// Native lock bindings only; reasoning and continuation remain CodeDog.
struct WorldModelMutex: wraps=recursive_mutex {}
struct WorldModelLock: wraps=Nested_Lock_Mutex {}

// Replacement reasoner. Agent owns sessions; WorldManager owns their reasoning.
// Scalar and closed ordered-list reasoning with local parser completion.
struct WorldOutcome: inherits=<mode[
    worldReady, worldComplete, worldPartial, worldWaiting,
    worldRejected, worldUnsupported, worldCancelled, worldError
]> {}

// Exact numeric value sets. A point and an empty half-open interval differ.
struct WorldBounds {
    me bool: bounded <- false
    me bool: point <- false
    me FlexNum: low
    me FlexNum: high
    me bool: empty() <- {return(bounded and !point and low>=high)}
    me bool: contains(me WorldBounds: other) <- {
        if(other.empty()){return(true)}
        if(empty()){return(false)}
        if(!bounded){return(true)}
        if(!other.bounded){return(false)}
        if(other.point){return(low<=other.low and ((point and low==other.low) or (!point and other.low<high)))}
        return(!point and low<=other.low and other.high<=high)
    }
    me bool: same(me WorldBounds: other) <- {
        return(bounded==other.bounded and point==other.point and (!bounded or (low==other.low and high==other.high)))
    }
    me WorldBounds: intersect(me WorldBounds: other) <- {
        me WorldBounds: result <- self
        if(empty() or !other.bounded){return(result)}
        if(other.empty() or !bounded){return(other)}
        if(point){if(other.contains(result)){return(result)}}
        else if(other.point){if(contains(other)){return(other)}}
        else{result.low <- max(low, other.low); result.high <- min(high, other.high); return(result)}
        result.point <- false; result.high <- result.low
        return(result)
    }
}

// A text expression borrows immutable leaves. Concatenation adds one node;
// each branch retains its represented length, including a borrowed prefix.
struct WorldText {
    our infonState: source
    our WorldText: left
    our WorldText: right
    me int64: leftLength <- 0
}
struct WorldTextSpan {
    our WorldText: text
    me int64: length
}
struct WorldTextCursor {
    me List<WorldTextSpan>: pending
    our infonState: source
    me int64: pos <- 0
    me int64: remaining <- 0
    me uint64: visits <- 0
    void: push(our WorldText: text, me int64: length) <- {
        if(length>0){me WorldTextSpan: span; span.text <- text; span.length <- length; pending.append(span)}
    }
    me char: next() <- {
        while(remaining==0){
            me WorldTextSpan: span <- pending.popLast()
            visits <+- 1
            if(span.text!.source!=NULL){source <- span.text!.source; pos <- 0; remaining <- span.length}
            else{
                push(span.text!.right, span.length-span.text!.leftLength)
                push(span.text!.left, min(span.length, span.text!.leftLength))
            }
        }
        me char: result <- source!.str[pos]
        pos <+- 1; remaining <- remaining-1
        return(result)
    }
}

// Sequences borrow member frames and summarize pending requirements. Joining
// adds one branch; cursors visit leaves once despite concatenation nesting.
struct WorldMember {
    our WorldFrame: frame
    me bool: embedded <- false
}
struct WorldList {
    our WorldList: left
    our WorldList: right
    me List<WorldMember>: members
    me int64: length <- 0
    // Represented members and required extent are different for sparse spans.
    me FlexNum: minimum <- 0
    me int: freeSpans <- 0 // Saturated at two: unique or potentially ambiguous.
    me bool: hasSpans <- false
    me bool: requirementsPending <- false
}
struct WorldListPosition {
    our WorldList: sequence
    me int64: pos <- 0
}
struct WorldListCursor {
    me List<WorldListPosition>: pending
    me uint64: visits <- 0
    void: push(our WorldList: sequence) <- {
        if(sequence!=NULL){me WorldListPosition: at; at.sequence <- sequence; pending.append(at)}
    }
    // Embedding belongs to the occurrence, not the cached member's infonView.
    me WorldMember: nextMember(me bool: flatten) <- {
        while(!pending.isEmpty()){
            me WorldListPosition: at <- pending.popLast()
            our WorldList: sequence <- at.sequence
            if(at.pos==0){visits <+- 1}
            if(flatten and sequence!.length==0){continue()}
            if(sequence!.left!=NULL or sequence!.right!=NULL){push(sequence!.right); push(sequence!.left)}
            else if(at.pos<sequence!.members.size()){
                me WorldMember: member <- sequence!.members[at.pos]
                at.pos <+- 1
                if(at.pos<sequence!.members.size()){pending.append(at)}
                if(flatten and member.embedded){push(member.frame!.facts.sequence)}
                else{return(member)}
            }
        }
        return(WorldMember())
    }
    our WorldFrame: next() <- {return(nextMember(true).frame)}
}

// A single symbolic gap has two anchored sequences. These borrow checked
// member frames; no model occurrences are allocated to inspect an alignment.
struct WorldOpenLayout {
    me List<our WorldFrame>: prefix
    me List<our WorldFrame>: suffix
    our WorldFrame: gap
    me int64: prefixCount <- 0
    me int64: suffixCount <- 0
}
struct WorldOpenScan {
    our WorldFrame: frame
    me WorldListCursor: members
}
struct WorldOpenAlignment {
    me int64: leftPrefixCount <- 0
    me int64: leftSuffixCount <- 0
    our WorldOpenLayout: right
    me int64: prefixPosition <- 0
    me int64: suffixPosition <- 0
    me int64: addedPrefix <- 0
    me int64: addedSuffix <- 0
    me bool: pastGap <- false
    me bool: remainderAdded <- false
}

// Occurrence paths borrow the model. They are local to a live request, not
// a persistent record of parent merge progress.
struct WorldPosition {
    our POV: node
    our WorldPosition: parent
    our POV: input
    their POV: occurrence
    me bool: tail <- false
}
struct WorldWalkLevel {
    our WorldPosition: position
    our POV: next
    me bool: entered <- false
    me bool: tailRead <- false
}
struct WorldWalk {
    me List<our WorldWalkLevel>: levels
    me Set<our infonView>: activeLayouts
    me WorldOutcome: outcome <- worldReady
    me string: detail
    our infonView: waiting
    void: push(our WorldPosition: position) <- {
        our WorldWalkLevel:: level; level!.position <- position; levels.append(level)
    }
}
struct WorldSelection {
    our WorldWalk: walk
    void: INIT() <- {Allocate(walk)}
    our WorldPosition: selected
    me FlexNum: index <- 0
    me FlexNum: position <- 0
    me bool: located <- false
    me bool: lastTail <- false
}
struct WorldLookup {
    our WorldWalk: left
    our WorldWalk: right
    void: INIT() <- {Allocate(left); Allocate(right)}
    our WorldPosition: target
    our WorldPosition: lhs
    our WorldPosition: rhs
    our WorldPosition: found
    our POV: edge
    me bool: matching <- false
    our WorldFrame: predicate
    our WorldFrame: candidate
    our WorldFrame: repeat
    our WorldPosition: afterRepeat
    our WorldFrame: exitPredicate
    our WorldFrame: foundFacts
    our POV: memberEdge
    me bool: repeatChecked <- false
}

struct WorldScalar {
    me WorldOutcome: outcome <- worldReady
    me string: detail
    me int: overlay <- -1
    me bool: hasSize <- false
    me FlexNum: size
    me bool: hasValue <- false
    me FlexNum: number
    our WorldText: textSource
    me int64: textLength <- 0
    me bool: negative <- false
    // A merge can need more facts without terminating the containing goal.
    me bool: needsEvidence <- false
    our WorldRequirement: pendingChecks
    me bool: extentApplied <- false
    me bool: explicitSize <- false
    me bool: contentsComplete <- true
    me bool: representable <- true
    me bool: dischargeListSpec <- false
    me bool: openTail <- false
    our WorldList: sequence
    me bool: hasRange <- false
    me FlexNum: lower
    me FlexNum: upper

    me WorldBounds: bounds() <- {
        me WorldBounds: result
        result.bounded <- hasValue or hasRange or hasSize
        result.point <- hasValue
        if(hasValue){result.low <- number; result.high <- number}
        else if(hasRange){result.low <- lower; result.high <- upper}
        else if(hasSize){result.high <- size}
        return(result)
    }
    void: useBounds(me WorldBounds: result) <- {
        hasValue <- result.point
        hasRange <- result.bounded and !result.point
        if(hasValue){number <- result.low}
        else if(hasRange){lower <- result.low; upper <- result.high}
    }

    void: applyExtent() <- {
        if(hasValue and overlay==NUM and hasSize and !extentApplied){
            if(number<0){number <+- size}
            extentApplied <- true
        }
    }
}

// Persistent ordered requirements: joining scopes never copies either side.
struct WorldRequirement {
    our WorldRequirement: left
    our WorldRequirement: right
    our WorldFrame: frame
    our POV: edge
}
struct WorldRequirementCursor {
    me List<our WorldRequirement>: pending
    me uint64: visits <- 0
    void: push(our WorldRequirement: requirement) <- {if(requirement!=NULL){pending.append(requirement)}}
    our WorldRequirement: next() <- {
        while(!pending.isEmpty()){
            our WorldRequirement: requirement <- pending.popLast(); visits <+- 1
            if(requirement!.frame!=NULL){return(requirement)}
            push(requirement!.right); push(requirement!.left)
        }
        return(NULL)
    }
}

struct WorldFrame {
    our POV: node
    me WorldScalar: facts
    me int64: nextWork <- 0
    me bool: initialized <- false
    me bool: finished <- false
    // Derived correspondence frames combine checked facts, never reread a POV.
    me bool: projected <- false
    me bool: corresponding <- false
    our WorldOpenAlignment: openAlignment
    our WorldPosition: context
    our WorldPosition: parentContext
    me int64: parentWork <- -1
    our WorldSelection: selection
    our WorldLookup: lookup
    me bool: selecting <- false
    me bool: predicateOnly <- false
    me bool: demandSize <- false
    me WorldListCursor: leftMembers
    our WorldListCursor: rightMembers
    me bool: pairedEmbedded <- false
    me bool: applyingListSpec <- false
    me bool: ownsRightCursor <- false
    me bool: extendingTail <- false
    me FlexNum: remaining <- 0
    me FlexNum: gapWidth <- 0
    our WorldFrame: pairedMember
    our WorldList: pairedSequence
    their POV: expressionParent
    // Visit the two stored slots once, then supplied identities.
    me int: expressionSlot <- 0 // 0=unstarted, 1=size, 2=value, 3=wrkList
    me bool: sourceIsOperand <- false
    me bool: sourceIsListSpec <- false
    me bool: memberSpecified <- false
    our POV: listSpecEdge
    our WorldFrame: listSpecFrame
    our WorldRequirement: tailRequirements
    our WorldRequirement: pendingRequirements
    me WorldRequirementCursor: memberRequirements
    our POV: nextOperand
    our POV: priorOperand
    me int64: operandsRead <- 0
    me WorldScalar: expression
    me WorldBounds: bodyBounds
    me bool: bodyHasSize <- false
    me FlexNum: bodySize
    me List<our POV>: retainedWork
    me bool: retainSource <- false
    our POV: sourceEdge
    our WorldFrame: prerequisite
}

// The shared control outlives WorldManager when callers retain completed handles.
struct WorldControl {
    me WorldModelMutex: mutex
    me Map<our infonView, our WorldInputWaiters>: inputWaiters
}
struct WorldInputWaiters {
    me List<our WorldRequest>: requests
}
struct WorldStatus {
    me WorldOutcome: outcome
    me string: detail
}
struct WorldPublication {
    our POV: target
    our WorldFrame: frame
    our infonState: newList
    our infonState: appendedList
}
struct WorldRequest {
    our WorldControl: control
    our infonView: waitingInput
    our WorldFrame: waitingFrame
    our POV: target
    me bool: requireSize <- false
    me WorldOutcome: outcome <- worldReady
    me string: detail
    me uint64: framesCreated <- 0
    me uint64: relationshipsRead <- 0
    me uint64: publications <- 0
    me uint64: memberPairs <- 0
    me uint64: alignmentChecks <- 0
    me uint64: correspondencePositions <- 0
    me uint64: correspondenceChecks <- 0
    me uint64: parentLookups <- 0
    me uint64: templateApplications <- 0
    me uint64: comparisonResumptions <- 0
    me uint64: requirementVisits <- 0
    me uint64: tailMembers <- 0
    me uint64: sequenceVisits <- 0
    me uint64: publishedTextBytes <- 0
    me uint64: publishedTextNodes <- 0
    me List<our WorldFrame>: ready
    me Map<our infonView, our WorldFrame>: attempts
    // Active ancestry only: this prevents circular contextual proofs, not
    // reuse of facts from a different occurrence.
    me Map<our infonView, our WorldFrame>: activeContexts
    our WorldFrame: root
    me WorldStatus: status() <- {
        me WorldModelLock: lock{control!.mutex}
        me WorldStatus: result
        result.outcome <- outcome; result.detail <- detail
        return(result)
    }
    me bool: complete() <- {return(status().outcome==worldComplete)}
    me bool: failed() <- {
        me WorldOutcome: state <- status().outcome
        return(state==worldRejected or state==worldUnsupported or state==worldError)
    }
    me string: error() <- {return(status().detail)}
    our POV: result() <- {return(target)}
    // Normalization drains runnable work before returning. Taking this lock
    // also waits for any active publication to finish; Waiting stays visible.
    void: waitForCompletion() <- {me WorldModelLock: lock{control!.mutex}}
    void: releaseProgress() <- {
        ready.clear(); attempts.clear(); activeContexts.clear(); root <- NULL; waitingFrame <- NULL
    }
    void: cancel() <- {
        me WorldModelLock: lock{control!.mutex}
        if(waitingInput!=NULL and control!.inputWaiters.containsKey(waitingInput)){
            our WorldInputWaiters: waiters <- control!.inputWaiters.at(waitingInput)
            me List<our WorldRequest>: remaining
            withEach request in waiters!.requests{
                if(request!==self){remaining.append(request)}
            }
            waiters!.requests <- remaining
            if(remaining.isEmpty()){control!.inputWaiters.erase(waitingInput)}
        }
        waitingInput <- NULL
        if(outcome==worldReady or outcome==worldWaiting or outcome==worldPartial){outcome <- worldCancelled}
        releaseProgress()
    }
}

struct WorldSession {
    me uint64: id
    me bool: closed <- false
    me List<our WorldRequest>: requests
}

struct WorldParseResult {
    our POV: target
    me string: error
}

struct infonView {
    // A copied view must not inherit another occurrence's completion marker.
    // Stronger requests still inspect their explicitly requested facts.
    their infonView: worldScalarCompletionOwner
    // A new supplied constraint needs a new request. Existing handles are not reset.
    void: noteNormalizationWork() <- {worldScalarCompletionOwner <- NULL; isNormed <- false}
}

// Virtual access over the existing model; no copied adjacency graph.
struct WorldPOVGraph {
    me int64: sequenceLength(our WorldList: sequence) <- {
        if(sequence==NULL){return(0)}else{return(sequence!.length)}
    }
    me bool: openLayout(me WorldScalar: facts) <- {
        return(facts.openTail or (facts.sequence!=NULL and facts.sequence!.hasSpans))
    }
    me FlexNum: minimumWidth(me WorldScalar: facts) <- {
        if(facts.sequence==NULL){return(FlexNum())}else{return(facts.sequence!.minimum)}
    }
    me int: freeSpans(me WorldScalar: facts) <- {
        me int: count <- 0
        if(facts.sequence!=NULL){count <- facts.sequence!.freeSpans}
        if(facts.openTail){count <+- 1}
        return(min(count, 2))
    }
    // Nonnegative span widths add to the supplied endpoint. One free width,
    // or a zero remainder, has one solution; other partitions stay unresolved.
    me WorldScalar: fitExtent(me WorldScalar: facts, me FlexNum: extent) <- {
        me FlexNum: minimum <- minimumWidth(facts)
        me int: free <- freeSpans(facts)
        if((facts.hasSize and facts.size!=extent) or extent<minimum or (free==0 and extent!=minimum)){
            facts.outcome <- worldPartial; facts.detail <- "List endpoints need span alignment"
        }else if(free>1 and extent>minimum){
            facts.outcome <- worldPartial; facts.detail <- "Several span widths remain possible"
        }
        return(facts)
    }
    our WorldList: join(our WorldList: left, our WorldList: right) <- {
        if(left==NULL){return(right)}
        if(right==NULL){return(left)}
        our WorldList:: result
        result!.left <- left; result!.right <- right
        result!.length <- left!.length+right!.length
        result!.minimum <- left!.minimum+right!.minimum
        result!.freeSpans <- min(2, left!.freeSpans+right!.freeSpans)
        result!.hasSpans <- left!.hasSpans or right!.hasSpans
        result!.requirementsPending <- left!.requirementsPending or right!.requirementsPending
        return(result)
    }
    me bool: appendMember(our WorldList: sequence, our WorldFrame: frame, me bool: embedded <- false) <- {
        me int64: length <- 1
        if(embedded){length <- sequenceLength(frame!.facts.sequence)}
        if(length>9223372036854775807-sequence!.length){return(false)}
        me WorldMember: member; member.frame <- frame; member.embedded <- embedded
        sequence!.members.append(member); sequence!.length <+- length
        sequence!.requirementsPending <- sequence!.requirementsPending or needsRequirements(frame)
        if(embedded){
            if(frame!.facts.hasSize){sequence!.minimum <+- frame!.facts.size}
            else{
                sequence!.minimum <+- minimumWidth(frame!.facts)
                sequence!.freeSpans <- min(2, sequence!.freeSpans+freeSpans(frame!.facts))
            }
            sequence!.hasSpans <- sequence!.hasSpans or openLayout(frame!.facts)
        }else{sequence!.minimum <+- 1}
        return(true)
    }
    void: beginCorrespondence(our WorldFrame: frame, me FlexNum: extent <- FlexNum()) <- {
        if(!frame!.applyingListSpec){
            if(frame!.openAlignment==NULL){
                frame!.facts <- fitExtent(frame!.facts, extent)
                if(frame!.facts.outcome!=worldReady){return()}
                frame!.remaining <- extent; frame!.gapWidth <- extent-minimumWidth(frame!.facts)
            }
            frame!.extendingTail <- frame!.facts.openTail
        }
        frame!.corresponding <- true; frame!.leftMembers.push(frame!.facts.sequence)
        Allocate(frame!.pairedSequence)
        frame!.facts.contentsComplete <- true; frame!.facts.representable <- true
    }
    me bool: needsRequirements(our WorldFrame: frame) <- {
        return(frame!.facts.outcome==worldReady and (frame!.pendingRequirements!=NULL or
            (frame!.facts.sequence!=NULL and frame!.facts.sequence!.requirementsPending)))
    }
    our WorldRequirement: joinRequirements(our WorldRequirement: left, our WorldRequirement: right) <- {
        if(left==NULL){return(right)}
        if(right==NULL){return(left)}
        our WorldRequirement:: result; result!.left <- left; result!.right <- right
        return(result)
    }
    our WorldRequirement: requirement(our WorldFrame: spec, our POV: edge) <- {
        our WorldRequirement:: result; result!.frame <- spec; result!.edge <- edge
        return(result)
    }
    void: beginRequirements(our WorldFrame: frame, our WorldRequirement: inherited <- NULL) <- {
        frame!.pendingRequirements <- joinRequirements(frame!.pendingRequirements, inherited)
        if(frame!.facts.openTail){frame!.tailRequirements <- joinRequirements(frame!.tailRequirements, frame!.pendingRequirements)}
        frame!.applyingListSpec <- true; beginCorrespondence(frame)
    }
    me bool: checkEmbedded(our WorldFrame: frame) <- {
        me WorldScalar: facts <- frame!.prerequisite!.facts
        if(facts.overlay!=LST or !facts.hasValue){
            frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Embedded member needs a closed list"; return(false)
        }
        me FlexNum: minimum <- minimumWidth(facts)
        if(facts.outcome!=worldReady or
           (!openLayout(facts) and (!facts.hasSize or facts.size!=FlexNum(sequenceLength(facts.sequence)))) or
           (facts.hasSize and (facts.size.getDenominator()!=1 or facts.size<minimum or
               (freeSpans(facts)==0 and facts.size!=minimum)))){
            frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Embedded list extent is unresolved"; return(false)
        }
        return(true)
    }
    me bool: scalarExpression(our infonState: state) <- {
        return(state!.overlayType==LST and state!.evalMode==emConcat and !state!.inverted and
            !state!.undefined and state!.items.head!=NULL and state!.listSpec==NULL and
            !state!.tailUnfinished and !state!.timelike)
    }
    me bool: memberSequence(our WorldFrame: frame) <- {
        return(frame!.expressionSlot==2 and frame!.facts.overlay==LST and
            frame!.node!.pItem!.value!.evalMode==emLiteral)
    }
    me bool: representableFacts(me WorldScalar: facts) <- {
        return(facts.outcome==worldReady and facts.representable and facts.pendingChecks==NULL)
    }
    me bool: completeFacts(me WorldScalar: facts, me bool: requireSize) <- {
        return(facts.outcome==worldReady and facts.pendingChecks==NULL and !facts.negative and !openLayout(facts) and facts.hasValue and facts.contentsComplete and
            ((!requireSize and facts.overlay==NUM) or facts.hasSize) and
            (facts.overlay!=LST or facts.size==FlexNum(sequenceLength(facts.sequence))))
    }
    me WorldScalar: read(our POV: node, their POV: expressionParent <- NULL, me bool: bodyInput <- false, me bool: selection <- false) <- {
        me WorldScalar: facts
        if(node==NULL or node!.pItem==NULL){
            facts.outcome <- worldError; facts.detail <- "Missing target POV"; return(facts)
        }
        if((node!.pParent!=NULL and node!.pParent!==expressionParent) or node!.viewMap.sourcePov!=NULL or node!.referenceAlias.sourcePov!=NULL){
            facts.outcome <- worldUnsupported; facts.detail <- "Contextual member access needs list correspondence"; return(facts)
        }
        our infonView: item <- node!.pItem
        if(item!.graphParseError!=""){
            facts.outcome <- worldError; facts.detail <- item!.graphParseError; return(facts)
        }
        if(item!.streamState==parseStarted or item!.streamState==parseListReady){
            facts.outcome <- worldWaiting; facts.detail <- "Scalar input is still being parsed"; return(facts)
        }
        if(item!.value==NULL or item!.infSize==NULL){
            facts.outcome <- worldError; facts.detail <- "Missing scalar state"; return(facts)
        }
        if(item!.type!=NULL or !item!.addedTypes.isEmpty() or item!.viewMode==vmCursor or
           (item!.innr!=NULL and !selection) or (item!.funcArgs!=NULL and !bodyInput) or
           !item!.parts.isEmpty() or item!.partRef!=NULL or item!.proxy!=NULL or
           item!.doReply or (item!.itmMode!=mItem and item!.itmMode!=mNone) or item!.identityName!=NULL or
           item!.independentTemporalValue or item!.temporalValueSource!=NULL or item!.temporalPredecessor!=NULL){
            facts.outcome <- worldUnsupported
            facts.detail <- "This request needs semantics beyond the scalar milestone"; return(facts)
        }
        if(selection){return(facts)}
        me bool: expression <- item!.value!.evalMode==emConcat
        if(!expression and item!.value!.overlayType==LST and
           (item!.value!.evalMode!=emLiteral or
            item!.value!.timelike or item!.orderMode==uUnordered or item!.invertMatch)){
            facts.outcome <- worldUnsupported; facts.detail <- "List needs correspondence or template semantics"; return(facts)
        }
        if(item!.value!.evalMode==emIntersection or
           item!.value!.undefined or (item!.value!.inverted and (expression or item!.value!.overlayType!=NUM)) or
           item!.infSize!.undefined or item!.infSize!.inverted or
           !((item!.infSize!.overlayType==NUM and
              (item!.infSize!.evalMode==emUnknown or item!.infSize!.evalMode==emLiteral)) or
             scalarExpression(item!.infSize))){
            facts.outcome <- worldUnsupported; facts.detail <- "Nonliteral scalar or size"; return(facts)
        }
        facts.hasSize <- item!.infSize!.evalMode==emLiteral
        facts.size <- item!.infSize!.num
        facts.explicitSize <- item!.value!.sizeMode==fromGiven
        if(facts.hasSize and facts.size.getDenominator()==0){
            facts.outcome <- worldError; facts.detail <- "Numeric size has a zero denominator"; return(facts)
        }
        if(facts.hasSize){facts.size.normalize()}
        if(expression){
            if(item!.invertMatch or !scalarExpression(item!.value)){
                facts.outcome <- worldUnsupported; facts.detail <- "Non-scalar expression template"
            }
            return(facts)
        }
        if(item!.value!.overlayType!=tUnknown and item!.value!.overlayType!=tUnset){facts.overlay <- item!.value!.overlayType}
        facts.hasValue <- item!.value!.evalMode==emLiteral
        if(facts.hasValue and facts.overlay!=NUM and facts.overlay!=STR and facts.overlay!=LST){
            facts.outcome <- worldUnsupported; facts.detail <- "Non-scalar literal"; return(facts)
        }
        facts.number <- item!.value!.num
        if(item!.value!.inverted){facts.number <- -facts.number}
        if((facts.hasValue and facts.overlay==NUM and facts.number.getDenominator()==0) or
           (facts.hasSize and facts.size.getDenominator()==0)){
            facts.outcome <- worldError; facts.detail <- "Numeric literal has a zero denominator"; return(facts)
        }
        if(facts.hasValue and facts.overlay==NUM){facts.number.normalize()}
        if(facts.hasSize){facts.size.normalize()}
        if(facts.hasValue and facts.overlay==STR){
            Allocate(facts.textSource); facts.textSource!.source <- item!.value
            facts.textLength <- item!.value!.str.size()
        }
        facts.openTail <- facts.overlay==LST and item!.value!.tailUnfinished
        facts.negative <- item!.invertMatch
        facts.extentApplied <- item!.value!.numericExtentApplied
        facts.applyExtent()
        return(facts)
    }

    our WorldPosition: position(our POV: node, our WorldPosition: parent <- NULL) <- {
        our WorldPosition:: result; result!.node <- node; result!.parent <- parent; result!.occurrence <- node; return(result)
    }
    our WorldPosition: occurrencePath(our POV: node) <- {
        our WorldPosition: result <- position(node)
        our WorldPosition: at <- result
        their POV: parent <- node!.pParent
        me Set<their POV>: seen
        seen.insert(result!.occurrence)
        while(parent!=NULL){
            if(seen.contains(parent)){return(NULL)}
            seen.insert(parent)
            me bool: contained <- false
            our POV: child <- parent!.pItem!.value!.items.head
            while(child!=NULL){
                if(child===at!.occurrence){contained <- true; break()}
                child <- child!.next
            }
            if(!contained){return(NULL)}
            our POV:: borrowed{936}; borrowed! <- parent!
            at!.parent <- position(borrowed); at <- at!.parent; at!.occurrence <- parent
            parent <- parent!.pParent
        }
        return(result)
    }
    me bool: samePosition(our WorldPosition: left, our WorldPosition: right) <- {
        while(left!=NULL and right!=NULL){
            if(left===right){return(true)}
            if(left!.occurrence!==right!.occurrence){return(false)}
            left <- left!.parent; right <- right!.parent
        }
        return(left==NULL and right==NULL)
    }
    our POV: memberRelationship(our POV: parent) <- {
        our POV:: result{937}; result! <- parent!
        result!.looseTop <- false; result!.looseInhtd <- parent!.looseMode or parent!.looseInhtd
        result!.pParent <- NULL
        return(result)
    }
    me bool: typePredicate(me WorldScalar: facts) <- {
        return(facts.outcome==worldReady and facts.pendingChecks==NULL and !facts.hasValue and
               !facts.hasSize and !facts.hasRange and facts.overlay>=0)
    }
    me WorldScalar: matchPosition(me WorldScalar: predicate, me WorldScalar: candidate, our POV: edge, me bool: proof <- false) <- {
        if(predicate.outcome!=worldReady){return(predicate)}
        if(candidate.outcome!=worldReady){return(candidate)}
        if(predicate.pendingChecks!=NULL or candidate.pendingChecks!=NULL){
            predicate.outcome <- worldPartial; predicate.detail <- "Correspondence predicate still needs evidence"; return(predicate)
        }
        if(proof and (predicate.hasRange or candidate.negative or edge!.looseType() or
           (predicate.overlay==LST and predicate.hasValue))){
            predicate.outcome <- worldUnsupported; predicate.detail <- "Repeated predicate needs additional comparison semantics"; return(predicate)
        }
        // A repeated predicate requires proof, not a compatible substitution.
        // A type predicate needs only the candidate's type. In particular,
        // excluding strings does not require evaluating a list's contents.
        if((proof or typePredicate(predicate)) and !edge!.looseType() and !candidate.negative){
            me WorldOutcome: compared <- compare(predicate, candidate)
            if(predicate.negative){
                if(compared==worldReady){compared <- worldRejected}
                else if(compared==worldRejected){compared <- worldReady}
            }
            predicate.outcome <- compared; predicate.detail <- "Correspondence predicate comparison"
            return(predicate)
        }
        if(predicate.overlay==LST and candidate.overlay==LST){
            predicate.outcome <- worldUnsupported; predicate.detail <- "Structured correspondence predicates need member matching"; return(predicate)
        }
        return(merge(predicate, candidate, edge))
    }
    // Read structural positions without evaluating sibling values. An open
    // remainder is one symbolic event, never an instruction to enumerate it.
    our WorldPosition: nextPosition(our WorldRequest: request, our WorldWalk: walk) <- {
        walk!.outcome <- worldReady; walk!.waiting <- NULL
        while(!walk!.levels.isEmpty()){
            our WorldWalkLevel: level <- walk!.levels.last()
            our POV: node <- level!.position!.node
            if(!level!.entered){
                me WorldScalar: header <- read(node, node!.pParent, level!.position!.input!=NULL)
                if(header.outcome!=worldReady){
                    walk!.outcome <- header.outcome; walk!.detail <- header.detail
                    if(header.outcome==worldWaiting){walk!.waiting <- node!.pItem}
                    return(NULL)
                }
                if(header.overlay!=LST or !header.hasValue){
                    walk!.outcome <- worldUnsupported; walk!.detail <- "Correspondence needs a represented list layout"; return(NULL)
                }
                // A nested layout's own constraints can change its extent.
                if(level!.position!.parent!=NULL and !node!.pItem!.wrkList.isEmpty()){
                    walk!.outcome <- worldUnsupported; walk!.detail <- "Embedded layout has unresolved relationships"; return(NULL)
                }
                walk!.activeLayouts.insert(node!.pItem)
                request!.correspondencePositions <+- 1
                level!.entered <- true; level!.next <- node!.pItem!.value!.items.head
            }
            if(level!.next!=NULL){
                our POV: member <- level!.next; level!.next <- member!.next
                our WorldPosition: result <- position(member, level!.position)
                request!.correspondencePositions <+- 1
                if(member!.isSubItm){
                    if(walk!.activeLayouts.contains(member!.pItem)){
                        walk!.outcome <- worldUnsupported; walk!.detail <- "Cyclic list layout"; return(NULL)
                    }
                    walk!.push(result)
                }else{return(result)}
            }else if(!level!.tailRead and node!.pItem!.value!.tailUnfinished){
                level!.tailRead <- true
                our WorldPosition: result <- position(node, level!.position!.parent)
                result!.tail <- true; return(result)
            }else{walk!.activeLayouts.erase(node!.pItem); walk!.levels.popLast()}
        }
        return(NULL)
    }

    // The cursor is retained in the frame; ordinary arrival never rewinds it.
    our POV: nextRelationship(our WorldFrame: frame) <- {
        frame!.sourceIsListSpec <- false
        while(frame!.expressionSlot<3){
            if(frame!.nextOperand!=NULL){
                our POV: operand <- frame!.nextOperand
                if(operand!.prev!==frame!.priorOperand){
                    frame!.facts.outcome <- worldError; frame!.facts.detail <- "Broken expression operand chain"; return(NULL)
                }
                if(operand!.isSubItm and !memberSequence(frame)){
                    frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Sublist expression operand"; return(NULL)
                }
                frame!.priorOperand <- operand; frame!.nextOperand <- operand!.next
                frame!.sourceIsOperand <- true; return(operand)
            }
            if(frame!.operandsRead>0 or memberSequence(frame)){finishExpression(frame)}
            if(frame!.facts.outcome!=worldReady){return(NULL)}
            frame!.expressionSlot <+- 1
            frame!.operandsRead <- 0; frame!.priorOperand <- NULL
            our infonState: slot
            if(frame!.expressionSlot==1){slot <- frame!.node!.pItem!.infSize}
            else if(frame!.expressionSlot==2){slot <- frame!.node!.pItem!.value}
            if(slot!=NULL and (slot!.evalMode==emConcat or memberSequence(frame))){
                frame!.nextOperand <- slot!.items.head
                // A finite template is read once, then projected into each member.
                // Empty closed lists need no template evaluation.
                if(memberSequence(frame) and slot!.listSpec!=NULL and
                   (frame!.nextOperand!=NULL or (frame!.facts.openTail and !(frame!.facts.hasSize and frame!.facts.size==0)))){
                    Allocate(frame!.listSpecEdge, 934); frame!.listSpecEdge!.pItem <- slot!.listSpec
                    frame!.sourceIsOperand <- false; frame!.sourceIsListSpec <- true
                    return(frame!.listSpecEdge)
                }
            }
        }
        frame!.sourceIsOperand <- false
        our infonView: item <- frame!.node!.pItem
        // Member constraints must be settled before this list's own identities.
        if(!item!.wrkList.isEmpty() and needsRequirements(frame)){return(NULL)}
        if(frame!.nextWork>=item!.wrkList.size()){return(NULL)}
        our POV: edge <- item!.wrkList[frame!.nextWork]
        frame!.nextWork <+- 1
        if(edge==NULL){frame!.facts.outcome <- worldError; frame!.facts.detail <- "Empty relationship"}
        return(edge)
    }

    // These are value operations over already resolved operand facts, not
    // identity links. No operand is copied into or normalized on the model.
    me WorldScalar: appendNumber(me WorldScalar: left, me WorldScalar: right, me bool: additive) <- {
        if(left.overlay!=NUM or right.overlay!=NUM or left.negative or right.negative){
            left.outcome <- worldUnsupported; left.detail <- "Numeric expression needs positive numeric operands"; return(left)
        }
        if(!right.hasValue){left.outcome <- worldPartial; left.detail <- "Expression operand value is unknown"; return(left)}
        if(additive){
            me WorldBounds: result <- left.bounds()
            if(!result.bounded){left.outcome <- worldPartial; left.detail <- "Additive input has no finite value bounds"; return(left)}
            if(result.empty()){left.outcome <- worldRejected; left.detail <- "Empty numeric range"; return(left)}
            result.low <+- right.number; result.high <+- right.number
            left.useBounds(result)
            if(left.hasRange){left.hasSize <- false; left.explicitSize <- false}
        }else{
            if(!left.hasValue or !right.hasSize or right.size<0){
                left.outcome <- worldPartial; left.detail <- "Numeric concatenation needs a value and radix"; return(left)
            }
            left.number <- left.number*right.size + right.number
            if(left.hasSize){left.size <- left.size*right.size}
        }
        return(left)
    }

    me WorldScalar: appendOperand(me WorldScalar: left, me WorldScalar: right, me bool: additive) <- {
        if(left.overlay<0 or right.overlay<0){
            left.outcome <- worldPartial; left.detail <- "Expression operand type is unknown"; return(left)
        }
        if(left.overlay==NUM and right.overlay==NUM){return(appendNumber(left, right, additive))}
        if(left.overlay==LST and right.overlay==LST and !left.negative and !right.negative){
            if(openLayout(left) or openLayout(right)){
                left.outcome <- worldUnsupported; left.detail <- "Open list concatenation needs span alignment"; return(left)
            }
            if((left.hasSize and left.size!=FlexNum(sequenceLength(left.sequence))) or
               (right.hasSize and right.size!=FlexNum(sequenceLength(right.sequence)))){
                left.outcome <- worldPartial; left.detail <- "List operand endpoint needs span alignment"; return(left)
            }
            if(sequenceLength(right.sequence)>9223372036854775807-sequenceLength(left.sequence)){
                left.outcome <- worldError; left.detail <- "List expression exceeds representable length"; return(left)
            }
            left.sequence <- join(left.sequence, right.sequence)
            left.contentsComplete <- left.contentsComplete and right.contentsComplete
            left.representable <- left.representable and right.representable
            if(left.hasSize and right.hasSize){left.size <+- right.size}else{left.hasSize <- false}
            return(left)
        }
        if(left.overlay!=STR or right.overlay!=STR or left.negative or right.negative){
            left.outcome <- worldUnsupported; left.detail <- "Mixed or negative expression operands"; return(left)
        }
        if(!left.hasValue or !right.hasValue){
            left.outcome <- worldPartial; left.detail <- "String expression operand value is unknown"; return(left)
        }
        if(right.textLength>9223372036854775807-left.textLength){
            left.outcome <- worldError; left.detail <- "String expression exceeds representable length"; return(left)
        }
        our WorldText:: joined
        joined!.left <- left.textSource; joined!.right <- right.textSource
        joined!.leftLength <- left.textLength
        left.textSource <- joined; left.textLength <+- right.textLength
        return(left)
    }

    void: finishExpression(our WorldFrame: frame) <- {
        if(memberSequence(frame)){
            if(frame!.facts.openTail and (frame!.facts.sequence==NULL or !frame!.facts.sequence!.hasSpans) and frame!.facts.hasSize and frame!.facts.size==FlexNum(frame!.operandsRead)){
                frame!.facts.openTail <- false
            }
            if(!openLayout(frame!.facts) and !frame!.facts.hasSize and !frame!.facts.explicitSize){
                frame!.facts.hasSize <- true; frame!.facts.size <- frame!.operandsRead
            }
            frame!.facts.dischargeListSpec <- frame!.facts.representable and !openLayout(frame!.facts)
            return()
        }
        me WorldScalar: expression <- frame!.expression
        if(frame!.expressionSlot==1){
            // The operand's value supplies the owner's size, not its type,
            // radix or range width. Unsupported extents remain expressed.
            if(expression.overlay!=NUM or expression.negative or !expression.hasValue or
               expression.number<0 or expression.number.getDenominator()!=1){
                frame!.facts.outcome <- worldPartial
                frame!.facts.detail <- "Computed size needs a nonnegative whole numeric value"; return()
            }
            frame!.facts.hasSize <- true; frame!.facts.size <- expression.number
            frame!.facts.applyExtent()
            return()
        }
        if(expression.overlay==LST){
            if(!expression.representable){
                frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "List expression still has unresolved member work"; return()
            }
            expression.explicitSize <- frame!.facts.explicitSize or !expression.hasSize
        }
        if(expression.overlay==STR and expression.hasValue and !expression.negative){
            // The expression counts its represented bytes, independently of
            // the operands' declared or unknown endpoints.
            expression.hasSize <- true; expression.size <- expression.textLength
            expression.explicitSize <- frame!.facts.explicitSize
        }
        if(expression.hasRange){
            // A range's width describes possible values, not its outer size.
            if(expression.hasSize and frame!.facts.hasSize and expression.size!=frame!.facts.size){
                frame!.facts.outcome <- worldRejected; frame!.facts.detail <- "Incompatible expression sizes"; return()
            }
            if(frame!.facts.hasSize){expression.hasSize <- true; expression.size <- frame!.facts.size}
            expression.explicitSize <- expression.explicitSize or frame!.facts.explicitSize
            frame!.facts <- expression; frame!.bodyBounds <- expression.bounds()
            frame!.bodyHasSize <- expression.hasSize; frame!.bodySize <- expression.size
        }else{
            if(frame!.operandsRead>1 and expression.overlay==NUM){
                expression.extentApplied <- expression.hasSize
                expression.explicitSize <- expression.hasSize or frame!.facts.explicitSize
            }
            frame!.facts <- merge(frame!.facts, expression, frame!.node!.pItem!.value!.items.head)
        }
    }

    // Compare the represented text, which can be a prefix borrowed from a
    // larger source. Intermediate frames never allocate substrings.
    me bool: sameText(me WorldScalar: left, me WorldScalar: right, me bool: prefix) <- {
        if(!prefix and left.textLength!=right.textLength){return(false)}
        me int64: length <- min(left.textLength, right.textLength)
        me WorldTextCursor: lhs; lhs.push(left.textSource, length)
        me WorldTextCursor: rhs; rhs.push(right.textSource, length)
        withEach pos in range 0 .. length{if(lhs.next()!=rhs.next()){return(false)}}
        return(true)
    }

    // Prove whether every supplied fact matches a positive scalar template.
    // Ready=yes, Rejected=no, Partial=not enough evidence. Work only on local
    // facts: a negative template must not acquire its candidate's size/value.
    me WorldOutcome: compare(me WorldScalar: required, me WorldScalar: actual) <- {
        if(required.overlay>=0 and actual.overlay>=0 and required.overlay!=actual.overlay){return(worldRejected)}
        if(required.hasSize and actual.hasSize and required.size!=actual.size){return(worldRejected)}
        me bool: covered <- (required.overlay<0 or actual.overlay>=0) and
            (!required.hasSize or actual.hasSize) and (!required.hasValue or actual.hasValue)
        if(required.hasValue and actual.hasValue){
            if(required.overlay==NUM){
                if(!required.hasSize and !actual.hasSize and required.number!=actual.number and
                   ((required.number<0 and !required.extentApplied)!=(actual.number<0 and !actual.extentApplied))){return(worldPartial)}
                if(!required.hasSize and actual.hasSize){required.hasSize <- true; required.size <- actual.size}
                if(!actual.hasSize and required.hasSize){actual.hasSize <- true; actual.size <- required.size}
                required.applyExtent(); actual.applyExtent()
                if(required.number!=actual.number){return(worldRejected)}
            }else if(!sameText(required, actual, false)){return(worldRejected)}
        }
        if(!covered){return(worldPartial)}
        return(worldReady)
    }

    me WorldScalar: mergeText(me WorldScalar: left, me WorldScalar: right, me bool: prefix) <- {
        if(left.hasValue){
            if(!sameText(left, right, prefix)){
                left.outcome <- worldRejected; left.detail <- "Incompatible string values"; return(left)
            }
        }else{
            me int64: width <- right.textLength
            if(left.hasSize){
                // Bound the exact integer before converting it to an index.
                if(left.size<0 or left.size.getDenominator()!=1 or left.size>width or
                   (!prefix and left.size!=width)){
                    left.outcome <- worldPartial; left.detail <- "String width is not supplied by the available text"; return(left)
                }
                width <- left.size.getNumerator().convertToIntVal()
            }
            left.hasValue <- true; left.textSource <- right.textSource; left.textLength <- width
            left.explicitSize <- !(left.hasSize or (!prefix and right.hasSize))
        }
        left.overlay <- STR
        if(!prefix and !left.hasSize and right.hasSize){left.hasSize <- true; left.size <- right.size}
        return(left)
    }

    me WorldScalar: mergeRanges(me WorldScalar: left, me WorldScalar: right, our POV: edge) <- {
        if(!edge!.looseType()){
            // Strict identity shares an endpoint; comparison may use it locally.
            if(!left.hasSize and right.hasSize){left.hasSize <- true; left.size <- right.size}
            if(!right.hasSize and left.hasSize){right.hasSize <- true; right.size <- left.size}
            left.applyExtent(); right.applyExtent()
        }
        me WorldBounds: required <- left.bounds()
        me WorldBounds: supplied <- right.bounds()
        me WorldBounds: result <- required.intersect(supplied)
        if(edge!.looseType() and !right.hasValue and !right.hasRange){result <- required}
        if(required.empty() or supplied.empty() or result.empty()){
            left.outcome <- worldRejected; left.detail <- "Disjoint numeric value ranges"; return(left)
        }
        if(edge!.looseType()){
            // A bounded unknown RHS supplies an endpoint, not a known value
            // set to match. An explicit range expression does supply that set.
            if(right.hasValue or right.hasRange){
                if(!required.contains(supplied)){
                    left.outcome <- worldPartial; left.detail <- "Numeric range match has only partial overlap"; return(left)
                }
                result <- supplied; left.explicitSize <- right.explicitSize
            }else{result <- required}
        }else{left.explicitSize <- left.explicitSize or right.explicitSize}
        if(!edge!.looseSize() and !left.hasSize and right.hasSize){
            left.hasSize <- true; left.size <- right.size
        }
        if(!left.hasValue){left.extentApplied <- right.extentApplied}
        left.overlay <- NUM; left.useBounds(result)
        if(left.hasValue and left.hasSize){left.extentApplied <- true}
        return(left)
    }

    // An unconstrained target adopts represented structure, including symbolic
    // tails. Other list identities prove the shape before pairing members.
    me WorldScalar: mergeList(me WorldScalar: left, me WorldScalar: right, our POV: edge, me bool: alignedOpen <- false) <- {
        if(edge!.forceID or edge!.looseType() or left.negative or right.negative){
            left.outcome <- worldUnsupported; left.detail <- "Qualified list relationships need matching semantics"; return(left)
        }
        if((left.overlay>=0 and left.overlay!=LST) or (right.overlay>=0 and right.overlay!=LST)){
            left.outcome <- worldRejected; left.detail <- "Incompatible list types"; return(left)
        }
        if(!alignedOpen and openLayout(right) and (left.hasValue or left.hasSize)){
            left.outcome <- worldUnsupported; left.detail <- "Open source correspondence needs span alignment"; return(left)
        }
        if(!alignedOpen and openLayout(left) and (!right.hasValue or !right.hasSize)){
            left.outcome <- worldPartial; left.detail <- "Tail closure needs a closed source endpoint"; return(left)
        }
        if((left.hasSize and right.hasSize and left.size!=right.size) or
           (right.hasValue and right.hasSize and !openLayout(right) and right.size!=FlexNum(sequenceLength(right.sequence))) or
           (!left.hasValue and left.hasSize and right.hasValue and left.size!=FlexNum(sequenceLength(right.sequence)))){
            left.outcome <- worldPartial; left.detail <- "List endpoints need span alignment"; return(left)
        }
        if(!alignedOpen and left.hasValue and right.hasValue){
            left <- fitExtent(left, FlexNum(sequenceLength(right.sequence)))
            if(left.outcome!=worldReady){return(left)}
        }
        if(!left.hasValue and right.hasValue and !right.representable){
            left.outcome <- worldPartial; left.detail <- "List source still has unresolved member work"; return(left)
        }
        left.overlay <- LST
        if(!left.hasSize and right.hasSize){left.hasSize <- true; left.size <- right.size}
        if(!left.hasValue and right.hasValue){
            left.hasValue <- true; left.sequence <- right.sequence; left.openTail <- right.openTail
            left.dischargeListSpec <- right.dischargeListSpec
            left.explicitSize <- left.explicitSize or right.explicitSize
            left.contentsComplete <- right.contentsComplete; left.representable <- right.representable
        }
        return(left)
    }

    me WorldScalar: merge(me WorldScalar: left, me WorldScalar: right, our POV: edge) <- {
        left.needsEvidence <- false
        if(left.overlay==LST or right.overlay==LST){return(mergeList(left, right, edge))}
        if(edge!.forceID){
            left.outcome <- worldUnsupported
            left.detail <- "Replacement relationships are not implemented yet"; return(left)
        }
        if(left.negative or right.negative){
            if(edge!.looseType() or left.hasRange or right.hasRange){
                left.outcome <- worldUnsupported; left.detail <- "Qualified negative matching needs template semantics"; return(left)
            }
            me WorldOutcome: match
            if(left.negative){match <- compare(left, right)}else{match <- compare(right, left)}
            if(left.negative and right.negative){
                // Only equivalent exclusions discharge each other. Other
                // conjunctions stay explicit; neither is positive evidence.
                if(match!=worldReady or compare(right, left)!=worldReady){
                    left.outcome <- worldPartial; left.detail <- "Unequal exclusions remain conjoined"
                }
            }else if(match==worldReady){
                left.outcome <- worldRejected; left.detail <- "Scalar excluded by negative constraint"
            }else if(match==worldPartial){
                left.needsEvidence <- !left.negative
                left.outcome <- worldPartial; left.detail <- "Negative constraint needs more evidence"
            }
            return(left)
        }
        if(edge!.looseType() and !right.hasValue and !right.hasRange and
           !(right.overlay==NUM and right.hasSize and right.size>0 and !left.hasValue)){
            left.outcome <- worldPartial; left.detail <- "Qualified scalar source value is unknown"; return(left)
        }
        if(left.overlay>=0 and right.overlay>=0 and left.overlay!=right.overlay){
            left.outcome <- worldRejected; left.detail <- "Incompatible scalar types"; return(left)
        }
        if(!edge!.looseSize() and left.hasSize and right.hasSize and left.size!=right.size){
            left.outcome <- worldRejected; left.detail <- "Incompatible scalar sizes"; return(left)
        }
        if(left.hasRange or right.hasRange){return(mergeRanges(left, right, edge))}
        if(edge!.looseType() and right.overlay==STR){return(mergeText(left, right, edge!.looseSize()))}
        if(edge!.looseType() and left.overlay==NUM and left.hasSize and !left.hasValue and right.hasValue){
            if(right.number<0 or right.number>=left.size){
                left.outcome <- worldRejected; left.detail <- "Value outside numeric range"; return(left)
            }
        }
        if(left.overlay<0){left.overlay <- right.overlay}
        if(!edge!.looseSize() and !left.hasSize and right.hasSize){
            left.hasSize <- true; left.size <- right.size
            left.explicitSize <- left.explicitSize or right.explicitSize
        }
        if(!edge!.looseSize() and left.hasSize and !right.hasSize){right.hasSize <- true; right.size <- left.size}
        left.applyExtent(); right.applyExtent()
        if(left.hasValue and right.hasValue){
            // Unsized signed displacements may agree once an extent is known.
            // Missing extent is not proof that this equality is contradictory.
            if(left.overlay==NUM and !left.hasSize and left.number!=right.number and
               ((left.number<0 and !left.extentApplied)!=(right.number<0 and !right.extentApplied))){
                left.needsEvidence <- true
                left.outcome <- worldPartial; left.detail <- "Numeric comparison needs an extent"; return(left)
            }
            if((left.overlay==NUM and left.number!=right.number) or
               (left.overlay==STR and !sameText(left, right, false))){
                left.outcome <- worldRejected; left.detail <- "Incompatible scalar values"; return(left)
            }
        }else if(right.hasValue){
            // A match uses the candidate's representation after checking the
            // target's range. Keep the target's actual size evidence separately.
            // Strict text acquisition copies the source's counted/given form.
            if(edge!.looseType() or left.overlay==STR){left.explicitSize <- right.explicitSize}
            else{left.explicitSize <- left.explicitSize or right.explicitSize}
            if(edge!.looseType() and left.overlay==STR){left.explicitSize <- !left.hasSize}
            left.hasValue <- true; left.number <- right.number; left.textSource <- right.textSource
            left.textLength <- right.textLength
            left.extentApplied <- right.extentApplied
        }
        return(left)
    }

    // A pending comparison keeps its checked source and qualified edge. Only
    // newly known scalar facts wake it; adding unrelated edges does no replay.
    void: mergeRelationship(our WorldRequest: request, our WorldFrame: frame) <- {
        me WorldScalar: before <- frame!.facts
        me WorldScalar: result <- merge(before, frame!.prerequisite!.facts, frame!.sourceEdge)
        if(result.needsEvidence){
            result <- before
            result.pendingChecks <- joinRequirements(before.pendingChecks, requirement(frame!.prerequisite, frame!.sourceEdge))
        }else if(result.outcome==worldReady and before.pendingChecks!=NULL and
                 ((before.overlay<0 and result.overlay>=0) or (!before.hasSize and result.hasSize) or
                  (!before.hasValue and result.hasValue))){
            me WorldRequirementCursor: checks; checks.push(before.pendingChecks)
            result.pendingChecks <- NULL
            our WorldRequirement: check <- checks.next()
            while(check!=NULL){
                request!.comparisonResumptions <+- 1
                me WorldScalar: checked <- merge(result, check!.frame!.facts, check!.edge)
                if(checked.needsEvidence){result.pendingChecks <- joinRequirements(result.pendingChecks, check)}
                else{
                    result <- checked
                    if(result.outcome!=worldReady){break()}
                }
                check <- checks.next()
            }
        }
        frame!.facts <- result
    }

    // Expose one unbounded gap and its anchored members. Given embedded
    // endpoints and multiple gaps need a richer alignment, not enumeration.
    our WorldOpenLayout: openLayoutOf(our WorldRequest: request, our WorldFrame: frame) <- {
        if(!representableFacts(frame!.facts) or needsRequirements(frame) or !openLayout(frame!.facts) or frame!.facts.hasSize){return(NULL)}
        our WorldOpenLayout:: layout
        me List<our WorldOpenScan>: pending
        our WorldOpenScan:: root; root!.frame <- frame; root!.members.push(frame!.facts.sequence); pending.append(root)
        while(!pending.isEmpty()){
            our WorldOpenScan: scan <- pending.last()
            if(openLayout(scan!.frame!.facts) and (scan!.frame!.facts.hasSize or !scan!.frame!.retainedWork.isEmpty())){return(NULL)}
            me WorldMember: member <- scan!.members.nextMember(false)
            if(member.frame==NULL){
                request!.sequenceVisits <+- scan!.members.visits; pending.popLast()
                if(scan!.frame!.facts.openTail){
                    if(layout!.gap!=NULL){return(NULL)}
                    layout!.gap <- scan!.frame
                }
            }else if(member.embedded){
                if(!openLayout(member.frame!.facts) and sequenceLength(member.frame!.facts.sequence)==0){continue()}
                our WorldOpenScan:: child; child!.frame <- member.frame
                child!.members.push(member.frame!.facts.sequence); pending.append(child)
            }else if(layout!.gap==NULL){layout!.prefix.append(member.frame); layout!.prefixCount <+- 1}
            else{layout!.suffix.append(member.frame); layout!.suffixCount <+- 1}
        }
        if(layout!.gap==NULL){return(NULL)}
        return(layout)
    }
    our WorldOpenAlignment: alignOpen(our WorldRequest: request, our WorldFrame: frame) <- {
        if(frame!.sourceEdge!.forceID or frame!.sourceEdge!.looseType()){return(NULL)}
        our WorldOpenLayout: left <- openLayoutOf(request, frame)
        if(left==NULL){return(NULL)}
        our WorldOpenLayout: right <- openLayoutOf(request, frame!.prerequisite)
        if(right==NULL){return(NULL)}
        // Before joining the longest prefix and suffix, exclude every shorter
        // overlap. Only an ordinary merge's contradiction is such a proof.
        our WorldOpenLayout: prefix <- left; our WorldOpenLayout: suffix <- left
        if(right!.prefixCount>left!.prefixCount){prefix <- right}
        if(right!.suffixCount>left!.suffixCount){suffix <- right}
        me int64: minimum <- max(left!.prefixCount+left!.suffixCount, right!.prefixCount+right!.suffixCount)
        me int64: frontier <- prefix!.prefixCount+suffix!.suffixCount
        withEach length in range minimum .. frontier{
            me bool: rejected <- false
            withEach pos in range length-suffix!.suffixCount .. prefix!.prefixCount{
                me WorldScalar: overlap <- merge(prefix!.prefix[pos]!.facts,
                    suffix!.suffix[pos+suffix!.suffixCount-length]!.facts, frame!.sourceEdge)
                request!.alignmentChecks <+- 1
                if(overlap.outcome==worldRejected){rejected <- true; break()}
            }
            if(!rejected){return(NULL)}
        }
        our WorldOpenAlignment:: alignment
        alignment!.leftPrefixCount <- left!.prefixCount; alignment!.leftSuffixCount <- left!.suffixCount
        alignment!.right <- right
        return(alignment)
    }

    // Semantic acceptance and work consolidation stay at the graph boundary.
    void: adoptListRequirements(our WorldFrame: frame, our WorldFrame: source) <- {
        frame!.listSpecFrame <- source!.listSpecFrame; frame!.listSpecEdge <- source!.listSpecEdge
        frame!.tailRequirements <- source!.tailRequirements
    }

    void: consumePrerequisite(our WorldRequest: request, our WorldFrame: frame) <- {
        if((frame!.prerequisite!.facts.outcome==worldPartial or frame!.prerequisite!.facts.pendingChecks!=NULL) and
           !(memberSequence(frame) and frame!.sourceIsOperand)){
            frame!.facts.outcome <- worldPartial; frame!.facts.detail <- frame!.prerequisite!.facts.detail
            if(frame!.prerequisite!.facts.pendingChecks!=NULL){frame!.facts.detail <- "Source comparison still needs evidence"}
        }else if(frame!.sourceIsListSpec){
            frame!.listSpecFrame <- frame!.prerequisite
            if(frame!.facts.openTail){frame!.tailRequirements <- requirement(frame!.prerequisite, frame!.listSpecEdge)}
        }else if(memberSequence(frame) and frame!.sourceIsOperand){
            if(frame!.facts.sequence==NULL){Allocate(frame!.facts.sequence)}
            if(!appendMember(frame!.facts.sequence, frame!.prerequisite, frame!.sourceEdge!.isSubItm)){
                frame!.facts.outcome <- worldError; frame!.facts.detail <- "List exceeds representable length"; return()
            }
            frame!.facts.representable <- frame!.facts.representable and representableFacts(frame!.prerequisite!.facts)
            frame!.facts.contentsComplete <- frame!.facts.contentsComplete and completeFacts(frame!.prerequisite!.facts, false)
            frame!.operandsRead <- sequenceLength(frame!.facts.sequence)
        }else if(frame!.sourceIsOperand){
            if(frame!.operandsRead==0){
                frame!.expression <- frame!.prerequisite!.facts
                if(frame!.expressionSlot==2 and frame!.expression.overlay==LST){adoptListRequirements(frame, frame!.prerequisite)}
            }
            else{
                frame!.expression <- appendOperand(frame!.expression, frame!.prerequisite!.facts,
                    frame!.sourceEdge!.pItem!.value!.sizeMode==fromContext)
            }
            frame!.operandsRead <+- 1
            if(frame!.expression.outcome!=worldReady){frame!.facts <- frame!.expression}
        }else{
            me WorldScalar: left <- frame!.facts
            if(frame!.openAlignment!=NULL){frame!.facts <- mergeList(left, frame!.prerequisite!.facts, frame!.sourceEdge, true)}
            else{mergeRelationship(request, frame)}
            if(frame!.facts.outcome==worldReady and !left.hasValue and frame!.facts.overlay==LST){
                // Adoption includes the requirements of members not yet present.
                adoptListRequirements(frame, frame!.prerequisite)
            }
            if(frame!.facts.outcome==worldReady and left.overlay==LST and left.hasValue and
               frame!.prerequisite!.facts.overlay==LST and frame!.prerequisite!.facts.hasValue){
                beginCorrespondence(frame, FlexNum(sequenceLength(frame!.prerequisite!.facts.sequence)))
                if(frame!.openAlignment==NULL){
                    Allocate(frame!.rightMembers); frame!.ownsRightCursor <- true
                    frame!.rightMembers!.push(frame!.prerequisite!.facts.sequence)
                }
            }
            our infonView: supplied <- frame!.sourceEdge!.pItem
            // A closed scalar leaf contributes only its checked type, size
            // and value, including the case where its value is unknown. A
            // successful qualified test adds no identity. Fully checked scalar
            // expressions supply the same facts; other nested work stays.
            me bool: scalarExpression <- supplied!.value!.evalMode==emConcat and frame!.prerequisite!.retainedWork.isEmpty() and
                (frame!.prerequisite!.facts.overlay==NUM or frame!.prerequisite!.facts.overlay==STR) and
                (frame!.prerequisite!.facts.hasValue or frame!.prerequisite!.facts.hasRange)
            // Closed correspondence checks the source endpoint. Unconstrained
            // adoption copies the whole layout and its future requirements.
            // Retain this edge below if any contribution is still unresolved.
            me bool: listSource <- frame!.prerequisite!.facts.overlay==LST and frame!.prerequisite!.facts.hasValue and
                representableFacts(frame!.prerequisite!.facts) and
                ((frame!.prerequisite!.facts.hasSize and !openLayout(frame!.prerequisite!.facts)) or
                 ((!left.hasValue and !left.hasSize or frame!.openAlignment!=NULL) and frame!.prerequisite!.retainedWork.isEmpty()))
            frame!.retainSource <- !listSource and !scalarExpression and (!supplied!.wrkList.isEmpty() or
                (supplied!.value!.evalMode!=emLiteral and supplied!.value!.evalMode!=emUnknown) or
                !frame!.prerequisite!.facts.representable)
            // A corresponding list makes one retention decision after member
            // work returns, including any unresolved obligations it discovers.
            if(!frame!.projected and !frame!.corresponding and frame!.retainSource){frame!.retainedWork.append(frame!.sourceEdge)}
        }
        frame!.prerequisite <- NULL
    }

    me bool: satisfied(our POV: target, me bool: requireSize) <- {
        return(target!.pParent==NULL and target!.viewMap.sourcePov==NULL and target!.referenceAlias.sourcePov==NULL and
           target!.pItem!.streamState!=parseStarted and target!.pItem!.streamState!=parseListReady and
           target!.pItem!.isNormed and target!.pItem!.worldScalarCompletionOwner===target!.pItem and
           (!requireSize or target!.pItem!.infSize!.evalMode==emLiteral))
    }

    void: finish(our WorldRequest: request) <- {
        me WorldScalar: facts <- request!.root!.facts
        if(facts.pendingChecks!=NULL and facts.outcome==worldReady){
            request!.outcome <- worldPartial; request!.detail <- "Scalar comparison still needs evidence"; return()
        }
        if(facts.outcome!=worldReady){request!.outcome <- facts.outcome; request!.detail <- facts.detail; return()}
        if(completeFacts(facts, request!.requireSize)){
            request!.outcome <- worldComplete
        }else{request!.outcome <- worldPartial}
        if(request!.root!.selection!=NULL and !completeFacts(facts, request!.requireSize)){
            request!.outcome <- worldPartial; request!.detail <- "Selected result still has unresolved work"; return()
        }
        publish(request)
    }

    // Prepare destination occurrences before any write. Existing literal lists
    // keep their POVs; adopted/concatenated lists get independent occurrences.
    void: publish(our WorldRequest: request) <- {
        me List<WorldPublication>: pending
        me List<WorldPublication>: writes
        me Map<our infonView, our WorldFrame>: seen
        me WorldPublication: root; root.target <- request!.target; root.frame <- request!.root; pending.append(root)
        while(!pending.isEmpty()){
            me WorldPublication: job <- pending.popLast()
            if(job.frame!.facts.outcome!=worldReady or job.frame!.facts.pendingChecks!=NULL){continue()}
            if(seen.containsKey(job.target!.pItem)){
                if(seen.at(job.target!.pItem)!==job.frame){
                    request!.outcome <- worldUnsupported
                    request!.detail <- "Shared target views need joint correspondence constraints"; return()
                }
                continue()
            }
            seen.insert(job.target!.pItem, job.frame)
            me WorldScalar: facts <- job.frame!.facts
            if(facts.overlay==LST and facts.hasValue){
                our infonState: body <- job.target!.pItem!.value
                me bool: existing <- body!.overlayType==LST and body!.evalMode==emLiteral
                if(!existing and !facts.representable){
                    request!.outcome <- worldPartial; request!.detail <- "List result still has unresolved member work"; return()
                }
                if(!existing){
                    Allocate(job.newList); body <- job.newList
                    body!.overlayType <- LST; body!.evalMode <- emLiteral
                    if(job.frame!.listSpecEdge!=NULL){body!.listSpec <- job.frame!.listSpecEdge!.pItem}
                    if(facts.explicitSize){body!.sizeMode <- fromGiven}else{body!.sizeMode <- fromCount}
                }
                our POV: targetMember <- body!.items.head
                me WorldListCursor: members; members.push(facts.sequence)
                me WorldMember: occurrence <- members.nextMember(false)
                while(occurrence.frame!=NULL){
                    our WorldFrame: member <- occurrence.frame
                    if(!existing or targetMember==NULL){
                        if(!representableFacts(member!.facts)){
                            request!.outcome <- worldPartial; request!.detail <- "New member still has unresolved work"; return()
                        }
                        our infonState: destination <- body
                        if(existing){
                            if(job.appendedList==NULL){Allocate(job.appendedList)}
                            destination <- job.appendedList
                        }
                        our infonView:: item
                        item!.viewMode <- vmAny; item!.itmMode <- mItem; item!.streamState <- parseDone
                        item!.infSize!.overlayType <- NUM; item!.infSize!.evalMode <- emUnknown
                        item!.value!.evalMode <- emUnknown; item!.value!.overlayType <- tUnknown
                        item!.orderMode <- member!.node!.pItem!.orderMode
                        targetMember <- destination!.items.append(item, occurrence.embedded, 933); targetMember!.pParent <- job.target
                    }
                    me WorldPublication: child; child.target <- targetMember; child.frame <- member; pending.append(child)
                    if(existing){targetMember <- targetMember!.next}
                    occurrence <- members.nextMember(false)
                }
                request!.sequenceVisits <+- members.visits
            }
            writes.append(job)
        }
        withEach job in writes{publishFrame(request, job)}
    }

    void: publishFrame(our WorldRequest: request, me WorldPublication: job) <- {
        our WorldFrame: frame <- job.frame
        our infonView: item <- job.target!.pItem
        me WorldScalar: facts <- frame!.facts
        if(frame!.selection!=NULL){
            item!.innr <- NULL; item!.intersectPos <- ipNoIntersect
            item!.hasInnrOutr <- false; item!.intersectMarkedRetPOV <- NULL
        }
        if(job.newList!=NULL){item!.value <- job.newList}
        // Detached suffixes join the target only after every destination has
        // passed publication checks, preserving the original prefix POVs.
        if(job.appendedList!=NULL){
            our POV: member <- job.appendedList!.items.head
            while(member!=NULL){
                our POV: next <- member!.next
                item!.value!.items.appendPov(member); member <- next
            }
        }
        if(facts.overlay==LST){item!.value!.tailUnfinished <- facts.openTail}
        if(facts.overlay==LST and !openLayout(facts) and facts.dischargeListSpec and facts.hasSize and
           facts.size==FlexNum(sequenceLength(facts.sequence))){item!.value!.listSpec <- NULL}
        // An unresolved expression is still the representation of its partial
        // result. Type evidence alone must not turn its body into 0 or ''.
        if(item!.value!.evalMode==emConcat and !facts.hasValue and !facts.hasRange){return()}
        me bool: sameView <- item===frame!.node!.pItem
        if(sameView and item!.infSize!.evalMode!=emConcat and facts.hasRange and frame!.bodyBounds.same(facts.bounds()) and
           frame!.bodyHasSize==facts.hasSize and (!facts.hasSize or frame!.bodySize==facts.size)){
            // The existing expression already represents these facts. Only
            // discharge work, without allocating an equivalent partial body.
            if(item!.wrkList.size()!=frame!.retainedWork.size()){
                item!.wrkList <- frame!.retainedWork; request!.publications <+- 1
            }
            return()
        }
        // Scalar states may be shared by other views. Publish through fresh
        // state objects, never overwrite another occurrence's borrowed payload.
        me bool: changedRange <- facts.hasRange and (!sameView or !frame!.bodyBounds.same(facts.bounds()))
        if(facts.overlay!=LST){
            our infonState:: nextValue; nextValue! <- item!.value!; item!.value <- nextValue
        }
        our infonState:: nextSize; nextSize! <- item!.infSize!; item!.infSize <- nextSize
        if(facts.overlay>=0){
            item!.viewMode <- vmOverlay
            if(!facts.hasRange and facts.overlay!=LST){item!.value!.overlayType <- facts.overlay}
        }
        if(facts.hasSize){
            item!.infSize!.overlayType <- NUM; item!.infSize!.evalMode <- emLiteral; item!.infSize!.num <- facts.size
            item!.infSize!.items.clear()
        }
        if(facts.hasValue and facts.overlay!=LST){
            item!.value!.evalMode <- emLiteral
            item!.value!.items.clear()
            item!.value!.num <- facts.number
            if(facts.overlay==STR){
                me WorldTextCursor: text; text.push(facts.textSource, facts.textLength)
                item!.value!.str <- ""
                withEach pos in range 0 .. facts.textLength{item!.value!.str <+- text.next()}
                request!.publishedTextBytes <+- facts.textLength
                request!.publishedTextNodes <+- text.visits
            }
            item!.value!.inverted <- false
            item!.value!.numericExtentApplied <- facts.extentApplied
        }
        if(changedRange){
            item!.value!.overlayType <- LST; item!.value!.evalMode <- emConcat
            item!.value!.items.clear()
            withEach part in range 0 .. 2{
                our infonView:: term
                term!.viewMode <- vmOverlay; term!.itmMode <- mItem; term!.streamState <- parseDone
                term!.infSize!.overlayType <- NUM; term!.value!.overlayType <- NUM
                if(part==0){
                    term!.infSize!.evalMode <- emLiteral; term!.infSize!.num <- facts.upper-facts.lower
                    term!.value!.evalMode <- emUnknown; term!.value!.sizeMode <- fromGiven
                }else{
                    term!.infSize!.evalMode <- emUnknown
                    term!.value!.evalMode <- emLiteral; term!.value!.num <- facts.lower
                    term!.value!.sizeMode <- fromContext
                }
                our POV: operand <- item!.value!.items.append(term, false, 932)
                operand!.pParent <- job.target
            }
        }
        if(facts.overlay!=LST){
            if(facts.explicitSize){item!.value!.sizeMode <- fromGiven}
            else{item!.value!.sizeMode <- fromCount}
        }
        item!.invertMatch <- facts.negative
        // Discharge represented work even if no value was supplied. Exhausted
        // unknowns remain partial; removing a tautology does not invent a value.
        item!.wrkList <- frame!.retainedWork
        request!.publications <+- 1
        if(completeFacts(facts, request!.requireSize and job.target===request!.target)){
            item!.isNormed <- true; item!.worldScalarCompletionOwner <- item
        }
    }
}

struct WorldManager {
    our WorldControl: control
    void: INIT() <- {Allocate(control)}
    me WorldPOVGraph: graph

    // Parser readiness and wait registration use the same model lock.
    void: prepareInput(our infonView: item) <- {
        me WorldModelLock: lock{control!.mutex}
        item!.streamState <- parseStarted; item!.graphParseError <- ""
    }
    void: failInput(our infonView: item, me string: message) <- {
        me WorldModelLock: lock{control!.mutex}
        item!.graphParseError <- message; item!.streamState <- parseDone
        inputReady(item)
    }
    void: setOrigin(our infonView: item, me uint64: origin) <- {
        me WorldModelLock: lock{control!.mutex}
        item!.originID <- origin
    }
    void: inputReady(our infonView: item) <- {
        me WorldModelLock: lock{control!.mutex}
        if(!control!.inputWaiters.containsKey(item)){return()}
        our WorldInputWaiters: waiters <- control!.inputWaiters.at(item)
        control!.inputWaiters.erase(item)
        withEach request in waiters!.requests{
            if(request!.outcome==worldWaiting and request!.waitingInput===item){
                request!.waitingInput <- NULL
                request!.ready.append(request!.waitingFrame); request!.waitingFrame <- NULL
                request!.outcome <- worldReady; request!.detail <- ""
                run(request)
            }
        }
    }

    // Closed parsing uses the existing parser without constructing the old engine.
    me WorldParseResult: parse(me string: source) <- {
        me WorldParseResult: result
        me ProteusParser: parser{NULL, false, 0}
        parser.initParseFromString("WorldManager", source)
        our infonView:: item
        parser.doParse(item)
        if(parser.doesParseHaveError()){result.error <- parser.formattedError(); return(result)}
        Allocate(result.target, 930); result.target!.pItem <- item
        return(result)
    }

    our WorldFrame: makeFrame(our WorldRequest: request, our POV: node, our WorldPosition: context <- NULL) <- {
        our WorldFrame:: frame
        frame!.node <- node
        frame!.context <- context
        if(context!=NULL){
            frame!.expressionParent <- node!.pParent; frame!.parentContext <- context!.parent
            if(request!.activeContexts.containsKey(node!.pItem)){
                frame!.initialized <- true; frame!.facts.outcome <- worldUnsupported
                frame!.facts.detail <- "Cyclic contextual prerequisites need a joint proof"
            }else{request!.activeContexts.insert(node!.pItem, frame)}
        }
        else{request!.attempts.insert(node!.pItem, frame)}
        request!.framesCreated <+- 1
        return(frame)
    }

    // Partial prerequisites return to their caller. A containing list can
    // keep that member partial and continue its other requested members.
    void: stopFrame(our WorldRequest: request, our WorldFrame: frame) <- {
        if(frame!.facts.outcome==worldPartial){frame!.finished <- true}
        else{request!.outcome <- frame!.facts.outcome; request!.detail <- frame!.facts.detail}
    }

    // Correspondence and listSpec projection share the same derived relationship.
    // Source frames stay immutable; each occurrence holds its own combined facts.
    our WorldFrame: projectFrame(our WorldRequest: request, our WorldFrame: left) <- {
        our WorldFrame:: pair
        pair!.node <- left!.node; pair!.facts <- left!.facts
        pair!.selection <- left!.selection
        pair!.retainedWork <- left!.retainedWork
        pair!.listSpecFrame <- left!.listSpecFrame; pair!.listSpecEdge <- left!.listSpecEdge
        pair!.tailRequirements <- left!.tailRequirements; pair!.pendingRequirements <- left!.pendingRequirements
        pair!.bodyBounds <- left!.bodyBounds; pair!.bodyHasSize <- left!.bodyHasSize; pair!.bodySize <- left!.bodySize
        pair!.initialized <- true; pair!.projected <- true
        request!.framesCreated <+- 1
        return(pair)
    }

    our WorldFrame: derivePair(our WorldRequest: request, our WorldFrame: left,
                              our WorldFrame: right, our POV: edge) <- {
        our WorldFrame: pair <- projectFrame(request, left)
        pair!.sourceEdge <- edge; pair!.prerequisite <- right
        return(pair)
    }

    our WorldFrame: projectListSpec(our WorldRequest: request, our WorldFrame: left,
                                   our WorldFrame: spec, our POV: edge) <- {
        our WorldFrame: pair <- projectFrame(request, left)
        pair!.pendingRequirements <- graph.joinRequirements(pair!.pendingRequirements, graph.requirement(spec, edge))
        pair!.facts.contentsComplete <- false
        return(pair)
    }

    // Batch pending ancestor projections through each wrapper. Only semantic
    // consumers demand this walk; structural containment can carry it onward.
    our WorldFrame: resolveRequirements(our WorldRequest: request, our WorldFrame: left,
                                       our WorldRequirement: inherited <- NULL) <- {
        our WorldFrame: pair <- projectFrame(request, left)
        graph.beginRequirements(pair, inherited)
        return(pair)
    }

    me bool: applyMemberRequirement(our WorldRequest: request, our WorldFrame: frame) <- {
        if(frame!.pairedMember!.facts.outcome!=worldReady){return(false)}
        me uint64: before <- frame!.memberRequirements.visits
        our WorldRequirement: requirement <- frame!.memberRequirements.next()
        request!.requirementVisits <+- frame!.memberRequirements.visits-before
        if(requirement==NULL){return(false)}
        frame!.pairedMember <- derivePair(request, frame!.pairedMember, requirement!.frame, requirement!.edge)
        request!.templateApplications <+- 1; request!.ready.append(frame!.pairedMember)
        return(true)
    }

    // A pair is a derived strict member relationship, evaluated by the same
    // merge operation. Nested lists return here through the retained stack.
    void: correspond(our WorldRequest: request, our WorldFrame: frame) <- {
        if(frame!.pairedMember!=NULL){
            if(applyMemberRequirement(request, frame)){return()}
            frame!.memberRequirements <- WorldRequirementCursor()
            if(frame!.pairedEmbedded and frame!.pairedMember!.facts.outcome==worldPartial){
                frame!.facts.outcome <- worldPartial; frame!.facts.detail <- frame!.pairedMember!.facts.detail; return()
            }
            if(!graph.appendMember(frame!.pairedSequence, frame!.pairedMember, frame!.pairedEmbedded)){
                request!.outcome <- worldError; request!.detail <- "List exceeds representable length"; return()
            }
            frame!.facts.contentsComplete <- frame!.facts.contentsComplete and graph.completeFacts(frame!.pairedMember!.facts, false)
            frame!.facts.representable <- frame!.facts.representable and graph.representableFacts(frame!.pairedMember!.facts)
            frame!.pairedMember <- NULL
        }
        me WorldMember: left <- frame!.leftMembers.nextMember(false)
        if(left.frame==NULL and frame!.extendingTail and frame!.openAlignment!=NULL){
            our WorldOpenAlignment: alignment <- frame!.openAlignment
            alignment!.pastGap <- true
            me int64: prefixIndex <- alignment!.leftPrefixCount+alignment!.addedPrefix
            me int64: extraSuffix <- alignment!.right!.suffixCount-alignment!.leftSuffixCount
            if(extraSuffix<0){extraSuffix <- 0}
            our WorldFrame: member
            frame!.pairedEmbedded <- false
            if(prefixIndex<alignment!.right!.prefixCount){
                member <- alignment!.right!.prefix[prefixIndex]; alignment!.addedPrefix <+- 1
            }else if(extraSuffix>0 and !alignment!.remainderAdded){
                // An incoming suffix moves the unresolved tail inside this
                // occurrence. Retain a symbolic span, never invent its width.
                member <- projectFrame(request, frame)
                Allocate(member!.facts.sequence); member!.facts.hasSize <- false
                member!.facts.openTail <- true; member!.facts.contentsComplete <- false
                member!.retainedWork.clear(); member!.listSpecFrame <- NULL; member!.listSpecEdge <- NULL
                member!.tailRequirements <- graph.joinRequirements(frame!.tailRequirements, alignment!.right!.gap!.tailRequirements)
                member!.finished <- true; frame!.pairedEmbedded <- true
                alignment!.remainderAdded <- true
            }else if(alignment!.addedSuffix<extraSuffix){
                member <- alignment!.right!.suffix[alignment!.addedSuffix]; alignment!.addedSuffix <+- 1
            }
            if(member!=NULL){
                frame!.pairedMember <- member
                if(!frame!.pairedEmbedded){
                    request!.tailMembers <+- 1; frame!.memberRequirements.push(frame!.tailRequirements)
                    applyMemberRequirement(request, frame)
                }
                return()
            }
            frame!.extendingTail <- false; frame!.facts.openTail <- extraSuffix==0
            if(frame!.facts.openTail){frame!.tailRequirements <- graph.joinRequirements(frame!.tailRequirements, alignment!.right!.gap!.tailRequirements)}
        }
        if(left.frame==NULL and frame!.extendingTail){
            // The closed source proved the extent. Continue its cursor for
            // the unique remainder; never enumerate from a declared size.
            our WorldFrame: member
            if(frame!.remaining>0){member <- frame!.rightMembers!.next()}
            if(member!=NULL){
                frame!.remaining <- frame!.remaining-1
                frame!.pairedEmbedded <- false; request!.tailMembers <+- 1
                frame!.pairedMember <- member
                frame!.memberRequirements.push(frame!.tailRequirements)
                applyMemberRequirement(request, frame)
                return()
            }
            frame!.extendingTail <- false; frame!.facts.openTail <- false
        }
        if(left.frame==NULL){
            frame!.facts.sequence <- frame!.pairedSequence; frame!.pairedSequence <- NULL
            frame!.pendingRequirements <- NULL
            if(!frame!.applyingListSpec and frame!.openAlignment==NULL and frame!.remaining!=0){
                request!.outcome <- worldError; request!.detail <- "Correspondence source ended before its checked extent"; return()
            }
            if(frame!.openAlignment!=NULL and graph.openLayout(frame!.facts) and frame!.openAlignment!.right!.gap!.tailRequirements!=NULL){
                // Future source requirements still need their containing
                // relationship in the stored partial result.
                frame!.facts.representable <- false
            }
            frame!.facts.dischargeListSpec <- frame!.facts.representable and !graph.openLayout(frame!.facts)
            if(!frame!.projected and !frame!.applyingListSpec and (frame!.retainSource or !frame!.facts.representable)){
                frame!.retainedWork.append(frame!.sourceEdge)
            }
            request!.sequenceVisits <+- frame!.leftMembers.visits
            if(frame!.ownsRightCursor){request!.sequenceVisits <+- frame!.rightMembers!.visits}
            frame!.leftMembers <- WorldListCursor(); frame!.rightMembers <- NULL; frame!.ownsRightCursor <- false
            frame!.corresponding <- false; frame!.applyingListSpec <- false; frame!.openAlignment <- NULL
        }else{
            our WorldFrame: pair
            if(left.embedded){
                // Preserve the left wrapper; its leaves continue the same RHS cursor.
                if(frame!.applyingListSpec){
                    pair <- resolveRequirements(request, left.frame, frame!.pendingRequirements)
                }else{
                    pair <- projectFrame(request, left.frame)
                    pair!.sourceEdge <- frame!.sourceEdge; pair!.rightMembers <- frame!.rightMembers
                    pair!.openAlignment <- frame!.openAlignment
                    me FlexNum: extent <- graph.minimumWidth(left.frame!.facts)
                    if(left.frame!.facts.hasSize){extent <- left.frame!.facts.size}
                    else if(graph.freeSpans(left.frame!.facts)>0){extent <+- frame!.gapWidth}
                    graph.beginCorrespondence(pair, extent)
                    frame!.remaining <- frame!.remaining-extent
                    if(pair!.facts.outcome==worldReady and pair!.openAlignment==NULL){pair!.facts.hasSize <- true; pair!.facts.size <- extent}
                }
            }else{
                if(frame!.applyingListSpec){
                    frame!.pairedMember <- left.frame; frame!.pairedEmbedded <- false
                    frame!.memberRequirements.push(frame!.pendingRequirements)
                    applyMemberRequirement(request, frame); return()
                }
                if(frame!.openAlignment!=NULL){
                    our WorldOpenAlignment: alignment <- frame!.openAlignment
                    our WorldFrame: right
                    if(!alignment!.pastGap){
                        if(alignment!.prefixPosition<alignment!.right!.prefixCount){right <- alignment!.right!.prefix[alignment!.prefixPosition]}
                        alignment!.prefixPosition <+- 1
                    }else{
                        me int64: index <- alignment!.suffixPosition+alignment!.right!.suffixCount-alignment!.leftSuffixCount
                        if(index>=0){right <- alignment!.right!.suffix[index]}
                        alignment!.suffixPosition <+- 1
                    }
                    if(right!=NULL){pair <- derivePair(request, left.frame, right, frame!.sourceEdge); request!.memberPairs <+- 1}
                    else{
                        frame!.pairedMember <- left.frame; frame!.pairedEmbedded <- false
                        frame!.memberRequirements.push(alignment!.right!.gap!.tailRequirements)
                        applyMemberRequirement(request, frame); return()
                    }
                }else{
                    our WorldFrame: right <- frame!.rightMembers!.next()
                    frame!.remaining <- frame!.remaining-1; request!.memberPairs <+- 1
                    pair <- derivePair(request, left.frame, right, frame!.sourceEdge)
                }
            }
            frame!.pairedMember <- pair; frame!.pairedEmbedded <- left.embedded
            request!.ready.append(pair)
        }
    }

    // One step either discovers one edge, consumes its result, or finishes a frame.
    void: waitAt(our WorldRequest: request, our WorldFrame: frame, our infonView: input) <- {
        request!.outcome <- worldWaiting; request!.waitingFrame <- frame; request!.waitingInput <- input
        if(!control!.inputWaiters.containsKey(input)){
            our WorldInputWaiters:: waiters; control!.inputWaiters.insert(input, waiters)
        }
        control!.inputWaiters.at(input)!.requests.append(request)
    }
    me bool: walkReady(our WorldRequest: request, our WorldFrame: frame, our WorldWalk: walk) <- {
        if(walk!.outcome==worldReady){return(true)}
        if(walk!.outcome==worldWaiting){waitAt(request, frame, walk!.waiting)}
        else{frame!.facts.outcome <- walk!.outcome; frame!.facts.detail <- walk!.detail; stopFrame(request, frame)}
        return(false)
    }
    // Intersection syntax only exposes the selected occurrence and its input
    // relationship. That occurrence uses ordinary RHS discovery and solving.
    void: selectMember(our WorldRequest: request, our WorldFrame: frame) <- {
        our infonView: item <- frame!.node!.pItem
        if(frame!.selection==NULL){
            me WorldScalar: header <- graph.read(frame!.node, frame!.expressionParent, false, true)
            if(header.outcome==worldWaiting){waitAt(request, frame, item); return()}
            if(header.outcome!=worldReady){frame!.facts <- header; stopFrame(request, frame); return()}
            if(item!.innr!=NULL and (item!.innr!.value==NULL or item!.innr!.infSize==NULL)){
                frame!.facts.outcome <- worldError; frame!.facts.detail <- "Missing intersection body state"; stopFrame(request, frame); return()
            }
            if(item!.innr==NULL or item!.isOrLike() or item!.type!=NULL or !item!.addedTypes.isEmpty() or
               item!.invertMatch or item!.funcArgs!=NULL or item!.argPos!=apNoArgs or item!.partRef!=NULL or !item!.parts.isEmpty()){
                frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Intersection needs additional selection semantics"; stopFrame(request, frame); return()
            }
            Allocate(frame!.selection)
            our POV:: body{936}; body!.pItem <- item!.innr
            our WorldPosition: root <- graph.position(body)
            if(item!.hasInnrOutr and item!.innr!.funcArgs!=NULL){
                Allocate(root!.input, 936); root!.input!.pItem <- item!.innr!.funcArgs; root!.input!.looseTop <- true
            }
            frame!.selection!.walk!.push(root)
            if(item!.innr!.value!.sizeMode==fromGiven){
                if(item!.innr!.infSize!.evalMode!=emLiteral or item!.innr!.infSize!.num<=0 or item!.innr!.infSize!.num.getDenominator()!=1){
                    frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Selection needs a positive known position"; stopFrame(request, frame); return()
                }
                frame!.selection!.index <- item!.innr!.infSize!.num
            }else if(item!.intersectPos==ipGetFirst){frame!.selection!.index <- 1}
        }
        our WorldSelection: selection <- frame!.selection
        while(!selection!.located){
            our WorldPosition: at <- graph.nextPosition(request, selection!.walk)
            if(!walkReady(request, frame, selection!.walk)){return()}
            if(at==NULL){
                if(selection!.lastTail or (item!.intersectPos==ipGetMarked and selection!.selected==NULL)){
                    frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Selected position needs open-span selection"; stopFrame(request, frame); return()
                }
                if(selection!.selected==NULL){
                    frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Selected position is not established"; stopFrame(request, frame); return()
                }
                selection!.located <- true; break()
            }
            if(at!.tail){
                if(selection!.index>0){frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Indexed selection crosses an unknown span"; stopFrame(request, frame); return()}
                selection!.lastTail <- true; continue()
            }
            selection!.position <+- 1; selection!.lastTail <- false
            if(item!.intersectPos==ipGetMarked){
                if(at!.node===item!.intersectMarkedRetPOV or at!.node===item!.innr!.intersectMarkedRetPOV){selection!.selected <- at; selection!.located <- true}
            }else if(selection!.index>0){
                if(selection!.position==selection!.index){selection!.selected <- at; selection!.located <- true}
            }else{selection!.selected <- at}
        }
        frame!.prerequisite <- makeFrame(request, selection!.selected!.node, selection!.selected)
        frame!.prerequisite!.demandSize <- frame!.demandSize
        frame!.selecting <- true; frame!.initialized <- true; frame!.expressionSlot <- 3
        request!.ready.append(frame); request!.ready.append(frame!.prerequisite)
    }

    // Return a read-only RHS for this member; neither containing list is a
    // value-normalization prerequisite. The two cursors survive local waits.
    void: locateRHS(our WorldRequest: request, our WorldFrame: frame) <- {
        our WorldLookup: lookup <- frame!.lookup
        while(true){
            if(lookup!.lhs==NULL){
                lookup!.lhs <- graph.nextPosition(request, lookup!.left)
                if(!walkReady(request, frame, lookup!.left)){return()}
            }
            if(lookup!.lhs==NULL){
                if(lookup!.found==NULL){frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "No corresponding member established"; stopFrame(request, frame); return()}
                our POV: edge <- graph.memberRelationship(lookup!.edge); edge!.pItem <- lookup!.found!.node!.pItem
                frame!.sourceEdge <- edge; frame!.sourceIsOperand <- false; frame!.sourceIsListSpec <- false
                frame!.prerequisite <- lookup!.foundFacts
                if(frame!.prerequisite==NULL){frame!.prerequisite <- makeFrame(request, lookup!.found!.node, lookup!.found)}
                frame!.lookup <- NULL; request!.relationshipsRead <+- 1
                request!.ready.append(frame)
                if(!frame!.prerequisite!.finished){request!.ready.append(frame!.prerequisite)}
                return()
            }
            if(lookup!.lhs!.tail){
                if(!lookup!.matching or lookup!.lhs!.node!.pItem!.value!.listSpec==NULL or
                   lookup!.lhs!.node!.pItem!.value!.sizeMode==fromGiven){
                    frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Requested correspondence crosses an unresolved pattern span"; stopFrame(request, frame); return()
                }
                if(lookup!.repeat==NULL){
                    our POV:: spec{937}; spec!.pItem <- lookup!.lhs!.node!.pItem!.value!.listSpec
                    lookup!.repeat <- makeFrame(request, spec)
                    request!.ready.append(frame); request!.ready.append(lookup!.repeat); return()
                }
                if(lookup!.afterRepeat==NULL){
                    lookup!.afterRepeat <- graph.nextPosition(request, lookup!.left)
                    if(!walkReady(request, frame, lookup!.left)){return()}
                    if(lookup!.afterRepeat==NULL or lookup!.afterRepeat!.tail){
                        frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Repeated correspondence needs a distinct following predicate"; stopFrame(request, frame); return()
                    }
                }
                if(lookup!.exitPredicate==NULL){
                    if(graph.samePosition(lookup!.afterRepeat, lookup!.target)){
                        lookup!.exitPredicate <- projectFrame(request, frame); lookup!.exitPredicate!.finished <- true
                    }else{
                        lookup!.exitPredicate <- makeFrame(request, lookup!.afterRepeat!.node, lookup!.afterRepeat)
                        lookup!.exitPredicate!.predicateOnly <- true
                        request!.ready.append(frame); request!.ready.append(lookup!.exitPredicate); return()
                    }
                }
                if(!lookup!.repeatChecked){
                    request!.correspondenceChecks <+- 1
                    me WorldScalar: overlap <- graph.matchPosition(lookup!.repeat!.facts, lookup!.exitPredicate!.facts, lookup!.memberEdge)
                    if(overlap.outcome!=worldRejected){
                        frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Overlapping pattern alternatives need span alignment"; stopFrame(request, frame); return()
                    }
                    lookup!.repeatChecked <- true
                }
                lookup!.predicate <- lookup!.repeat
            }
            if(lookup!.rhs==NULL){
                lookup!.rhs <- graph.nextPosition(request, lookup!.right)
                if(!walkReady(request, frame, lookup!.right)){return()}
            }
            if(lookup!.rhs==NULL or lookup!.rhs!.tail){
                frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Correspondence needs more source positions"; stopFrame(request, frame); return()
            }
            me bool: selected <- graph.samePosition(lookup!.lhs, lookup!.target)
            if(lookup!.matching){
                if(lookup!.predicate==NULL){
                    if(selected){lookup!.predicate <- projectFrame(request, frame); lookup!.predicate!.finished <- true}
                    else{
                        lookup!.predicate <- makeFrame(request, lookup!.lhs!.node, lookup!.lhs)
                        lookup!.predicate!.predicateOnly <- true
                        request!.ready.append(frame); request!.ready.append(lookup!.predicate); return()
                    }
                }
                me WorldScalar: actual
                me bool: headerOnly <- graph.typePredicate(lookup!.predicate!.facts) and lookup!.rhs!.node!.pItem!.wrkList.isEmpty()
                our WorldPosition: parent <- lookup!.rhs!.parent
                while(headerOnly and parent!=NULL){
                    if(parent!.node!.pItem!.value!.listSpec!=NULL or !parent!.node!.pItem!.wrkList.isEmpty() or parent!.input!=NULL){headerOnly <- false}
                    if(!parent!.node!.isSubItm){break()}
                    parent <- parent!.parent
                }
                if(headerOnly){
                    actual <- graph.read(lookup!.rhs!.node, lookup!.rhs!.node!.pParent)
                    if(actual.outcome==worldWaiting){waitAt(request, frame, lookup!.rhs!.node!.pItem); return()}
                    if(actual.outcome==worldReady and actual.overlay<0){headerOnly <- false}
                }
                if(!headerOnly){
                    if(lookup!.candidate==NULL){
                        lookup!.candidate <- makeFrame(request, lookup!.rhs!.node, lookup!.rhs)
                        request!.ready.append(frame); request!.ready.append(lookup!.candidate); return()
                    }
                    actual <- lookup!.candidate!.facts
                }
                request!.correspondenceChecks <+- 1
                me WorldScalar: matched <- graph.matchPosition(lookup!.predicate!.facts, actual, lookup!.memberEdge, lookup!.lhs!.tail)
                if(lookup!.lhs!.tail){
                    if(matched.outcome==worldReady and !matched.needsEvidence){
                        lookup!.rhs <- NULL; lookup!.candidate <- NULL; continue()
                    }
                    if(matched.outcome==worldRejected){
                        lookup!.lhs <- lookup!.afterRepeat; lookup!.predicate <- lookup!.exitPredicate
                        lookup!.repeat <- NULL; lookup!.afterRepeat <- NULL; lookup!.exitPredicate <- NULL; lookup!.repeatChecked <- false
                        continue()
                    }
                }
                if(matched.outcome!=worldReady or matched.needsEvidence){
                    frame!.facts.outcome <- matched.outcome; frame!.facts.detail <- matched.detail
                    if(matched.needsEvidence){frame!.facts.outcome <- worldPartial}
                    stopFrame(request, frame); return()
                }
            }
            if(selected){lookup!.found <- lookup!.rhs; lookup!.foundFacts <- lookup!.candidate}
            lookup!.lhs <- NULL; lookup!.rhs <- NULL; lookup!.predicate <- NULL; lookup!.candidate <- NULL
            // An asserted list identity establishes position; no unrelated
            // value checks are requested. Pattern input still checks its suffix.
            if(selected and !lookup!.matching){lookup!.left!.levels.clear()}
        }
    }
    me bool: requestParentRHS(our WorldRequest: request, our WorldFrame: frame) <- {
        while(frame!.parentContext!=NULL){
            our WorldPosition: parent <- frame!.parentContext
            our infonView: item <- parent!.node!.pItem
            me WorldScalar: parentHeader <- graph.read(parent!.node, parent!.node!.pParent, parent!.input!=NULL)
            if(parentHeader.outcome==worldWaiting){waitAt(request, frame, item); return(true)}
            if(parentHeader.outcome!=worldReady){frame!.facts <- parentHeader; stopFrame(request, frame); return(true)}
            if(frame!.parentWork<0){
                frame!.parentWork <- 0
                if(item!.value!.listSpec!=NULL){
                    our POV:: spec{937}; spec!.pItem <- item!.value!.listSpec
                    frame!.sourceEdge <- spec; frame!.sourceIsOperand <- false; frame!.sourceIsListSpec <- false
                    frame!.prerequisite <- makeFrame(request, spec)
                    request!.relationshipsRead <+- 1
                    request!.ready.append(frame); request!.ready.append(frame!.prerequisite); return(true)
                }
            }
            our POV: relation
            me bool: input <- false
            if(!frame!.predicateOnly and parent!.input!=NULL and frame!.parentWork==0){relation <- parent!.input; input <- true; frame!.parentWork <+- 1}
            else{
                me int64: index <- frame!.parentWork
                if(parent!.input!=NULL){index <- index-1}
                if(!frame!.predicateOnly and !graph.completeFacts(frame!.facts, frame!.demandSize) and index<item!.wrkList.size()){
                    relation <- item!.wrkList[index]; frame!.parentWork <+- 1
                    if(relation==NULL){frame!.facts.outcome <- worldError; frame!.facts.detail <- "Empty parent relationship"; stopFrame(request, frame); return(true)}
                }
            }
            if(relation!=NULL){
                if(relation!.pParent!=NULL){frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Contextual parent RHS needs occurrence projection"; stopFrame(request, frame); return(true)}
                if(relation!.forceID){frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Replacement correspondence is not implemented"; stopFrame(request, frame); return(true)}
                me WorldScalar: leftHeader <- parentHeader
                me WorldScalar: rightHeader <- graph.read(relation, relation!.pParent)
                if(!input and leftHeader.outcome==worldReady and rightHeader.outcome==worldReady and
                   leftHeader.hasSize and rightHeader.hasSize and
                   ((!relation!.looseSize() and leftHeader.size!=rightHeader.size) or (relation!.looseSize() and leftHeader.size>rightHeader.size))){
                    frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Parent endpoints need span alignment"; stopFrame(request, frame); return(true)
                }
                Allocate(frame!.lookup); frame!.lookup!.target <- frame!.context; frame!.lookup!.edge <- relation
                frame!.lookup!.matching <- input; frame!.lookup!.memberEdge <- graph.memberRelationship(relation)
                frame!.lookup!.left!.push(parent); frame!.lookup!.right!.push(graph.position(relation))
                request!.parentLookups <+- 1; request!.ready.append(frame); return(true)
            }
            // An embedded parent's coordinates belong to the enclosing list.
            if(parent!.node!.isSubItm){frame!.parentContext <- parent!.parent; frame!.parentWork <- -1}
            else{frame!.parentContext <- NULL}
        }
        return(false)
    }

    void: step(our WorldRequest: request, our WorldFrame: frame) <- {
        if(!frame!.initialized and frame!.node!.pItem!.value!=NULL and frame!.node!.pItem!.value!.evalMode==emIntersection){selectMember(request, frame); return()}
        if(!frame!.initialized){
            frame!.facts <- graph.read(frame!.node, frame!.expressionParent)
            // A pending header has not been inspected. Resume this exact read,
            // preserving all earlier frames and relationship cursors.
            if(frame!.facts.outcome==worldWaiting){
                request!.waitingFrame <- frame; request!.waitingInput <- frame!.node!.pItem
                if(!control!.inputWaiters.containsKey(request!.waitingInput)){
                    our WorldInputWaiters:: waiters
                    control!.inputWaiters.insert(request!.waitingInput, waiters)
                }
                control!.inputWaiters.at(request!.waitingInput)!.requests.append(request)
            }else{frame!.initialized <- true}
        }
        if(frame!.facts.outcome!=worldReady){
            stopFrame(request, frame); return()
        }
        if(frame!.lookup!=NULL){locateRHS(request, frame); return()}
        if(frame!.selecting and frame!.prerequisite!=NULL){
            frame!.facts <- frame!.prerequisite!.facts
            frame!.retainedWork <- frame!.prerequisite!.retainedWork
            graph.adoptListRequirements(frame, frame!.prerequisite)
            frame!.prerequisite <- NULL; frame!.selecting <- false
            if(frame!.facts.outcome!=worldReady){stopFrame(request, frame); return()}
        }
        if(frame!.prerequisite!=NULL){
            if(graph.needsRequirements(frame!.prerequisite) and
               !(frame!.sourceIsOperand and graph.memberSequence(frame) and frame!.sourceEdge!.isSubItm)){
                frame!.prerequisite <- resolveRequirements(request, frame!.prerequisite)
                request!.ready.append(frame); request!.ready.append(frame!.prerequisite); return()
            }
            if(frame!.sourceIsOperand and graph.memberSequence(frame) and frame!.sourceEdge!.isSubItm and
               !graph.checkEmbedded(frame)){stopFrame(request, frame); return()}
            if(frame!.sourceIsOperand and graph.memberSequence(frame) and
               frame!.listSpecFrame!=NULL and !frame!.memberSpecified and
               frame!.prerequisite!.facts.outcome==worldReady){
                if(frame!.sourceEdge!.isSubItm){
                    frame!.prerequisite <- projectListSpec(request, frame!.prerequisite, frame!.listSpecFrame, frame!.listSpecEdge)
                }else{
                    frame!.prerequisite <- derivePair(request, frame!.prerequisite, frame!.listSpecFrame, frame!.listSpecEdge)
                    request!.templateApplications <+- 1
                }
                frame!.memberSpecified <- true
                request!.ready.append(frame); request!.ready.append(frame!.prerequisite); return()
            }
            // A closed target proves the endpoint of a strict open source.
            // Project that source with the same correspondence operation, then
            // merge its checked result back into the original target shape.
            if(!frame!.sourceIsOperand and !frame!.sourceIsListSpec and
               !frame!.sourceEdge!.forceID and !frame!.sourceEdge!.looseType() and
               frame!.facts.overlay==LST and frame!.facts.hasValue and frame!.facts.hasSize and
               !graph.openLayout(frame!.facts) and frame!.facts.size==FlexNum(graph.sequenceLength(frame!.facts.sequence)) and
               frame!.prerequisite!.facts.outcome==worldReady and frame!.prerequisite!.facts.overlay==LST and
               frame!.prerequisite!.facts.hasValue and graph.openLayout(frame!.prerequisite!.facts)){
                our WorldFrame: endpoint <- projectFrame(request, frame); endpoint!.finished <- true
                // Nonnegative widths summing to zero are all zero. The checked
                // header proves emptiness without unfolding shared source spans.
                me bool: emptyProof <- false
                if(frame!.facts.size==0 and graph.representableFacts(frame!.prerequisite!.facts)){
                    me WorldScalar: bounded <- graph.fitExtent(frame!.prerequisite!.facts, FlexNum())
                    emptyProof <- bounded.outcome==worldReady
                }
                if(emptyProof){frame!.prerequisite <- endpoint}
                else{
                    frame!.prerequisite <- derivePair(request, frame!.prerequisite, endpoint, frame!.sourceEdge)
                    request!.ready.append(frame); request!.ready.append(frame!.prerequisite); return()
                }
            }
            if(!frame!.sourceIsOperand and !frame!.sourceIsListSpec and
               graph.openLayout(frame!.facts) and graph.openLayout(frame!.prerequisite!.facts)){
                frame!.openAlignment <- graph.alignOpen(request, frame)
            }
            graph.consumePrerequisite(request, frame)
            frame!.memberSpecified <- false
            if(frame!.facts.outcome!=worldReady){
                stopFrame(request, frame); return()
            }
        }
        if(frame!.corresponding){
            request!.ready.append(frame); correspond(request, frame); return()
        }
        if(frame!.projected){frame!.finished <- true; return()}
        frame!.sourceEdge <- graph.nextRelationship(frame)
        if(frame!.sourceEdge==NULL){
            if(graph.needsRequirements(frame) and (frame===request!.root or !frame!.node!.pItem!.wrkList.isEmpty())){
                graph.beginRequirements(frame); request!.ready.append(frame); return()
            }
            if(frame!.facts.outcome==worldReady and requestParentRHS(request, frame)){return()}
            frame!.finished <- true
            if(frame!.facts.outcome!=worldReady){stopFrame(request, frame)}
            return()
        }
        request!.relationshipsRead <+- 1
        our POV: source <- frame!.sourceEdge
        if(source!.pItem==NULL){request!.outcome <- worldError; request!.detail <- "Empty relationship"; return()}
        if(source!.viewMap.sourcePov!=NULL or source!.referenceAlias.sourcePov!=NULL or
           (source!.pParent!=NULL and (!frame!.sourceIsOperand or source!.pParent!==frame!.node))){
            request!.outcome <- worldUnsupported; request!.detail <- "Contextual expression source"; return()
        }
        if(request!.attempts.containsKey(source!.pItem)){
            frame!.prerequisite <- request!.attempts.at(source!.pItem)
            if(!frame!.prerequisite!.finished){
                request!.outcome <- worldUnsupported
                request!.detail <- "Cyclic scalar prerequisites need the continuation stage"
                frame!.prerequisite <- NULL; return()
            }
            request!.ready.append(frame)
        }else{
            frame!.prerequisite <- makeFrame(request, source)
            if(frame!.sourceIsOperand){frame!.prerequisite!.expressionParent <- frame!.node}
            request!.ready.append(frame)
            request!.ready.append(frame!.prerequisite)
        }
    }

    our WorldRequest: normalize(our WorldSession: session, our POV: target, me bool: requireSize <- false) <- {
        me WorldModelLock: lock{control!.mutex}
        our WorldRequest:: request
        request!.control <- control
        request!.target <- target; request!.requireSize <- requireSize
        if(session==NULL or session!.closed){
            request!.outcome <- worldError; request!.detail <- "An open Agent session is required"; return(request)
        }
        session!.requests.append(request)
        if(target==NULL or target!.pItem==NULL){
            request!.outcome <- worldError; request!.detail <- "Missing target POV"; return(request)
        }
        if(graph.satisfied(target, requireSize)){
            request!.outcome <- worldComplete; return(request)
        }
        our WorldPosition: context
        if(target!.pParent!=NULL){
            context <- graph.occurrencePath(target)
            if(context==NULL){request!.outcome <- worldUnsupported; request!.detail <- "Invalid or cyclic occurrence path"; return(request)}
        }
        request!.root <- makeFrame(request, target, context); request!.root!.demandSize <- requireSize
        request!.ready.append(request!.root)
        run(request)
        return(request)
    }

    void: run(our WorldRequest: request) <- {
        while(request!.outcome==worldReady and !request!.ready.isEmpty()){
            our WorldFrame: frame <- request!.ready.popLast()
            step(request, frame)
            if(frame!.finished and frame!.context!=NULL and request!.activeContexts.containsKey(frame!.node!.pItem) and
               request!.activeContexts.at(frame!.node!.pItem)===frame){request!.activeContexts.erase(frame!.node!.pItem)}
        }
        if(request!.outcome==worldReady){graph.finish(request)}
        if(request!.outcome!=worldWaiting){request!.releaseProgress()}
    }

    void: cancel(our WorldRequest: request) <- {request!.cancel()}
    void: closeSession(our WorldSession: session) <- {
        me WorldModelLock: lock{control!.mutex}
        if(session!.closed){return()}
        withEach request in session!.requests{cancel(request)}
        session!.requests.clear(); session!.closed <- true
    }
}
