// Active Proteus WorldManager implementation.
// The generated rule matrix is kept in WorldManagerRules.dog.
#include WorldManagerRules.dog

struct WorldManager{
    our WordUse: orderedSpanSourceUnitType(our POV: rhsPOV) <- {
        if(rhsPOV==NULL or rhsPOV!.pItem==NULL){return(NULL)}
        if(rhsPOV!.pItem!.type!=NULL){return(rhsPOV!.pItem!.type)}
        if(rhsPOV!.pParent!=NULL and rhsPOV!.pParent!.pItem!=NULL and rhsPOV!.pParent!.pItem!.value!.listSpec!=NULL and rhsPOV!.pParent!.pItem!.value!.listSpec!.type!=NULL){
            return(rhsPOV!.pParent!.pItem!.value!.listSpec!.type)
        }
        return(NULL)
    }
    our WordUse: orderedSpanContainerType(our POV: rhsPOV) <- {
        if(rhsPOV==NULL){return(NULL)}
        their POV: containerPOV <- rhsPOV!.pParent
        while(containerPOV!=NULL){
            if(containerPOV!.pItem!=NULL and containerPOV!.pItem!.type!=NULL){return(containerPOV!.pItem!.type)}
            if(containerPOV!.outerPOV!=NULL and containerPOV!.outerPOV!.pItem!=NULL and containerPOV!.outerPOV!.pItem!.type!=NULL){return(containerPOV!.outerPOV!.pItem!.type)}
            containerPOV <- containerPOV!.pParent
        }
        return(NULL)
    }
    me bool: isOrderedSpanRequest(our POV: lhsPOV, their vocabularySpec: vSpec) <- {
        if(lhsPOV==NULL or lhsPOV!.pItem==NULL or lhsPOV!.pItem!.type==NULL){return(false)}
        if(lhsPOV!.pItem!.invertMatch){return(false)}
        our OrderedSpanMeasure: measure <- modelMngr.measureOrderedSpanUnit(lhsPOV!.pItem!.type, vSpec, 0)
        return(measure!=NULL and measure!.valid and measure!.baseCount>1)
    }
    our POV: exposeSparseOrderedSpanHeadForTraversal(our POV: sparsePOV) <- {
        if(sparsePOV==NULL){return(NULL)}
        our infonView: compositeHead <- NULL
        if(sparsePOV!.isSparseOrderedSpan() and sparsePOV!.pItem!.value!.listSpec!=NULL and sparsePOV!.pItem!.value!.listSpec!.type!=NULL){
            me vocabularySpec: vSpec
            vSpec.init(agent!.getLocaleBaseName())
            compositeHead <- makeSparseOrderedSpanCompositeHead(sparsePOV!.pItem!.value!.listSpec!.type, vSpec)
        }
        if(compositeHead!=NULL){return(sparsePOV!.exposeSparseHeadWithItem(compositeHead))}
        return(sparsePOV!.exposeSparseHead(false))
    }
    our infonView: makeSparseOrderedSpanCompositeHead(our WordUse: unitType, their vocabularySpec: vSpec) <- {
        if(unitType==NULL){return(NULL)}
        our infonView: meaning <- orderedSpanDefinitionMeaning(unitType, vSpec)
        if(meaning==NULL){return(NULL)}
        if(meaning!.value!.listSpec==NULL or meaning!.value!.listSpec!.type==NULL){return(NULL)}

        me int64: childCount <- meaning!.infSize!.num.convertToInt()
        if(childCount<=0){return(NULL)}

        our infonView:: span
        span!.setToList()
        span!.type <- unitType
        span!.value!.listSpec <- meaning!.value!.listSpec
        span!.orderMode <- meaning!.orderMode
        span!.value!.sizeMode <- fromCount
        span!.value!.tailUnfinished <- false
        span!.infSize!.overlayType <- NUM
        span!.infSize!.evalMode <- emLiteral
        span!.infSize!.num <- childCount
        span!.copySource <- meaning
        span!.copySourceType <- cstDefinition
        span!.wordDerefed <- true
        span!.alreadyTypeChecked <- true

        our infonView:: childSparse
        childSparse!.setToList()
        childSparse!.value!.listSpec <- meaning!.value!.listSpec
        childSparse!.orderMode <- meaning!.orderMode
        childSparse!.value!.sizeMode <- fromCount
        childSparse!.value!.tailUnfinished <- true
        childSparse!.infSize!.overlayType <- NUM
        childSparse!.infSize!.evalMode <- emLiteral
        childSparse!.infSize!.num <- childCount
        span!.value!.items.append(childSparse, true, povSrcListSpecSparseTail)
        return(span)
    }
    our POV: positiveOrderedSpanAfterNegativeSkip(our POV: lhsPOV, their vocabularySpec: vSpec) <- {
        if(lhsPOV==NULL or lhsPOV!.pItem==NULL or !lhsPOV!.pItem!.invertMatch){return(NULL)}
        if(lhsPOV!.pParent==NULL or lhsPOV!.pParent!.next==NULL){return(NULL)}
        our POV: candidate <- lhsPOV!.pParent!.next
        if(candidate!.pItem==NULL or candidate!.pItem!.type==NULL){return(NULL)}
        if(lhsPOV!.pItem!.type!=NULL and lhsPOV!.pItem!.type!.typeID()!=candidate!.pItem!.type!.typeID()){return(NULL)}
        if(isOrderedSpanRequest(candidate, vSpec)){return(candidate)}
        return(NULL)
    }
    void: removeConsumedOrderedSpanSkipWork(our POV: requestPOV, our POV: skipPOV) <- {
        if(requestPOV==NULL or requestPOV!.pItem==NULL or skipPOV==NULL or skipPOV!.pItem==NULL or skipPOV!.pItem!.type==NULL){return()}
        me string: skipTypeID <- skipPOV!.pItem!.type!.typeID()
        if(skipTypeID==""){return()}

        me List<our POV>: retainedWork
        withEach wrkPOV in requestPOV!.pItem!.wrkList{
            me bool: consumedSkip <- false
            if(wrkPOV!=NULL and wrkPOV!.pItem!=NULL and wrkPOV!.pItem!.invertMatch and wrkPOV!.pItem!.type!=NULL and wrkPOV!.pItem!.type!.typeID()==skipTypeID){
                consumedSkip <- true
            }
            if(!consumedSkip){retainedWork.append(wrkPOV)}
        }
        requestPOV!.pItem!.wrkList <- retainedWork
    }
    me int64: orderedSpanWindowItemCount(our POV: lhsPOV, our POV: rhsPOV, their vocabularySpec: vSpec) <- {
        if(!isOrderedSpanRequest(lhsPOV, vSpec) or rhsPOV==NULL or rhsPOV!.pItem==NULL){return(0)}
        return(orderedSpanWindowItemCountForUnit(lhsPOV!.pItem!.type, rhsPOV, vSpec))
    }
    me int64: orderedSpanWindowItemCountForUnit(our WordUse: unitType, our POV: rhsPOV, their vocabularySpec: vSpec) <- {
        if(unitType==NULL or rhsPOV==NULL or rhsPOV!.pItem==NULL){return(0)}
        our WordUse: rhsUnitType <- orderedSpanSourceUnitType(rhsPOV)
        if(rhsUnitType!=NULL){
            our OrderedSpanConverter: converter <- modelMngr.getOrderedSpanConverter(unitType, rhsUnitType, vSpec)
            if(converter!=NULL and converter!.valid and converter!.fromBaseCount==converter!.toBaseCount){return(1)}
            if(converter!=NULL and converter!.valid and converter!.fromBaseCount>converter!.toBaseCount and converter!.toBaseCount>0){
                if(converter!.fromBaseCount % converter!.toBaseCount == 0){return(converter!.fromBaseCount / converter!.toBaseCount)}
            }
            return(0)
        }
        our OrderedSpanMeasure: measure <- modelMngr.measureOrderedSpanUnit(unitType, vSpec, 0)
        if(measure!=NULL and measure!.valid and measure!.baseCount>1){return(measure!.baseCount)}
        return(0)
    }
    me bool: isImplicitOrderedSpanIndexRequest(our POV: lhsPOV) <- {
        if(lhsPOV==NULL or lhsPOV!.pItem==NULL){return(false)}
        if(lhsPOV!.pItem!.type!=NULL){return(false)}
        if(lhsPOV!.pItem!.viewMode!=vmAny){return(false)}
        if(lhsPOV!.pParent==NULL or lhsPOV!.pParent!.pItem==NULL){return(false)}
        if(!lhsPOV!.pParent!.pItem!.isInnr){return(false)}
        if(lhsPOV!.pParent!.pItem!.value!.sizeMode!=fromCount){return(false)}
        if(lhsPOV!.pParent!.pItem!.infSize!.overlayType!=NUM or lhsPOV!.pParent!.pItem!.infSize!.evalMode!=emLiteral){return(false)}
        return(true)
    }
    our WordUse: orderedSpanContainerChildType(our POV: rhsPOV, their vocabularySpec: vSpec) <- {
        our WordUse: containerType <- orderedSpanContainerType(rhsPOV)
        if(containerType==NULL){return(NULL)}
        our WordDefn: defn <- modelMngr.lookupSingleDefinitionForType(containerType, vSpec)
        if(defn==NULL or defn!.meaning==NULL){return(NULL)}
        our infonView: meaning <- defn!.meaning
        if(meaning!.value!.overlayType!=LST or meaning!.value!.evalMode!=emLiteral){return(NULL)}
        if(!meaning!.value!.tailUnfinished or !meaning!.value!.items.isEmpty()){return(NULL)}
        if(meaning!.value!.listSpec==NULL or meaning!.value!.listSpec!.type==NULL){return(NULL)}
        if(meaning!.infSize!.overlayType!=NUM or meaning!.infSize!.evalMode!=emLiteral){return(NULL)}
        return(meaning!.value!.listSpec!.type)
    }
    me bool: orderedSpanTypesMatch(our WordUse: leftType, our WordUse: rightType) <- {
        if(leftType==NULL or rightType==NULL){return(false)}
        me string: leftID <- leftType!.typeID()
        if(leftID==""){leftID <- leftType!.normalType()}
        me string: rightID <- rightType!.typeID()
        if(rightID==""){rightID <- rightType!.normalType()}
        if(leftID=="" or rightID==""){return(false)}
        return(leftID==rightID)
    }
    our infonView: orderedSpanDefinitionMeaning(our WordUse: unitType, their vocabularySpec: vSpec) <- {
        if(unitType==NULL){return(NULL)}
        our WordDefn: defn <- modelMngr.lookupSingleDefinitionForType(unitType, vSpec)
        if(defn==NULL or defn!.meaning==NULL){return(NULL)}
        our infonView: meaning <- defn!.meaning
        if(meaning!.value!.overlayType!=LST or meaning!.value!.evalMode!=emLiteral){return(NULL)}
        if(!meaning!.value!.tailUnfinished or !meaning!.value!.items.isEmpty()){return(NULL)}
        if(meaning!.value!.listSpec==NULL or meaning!.value!.listSpec!.type==NULL){return(NULL)}
        if(meaning!.infSize!.overlayType!=NUM or meaning!.infSize!.evalMode!=emLiteral){return(NULL)}
        return(meaning)
    }
    me int64: orderedSpanDefinitionChildCount(our WordUse: unitType, their vocabularySpec: vSpec) <- {
        our infonView: meaning <- orderedSpanDefinitionMeaning(unitType, vSpec)
        if(meaning==NULL){return(0)}
        return(meaning!.infSize!.num.convertToInt())
    }
    our WordUse: orderedSpanDefinitionChildType(our WordUse: unitType, their vocabularySpec: vSpec) <- {
        our infonView: meaning <- orderedSpanDefinitionMeaning(unitType, vSpec)
        if(meaning==NULL){return(NULL)}
        return(meaning!.value!.listSpec!.type)
    }
    void: markOrderedSpanViewReady(our infonView: spanInfon) <- {
        if(spanInfon==NULL){return()}
        spanInfon!.wordDerefed <- true
        spanInfon!.alreadyTypeChecked <- true
        spanInfon!.isNormed <- true
        spanInfon!.wasProcessed <- true
        spanInfon!.sizeNormed <- true
        if(spanInfon!.value!.overlayType==LST and spanInfon!.value!.evalMode==emLiteral){
            our POV: childPOV <- spanInfon!.value!.items.head
            while(childPOV!=NULL){
                markOrderedSpanViewReady(childPOV!.pItem)
                childPOV <- childPOV!.next
            }
        }
    }
    our POV: materializedOrderedSpanChildAt(our infonView: container, me int64: itemIndex, their vocabularySpec: vSpec) <- {
        if(container==NULL or itemIndex<=0){return(NULL)}
        if(container!.type==NULL){return(NULL)}
        if(container!.value!.overlayType!=LST or container!.value!.evalMode!=emLiteral){return(NULL)}
        if(container!.value!.listSpec==NULL or container!.value!.listSpec!.type==NULL){return(NULL)}
        our WordUse: childType <- orderedSpanDefinitionChildType(container!.type, vSpec)
        if(childType==NULL or !orderedSpanTypesMatch(childType, container!.value!.listSpec!.type)){return(NULL)}
        me int64: crntIndex <- 1
        our POV: childPOV <- container!.value!.items.head
        while(childPOV!=NULL){
            if(crntIndex==itemIndex){return(childPOV)}
            crntIndex <+- 1
            childPOV <- childPOV!.next
        }
        return(NULL)
    }
    our POV: makeOrderedSpanContainerView(our POV: containerPOV, their vocabularySpec: vSpec) <- {
        if(containerPOV==NULL or containerPOV!.pItem==NULL or containerPOV!.pItem!.type==NULL){return(NULL)}
        if(containerPOV!.pItem!.value!.overlayType!=LST or containerPOV!.pItem!.value!.evalMode!=emLiteral){return(NULL)}
        if(containerPOV!.pItem!.value!.items.isEmpty()){return(NULL)}
        our POV: sourceStart <- containerPOV!.pItem!.value!.items.head
        if(sourceStart==NULL){return(NULL)}
        sourceStart!.pParent <- containerPOV
        return(makeOrderedSpanUnitView(containerPOV!.pItem!.type, sourceStart, vSpec, povSrcConcreteSpanPrefix))
    }
    our infonView: resolveTypedFieldPathInfonView(our POV: fieldPOV, our infonView: path, their vocabularySpec: vSpec) <- {
        if(fieldPOV==NULL or fieldPOV!.pItem==NULL or path==NULL){return(NULL)}

        our infonView: resolved <- fieldPOV!.pItem
        me bool: hasFollowOnPath <- (path!.partRef!=NULL or !path!.parts.isEmpty())
        if(!hasFollowOnPath){
            our POV: fieldView <- makeOrderedSpanContainerView(fieldPOV, vSpec)
            if(fieldView!=NULL){return(fieldView!.pItem)}
            return(NULL)
        }

        if(path!.partRef!=NULL){
            resolved!.partRef <- path!.partRef
            path!.partRef <- NULL
            resolved!.isNormed <- false
            resolved!.wasProcessed <- false
        }else{
            resolved!.parts <- path!.parts
            if(!path!.parts.isEmpty()){
                resolved!.isNormed <- false
                resolved!.wasProcessed <- false
            }
        }
        return(resolved)
    }
    our POV: makeDirectOrderedSpanSourceView(our WordUse: unitType, our POV: sourcePOV, me int: source) <- {
        if(unitType==NULL or sourcePOV==NULL or sourcePOV!.pItem==NULL){return(NULL)}
        our POV:: directPOV{source}
        directPOV!.pItem <- sourcePOV!.pItem
        directPOV!.outerPOV <- sourcePOV
        directPOV!.accessMode <- aRefTo
        directPOV!.isSubItm <- sourcePOV!.isSubItm
        directPOV!.pParent <- sourcePOV!.pParent
        if(directPOV!.pItem!.itmMode==mNone){directPOV!.pItem!.itmMode <- mItem}
        markOrderedSpanViewReady(directPOV!.pItem)
        return(directPOV)
    }
    our POV: makeOrderedSpanUnitView(our WordUse: unitType, our POV: sourcePOV, their vocabularySpec: vSpec, me int: source) <- {
        if(unitType==NULL or sourcePOV==NULL or sourcePOV!.pItem==NULL){return(NULL)}
        our WordUse: sourceUnitType <- orderedSpanSourceUnitType(sourcePOV)
        if(sourceUnitType==NULL){return(NULL)}

        our OrderedSpanConverter: unitConverter <- modelMngr.getOrderedSpanConverter(unitType, sourceUnitType, vSpec)
        if(unitConverter==NULL or !unitConverter!.valid){return(NULL)}
        if(unitConverter!.fromBaseCount==unitConverter!.toBaseCount){
            return(makeDirectOrderedSpanSourceView(unitType, sourcePOV, source))
        }
        if(unitConverter!.fromBaseCount<unitConverter!.toBaseCount){return(NULL)}
        if(unitConverter!.toBaseCount<=0 or unitConverter!.fromBaseCount % unitConverter!.toBaseCount != 0){return(NULL)}
        me int64: sourceItemsForUnit <- unitConverter!.fromBaseCount / unitConverter!.toBaseCount
        if(sourcePOV!.countConcreteSiblingsFromHere()<sourceItemsForUnit){return(NULL)}

        our infonView: meaning <- orderedSpanDefinitionMeaning(unitType, vSpec)
        if(meaning==NULL){
            our POV: flatPOV <- sourcePOV!.makeConcreteSiblingSpanView(sourceItemsForUnit, false, source)
            if(flatPOV!=NULL){
                flatPOV!.pItem!.type <- unitType
                flatPOV!.pItem!.wordDerefed <- true
                flatPOV!.pItem!.alreadyTypeChecked <- true
            }
            return(flatPOV)
        }

        our WordUse: childType <- meaning!.value!.listSpec!.type
        me int64: childCount <- meaning!.infSize!.num.convertToInt()
        if(childCount<=0){return(NULL)}
        our OrderedSpanConverter: childConverter <- modelMngr.getOrderedSpanConverter(childType, sourceUnitType, vSpec)
        if(childConverter==NULL or !childConverter!.valid){return(NULL)}
        if(childConverter!.fromBaseCount<childConverter!.toBaseCount){return(NULL)}
        if(childConverter!.toBaseCount<=0 or childConverter!.fromBaseCount % childConverter!.toBaseCount != 0){return(NULL)}
        me int64: sourceItemsForChild <- childConverter!.fromBaseCount / childConverter!.toBaseCount
        if(sourceItemsForChild<=0){return(NULL)}

        our infonView:: span
        span!.setToList()
        span!.type <- unitType
        span!.value!.listSpec <- meaning!.value!.listSpec
        span!.orderMode <- meaning!.orderMode
        span!.value!.sizeMode <- fromCount
        span!.value!.tailUnfinished <- false
        span!.infSize!.overlayType <- NUM
        span!.infSize!.evalMode <- emLiteral
        span!.infSize!.num <- childCount

        our POV:: spanPOV{source}
        spanPOV!.pItem <- span
        spanPOV!.accessMode <- aRefTo
        spanPOV!.isSubItm <- true
        spanPOV!.pParent <- sourcePOV!.pParent

        me int64: childIndex <- 0
        me int64: sourceOffset <- 0
        while(childIndex<childCount){
            our POV: childSourcePOV <- sourcePOV!.siblingAtOffset(sourceOffset)
            if(childSourcePOV==NULL){return(NULL)}
            our POV: childPOV <- makeOrderedSpanUnitView(childType, childSourcePOV, vSpec, source)
            if(childPOV==NULL){return(NULL)}
            childPOV!.isSubItm <- false
            childPOV!.pParent <- spanPOV
            span!.value!.items.appendPov(childPOV)
            childIndex <+- 1
            sourceOffset <+- sourceItemsForChild
        }
        markOrderedSpanViewReady(span)
        return(spanPOV)
    }
    our POV: firstOrderedSpanChildForRequest(our WordUse: requestType, our POV: rhsPOV, their vocabularySpec: vSpec) <- {
        if(requestType==NULL or rhsPOV==NULL or rhsPOV!.pItem==NULL){return(NULL)}
        our WordUse: sourceUnitType <- orderedSpanSourceUnitType(rhsPOV)
        if(sourceUnitType==NULL){return(NULL)}
        our OrderedSpanConverter: childConverter <- modelMngr.getOrderedSpanConverter(requestType, sourceUnitType, vSpec)
        if(childConverter==NULL or !childConverter!.valid){return(NULL)}

        if(childConverter!.fromBaseCount==childConverter!.toBaseCount){
            if(rhsPOV!.isSparseOrderedSpan()){return(exposeSparseOrderedSpanHeadForTraversal(rhsPOV))}
            return(rhsPOV)
        }

        if(childConverter!.fromBaseCount<childConverter!.toBaseCount){
            if(rhsPOV!.isSparseOrderedSpan()){
                our POV: exposedPOV <- exposeSparseOrderedSpanHeadForTraversal(rhsPOV)
                if(exposedPOV==NULL){return(NULL)}
                return(firstOrderedSpanChildForRequest(requestType, exposedPOV, vSpec))
            }
            if(rhsPOV!.pItem!.value!.overlayType!=LST or rhsPOV!.pItem!.value!.evalMode!=emLiteral){return(NULL)}
            if(rhsPOV!.pItem!.value!.items.isEmpty()){return(NULL)}
            our POV: childPOV <- rhsPOV!.pItem!.value!.items.head
            if(childPOV==NULL){return(NULL)}
            childPOV!.pParent <- rhsPOV
            return(firstOrderedSpanChildForRequest(requestType, childPOV, vSpec))
        }
        if(rhsPOV!.pItem!.value!.overlayType==LST and rhsPOV!.pItem!.value!.evalMode==emLiteral and !rhsPOV!.pItem!.value!.items.isEmpty()){
            our POV: childPOV <- rhsPOV!.pItem!.value!.items.head
            if(childPOV!=NULL){
                childPOV!.pParent <- rhsPOV
                return(makeOrderedSpanUnitView(requestType, childPOV, vSpec, povSrcConcreteSpanPrefix))
            }
        }
        return(makeOrderedSpanUnitView(requestType, rhsPOV, vSpec, povSrcConcreteSpanPrefix))
    }
    our OrderedSpanTraversalWindow: tryBuildOrderedSpanTraversalWindow(our POV: lhsPOV, our POV: rhsPOV) <- {
        our OrderedSpanTraversalWindow:: result
        result!.valid <- false
        if(lhsPOV==NULL or rhsPOV==NULL){return(result)}
        me vocabularySpec: vSpec
        vSpec.init(agent!.getLocaleBaseName())

        our POV: requestPOV <- lhsPOV
        our POV: positivePOV <- positiveOrderedSpanAfterNegativeSkip(lhsPOV, vSpec)
        if(positivePOV!=NULL){
            removeConsumedOrderedSpanSkipWork(positivePOV, lhsPOV)
            requestPOV <- positivePOV
        }

        our WordUse: windowType <- NULL
        our WordUse: unitTypeForWindow <- requestPOV!.pItem!.type
        me bool: implicitIndexRequest <- isImplicitOrderedSpanIndexRequest(requestPOV)
        if(unitTypeForWindow==NULL and implicitIndexRequest){
            windowType <- orderedSpanContainerChildType(rhsPOV, vSpec)
            unitTypeForWindow <- windowType
        }
        our WordUse: rhsUnitType <- orderedSpanSourceUnitType(rhsPOV)
        if(unitTypeForWindow!=NULL and rhsUnitType!=NULL){
            our OrderedSpanConverter: spanConverter <- modelMngr.getOrderedSpanConverter(unitTypeForWindow, rhsUnitType, vSpec)
            if(spanConverter!=NULL and spanConverter!.valid and spanConverter!.fromBaseCount<spanConverter!.toBaseCount){
                our POV: containedPOV <- firstOrderedSpanChildForRequest(unitTypeForWindow, rhsPOV, vSpec)
                if(containedPOV!=NULL){
                    result!.lhsPOV <- requestPOV
                    result!.rhsPOV <- containedPOV
                    requestPOV!.accessMode <- aRefTo
                    result!.valid <- true
                    return(result)
                }
            }
        }
        me int64: itemCount <- orderedSpanWindowItemCountForUnit(unitTypeForWindow, rhsPOV, vSpec)
        if(itemCount==1 and implicitIndexRequest){
            result!.lhsPOV <- requestPOV
            result!.rhsPOV <- rhsPOV
            requestPOV!.accessMode <- aRefTo
            result!.valid <- true
            return(result)
        }
        if(itemCount<=1){return(result)}
        if(rhsPOV!.countConcreteSiblingsFromHere()<itemCount){return(result)}

        our POV: prefix <- makeOrderedSpanUnitView(unitTypeForWindow, rhsPOV, vSpec, povSrcConcreteSpanPrefix)
        if(prefix==NULL){prefix <- rhsPOV!.makeConcreteSiblingSpanView(itemCount, false, povSrcConcreteSpanPrefix)}
        if(prefix==NULL){return(result)}
        if(windowType!=NULL){
            prefix!.pItem!.type <- windowType
            prefix!.pItem!.wordDerefed <- true
            prefix!.pItem!.alreadyTypeChecked <- true
        }

        our POV: suffixStart <- rhsPOV!.siblingAtOffset(itemCount)
        if(suffixStart!=NULL){
            prefix!.next <- suffixStart
        }

        result!.lhsPOV <- requestPOV
        result!.rhsPOV <- prefix
        requestPOV!.accessMode <- aRefTo
        result!.valid <- true
        return(result)
    }
    me bool: sparseOrderedSpanMergeAlignable(our POV: lhsPOV, our POV: rhsPOV, their vocabularySpec: vSpec) <- {
        if(lhsPOV==NULL or rhsPOV==NULL or !lhsPOV!.isSparseOrderedSpan() or !rhsPOV!.isSparseOrderedSpan()){return(false)}
        if(lhsPOV!.sparseSpanCompatibleWith(rhsPOV)){return(true)}

        our OrderedSpanConverter: spanConverter <- modelMngr.getOrderedSpanConverter(lhsPOV!.pItem!.value!.listSpec!.type, rhsPOV!.pItem!.value!.listSpec!.type, vSpec)
        if(spanConverter==NULL or !spanConverter!.valid){return(false)}
        me int64: lhsCount <- lhsPOV!.sparseSpanCount()
        me int64: rhsCount <- rhsPOV!.sparseSpanCount()
        me int64: lhsBaseCount <- lhsCount * spanConverter!.fromBaseCount
        me int64: rhsBaseCount <- rhsCount * spanConverter!.toBaseCount
        if(lhsBaseCount==rhsBaseCount){return(true)}
        if(lhsBaseCount<rhsBaseCount){
            me int64: rhsPrefixCount <- lhsBaseCount / spanConverter!.toBaseCount
            return(rhsPrefixCount>0 and rhsPrefixCount<rhsCount and rhsPrefixCount*spanConverter!.toBaseCount==lhsBaseCount)
        }
        me int64: lhsPrefixCount <- rhsBaseCount / spanConverter!.fromBaseCount
        return(lhsPrefixCount>0 and lhsPrefixCount<lhsCount and lhsPrefixCount*spanConverter!.fromBaseCount==rhsBaseCount)
    }
    our POV: orderedSpanMergeRules(our AItem: aItem, their bool: handled) <- {
        handled! <- false
        our POV: remainder <- NULL
        if(aItem!.RHS!=NULL and aItem!.LHS_item!.isSparseOrderedSpan() and aItem!.RHS!.isSparseOrderedSpan() and aItem!.LHS_item!.sparseSpanCompatibleWith(aItem!.RHS)){
            me int64: lhsCount <- aItem!.LHS_item!.sparseSpanCount()
            me int64: rhsCount <- aItem!.RHS!.sparseSpanCount()
            if(lhsCount==rhsCount){
                aItem!.sizeToCopy <- lhsCount
                handled! <- true
                return(NULL)
            }
            if(lhsCount<rhsCount){
                remainder <- aItem!.RHS!.splitSparseSpanPrefix(lhsCount)
                aItem!.sizeToCopy <- lhsCount
                handled! <- true
                return(remainder)
            }
            if(rhsCount<lhsCount){
                aItem!.LHS_item!.splitSparseSpanPrefix(rhsCount)
                aItem!.sizeToCopy <- rhsCount
                handled! <- true
                return(NULL)
            }
        }
        if(aItem!.RHS!=NULL and aItem!.LHS_item!.isSparseOrderedSpan() and aItem!.RHS!.isSparseOrderedSpan()){
            me vocabularySpec: vSpec
            vSpec.init(agent!.getLocaleBaseName())
            our OrderedSpanConverter: spanConverter <- modelMngr.getOrderedSpanConverter(aItem!.LHS_item!.pItem!.value!.listSpec!.type, aItem!.RHS!.pItem!.value!.listSpec!.type, vSpec)
            if(spanConverter!=NULL and spanConverter!.valid){
                me int64: lhsCount <- aItem!.LHS_item!.sparseSpanCount()
                me int64: rhsCount <- aItem!.RHS!.sparseSpanCount()
                me int64: lhsBaseCount <- lhsCount * spanConverter!.fromBaseCount
                me int64: rhsBaseCount <- rhsCount * spanConverter!.toBaseCount
                if(lhsBaseCount==rhsBaseCount){
                    aItem!.sizeToCopy <- lhsCount
                    handled! <- true
                    return(NULL)
                }
                if(lhsBaseCount<rhsBaseCount){
                    me int64: rhsPrefixCount <- lhsBaseCount / spanConverter!.toBaseCount
                    if(rhsPrefixCount>0 and rhsPrefixCount<rhsCount and rhsPrefixCount*spanConverter!.toBaseCount==lhsBaseCount){
                        remainder <- aItem!.RHS!.splitSparseSpanPrefix(rhsPrefixCount)
                        aItem!.sizeToCopy <- lhsCount
                        handled! <- true
                        return(remainder)
                    }
                }
                if(rhsBaseCount<lhsBaseCount){
                    me int64: lhsPrefixCount <- rhsBaseCount / spanConverter!.fromBaseCount
                    if(lhsPrefixCount>0 and lhsPrefixCount<lhsCount and lhsPrefixCount*spanConverter!.fromBaseCount==rhsBaseCount){
                        aItem!.LHS_item!.splitSparseSpanPrefix(lhsPrefixCount)
                        aItem!.sizeToCopy <- lhsPrefixCount
                        handled! <- true
                        return(NULL)
                    }
                }
            }
        }
        if(aItem!.RHS!=NULL and aItem!.LHS_item!.accessMode==aRefTo and aItem!.LHS_item!.outerPOV!=NULL and aItem!.LHS_item!.outerPOV!.pItem===aItem!.LHS_item!.pItem and !aItem!.RHS!.pItem!.asRHSInternalIdent and !(aItem!.RHS!.pParent!=NULL and aItem!.RHS!.pParent!.pItem!.asRHSInternalIdent)){
            copyIdentity(aItem)
            handled! <- true
            return(NULL)
        }
        return(NULL)
    }
}

struct WorldManager{
    their Agent: agent
    me string: phase1LastCoverageReport
    me uint64: phase1LastTraceCount <- 0

    // AGENDA PROCESSING FUNCTIONS
    our AItem: processInfonViewViaAgenda(their Agenda: agenda, our POV: pov, our AItem: subscriber, our AItem: aParent, me int64: priority, me aitemSrcID: source)<-{
        if(agenda!.povIsOnAgenda(pov)){return(NULL)}
        our AItem:: newAItem{source}
        newAItem!.ruleSet   <- rsInfon
        newAItem!.LHS_item  <- pov
        newAItem!.priority  <- priority
        newAItem!.step      <- 0
        newAItem!.indentLvl <- 0
        if(subscriber != NULL){
            newAItem!.subscribers.prepend(subscriber, 5)
            subscriber!.pendingTasks <+- 1
            //:l/PAI/PT::logSeg(" ++"+subscriber!.mySymbol()+"_PT:a="+toString(subscriber!.pendingTasks))
            newAItem!.indentLvl <- subscriber!.indentLvl+1
            newAItem!.cursorAnchor <- subscriber!.cursorAnchor
        }
        if(aParent != NULL){
            aParent!.taskEnqueued <- true
            newAItem!.parent <- aParent
            if(!(subscriber===aParent)) {
                aParent!.pendingTasks <+- 1
                //:l/PAI/PT::logSeg(" ++"+aParent!.mySymbol()+"_PT:b="+toString(aParent!.pendingTasks))
            }
            newAItem!.indentLvl <- aParent!.indentLvl+1
            newAItem!.cursorAnchor <- aParent!.cursorAnchor
        }else{
            //log("Parent_NULL; subscriber:"+subscriber!.mySymbol() +"  yields:"+newAItem!.mySymbol())
            //if(subscriber==NULL){log("// Proteus NOTICE: PIVA Parent_NULL; subscriber:"+subscriber!.mySymbol() +"  yields:"+newAItem!.mySymbol())}
        }
        return(newAItem)
    }
    our AItem: processMergeViaAgenda(their Agenda: agenda, our POV: LHS, our POV: RHS, me bool: looseSize, our AItem: subscriber, our AItem: aParent, me int64: priority, me aitemSrcID: source)<-{
        our AItem:: newAItem{source}
        newAItem!.ruleSet   <- rsMerge
        newAItem!.LHS_item  <- LHS
        newAItem!.RHS       <- RHS
        newAItem!.looseSize <- looseSize
        newAItem!.priority  <- priority
        newAItem!.step      <- 0
        newAItem!.indentLvl <- 0
        aParent!.taskEnqueued <- true
        if(subscriber != NULL){
            newAItem!.subscribers.prepend(subscriber, 6)
            subscriber!.pendingTasks <+- 1
            //:l/PAI/PT::logSeg(" ++"+subscriber!.mySymbol()+"_PT:c="+toString(subscriber!.pendingTasks))
            newAItem!.indentLvl <- subscriber!.indentLvl+1
            newAItem!.cursorAnchor <- subscriber!.cursorAnchor
        }
        if(aParent != NULL){
            newAItem!.parent <- aParent
            if(!(subscriber===aParent)){
                aParent!.pendingTasks <+- 1
                //:l/PAI/PT::logSeg(" ++"+aParent!.mySymbol()+"_PT:g="+toString(aParent!.pendingTasks))
            }
        }else{
            //if(subscriber==NULL){log("// Proteus NOTICE: PMVA Parent_NULL; subscriber:"+subscriber!.mySymbol() +"  yields:"+newAItem!.mySymbol())}
            //if(aParent!.parent==NULL){log("// Proteus NOTICE: PMVA aParent!.parent==NULL;   yields:"+newAItem!.mySymbol())}
        }
        agenda!.addAItemToAgenda(newAItem) // PMVA
        return(newAItem)
    }
    our AItem: processIntersectViaAgenda(their Agenda: agenda, our POV: pov, our AItem: subscriber, me int64: priority)<-{
        //log("processINTERSECTViaAgenda:"+ pov!.stringify())
        //if(subscriber!.parent!=NULL and subscriber!.parent!.LHSItr!=NULL){log("     LHSItr:"+subscriber!.parent!.LHSItr!.topPOV.stringify())}
        our AItem:: newAItem{srcPiCVA}
        newAItem!.ruleSet   <- rsIntersect
        newAItem!.LHS_item  <- pov
        newAItem!.priority  <- priority
        newAItem!.step      <- 0
        newAItem!.indentLvl <- 0
        if(subscriber != NULL){
            subscriber!.taskEnqueued <- true
            newAItem!.subscribers.prepend(subscriber, 7)
            subscriber!.pendingTasks <+- 1
            //:l/PAI/PT::logSeg(" ++"+subscriber!.mySymbol()+"_PT:d="+toString(subscriber!.pendingTasks))
            newAItem!.indentLvl <- subscriber!.indentLvl+1
            newAItem!.cursorAnchor <- subscriber!.cursorAnchor
            if(subscriber!.parent!=NULL){
                newAItem!.LHSItr <- subscriber!.parent!.LHSItr
                newAItem!.RHSItr <- subscriber!.parent!.RHSItr
            }
            newAItem!.parent <- subscriber
        }
        agenda!.addAItemToAgenda(newAItem) //PiCVA
        //:l/PAI::logSeg(" PIcVA:"+newAItem!.mySymbol())
        return(newAItem)
    }
    // Wake an rsInfon subscriber early so it can emit a streaming doReply before
    // deeper propagate work blocks, while keeping the subscriber edge outstanding
    // for the later real fulfillSubscriptions() pass.
    void: wakeSubscriptions(their Agenda: agenda, our AItem: aItem) <- {
        while(!aItem!.subscribers.isEmpty()){
            our AItem: sub <- aItem!.subscribers.first()
            if(sub!.ruleSet!=rsInfon or sub!.wokenEarly){break()}
            sub!.heldPendingTasks <+- 1
            sub!.wokenEarly <- true
            sub!.priority <- aItem!.priority
            sub!.LHS_item!.pItem!.isNormed <- false
            agenda!.addAItemToAgenda(sub)
            break()
        }
    }
    void: fulfillSubscriptions(their Agenda: agenda, our AItem: aItem) <- {
        me string: S
        while(!aItem!.subscribers.isEmpty()){
            our AItem: sub <- aItem!.subscribers.first()
            if(sub!.ruleSet==rsInfon){
                sub!.step <+- 1
                S <- S + " +step:"+toString(sub!.step)+":"
                sub!.priority <- aItem!.priority
            }
            aItem!.subscribers.popFirst()
            sub!.LHS_item!.pItem!.isNormed <- false
            if(sub!.wokenEarly){
                if(sub!.heldPendingTasks>0){sub!.heldPendingTasks <-- 1}
                sub!.wokenEarly <- false
            }
            me bool: itmAdded <- agenda!.addAItemToAgenda(sub) // FFS
            if(itmAdded){S<+-":"+sub!.mySymbol()}
        }
        if(S != ""){
            //:l/PAI::logSeg(" FFS"+S)
        }
    }

    // rsINFON UTILITY FUNCTIONS: PREP WORKLIST FUNCTIONS
    void: initRules(our AItem: aItem) <- {
        if(aItem!.initRulesApplied){return()} else {aItem!.initRulesApplied <- true}
        // Any init can go here
    }
    me bool: wordDefRules(our AItem: aItem) <- {
        our infonView: CI        <- aItem!.LHS_item!.pItem
        me bool: changeMade  <- false
        if(CI!.itmMode==mWordDefn and !CI!.defnRegistered){
            //:l/PAI::logSeg(" WrdDefn")
            CI!.setOrderMode()
            // TODO: if(CI!.orderMode==uUnknown){ Set word type modelMngr.wordsWaitingForDefinition}
            modelMngr.indexDefinition(agent, CI!.definedWord, CI!.funcArgs)
            CI!.defnRegistered <- true
            changeMade <- true
        }
        return(changeMade)
    }
    me bool: rangeRules(our AItem: aItem) <- {
        me bool: changeMade <- false
        // TODO: Don't do this every time.
        our infonView: LHSInf <- aItem!.LHS_item!.pItem
        // Reduce fraction
        if(LHSInf!.value!.evalMode == emLiteral and LHSInf!.value!.overlayType==NUM){
            LHSInf!.value!.num.normalize()
        }

        // Handle negative
        if(LHSInf!.value!.evalMode == emLiteral and LHSInf!.value!.inverted){
            if(LHSInf!.infSize!.evalMode == emLiteral){
                LHSInf!.value!.num <- LHSInf!.infSize!.num - LHSInf!.value!.num
                LHSInf!.value!.inverted <- false
                changeMade <- true
            }
        }
        return(changeMade)
    }
    me bool: splitLangText(our AItem: aItem) <- {
        our POV: CIPov      <- aItem!.LHS_item
        our infonView: CI       <- CIPov!.pItem
        me bool: changeMade <- false
        if(CI!.type!=NULL and CI!.type!.normalType()=="english-text" and CI!.value!.overlayType==STR and CI!.value!.evalMode==emLiteral){
            me string: text <- CI!.value!.str
            CI!.type!.setAsGiven("english-phrase")
            CI!.value!.overlayType  <- LST
            Allocate(CI!.value!.listSpec)
            Allocate(CI!.value!.listSpec!.type)
            CI!.value!.listSpec!.type!.setAsGiven("word")
            me int64: strLen <- text.size()-1
            me int64: pos    <- 0
            me string: word  <- ""
            while(pos <= strLen){
                me char: ch <- text[pos]
                if(ch!=" "){word <+- ch}
                if(ch==" " or pos==strLen){
                    if(word.size()>0){
                        //log("EXTRACTED_WORD:" + word)
                        our infonView:: newWord
                        Allocate(newWord!.type)
                        newWord!.type!.setAsGiven(word)
                        our POV: newPOV <- CI!.value!.items.append(newWord, CIPov!.isSubItm, 888)
                        word <- ""
                    }
                }
                pos <+- 1
            }
            changeMade <- true
        }
        return(changeMade)
    }
    me bool: derefInfonView(our infonView: CI) <- {
        if(CI!.wordDerefed){return(false)}
        me bool: changeMade  <- false
        modelMngr.completeItemsType(CI)
        if(CI!.wordDerefed){return(true)}
        if(CI!.type!=NULL and CI!.itmMode!=mWordDefn){
// TODO: move vSpec into agent
me vocabularySpec: vSpec
vSpec.init(agent!.getLocaleBaseName())
            our infonView: infModel  <- modelMngr.constructAltModelFromWord(agent, CI!.type, vSpec, "scope")
            if(infModel!=NULL){
                //log("derefWord:'"+CI!.type!.asGiven+"'    infModel:"+toString(infModel))
                infModel!.generality <- gAbstract
                if(CI!.viewMode!=vmAny){
                    if(infModel!.viewMode!=vmAny){
                        //:l/PAI::logSeg(" WRD_VAL:'"+CI!.type!.asGiven+"'")
                        CI!.generality <- gConcrete  // TODO: This may not always be the case.
                        our POV: newPov <- CI!.addInfonViewToWorkListWithPriority(infModel, true)
                        if(newPov===NULL){return(false)}
                        else{newPov!.trueByDefinition <- true}
                    }// else{log("SKIPPED:"+toString(infModel)}
                }else{
                    //:l/PAI::logSeg(" WRDxVAL:'"+CI!.type!.asGiven+"'")
                    our WordUse:CIsType <- CI!.type
                    me bool: invertMatch <- CI!.invertMatch
                    me uint64: itmMode <- CI!.itmMode
                    me List<our PartPath>: parts <- CI!.parts
                    our PartPath: partRef <- CI!.partRef
                    infModel!.copyAsTypeTo(CI, false, false)
                    CI!.copySource <- infModel
                    CI!.copySourceType <- cstDefinition
                    CI!.type    <- CIsType
                    CI!.invertMatch   <- invertMatch
                    CI!.parts   <- parts
                    CI!.partRef <- partRef
                    CI!.itmMode <- itmMode
                    CI!.isTypeExample <- true
                    CI!.alreadyTypeChecked <- true
                }
                if(infModel!.type!=NULL and !CI!.infonViewHasType(infModel!.type!.typeID())){CI!.addedTypes.append(infModel!.type)}
                changeMade <- true
            }else{
                //:l/PAI::logSeg(" WRD:ERR")
                agent!.setErrorState("'"+CI!.type!.asGiven+"' is not defined\n\n")
                //print("\n\n The word '"+CI!.type!.asGiven+"' is not defined\n\n"); exit(3)
                //log("// Proteus NOTICE: The word '"+CI!.type!.asGiven+"' is not defined")
            }
            CI!.wordDerefed <-true
        }
        return(changeMade)
    }
    me bool: derefWordRules(our AItem: aItem) <- {
        our POV: CIPov    <- aItem!.LHS_item
        our infonView: CI     <- CIPov!.pItem
        me bool: derefLHS <- false
        if(CIPov!=NULL){derefLHS <- derefInfonView(CIPov!.pItem)}
        me bool: derefRHS <- false
        if(aItem!.RHS!=NULL){derefInfonView(aItem!.RHS!.pItem)}
        if(derefLHS){
            if(CIPov!.pParent!=NULL and CIPov!.pParent!.pItem!=NULL){
                CIPov!.pParent!.pItem!.value!.index.insert(CI!.type!.typeID(), CI)
            }else{ // This section is to get items into World. In a fully streaming mode this isn't needed.
                agent!.world!.value!.index.insert(CI!.type!.typeID(), CI)
            }
        }
        return(derefLHS or derefRHS)
    }
    me bool: funcArgRules(our AItem: aItem) <- {
        our infonView: CI        <- aItem!.LHS_item!.pItem
        me bool: changeMade  <- false
        if(CI!.argPos != apNoArgs){
            //:l/PAI::logSeg(" fArgs")
            our infonView: tmp
            if(CI!.argPos == apArgIsFirstItem){tmp <- CI!.getFirstItem(aItem!.LHS_item!.isSubItm)}
            else {tmp <- CI!.getLastInfonView()}
            if(tmp!=NULL){
                our POV:: newPov{9}
                newPov!.pItem    <- CI!.funcArgs
                newPov!.pItem!.asRHSInternalIdent <- true
                tmp!.addPOVToWrkList(newPov)
                CI!.funcArgs <- NULL
                CI!.argPos   <- apNoArgs
                changeMade  <- true
            }
            //if(CI!.value!.overlayType==LST){ciItr.state <- sFirstVisit}
            //else if(CI!.value!.overlayType!=LST){ciItr.state <- sNotASeq}
        }
        return(changeMade)
    }
    me bool: func_altRules(their Agenda: agenda, our AItem: aItem) <- {
        our infonView: CI <- aItem!.LHS_item!.pItem
        if(CI!.altRulesApplied){return(false)}
        else{CI!.altRulesApplied <- true}
        me bool: stopAndWait <- false
        if(CI!.value!.evalMode == emIntersection){
            //logSegIn("fALTS")
            //log("func_altRules:"+aItem!.mySymbol())
            processIntersectViaAgenda(agenda, aItem!.LHS_item, aItem, aItem!.priority)
            //:l/PAI::logSegOut("")
            stopAndWait <- true
        }
        return(stopAndWait)
    }
    ////////////
    // Support for evaluating %, %prev and %next
    our infonView: getSelfInfonView(our POV: startAnchor,our POV: cursorAnchor) <- {
        their POV: anchor <- startAnchor
        if(cursorAnchor!=NULL){anchor <- cursorAnchor}
        while(anchor!=NULL and anchor!.pItem!.copySourceType!=cstDefinition){
            anchor <- anchor!.pParent
        }
        if(anchor!=NULL and anchor!.pItem!=NULL){
            return(anchor!.pItem)
        }
        return(NULL)
    }

    their POV: getRelativeAnchor(our POV: startAnchor,our POV: cursorAnchor) <- {
        their POV: anchor <- startAnchor
        if(cursorAnchor!=NULL){anchor <- cursorAnchor}
        while(anchor!.pParent!=NULL and anchor!.pItem!.copySourceType!=cstListSpec){
            anchor <- anchor!.pParent
        }
        if(anchor!=NULL){
            return(anchor)
        }
        return(NULL)
    }

    me bool: infonViewContainsNestedCursorLookup(their infonView: infn, their List<their infonView>: seen) <- {
        if(infn==NULL){return(false)}
        withEach seenInfn in seen{
            if(seenInfn===infn){return(false)}
        }
        seen.append(infn)
        if(infn!.viewMode==vmCursor or infn!.cursorMode!=cmNone){return(true)}
        our POV: child <- infn!.value!.items.head
        while(child!=NULL){
            if(infonViewContainsNestedCursorLookup(child!.pItem, seen)){return(true)}
            child <- child!.next
        }
        withEach wrkPov in infn!.wrkList{
            if(infonViewContainsNestedCursorLookup(wrkPov!.pItem, seen)){return(true)}
        }
        if(infonViewContainsNestedCursorLookup(infn!.funcArgs, seen)){return(true)}
        if(infonViewContainsNestedCursorLookup(infn!.innr, seen)){return(true)}
        return(false)
    }

    me bool: RHSNeedsNestedCursorNormalization(their infonView: infn) <- {
        // A true result here prevents the RHS from completing during merge.
        // That can leave later typed-list alternatives as bare word references
        // (e.g. rubixCube's second time state remains solvedState2).
//me List<their infonView>: seen
//return(infonViewContainsNestedCursorLookup(infn, seen))
        return(false)
    }

    me bool: lookUpCursorRules(our AItem: aItem) <- {
        our infonView: CI        <- aItem!.LHS_item!.pItem
        our infonView: newTop    <- NULL
        me bool: changeMade  <- false
        me bool: detachCursorResult <- false
        if(CI!.viewMode==vmCursor) {
            //:l/PAI::logSeg(" %*")
            switch(CI!.cursorMode){
                case cmWorld:  {newTop <- agent!.world}
                case cmContext:{newTop <- agent!.context.topicHistory; aItem!.dontProcess<-true}
                case cmUser:   {newTop <- agent!.user}
                case cmArgs:   {newTop <- aItem!.LHS_item!.pParent!.pItem!.value!.items.first()}
                case cmVars:   {} //{newTop <- next}
                case cmSelf:   {newTop <- CI!.thisPtr}
             //   case cmSelf:   {newTop <- getSelfInfonView(aItem!.LHS_item, aItem!.cursorAnchor)}
                case cmPrev: {
                    their POV: anchor <- getRelativeAnchor(aItem!.LHS_item, aItem!.cursorAnchor)
                    if(anchor!=NULL and anchor!.prev!=NULL){
                        newTop <- anchor!.prev!.pItem
                        detachCursorResult <- true
                        }
                    else {
                        CI!.value!.undefined <- true
                    }
                }
                case cmNext: {
                    their POV: anchor <- getRelativeAnchor(aItem!.LHS_item, aItem!.cursorAnchor)
                    if(anchor!=NULL and anchor!.next!=NULL){
                        newTop <- anchor!.next!.pItem
                        detachCursorResult <- true
                        }
                    else {
                        CI!.value!.undefined <- true
                    }
                }
            }
            if(newTop!=NULL) {
                our PartPath: partRef   <- CI!.partRef
                me bool: doReply        <- CI!.doReply
                me uint64: originID     <- CI!.originID
                me uint64: infCharPos   <- CI!.infCharPos
                me uint64: itmMode      <- CI!.itmMode
                if(CI!.cursorMode==cmWorld){inheritDefinitionListShapeForInfonView(newTop)}
                if(CI!.cursorMode==cmWorld and partRef==NULL and CI!.parts.isEmpty()){
                    aItem!.LHS_item!.pItem <- newTop
                    aItem!.LHS_item!.accessMode <- aRefTo
                    CI <- aItem!.LHS_item!.pItem
                }else if(detachCursorResult){
                    our infonView:: detachedTop
                    newTop!.copyAsTypeTo(detachedTop, false, false)
                    CI! <- detachedTop!
                }else{
                    // Debugging? more items from CI may need to go here.
                    CI! <- newTop!
                }
                CI!.partRef    <- partRef
                CI!.doReply    <- doReply
                CI!.originID   <- originID
                CI!.infCharPos <- infCharPos
                CI!.itmMode    <- itmMode
                aItem!.LHS_item!.propagateInMrg2 <- true
                CI!.wrkList.clear()
                changeMade <- true
            }
        }
        return(changeMade)
    }
    me bool: normSize(their Agenda: agenda, our AItem: aItem) <- {
        if(aItem!.LHS_item!.pItem!.sizeNormed){return(false)}else{aItem!.LHS_item!.pItem!.sizeNormed<-true}
        me bool: stopAndWait <- false
        our infonState: infSize <- aItem!.LHS_item!.pItem!.infSize
        if(infSize!.evalMode==emConcat and infSize!.overlayType!=STR){
            our POV:: tmpPov{10}
            our infonView:: tmpInfon
                tmpInfon!.value   <- aItem!.LHS_item!.pItem!.infSize
                tmpInfon!.itmMode <- mItem
                tmpInfon!.viewMode <- vmOverlay
            tmpPov!.pItem <- tmpInfon
            our AItem: newAItem <-  processInfonViewViaAgenda(agenda, tmpPov, NULL, aItem, aItem!.priority, srcNrmSize)
            if(newAItem!=NULL){
                //:l/PAI::logSeg(" sizePIVA:"+newAItem!.mySymbol())
                agenda!.addAItemToAgenda(newAItem) // PIVA
                addDebugEvent("RegisterPIVA to norm size of "+aItem!.LHS_item!.pItem!.mySymbol()+":"+toString(aItem!.LHS_item!.pItem), aItem!.LHS_item!.pItem)
                printDebInf("nrmSize", aItem!.LHS_item!.pItem)
                stopAndWait <- true
            }
        }
        return(stopAndWait)
    }
    me bool: wrkLstRules(their Agenda: agenda, our AItem: aItem) <- {
        ////////// If "{[....]| ... } <~ outr", prepend outr to wrkList
        //:l/PAI::logSegIn(" WL")
        our infonView: lSpecItem <- aItem!.LHS_item!.pItem
        our infonView: lSpec <- lSpecItem!.value!.listSpec
        if(lSpec!=NULL and lSpecItem!.hasInnrOutr and lSpecItem!.intersectPos==ipNoIntersect and lSpec!.intersectPos!=ipNoIntersect){
            //log("OUTR: lSpecItem: "+toString(lSpecItem) + "   lSpec:" +toString(lSpec) + "   outr:" +toString(lSpecItem!.funcArgs))
            //:l/PAI::logSeg(" Otr")
            our POV:: newPov{11}; newPov!.pItem <- lSpecItem!.funcArgs; newPov!.looseMode <- true; newPov!.isOutrFeed<-true; newPov!.pItem!.asRHSInternalIdent <- true
            lSpecItem!.addPOVToWrkList(newPov)
            lSpecItem!.hasInnrOutr<-false;  lSpecItem!.funcArgs <- NULL
            lSpec!.asWrkLstOutr <- true
        }

        ////////// Handle items on WrkList
        me bool: stopAndWait <- false
        our POV: LHSPov    <- aItem!.LHS_item
        our POV: RHSPov    <- NULL
        me bool: looseSize <- false
        //if(lSpecItem!.wrkList.isEmpty() and LHSPov!.hasPropagated){log("WARNING: NotRePropagating "+LHSPov.stringify())}
        if(!lSpecItem!.wrkList.isEmpty()){
            RHSPov <- lSpecItem!.wrkList.first()
            //:l/PAI::logSeg(" WLP:"+RHSPov!.mySymbol())
            lSpecItem!.wrkList.popFirst()
            lSpecItem!.usedWrkList.append(RHSPov)
            looseSize <- RHSPov!.looseSize()
            LHSPov!.hasPropagated <- true
            if(!aItem!.dontProcess){
                our AItem: newAItem <- processMergeViaAgenda(agenda, LHSPov, RHSPov, looseSize, aItem, aItem, aItem!.priority, srcPMVA1)
                newAItem!.debugArg <- aItem // For validateAItem debugging
                //:l/PAI::logSeg(" Itm_PMVA:"+newAItem!.mySymbol())
                stopAndWait <- true
            }else{
                log("DONT_PROCESS-a:"+aItem!.stringify())
                //:l/PAI::logSeg(" dontProcess")
            }
        }
        if(!LHSPov!.hasPropagated){
            if(!aItem!.dontProcess){
                our AItem: newAItem <- processMergeViaAgenda(agenda, LHSPov, RHSPov, false, aItem, aItem, aItem!.priority, srcPMVA2)
                newAItem!.debugArg <- aItem // For validateAItem debugging
                //:l/PAI::logSeg(" LHS_PMVA:"+newAItem!.mySymbol())
                stopAndWait <- true
                LHSPov!.hasPropagated <- true
            }else{
                log("DONT_PROCESS-b:"+aItem!.stringify())
                //:l/PAI::logSeg(" dontProcess_LHS")
            }
        }else{
            //:l/PAI::logSeg(" NoProp")
        }
        //:l/PAI::logSegOut("")
        return(stopAndWait)
    }
    me bool: povIsUnderIncompleteStream(their POV: pov) <- {
        their POV: crnt <- pov
        while(crnt!=NULL){
            if(crnt!.pItem!=NULL and (crnt!.pItem!.streamState==parseStarted or crnt!.pItem!.streamState==parseListReady)){return(true)}
            crnt <- crnt!.pParent
        }
        return(false)
    }
    me bool: hasLocalNullableContinuation(our AItem: aItem) <- {
        if(!povIsUnderIncompleteStream(aItem!.LHS_item)){return(false)}
        our infonView: CI <- aItem!.LHS_item!.pItem
        return(CI!.partRef!=NULL or !CI!.parts.isEmpty())
    }
    me bool: localNullableContinuationRules(their Agenda: agenda, our AItem: aItem, their bool: nxtAction) <- {
        if(hasLocalNullableContinuation(aItem)){
            return(partsRules(agenda, aItem, nxtAction))
        }
        return(false)
    }
    // rsINFON UTILITY FUNCTIONS: CONCAT FUNCTIONS
    me int: evalForRange(our infonView: infn, their FlexNum: lowest, their FlexNum: highest) <- {
        if(infn!.value!.evalMode!=emConcat){
            if(infn!.value!.overlayType==NUM){
                if(infn!.infSize!.evalMode==emLiteral){
                    if(infn!.value!.evalMode==emLiteral){// eg: *5+3
                        lowest!  <- infn!.value!.num
                        highest! <- lowest!
                    }
                    else if(infn!.value!.evalMode==emUnknown){// eg: *5+_
                        lowest!  <- 0
                        highest! <- infn!.infSize!.num
                    }
                    else{return(1)}
                }
                else if(infn!.infSize!.evalMode==emUnknown){
                    if(infn!.value!.evalMode==emLiteral){// eg: *_+3
                        lowest!  <- infn!.value!.num
                        highest! <- infn!.value!.num
                    }
                    else{return(1)}
                }
                else{return(1)}
            }
            else{logFatalError("    evalForRange:error")}
            return(3)
        }else if(infn!.value!.evalMode==emConcat){
            if(infn!.value!.items.size()==2){
                our infonView: first  <- infn!.value!.items.first()
                our infonView: secnd <- infn!.value!.items.last()
                if(first!.value!.overlayType==NUM and first!.value!.evalMode==emUnknown and first!.infSize!.evalMode==emLiteral and
                   secnd!.value!.overlayType==NUM and secnd!.value!.evalMode==emLiteral and secnd!.infSize!.evalMode==emUnknown and secnd!.value!.sizeMode==fromContext){
                    lowest!  <- secnd!.value!.num
                    highest! <- lowest! + first!.infSize!.num
                }
            }
            else{return(1)}
            return(3)
        }
        return(1)
    }
    void: resetNumRange(our infonView: infn, their FlexNum: lowest, their FlexNum: highest) <- {
        if(infn!.value!.evalMode!=emConcat){logFatalError("TODO: handle non-concat in resetNumRange")}
        if(infn!.value!.items.size()==2){
            our infonView: first  <- infn!.value!.items.first()
            our infonView: secnd <- infn!.value!.items.last()
            if(first!.value!.overlayType==NUM and first!.value!.evalMode==emUnknown and first!.infSize!.evalMode==emLiteral and
               secnd!.value!.overlayType==NUM and secnd!.value!.evalMode==emLiteral and secnd!.infSize!.evalMode==emUnknown and secnd!.value!.sizeMode==fromContext){
                secnd!.value!.num <- lowest!
                first!.infSize!.num <- highest! - lowest!
            }
        }
    }
    me bool: mergeANDRanges(our AItem: aItem) <- {
        me FlexNum: lowestLHS
        me FlexNum: highestLHS
        me FlexNum: lowestRHS
        me FlexNum: highestRHS
        our infonView: LHSInfon <- aItem!.LHS_item!.pItem
        me int: rangeResultLHS <- evalForRange(LHSInfon, lowestLHS, highestLHS)
        if(rangeResultLHS!=pass){return(true)}
        me int: rangeResultRHS <- evalForRange(aItem!.RHS!.pItem, lowestRHS, highestRHS)
        if(rangeResultRHS!=pass){return(true)}
        me FlexNum: lowestNew <- max(lowestLHS, lowestRHS)
        me FlexNum: highestNew <- min(highestLHS, highestRHS)
        resetNumRange(LHSInfon, lowestNew, highestNew)
        return(false)
    }
    me bool: checkNumRange(our infonView: LHS, our infonView: RHS) <- { // NUM=(range)
        me FlexNum: lowestLHS
        me FlexNum: highestLHS
        me FlexNum: lowestRHS
        me FlexNum: highestRHS
        me int: rangeResultLHS <- evalForRange(LHS, lowestLHS, highestLHS)
        if(rangeResultLHS!=pass){return(true)}
        me int: rangeResultRHS <- evalForRange(RHS, lowestRHS, highestRHS)
        if(rangeResultRHS==pass){
            if(lowestLHS <= lowestRHS and highestLHS > highestRHS){
                return(true)
            }
            else{return(false)}
        }
        return(true)
    }
    me bool: joinOnRight(our infonView: LHS, our infonView: RHS) <- { // Join RHS into LHS. Return true on success (so need no subscription).
        //:l/PAI::logSeg(" JOR:")
        if(LHS!.value!.evalMode==emLiteral and RHS!.value!.evalMode==emLiteral){
            me int: LHSType <- LHS!.value!.overlayType
            if(LHSType == RHS!.value!.overlayType){
                switch(LHSType){
                    case NUM: {
                        if(RHS!.value!.sizeMode==fromContext){
                            LHS!.value!.num   <+- RHS!.value!.num
                            //:l/PAI::logSeg(" CCatNUM+  infSize:" + toString(LHS!.infSize!.num))
                        }else{
                            LHS!.infSize!.num <- LHS!.infSize!.num * RHS!.infSize!.num
                            LHS!.value!.num   <- (LHS!.value!.num * RHS!.infSize!.num) + RHS!.value!.num
                            //:l/PAI::logSeg(" CCatNUM*")
                        }
                    }
                    case STR: {
                        LHS!.value!.str.append(RHS!.value!.str)
                        LHS!.infSize!.num<-LHS!.value!.str.size()
                        //:l/PAI::logSeg(" CCatSTR:"+LHS!.value!.str)
                    }
                    case LST: {
                        our POV: povElement <- RHS!.value!.items.head
                        while(povElement != NULL){
                            our infonView: pItemElement <- povElement!.pItem
                            LHS!.value!.items.append(pItemElement, povElement!.isSubItm, 12)
                            povElement <- povElement!.next
                        }
                        //:l/PAI::logSeg(" CCatLST")
                    }
                    default: {return(false)}
                }
            } else {} // TODO: handle type conversions
            return(true)
        }
        return(false)
    }

    me bool: collapseSingletonConcat(our infonView: infn) <- {
        me bool: changeMade <- false
        while(infn!.value!.evalMode==emConcat and !infn!.value!.items.isEmpty() and infn!.value!.items.head!.isLast()){
            if(infn!.infSize!.evalMode!=emUnknown){
                infn!.value! <- infn!.value!.items.first()!.value!
                infn!.value!.sizeMode <- fromGiven
            } else {
                infn! <- infn!.value!.items.first()!
            }
            changeMade <- true
        }
        return(changeMade)
    }

    me bool: canUnwrapSingletonSubItem(our POV: pov) <- {
        if(pov==NULL or !pov!.isSubItm){return(false)}
        // The selected marked wrapper owns the result's list shape; only unwrap
        // ordinary singleton subitems inside that result.
        if(pov!.pParent!=NULL and pov!.pParent!.pItem!.intersectMarkedRetPOV!=NULL and
                (pov!.pParent!.pItem!.intersectMarkedRetPOV===pov or pov!.pParent!.pItem!.intersectMarkedRetPOV!.pItem===pov!.pItem)){
            return(false)
        }
        if(pov!.pParent!=NULL and pov!.pParent!.pItem!.isInnr and pov!.pParent!.pItem!.intersectMarkedRetPOV!=NULL){return(false)}
        our infonView: subList <- pov!.pItem
        if(subList==NULL){return(false)}
        if(subList!.viewMode!=vmOverlay){return(false)}
        if(subList!.type!=NULL){return(false)}
        if(subList!.value!.overlayType!=LST or subList!.value!.evalMode!=emLiteral){return(false)}
        if(subList!.value!.tailUnfinished or subList!.value!.listSpec!=NULL){return(false)}
        if(subList!.value!.items.size()!=1){return(false)}
        if(subList!.intersectPos!=ipNoIntersect){return(false)}
        if(!subList!.wrkList.isEmpty()){return(false)}
        if(subList!.partRef!=NULL or !subList!.parts.isEmpty()){return(false)}
        if(subList!.argPos!=apNoArgs){return(false)}
        return(true)
    }

    me bool: unwrapSingletonSubItems(our infonView: infn) <- {
        me bool: changeMade <- false
        if(infn!.value!.overlayType!=LST or infn!.value!.evalMode!=emLiteral){return(false)}
        if(infn!.value!.items.size()<=1){return(false)}
        our POV: pov <- infn!.value!.items.head
        while(pov!=NULL){
            if(canUnwrapSingletonSubItem(pov)){
                our POV: onlyItem <- pov!.pItem!.value!.items.head
                pov!.pItem <- onlyItem!.pItem
                pov!.isSubItm <- onlyItem!.isSubItm
                changeMade <- true
            }
            pov <- pov!.next
        }
        if(changeMade){infn!.countSize(false)}
        return(changeMade)
    }

    me bool: JoinIfConcat(our POV: pov) <- {
        me bool: changeMade  <- false
        if(pov!.pParent!=NULL and (pov!.pParent!.pItem!.value!.evalMode==emConcat)){
            if(pov!.isFirst()){ // Set Parent's type
            } else {
                our POV: prev <- pov!.prev
                if(prev != NULL){
                        //log("CCAT_PREV:"+prev.stringify() +" <= "+pov!.stringify())
                    if(joinOnRight(prev!.pItem, pov!.pItem)){
                        pov!.pParent!.pItem!.value!.items.erase(pov)
                        changeMade <- true
                        //:l/PAI::logSeg(" erase:")
                    }else{}  // Subscribe
                }
            }
            // (234) --> 234
            our infonView: CI <- pov!.pParent!.pItem
            if(collapseSingletonConcat(CI)){changeMade <- true}
        }
        return(changeMade)
    }
    me bool: processConcat(our AItem: aItem) <- {
        me bool: changeMade  <- false
        if(aItem!.concatProcessed){return(changeMade)}else{aItem!.concatProcessed<-true}
        if(JoinIfConcat(aItem!.LHS_item)){changeMade <- true}
        return(changeMade)
    }
    me bool: partsRules(their Agenda: agenda, our AItem: aItem, their bool: nxtAction) <- {
        me bool: changeMade <- false
        nxtAction! <- true
        our infonView: CI        <- aItem!.LHS_item!.pItem
        if(CI!.partRef!=NULL){
            //log("PART2REF:"+toString(CI!.partRef!.path))
            //:l/PAI::logSeg(" Part2Ref")
            CI!.parts.append(CI!.partRef)
            CI!.partRef<-NULL
        }
        if(!CI!.parts.isEmpty()){
            withEach part in CI!.parts{
                me string: partTag
                if(part!.path!.type != NULL){partTag <- part!.path!.type!.typeID()}
                our infonView: newPath
                our POV: newPov
                if(part!.wasTransfered){continue()}else{part!.wasTransfered <- true}
                //log("@@PART:"+toString(part!.path)+" viewMode:"+viewModeStrings[part!.path.viewMode] + "  CI:"+toString(CI))
                //:l/PAI::logSegIn(" PART")
                //print("PART_PART:"+toString(part!.path)+"\n")
                switch(part!.pathMode){
                    case dotField:{
                        //:l/PAI::logSeg(" DOT."+partTag)
                        if(CI!.orderMode==uUnordered){
                            newPath <- CI!.findMatchingItem(part!.path)
                        } else if(part!.path!.type != NULL){
                            if(partTag == "first"){newPath <- CI!.getFirstItem(aItem!.LHS_item!.isSubItm)}
                            else if(partTag == "last") {newPath <- CI!.getLastInfonView()}
                            //else if(partTag == "size"){newPath <- getSizeInfonView}
                            // else {Later, optimize various lookups}  // Only after non-optimized lookups are robust
                        }
                        if(newPath==NULL){
                            me bool: doReply <- CI!.doReply
                            if(doReply){CI!.doReply <- false}
                            our infonView:: skipPtn
                                part!.path!.copyAsTypeTo(skipPtn, false, false)
                                // Keep !path as the written selector token; local word defs should not stop the scan.
                                skipPtn!.wordDerefed          <- true
                                skipPtn!.invertMatch                 <- true
                            our infonView:: matchPtn
                                part!.path!.copyAsTypeTo(matchPtn, false, false)
                            our infonView:: skipPart
                                skipPart!.setToList()
                                skipPart!.value!.sizeMode       <- fromCount
                                skipPart!.infSize!.overlayType        <- NUM
                                skipPart!.infSize!.evalMode       <- emUnknown
                                skipPart!.value!.listSpec       <- skipPtn
                            our infonView: newInnr <- makeInnrInfonView()
                                newInnr!.value!.items.append(skipPart, true, 13)
                                newInnr!.value!.items.append(matchPtn, false, 14)
                                newInnr!.orderMode      <- CI!.orderMode
                            Allocate(newPath)
                                newPath!.convertThisToIntersection(newInnr, fromGiven)
                                newPath!.doReply        <- doReply
                                newInnr!.value!.sizeMode <- fromCount
                                newPath!.value!.sizeMode <- fromCount
                                newPath!.infSize!.overlayType  <- NUM
                                newPath!.originID       <- CI!.originID
                                newPath!.infCharPos     <- CI!.infCharPos
                                // Preserve unordered/ordered semantics when a dot lookup
                                // falls back to a synthetic intersection such as {!color|...} color.
                                newPath!.orderMode      <- CI!.orderMode
                                if(part!.path!.partRef!=NULL){
                                    newPath!.partRef    <- part!.path!.partRef
                                    part!.path!.partRef  <- NULL
                                }else{
                                    newPath!.parts      <- part!.path!.parts
                                }
                    //print("newPath!.infCharPos:", newPath!.infCharPos, "\n")
                            newPov <- newPath!.innr!.addInfonViewToWrkList(CI, true, 15)
                            newPov!.looseMode <- false; newPov!.looseTop  <- true
                        }
                    }
                    case upField:{
                        //:l/PAI::logSeg(" ^"+partTag)
                        //if(partTag == "pred"){}
                    }
                    case idxField:{
                        //:l/PAI::logSeg(" #"+partTag)
                        if(part!.spec==NULL){
                            if(part!.path!.value!.overlayType == NUM){
                                me bool: doReply <- CI!.doReply
                                if(doReply){CI!.doReply <- false}
                                our infonView: newInnr <- makeInnrInfonView()
                                    newInnr!.value!.tailUnfinished <- true
                                Allocate(newPath)
                                    newPath!.convertThisToIntersection(newInnr, fromGiven)
                                    newPath!.doReply        <- doReply
                                    newPath!.value!.sizeMode <- fromCount
                                    newPath!.infSize!.overlayType  <- NUM
                                    newPath!.originID       <- CI!.originID
                                    newPath!.infCharPos     <- CI!.infCharPos
                                    if(part!.path!.partRef!=NULL){
                                        newPath!.partRef    <- part!.path!.partRef
                                        part!.path!.partRef  <- NULL
                                    }else{
                                        newPath!.parts      <- part!.path!.parts
                                    }
                                    newInnr!.infSize!              <- part!.path!.value!
                                    newInnr!.value!.sizeMode       <- fromCount
                                newPov <- newPath!.innr!.addInfonViewToWrkList(CI, true, 16)
                                newPov!.looseMode <- false; newPov!.looseTop  <- true
                            }
                        }else{
                            if(part!.path!.value!.overlayType == NUM){
                                me bool: doReply <- CI!.doReply
                                if(doReply){CI!.doReply <- false}
                                our infonView:: skipPart
                                skipPart!.setToList()
                                skipPart!.infSize!        <- part!.path!.value!
                                skipPart!.value!.sizeMode <- fromGiven
                                our infonView: partSpec     <- part!.spec
                                our infonView: newInnr <- makeInnrInfonView()
                                    newInnr!.value!.tailUnfinished <- false
                                    newInnr!.value!.items.append(skipPart, true, 17)
                                    our POV: partPov <- newInnr!.value!.items.append(partSpec, false, 18)
                                    partPov!.isSubItm <- true
                                Allocate(newPath)
                                    newPath!.convertThisToIntersection(newInnr, fromGiven)
                                    newPath!.doReply        <- doReply
                                    newPath!.value!.sizeMode <- fromGiven
                                    newPath!.infSize!.overlayType  <- NUM
                                    newPath!.originID       <- CI!.originID
                                    newPath!.infCharPos     <- CI!.infCharPos
                                    newPath!.intersectPos <- ipGetMarked
                                    newPath!.intersectMarkedRetPOV <- partPov
                                    if(part!.path!.partRef!=NULL){
                                        newPath!.partRef    <- part!.path!.partRef
                                        part!.path!.partRef  <- NULL
                                    }else{
                                        newPath!.parts      <- part!.path!.parts
                                    }
                                newPov <- newPath!.innr!.addInfonViewToWrkList(CI, true, 19)
                                newPov!.looseMode <- false; newPov!.looseTop  <- true
                            }
                        }
                    }
                    case colonField:{}
                }
                if(newPath==NULL){logFatalError("Handle newPath is null")}
                newPath!.takeWrkListFrom(part!.path, true)
                if(!part!.hasSemiColon){
                    aItem!.LHS_item!.pItem <- newPath
             //aItem!.LHS_item!.hasPropagated <- false
                    nxtAction! <- true
                }else{
                    our POV:: pathPov{20}
                    pathPov!.pItem <- newPath
                    aItem!.LHS_item!.pItem!.retainPOV(pathPov)
                    our AItem: newAItem <-  processInfonViewViaAgenda(agenda, pathPov, NULL, aItem, aItem!.priority, srcPartsPath)
                    if(newAItem!=NULL){
                        //:l/PAI::logSeg(" pPIVA:"+newAItem!.mySymbol())
                        addDebugEvent("RegisterPIVA to integrate "+newPath!.mySymbol()+":"+toString(newPath), newPath)
                        agenda!.addAItemToAgenda(newAItem) // PIVA
                    }
                    nxtAction! <- false
                }
                changeMade <- true
                //:l/PAI::logSegOut("")
            }
        }
        return(changeMade)
    }
    // rsINFON UTILITY FUNCTIONS: CLEAN INFON FUNCTIONS
    void: closeIntersectAt(our POV: pov) <- {
        pov!.pItem!.isTentative <- false
        //:l/PAI::logSeg(" resetTent:B")
        our PartPath: tmpParfDef <- pov!.outerPOV!.pItem!.partRef
        pov!.outerPOV!.pItem! <- pov!.pItem!
        pov!.outerPOV!.pItem!.partRef <- tmpParfDef
        pov!.outerPOV!.predecessors <- pov!.predecessors
    }
    void: validateItem(our POV: lastItem) <- {
        me bool: oneMore<-false
        our POV: pov <- lastItem
        their POV: topParent <- lastItem!.pParent
        if(lastItem!.outerPOV!=NULL){topParent <- lastItem!.outerPOV!.pParent}
        //log("VALIDATING: lastItem:" + pov!.mySymbol() +":" + pov!.stringify() + "    topParent:"+topParent.stringify())
        //:l/PAI::logSeg(" VAL")
        while(pov!=NULL){
            their POV: parent <- pov!.pParent
            if(pov!.outerPOV!=NULL){parent <- pov!.outerPOV!.pParent}
            me string: logStr <- "   VALIDATE:" + pov!.mySymbol() +":" + pov!.stringify() + "    PARENT:<"+parent!.stringify()+">"
        if(pov!==topParent or !pov!.pItem!.value!.tailUnfinished){
            if(pov!.pItem!.isTentative){
                //:l/PAI::logSeg(" resetTent:C")
            }
            pov!.pItem!.isTentative <- false
            if(pov!.outerPOV!=NULL and pov!.outerPOV!.pItem!.isOrLike()){ // First check whether pov is in [...]
                logStr <+- "[closeIntersectAt]"
                closeIntersectAt(pov)
            } else if(pov!==topParent and parent!=NULL and parent!.pItem!.value!.tailUnfinished){ // Close a list at lastItem
                    logStr <+- ":LAST_ITEM"
                    parent!.closeItemsAtPOV(pov)
            }
        }
            if(oneMore){
                pov<-NULL
            } else if(pov!.predecessors.size()==1){
                our POV: oldPovPrev <- pov!.prev
                our POV: pred <- pov!.predecessors.first()
                if(topParent!==pred and topParent!.pItem!==pred!.pItem!.innr){
                    logStr <+- ":TO_PRED:" + pred!.stringify()
                    pov <- pred
                }else{
                    pov<-pred
                    if(!pov!.pItem!.cnvtToFunc){oneMore<-true;} else {pov<-NULL; logStr <+- ":ONE_MORE"}
                }
                if(oldPovPrev!=NULL and pred!=NULL and !(oldPovPrev===pred!.pParent)){
                    trimTowardInfonViewFront(pred, oldPovPrev)
                }
            }else{logStr <+- ":EXIT_"+toString(pov!.predecessors.size())+"_PREDS"; pov <- NULL}
            //log(logStr)

        }
    }
    void: cleanUpInfonView(our AItem: aItem) <- {
        //:l/PAI::logSegIn(" CLEAN")
        our infonView: CI <- aItem!.LHS_item!.pItem
        // {? ...}  --> {...}
        if(CI!.value!.tailUnfinished and !CI!.value!.items.isEmpty() and CI!.value!.items.last()!.isTentative){
            //:l/PAI::logSeg(" popT")
            CI!.value!.items.popLast()
        }

        // If this is [], i.e, null, remove it from parent list.
        if(CI!.intersectPos==ipGetLast and CI!.innr!=NULL and CI!.innr!.infSize!.evalMode==emLiteral and CI!.innr!.value!.sizeMode==fromCount and CI!.innr!.infSize!.num==0){
            if(aItem!.LHS_item!.pParent != NULL){
                //:l/PAI::logSeg(" del[]")
 /*Resolve the NULL ambiguity*/           aItem!.LHS_item!.pParent!.pItem!.value!.items.erase(aItem!.LHS_item)
            }
        }
//if(CI!.value!.overlayType==LST){log("PREDS___\n"+stringifyPreds(aItem!.LHS_item, ""))}
        if(CI!.value!.overlayType==LST and CI!.value!.evalMode==emLiteral){
            me int: numCandidates <- aItem!.LHS_item!.candidatesForLastItem.size()
            //log("CLEAN_LIST:"+aItem!.LHS_item!.mySymbol()+":"+ aItem!.LHS_item!.stringify()+"  #candidates:"+toString(numCandidates))
            if(numCandidates==1){
                our POV: lastItem <- aItem!.LHS_item!.candidatesForLastItem.last()
                aItem!.LHS_item!.candidatesForLastItem.popLast()
                //:l/PAI::logSeg(" CLEAN_LAST:" + lastItem!.mySymbol())
                //log("-CLEAN_LAST:" + lastItem.stringify())
                if(lastItem!.outerPOV!=NULL and lastItem!.outerPOV!.forLastUseOutrPov and lastItem!.outerPOV!.predecessors.size()>0){//TODO: need to verify this logic
                    //:l/PAI::logSeg(" UseOuterPOV:"+lastItem!.outerPOV!.mySymbol())
                    validateItem(lastItem!.outerPOV)
                }else {
                    validateItem(lastItem)
                }
                CI!.countSize(false)
            } else if(numCandidates==0){
                //:l/PAI::logSeg(" Clean0")
                if(aItem!.LHS_item!.forLastUseLastItem){
                    /*log("IN_VAL0:"+aItem!.LHS_item!.stringify())*/
                    validateItem(CI!.value!.items.tail)
                } else if(CI!.value!.items.tail!=NULL and (CI!.value!.sizeMode!=fromGiven and CI!.infSize!.evalMode==emUnknown)){
                    /*log("IN_VAL1:"+aItem!.LHS_item!.stringify())*/
                    validateItem(CI!.value!.items.tail)
                }
                //else{log("IN_VAL2:"+aItem!.LHS_item!.stringify())  aItem!.mergeStatus<-msReject; aItem!.LHS_item!.rejected<-true}
            } else{
                //:l/PAI::logSeg(" LST!")
                our POV: lastItem <- NULL
                if(CI!.value!.items.tail!=NULL){
                    withEach cand in aItem!.LHS_item!.candidatesForLastItem Backward{
                        if(cand!.outerPOV===CI!.value!.items.tail and cand!.predecessors.size()==1){
                            lastItem <- cand
                            break()
                        }
                    }
                }
                if(lastItem!=NULL){
                    validateItem(lastItem)
                    CI!.countSize(false)
                }
            }
            // log("candidatesForLastItem:"+toString(numCandidates))}
            unwrapSingletonSubItems(CI)
        }
        //:l/PAI::logSegOut("")
    }

    // MERGE_RULES UTILITY FUNCTIONS
    me int: matchLength(me string: A, me string: B)<-{
        //log("matchLength: '"+A +"'     '" +B+"'")
        me int: lastChar
        me int: retVal <-0
            lastChar <- min(A.size(), B.size())
        if (lastChar==0){return(0)}
        withEach pos in range 0 .. lastChar{
            if(A[pos]!= B[pos]){
                return(pos-1)
            }
        }
        return(lastChar)
    }
    our POV: mergeLooseStrings(our AItem: aItem) <- {
        //log("mergeLooseStrings:"+aItem!.stringify())
        our infonView: LHS <- aItem!.LHS_item!.pItem
        our infonView: RHS <- aItem!.RHS!.pItem
        me int64: sizeDiff
        me int64: RSize <- RHS!.value!.str.size()
        me int64: LSize
        if(LHS!.value!.evalMode==emUnknown){
            if(LHS!.infSize!.evalMode == emUnknown){
                sizeDiff            <- 0
                LHS!.value!.evalMode    <- emLiteral
                LHS!.value!.str       <- RHS!.value!.str
                LHS!.value!.sizeMode  <- fromGiven
            }else if(LHS!.infSize!.evalMode == emLiteral){
                LSize       <- LHS!.infSize!.num.convertToFloat()
                sizeDiff            <- RSize - LSize
                LHS!.value!.evalMode    <- emLiteral
                LHS!.value!.str       <- RHS!.value!.str.subStr(0, LSize)
                LHS!.value!.sizeMode  <- fromCount
            }
        }
        else{
            LSize <- LHS!.value!.str.size()
            me int: matchLen <- matchLength(LHS!.value!.str, RHS!.value!.str)
            me bool: matchFailed
            if(matchLen==-1 or (matchLen < LSize and matchLen < RSize)){
                matchFailed  <- true
                aItem!.mergeStatus <- msReject
                aItem!.LHS_item!.rejected<-true
            }
            else{
                sizeDiff    <- RSize - LSize
                matchFailed <- false
            }
        }
        if(sizeDiff > 0 ){
            me string: remainderStr <- RHS!.value!.str.subStr(convertToIntVal(RSize -sizeDiff), convertToIntVal(sizeDiff))
            our infonView: remainderInfon; Allocate(remainderInfon,remainderStr)
            our POV:: remainder{21}
            remainder!       <- aItem!.RHS!
            remainder!.pItem     <- remainderInfon
            aItem!.sizeToCopy    <- RSize - sizeDiff
            return(remainder)
        } else if(sizeDiff==0){
            aItem!.sizeToCopy    <- RSize
        }
        return(NULL)
    }
    our POV: mergeLooseNums(our AItem: aItem) <- {
        return(NULL)
    }
    void: DO_COPY(their infonState: from, their infonState: to, me FlexNum: sizeToCopy) <- {
        me int: fromsType <- from!.overlayType
        if(fromsType==to!.overlayType){
            to!.evalMode<-from!.evalMode
            to!.sizeMode <- from!.sizeMode
            switch(fromsType){
                case NUM: {to!.num <- from!.num}
                case STR: {
                    if(sizeToCopy==0){to!.str <- from!.str}
                    else {to!.str <- from!.str.subStr(0, sizeToCopy.convertToFloat())}
                }
                case LST: {to!.items <- from!.items}
            }
        } else {  // TODO: Do Convert + copy
        }
    }
    me bool: sizesAreCompatable(our infonView: LHS, our infonView: RHS)<-{return(true)}

    me void: initListIterators(our AItem: aItem) <- {
        if(aItem!.LHSItr==NULL){
            Allocate(aItem!.LHSItr); aItem!.LHSItr!.initialize(aItem!.LHS_item)
            lastLineAltID <+- 1; aItem!.LHSItr!.lineAltID <- lastLineAltID
///me string: nodeID <- aItem!.LHSItr!.mySymbol()+"L"
//log("InitInfItr:"+nodeID+" ID:"+toString(lastLineAltID) + "   AITEM:"+aItem!.mySymbol()+":"+aItem!.stringify())
///grapher.addNode(nodeID, nodeID, "style=filled color=red")
///grapher.addArrow(nodeID, aItem!.mySymbol(), "topPov", "color=purple")
            our AItem: intPrnt <- aItem!.prntOrSub()!.prntOrSub()
            if(intPrnt!=NULL){
                aItem!.LHSItr!.iParent <- intPrnt!.LHSItr
                ///grapher.addArrow(nodeID, aItem!.LHSItr!.iParent.mySymbol()+"L", "iParent", "color=skyblue")
            }
        }
        if(aItem!.RHS!=NULL and aItem!.RHSItr==NULL){
            Allocate(aItem!.RHSItr)
            aItem!.RHSItr!.initialize(aItem!.RHS)
///me string: nodeID <- aItem!.RHSItr!.mySymbol()+"R"
///grapher.addNode(nodeID, nodeID, "style=filled color=orange")
///grapher.addArrow(nodeID, aItem!.mySymbol(), "topPov", "color=green")
            our AItem: intPrnt <- aItem!.prntOrSub()!.prntOrSub()
            if(intPrnt!=NULL){
                aItem!.RHSItr!.iParent <- intPrnt!.RHSItr
                ///grapher.addArrow(nodeID, aItem!.RHSItr!.iParent.mySymbol()+"R", "iParent", "color=blue")
            }
        }
    }

    me void: mergeRHSIntersect(our AItem: aItem) <- {
        //:l/PAI::logSeg(" mergeRHSIntersect")
        // TODO: make this work with inverted and marked intersections
        our infonView: LHS <- aItem!.LHS_item!.pItem
        our infonView: RHS <- aItem!.RHS!.pItem
        if(RHS!.isOrLike()){
            me bool: isFromAlt <- (aItem!.RHS!.linearAltID>0)
         //   if(isFromAlt){ or RHS!.innr!.value!.tailUnfinished==false){ // TODO: remove the !isFromAlt condition
       if(true or isFromAlt) {RHS!.innr!.value!.tailUnfinished<-false}  // TODO-WORKING: Mark this elsewhere !!!!!!!!!!!!!!!!!!!!!!!!!!!!!############!!!!!!!!!!!!!!
                our infonView: newListInfon <- makeInnrInfonView()
                our POV: pov <- RHS!.innr!.value!.items.head
                while(pov != NULL){
                    // TODO: if(sizesNotCompatable()){markAsReject or notLast}
                    our infonView:: altItem
                    LHS!.copyAsTypeTo(altItem,false, true)
                    altItem!.isTentative <- true
                    our POV:: RHSPov{22}; RHSPov! <- pov!
                    altItem!.addPOVToWrkList(RHSPov)
                    our POV: LHSPOV <- newListInfon!.value!.items.append(altItem, pov!.isSubItm, 23)
                    if(isFromAlt) {LHSPOV!.isFromALT <- true}
                    LHSPOV!.outerPOV <- aItem!.LHS_item
                    LHSPOV!.predecessors <- pov!.predecessors
                    pov <- pov!.next
                }
                LHS!.convertThisToIntersection(newListInfon, fromGiven)
                LHS!.innr!.value!.tailUnfinished <- RHS!.innr!.value!.tailUnfinished
                LHS!.innr!.value!.sizeMode <- fromGiven
                LHS!.altRulesApplied <- false
        }else{
            log("MG_RHS_INSCT_NotAlt:"+aItem!.stringify())
              //  aItem!.mergeStatus<-msPending
            // TODO: subscribe to RHS updates then retry
        }
      //  }
    }
    me void: copyIdentity(our AItem: aItem) <- {
        // NOTE (search/adj1 investigation, 2026-04):
        // Copying identity here replaces the LHS infon pointer. If the old LHS had pending
        // wrkList constraints, those constraints may no longer participate unless explicitly
        // carried over elsewhere in the flow.
        our infonView: RHS <- aItem!.RHS!.pItem
        our WordUse:type     <- aItem!.LHS_item!.pItem!.type
        our infonView: listSpec  <- aItem!.LHS_item!.pItem!.value!.listSpec
        me uint64: lhsItmMode <- aItem!.LHS_item!.pItem!.itmMode

        if(mergeOpenListShapeIntoConcreteList(aItem, RHS, lhsItmMode)){return()}

        if(isSourceBackedPOV(aItem!.LHS_item)){
            aItem!.RHS!.pItem!.copyAsTypeTo(aItem!.LHS_item!.pItem, false, true)
            if(lhsItmMode!=mNone){aItem!.LHS_item!.pItem!.itmMode <- lhsItmMode}
            if(!aItem!.RHS!.pItem!.isTentative){aItem!.LHS_item!.pItem!.isTentative <- false}
        }else{
            aItem!.LHS_item!.pItem <- aItem!.RHS!.pItem
            if(lhsItmMode!=mNone){aItem!.LHS_item!.pItem!.itmMode <- lhsItmMode}
        }

        preserveLHSSlotMetadata(aItem, type, listSpec, RHS)
        //print("\nCOW: ",toString(aItem))
        // ERROR??? Copy workList
    }
    me bool: isOpenListShape(our infonView: item) <- {
        return(item!=NULL and item!.value!.overlayType==LST and item!.value!.evalMode==emLiteral and item!.value!.items.isEmpty() and item!.value!.tailUnfinished and item!.value!.listSpec!=NULL)
    }
    me bool: hasConcreteLiteralListItems(our infonView: item) <- {
        return(item!=NULL and item!.value!.overlayType==LST and item!.value!.evalMode==emLiteral and !item!.value!.items.isEmpty())
    }
    me bool: hasConcreteListSpec(our infonView: item) <- {
        return(hasConcreteLiteralListItems(item) and item!.value!.listSpec!=NULL)
    }
    me bool: isSourceBackedPOV(our POV: pov) <- {
        return(pov!=NULL and pov!.accessMode==aRefTo and pov!.outerPOV!=NULL and pov!.outerPOV!.pItem===pov!.pItem)
    }
    me bool: mergeOpenListShapeIntoConcreteList(our AItem: aItem, our infonView: RHS, me uint64: lhsItmMode) <- {
        if(!isOpenListShape(RHS) or !hasConcreteLiteralListItems(aItem!.LHS_item!.pItem)){return(false)}
        if(aItem!.LHS_item!.pItem!.type==NULL and RHS!.type!=NULL){aItem!.LHS_item!.pItem!.type <- RHS!.type}
        if(aItem!.LHS_item!.pItem!.value!.listSpec==NULL and RHS!.value!.listSpec!=NULL){aItem!.LHS_item!.pItem!.value!.listSpec <- RHS!.value!.listSpec}
        if(aItem!.LHS_item!.pItem!.orderMode==uUnknown and RHS!.orderMode!=uUnknown){aItem!.LHS_item!.pItem!.orderMode <- RHS!.orderMode}
        if(lhsItmMode!=mNone){aItem!.LHS_item!.pItem!.itmMode <- lhsItmMode}
        return(true)
    }
    me void: preserveLHSSlotMetadata(our AItem: aItem, our WordUse: oldType, our infonView: oldListSpec, our infonView: RHS) <- {
        if(oldType!=NULL){aItem!.LHS_item!.pItem!.type <- oldType}
        // A selector's listSpec is only a request shape. If the RHS is already a
        // concrete typed list, preserve the RHS listSpec so later traversal sees
        // the real source representation.
        if(oldListSpec!=NULL and !hasConcreteListSpec(RHS)){aItem!.LHS_item!.pItem!.value!.listSpec <- oldListSpec}
    }
    me void: carryPassiveScalarSource(our POV: LHSPOV, our POV: RHSPOV) <- {
        if(LHSPOV==NULL or RHSPOV==NULL or RHSPOV!.pItem==NULL){return()}
        if(RHSPOV!.pItem!.value!.overlayType==LST){return()}
        if(RHSPOV!.outerPOV!=NULL and RHSPOV!.outerPOV!.pItem===RHSPOV!.pItem){LHSPOV!.sourcePOV <- RHSPOV!.outerPOV}
        else{LHSPOV!.sourcePOV <- RHSPOV}
    }
    our infonView: selectReturnedInfonViewFromPOV(our AItem: aItem, our POV: selectedPOV) <- {
        if(selectedPOV==NULL){return(NULL)}
        our infonView: selected <- selectedPOV!.pItem
        if(selectedPOV!.outerPOV!=NULL and selectedPOV!.outerPOV!.pItem===selectedPOV!.pItem){
            aItem!.LHS_item!.outerPOV <- selectedPOV!.outerPOV
            aItem!.LHS_item!.accessMode <- aRefTo
        }else if(selectedPOV!.sourcePOV!=NULL and selectedPOV!.sourcePOV!.pItem===selectedPOV!.pItem){
            aItem!.LHS_item!.outerPOV <- selectedPOV!.sourcePOV
            aItem!.LHS_item!.accessMode <- aRefTo
        }
        return(selected)
    }

    // PROPAGATE & PROPAGATE UTILITY FUNCTIONS
    our POV: findNextLHS(our POV: LHSPov, our infItr: ii, me int64: skipDots, their int64: lvlsUpOnLeft, me bool: itrBeginning, me bool: LHSIsLST, me bool: RHSIsLST, me bool: unknownAsList, their int:waitState) <- {
        our POV: LHSPovNxt
        if((!LHSIsLST and !unknownAsList) and RHSIsLST){
            LHSPovNxt <- LHSPov
        }else{
            LHSPovNxt <- LHSPov!.getNextTight(ii, skipDots, lvlsUpOnLeft, false, itrBeginning, waitState, agent)
        }
        if(LHSPovNxt == NULL){
            //:l/PAI::logSeg(" LNxt_NULL")
        }else{
//            //:l/PAI::logSeg(" nxtL")
        }
        return(LHSPovNxt)
    }
    our POV: findNextRHS(our POV: RHSPov, our infItr: ii, me int64: skipDots, their int64: lvlsUpOnRight, me bool: itrBeginning, me bool: LHSIsLST, me bool: RHSIsLST, their int:waitState) <- {
        our POV: RHSPovNxt
        if(LHSIsLST and !RHSIsLST and itrBeginning){
            Allocate(RHSPovNxt)
            RHSPovNxt! <- RHSPov!
            if(RHSPovNxt!.pedigree.source==0){RHSPovNxt!.pedigree.source <- 456}
            RHSPovNxt!.looseInhtd <- true
        }else{
            RHSPovNxt <- RHSPov!.getNextTight(ii, skipDots, lvlsUpOnRight, false, itrBeginning, waitState, agent)
//  if(RHSPovNxt!=NULL and lvlsUpOnRight==0){RHSPovNxt.pItem!.asRHSInternalIdent <- RHSPov!.pItem!.asRHSInternalIdent}
        }
        if(RHSPovNxt==NULL){
            //:l/PAI::logSeg(" RNxt_NULL")
        }else{
//            //:l/PAI::logSeg(" nxtR")
        }
        return(RHSPovNxt)
    }

    our AItem: propagate(their Agenda: agenda, our AItem: aItem, our POV: LHSPov, our POV: RHSPov, our POV: remainder, me bool: looseSize, bool: dontEnque, their int:waitState) <- {
        // Log LHS==RHS
        me string: idnt <- indentStr(aItem!.indentLvl)
        me string: logStr <- idnt+"    PROPAGATE:"+shortedStr(toString(LHSPov!.pItem), 400)
        if(RHSPov!=NULL){
            if(RHSPov!.looseSize()){logStr <+- " =="}else{logStr <+- " ="}
            if(RHSPov!.looseTop){logStr <+- ":"}
            logStr <+- " " + shortedStr(toString(RHSPov!.pItem),400)
        }else{
            if(remainder!=NULL){logStr <+- " REM:"+shortedStr(toString(remainder!.pItem),400)}
            else{logStr <+- " (No_RHS)"}
        }
        //log(logStr)
        //:l/PAI::logSegIn(" PROP")
        // Gather information
        me bool: RhsAttached<- true
        me bool: RHSExists  <- RHSPov != NULL
        me bool: RorRExists <- RHSExists or remainder!=NULL
        me bool: LHSIsLST   <- (LHSPov!.pItem!.value!.overlayType==LST and LHSPov!.pItem!.value!.evalMode!=emConcat)
        me bool: RHSIsLST   <- (RHSExists and RHSPov!.pItem!.value!.overlayType==LST and RHSPov!.pItem!.value!.evalMode!=emConcat)
        me bool: identIsInternal <- RHSExists and (RHSPov!.pItem!.asRHSInternalIdent or (RHSPov!.pParent!=NULL and RHSPov!.pParent!.pItem!.asRHSInternalIdent))
        me bool: LHSitrBeginning <- aItem!.LHSItr!=NULL and LHSPov===aItem!.LHSItr!.topPOV
        me bool: RHSitrBeginning <- aItem!.RHSItr!=NULL and RHSPov===aItem!.RHSItr!.topPOV
        me bool: LHSIsFromALT
        our POV: adjLhsPOV  <- LHSPov
        our POV: adjRhsPOV  <- RHSPov
        while(adjLhsPOV!.outerPOV != NULL and !LHSitrBeginning){LHSIsFromALT <- adjLhsPOV!.isFromALT; adjLhsPOV <- adjLhsPOV!.outerPOV}
        while(RHSExists and adjRhsPOV!.outerPOV != NULL and !RHSitrBeginning){adjRhsPOV <- adjRhsPOV!.outerPOV}
        our POV: LHSPovNext
        our POV: RHSPovNext
        me int64: lvlsUpOnLeft
        me int64: lvlsUpOnRight
        if(!RHSExists and !adjLhsPOV!.pItem!.hasInnrOutr){
            if(adjLhsPOV!.pItem!.value!.items.isEmpty()){LHSitrBeginning <- false}
        }
        our AItem: aParent <- aItem
        if(!LHSitrBeginning){
            if(aItem!.ruleSet==rsInfon){aParent <- aItem!.parent}
            else{aParent <- aItem!.parent!.parent}
        }
        while(aParent!=NULL and aParent!.ruleSet==rsIntersect){aParent <- aParent!.parent!.parent}

        // Fetch next RHS: CHECK: aParent
        if(remainder!=NULL){RHSPovNext <- remainder}
        else if(RHSExists and aParent != NULL and aParent!.RHSItr != NULL){
            me int64: skipDotsR <- 0; if(dontEnque){skipDotsR<-INT64_MAX}
            RHSPovNext <- findNextRHS(adjRhsPOV, aParent!.RHSItr, skipDotsR, lvlsUpOnRight, RHSitrBeginning, LHSIsLST, RHSIsLST, waitState)
            if(waitState!=NULL and waitState! == 1){
                //log("SKIPPING_FETCH_RHS:"+aItem!.stringify())
                return(NULL)
            }
            if(RHSPovNext==NULL and adjRhsPOV!.pItem!.intersectPos != ipNoIntersect and adjRhsPOV!.next==NULL){
                RhsAttached <- false // RHS is an unattached intersect
            }
        }
        if(RHSExists and aParent!=NULL and aParent!.LHS_item!.pItem!.value!.sizeMode!=fromGiven and LHSPov!.pItem!.isTentative and !LHSPov!.applyAsNot(RHSPov) and !RHSPov!.pItem!.isTentative and !identIsInternal and RhsAttached){
            LHSPov!.pItem!.isTentative <- false
            //:l/PAI::logSeg(" resetTent:D")
        }

        // Fetch next LHS
        if(aParent == NULL){LHSPovNext <- NULL}  // At very top infon or propagating a lone RHS or intersect.
        else{
            me int64: skipDotsL <- 0;   if(RHSPovNext == NULL){ skipDotsL <- lvlsUpOnRight}    if(skipDotsL==0 and (dontEnque or !RorRExists)){ skipDotsL<-INT64_MAX}
            LHSPovNext <- findNextLHS(adjLhsPOV, aParent!.LHSItr, skipDotsL, lvlsUpOnLeft, LHSitrBeginning, LHSIsLST, RHSIsLST, false, waitState)
            if(waitState!=NULL and waitState! == 1){
                //log("SKIPPING_FETCH_LHS:"+aItem!.stringify())
                return(NULL)
            }
            if(lvlsUpOnLeft>0 and LHSPovNext!=NULL and LHSPovNext!.applyAsNot(RHSPovNext)){ // Eg Coming out of an LHS like: !char:{...}
                if(aParent!.mergeStatus==msUnknown){ // If it's msUnknown no 'mismatch' has been found so it's really a reject.
                    aParent!.mergeStatus<-msReject
                    LHSPovNext!.rejected <- true
                    dontEnque  <- true
                }
            }
        }

        if(LHSPovNext!=NULL and RHSPovNext!=NULL){
            our OrderedSpanTraversalWindow: spanWindow <- tryBuildOrderedSpanTraversalWindow(LHSPovNext, RHSPovNext)
            if(spanWindow!=NULL and spanWindow!.valid){
                LHSPovNext <- spanWindow!.lhsPOV
                RHSPovNext <- spanWindow!.rhsPOV
            }
        }

        if(LHSPovNext!=NULL and RHSPovNext!=NULL){
            if(!LHSPovNext!.isSparseOrderedSpan() and RHSPovNext!.isSparseOrderedSpan()){
                our POV: exposedRHS <- exposeSparseOrderedSpanHeadForTraversal(RHSPovNext)
                if(exposedRHS!=NULL){RHSPovNext <- exposedRHS}
            }
            if(LHSPovNext!=NULL and RHSPovNext!=NULL and LHSPovNext!.isSparseOrderedSpan() and !RHSPovNext!.isSparseOrderedSpan()){
                our POV: exposedLHS <- exposeSparseOrderedSpanHeadForTraversal(LHSPovNext)
                if(exposedLHS!=NULL){LHSPovNext <- exposedLHS}
            }
        }

        if(LHSPovNext!=NULL and RHSPovNext!=NULL){
            our OrderedSpanTraversalWindow: spanWindow <- tryBuildOrderedSpanTraversalWindow(LHSPovNext, RHSPovNext)
            if(spanWindow!=NULL and spanWindow!.valid){
                LHSPovNext <- spanWindow!.lhsPOV
                RHSPovNext <- spanWindow!.rhsPOV
            }
        }

        if(aParent!=NULL and aParent!.LHS_item!.pItem!.intersectMarkedRetPOV!=NULL){
            // getFirst/NextTight can step through a marked transparent &{...} and return
            // one of its inner POVs. If that inner LHS POV matches here, use the matched
            // RHS POV as the source-backed marked return so writes target the source list.
            our POV: markedMatch <- NULL
            our POV: markedPOV <- aParent!.LHS_item!.pItem!.intersectMarkedRetPOV
            me bool: markedReturnAlreadyMapped <- false
            if(markedPOV!=NULL and markedPOV!.pParent!=NULL){
                if(!markedPOV!.pParent!.pItem!.isInnr and (aParent!.LHS_item!.pItem!.innr==NULL or !(markedPOV!.pParent!.pItem===aParent!.LHS_item!.pItem!.innr))){
                    markedReturnAlreadyMapped <- true
                }
            }
            if(!markedReturnAlreadyMapped){
                if(LHSPov!=NULL and RHSExists and RHSPov!.pedigree.source==povSrcSparseExposedHead and markedPOV===LHSPov){markedMatch <- RHSPov}
                if(LHSPovNext!=NULL and RHSPovNext!=NULL and RHSPovNext!.pedigree.source==povSrcSparseExposedHead and markedPOV===LHSPovNext){markedMatch <- RHSPovNext}
                if(LHSPov!=NULL and RHSExists and RHSPov!.pedigree.source==povSrcSparseExposedHead and markedPOV!.pItem===LHSPov!.pItem){markedMatch <- RHSPov}
                if(LHSPovNext!=NULL and RHSPovNext!=NULL and RHSPovNext!.pedigree.source==povSrcSparseExposedHead and markedPOV!.pItem===LHSPovNext!.pItem){markedMatch <- RHSPovNext}
                if(markedMatch==NULL and LHSPovNext!=NULL and RHSPovNext!=NULL and RHSPovNext!.pedigree.source==povSrcSparseExposedHead){
                    if(markedPOV!=NULL and markedPOV!.pItem!=NULL and markedPOV!.pItem!.type!=NULL and RHSPovNext!.pItem!=NULL and RHSPovNext!.pItem!.type!=NULL){
                        if(markedPOV!.pItem!.isCompatibleWith(RHSPovNext!.pItem, false)==tvTrue){markedMatch <- RHSPovNext}
                    }
                }
                if(LHSPov!.markedOuterPOV!=NULL and RHSExists){markedMatch <- RHSPov}
                if(LHSPovNext!=NULL and LHSPovNext!.markedOuterPOV!=NULL and RHSPovNext!=NULL){markedMatch <- RHSPovNext}
            }
            if(markedMatch!=NULL){
                aParent!.LHS_item!.pItem!.intersectMarkedRetPOV <- markedMatch
                if(markedMatch!.pItem!.isTentative){
                    markedMatch!.addNewSubDots <- true
                    if(markedMatch!.pParent!=NULL){markedMatch!.pParent!.keepDots <- true}
                }
            }
        }

//log("RHSPovNext:"+RHSPovNext.mySymbol()+":"+RHSPovNext.stringify())
//log("LHSPovNext:"+LHSPovNext.mySymbol()+":"+LHSPovNext.stringify())

        // Find the aParent for the next LHS item.
        our AItem: nxtsParent <- aParent
        withEach aitm in range 0 .. lvlsUpOnLeft{
            if(nxtsParent==NULL or nxtsParent!.parent==NULL){break()}
            nxtsParent <- nxtsParent!.parent!.parent
            if(nxtsParent!=NULL and (nxtsParent!.parent==NULL or nxtsParent!.parent!.parent==NULL)){break()}
            if(nxtsParent != NULL and nxtsParent!.ruleSet==rsIntersect and nxtsParent!.parent != NULL and nxtsParent!.parent!.parent != NULL){aitm <-- 1}
        }

        me bool: candidateForLast <- false
        if(!dontEnque){
            // Set povParent's CandidateForLastItem flag and povParent!.keepDots.
            {  // REfs after wait(): LHSPovNext==NULL, LHSPovNext!.tentFromDots, lvlsUpOnLeft, RHSPovNext==NULL, RhsAttached, lvlsUpOnRight; SETs: candidateForLast, povParent!.keepDots
                me bool: isLooseSize  <- aParent!=NULL and aParent!.RHS!=NULL and aParent!.RHS!.looseSize()
                me bool: LHSisFinished <- LHSPovNext == NULL or lvlsUpOnLeft>0 or LHSPovNext!.tentFromDots
                me bool: RHSisFinished <- (RHSPovNext == NULL and RhsAttached) or lvlsUpOnRight>0
                their POV: povParent; if(LHSitrBeginning){povParent <- adjLhsPOV} else {povParent <- adjLhsPOV!.pParent}
                if((RorRExists and ((LHSisFinished and RHSisFinished) or (isLooseSize and (povParent!=NULL and povParent!.pItem!.infSize!.evalMode==emUnknown) )))
                    or (lvlsUpOnLeft>0 and LHSPov!.outerPOV==NULL and (povParent!=NULL and !povParent!.pItem!.value!.tailUnfinished))
                  ){
                    if(LHSitrBeginning){ //log(idnt+"   candidatesForLastItem:" + adjLhsPOV.stringify() + "   EndsOnA:"+LHSPovNext.stringify())
                        if(LHSPovNext!=NULL){
                            povParent!.addCandidateForLastItem(LHSPovNext)
                            candidateForLast <- true
                        }
                    }else{
                        if(LHSPov!.pItem!.intersectPos == ipNoIntersect and povParent!=NULL){
                            povParent!.addCandidateForLastItem(LHSPov)
                            candidateForLast <- true
                        }//else {log("NO_candidatesForLastItem due to [...] or atTop")}
                    }
                }
                if(!RorRExists and povParent!=NULL){povParent!.keepDots <- true}
            }
            if(LHSPovNext == NULL){
                //:l/PAI::logSegOut("NO_NXTa")
                return(NULL)
            }
            //ENQUEUE FOR PROCESSING
            ///me int: RHSsAvailable <- 0; our POV: RHSAltCnt <- RHSPovNext; while(RHSAltCnt){RHSsAvailable <+- 1; RHSAltCnt <- RHSAltCnt.altPOV}; if(LHSIsFromALT){RHSsAvailable <+- 1} // This may be needed later
            me bool: LHSHasAlt <- (LHSPovNext != NULL and LHSPovNext!.altPOV != NULL)
            me bool: RHSHasAlt <- (RHSPovNext != NULL and RHSPovNext!.altPOV != NULL)
            me int: lCount <- 0
            our POV: LHSAlt <- LHSPovNext
            while(LHSAlt!=NULL){
                /// me int: numRHSs <- RHSsAvailable; if(RHSHasAlt and LHSAlt!.pItem!.isTentative){numRHSs <-- 1} // numRHSs can be used as an alternate way to do this, and may be needed later.
                our POV: RHSAlt <- RHSPovNext
                me bool: predPushed <- false
                while(RHSAlt!=NULL){
                    if(LHSAlt!.pItem!.isTentative and RHSAlt!.pItem!.isTentative){  // ?=?
                        //:l/PAI::logSeg(" ?=?")
                        LHSAlt!.addNewSubDots <- true
                        LHSAlt!.pParent!.keepDots <- true
                        //log(idnt+"    ENQUEq:"+  LHSAlt.stringify() + " === " + RHSAlt.stringify())
                    } else {
                        if((lCount>0 and (LHSHasAlt or RHSHasAlt)) or LHSIsFromALT){    /// if(numRHSs>1 or lCount>0){
                                if(nxtsParent!.RHS!=NULL){
                                    RHSAlt!.looseInhtd <- nxtsParent!.RHS!.looseInhtd or nxtsParent!.RHS!.looseMode
                                    RHSAlt!.looseTop   <- false
                                }
         //           log("LHSIterator:"+nxtsParent!.LHSItr!.mySymbol()+":"+toString(nxtsParent!.LHSItr!.lineAltID)+"   QX_aParent:"+nxtsParent.mySymbol()+":"+nxtsParent.stringify())
                                //logSeg(" EnqX")
                                LHSAlt!.pItem!.pushAltIntoLineAlt(LHSPov, nxtsParent!.LHSItr!.lineAltID, RHSAlt!.pItem, RHSAlt, LHSIsFromALT)
         //                       log(idnt+"    ENQUEx:"+LHSAlt.mySymbol()+":" + LHSAlt.stringify() + " <== " + RHSAlt.stringify()+"  PREDx:"+LHSPov.mySymbol()+":"+LHSPov.stringify())
                        } else {
                            if(!predPushed){
                                if(!(LHSAlt===LHSPov)){ // push pred, but not to self
                                    LHSAlt!.pushPredecessor(LHSPov)
                                    predPushed <- true
                                }
                            }
                            if(aParent!.RHS!=NULL){
                                RHSAlt!.looseInhtd <- aParent!.RHS!.looseInhtd or aParent!.RHS!.looseMode
                                RHSAlt!.looseTop   <- false
                            }
                            //logSeg(" EnqY")
                            carryPassiveScalarSource(LHSAlt, RHSAlt)
                            LHSAlt!.pItem!.addPOVToWrkList(RHSAlt)
         //                   log(idnt+"    ENQUEy:" + LHSAlt.stringify() + " === " + RHSAlt.stringify())
                        }
                    }
                    RHSAlt <- RHSAlt!.altPOV
                }
                lCount <+- 1
                LHSAlt <- LHSAlt!.altPOV
            }
        } else {if(LHSPovNext == NULL){
            //:l/PAI::logSegOut("NO_NXTb")
            return(NULL)}
        }
        // Schedule Process Infon Via Agenda
        our AItem: PIVA
        if(RhsAttached){
            if(!aParent!.LHS_item!.pItem!.wrkList.isEmpty()){
                return(NULL)
            }
            PIVA <- processInfonViewViaAgenda(agenda, LHSPovNext, NULL, nxtsParent, aItem!.priority+1, srcPropagate)
            if(PIVA!=NULL){
                PIVA!.candidateForLast <- candidateForLast
                PIVA!.debugArg <- aParent
                //:l/PAI::logSeg(" PropPIVA:"+PIVA!.mySymbol())
                addDebugEvent("RegisterPIVA to propagate "+aItem!.stringify()+"\n    TO:"+LHSPovNext!.pItem!.mySymbol()+":"+toString(LHSPovNext!.pItem)+"\n", LHSPovNext!.pItem)
            }
        }
        // Clean and return
        if(!candidateForLast){LHSPovNext!.altPOV <- NULL}
        if(RHSPovNext!=NULL){RHSPovNext!.altPOV <- NULL}
        //:l/PAI::logSegOut("");
        return(PIVA)
    }
    void: callPropagate(their Agenda: agenda, our AItem: aItem, our POV: LHSPov, our POV: RHSPov, our POV: remainder, me bool: looseSize, bool: dontEnque, their int:waitState) <- {
        our AItem: nextAItem <- propagate(agenda, aItem, LHSPov, RHSPov, remainder, looseSize, dontEnque, waitState)
        if(aItem!.pendingTasks==0){fulfillSubscriptions(agenda, aItem)}
        if(nextAItem!=NULL){agenda!.addAItemToAgenda(nextAItem)}   // callPropagate
    }

    bool: addQueuedAItemsToAgenda(their Agenda: agenda) <- {
        // Propagate queued AItems. Return true if a wait occurred.
        while(!agenda!.propagationsTodo.isEmpty()){
            our PropagateRecord: propRec <- agenda!.propagationsTodo.last();
            me int:waitState <- 0
            callPropagate(agenda, propRec!.aItem, propRec!.LHSPov, propRec!.RHSPov, propRec!.remainder, propRec!.looseSize, propRec!.dontEnque, NULL)
            if(waitState==1){// Stop processing if a wait is needed.
            log("PAI_PROPAGATE_WAITING")
                return(true)
            } else {
                agenda!.propagationsTodo.popLast()
                agenda!.totalPropagationsProcessed <+- 1
            }
        }
        return(false)
    }

    void: propagateProxy(their Agenda: agenda, our AItem: aItem, our POV: LHSPov, our POV: RHSPov, our POV: remainder, me bool: looseSize, bool: dontEnque) <- {
        // ORIGIN-BASED GATE: when a propagated merge is about to continue deeper into
        // a replyable child, wake the subscriber early but keep the dependency edge
        // alive so the later real fulfill still owns pendingTasks bookkeeping.
        our infonView: subProxy <- aItem!.LHS_item!.pItem
        me bool: doReplyRequested <- checkIfReplyRequested(aItem!.LHS_item)
        me bool: parentFromPropagate <- (aItem!.parent != NULL and aItem!.parent!.pedigree.source == srcPropagate)
        me bool: subFromPropagate    <- (!aItem!.subscribers.isEmpty() and aItem!.subscribers.first()!.pedigree.source == srcPropagate)
        if(parentFromPropagate and subFromPropagate and doReplyRequested){
            wakeSubscriptions(agenda, aItem)
            our PropagateRecord:: propRec{aItem, LHSPov, RHSPov, remainder, looseSize, dontEnque}
            agenda!.propagationsTodo.prepend(propRec)
            agenda!.totalPropagationsQueued <+- 1
        } else {
            callPropagate(agenda, aItem, LHSPov, RHSPov, remainder, looseSize, dontEnque, NULL)
        }
    }

    me bool: processUnorderedInfonViews(their Agenda: agenda, our AItem: aItem, their bool: contnue) <- {
        // Handle Unordered infons
        our infonView: LHS_item <- aItem!.LHS_item!.pItem
        me OrderMode: LHSOrderMode <- LHS_item!.getOrderMode(agent)
        me OrderMode: RHSOrderMode <- uOrdered
        //log("LHSOrderMode: "+OrderModeStrings[LHSOrderMode]+" RHSOrderMode:"+OrderModeStrings[RHSOrderMode])
        if(aItem!.RHS!=NULL){RHSOrderMode <- aItem!.RHS!.pItem!.getOrderMode(agent)}
        if(aItem!.RHS!=NULL and(LHSOrderMode==uUnordered or RHSOrderMode==uUnordered)){
            if(LHSOrderMode==uUnordered and RHSOrderMode==uUnordered){
                me int: count <- 0
                our POV: RHS_pov <- aItem!.RHS!.pItem!.value!.items.head
                me int64: crntPriority <- aItem!.priority
                me int: priorityIdx <- 0
                while(RHS_pov != NULL){
                    our infonView: RHS_item <- RHS_pov!.pItem
                    me string: fieldName <- ""
                    fleshOutWord(agent, RHS_item)
                    if(RHS_item!.type!=NULL){
                        fieldName <- RHS_item!.type!.typeID()
                        our POV: LHS_Pov <- LHS_item!.fetchCompatibleField(agent, RHS_item)
                        if(LHS_Pov!=NULL){
                            // This 'if' is an optimization. Something similar can be done for "ordered" infons.
                            // NOTE (search/adj1 investigation, 2026-04):
                            // If this optimization skips merge work for a same-type "type example",
                            // verify that no concrete constraints are being skipped with it.
                            if(!(LHS_Pov!.pItem!.type!=NULL and RHS_item!.type!=NULL and RHS_item!.isTypeExample and LHS_Pov!.pItem!.infonViewHasType(RHS_item!.type!.typeID()))){
                                our POV: pov <- LHS_Pov!.pItem!.addInfonViewToWrkList(RHS_item, true, 417)
                                RHS_item!.streamState <- notParsing
                                if(pov!=NULL and LHS_Pov!.hasPropagated){
                                    our AItem: PIVA <- processInfonViewViaAgenda(agenda, LHS_Pov, NULL, aItem, crntPriority+priorityIdx, srcUnordd)
                                    if(PIVA!=NULL){
                                        //:l/PAI::logSeg(" UNORD_PIVA:"+PIVA!.mySymbol())
                                        agenda!.addAItemToAgenda(PIVA) // PIVA
                                        contnue! <- false
                                    }
                                    priorityIdx <- priorityIdx + 1
                                }
                              //  S <+- "    FOUND("+fieldName+"):"+LHS_Pov!.pItem!.type!.typeID()+" = "+toString(RHS_item)+"\n"
                            }//else{S <+- "    SKIPPING "+fieldName+"\n"}
                        } else {
                            if(RHS_item!.isFromDefn){ // Create the field. Optimize: Only do this when needed; COW
                                our infonView:: newField
                                newField! <- RHS_item!
                                newField!.copySource <- RHS_item
                                newField!.copySourceType <- cstDefinition
                                our POV: newPov <- LHS_item!.value!.items.append(newField, RHS_pov!.isSubItm, 444)
                                LHS_item!.infSize!.num <+- 1
                              //  S <+- "    Creating field: '"+fieldName+"' = "+toString(RHS_item)+"\n"
                            } else {
                                print("WARNING: compatable LHS infon Field not found: '",fieldName,"'\n")
                                log("// Proteus WARNING: compatable LHS infon Field not found. '"+fieldName+"'::"+toString(aItem))
                            }
                        }
                    } else {
                        //logFatalError("RHS infon Field not identified:'"+fieldName+"'::"+toString(aItem))
                        print("// Proteus WARNING: could not find:"+toString(RHS_item)+" in:\n    "+toString(LHS_item)+"\n")
                    } // TODO: Try . find
                    count <- count+1
                    RHS_pov <- RHS_pov!.next
                }
    // ** This 'regular' norming needs to happen at least once. After that, We can add "FOUND" items directly to the agenda. Should they be interweaved or done 1 at a time with subscriptions?
                aItem!.skipRHSUsageInPAI <- true
            } else {
                if(aItem!.RHS!=NULL and aItem!.RHS!.pItem!.intersectPos==ipNoIntersect){
                    me bool: LHSIsUnresolvedUnknown <- LHS_item!.viewMode==vmAny and (LHS_item!.value!.overlayType==tUnknown or LHS_item!.value!.overlayType==tUnset)
                    me bool: RHSIsUnresolvedUnknown <- aItem!.RHS!.pItem!.viewMode==vmAny and (aItem!.RHS!.pItem!.value!.overlayType==tUnknown or aItem!.RHS!.pItem!.value!.overlayType==tUnset)
                    if(LHSIsUnresolvedUnknown or RHSIsUnresolvedUnknown){
                        return(false)
                    }else{
                        aItem!.mergeStatus <- msReject
                        print("// Proteus NOTICE: Unordered/ordered missmatch: "+aItem!.stringify()+"\n")
                    }
                }
               // log("Unordered infon + ordered infon not yet handled. "+toString(aItem)+" LHSOrderMode:"+OrderModeStrings[LHSOrderMode]+" RHSOrderMode:"+OrderModeStrings[RHSOrderMode])
                return(false)
            }
            return(true)
        }
        return(false)
    }
    void: processAgendaItem(their Agenda: agenda, our AItem: aItem, me int: AlternativesNestLvl)<-{
        //if(aItem!.parent==NULL and aItem!.ruleSet==rsInfon and aItem!.LHS_item!.pParent==NULL){setInfonViewToMonitor(aItem!.LHS_item!.pItem)}
//if(aItem!.LHS_item!.pItem!.type!=NULL and aItem!.LHS_item!.pItem!.type!.normalType()=="solvedstate"){setInfonViewToMonitor(aItem!.LHS_item!.pItem)}
        //log("________________________________________")
        me bool: continueLoop    <- true
        me bool: doFulfillSubs <- false
        aItem!.taskEnqueued     <- false
        me string: idnt <- indentStr(aItem!.indentLvl)
        //:l/PAI::logSeg(indentedStr(">>"+shortedStr(toString(aItem),1000), aItem!.indentLvl, 0))
        //:l/PAI::logSegStartCol("",150)
        //:l/PAI::logSegIn(" PAI")
        if(!aItem!.wokenEarly){
            aItem!.pendingTasks <-- 1
            //:l/PAI/PT::logSeg(" --"+aItem!.mySymbol()+"_PT:e="+toString(aItem!.pendingTasks))
        }

        me string: endBracket<-""
        me int: count <- 0
        while(continueLoop){
            continueLoop <- false // True: keep doing these steps now. False: Stop and wait for other agenda items to complete and fulfill your subscription.
            me bool: act          // Can be used to alter the next action for continueLoop
            switch(aItem!.ruleSet){
                case rsInfon:{
                    if(aItem!.LHS_item!.pItem!.isNormed){
                        aItem!.phase1RecordHandler("infon:alreadyNormed", false)
                        doFulfillSubs <- true
                        //:l/PAI::logSegOut("NRMD")
                        //:l/PAI::logSeg("{}")
                        //:l/PAI::logFlush()
                        break()
                    }
                    if(!aItem!.initRulesApplied){endBracket<-"{"; aItem!.phase1RecordHandler("infon:initRules", false)}
                    initRules(aItem)

                    if(aItem!.LHS_item!.pItem!.itmMode==mIncludeStream){ // Normalize the specified SUB-stream
                        aItem!.phase1RecordHandler("infon:includeStream", false)
                        //log("SUB_NORMING:"+aItem!.LHS_item!.pItem!.mySymbol()+" = "+aItem!.LHS_item!.pItem!.includeSpec)
                        aItem!.LHS_item!.pItem!.itmMode <- mItem
                        if(!aItem!.LHS_item!.hasPropagated){
                            if(!aItem!.dontProcess){
                                //:l/PAI::logSeg(" MG_SubNorm")
                                //log("SUB_PROPING:"+aItem!.stringify())
                                our AItem: nextAItem <- propagate(agenda, aItem,  aItem!.LHS_item, NULL, NULL, false, false, NULL)
                                if(nextAItem!=NULL){agenda!.addAItemToAgenda(nextAItem)} // #include
                                aItem!.LHS_item!.hasPropagated <- true
                            }
                        }
aItem!.LHS_item!.pItem!.streamState <- parseStarted
                        agent!.CORE!.normalizeFromStreamSpec(aItem!.LHS_item, aItem!.LHS_item!.pItem!.includeSpec)
                        continueLoop <- false
                    }
                    else if(wordDefRules(aItem))          {aItem!.phase1RecordHandler("infon:wordDefRules", false); continueLoop <- true}
                    else if(rangeRules(aItem))            {aItem!.phase1RecordHandler("infon:rangeRules", false); continueLoop <- true}
                    else if(splitLangText(aItem))         {aItem!.phase1RecordHandler("infon:splitLangText", false); continueLoop <- true}
                    else if(derefWordRules(aItem))        {aItem!.phase1RecordHandler("infon:derefWordRules", false); continueLoop <- true}
                    else if(funcArgRules(aItem))          {aItem!.phase1RecordHandler("infon:funcArgRules", false); continueLoop <- true}
                    else if(func_altRules(agenda, aItem)) {aItem!.phase1RecordHandler("infon:funcAltRules", false); continueLoop <- false}
                    else if(lookUpCursorRules(aItem))     {aItem!.phase1RecordHandler("infon:lookUpCursorRules", false); partsRules(agenda,aItem,act); continueLoop <- act}
                    else if(normSize(agenda, aItem))      {aItem!.phase1RecordHandler("infon:normSize", false); continueLoop <- false}
                    else if(localNullableContinuationRules(agenda, aItem, act)) {aItem!.phase1RecordHandler("infon:nullableContinuation", false); continueLoop <- act}
                    else if(wrkLstRules(agenda, aItem))   {aItem!.phase1RecordHandler("infon:wrkLstRules", false); continueLoop <- false}
                    else if(partsRules(agenda,aItem,act)) {aItem!.phase1RecordHandler("infon:partsRules", false); continueLoop <- act}
                    else if(processConcat(aItem))         {aItem!.phase1RecordHandler("infon:processConcat", false); continueLoop <- true}
                    else{
                        aItem!.phase1RecordHandler("infon:completeOrWait", false)
                        me int: readyPendingTasks <- aItem!.pendingTasks - aItem!.heldPendingTasks
                        if(readyPendingTasks < 0){
                            log("WARNING!:"+aItem!.mySymbol()+"_PT="+toString(aItem!.pendingTasks)+" held="+toString(aItem!.heldPendingTasks)+":"+toString(aItem))
                        }
                        if(readyPendingTasks==0){
                            our infonView: CI <- aItem!.LHS_item!.pItem;
                            if(aItem!.heldPendingTasks>0){
                                aItem!.phase1RecordHandler("infon:heldPending", false)
                                if(CI!.doReply){
                                    CI!.doReply <- false
                                    log("DO_REPLY-PAI:"+CI!.mySymbol()+"  originID:"+toString(CI!.originID) + "  CI:"+shortedStr(toString(CI),100))
                                    if(CI!.originID>0){
                                        agent!.CORE!.submitProteusResult(CI!.originID, CI!.infCharPos, toString(CI))
                                    }
                                }
                                addQueuedAItemsToAgenda(agenda)
                                break()
                            }
                            cleanUpInfonView(aItem)
                            aItem!.phase1RecordHandler("infon:cleanUp", false)
                            if(CI!.cnvtToFunc){ //:l/PAI::logSeg(" ReFn")
                                aItem!.phase1RecordHandler("infon:reFunctionize", false)
                                //log("REFUNC:"+toString(CI))
                                reFunctionize(CI)
                                CI!.altRulesApplied <- false
                                continueLoop <- true
                                continue()
                            }
                            if(CI!.type!=NULL and CI!.type!.usePOS==posNoun and CI!.intersectPos==ipNoIntersect and aItem!.distanceToTop()<=2){ // Add this to context
                                agent!.context.addContextItem(aItem!.LHS_item!.dpItem())
                            }
                            CI!.wasProcessed <- true
                            if(CI!.doReply){
                                CI!.doReply <- false
                                log("DO_REPLY-PAI:"+CI!.mySymbol()+"  originID:"+toString(CI!.originID) + "  CI:"+shortedStr(toString(CI),100))
                                if(CI!.originID>0){
                                    agent!.CORE!.submitProteusResult(CI!.originID, CI!.infCharPos, toString(CI))
                                }
                            }

                            addQueuedAItemsToAgenda(agenda)

                            our AItem: aParent <- aItem!.parent
                            if(aParent != NULL){
                              //  print("\naParent pendingTask:", toString(aParent!.pendingTasks))
                                aParent!.pendingTasks <-- 1
                                if(aParent!.pendingTasks == 0){ //:l/PAI::logSeg(" ADP:"+aParent!.mySymbol())
                                    // Resuming an infon parent after child work is a new agenda pass,
                                    // but merge/intersect parents already encode their own step state.
                                    if(aParent!.ruleSet==rsInfon){aParent!.step <+- 1}
                                    aParent!.pendingTasks <+- 1
                                    agenda!.addAItemToAgenda(aParent)  // Restart parent task
                                } else {
                                    //:l/PAI/PT::logSeg(" --"+aParent!.mySymbol()+"_PT:f="+toString(aParent!.pendingTasks))
                                }
                            }else {
                                //:l/PAI::logSeg(" NoAParent")
                            }
                            doFulfillSubs <- true
                        } else {
                            //:l/PAI::logSeg(" TASKS>0:"+toString(aItem!.pendingTasks))
                        }
                    }
                    printDebInf("PAI:INF", aItem!.LHS_item!.pItem)
                    if(!continueLoop){if(aItem!.pendingTasks==0){endBracket<+-"}"} else if(endBracket==""){endBracket<-"}{"}}
                }
                case rsMerge:{
                    if(aItem!.step==0){
                        aItem!.mergeStatus <- msAccept
                        if(aItem!.RHS==NULL or aItem!.skipRHSUsageInPAI){
                            aItem!.phase1RecordHandler("merge:step0:singleSided", false)
                            //:l/PAI::logSeg(" MGxR")
                            //:l/PAI::endBracket<-"{"
                            //log("NO_RHS:"+ toString(aItem))
                            if(!aItem!.LHS_item!.pItem!.wasProcessed){
                                if(aItem!.LHS_item!.pItem!.value!.overlayType == LST){initListIterators(aItem)}
                            }
                            // BDL Uncomment to re-enable reply on single-sided merges
                            // log("PROP_XY:"+aItem!.stringify())
                            // our infonView: CI <- aItem!.LHS_item!.pItem;
                            // if(CI!.doReply){
                            //     log("   PROPx:"+aItem!.stringify())
                            // //    CI!.doReply <- false
                            //     log("DO_REPLY-PAI-b:"+CI!.mySymbol()+"  originID:"+toString(CI!.originID) + "  CI:"+shortedStr(toString(CI),100))
                            //     if(CI!.originID>0){
                            //         agent!.CORE!.submitProteusResult(CI!.originID, CI!.infCharPos, toString(CI))
                            //     }
                            // }
                            aItem!.step <- 2
                            propagateProxy(agenda, aItem, aItem!.LHS_item, NULL, NULL, false, false)
                            break()
                        } else {
                            if(aItem!.step ==0){// ###############   TODO: optimize so that skipping step 0 isn't needed #######
                                aItem!.phase1RecordHandler("merge:step0:inspectRHS", false)
                                our infonView: RHS <- aItem!.RHS!.pItem
                                fleshOutWord(agent, RHS)
                                if((RHS!.type==NULL or RHS!.itmMode==mWordDefn or RHS!.isFromDefn)
                                   and RHS!.cursorMode==cmNone and RHS!.value!.evalMode!=emConcat
                                   and !RHSNeedsNestedCursorNormalization(RHS)){
                                    //:l/PAI::endBracket<-"{"
                                    logSeg(":setStep1:a")
                                    aItem!.step <- 1;
                                }
                            }// ############### //TODO: optimize above so that skipping step 0 isn't needed ###################
                        }
                    }
                    if(aItem!.step==0){ //:l/PAI::logSeg(" MG0")
                        aItem!.phase1RecordHandler("merge:step0:normalizeRHS", false)
                        our AItem: PIVA <- processInfonViewViaAgenda(agenda, aItem!.RHS, aItem, NULL, aItem!.priority, srcMrg0)
                        if(PIVA!=NULL){ //:l/PAI::logSeg(" RHS_PIVA:"+PIVA!.mySymbol())
                            addDebugEvent("\nRegisterPIVA to norm RHS "+aItem!.RHS!.pItem!.mySymbol()+":"+toString(aItem!.RHS!.pItem)+"\n", aItem!.RHS!.pItem)
                            // Preserve the outer relative-cursor context when normalizing nested RHS.
                            if(aItem!.cursorAnchor!=NULL){PIVA!.cursorAnchor <- aItem!.cursorAnchor}
                            else{PIVA!.cursorAnchor <- aItem!.LHS_item}
                            agenda!.addAItemToAgenda(PIVA)
                        }
                        aItem!.step <- 1
                    }
                    else if(aItem!.step==1){
                        aItem!.phase1RecordHandler("merge:step1", false)
                        me bool: LHSWasTentative <- aItem!.LHS_item!.pItem!.isTentative
                        me bool: invertAcceptance <- aItem!.LHS_item!.applyAsNot(aItem!.RHS)
                        our AItem: mrgParent <- aItem!.parentListsMrgAItem()
                        me bool: parentListIsAsNot <- mrgParent!=NULL and mrgParent!.LHS_item!.applyAsNot(mrgParent!.RHS)
                        our POV: remainder
                        if(aItem!.RHS!.pItem!.intersectPos == ipNoIntersect){
                            me int: isCompatible
                            if(aItem!.LHS_item!.trueByDefinition){isCompatible <- true}
                            else{
                                isCompatible <- aItem!.LHS_item!.pItem!.isCompatibleWith(aItem!.RHS!.pItem, aItem!.RHS!.trueByDefinition)
                                if(isCompatible==tvFalse and aItem!.LHS_item!.isSparseOrderedSpan() and aItem!.RHS!.isSparseOrderedSpan()){
                                    me vocabularySpec: vSpec
                                    vSpec.init(agent!.getLocaleBaseName())
                                    if(sparseOrderedSpanMergeAlignable(aItem!.LHS_item, aItem!.RHS, vSpec)){isCompatible <- tvTrue}
                                }
                                if(isCompatible!=tvTrue and aItem!.LHS_item!.pItem!.type!=NULL and aItem!.RHS!.pItem!.value!.overlayType==LST and aItem!.RHS!.pItem!.value!.listSpec!=NULL and aItem!.RHS!.pItem!.value!.listSpec!.type!=NULL){
                                    me vocabularySpec: vSpec
                                    vSpec.init(agent!.getLocaleBaseName())
                                    our OrderedSpanConverter: spanConverter <- modelMngr.getOrderedSpanConverter(aItem!.LHS_item!.pItem!.type, aItem!.RHS!.pItem!.value!.listSpec!.type, vSpec)
                                    if(spanConverter!=NULL and spanConverter!.valid and spanConverter!.fromBaseCount>=spanConverter!.toBaseCount){isCompatible <- tvTrue}
                                }
                            }
                            if(!aItem!.looseSize){
                                if(isCompatible==tvFalse){ //log("REJECT.a:"+aItem!.LHS_item!.stringify());
                                    aItem!.mergeStatus<-msReject
                                }
                                else if(isCompatible==tvUnknown){
                                    if(aItem!.LHS_item!.pItem!.useMode==umQuestion){ //log("REJECT.b:"+aItem!.stringify());
                                        aItem!.mergeStatus<-msReject
                                    }
                                }
                            }
                        }
                        if(aItem!.mergeStatus!=msReject and aItem!.LHS_item!.pItem!.getOrderMode(agent)!=uUnordered){mergeSizeRules(aItem)}
                        if(aItem!.mergeStatus!=msReject){
                            if(aItem!.RHS!.forceID){ //log("FORCE_ID:"+aItem!.stringify());
                                aItem!.phase1RecordHandler("merge:forceIdentity", false)
                                aItem!.RHS!.pItem!.copyAsTypeTo(aItem!.LHS_item!.pItem, false, true)
                            }else{
                                me bool: contnue <- true
                                if(processUnorderedInfonViews(agenda, aItem, contnue)){
                                    aItem!.phase1RecordHandler("merge:unordered", false)
                                    if(!contnue){
                                        aItem!.step <- 2
                                        //:l/PAI::logSegOut("")
                                        //:l/PAI::logSeg("}")
                                        //:l/PAI::logFlush()
                                        return()
                                    }
                                    if(aItem!.LHS_item!.pItem!.value!.overlayType == LST){
                                        our POV: tmp <- aItem!.RHS
                                        aItem!.RHS <- NULL
                                        initListIterators(aItem)
                                        aItem!.RHS <- tmp
                                    }
                                }
                                else{
                                    if(aItem!.RHS!.pItem!.viewMode == vmAny){
                                        aItem!.phase1RecordHandler("merge:rhsAny", false)
                                        if(aItem!.RHS!.pItem!.type!=NULL and aItem!.LHS_item!.pItem!.type==NULL){
                                            log(indentStr(aItem!.indentLvl)+"        merge  |||r?|       copyType")
                                            aItem!.LHS_item!.pItem!.type <- aItem!.RHS!.pItem!.type}
                                            if(aItem!.LHS_item!.pItem!.value!.overlayType==LST){
                                                aItem!.RHS <- NULL
                                                initListIterators(aItem)
                                                aItem!.mergeStatus <- msUnknown
                                            }
                                    } else {
                                        remainder <- mergeRules(aItem)
                                    }
                                }
                            }
                        }
                        if(invertAcceptance){ //:l/PAI::logSeg(" INVRT")
                            if(aItem!.mergeStatus==msAccept){aItem!.mergeStatus<-msReject}
                            else if(aItem!.mergeStatus==msReject){aItem!.mergeStatus<-msAccept}
                        }
                        if(aItem!.mergeStatus == msReject){aItem!.LHS_item!.rejected <- true}
                        else{aItem!.LHS_item!.rejected <- false}
                        our POV: RHSSide; if(remainder==NULL){RHSSide <- aItem!.RHS}
                        if(aItem!.mergeStatus!=msPending){
                            if(aItem!.mergeStatus!=msReject){
                                //:l/PAI::logSeg(" MG1")
                                if(aItem!.mergeStatus==msAccept){
                                    //:l/PAI::logSeg(":ACC")
                                } else if(aItem!.mergeStatus==msReject){
                                    //:l/PAI::logSeg(":REJ")
                                }
                                // Optimization: propagate "already initialized" state to avoid extra inits.
                                if(aItem!.RHS!=NULL and aItem!.RHS!.pItem!.isTypeExample){
                                    me string: typeIDStr <- aItem!.RHS!.pItem!.type!.typeID()
                                    withEach LHSSpec in aItem!.LHS_item!.pItem!.addedTypes{
                                        if(LHSSpec!.typeID()==typeIDStr){
                                            LHSSpec!.typeInitialized <- true
                                            break();
                                        }
                                    }
                                }
                                if(!aItem!.looseSize and aItem!.RHS!=NULL and aItem!.RHS!.pItem!.generality==gConcrete){
                                    aItem!.LHS_item!.pItem!.generality <- gConcrete
                                    aItem!.LHS_item!.pItem!.proxy <- aItem!.RHS!.pItem
                                }
                                // propagate() clears accepted dot-created tentatives when it can
                                // look ahead. A terminal accepted merge has no later propagation.
                                if(aItem!.RHS!=NULL and LHSWasTentative and aItem!.LHS_item!.tentFromDots and aItem!.LHS_item!.pItem!.isTentative and aItem!.LHS_item!.pItem!.value!.sizeMode!=fromGiven and !aItem!.LHS_item!.applyAsNot(aItem!.RHS) and !aItem!.RHS!.pItem!.isTentative and !aItem!.RHS!.pItem!.asRHSInternalIdent and !(aItem!.RHS!.pParent!=NULL and aItem!.RHS!.pParent!.pItem!.asRHSInternalIdent)){
                                    aItem!.LHS_item!.pItem!.isTentative <- false
                                }
                                me bool: dontEnque <- false // parentListIsAsNot and mrgParent!.mergeStatus==msAccept //aItem!.mergeStatus==msReject and aItem!.parent!.candidateForLast
                                aItem!.step <- 2
                                propagateProxy(agenda, aItem, aItem!.LHS_item, RHSSide, remainder, aItem!.looseSize, dontEnque)
                            } else{ //:l/PAI::logSeg(" MG1:REJ")
                                if(parentListIsAsNot){ //:l/PAI::logSeg(" INV_ACPT")
                                    mrgParent!.mergeStatus<-msAccept
                                }
                                their POV: pParent <- aItem!.LHS_item!.pParent
                                me bool: parentInfonIsNullableList <- (pParent!=NULL and pParent!.pItem!.value!.items.size()==1 and pParent!.pItem!.value!.tailUnfinished)
                                if(aItem!.parent!.candidateForLast or parentInfonIsNullableList or parentListIsAsNot){
                                    me bool: dontEnque <- !parentListIsAsNot // aItem!.mergeStatus==msReject and (aItem!.parent!.candidateForLast or parentInfonIsNullableList)
                                    propagateProxy(agenda, aItem, aItem!.LHS_item, RHSSide, remainder, aItem!.looseSize, dontEnque)
                                } else {
                                    me bool: candidatesEmpty <- true
                                    if(pParent!=NULL and !pParent!.candidatesForLastItem.isEmpty()){
                                        candidatesEmpty <- false
                                    }
                                    if(!aItem!.looseSize and !aItem!.LHS_item!.pItem!.isTentative and !aItem!.RHS!.pItem!.isTentative and candidatesEmpty){
                                        //log("// Proteus NOTICE: LHS:"+aItem!.LHS_item!.stringify()+"   RHS:"+aItem!.RHS!.stringify()+"      AItem pedigree: "+aitemSrcIDStrings[aItem!.pedigree.source]+" LHS pedigree: "+toString(aItem!.LHS_item!.pedigree.source)+"  RHS pedigree: "+toString(aItem!.RHS!.pedigree.source))
                                        //log("     AITEM:"+aItem!.mySymbol()+" = "+shortedStr(aItem!.stringify(),200))
                                        agent!.CORE!.handleProteusError(aItem!.LHS_item!.pItem!.originID, "Proteus NOTICE - Candidates Empty:\n    LHS:"+shortedStr(aItem!.LHS_item!.stringify(),60)+"\n    RHS:"+shortedStr(aItem!.RHS!.stringify(),60)+"\n    AItem pedigree: "+aitemSrcIDStrings[aItem!.pedigree.source]+" LHS pedigree: "+toString(aItem!.LHS_item!.pedigree.source)+"  RHS pedigree: "+toString(aItem!.RHS!.pedigree.source))
                                    }
                                    if(aItem!.pendingTasks==0){doFulfillSubs <- true}
                                }
                            }
                        } else {log("mergeStatusPENDING:")}
                    } else if(aItem!.step==2){
                        aItem!.phase1RecordHandler("merge:step2", false)
                        if(aItem!.mergeStatus==msUnknown){
                            if(aItem!.LHS_item!.applyAsNot(aItem!.RHS)){aItem!.mergeStatus<-msReject}
                            else{aItem!.mergeStatus<-msAccept}
                        }
                        //:l/PAI::logSeg(" MG2")
                        if(aItem!.mergeStatus==msAccept){
                            //:l/PAI::logSeg(":ACC")
                        } else if(aItem!.mergeStatus==msReject){
                            //:l/PAI::logSeg(":REJ")
                        }
                        if(aItem!.LHS_item!.pItem!.value!.tailUnfinished and aItem!.LHS_item!.pItem!.infSize!.evalMode==emLiteral){
                            aItem!.LHS_item!.pItem!.countSize(true)
                        }
                        if(aItem!.skipRHSUsageInPAI or aItem!.LHS_item!.propagateInMrg2){
                            aItem!.LHSItr <- NULL        // Stop infinite loop
                            aItem!.RHSItr <- NULL        // Stop infinite loop
                            propagateProxy(agenda, aItem, aItem!.LHS_item, aItem!.RHS, NULL, false, false)
                        }
                        doFulfillSubs <- true
                        //:l/PAI::endBracket<-"{"
                    }

                    printDebInf("PAI:MRG", aItem!.LHS_item!.pItem)
                    if(aItem!.pendingTasks==0){endBracket<-"{}"}
                }
                case rsIntersect:{
                    aItem!.phase1RecordHandler("intersect:step"+toString(aItem!.step), false)
                    our infonView: CI   <- aItem!.LHS_item!.pItem
                    our infonView: innr <- CI!.innr
                    switch(aItem!.step){
                        case 0:{
                            //:l/PAI::endBracket<-"{"
                            if(CI!.hasInnrOutr){
                                our POV: newPOV  <- CI!.innr!.addInfonViewToWrkList(CI!.innr!.funcArgs, true, 24)
                                newPOV!.looseTop  <- true
                                CI!.hasInnrOutr   <- false
                                CI!.innr!.funcArgs <- NULL
                            }
                            if(CI!.intersectMarkedRetPOV!=NULL){
                                CI!.innr!.intersectMarkedRetPOV <- CI!.intersectMarkedRetPOV
                            }
                            if(CI!.isOrLike()){
                                aItem!.phase1RecordHandler("intersect:normalizeAlternatives", false)
                                //:l/PAI::logSeg(" IC0_OR:[")
                                // EXPERIMENT for the innr/oneOf/Aaron bug: always normalize the innr. Its members each normalize
                                // individually, getting aRefTo (identity) + umQuestion (filter) via the
                                // child-direction flags propagated through processInfonViewViaAgenda. No
                                // separate buildIntersectOrAlts pass; step 1 picks the survivor.
                                // But get the other tests to pass as the above makes many tests fail
                                if(!innr!.value!.tailUnfinished){
                                    our POV: innrPov <- innr!.value!.items.head
                                    while(innrPov != NULL){
                                        if(innrPov!.outerPOV==NULL){innrPov!.outerPOV <- aItem!.LHS_item}
                                        our AItem: PIVA <- processInfonViewViaAgenda(agenda, innrPov, NULL, aItem, aItem!.priority, srcItsALT)
                                        PIVA!.LHS_item!.pItem!.takeWrkListFrom(aItem!.LHS_item!.pItem, false)
                                        PIVA!.LHS_item!.accessMode    <- aRefTo
                                PIVA!.LHS_item!.pItem!.useMode <- umQuestion
                                //log("QUESTION-in-b:"+PIVA!.LHS_item!.pItem!.mySymbol()+" = "+toString(PIVA!.LHS_item!.pItem))
                                        //:l/PAI::logSeg(" IC0_orPIVA:"+PIVA!.mySymbol())
                                        addDebugEvent("RegisterPIVA to integrate OR intersect "+innrPov!.pItem!.mySymbol()+":"+toString(innrPov!.pItem), innrPov!.pItem)
                                        agenda!.addAItemToAgenda(PIVA)  // PIVA
                                        innrPov <- innrPov!.next
                                    }
                                    aItem!.LHS_item!.pItem!.wrkList.clear() //TODO: is this necessary?
                                }
                                //:l/PAI::logSeg("]")
                            } else {  // CI is FunctionLike
                                aItem!.phase1RecordHandler("intersect:normalizeFunction", false)
                                our POV:: srcPOV{25}; srcPOV!.pItem <- innr
                                CI!.retainPOV(srcPOV)
                                our AItem: PIVA <- processInfonViewViaAgenda(agenda, srcPOV, aItem, NULL, aItem!.priority, srcItsFunc)
                                if(PIVA!=NULL){
                                    //:l/PAI::logSeg(" IC0_funcPIVA:"+PIVA!.mySymbol())
                                    agenda!.addAItemToAgenda(PIVA) // PIVA
                                    //:l/PAI::logSeg(" IC0_funcPIVA:"+PIVA!.mySymbol())
                                    addDebugEvent("RegisterPIVA to integrate func intersect "+srcPOV!.pItem!.mySymbol()+":"+toString(srcPOV!.pItem), srcPOV!.pItem)
                                }
                            }
                            aItem!.step <- 1
                        }
                        case 1:{
                            //:l/PAI::logSeg(" IC1")
                            //:l/PAI::endBracket<-"}"
                            our infonView: newTop    <- NULL
                            if(CI!.isOrLike()){  // Eliminate if only 1 non - reject.
                                aItem!.phase1RecordHandler("intersect:selectAlternative", false)
                                //:l/PAI::logSeg(" IS_OR_LIKE:"+aItem!.mySymbol())
                                //TODO: Perhaps we can skip the following if there is exactly one candidateForLast
                                if(!innr!.value!.tailUnfinished){
                                    our POV: lastOK   <- NULL
                                    me int: numOK <- 0
                                    our POV: pov <- innr!.value!.items.head
                                    while(pov != NULL){
                                        // TODO: if(sizesNotCompatable()){markAsReject or notLast}
                                        me string: logPredString; if(!pov!.predecessors.isEmpty()){logPredString<-"  Pred:"+ pov!.predecessors[0]!.stringify()}
                                        // Is the next line really valid? This could be the correct item but just be unknown. However, tests fail without it.
                                        me bool: unresolvedAlt <- pov!.pItem!.type==NULL and pov!.pItem!.viewMode==vmAny and (pov!.pItem!.value!.overlayType==tUnknown or pov!.pItem!.value!.overlayType==tUnset)
                                        if(!pov!.rejected and !unresolvedAlt){
                                            //:l/PAI::log(idnt+"            ALT:"+ pov!.mySymbol()+":"+ shortedStr(pov!.stringify(),100) + shortedStr(logPredString,100))
                                            numOK <+- 1
                                            lastOK <- pov
                                        } else {
                                            //:l/PAI::log(idnt+"          x ALT:"+ pov!.mySymbol()+":"+ shortedStr(pov!.stringify(),100) + shortedStr(logPredString,100))
                                        }
                                        pov <- pov!.next
                                    }
                                    if(numOK==1){
                                        newTop <- lastOK!.pItem
                                        aItem!.parent!.dontProcess <- true
                                        aItem!.LHS_item!.forLastUseOutrPov <- true
                                        //log("NEWTOPING:"+aItem!.LHS_item!.mySymbol()+"   newTop:"+newTop.mySymbol())
                                        if(!(lastOK!.outerPOV != NULL and lastOK!.outerPOV===aItem!.LHS_item)){
                                            aItem!.LHS_item!.predecessors <- lastOK!.predecessors
                                        }
                                        if(newTop!.isTentative){
         /*BDL*/                                   newTop!.isTentative <- aItem!.LHS_item!.pItem!.isTentative// false
                                            if(lastOK!.predecessors.size()==1){
                                                our POV: pred <- lastOK!.predecessors[0]
                                                //log("-TryCloseTentative " + lastOK.stringify() + "  PREDc:"+pred!.stringify())
                                                validateItem(pred)
                                            }
                                        }
                                    }else if(numOK==0){
                                        //log("NO_ALTS") // outr/everyOther fails w/o this
                                        innr!.value!.items.clear()
                                        innr!.value!.sizeMode <- fromCount
                                        innr!.infSize!.num <- 0
                                        innr!.infSize!.evalMode <- emLiteral
                                        CI!.value!.undefined <- true
                                        CI!.partRef <- NULL
                                        CI!.parts.clear()
                                    }
                                } else {log("TODO: IS_OR_LIKE: tailUnfinished")}
                            } else {  // CI is FunctionLike
                                aItem!.phase1RecordHandler("intersect:selectFunctionResult", false)
                                //:l/PAI::logSeg(" FUNC")
                                switch(CI!.intersectPos){
                                    case ipGetLast   : {
                                        newTop <- selectReturnedInfonViewFromPOV(aItem, innr!.getLastPOV())
                                    }
                                    case ipGetFirst  : {newTop <- innr!.getFirstItem(aItem!.LHS_item!.isSubItm)}
                                    case ipGetMarked : {
                                        if(innr!.intersectMarkedRetPOV!=NULL and
                                                innr!.intersectMarkedRetPOV!.pItem!.isTentative and
                                                innr!.intersectMarkedRetPOV!.pParent!=NULL and
                                                !(innr!.intersectMarkedRetPOV!.pParent!.pItem===innr)){
                                            Allocate(newTop)
                                            newTop!.viewMode <- vmOverlay
                                            newTop!.infSize!.evalMode <- emUnknown
                                            newTop!.value!.evalMode <- emLiteral
                                            newTop!.value!.overlayType <- LST
                                            innr!.intersectMarkedRetPOV!.addNewSubDots <- true
                                            // The mark selects a slice position. Keep the list-view
                                            // shape, but tie its first slot back to the source POV.
                                            our POV: markedWrapperPOV <- newTop!.value!.items.append(innr!.intersectMarkedRetPOV!.pItem, innr!.intersectMarkedRetPOV!.isSubItm, 304)
                                            markedWrapperPOV!.outerPOV <- innr!.intersectMarkedRetPOV
                                            markedWrapperPOV!.accessMode <- aRefTo
                                            markedWrapperPOV!.tentFromDots <- innr!.intersectMarkedRetPOV!.tentFromDots
                                            newTop!.countSize(false)
                                        }else{
                                            // TODO: Is the next line a special case that should be generalized?
                                            //    Before we just had the 2nd line without the 'else'.
                                            if(innr!.intersectMarkedRetPOV!=NULL and innr!.intersectMarkedRetPOV!.pedigree.source==povSrcSparseExposedHead){newTop <- innr!.intersectMarkedRetPOV!.pItem}
                                            else if(CI!.intersectMarkedRetPOV!=NULL){newTop <- CI!.intersectMarkedRetPOV!.pItem}
                                        }
                                    }
                                }
                                if(newTop!=NULL){
                                    if(CI!.intersectPos==ipGetMarked){
                                        if(CI!.intersectMarkedRetPOV!=NULL and newTop===CI!.intersectMarkedRetPOV!.pItem){
                                            // A marked range object may still have selector-local
                                            // work queued on it; do not project that work outward.
                                            newTop!.wrkList.clear()
                                            CI!.wrkList.clear()
                                        }else{
                                            newTop!.takeWrkListFrom(CI, true)
                                        }
                                    }else{
                                        newTop!.takeWrkListFrom(CI, true)
                                    }
                                    //:l/PAI::logSeg(" GET_LAST")
                   // log("NEW_TOP_FUNC: RHS:"+ toString(aItem!.LHS_item!.pItem) + "  newTop:" + toString(newTop)+": "+newTop.mySymbol())
                                }else{CI!.value!.undefined <- true}
                            }
                            doFulfillSubs <- true
                            if(newTop!=NULL){
                                if(aItem!.LHS_item!.pItem!.itmMode!=mNone){newTop!.itmMode <- aItem!.LHS_item!.pItem!.itmMode}
                                newTop!.doReply       <- aItem!.LHS_item!.pItem!.doReply
                                newTop!.partRef       <- aItem!.LHS_item!.pItem!.partRef
                                newTop!.parts         <- aItem!.LHS_item!.pItem!.parts
        newTop!.originID      <- aItem!.LHS_item!.pItem!.originID // TODO: // WRONG! This changes the original, need to track this origin separately in POV or aItem
                                newTop!.infCharPos    <- aItem!.LHS_item!.pItem!.infCharPos
                                if(aItem!.LHS_item!.pItem!.value!.undefined){newTop!.value!.undefined <- true}
                                aItem!.LHS_item!.pItem <- newTop
                            }else{} // TODO: return Subscriptions
                            aItem!.step <- 2
                        }
                    }
                }
                case rsPure:{
                    aItem!.phase1RecordHandler("pure:noOp", false)
                }
            }
            count <+- 1
        }

        if(doFulfillSubs){fulfillSubscriptions(agenda, aItem)}
        //aItem!.LHS_item!.pItem!.isNormed <- true // Uncommenting this makes everything fail, but why? It should be there...
        //logSegStartCol("<<:DONE", col4)
        //:l/PAI::logSegOut("")
        //:l/PAI::logSeg(endBracket)
        //:l/PAI::logFlush()
    }
    void: processAgenda(their Agenda: agenda)<-{
        me AItemValidator: validator
        me bool: validateAitems <- true // Set to true to validate AItems
        me string: recordKey
        me bool: makeDebugGraph <-false  // Set to true for a graph
        me AItemGrapherData: grapherData
        if(agenda!.normalizationID==0){
            {
                me MutexMngr: phase1IDLock{phase1NormalizationIDMutex}
                agenda!.normalizationID <- phase1NextNormalizationID
                phase1NextNormalizationID <+- 1
            }
        }
        if(makeDebugGraph){grapher.clear(); grapher.addItem("rankdir=RL; ordering=out;")}
        me int: count <- 0
        while(!agenda!.AItems.isEmpty()) {
            our AItem: aItem <- agenda!.AItems.popFirst()
            aItem!.runID <- agenda!.nextRunID
            agenda!.nextRunID <+- 1
            if(makeDebugGraph){GraphNode_prePAI(aItem, grapherData)}

            our AItemTrace: phase1Trace <- validator.beginAItem(agenda, aItem, validateAitems)
            processAgendaItem(agenda, aItem, 0)
            validator.endAItem(agenda, aItem, phase1Trace, validateAitems)

// These lines should NOT be here. But It is sometimes useful for experimental diagnostics.
// That is because a new aItem should be enqueued every single time through ProcessAgendaItem except the last time.
// So it should never be empty early.
// Remove them eventually when streaming works well enough.
//  if(agenda!.AItems.isEmpty()){addQueuedAItemsToAgenda(agenda)}
//  else{addQueuedAItemsToAgenda(agenda)}

            if(makeDebugGraph){ GraphNode_postPAI(aItem, grapherData)}

            count <+- 1
        }
        phase1LastTraceCount <- validator.traces.size()
        phase1LastCoverageReport <- validator.coverageReport(agenda!.normalizationID)
        log(phase1LastCoverageReport)
        if(makeDebugGraph){grapher.saveGraph("AgendaRun", "AgendaRun.dot")}
    }
    void: init(their Agent: agnt) <- {agent <- agnt}
}
