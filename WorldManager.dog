        agendaEngine.processAgendaItem(self, agenda, aItem, AlternativesNestLvl)
    }
    void: processAgenda(their Agenda: agenda)<-{
        agendaEngine.processAgenda(self, agenda)
    }
    void: init(their Agent: agnt) <- {agent <- agnt}
}
