// Native lock bindings only; reasoning and continuation remain CodeDog.
struct WorldModelMutex: wraps=recursive_mutex {}
struct WorldModelLock: wraps=Nested_Lock_Mutex {}

// Replacement reasoner. Agent owns sessions; WorldManager owns their reasoning.
// Scalar and closed ordered-list reasoning with local parser completion.
struct WorldOutcome: inherits=<mode[
    worldReady, worldComplete, worldPartial, worldWaiting,
    worldRejected, worldUnsupported, worldCancelled, worldError
]> {}

// Exact numeric value sets. A point and an empty half-open interval differ.
struct WorldBounds {
    me bool: bounded <- false
    me bool: point <- false
    me FlexNum: low
    me FlexNum: high
    me bool: empty() <- {return(bounded and !point and low>=high)}
    me bool: contains(me WorldBounds: other) <- {
        if(other.empty()){return(true)}
        if(empty()){return(false)}
        if(!bounded){return(true)}
        if(!other.bounded){return(false)}
        if(other.point){return(low<=other.low and ((point and low==other.low) or (!point and other.low<high)))}
        return(!point and low<=other.low and other.high<=high)
    }
    me bool: same(me WorldBounds: other) <- {
        return(bounded==other.bounded and point==other.point and (!bounded or (low==other.low and high==other.high)))
    }
    me WorldBounds: intersect(me WorldBounds: other) <- {
        me WorldBounds: result <- self
        if(empty() or !other.bounded){return(result)}
        if(other.empty() or !bounded){return(other)}
        if(point){if(other.contains(result)){return(result)}}
        else if(other.point){if(contains(other)){return(other)}}
        else{result.low <- max(low, other.low); result.high <- min(high, other.high); return(result)}
        result.point <- false; result.high <- result.low
        return(result)
    }
}

// A text expression borrows immutable leaves. Concatenation adds one node;
// each branch retains its represented length, including a borrowed prefix.
struct WorldText {
    our infonState: source
    our WorldText: left
    our WorldText: right
    me int64: leftLength <- 0
    me int64: start <- 0 // A borrowed text window, measured in source bytes.
}
struct WorldTextSpan {
    our WorldText: text
    me int64: length
    me int64: start <- 0
}
struct WorldTextCursor {
    me List<WorldTextSpan>: pending
    our infonState: source
    me int64: pos <- 0
    me int64: remaining <- 0
    me uint64: visits <- 0
    void: push(our WorldText: text, me int64: length) <- {
        if(length>0){me WorldTextSpan: span; span.text <- text; span.length <- length; pending.append(span)}
    }
    me bool: nextLeaf() <- {
        while(remaining==0 and !pending.isEmpty()){
            me WorldTextSpan: span <- pending.popLast(); visits <+- 1
            if(span.text!.source!=NULL){source <- span.text!.source; pos <- span.text!.start; remaining <- span.length}
            else{
                push(span.text!.right, span.length-span.text!.leftLength)
                push(span.text!.left, min(span.length, span.text!.leftLength))
            }
        }
        return(remaining>0)
    }
    me char: next() <- {
        nextLeaf()
        me char: result <- source!.str[pos]
        pos <+- 1; remaining <- remaining-1
        return(result)
    }
}

// Sequences borrow member frames and summarize pending requirements. Joining
// adds one branch; cursors visit leaves once despite concatenation nesting.
struct WorldMember {
    our WorldFrame: frame
    me bool: embedded <- false
}
struct WorldList {
    our WorldList: left
    our WorldList: right
    me List<WorldMember>: members
    me int64: length <- 0
    // Represented members and required extent are different for sparse spans.
    me FlexNum: minimum <- 0
    me int: freeSpans <- 0 // Saturated at two: unique or potentially ambiguous.
    me bool: hasSpans <- false
    me bool: requirementsPending <- false
}
struct WorldListPosition {
    our WorldList: sequence
    me int64: pos <- 0
}
struct WorldListCursor {
    me List<WorldListPosition>: pending
    me uint64: visits <- 0
    void: push(our WorldList: sequence) <- {
        if(sequence!=NULL){me WorldListPosition: at; at.sequence <- sequence; pending.append(at)}
    }
    // Embedding belongs to the occurrence, not the cached member's infonView.
    me WorldMember: nextMember(me bool: flatten) <- {
        while(!pending.isEmpty()){
            me WorldListPosition: at <- pending.popLast()
            our WorldList: sequence <- at.sequence
            if(at.pos==0){visits <+- 1}
            if(flatten and sequence!.length==0){continue()}
            if(sequence!.left!=NULL or sequence!.right!=NULL){push(sequence!.right); push(sequence!.left)}
            else if(at.pos<sequence!.members.size()){
                me WorldMember: member <- sequence!.members[at.pos]
                at.pos <+- 1
                if(at.pos<sequence!.members.size()){pending.append(at)}
                if(flatten and member.embedded){push(member.frame!.facts.sequence)}
                else{return(member)}
            }
        }
        return(WorldMember())
    }
    our WorldFrame: next() <- {return(nextMember(true).frame)}
}

// A single symbolic gap has two anchored sequences. These borrow checked
// member frames; no model occurrences are allocated to inspect an alignment.
struct WorldOpenLayout {
    me List<our WorldFrame>: prefix
    me List<our WorldFrame>: suffix
    our WorldFrame: gap
    me int64: prefixCount <- 0
    me int64: suffixCount <- 0
}
struct WorldOpenScan {
    our WorldFrame: frame
    me WorldListCursor: members
}
struct WorldOpenAlignment {
    me int64: leftPrefixCount <- 0
    me int64: leftSuffixCount <- 0
    our WorldOpenLayout: right
    me int64: prefixPosition <- 0
    me int64: suffixPosition <- 0
    me int64: addedPrefix <- 0
    me int64: addedSuffix <- 0
    me bool: pastGap <- false
    me bool: remainderAdded <- false
}

// Occurrence paths borrow the model. They are local to a live request, not
// a persistent record of parent merge progress.
struct WorldPosition {
    our POV: owner
    our POV: argumentEdge
    our POV: node
    our WorldPosition: parent
    our POV: input
    our WorldPosition: inputContext
    me bool: writable <- true
    their POV: occurrence
    me bool: embedded <- false
    me bool: tail <- false
}
struct WorldWalkLevel {
    me List<our infonView>: namedLayouts
    our WorldPosition: position
    our POV: next
    me bool: entered <- false
    me bool: concatenated <- false
    me bool: tailRead <- false
    me bool: hasLimit <- false
    me FlexNum: limit
    me bool: hasExtent <- false
    me FlexNum: end
}
struct WorldWalk {
    me bool: rawLayout <- false
    // A span request can inspect wrappers instead of flattening them away.
    me bool: shallow <- false
    their POV: stopAt
    me FlexNum: stopIndex
    me bool: checkExtents <- false
    me bool: requireClosedRelations <- false
    me bool: listTypeProved <- false
    me FlexNum: position <- 0
    me List<our WorldWalkLevel>: levels
    me Set<our infonView>: activeLayouts
    me WorldOutcome: outcome <- worldReady
    me string: detail
    our infonView: waiting
    our WorldPosition: requestedLayout
    our WorldFrame: layoutFrame
    void: push(our WorldPosition: position) <- {
        our WorldWalkLevel:: level; level!.position <- position
        if(!levels.isEmpty()){level!.hasLimit <- levels.last()!.hasLimit; level!.limit <- levels.last()!.limit}
        levels.append(level)
    }
}
struct WorldSelection {
    our WorldFrame: coordinate
    our WorldWalk: walk
    void: INIT() <- {Allocate(walk)}
    our WorldPosition: selected
    me FlexNum: index <- 0
    me FlexNum: position <- 0
    me bool: located <- false
    me bool: lastTail <- false
    me bool: oneOf <- false
    me bool: openResult <- false
    me bool: domainChecked <- false
    our WorldPosition: domain
    our WorldFrame: candidate
}
// OR records borrow checked branch frames. A relationship distributes over
// them; it never changes a candidate's model or loses its conjunctions.
struct WorldAlternatives {
    me List<our WorldFrame>: members
}
struct WorldChoiceMerge {
    our WorldAlternatives: left
    our WorldAlternatives: right
    our WorldAlternatives: result
    me int64: lhs <- 0
    me int64: rhs <- 0
    our WorldFrame: pair
    our POV: edge
}
// A chart position retains only the selected occurrence. Alternatives with
// the same remaining predicates have identical future tests, so their captures
// can be packed without enumerating paths or losing an ambiguous selection.
struct WorldCapture {
    our WorldPosition: position
    our WorldFrame: facts
}
// Persistent match records share prefixes. A choice keeps both mappings;
// only an unambiguous accepted mapping may bound a whole-list result.
struct WorldMapping {
    our WorldMapping: prior
    our WorldMapping: alternative
    me bool: choice <- false
    me int64: slot <- 0
    our WorldCapture: capture
}
struct WorldMatch {
    me int64: slot <- 0
    our WorldCapture: capture
    our WorldMapping: mapping
    me bool: ambiguous <- false
}
struct WorldPattern {
    our WorldPosition: position
    our WorldFrame: predicate
    our WorldFrame: owner
    me List<our WorldRequirement>: requirements
}
// A correspondence request describes semantic coverage, not a traversal algorithm.
// The relation retains =/==/=: qualifiers. Testing a pattern is distinct from
// acquiring an asserted member's facts; both return source occurrences.
struct WorldCorrespondenceQuery {
    our WorldPosition: target
    our POV: relation
    me bool: testPattern <- false
    me bool: allMembers <- false
}
struct WorldCorrespondenceResult {
    our WorldPosition: sourceDomain
    me bool: positional <- false
    me bool: span <- false
    our WorldPosition: position
    our WorldFrame: facts
    our WorldMapping: bindings
    me List<our WorldPosition>: positions
}
// Hierarchical correspondence memoizes a template at a source boundary.
// Packed proofs share continuations; a later ambiguity never restarts work.
struct WorldPatternProof {
    our WorldPatternProof: prior
    our WorldPatternProof: child
    me bool: ambiguous <- false
}
struct WorldPatternResult {
    our WorldFrame: selected
    me int64: end <- 0
    our WorldFrame: frame
    our WorldPatternProof: proof
}
struct WorldPatternState {
    our WorldFrame: selected
    me int64: slot <- 0
    me int64: end <- 0
    our WorldList: sequence
    me bool: complete <- true
    me bool: representable <- true
    our WorldPatternProof: proof
    void: INIT() <- {Allocate(proof)}
}
struct WorldPatternGoal {
    me bool: projectedPrefix <- false
    our WorldFrame: pattern
    me int64: start <- 0
    me bool: initialized <- false
    me bool: finished <- false
    me List<WorldMember>: members
    our WorldFrame: repeated
    me WorldRequirementCursor: requirements
    me List<our WorldPatternState>: pending
    me Map<string, our WorldPatternState>: states
    me List<our WorldPatternResult>: results
    me Map<int64, our WorldPatternResult>: ends
    our WorldPatternState: state
    our WorldPatternGoal: child
    me int64: alternative <- 0
}
struct WorldPatternStarts {me Map<int64, our WorldPatternGoal>: goals}
struct WorldPatternChart {
    our WorldPosition: patternPosition
    our WorldFrame: pattern
    me bool: deterministic <- true
    me bool: selectedEarly <- false
    me Map<our WorldFrame, our WorldPatternStarts>: memo
    me List<our WorldPatternGoal>: pending
    our WorldPatternGoal: root
    me bool: initialized <- false
    me bool: text <- false
    me WorldTextCursor: textCursor
    me List<WorldTextSpan>: textSpans
    me int64: textIndexed <- 0
    me int64: textIndex <- 0
    me bool: ended <- false
    our WorldFrame: source
    our POV: sourceProbe
    me Set<our infonView>: sourcePath
    me List<our WorldCapture>: input
    our WorldPatternResult: accepted
    me int64: resultIndex <- 0
}
struct WorldCorrespondence {
    me bool: sourceResolved <- false
    our WorldFrame: sourceReference
    our WorldPatternChart: chart
    our WorldWalk: left
    our WorldWalk: right
    our WorldCorrespondenceQuery: query
    our WorldCorrespondenceResult: result
    void: INIT() <- {Allocate(left); Allocate(right); Allocate(query); Allocate(result)}
    our WorldPosition: lhs
    our WorldPosition: rhs
    me bool: bounded <- false
    me bool: normalized <- false
    me bool: capturing <- false
    our WorldFrame: prefixPredicate
    me bool: captured <- false
    me FlexNum: remaining <- 0
    me FlexNum: sourceOffset <- 0
    our WorldFrame: layout
    me List<our WorldFrame>: layouts
    me List<our WorldMapping>: mapped
    our WorldFrame: supplied
    me bool: materializing <- false
    me int64: predicateIndex <- 0
    our WorldFrame: candidate
    our WorldCapture: capture
    our WorldCapture: priorCapture
    our POV: memberEdge
    me List<our WorldPattern>: pattern
    me bool: patternDone <- false
    me bool: started <- false
    me bool: sourceDone <- false
    // Sorted frontiers: a transition stays at its repeated slot or advances
    // one slot. Equal destinations are adjacent, requiring no search or map.
    me List<our WorldMatch>: active
    me List<our WorldMatch>: following
    me List<our WorldMatch>: consuming
    me bool: checking <- false
    me int64: cursor <- 0
    our WorldMatch: branch
    our WorldMatch: epsilon
    our WorldMatch: accepted
}

// The catalogue stores shared declarations, not normalized instances.
struct WorldDefinitions {
    me List<our WordDefn>: entries
}
struct WorldFieldMerge {
    me List<our WorldFrame>: members
    me int64: next <- 0
    our WorldList: sequence
    void: INIT() <- {Allocate(sequence)}
}
struct WorldScalar {
    me int: terminalValue <- 0 // 1 = null, 2 = undefined
    our InfonIdentity: identity
    our POV: boundary

    me bool: inheritedName <- false
    me OrderMode: order <- uUnknown
    me bool: timelike <- false
    me WorldOutcome: outcome <- worldReady
    me string: detail
    our WordUse: nominal
    me List<our WordUse>: qualifications // Checked types supplied by applied meanings.
    our WordDefn: declaration
    me bool: meaningApplied <- false
    me int: overlay <- -1
    me bool: hasSize <- false
    me FlexNum: size
    me bool: hasValue <- false
    me FlexNum: number
    our WorldText: textSource
    me int64: textLength <- 0
    me bool: negative <- false
    // A merge can need more facts without terminating the containing goal.
    me bool: needsEvidence <- false
    our WorldRequirement: pendingChecks
    me bool: extentApplied <- false
    me bool: explicitSize <- false
    me bool: contentsComplete <- true
    me bool: representable <- true
    me bool: fieldLayout <- false
    me bool: dischargeListSpec <- false
    me bool: openTail <- false
    our WorldList: sequence
    our WorldAlternatives: alternatives
    me bool: hasRange <- false
    me FlexNum: lower
    me FlexNum: upper

    me WorldBounds: bounds() <- {
        me WorldBounds: result
        result.bounded <- hasValue or hasRange or hasSize
        result.point <- hasValue
        if(hasValue){result.low <- number; result.high <- number}
        else if(hasRange){result.low <- lower; result.high <- upper}
        else if(hasSize){result.high <- size}
        return(result)
    }
    void: useBounds(me WorldBounds: result) <- {
        hasValue <- result.point
        hasRange <- result.bounded and !result.point
        if(hasValue){number <- result.low}
        else if(hasRange){lower <- result.low; upper <- result.high}
    }

    void: applyExtent() <- {
        if(hasValue and overlay==NUM and hasSize and !extentApplied){
            if(number<0){number <+- size}
            extentApplied <- true
        }
    }
}

// Persistent ordered requirements: joining scopes never copies either side.
struct WorldRequirement {
    our WorldRequirement: left
    our WorldRequirement: right
    our WorldFrame: frame
    our POV: edge
}
struct WorldRequirementCursor {
    me List<our WorldRequirement>: pending
    me uint64: visits <- 0
    void: push(our WorldRequirement: requirement) <- {if(requirement!=NULL){pending.append(requirement)}}
    our WorldRequirement: next() <- {
        while(!pending.isEmpty()){
            our WorldRequirement: requirement <- pending.popLast(); visits <+- 1
            if(requirement!.frame!=NULL){return(requirement)}
            push(requirement!.right); push(requirement!.left)
        }
        return(NULL)
    }
}

// Definition-derived coordinates. A measure is a finite homogeneous chain;
// a segment keeps its source occurrence rather than expanding represented gaps.
struct WorldUnit {
    our WordUse: word
    our WordUse: base
    our WorldUnit: member
    me FlexNum: count <- FlexNum("1")
    me FlexNum: width <- FlexNum("1")
}
struct WorldUnitSegment {
    our WorldUnit: member
    our WorldPosition: source
    me FlexNum: start
    me FlexNum: width
    me bool: gap <- false
}
struct WorldUnitLevel {
    our infonView: source
    our WorldWalk: walk
    our WorldUnit: member
    our WorldPosition: pending
    me FlexNum: start
    void: INIT() <- {Allocate(walk); walk!.shallow <- true; walk!.rawLayout <- true; walk!.requireClosedRelations <- true}
}
struct WorldUnitOrigin {
    our WorldUnit: member
    me FlexNum: membersCount
    me bool: sparse <- false
    me FlexNum: offset
    me FlexNum: count
    our WorldPosition: source
    me List<our POV>: members
}
struct WorldSparseEdit {
    me int64: index
    our WorldFrame: frame
}
struct WorldSparseBatch {
    our WorldPosition: source
    me int64: count
    me Map<int64, our WorldSparseEdit>: edits
    me List<our WorldSparseEdit>: descending() <- {
        me List<our WorldSparseEdit>: result
        withEach edit in edits{result.append(edit)}
        me int64: width <- 1; me int64: count <- result.size()
        while(width<count){
            me List<our WorldSparseEdit>: merged
            me int64: start <- 0
            while(start<result.size()){
                me int64: left <- start; me int64: middle <- min(start+width, count)
                me int64: right <- middle; me int64: end <- min(middle+width, count)
                while(left<middle or right<end){
                    if(right>=end or (left<middle and result[left]!.index>result[right]!.index)){merged.append(result[left]); left <+- 1}
                    else{merged.append(result[right]); right <+- 1}
                }
                start <- end
            }
            result <- merged; width <+- width
        }
        return(result)
    }
}
struct WorldUnitSelection {
    me FlexNum: prefix
    me FlexNum: suffix
    me bool: writeThrough <- false
    our WorldFrame: sourceReference
    our WorldPosition: source
    our WorldUnit: unit
    me FlexNum: coordinate
    me FlexNum: count <- FlexNum("1")
    me FlexNum: end <- 0
    me bool: span <- false
    me bool: explicitSpec <- false
    me bool: entered <- false
    me List<our WorldUnitLevel>: levels
    me List<WorldUnitSegment>: segments
    me int64: segment <- 0
    me Set<our infonView>: active
    our WorldFrame: result
}

struct WorldPath {
    our WorldWalk: cursorLayout
    our WorldPosition: cursor
    me bool: descending <- false
    our WorldPosition: source
    me int64: next <- 0
    me bool: returned <- false
    me bool: applied <- false
    our PartPath: part
    our WorldFrame: index
    our WorldFrame: operation
    our WorldFrame: nested
}

struct WorldFrame {
    our WorldPosition: navigation
    me bool: contextual <- false
    our POV: argumentEdge
    me bool: sourceNameInherited <- false
    our WorldUnitSelection: unitSelection
    our POV: inputEdge
    our WorldFrame: projectionBody
    our WorldFieldMerge: fields
    me bool: lazyPattern <- false
    our POV: node
    our WorldPath: path
    me bool: acquireOnly <- false
    me bool: referenceOnly <- false
    me WorldScalar: facts
    me int64: nextWork <- 0
    me bool: meaningRequested <- false
    me bool: initialized <- false
    me bool: finished <- false
    // Derived correspondence frames combine checked facts, never reread a POV.
    me bool: projected <- false
    me bool: corresponding <- false
    our WorldOpenAlignment: openAlignment
    our WorldPosition: context
    our WorldPosition: parentContext
    me int64: parentWork <- -1
    our WorldSelection: selection
    our WorldChoiceMerge: choiceMerge
    our WorldCorrespondence: lookup
    our WorldCorrespondenceResult: correspondenceResult
    me bool: selecting <- false
    me bool: predicateOnly <- false
    me bool: demandSize <- false
    me WorldListCursor: leftMembers
    our WorldListCursor: rightMembers
    me bool: pairedEmbedded <- false
    me bool: applyingListSpec <- false
    me bool: ownsRightCursor <- false
    me bool: extendingTail <- false
    me FlexNum: remaining <- 0
    me FlexNum: gapWidth <- 0
    our WorldFrame: pairedMember
    our WorldList: pairedSequence
    their POV: expressionParent
    // Visit the two stored slots once, then supplied identities.
    me int: expressionSlot <- 0 // 0=unstarted, 1=size, 2=value, 3=wrkList
    me bool: sourceIsOperand <- false
    me bool: sourceIsListSpec <- false
    me bool: memberSpecified <- false
    our POV: listSpecEdge
    our WorldFrame: listSpecFrame
    our WorldRequirement: tailRequirements
    our WorldRequirement: pendingRequirements
    me WorldRequirementCursor: memberRequirements
    our POV: nextOperand
    our POV: priorOperand
    me int64: operandsRead <- 0
    me WorldScalar: expression
    me WorldBounds: bodyBounds
    me bool: bodyHasSize <- false
    me FlexNum: bodySize
    me List<our POV>: retainedWork
    me bool: retainSource <- false
    our POV: sourceEdge
    our POV: preparedReplacement
    our WorldFrame: prerequisite
}

// The shared control outlives WorldManager when callers retain completed handles.
struct WorldControl {
    our POV: worldRoot
    our IdentityRegistry:: identities
    me WorldModelMutex: mutex
    me Map<our infonView, our WorldInputWaiters>: inputWaiters
}
struct WorldInputWaiters {
    me List<our WorldRequest>: requests
}
struct WorldStatus {
    me WorldOutcome: outcome
    me string: detail
}
struct WorldPublication {
    our POV: target
    our WorldFrame: frame
    our infonState: newList
    our infonState: appendedList
    our infonView: newAlternatives
    me bool: reorderFields <- false
    me List<our POV>: fieldOrder
}
struct WorldRequest {
    me Map<our POV, our WorldFrame>: completedOccurrences
    our IdentityRegistry: identities
    me Map<our POV, our BoundaryReference>: boundaries
    me Map<our infonView, our WorldSparseBatch>: sparseEdits
    me Map<our infonView, our WorldUnitOrigin>: unitOrigins
    our infonView: worldSource
    me vocabularySpec: vocabulary
    me Map<string, our WorldDefinitions>: declarations
    me Set<our WordDefn>: declarationOrigins
    me uint64: meaningEdges <- 0
    me uint64: namedLayouts <- 0
    our WorldControl: control
    our infonView: waitingInput
    our WorldFrame: waitingFrame
    our POV: target
    me bool: requireSize <- false
    me WorldOutcome: outcome <- worldReady
    me string: detail
    me uint64: framesCreated <- 0
    me uint64: relationshipsRead <- 0
    me uint64: publications <- 0
    me uint64: alternativePairs <- 0
    me uint64: memberPairs <- 0
    me uint64: alignmentChecks <- 0
    me uint64: correspondencePositions <- 0
    me uint64: correspondenceChecks <- 0
    me uint64: correspondenceMappings <- 0
    me uint64: parentLookups <- 0
    me uint64: templateApplications <- 0
    me uint64: comparisonResumptions <- 0
    me uint64: requirementVisits <- 0
    me uint64: tailMembers <- 0
    me uint64: sequenceVisits <- 0
    me uint64: textSourceNodes <- 0
    me uint64: textWindowNodes <- 0
    me uint64: publishedTextBytes <- 0
    me uint64: publishedTextNodes <- 0
    me List<our WorldFrame>: ready
    me Map<our infonView, our WorldFrame>: attempts
    // Active ancestry only: this prevents circular contextual proofs, not
    // reuse of facts from a different occurrence.
    me Map<our infonView, our WorldFrame>: activeContexts
    our WorldFrame: root
    me Map<our infonView, our WorldFrame>: edits
    our WorldCorrespondenceResult: provenance
    our POV: selectedSource() <- {if(provenance!=NULL and provenance!.position!=NULL){return(provenance!.position!.node)} return(NULL)}
    me WorldStatus: status() <- {
        me WorldModelLock: lock{control!.mutex}
        me WorldStatus: result
        result.outcome <- outcome; result.detail <- detail
        return(result)
    }
    me bool: complete() <- {return(status().outcome==worldComplete)}
    me bool: failed() <- {
        me WorldOutcome: state <- status().outcome
        return(state==worldRejected or state==worldUnsupported or state==worldError)
    }
    me string: error() <- {return(status().detail)}
    our POV: result() <- {return(target)}
    // Normalization drains runnable work before returning. Taking this lock
    // also waits for any active publication to finish; Waiting stays visible.
    void: waitForCompletion() <- {me WorldModelLock: lock{control!.mutex}}
    void: releaseProgress() <- {
        completedOccurrences.clear(); boundaries.clear(); sparseEdits.clear(); unitOrigins.clear(); ready.clear(); attempts.clear(); activeContexts.clear(); edits.clear(); declarations.clear(); declarationOrigins.clear(); root <- NULL; waitingFrame <- NULL
    }
    void: cancel() <- {
        me WorldModelLock: lock{control!.mutex}
        if(waitingInput!=NULL and control!.inputWaiters.containsKey(waitingInput)){
            our WorldInputWaiters: waiters <- control!.inputWaiters.at(waitingInput)
            me List<our WorldRequest>: remaining
            withEach request in waiters!.requests{
                if(request!==self){remaining.append(request)}
            }
            waiters!.requests <- remaining
            if(remaining.isEmpty()){control!.inputWaiters.erase(waitingInput)}
        }
        waitingInput <- NULL
        if(outcome==worldReady or outcome==worldWaiting or outcome==worldPartial){outcome <- worldCancelled}
        releaseProgress()
    }
}

struct WorldSession {
    me uint64: id
    me bool: closed <- false
    me List<our WorldRequest>: requests
}

struct WorldParseResult {
    our POV: target
    me string: error
}

struct infonView {
    // A copied view must not inherit another occurrence's completion marker.
    // Stronger requests still inspect their explicitly requested facts.
    their infonView: worldScalarCompletionOwner
    // A new supplied constraint needs a new request. Existing handles are not reset.
    void: noteNormalizationWork() <- {worldScalarCompletionOwner <- NULL; isNormed <- false}
}

// Virtual access over the existing model; no copied adjacency graph.
struct WorldPOVGraph {
    // A boundary argument is an ordinary identity with an unconstrained
    // remainder. Member and whole-list consumers use the same correspondence.
    our POV: argumentRelation(our infonView: item, me WorldScalar: header) <- {
        if(item!.funcArgs==NULL or item!.argPos==apNoArgs){return(NULL)}
        our POV:: edge{943}; Allocate(edge!.pItem)
        our infonView: body <- edge!.pItem
        body!.itmMode <- mItem; body!.streamState <- parseDone; body!.viewMode <- vmOverlay; body!.orderMode <- uOrdered
        body!.value!.overlayType <- LST; body!.value!.evalMode <- emLiteral
        body!.infSize!.overlayType <- NUM; body!.infSize!.evalMode <- emUnknown
        if(item!.argPos==apArgIsLastItem){
            our infonView:: gap; gap!.itmMode <- mItem; gap!.streamState <- parseDone; gap!.viewMode <- vmOverlay
            gap!.value!.overlayType <- LST; gap!.value!.evalMode <- emLiteral; gap!.value!.tailUnfinished <- true
            gap!.infSize!.overlayType <- NUM; gap!.infSize!.evalMode <- emUnknown
            if(header.hasSize and header.size>=1){gap!.infSize!.evalMode <- emLiteral; gap!.infSize!.num <- header.size-1; gap!.value!.sizeMode <- fromGiven}
            body!.value!.items.append(gap, true, 943)
        }else{body!.value!.tailUnfinished <- true}
        body!.value!.items.append(item!.funcArgs, false, 943)
        return(edge)
    }

    our POV: boundaryOf(our WorldRequest: request, our WorldPosition: source, me bool: end) <- {
        if(source!.node!.pItem!.isNull()){return(source!.node)}
        our POV: anchor <- source!.owner
        our BoundaryReference: reference
        if(request!.boundaries.containsKey(anchor)){reference <- request!.boundaries.at(anchor)}
        else{
            Allocate(reference); reference!.source <- anchor
            if(request!.identities!.boundaries.containsKey(anchor)){reference! <- request!.identities!.boundaries.at(anchor)!}
            request!.boundaries.insert(anchor, reference)
        }
        our POV: result <- reference!.begin
        if(end){result <- reference!.end}
        if(result==NULL){
            Allocate(result, 944); Allocate(result!.pItem); result!.pItem!.setToNull(); result!.pItem!.streamState <- parseDone
            if(end){reference!.end <- result}else{reference!.begin <- result}
        }
        return(result)
    }

    // Navigation words are bare predicates. A supplied value/shape remains
    // an ordinary matching constraint even when it uses the same name.
    me string: pathOperator(our infonView: item) <- {
        if(item!.type!=NULL and item!.viewMode==vmAny and !item!.invertMatch and item!.addedTypes.isEmpty() and
           item!.innr==NULL and item!.funcArgs==NULL and item!.value!.evalMode==emUnknown and item!.infSize!.evalMode==emUnknown){return(item!.type!.typeID())}
        return("")
    }
    our infonView: pathBody(our infonView: source, me bool: stripWork) <- {
        our infonView:: body; body! <- source!
        body!.parts.clear(); body!.partRef <- NULL
        if(stripWork){body!.wrkList.clear()}
        body!.isNormed <- false; body!.worldScalarCompletionOwner <- NULL
        return(body)
    }
    me Map<string, our WorldDefinitions>: definitions
    me Set<our WordDefn>: declarationOrigins

    void: addDefinition(their Map<string, our WorldDefinitions>: catalog, our WordDefn: definition) <- {
        if(!catalog!.containsKey(definition!.defWord)){
            our WorldDefinitions:: entries; catalog!.insert(definition!.defWord, entries)
        }
        catalog!.at(definition!.defWord)!.entries.append(definition)
    }
    our WordDefn: stageDefinition(our WorldRequest: request, our infonView: item) <- {
        if(declarationOrigins.contains(item!.definedWord) or request!.declarationOrigins.contains(item!.definedWord)){return(item!.definedWord)}
        request!.declarationOrigins.insert(item!.definedWord)
        our WordDefn:: definition; definition! <- item!.definedWord!
        definition!.defWord <- unicodeMgr.normalizeStr(definition!.defWord)
        me int: separator <- findString(definition!.defWord, "_")
        if(separator!=-1){
            definition!.modelID <- definition!.defWord.subStr(separator+1, definition!.defWord.size())
            definition!.defWord <- definition!.defWord.subStr(0, separator)
        }
        definition!.meaning <- item!.funcArgs
        if(definition!.UsageTags.isEmpty()){definition!.langSpecTag <- request!.vocabulary.langSpec}
        else{definition!.langSpecTag <- unicodeMgr.normalizeStr(definition!.UsageTags[0])}
        addDefinition(request!.declarations, definition)
        return(definition)
    }
    // An existing binding is stable. A fresh use must have one applicable
    // declaration; overload search and morphological lookup are later work.
    me WorldScalar: bind(our WorldRequest: request, me WorldScalar: facts, our WordUse: word) <- {
        facts.nominal <- word
        if(word==NULL or word!.baseDefinition!=NULL){return(facts)}
        our WordUse:: bound; bound! <- word!
        me int: separator <- findString(bound!.normalType(), "_")
        if(separator!=-1 and bound!.modelID==""){
            bound!.modelID <- bound!.normedWord.subStr(separator+1, bound!.normedWord.size())
            bound!.normedWord <- bound!.normedWord.subStr(0, separator)
        }
        me int: count <- 0
        withEach pass in range 0 .. 2{
            our WorldDefinitions: candidates
            if(pass==0 and definitions.containsKey(bound!.normalType())){candidates <- definitions.at(bound!.normalType())}
            if(pass==1 and request!.declarations.containsKey(bound!.normalType())){candidates <- request!.declarations.at(bound!.normalType())}
            if(candidates!=NULL){
                withEach definition in candidates!.entries{
                    if(modelMngr.wordValidForLang(definition!.langSpecTag, request!.vocabulary) and
                       (bound!.modelID=="" or bound!.modelID==definition!.modelID)){
                        bound!.baseDefinition <- definition; bound!.defToUse <- definition!.meaning; count <+- 1
                    }
                }
            }
        }
        if(count>1){facts.outcome <- worldUnsupported; facts.detail <- "Named meaning needs overload selection"}
        if(count==1){bound!.modelID <- bound!.baseDefinition!.modelID}
        facts.nominal <- bound
        return(facts)
    }
    // Only a proved finite homogeneous definition supplies coordinate units.
    // Other definitions remain with the ordinary matcher; equal shapes alone
    // do not establish nominal identity.
    our WorldUnit: unitMeasure(our WorldRequest: request, our WordUse: word, their Set<our infonView>: seen) <- {
        if(word==NULL){return(NULL)}
        me WorldScalar: binding; binding <- bind(request, binding, word)
        if(binding.outcome!=worldReady or binding.nominal!.defToUse==NULL){return(NULL)}
        our infonView: body <- binding.nominal!.defToUse
        if(seen!.contains(body) or body!.streamState!=parseDone or body!.type!=NULL or !body!.addedTypes.isEmpty() or
           !body!.wrkList.isEmpty() or body!.partRef!=NULL or !body!.parts.isEmpty() or body!.funcArgs!=NULL or
           body!.innr!=NULL or body!.invertMatch or body!.value!.undefined or body!.value!.inverted){return(NULL)}
        our WorldUnit:: result; result!.word <- binding.nominal
        if(body!.value!.overlayType==NUM and body!.value!.evalMode==emUnknown and body!.infSize!.evalMode==emUnknown){result!.base <- result!.word; return(result)}
        if(body!.value!.overlayType!=LST or body!.value!.evalMode!=emLiteral or body!.orderMode==uUnordered or
           body!.value!.items.head!=NULL or !body!.value!.tailUnfinished or body!.value!.listSpec==NULL or
           body!.infSize!.evalMode!=emLiteral or body!.infSize!.num<=0 or body!.infSize!.num.getDenominator()!=1){return(NULL)}
        our infonView: spec <- body!.value!.listSpec
        if(pathOperator(spec)==""){return(NULL)}
        seen!.insert(body)
        result!.member <- unitMeasure(request, spec!.type, seen)
        if(result!.member==NULL){return(NULL)}
        result!.count <- body!.infSize!.num; result!.width <- result!.count*result!.member!.width
        result!.base <- result!.member!.base
        return(result)
    }
    our WorldUnit: unitType(our WorldRequest: request, our infonView: item) <- {
        if(item==NULL or pathOperator(item)==""){return(NULL)}
        me Set<our infonView>: seen
        return(unitMeasure(request, item!.type, seen))
    }
    our WorldUnit: writtenUnit(our WorldRequest: request, our WorldPosition: source, our WorldUnit: fallback) <- {
        our infonView: body <- source!.node!.pItem
        if(body!.value!.listSpec!=NULL){return(unitType(request, body!.value!.listSpec))}
        if(body!.type!=NULL){
            me Set<our infonView>: seen
            our WorldUnit: declared <- unitMeasure(request, body!.type, seen)
            if(declared!=NULL and declared!.member!=NULL){return(declared!.member)}
        }
        return(fallback)
    }

    // A distinct name is a proven mismatch only when no unexamined meaning
    // can supply an inherited nominal type. More general meanings need that
    // proof, even if their written names differ.
    me bool: noInheritedType(our WordUse: word) <- {
        if(word!.baseDefinition==NULL){return(word!.defToUse==NULL)}
        our infonView: body <- word!.defToUse
        return(body!=NULL and body!.streamState==parseDone and body!.type==NULL and body!.addedTypes.isEmpty() and
            body!.wrkList.isEmpty() and body!.innr==NULL and body!.funcArgs==NULL and body!.proxy==NULL and
            body!.parts.isEmpty() and body!.partRef==NULL and body!.value!=NULL and
            (body!.value!.overlayType==NUM or body!.value!.overlayType==STR or body!.value!.overlayType==LST) and
            (body!.value!.evalMode==emLiteral or body!.value!.evalMode==emUnknown))
    }
    me WorldOutcome: compareNominal(our WordUse: required, our WordUse: actual) <- {
        if(required==NULL){return(worldReady)}
        if(actual==NULL){return(worldPartial)}
        if(required!.baseDefinition!=NULL and actual!.baseDefinition!=NULL){
            if(required!.baseDefinition===actual!.baseDefinition){return(worldReady)}
            if(noInheritedType(required) and noInheritedType(actual)){return(worldRejected)}
            return(worldPartial)
        }
        if(required!.typeID()!=actual!.typeID()){
            if(noInheritedType(required) and noInheritedType(actual)){return(worldRejected)}
            return(worldPartial)
        }
        if(required!.baseDefinition!=NULL or actual!.baseDefinition!=NULL){return(worldPartial)}
        return(worldReady)
    }
    me WorldOutcome: hasNominal(me WorldScalar: actual, our WordUse: required) <- {
        me WorldOutcome: match <- compareNominal(required, actual.nominal)
        if(match==worldReady){return(match)}
        withEach word in actual.qualifications{
            if(compareNominal(required, word)==worldReady){return(worldReady)}
        }
        if(actual.meaningApplied and actual.nominal!=NULL){return(worldRejected)}
        if(required!=NULL and required!.defToUse==NULL and actual.nominal==NULL and actual.hasValue and
           (actual.overlay==NUM or actual.overlay==STR)){return(worldRejected)}
        return(match)
    }
    me WorldOutcome: compareNames(me WorldScalar: required, me WorldScalar: actual) <- {
        me WorldOutcome: result <- hasNominal(actual, required.nominal)
        if(result==worldRejected){return(result)}
        withEach word in required.qualifications{
            me WorldOutcome: match <- hasNominal(actual, word)
            if(match==worldRejected){return(match)}
            if(match!=worldReady){result <- match}
        }
        return(result)
    }
    void: addNominal(their WorldScalar: facts, our WordUse: word) <- {
        if(word!=NULL and hasNominal(facts!, word)!=worldReady){facts!.qualifications.append(word)}
    }
    // An applied meaning proves its positive nominal qualifications. Identity
    // can carry those facts in either direction; predicate comparison remains
    // directional. Equal primitive values do not equate sibling declarations.
    me WorldScalar: mergeNames(me WorldScalar: left, me WorldScalar: right, our POV: edge) <- {
        if(left.negative or right.negative){return(left)}
        if(!edge!.trueByDefinition and left.nominal!=NULL and right.nominal!=NULL){
            me WorldOutcome: forward <- compareNames(left, right)
            me WorldOutcome: backward <- compareNames(right, left)
            if(forward!=worldReady and backward!=worldReady){
                left.outcome <- worldUnsupported
                if(forward==worldRejected and backward==worldRejected){left.outcome <- worldRejected}
                if(left.outcome!=worldRejected and !left.meaningApplied and left.nominal!.defToUse!=NULL){left.outcome <- worldPartial; left.needsEvidence <- true}
                left.detail <- "Nominal types do not have a proved identity"; return(left)
            }
        }
        if(!edge!.trueByDefinition and left.nominal==NULL){
            left.nominal <- right.nominal; left.inheritedName <- right.inheritedName; left.meaningApplied <- right.meaningApplied
        }else{addNominal(left, right.nominal)}
        withEach word in right.qualifications{addNominal(left, word)}
        if(edge!.trueByDefinition){left.meaningApplied <- true}
        return(left)
    }
    me int64: sequenceLength(our WorldList: sequence) <- {
        if(sequence==NULL){return(0)}else{return(sequence!.length)}
    }
    me bool: openLayout(me WorldScalar: facts) <- {
        return(facts.openTail or (facts.sequence!=NULL and facts.sequence!.hasSpans))
    }
    me FlexNum: minimumWidth(me WorldScalar: facts) <- {
        if(facts.sequence==NULL){return(FlexNum())}else{return(facts.sequence!.minimum)}
    }
    me int: freeSpans(me WorldScalar: facts) <- {
        me int: count <- 0
        if(facts.sequence!=NULL){count <- facts.sequence!.freeSpans}
        if(facts.openTail){count <+- 1}
        return(min(count, 2))
    }
    // Nonnegative span widths add to the supplied endpoint. One free width,
    // or a zero remainder, has one solution; other partitions stay unresolved.
    me WorldScalar: fitExtent(me WorldScalar: facts, me FlexNum: extent) <- {
        me FlexNum: minimum <- minimumWidth(facts)
        me int: free <- freeSpans(facts)
        if((facts.hasSize and facts.size!=extent) or extent<minimum or (free==0 and extent!=minimum)){
            facts.outcome <- worldPartial; facts.detail <- "List endpoints need span alignment"
        }else if(free>1 and extent>minimum){
            facts.outcome <- worldPartial; facts.detail <- "Several span widths remain possible"
        }
        return(facts)
    }
    our WorldList: join(our WorldList: left, our WorldList: right) <- {
        if(left==NULL){return(right)}
        if(right==NULL){return(left)}
        our WorldList:: result
        result!.left <- left; result!.right <- right
        result!.length <- left!.length+right!.length
        result!.minimum <- left!.minimum+right!.minimum
        result!.freeSpans <- min(2, left!.freeSpans+right!.freeSpans)
        result!.hasSpans <- left!.hasSpans or right!.hasSpans
        result!.requirementsPending <- left!.requirementsPending or right!.requirementsPending
        return(result)
    }
    me bool: appendMember(our WorldList: sequence, our WorldFrame: frame, me bool: embedded <- false) <- {
        me int64: length <- 1
        if(embedded){length <- sequenceLength(frame!.facts.sequence)}
        if(length>9223372036854775807-sequence!.length){return(false)}
        me WorldMember: member; member.frame <- frame; member.embedded <- embedded
        sequence!.members.append(member); sequence!.length <+- length
        sequence!.requirementsPending <- sequence!.requirementsPending or needsRequirements(frame)
        if(embedded){
            if(frame!.facts.hasSize){sequence!.minimum <+- frame!.facts.size}
            else{
                sequence!.minimum <+- minimumWidth(frame!.facts)
                sequence!.freeSpans <- min(2, sequence!.freeSpans+freeSpans(frame!.facts))
            }
            sequence!.hasSpans <- sequence!.hasSpans or openLayout(frame!.facts)
        }else{sequence!.minimum <+- 1}
        return(true)
    }
    our WorldCorrespondence: correspondence(our WorldPosition: pattern, our POV: relation,
                                                  our WorldPosition: target, me bool: testPattern,
                                                  me bool: allMembers <- false) <- {
        our WorldCorrespondence:: lookup
        lookup!.query!.target <- target; lookup!.query!.relation <- relation
        lookup!.query!.testPattern <- testPattern; lookup!.query!.allMembers <- allMembers
        if(relation!=NULL){lookup!.memberEdge <- memberRelationship(relation)}
        if(pattern!=NULL){lookup!.left!.push(pattern)}
        lookup!.right!.requireClosedRelations <- true
        if(relation!=NULL){
            lookup!.result!.sourceDomain <- position(relation)
            if(pattern!=NULL and relation===pattern!.input and pattern!.inputContext!=NULL){lookup!.result!.sourceDomain <- pattern!.inputContext}
            lookup!.right!.push(lookup!.result!.sourceDomain)
        }
        return(lookup)
    }
    void: beginCorrespondence(our WorldFrame: frame, me FlexNum: extent <- FlexNum()) <- {
        if(!frame!.applyingListSpec){
            if(frame!.openAlignment==NULL){
                frame!.facts <- fitExtent(frame!.facts, extent)
                if(frame!.facts.outcome!=worldReady){return()}
                frame!.remaining <- extent; frame!.gapWidth <- extent-minimumWidth(frame!.facts)
            }
            frame!.extendingTail <- frame!.facts.openTail
        }
        if(frame!.lookup==NULL){
            frame!.lookup <- correspondence(NULL, frame!.sourceEdge, NULL, false, true)
            frame!.lookup!.normalized <- true; frame!.lookup!.result!.positional <- true
        }
        frame!.corresponding <- true; frame!.leftMembers.push(frame!.facts.sequence)
        Allocate(frame!.pairedSequence)
        frame!.facts.contentsComplete <- true; frame!.facts.representable <- true
    }
    me bool: needsRequirements(our WorldFrame: frame) <- {
        return(frame!.facts.outcome==worldReady and (frame!.pendingRequirements!=NULL or
            (frame!.facts.sequence!=NULL and frame!.facts.sequence!.requirementsPending)))
    }
    our WorldRequirement: joinRequirements(our WorldRequirement: left, our WorldRequirement: right) <- {
        if(left==NULL){return(right)}
        if(right==NULL){return(left)}
        our WorldRequirement:: result; result!.left <- left; result!.right <- right
        return(result)
    }
    our WorldRequirement: requirement(our WorldFrame: spec, our POV: edge) <- {
        our WorldRequirement:: result; result!.frame <- spec; result!.edge <- edge
        return(result)
    }
    void: beginRequirements(our WorldFrame: frame, our WorldRequirement: inherited <- NULL) <- {
        frame!.pendingRequirements <- joinRequirements(frame!.pendingRequirements, inherited)
        if(frame!.facts.openTail){frame!.tailRequirements <- joinRequirements(frame!.tailRequirements, frame!.pendingRequirements)}
        frame!.applyingListSpec <- true; beginCorrespondence(frame)
    }
    me bool: checkEmbedded(our WorldFrame: frame) <- {
        me WorldScalar: facts <- frame!.prerequisite!.facts
        if(facts.overlay!=LST or !facts.hasValue){
            frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Embedded member needs a closed list"; return(false)
        }
        me FlexNum: minimum <- minimumWidth(facts)
        if(facts.outcome!=worldReady or
           (!openLayout(facts) and (!facts.hasSize or facts.size!=FlexNum(sequenceLength(facts.sequence)))) or
           (facts.hasSize and (facts.size.getDenominator()!=1 or facts.size<minimum or
               (freeSpans(facts)==0 and facts.size!=minimum)))){
            frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Embedded list extent is unresolved"; return(false)
        }
        return(true)
    }
    me bool: scalarExpression(our infonState: state) <- {
        return(state!.overlayType==LST and state!.evalMode==emConcat and !state!.inverted and
            !state!.undefined and state!.items.head!=NULL and state!.listSpec==NULL and
            !state!.tailUnfinished and !state!.timelike)
    }
    me bool: memberSequence(our WorldFrame: frame) <- {
        return(frame!.expressionSlot==2 and frame!.facts.overlay==LST and
            frame!.node!.pItem!.value!.evalMode==emLiteral)
    }
    me bool: representableFacts(me WorldScalar: facts) <- {
        return(facts.outcome==worldReady and facts.representable and facts.pendingChecks==NULL)
    }
    me bool: completeFacts(me WorldScalar: facts, me bool: requireSize) <- {
        return(facts.declaration!=NULL or (facts.terminalValue!=0 and facts.outcome==worldReady) or (facts.outcome==worldReady and facts.pendingChecks==NULL and !facts.negative and !openLayout(facts) and facts.hasValue and facts.contentsComplete and
            ((!requireSize and facts.overlay==NUM) or facts.hasSize) and
            (facts.overlay!=LST or facts.size==FlexNum(sequenceLength(facts.sequence)))))
    }
    me WorldScalar: read(our WorldRequest: request, our POV: node, their POV: expressionParent <- NULL, me bool: bodyInput <- false, me bool: selection <- false, me bool: predicate <- false) <- {
        me WorldScalar: facts
        if(node==NULL or node!.pItem==NULL){
            facts.outcome <- worldError; facts.detail <- "Missing target POV"; return(facts)
        }
        if((node!.pParent!=NULL and node!.pParent!==expressionParent) or node!.viewMap.sourcePov!=NULL or node!.referenceAlias.sourcePov!=NULL){
            facts.outcome <- worldUnsupported; facts.detail <- "Contextual member access needs list correspondence"; return(facts)
        }
        our infonView: item <- node!.pItem
        if(request!.edits.containsKey(item)){return(request!.edits.at(item)!.facts)}
        if(item!.graphParseError!=""){
            facts.outcome <- worldError; facts.detail <- item!.graphParseError; return(facts)
        }
        if(item!.streamState==parseStarted or item!.streamState==parseListReady){
            facts.outcome <- worldWaiting; facts.detail <- "Scalar input is still being parsed"; return(facts)
        }
        if(item!.value==NULL or item!.infSize==NULL){
            facts.outcome <- worldError; facts.detail <- "Missing scalar state"; return(facts)
        }
        if(item!.itmMode==mWordDefn and item!.definedWord!=NULL and item!.funcArgs!=NULL){
            // A declaration contributes a meaning; evaluating its body is a
            // separate demand. Staging makes it visible to subsequent siblings.
            if(item!.type!=NULL or !item!.wrkList.isEmpty() or !item!.parts.isEmpty() or item!.partRef!=NULL or
               item!.innr!=NULL or item!.invertMatch or item!.doReply){
                facts.outcome <- worldUnsupported; facts.detail <- "Declaration has additional obligations"; return(facts)
            }
            facts.declaration <- item!.definedWord
            return(facts)
        }
        if((!item!.wordDerefed and !item!.addedTypes.isEmpty() and (item!.type!=NULL or item!.addedTypes.size()!=1)) or item!.viewMode==vmCursor or
           (item!.innr!=NULL and !selection) or (item!.funcArgs!=NULL and !bodyInput and (item!.argPos==apNoArgs or
            !((item!.value!.overlayType==LST and item!.value!.evalMode==emLiteral) or
              (item!.type!=NULL and item!.value!.evalMode==emUnknown)))) or
           !item!.parts.isEmpty() or item!.partRef!=NULL or item!.proxy!=NULL or
           item!.doReply or (item!.itmMode!=mItem and item!.itmMode!=mNone) or (item!.identityName!=NULL and !item!.isNull()) or
           item!.independentTemporalValue or item!.temporalValueSource!=NULL or item!.temporalPredecessor!=NULL){
            facts.outcome <- worldUnsupported
            facts.detail <- "This request needs semantics beyond the scalar milestone"; return(facts)
        }
        facts <- bind(request, facts, item!.type)
        if(item!.type==NULL and !item!.addedTypes.isEmpty()){
            facts <- bind(request, facts, item!.addedTypes[0]); facts.inheritedName <- true
        }
        withEach word in item!.addedTypes{
            me WorldScalar: binding; binding <- bind(request, binding, word)
            if(binding.outcome!=worldReady){return(binding)}
            addNominal(facts, binding.nominal)
        }
        facts.meaningApplied <- item!.wordDerefed
        if(facts.outcome!=worldReady or selection){return(facts)}
        me bool: expression <- item!.value!.evalMode==emConcat
        if(item!.isNull() or item!.value!.undefined){
            if(item!.invertMatch or facts.nominal!=NULL){facts.outcome <- worldUnsupported; facts.detail <- "Qualified terminal value needs predicate proof"; return(facts)}
            facts.terminalValue <- 2
            if(item!.isNull()){facts.terminalValue <- 1; facts.identity <- item!.identityName; facts.boundary <- node}
            facts.hasValue <- true; facts.hasSize <- true
            return(facts)
        }
        if(!expression and item!.value!.overlayType==LST and
           (item!.value!.evalMode!=emLiteral or
            (item!.invertMatch and !predicate))){
            facts.outcome <- worldUnsupported; facts.detail <- "List needs correspondence or template semantics"; return(facts)
        }
        if(item!.value!.evalMode==emIntersection or
           item!.value!.undefined or (item!.value!.inverted and (expression or item!.value!.overlayType!=NUM)) or
           item!.infSize!.undefined or item!.infSize!.inverted or
           !((item!.infSize!.overlayType==NUM and
              (item!.infSize!.evalMode==emUnknown or item!.infSize!.evalMode==emLiteral)) or
             scalarExpression(item!.infSize))){
            facts.outcome <- worldUnsupported; facts.detail <- "Nonliteral scalar or size"; return(facts)
        }
        facts.hasSize <- item!.infSize!.evalMode==emLiteral
        facts.size <- item!.infSize!.num
        facts.explicitSize <- item!.value!.sizeMode==fromGiven
        if(facts.hasSize and facts.size.getDenominator()==0){
            facts.outcome <- worldError; facts.detail <- "Numeric size has a zero denominator"; return(facts)
        }
        if(facts.hasSize){facts.size.normalize()}
        if(expression){
            if(!scalarExpression(item!.value)){
                facts.outcome <- worldUnsupported; facts.detail <- "Non-scalar expression template"
            }
            return(facts)
        }
        if(item!.value!.overlayType!=tUnknown and item!.value!.overlayType!=tUnset){facts.overlay <- item!.value!.overlayType}
        facts.hasValue <- item!.value!.evalMode==emLiteral
        if(facts.hasValue and facts.overlay!=NUM and facts.overlay!=STR and facts.overlay!=LST){
            facts.outcome <- worldUnsupported; facts.detail <- "Non-scalar literal"; return(facts)
        }
        facts.number <- item!.value!.num
        if(item!.value!.inverted){facts.number <- -facts.number}
        if((facts.hasValue and facts.overlay==NUM and facts.number.getDenominator()==0) or
           (facts.hasSize and facts.size.getDenominator()==0)){
            facts.outcome <- worldError; facts.detail <- "Numeric literal has a zero denominator"; return(facts)
        }
        if(facts.hasValue and facts.overlay==NUM){facts.number.normalize()}
        if(facts.hasSize){facts.size.normalize()}
        if(facts.hasValue and facts.overlay==STR){
            Allocate(facts.textSource); facts.textSource!.source <- item!.value
            facts.textLength <- item!.value!.str.size()
        }
        facts.order <- item!.orderMode; facts.timelike <- item!.value!.timelike
        if(facts.overlay==LST and facts.order==uUnordered and !facts.explicitSize){facts.hasSize <- false}
        facts.openTail <- facts.overlay==LST and item!.value!.tailUnfinished
        facts.negative <- item!.invertMatch
        facts.extentApplied <- item!.value!.numericExtentApplied
        facts.applyExtent()
        return(facts)
    }

    our WorldPosition: position(our POV: node, our WorldPosition: parent <- NULL) <- {
        our WorldPosition:: result; result!.node <- node; result!.owner <- node; result!.parent <- parent; result!.occurrence <- node; result!.embedded <- node!.isSubItm; if(parent!=NULL){result!.writable <- parent!.writable} return(result)
    }
    // Lower a proved source boundary to the same symbolic prefix used by
    // span correspondence. The borrowed body and marked member stay intact.
    our WorldPosition: offsetDomain(our WorldPosition: domain, me FlexNum: boundary) <- {
        our infonView:: prefix
        prefix!.itmMode <- mItem; prefix!.streamState <- parseDone; prefix!.viewMode <- vmOverlay
        prefix!.value!.overlayType <- LST; prefix!.value!.evalMode <- emLiteral
        prefix!.value!.tailUnfinished <- true; prefix!.value!.sizeMode <- fromGiven
        prefix!.infSize!.overlayType <- NUM; prefix!.infSize!.evalMode <- emLiteral; prefix!.infSize!.num <- boundary
        our infonView: body <- pathBody(domain!.node!.pItem, false); body!.funcArgs <- NULL
        Allocate(body!.infSize); body!.infSize!.overlayType <- NUM; body!.infSize!.evalMode <- emUnknown
        our POV:: wrapper{940}; Allocate(wrapper!.pItem)
        wrapper!.pItem!.itmMode <- mItem; wrapper!.pItem!.streamState <- parseDone
        wrapper!.pItem!.value!.overlayType <- LST; wrapper!.pItem!.value!.evalMode <- emLiteral
        wrapper!.pItem!.infSize!.overlayType <- NUM; wrapper!.pItem!.infSize!.evalMode <- emUnknown
        wrapper!.pItem!.value!.items.append(prefix, true, 940)
        wrapper!.pItem!.value!.items.append(body, true, 940)
        our WorldPosition: result <- position(wrapper)
        result!.input <- domain!.input; result!.inputContext <- domain!.inputContext
        return(result)
    }
    our WorldPosition: occurrencePath(our POV: node) <- {
        our WorldPosition: result <- position(node)
        our WorldPosition: at <- result
        their POV: parent <- node!.pParent
        me Set<their POV>: seen
        seen.insert(result!.occurrence)
        while(parent!=NULL){
            if(seen.contains(parent)){return(NULL)}
            seen.insert(parent)
            me bool: contained <- false
            our POV: child <- parent!.pItem!.value!.items.head
            while(child!=NULL){
                if(child===at!.occurrence){contained <- true; break()}
                child <- child!.next
            }
            if(!contained){return(NULL)}
            our POV:: borrowed{936}; borrowed! <- parent!
            at!.parent <- position(borrowed); at <- at!.parent; at!.occurrence <- parent
            parent <- parent!.pParent
        }
        return(result)
    }
    me bool: samePosition(our WorldPosition: left, our WorldPosition: right) <- {
        while(left!=NULL and right!=NULL){
            if(left===right){return(true)}
            if(left!.occurrence!==right!.occurrence){return(false)}
            left <- left!.parent; right <- right!.parent
        }
        return(left==NULL and right==NULL)
    }
    our POV: memberRelationship(our POV: parent) <- {
        our POV:: result{937}; result! <- parent!
        result!.looseTop <- false; result!.looseInhtd <- parent!.looseMode or parent!.looseInhtd
        result!.pParent <- NULL
        return(result)
    }
    me bool: typePredicate(me WorldScalar: facts) <- {
        return(facts.outcome==worldReady and facts.pendingChecks==NULL and !facts.hasValue and
               !facts.hasSize and !facts.hasRange and (facts.overlay>=0 or (facts.nominal!=NULL)))
    }
    me bool: projectionTemplate(our infonView: item) <- {
        return(item!=NULL and item!.value!=NULL and item!.innr!=NULL and item!.value!.evalMode==emIntersection and !item!.isOrLike())
    }
    me bool: rangePredicate(me WorldScalar: facts) <- {
        return(facts.overlay==NUM and (facts.hasRange or (!facts.hasValue and facts.hasSize)))
    }
    me WorldScalar: matchPosition(me WorldScalar: predicate, me WorldScalar: candidate, our POV: edge, me bool: proof <- false) <- {
        if(predicate.outcome!=worldReady){return(predicate)}
        if(candidate.outcome!=worldReady){return(candidate)}
        if(predicate.pendingChecks!=NULL or candidate.pendingChecks!=NULL){
            predicate.outcome <- worldPartial; predicate.detail <- "Correspondence predicate still needs evidence"; return(predicate)
        }
        if(proof and (candidate.negative or edge!.looseType())){
            predicate.outcome <- worldUnsupported; predicate.detail <- "Repeated predicate needs additional comparison semantics"; return(predicate)
        }
        // Selection tests a value domain, independently of its representation's
        // endpoint. A proved exclusion supplies the candidate, not its negation.
        if(!proof and !edge!.looseType() and !candidate.negative and
           (predicate.negative or rangePredicate(predicate) or typePredicate(predicate))){
            me WorldOutcome: compared <- compare(predicate, candidate)
            if(predicate.negative){
                if(compared==worldReady){compared <- worldRejected}
                else if(compared==worldRejected){compared <- worldReady}
            }
            me WorldScalar: result <- candidate
            if(!predicate.negative and predicate.nominal!=NULL and (candidate.nominal==NULL or candidate.inheritedName)){
                result.nominal <- predicate.nominal; result.inheritedName <- predicate.inheritedName
                addNominal(result, candidate.nominal)
            }
            result.outcome <- compared; result.detail <- "Correspondence predicate comparison"
            if(!predicate.negative and predicate.hasSize){result.hasSize <- true; result.size <- predicate.size}
            return(result)
        }
        // A repeated predicate requires proof, not a compatible substitution.
        // A type predicate needs only the candidate's type. In particular,
        // excluding strings does not require evaluating a list's contents.
        if((proof or typePredicate(predicate) or (predicate.overlay==LST and predicate.hasValue)) and
           !edge!.looseType() and !candidate.negative){
            me WorldOutcome: compared <- compare(predicate, candidate)
            if(predicate.negative){
                if(compared==worldReady){compared <- worldRejected}
                else if(compared==worldRejected){compared <- worldReady}
            }
            predicate.outcome <- compared; predicate.detail <- "Correspondence predicate comparison"
            return(predicate)
        }
        return(merge(predicate, candidate, edge))
    }
    // Only list extents count as member widths. Explicit nonempty extents
    // require layout checking; an empty open span itself proves its width.
    me bool: skippableWidth(me WorldScalar: header, our POV: node) <- {
        return(header.outcome==worldReady and header.overlay==LST and header.hasValue and
            header.hasSize and header.size>=0 and header.size.getDenominator()==1 and node!.pItem!.wrkList.isEmpty() and
            (!header.explicitSize or (header.openTail and node!.pItem!.value!.items.head==NULL)))
    }
    me bool: enterLayout(our WorldRequest: request, our WorldWalk: walk) <- {
        walk!.outcome <- worldReady; walk!.waiting <- NULL
        while(!walk!.levels.isEmpty()){
            our WorldWalkLevel: level <- walk!.levels.last()
            if(level!.entered){return(true)}
            our POV: node <- level!.position!.node
            if(node!.pItem!.viewMode==vmCursor or node!.pItem!.partRef!=NULL or !node!.pItem!.parts.isEmpty()){
                walk!.requestedLayout <- level!.position
                walk!.outcome <- worldPartial; walk!.detail <- "List layout needs the selected path occurrence"; return(false)
            }
            me WorldScalar: header <- read(request, node, node!.pParent, level!.position!.input!=NULL)
            if(header.outcome!=worldReady){
                walk!.outcome <- header.outcome; walk!.detail <- header.detail
                if(header.outcome==worldWaiting){walk!.waiting <- node!.pItem}
                return(false)
            }
            if(header.overlay<0 and !header.hasValue and !header.hasSize and !header.negative and header.nominal!=NULL and
               header.nominal!.defToUse!=NULL and node!.pItem!.wrkList.isEmpty()){
                our infonView: meaning <- header.nominal!.defToUse
                if(walk!.activeLayouts.contains(meaning)){
                    walk!.outcome <- worldUnsupported; walk!.detail <- "Cyclic named list layout"; return(false)
                }
                walk!.activeLayouts.insert(node!.pItem); level!.namedLayouts.append(node!.pItem)
                request!.namedLayouts <+- 1
                // Keep the use's occurrence identity and ancestry while
                // borrowing the definition's physical member layout.
                our POV:: layout{939}; layout!.pItem <- meaning; layout!.isSubItm <- node!.isSubItm
                our WorldPosition: expanded <- position(layout, level!.position!.parent)
                expanded!.owner <- level!.position!.owner; expanded!.occurrence <- level!.position!.occurrence; expanded!.embedded <- level!.position!.embedded
                expanded!.writable <- false
                level!.position <- expanded
                continue()
            }
            // A supplied representation is not yet the declared member
            // layout of a named template (for example, seconds vs minutes).
            // Indexing it requires that correspondence, not a physical index.
            if(!walk!.rawLayout and header.overlay==LST and header.hasValue and !header.meaningApplied and
               header.nominal!=NULL and header.nominal!.defToUse!=NULL){
                our infonView: meaning <- header.nominal!.defToUse
                if(meaning!.streamState==parseStarted or meaning!.streamState==parseListReady){
                    walk!.outcome <- worldWaiting; walk!.waiting <- meaning
                    walk!.detail <- "Named list layout is still being parsed"; return(false)
                }
                if(meaning!.value!=NULL and meaning!.value!.listSpec!=NULL){
                    walk!.outcome <- worldUnsupported; walk!.detail <- "Named list layout needs template correspondence"; return(false)
                }
            }
            level!.concatenated <- scalarExpression(node!.pItem!.value)
            if(!level!.concatenated and header.overlay==LST and header.hasValue){walk!.listTypeProved <- true}
            if(!level!.concatenated and (header.overlay!=LST or !header.hasValue)){
                walk!.outcome <- worldUnsupported; walk!.detail <- "Correspondence needs a list layout"; return(false)
            }
            // A nested layout's own constraints can change its extent.
            if(walk!.requireClosedRelations and (!node!.pItem!.wrkList.isEmpty() or node!.pItem!.argPos!=apNoArgs)){
                walk!.outcome <- worldUnsupported; walk!.detail <- "Embedded layout has unresolved relationships"; return(false)
            }
            if(walk!.checkExtents and header.hasSize){
                me FlexNum: limit <- walk!.position+header.size
                level!.hasExtent <- true; level!.end <- limit
                if(!level!.hasLimit or limit<level!.limit){level!.hasLimit <- true; level!.limit <- limit}
            }
            walk!.activeLayouts.insert(node!.pItem)
            request!.correspondencePositions <+- 1
            level!.entered <- true; level!.next <- node!.pItem!.value!.items.head
            return(true)
        }
        return(true)
    }
    // Read structural positions without evaluating sibling values. An open
    // remainder is one symbolic event, never an instruction to enumerate it.
    our WorldPosition: nextPosition(our WorldRequest: request, our WorldWalk: walk) <- {
        walk!.outcome <- worldReady; walk!.waiting <- NULL
        while(!walk!.levels.isEmpty()){
            our WorldWalkLevel: level <- walk!.levels.last()
            our POV: node <- level!.position!.node
            if(!enterLayout(request, walk)){return(NULL)}
            node <- level!.position!.node
            if(level!.next!=NULL){
                our POV: member <- level!.next
                our WorldPosition: result <- position(member, level!.position)
                result!.embedded <- result!.embedded or level!.concatenated
                if(result!.embedded and walk!.stopIndex>0 and member!.pItem!.partRef==NULL and member!.pItem!.parts.isEmpty()){
                    me WorldScalar: header <- read(request, member, member!.pParent)
                    if(header.outcome!=worldReady){
                        walk!.outcome <- header.outcome; walk!.detail <- header.detail
                        if(header.outcome==worldWaiting){walk!.waiting <- member!.pItem}
                        return(NULL)
                    }
                    if(skippableWidth(header, member) and walk!.position+header.size<walk!.stopIndex){
                        if(level!.hasLimit and walk!.position+header.size>level!.limit){
                            walk!.outcome <- worldPartial; walk!.detail <- "Correspondence exceeds a known source endpoint"; return(NULL)
                        }
                        walk!.position <+- header.size; level!.next <- member!.next
                        request!.correspondencePositions <+- 1; continue()
                    }
                }
                level!.next <- member!.next; request!.correspondencePositions <+- 1
                if(result!.embedded and walk!.activeLayouts.contains(member!.pItem)){
                    walk!.outcome <- worldUnsupported; walk!.detail <- "Cyclic list layout"; return(NULL)
                }
                if(member===walk!.stopAt or (walk!.shallow and result!.embedded)){return(result)}
                if(result!.embedded){
                    walk!.push(result)
                }else{
                    if(walk!.checkExtents and level!.hasLimit and walk!.position>=level!.limit){
                        walk!.outcome <- worldPartial; walk!.detail <- "Correspondence exceeds a known source endpoint"; return(NULL)
                    }
                    walk!.position <+- 1; return(result)
                }
            }else if(!level!.tailRead and node!.pItem!.value!.tailUnfinished){
                level!.tailRead <- true
                our WorldPosition: result <- position(node, level!.position!.parent)
                result!.tail <- true; return(result)
            }else{
                if(walk!.checkExtents and level!.hasExtent and walk!.position!=level!.end){
                    walk!.outcome <- worldPartial; walk!.detail <- "Source layout does not reach its known endpoint"; return(NULL)
                }
                withEach named in level!.namedLayouts{walk!.activeLayouts.erase(named)}
                walk!.activeLayouts.erase(node!.pItem); walk!.levels.popLast()
            }
        }
        return(NULL)
    }

    // The cursor is retained in the frame; ordinary arrival never rewinds it.
    our POV: nextRelationship(our WorldRequest: request, our WorldFrame: frame) <- {
        frame!.sourceIsListSpec <- false; frame!.sourceNameInherited <- false
        if(frame!.facts.declaration!=NULL){return(NULL)}
        while(frame!.expressionSlot<3){
            if(frame!.nextOperand!=NULL){
                our POV: operand <- frame!.nextOperand
                if(operand!.prev!==frame!.priorOperand){
                    frame!.facts.outcome <- worldError; frame!.facts.detail <- "Broken expression operand chain"; return(NULL)
                }
                if(operand!.isSubItm and !memberSequence(frame)){
                    frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Sublist expression operand"; return(NULL)
                }
                frame!.priorOperand <- operand; frame!.nextOperand <- operand!.next
                frame!.sourceIsOperand <- true; return(operand)
            }
            if(frame!.operandsRead>0 or memberSequence(frame)){finishExpression(frame)}
            if(frame!.facts.outcome!=worldReady){return(NULL)}
            frame!.expressionSlot <+- 1
            frame!.operandsRead <- 0; frame!.priorOperand <- NULL
            our infonState: slot
            if(frame!.expressionSlot==1){slot <- frame!.node!.pItem!.infSize}
            else if(frame!.expressionSlot==2){slot <- frame!.node!.pItem!.value}
            if(slot!=NULL and (slot!.evalMode==emConcat or memberSequence(frame))){
                frame!.nextOperand <- slot!.items.head
                // A finite template is read once, then projected into each member.
                // Empty closed lists need no template evaluation.
                if(memberSequence(frame) and slot!.listSpec!=NULL and
                   (frame!.nextOperand!=NULL or (frame!.facts.openTail and !(frame!.facts.hasSize and frame!.facts.size==0)))){
                    Allocate(frame!.listSpecEdge, 934); frame!.listSpecEdge!.pItem <- slot!.listSpec
                    frame!.sourceIsOperand <- false; frame!.sourceIsListSpec <- true
                    return(frame!.listSpecEdge)
                }
            }
        }
        frame!.sourceIsOperand <- false
        our infonView: item <- frame!.node!.pItem
        // Member constraints must be settled before this list's own identities.
        if((!item!.wrkList.isEmpty() or item!.argPos!=apNoArgs) and needsRequirements(frame)){return(NULL)}
        me bool: needsTemplate <- ((frame!.nextWork<item!.wrkList.size() and
            item!.wrkList[frame!.nextWork]!=NULL and item!.wrkList[frame!.nextWork]!.looseType()) or item!.argPos!=apNoArgs) and !frame!.facts.hasValue and
            frame!.facts.nominal!=NULL and frame!.facts.nominal!.defToUse!=NULL and !frame!.meaningRequested
        if(!needsTemplate and frame!.nextWork>=item!.wrkList.size() and frame!.argumentEdge==NULL){
            frame!.argumentEdge <- argumentRelation(item, frame!.facts)
            if(frame!.argumentEdge!=NULL){return(frame!.argumentEdge)}
        }
        if(needsTemplate or frame!.nextWork>=item!.wrkList.size()){
            if(frame!.referenceOnly or (frame!.acquireOnly and (frame!.facts.hasValue or frame!.parentContext!=NULL))){return(NULL)}
            if(frame!.meaningRequested or frame!.facts.nominal==NULL or frame!.facts.meaningApplied or
               (frame!.predicateOnly and typePredicate(frame!.facts))){return(NULL)}
            frame!.meaningRequested <- true
            if(frame!.facts.nominal!.defToUse==NULL){
                if(!frame!.facts.hasValue and frame!.facts.overlay<0 and frame!.context==NULL and frame!.expressionParent==NULL and !frame!.predicateOnly and !frame!.acquireOnly){frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Named value has no available definition"}
                return(NULL)
            }
            if(frame!.facts.nominal!.defToUse===item and frame!.facts.hasValue){frame!.facts.meaningApplied <- true; return(NULL)}
            request!.meaningEdges <+- 1
            our POV:: meaning{939}; meaning!.pItem <- frame!.facts.nominal!.defToUse; meaning!.trueByDefinition <- true
            return(meaning)
        }
        our POV: edge <- item!.wrkList[frame!.nextWork]
        frame!.nextWork <+- 1
        if(edge==NULL){frame!.facts.outcome <- worldError; frame!.facts.detail <- "Empty relationship"}
        return(edge)
    }

    // These are value operations over already resolved operand facts, not
    // identity links. No operand is copied into or normalized on the model.
    me WorldScalar: appendNumber(me WorldScalar: left, me WorldScalar: right, me bool: additive) <- {
        if(left.overlay!=NUM or right.overlay!=NUM or left.negative or right.negative){
            left.outcome <- worldUnsupported; left.detail <- "Numeric expression needs positive numeric operands"; return(left)
        }
        if(!right.hasValue){left.outcome <- worldPartial; left.detail <- "Expression operand value is unknown"; return(left)}
        if(additive){
            me WorldBounds: result <- left.bounds()
            if(!result.bounded){left.outcome <- worldPartial; left.detail <- "Additive input has no finite value bounds"; return(left)}
            if(result.empty()){left.outcome <- worldRejected; left.detail <- "Empty numeric range"; return(left)}
            result.low <+- right.number; result.high <+- right.number
            left.useBounds(result)
            if(left.hasRange){left.hasSize <- false; left.explicitSize <- false}
        }else{
            if(!left.hasValue or !right.hasSize or right.size<0){
                left.outcome <- worldPartial; left.detail <- "Numeric concatenation needs a value and radix"; return(left)
            }
            left.number <- left.number*right.size + right.number
            if(left.hasSize){left.size <- left.size*right.size}
        }
        return(left)
    }

    me WorldScalar: appendOperand(me WorldScalar: left, me WorldScalar: right, me bool: additive) <- {
        if(left.nominal!=NULL or right.nominal!=NULL){
            left.outcome <- worldUnsupported; left.detail <- "Nominal expression needs type rules"; return(left)
        }
        if(left.overlay<0 or right.overlay<0){
            left.outcome <- worldPartial; left.detail <- "Expression operand type is unknown"; return(left)
        }
        if(left.overlay==NUM and right.overlay==NUM){return(appendNumber(left, right, additive))}
        if(left.overlay==LST and right.overlay==LST and !left.negative and !right.negative){
            if(openLayout(left) or openLayout(right)){
                left.outcome <- worldUnsupported; left.detail <- "Open list concatenation needs span alignment"; return(left)
            }
            if((left.hasSize and left.size!=FlexNum(sequenceLength(left.sequence))) or
               (right.hasSize and right.size!=FlexNum(sequenceLength(right.sequence)))){
                left.outcome <- worldPartial; left.detail <- "List operand endpoint needs span alignment"; return(left)
            }
            if(sequenceLength(right.sequence)>9223372036854775807-sequenceLength(left.sequence)){
                left.outcome <- worldError; left.detail <- "List expression exceeds representable length"; return(left)
            }
            left.sequence <- join(left.sequence, right.sequence)
            left.contentsComplete <- left.contentsComplete and right.contentsComplete
            left.representable <- left.representable and right.representable
            if(left.hasSize and right.hasSize){left.size <+- right.size}else{left.hasSize <- false}
            return(left)
        }
        if(left.overlay!=STR or right.overlay!=STR or left.negative or right.negative){
            left.outcome <- worldUnsupported; left.detail <- "Mixed or negative expression operands"; return(left)
        }
        if(!left.hasValue or !right.hasValue){
            left.outcome <- worldPartial; left.detail <- "String expression operand value is unknown"; return(left)
        }
        if(right.textLength>9223372036854775807-left.textLength){
            left.outcome <- worldError; left.detail <- "String expression exceeds representable length"; return(left)
        }
        our WorldText:: joined
        joined!.left <- left.textSource; joined!.right <- right.textSource
        joined!.leftLength <- left.textLength
        left.textSource <- joined; left.textLength <+- right.textLength
        return(left)
    }

    void: finishExpression(our WorldFrame: frame) <- {
        if(memberSequence(frame)){
            if(frame!.facts.order==uUnordered and frame!.facts.hasSize and frame!.facts.size<FlexNum(frame!.operandsRead)){
                frame!.facts.outcome <- worldRejected; frame!.facts.detail <- "Unordered members exceed the given extent"; return()
            }
            if(frame!.facts.openTail and (frame!.facts.sequence==NULL or !frame!.facts.sequence!.hasSpans) and frame!.facts.hasSize and frame!.facts.size==FlexNum(frame!.operandsRead)){
                frame!.facts.openTail <- false
            }
            if(!openLayout(frame!.facts) and frame!.facts.order!=uUnordered and !frame!.facts.hasSize and !frame!.facts.explicitSize){
                frame!.facts.hasSize <- true; frame!.facts.size <- frame!.operandsRead
            }
            frame!.facts.dischargeListSpec <- frame!.facts.representable and !openLayout(frame!.facts)
            return()
        }
        me WorldScalar: expression <- frame!.expression
        if(frame!.expressionSlot==1){
            // The operand's value supplies the owner's size, not its type,
            // radix or range width. Unsupported extents remain expressed.
            if(expression.overlay!=NUM or expression.negative or !expression.hasValue or
               expression.number<0 or expression.number.getDenominator()!=1){
                frame!.facts.outcome <- worldPartial
                frame!.facts.detail <- "Computed size needs a nonnegative whole numeric value"; return()
            }
            frame!.facts.hasSize <- true; frame!.facts.size <- expression.number
            frame!.facts.applyExtent()
            return()
        }
        if(expression.overlay==LST){
            if(!expression.representable){
                frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "List expression still has unresolved member work"; return()
            }
            expression.explicitSize <- frame!.facts.explicitSize or !expression.hasSize
        }
        if(expression.overlay==STR and expression.hasValue and !expression.negative){
            // The expression counts its represented bytes, independently of
            // the operands' declared or unknown endpoints.
            expression.hasSize <- true; expression.size <- expression.textLength
            expression.explicitSize <- frame!.facts.explicitSize
        }
        if(expression.hasRange){
            // A range's width describes possible values, not its outer size.
            if(expression.hasSize and frame!.facts.hasSize and expression.size!=frame!.facts.size){
                frame!.facts.outcome <- worldRejected; frame!.facts.detail <- "Incompatible expression sizes"; return()
            }
            if(frame!.facts.hasSize){expression.hasSize <- true; expression.size <- frame!.facts.size}
            expression.explicitSize <- expression.explicitSize or frame!.facts.explicitSize
            expression.qualifications <- frame!.facts.qualifications
            expression.nominal <- frame!.facts.nominal; expression.inheritedName <- frame!.facts.inheritedName; expression.meaningApplied <- frame!.facts.meaningApplied
            frame!.facts <- expression; frame!.bodyBounds <- expression.bounds()
            frame!.bodyHasSize <- expression.hasSize; frame!.bodySize <- expression.size
        }else{
            if(frame!.operandsRead>1 and expression.overlay==NUM){
                expression.extentApplied <- expression.hasSize
                expression.explicitSize <- expression.hasSize or frame!.facts.explicitSize
            }
            frame!.facts <- merge(frame!.facts, expression, frame!.node!.pItem!.value!.items.head)
        }
        // Negation applies to the computed predicate, not to its operands.
        frame!.facts.negative <- frame!.node!.pItem!.invertMatch
    }

    // Compare the represented text, which can be a prefix borrowed from a
    // larger source. Intermediate frames never allocate substrings.
    me bool: sameText(me WorldScalar: left, me WorldScalar: right, me bool: prefix) <- {
        if(!prefix and left.textLength!=right.textLength){return(false)}
        me int64: length <- min(left.textLength, right.textLength)
        me WorldTextCursor: lhs; lhs.push(left.textSource, length)
        me WorldTextCursor: rhs; rhs.push(right.textSource, length)
        withEach pos in range 0 .. length{if(lhs.next()!=rhs.next()){return(false)}}
        return(true)
    }

    // Prove whether every supplied fact matches a positive scalar template.
    // Ready=yes, Rejected=no, Partial=not enough evidence. Work only on local
    // facts: a negative template must not acquire its candidate's size/value.
    me WorldOutcome: compare(me WorldScalar: required, me WorldScalar: actual) <- {
        if(required.terminalValue!=0 or actual.terminalValue!=0){
            if(required.terminalValue!=actual.terminalValue){
                if(required.hasValue or required.overlay>=0 or (required.hasSize and required.size!=0)){return(worldRejected)}
                if(required.nominal!=NULL){return(worldPartial)}
                return(worldReady)
            }
            if(required.identity!=NULL and required.identity!==actual.identity){return(worldPartial)}
            return(worldReady)
        }
        if(actual.declaration!=NULL){return(worldRejected)}
        me WorldOutcome: nominal <- compareNames(required, actual)
        if(nominal==worldRejected){return(nominal)}
        if(required.overlay>=0 and actual.overlay>=0 and required.overlay!=actual.overlay){return(worldRejected)}
        if(rangePredicate(required)){
            if(actual.overlay!=NUM){return(worldPartial)}
            me WorldBounds: expected <- required.bounds(); me WorldBounds: supplied <- actual.bounds()
            if(expected.empty() or supplied.empty() or expected.intersect(supplied).empty()){return(worldRejected)}
            if(expected.contains(supplied)){return(nominal)}
            return(worldPartial)
        }
        if(required.hasSize and actual.hasSize and required.size!=actual.size){return(worldRejected)}
        me bool: covered <- nominal==worldReady and (required.overlay<0 or actual.overlay>=0) and
            (!required.hasSize or actual.hasSize) and (!required.hasValue or actual.hasValue)
        if(required.hasValue and actual.hasValue){
            if(required.overlay==LST){
                if((required.order==uUnordered or actual.order==uUnordered) and namedFields(required) and namedFields(actual)){
                    me Map<string, our WorldFrame>: fields
                    me WorldListCursor: supplied; supplied.push(actual.sequence)
                    our WorldFrame: member <- supplied.next()
                    while(member!=NULL){
                        me string: key <- member!.facts.nominal!.typeID()
                        if(fields.containsKey(key)){return(worldPartial)}
                        fields.insert(key, member); member <- supplied.next()
                    }
                    me WorldListCursor: wanted; wanted.push(required.sequence)
                    member <- wanted.next()
                    me Set<string>: seen
                    while(member!=NULL){
                        me string: key <- member!.facts.nominal!.typeID()
                        if(seen.contains(key) or !fields.containsKey(key)){return(worldPartial)}
                        seen.insert(key)
                        me WorldOutcome: match <- compare(member!.facts, fields.at(key)!.facts)
                        if(match==worldRejected){return(match)}
                        if(match!=worldReady){covered <- false}
                        member <- wanted.next()
                    }
                    if(required.hasSize and fields.size()!=seen.size()){return(worldRejected)}
                    if(covered){return(worldReady)}else{return(worldPartial)}
                }
                if(openLayout(required) or openLayout(actual)){return(worldPartial)}
                me WorldListCursor: left; left.push(required.sequence)
                me WorldListCursor: right; right.push(actual.sequence)
                our WorldFrame: lhs <- left.next(); our WorldFrame: rhs <- right.next()
                me bool: pending <- false
                while(lhs!=NULL and rhs!=NULL){
                    if(lhs!.facts.pendingChecks!=NULL or rhs!.facts.pendingChecks!=NULL or rhs!.facts.negative){pending <- true}
                    else{
                        me WorldOutcome: compared <- compare(lhs!.facts, rhs!.facts)
                        if(lhs!.facts.negative){
                            if(compared==worldReady){compared <- worldRejected}
                            else if(compared==worldRejected){compared <- worldReady}
                        }
                        if(compared==worldRejected){return(compared)}
                        if(compared!=worldReady){pending <- true}
                    }
                    lhs <- left.next(); rhs <- right.next()
                }
                if(lhs!=NULL or rhs!=NULL){return(worldRejected)}
                if(pending){return(worldPartial)}
            }else if(required.overlay==NUM){
                if(!required.hasSize and !actual.hasSize and required.number!=actual.number and
                   ((required.number<0 and !required.extentApplied)!=(actual.number<0 and !actual.extentApplied))){return(worldPartial)}
                if(!required.hasSize and actual.hasSize){required.hasSize <- true; required.size <- actual.size}
                if(!actual.hasSize and required.hasSize){actual.hasSize <- true; actual.size <- required.size}
                required.applyExtent(); actual.applyExtent()
                if(required.number!=actual.number){return(worldRejected)}
            }else if(!sameText(required, actual, false)){return(worldRejected)}
        }
        if(!covered){return(worldPartial)}
        return(worldReady)
    }

    me WorldScalar: mergeText(me WorldScalar: left, me WorldScalar: right, me bool: prefix) <- {
        if(left.hasValue){
            if(!sameText(left, right, prefix)){
                left.outcome <- worldRejected; left.detail <- "Incompatible string values"; return(left)
            }
        }else{
            me int64: width <- right.textLength
            if(left.hasSize){
                // Bound the exact integer before converting it to an index.
                if(left.size<0 or left.size.getDenominator()!=1 or left.size>width or
                   (!prefix and left.size!=width)){
                    left.outcome <- worldPartial; left.detail <- "String width is not supplied by the available text"; return(left)
                }
                width <- left.size.getNumerator().convertToIntVal()
            }
            left.hasValue <- true; left.textSource <- right.textSource; left.textLength <- width
            left.explicitSize <- !(left.hasSize or (!prefix and right.hasSize))
        }
        left.overlay <- STR
        if(!prefix and !left.hasSize and right.hasSize){left.hasSize <- true; left.size <- right.size}
        return(left)
    }

    me WorldScalar: mergeRanges(me WorldScalar: left, me WorldScalar: right, our POV: edge) <- {
        if(!edge!.looseType()){
            // Strict identity shares an endpoint; comparison may use it locally.
            if(!left.hasSize and right.hasSize){left.hasSize <- true; left.size <- right.size}
            if(!right.hasSize and left.hasSize){right.hasSize <- true; right.size <- left.size}
            left.applyExtent(); right.applyExtent()
        }
        me WorldBounds: required <- left.bounds()
        me WorldBounds: supplied <- right.bounds()
        me WorldBounds: result <- required.intersect(supplied)
        if(edge!.looseType() and !right.hasValue and !right.hasRange){result <- required}
        if(required.empty() or supplied.empty() or result.empty()){
            left.outcome <- worldRejected; left.detail <- "Disjoint numeric value ranges"; return(left)
        }
        if(edge!.looseType()){
            // A bounded unknown RHS supplies an endpoint, not a known value
            // set to match. An explicit range expression does supply that set.
            if(right.hasValue or right.hasRange){
                if(!required.contains(supplied)){
                    left.outcome <- worldPartial; left.detail <- "Numeric range match has only partial overlap"; return(left)
                }
                result <- supplied; left.explicitSize <- right.explicitSize
            }else{result <- required}
        }else{left.explicitSize <- left.explicitSize or right.explicitSize}
        if(!edge!.looseSize() and !left.hasSize and right.hasSize){
            left.hasSize <- true; left.size <- right.size
        }
        if(!left.hasValue){left.extentApplied <- right.extentApplied}
        left.overlay <- NUM; left.useBounds(result)
        if(left.hasValue and left.hasSize){left.extentApplied <- true}
        return(left)
    }

    me bool: namedFields(me WorldScalar: facts) <- {
        if(facts.overlay!=LST or !facts.hasValue or (facts.sequence!=NULL and facts.sequence!.hasSpans)){return(false)}
        me WorldListCursor: cursor; cursor.push(facts.sequence)
        me WorldMember: member <- cursor.nextMember(false)
        while(member.frame!=NULL){
            if(member.embedded or member.frame!.facts.nominal==NULL){return(false)}
            member <- cursor.nextMember(false)
        }
        return(true)
    }
    // An unconstrained target adopts represented structure, including symbolic
    // tails. Other list identities prove the shape before pairing members.
    me WorldScalar: mergeList(me WorldScalar: left, me WorldScalar: right, our POV: edge, me bool: alignedOpen <- false) <- {
        // With no target type, extent or contents there is no list pattern to
        // test. Adoption still preserves top-only size qualification.
        me bool: unconstrained <- left.overlay<0 and !left.hasSize and !left.hasValue
        if(edge!.forceID or (edge!.looseType() and !unconstrained) or left.negative or right.negative){
            left.outcome <- worldUnsupported; left.detail <- "Qualified list relationships need matching semantics"; return(left)
        }
        if((left.overlay>=0 and left.overlay!=LST) or (right.overlay>=0 and right.overlay!=LST)){
            left.outcome <- worldRejected; left.detail <- "Incompatible list types"; return(left)
        }
        if(!alignedOpen and openLayout(right) and (left.hasValue or left.hasSize)){
            left.outcome <- worldUnsupported; left.detail <- "Open source correspondence needs span alignment"; return(left)
        }
        if(!alignedOpen and openLayout(left) and (!right.hasValue or !right.hasSize)){
            left.outcome <- worldPartial; left.detail <- "Tail closure needs a closed source endpoint"; return(left)
        }
        if((left.hasSize and right.hasSize and left.size!=right.size) or
           (right.hasValue and right.hasSize and !openLayout(right) and right.size!=FlexNum(sequenceLength(right.sequence))) or
           (!left.hasValue and left.hasSize and right.hasValue and left.size!=FlexNum(sequenceLength(right.sequence)))){
            left.outcome <- worldPartial; left.detail <- "List endpoints need span alignment"; return(left)
        }
        if(!alignedOpen and left.hasValue and right.hasValue){
            left <- fitExtent(left, FlexNum(sequenceLength(right.sequence)))
            if(left.outcome!=worldReady){return(left)}
        }
        if(!left.hasValue and right.hasValue and !right.representable){
            left.outcome <- worldPartial; left.detail <- "List source still has unresolved member work"; return(left)
        }
        left.overlay <- LST
        left.timelike <- left.timelike or right.timelike
        if(left.order==uUnknown or right.order==uUnordered){left.order <- right.order}
        if(!edge!.looseSize() and !left.hasSize and right.hasSize){left.hasSize <- true; left.size <- right.size}
        if(!left.hasValue and right.hasValue){
            left.hasValue <- true; left.sequence <- right.sequence; left.openTail <- right.openTail
            left.dischargeListSpec <- right.dischargeListSpec
            left.explicitSize <- left.explicitSize or right.explicitSize or (!left.hasSize and left.order!=uUnordered)
            left.contentsComplete <- right.contentsComplete; left.representable <- right.representable
        }
        return(left)
    }

    me WorldScalar: merge(me WorldScalar: left, me WorldScalar: right, our POV: edge) <- {
        if(left.terminalValue!=0 or right.terminalValue!=0){
            if(left.negative or right.negative or edge!.forceID or edge!.looseType()){
                left.outcome <- worldUnsupported; left.detail <- "Qualified terminal-value relationship needs proof"; return(left)
            }
            if(left.terminalValue==0 and !left.hasValue and left.overlay<0 and !left.hasSize and left.nominal==NULL){return(right)}
            if(right.terminalValue==0 and !right.hasValue and right.overlay<0 and !right.hasSize and right.nominal==NULL){return(left)}
            if(left.terminalValue!=right.terminalValue){left.outcome <- worldRejected; left.detail <- "Incompatible terminal values"}
            else if(left.identity!=NULL and right.identity!=NULL and left.identity!==right.identity){left.outcome <- worldPartial; left.detail <- "Null occurrence identity needs proof"}
            return(left)
        }
        if(left.alternatives!=NULL or right.alternatives!=NULL){
            left.outcome <- worldUnsupported; left.detail <- "Alternative comparison needs branch distribution"; return(left)
        }
        left.needsEvidence <- false
        if(left.declaration!=NULL or right.declaration!=NULL){
            left.outcome <- worldUnsupported; left.detail <- "Declarations are not value relationships"; return(left)
        }
        if(edge!.forceID){
            if(edge!.looseType() or left.negative or right.negative or left.overlay==LST or right.overlay==LST){
                left.outcome <- worldUnsupported; left.detail <- "Replacement needs a positive scalar relationship"; return(left)
            }
            if(!right.hasValue or (right.overlay!=NUM and right.overlay!=STR)){
                left.outcome <- worldPartial; left.detail <- "Replacement needs an available scalar value"; return(left)
            }
            // Replacement discards the previous value/extent evidence. An
            // anonymous replacement retains the declared destination name,
            // whose meaning is checked by the ordinary continuation.
            if(right.nominal==NULL){
                right.nominal <- left.nominal; right.inheritedName <- left.inheritedName
                right.meaningApplied <- false
            }
            return(right)
        }
        left <- mergeNames(left, right, edge)
        if(left.outcome!=worldReady){return(left)}
        if(left.overlay==LST or right.overlay==LST){return(mergeList(left, right, edge))}
        if(left.negative or right.negative){
            if(edge!.looseType() or left.hasRange or right.hasRange){
                left.outcome <- worldUnsupported; left.detail <- "Qualified negative matching needs template semantics"; return(left)
            }
            me WorldOutcome: match
            if(left.negative){match <- compare(left, right)}else{match <- compare(right, left)}
            if(left.negative and right.negative){
                // Only equivalent exclusions discharge each other. Other
                // conjunctions stay explicit; neither is positive evidence.
                if(match!=worldReady or compare(right, left)!=worldReady){
                    left.outcome <- worldPartial; left.detail <- "Unequal exclusions remain conjoined"
                }
            }else if(match==worldReady){
                left.outcome <- worldRejected; left.detail <- "Scalar excluded by negative constraint"
            }else if(match==worldPartial){
                left.needsEvidence <- !left.negative
                left.outcome <- worldPartial; left.detail <- "Negative constraint needs more evidence"
            }
            return(left)
        }
        if(edge!.looseType() and !right.hasValue and !right.hasRange and
           !(right.overlay==NUM and right.hasSize and right.size>0 and !left.hasValue)){
            left.outcome <- worldPartial; left.detail <- "Qualified scalar source value is unknown"; return(left)
        }
        if(left.overlay>=0 and right.overlay>=0 and left.overlay!=right.overlay){
            left.outcome <- worldRejected; left.detail <- "Incompatible scalar types"; return(left)
        }
        if(!edge!.looseSize() and left.hasSize and right.hasSize and left.size!=right.size){
            left.outcome <- worldRejected; left.detail <- "Incompatible scalar sizes"; return(left)
        }
        if(left.hasRange or right.hasRange){return(mergeRanges(left, right, edge))}
        if(edge!.looseType() and right.overlay==STR){return(mergeText(left, right, edge!.looseSize()))}
        if(edge!.looseType() and left.overlay==NUM and left.hasSize and !left.hasValue and right.hasValue){
            if(right.number<0 or right.number>=left.size){
                left.outcome <- worldRejected; left.detail <- "Value outside numeric range"; return(left)
            }
        }
        if(left.overlay<0){left.overlay <- right.overlay}
        if(!edge!.looseSize() and left.overlay==NUM and !left.hasSize and !right.hasSize){left.explicitSize <- left.explicitSize or right.explicitSize}
        if(!edge!.looseSize() and !left.hasSize and right.hasSize){
            left.hasSize <- true; left.size <- right.size
            left.explicitSize <- left.explicitSize or right.explicitSize
        }
        if(!edge!.looseSize() and left.hasSize and !right.hasSize){right.hasSize <- true; right.size <- left.size}
        left.applyExtent(); right.applyExtent()
        if(left.hasValue and right.hasValue){
            // Unsized signed displacements may agree once an extent is known.
            // Missing extent is not proof that this equality is contradictory.
            if(left.overlay==NUM and !left.hasSize and left.number!=right.number and
               ((left.number<0 and !left.extentApplied)!=(right.number<0 and !right.extentApplied))){
                left.needsEvidence <- true
                left.outcome <- worldPartial; left.detail <- "Numeric comparison needs an extent"; return(left)
            }
            if((left.overlay==NUM and left.number!=right.number) or
               (left.overlay==STR and !sameText(left, right, false))){
                left.outcome <- worldRejected; left.detail <- "Incompatible scalar values"; return(left)
            }
        }else if(right.hasValue){
            // A match uses the candidate's representation after checking the
            // target's range. Keep the target's actual size evidence separately.
            // Strict text acquisition copies the source's counted/given form.
            if(edge!.looseType() or left.overlay==STR){left.explicitSize <- right.explicitSize}
            else{left.explicitSize <- left.explicitSize or right.explicitSize}
            if(edge!.looseType() and left.overlay==STR){left.explicitSize <- !left.hasSize}
            left.hasValue <- true; left.number <- right.number; left.textSource <- right.textSource
            left.textLength <- right.textLength
            left.extentApplied <- right.extentApplied
        }
        return(left)
    }

    // A pending comparison keeps its checked source and qualified edge. Only
    // newly known scalar facts wake it; adding unrelated edges does no replay.
    void: mergeRelationship(our WorldRequest: request, our WorldFrame: frame) <- {
        me WorldScalar: before <- frame!.facts
        me WorldScalar: result <- merge(before, frame!.prerequisite!.facts, frame!.sourceEdge)
        if(result.needsEvidence){
            result <- before
            result.pendingChecks <- joinRequirements(before.pendingChecks, requirement(frame!.prerequisite, frame!.sourceEdge))
        }else if(result.outcome==worldReady and before.pendingChecks!=NULL and
                 ((before.overlay<0 and result.overlay>=0) or (!before.hasSize and result.hasSize) or
                  (!before.hasValue and result.hasValue) or result.qualifications.size()!=before.qualifications.size() or frame!.sourceEdge!.trueByDefinition)){
            me WorldRequirementCursor: checks; checks.push(before.pendingChecks)
            result.pendingChecks <- NULL
            our WorldRequirement: check <- checks.next()
            while(check!=NULL){
                request!.comparisonResumptions <+- 1
                me WorldScalar: checked <- merge(result, check!.frame!.facts, check!.edge)
                if(checked.needsEvidence){result.pendingChecks <- joinRequirements(result.pendingChecks, check)}
                else{
                    result <- checked
                    if(result.outcome!=worldReady){break()}
                }
                check <- checks.next()
            }
        }
        if(frame!.sourceNameInherited and before.nominal==NULL and result.nominal!=NULL and frame!.prerequisite!.facts.alternatives==NULL and typePredicate(frame!.prerequisite!.facts)){
            result.inheritedName <- true
        }
        frame!.facts <- result
    }

    // Expose one unbounded gap and its anchored members. Given embedded
    // endpoints and multiple gaps need a richer alignment, not enumeration.
    our WorldOpenLayout: openLayoutOf(our WorldRequest: request, our WorldFrame: frame) <- {
        if(!representableFacts(frame!.facts) or needsRequirements(frame) or !openLayout(frame!.facts) or frame!.facts.hasSize){return(NULL)}
        our WorldOpenLayout:: layout
        me List<our WorldOpenScan>: pending
        our WorldOpenScan:: root; root!.frame <- frame; root!.members.push(frame!.facts.sequence); pending.append(root)
        while(!pending.isEmpty()){
            our WorldOpenScan: scan <- pending.last()
            if(openLayout(scan!.frame!.facts) and (scan!.frame!.facts.hasSize or !scan!.frame!.retainedWork.isEmpty())){return(NULL)}
            me WorldMember: member <- scan!.members.nextMember(false)
            if(member.frame==NULL){
                request!.sequenceVisits <+- scan!.members.visits; pending.popLast()
                if(scan!.frame!.facts.openTail){
                    if(layout!.gap!=NULL){return(NULL)}
                    layout!.gap <- scan!.frame
                }
            }else if(member.embedded){
                if(!openLayout(member.frame!.facts) and sequenceLength(member.frame!.facts.sequence)==0){continue()}
                our WorldOpenScan:: child; child!.frame <- member.frame
                child!.members.push(member.frame!.facts.sequence); pending.append(child)
            }else if(layout!.gap==NULL){layout!.prefix.append(member.frame); layout!.prefixCount <+- 1}
            else{layout!.suffix.append(member.frame); layout!.suffixCount <+- 1}
        }
        if(layout!.gap==NULL){return(NULL)}
        return(layout)
    }
    our WorldOpenAlignment: alignOpen(our WorldRequest: request, our WorldFrame: frame) <- {
        if(frame!.sourceEdge!.forceID or frame!.sourceEdge!.looseType()){return(NULL)}
        our WorldOpenLayout: left <- openLayoutOf(request, frame)
        if(left==NULL){return(NULL)}
        our WorldOpenLayout: right <- openLayoutOf(request, frame!.prerequisite)
        if(right==NULL){return(NULL)}
        // Before joining the longest prefix and suffix, exclude every shorter
        // overlap. Only an ordinary merge's contradiction is such a proof.
        our WorldOpenLayout: prefix <- left; our WorldOpenLayout: suffix <- left
        if(right!.prefixCount>left!.prefixCount){prefix <- right}
        if(right!.suffixCount>left!.suffixCount){suffix <- right}
        me int64: minimum <- max(left!.prefixCount+left!.suffixCount, right!.prefixCount+right!.suffixCount)
        me int64: frontier <- prefix!.prefixCount+suffix!.suffixCount
        withEach length in range minimum .. frontier{
            me bool: rejected <- false
            withEach pos in range length-suffix!.suffixCount .. prefix!.prefixCount{
                me WorldScalar: overlap <- merge(prefix!.prefix[pos]!.facts,
                    suffix!.suffix[pos+suffix!.suffixCount-length]!.facts, frame!.sourceEdge)
                request!.alignmentChecks <+- 1
                if(overlap.outcome==worldRejected){rejected <- true; break()}
            }
            if(!rejected){return(NULL)}
        }
        our WorldOpenAlignment:: alignment
        alignment!.leftPrefixCount <- left!.prefixCount; alignment!.leftSuffixCount <- left!.suffixCount
        alignment!.right <- right
        return(alignment)
    }

    // Semantic acceptance and work consolidation stay at the graph boundary.
    void: adoptListRequirements(our WorldFrame: frame, our WorldFrame: source) <- {
        frame!.listSpecFrame <- source!.listSpecFrame; frame!.listSpecEdge <- source!.listSpecEdge
        frame!.tailRequirements <- source!.tailRequirements
    }

    void: consumePrerequisite(our WorldRequest: request, our WorldFrame: frame) <- {
        frame!.contextual <- frame!.contextual or frame!.prerequisite!.contextual
        if((frame!.prerequisite!.facts.outcome==worldPartial or frame!.prerequisite!.facts.pendingChecks!=NULL) and
           !(memberSequence(frame) and frame!.sourceIsOperand)){
            frame!.facts.outcome <- worldPartial; frame!.facts.detail <- frame!.prerequisite!.facts.detail
            if(frame!.prerequisite!.facts.pendingChecks!=NULL){frame!.facts.detail <- "Source comparison still needs evidence"}
        }else if(frame!.sourceIsListSpec){
            frame!.listSpecFrame <- frame!.prerequisite
            if(frame!.facts.openTail){frame!.tailRequirements <- requirement(frame!.prerequisite, frame!.listSpecEdge)}
        }else if(memberSequence(frame) and frame!.sourceIsOperand){
            if(frame!.facts.sequence==NULL){Allocate(frame!.facts.sequence)}
            if(!appendMember(frame!.facts.sequence, frame!.prerequisite, frame!.sourceEdge!.isSubItm)){
                frame!.facts.outcome <- worldError; frame!.facts.detail <- "List exceeds representable length"; return()
            }
            frame!.facts.representable <- frame!.facts.representable and representableFacts(frame!.prerequisite!.facts)
            frame!.facts.contentsComplete <- frame!.facts.contentsComplete and completeFacts(frame!.prerequisite!.facts, false)
            frame!.operandsRead <- sequenceLength(frame!.facts.sequence)
        }else if(frame!.sourceIsOperand){
            if(frame!.operandsRead==0){
                frame!.expression <- frame!.prerequisite!.facts
                if(frame!.expressionSlot==2 and frame!.expression.overlay==LST){adoptListRequirements(frame, frame!.prerequisite)}
            }
            else{
                frame!.expression <- appendOperand(frame!.expression, frame!.prerequisite!.facts,
                    frame!.sourceEdge!.pItem!.value!.sizeMode==fromContext)
            }
            frame!.operandsRead <+- 1
            if(frame!.expression.outcome!=worldReady){frame!.facts <- frame!.expression}
        }else{
            me WorldScalar: left <- frame!.facts
            if(frame!.openAlignment!=NULL){frame!.facts <- mergeList(left, frame!.prerequisite!.facts, frame!.sourceEdge, true)}
            else{mergeRelationship(request, frame)}
            if(frame!.facts.outcome==worldReady and !left.hasValue and frame!.facts.overlay==LST){
                // Adoption includes the requirements of members not yet present.
                adoptListRequirements(frame, frame!.prerequisite)
            }
            if(frame!.facts.outcome==worldReady and left.overlay==LST and left.hasValue and
               frame!.prerequisite!.facts.overlay==LST and frame!.prerequisite!.facts.hasValue){
                beginCorrespondence(frame, FlexNum(sequenceLength(frame!.prerequisite!.facts.sequence)))
                if(frame!.openAlignment==NULL){
                    Allocate(frame!.rightMembers); frame!.ownsRightCursor <- true
                    frame!.rightMembers!.push(frame!.prerequisite!.facts.sequence)
                }
            }
            if(frame!.sourceEdge!.trueByDefinition and frame!.facts.outcome==worldReady){frame!.facts.meaningApplied <- true}
            our infonView: supplied <- frame!.sourceEdge!.pItem
            // A closed scalar leaf contributes only its checked type, size
            // and value, including the case where its value is unknown. A
            // successful qualified test adds no identity. Fully checked scalar
            // expressions supply the same facts; other nested work stays.
            me bool: scalarExpression <- (supplied!.value!.evalMode==emConcat or
                frame!.prerequisite!.selection!=NULL) and frame!.prerequisite!.retainedWork.isEmpty() and
                (frame!.prerequisite!.facts.overlay==NUM or frame!.prerequisite!.facts.overlay==STR) and
                (frame!.prerequisite!.facts.hasValue or frame!.prerequisite!.facts.hasRange)
            // Closed correspondence checks the source endpoint. Unconstrained
            // adoption copies the whole layout and its future requirements.
            // Retain this edge below if any contribution is still unresolved.
            me bool: listSource <- frame!.prerequisite!.facts.overlay==LST and frame!.prerequisite!.facts.hasValue and
                representableFacts(frame!.prerequisite!.facts) and
                ((frame!.prerequisite!.facts.hasSize and !openLayout(frame!.prerequisite!.facts)) or
                 ((!left.hasValue and !left.hasSize or frame!.openAlignment!=NULL) and frame!.prerequisite!.retainedWork.isEmpty()))
            frame!.retainSource <- !listSource and !scalarExpression and (!supplied!.wrkList.isEmpty() or
                (supplied!.value!.evalMode!=emLiteral and supplied!.value!.evalMode!=emUnknown) or
                !frame!.prerequisite!.facts.representable)
            // A corresponding list makes one retention decision after member
            // work returns, including any unresolved obligations it discovers.
            if(!frame!.projected and !frame!.corresponding and frame!.retainSource){frame!.retainedWork.append(frame!.sourceEdge)}
        }
        frame!.prerequisite <- NULL
    }

    me bool: satisfied(our POV: target, me bool: requireSize) <- {
        return(target!.pParent==NULL and target!.viewMap.sourcePov==NULL and target!.referenceAlias.sourcePov==NULL and
           target!.pItem!.streamState!=parseStarted and target!.pItem!.streamState!=parseListReady and
           target!.pItem!.isNormed and target!.pItem!.worldScalarCompletionOwner===target!.pItem and
           (!requireSize or target!.pItem!.infSize!.evalMode==emLiteral))
    }

    void: finish(our WorldRequest: request) <- {
        me WorldScalar: facts <- request!.root!.facts
        if(facts.pendingChecks!=NULL and facts.outcome==worldReady){
            request!.outcome <- worldPartial; request!.detail <- "Scalar comparison still needs evidence"; return()
        }
        if(facts.outcome!=worldReady){request!.outcome <- facts.outcome; request!.detail <- facts.detail; return()}
        if(completeFacts(facts, request!.requireSize)){
            request!.outcome <- worldComplete
        }else{request!.outcome <- worldPartial}
        if(request!.root!.selection!=NULL and request!.root!.unitSelection==NULL and !request!.root!.selection!.oneOf and
           !(request!.root!.selection!.openResult and facts.hasValue and representableFacts(facts)) and
           !request!.root!.acquireOnly and !completeFacts(facts, request!.requireSize)){
            request!.outcome <- worldPartial; request!.detail <- "Selected result still has unresolved work"; return()
        }
        publish(request)
        if(request!.outcome==worldComplete or request!.outcome==worldPartial){request!.provenance <- request!.root!.correspondenceResult}
    }

    // Prepare destination occurrences before any write. Existing literal lists
    // keep their POVs; adopted/concatenated lists get independent occurrences.
    void: publish(our WorldRequest: request) <- {
        me List<WorldPublication>: pending
        me List<WorldPublication>: writes
        me Map<our infonView, our WorldFrame>: seen
        me WorldPublication: root; root.target <- request!.target; root.frame <- request!.root; pending.append(root)
        me bool: editsQueued <- false
        while(!pending.isEmpty() or !editsQueued){
            if(pending.isEmpty()){
                editsQueued <- true
                // Returned parents already contain the checked staged facts.
                // Only edits outside that result need another destination job.
                withEach update in request!.edits{
                    if(!seen.containsKey(update!.node!.pItem)){
                        me WorldPublication: edit; edit.target <- update!.node; edit.frame <- update; pending.append(edit)
                    }
                }
                if(pending.isEmpty()){break()}
            }
            me WorldPublication: job <- pending.popLast()
            if(job.frame!.facts.outcome!=worldReady or job.frame!.facts.pendingChecks!=NULL){continue()}
            if(seen.containsKey(job.target!.pItem)){
                if(seen.at(job.target!.pItem)!==job.frame){
                    request!.outcome <- worldUnsupported
                    request!.detail <- "Shared target views need joint correspondence constraints"; return()
                }
                continue()
            }
            seen.insert(job.target!.pItem, job.frame)
            me WorldScalar: facts <- job.frame!.facts
            if(facts.declaration!=NULL and job.target!.pItem!==job.frame!.node!.pItem){
                request!.outcome <- worldUnsupported; request!.detail <- "Declaration cannot be copied as a value"; return()
            }
            if(facts.alternatives!=NULL){
                Allocate(job.newAlternatives)
                job.newAlternatives!.viewMode <- vmOverlay; job.newAlternatives!.itmMode <- mItem
                job.newAlternatives!.streamState <- parseDone; job.newAlternatives!.isInnr <- true
                job.newAlternatives!.infSize!.overlayType <- NUM; job.newAlternatives!.infSize!.evalMode <- emUnknown
                job.newAlternatives!.value!.overlayType <- LST; job.newAlternatives!.value!.evalMode <- emLiteral
                job.newAlternatives!.value!.sizeMode <- fromGiven
                withEach member in facts.alternatives!.members{
                    if(!representableFacts(member!.facts)){
                        request!.outcome <- worldPartial; request!.detail <- "Alternative still has unresolved work"; return()
                    }
                    our infonView:: item
                    item!.viewMode <- vmAny; item!.itmMode <- mItem; item!.streamState <- parseDone
                    item!.infSize!.overlayType <- NUM; item!.infSize!.evalMode <- emUnknown
                    item!.value!.overlayType <- tUnknown; item!.value!.evalMode <- emUnknown
                    me WorldPublication: child
                    child.target <- job.newAlternatives!.value!.items.append(item, false, 938)
                    child.frame <- member; pending.append(child)
                }
            }else if(facts.overlay==LST and facts.hasValue){
                our infonState: body <- job.target!.pItem!.value
                me bool: existing <- body!.overlayType==LST and body!.evalMode==emLiteral and
                    !(job.frame!.path!=NULL and job.frame!.path!.returned)
                if(!existing and !facts.representable){
                    request!.outcome <- worldPartial; request!.detail <- "List result still has unresolved member work"; return()
                }
                if(!existing){
                    Allocate(job.newList); body <- job.newList
                    body!.overlayType <- LST; body!.evalMode <- emLiteral
                    if(job.frame!.listSpecEdge!=NULL){body!.listSpec <- job.frame!.listSpecEdge!.pItem}
                    if(facts.explicitSize){body!.sizeMode <- fromGiven}else{body!.sizeMode <- fromCount}
                }
                job.reorderFields <- existing and facts.fieldLayout
                me Set<our POV>: originalFields
                our POV: original <- body!.items.head
                if(job.reorderFields){while(original!=NULL){originalFields.insert(original); original <- original!.next}}
                our POV: targetMember <- body!.items.head
                me WorldListCursor: members; members.push(facts.sequence)
                me WorldMember: occurrence <- members.nextMember(false)
                while(occurrence.frame!=NULL){
                    our WorldFrame: member <- occurrence.frame
                    if(job.reorderFields){
                        targetMember <- NULL
                        if(originalFields.contains(member!.node)){targetMember <- member!.node; originalFields.erase(member!.node)}
                    }
                    if(!existing or targetMember==NULL){
                        if(!representableFacts(member!.facts)){
                            request!.outcome <- worldPartial; request!.detail <- "New member still has unresolved work"; return()
                        }
                        our infonState: destination <- body
                        if(existing){
                            if(job.appendedList==NULL){Allocate(job.appendedList)}
                            destination <- job.appendedList
                        }
                        our infonView:: item
                        item!.viewMode <- vmAny; item!.itmMode <- mItem; item!.streamState <- parseDone
                        item!.infSize!.overlayType <- NUM; item!.infSize!.evalMode <- emUnknown
                        item!.value!.evalMode <- emUnknown; item!.value!.overlayType <- tUnknown
                        item!.orderMode <- member!.node!.pItem!.orderMode
                        targetMember <- destination!.items.append(item, occurrence.embedded, 933); targetMember!.pParent <- job.target
                    }
                    me WorldPublication: child; child.target <- targetMember; child.frame <- member; pending.append(child)
                    if(job.reorderFields){job.fieldOrder.append(targetMember)}
                    else if(existing){targetMember <- targetMember!.next}
                    occurrence <- members.nextMember(false)
                }
                request!.sequenceVisits <+- members.visits
            }
            writes.append(job)
        }
        // All sparse destinations are checked before ordinary or structural writes.
        withEach batch in request!.sparseEdits{
            our POV: source <- batch!.source!.node
            if(!batch!.source!.writable or source!.pItem!.value!.overlayType!=LST or
               source!.pItem!.value!.evalMode!=emLiteral or !source!.pItem!.value!.tailUnfinished or
               source!.pItem!.value!.listSpec==NULL or source!.pItem!.infSize!.evalMode!=emLiteral or
               seen.containsKey(source!.pItem) or
               (source!.isSubItm and (batch!.source!.parent==NULL or !source!.hasSparseOrderedSpanValue() or
                source!.pItem!.infSize!.num!=FlexNum(batch!.count) or seen.containsKey(batch!.source!.parent!.node!.pItem)))){
                request!.outcome <- worldUnsupported; request!.detail <- "Sparse write needs a stable independent destination"; return()
            }
            if(source!.isSubItm){
                // Traversal proved membership. Validate its immediate links;
                // do not search from the parent's start again for every edit.
                our infonView: parent <- batch!.source!.parent!.node!.pItem
                if((source!.prev==NULL and parent!.value!.items.head!==source) or
                   (source!.prev!=NULL and source!.prev!.next!==source) or
                   (source!.next==NULL and parent!.value!.items.tail!==source) or
                   (source!.next!=NULL and source!.next!.prev!==source)){
                    request!.outcome <- worldUnsupported; request!.detail <- "Sparse occurrence is no longer in its source list"; return()
                }
            }
        }
        withEach origin in request!.declarationOrigins{declarationOrigins.insert(origin)}
        withEach entries in request!.declarations{
            withEach definition in entries!.entries{addDefinition(definitions, definition)}
        }
        withEach staged in request!.boundaries{
            our BoundaryReference: prior
            if(request!.identities!.boundaries.containsKey(staged!.source)){prior <- request!.identities!.boundaries.at(staged!.source)}
            if(staged!.begin!=NULL and staged!.begin!.pItem!.identityName==NULL){
                if(prior!=NULL and prior!.begin!=NULL){staged!.begin!.pItem!.identityName <- prior!.begin!.pItem!.identityName}
                else{staged!.begin!.pItem!.identityName <- request!.identities!.occurrenceScope.freshIdentity()}
            }
            if(staged!.end!=NULL and staged!.end!.pItem!.identityName==NULL){
                if(prior!=NULL and prior!.end!=NULL){staged!.end!.pItem!.identityName <- prior!.end!.pItem!.identityName}
                else{staged!.end!.pItem!.identityName <- request!.identities!.occurrenceScope.freshIdentity()}
            }
            if(prior!=NULL){
                if(staged!.begin==NULL){staged!.begin <- prior!.begin}
                if(staged!.end==NULL){staged!.end <- prior!.end}
                request!.identities!.boundaries.at(staged!.source) <- staged
            }else{request!.identities!.boundaries.insert(staged!.source, staged)}
        }
        withEach job in writes{publishFrame(request, job)}
        withEach batch in request!.sparseEdits{
            our POV: source <- batch!.source!.node
            our POV: parent <- source
            if(source!.isSubItm){parent <- batch!.source!.parent!.node}
            if(!source!.isSubItm){
                our infonView: span <- source!.makeSparseSpanCopy(batch!.count)
                span!.type <- NULL; modelMngr.completeItemsType(span)
                our POV: tail <- source!.pItem!.value!.items.append(span, true, 942); tail!.pParent <- NULL
                source!.pItem!.value!.tailUnfinished <- false; source <- tail
            }
            modelMngr.completeItemsType(source!.pItem)
            // Descending coordinates preserve the original prefix as each
            // demanded occurrence splits off its own compressed suffix.
            me List<our WorldSparseEdit>: ordered <- batch!.descending()
            withEach edit in ordered{
                our POV: tail <- source
                if(edit!.index>0){tail <- source!.splitSparseSpanPrefix(edit!.index, parent, source)}
                tail!.exposeSparseHeadWithItem(edit!.frame!.node!.pItem, parent, tail)
            }
            source!.pItem!.noteNormalizationWork()
            parent!.pItem!.noteNormalizationWork()
        }
    }

    // A closed containing level need not repeat a type-only requirement
    // already represented by every embedded child's own future template.
    me bool: coveredListSpec(our WorldFrame: frame) <- {
        if(frame!.facts.openTail or frame!.facts.order==uUnordered or !frame!.facts.representable or
           (frame!.facts.explicitSize and !frame!.facts.hasSize) or needsRequirements(frame) or frame!.listSpecFrame==NULL){return(false)}
        me WorldScalar: required <- frame!.listSpecFrame!.facts
        if(!typePredicate(required) or required.negative or !frame!.listSpecFrame!.retainedWork.isEmpty()){return(false)}
        me WorldListCursor: members; members.push(frame!.facts.sequence)
        me WorldMember: member <- members.nextMember(false)
        while(member.frame!=NULL){
            if(member.embedded){
                our WorldFrame: own <- member.frame!.listSpecFrame
                if(own==NULL or !typePredicate(own!.facts) or own!.facts.negative or
                   !own!.retainedWork.isEmpty() or compareNominal(required.nominal, own!.facts.nominal)!=worldReady or
                   (required.overlay>=0 and required.overlay!=own!.facts.overlay)){return(false)}
            }
            member <- members.nextMember(false)
        }
        return(true)
    }

    void: publishFrame(our WorldRequest: request, me WorldPublication: job) <- {
        our WorldFrame: frame <- job.frame
        our infonView: item <- job.target!.pItem
        me WorldScalar: facts <- frame!.facts
        if(frame!.inputEdge!=NULL){item!.funcArgs <- NULL; item!.hasInnrOutr <- false}
        if(frame!.argumentEdge!=NULL){item!.funcArgs <- NULL; item!.argPos <- apNoArgs}
        if(frame!.path!=NULL){
            item!.partRef <- NULL; item!.parts.clear()
            if(frame!.correspondenceResult!=NULL and frame!.correspondenceResult!.position!=NULL){
                item!.orderMode <- frame!.correspondenceResult!.position!.node!.pItem!.orderMode
            }
        }
        if(facts.declaration!=NULL){
            item!.isNormed <- true; item!.worldScalarCompletionOwner <- item
            request!.publications <+- 1; return()
        }
        if(facts.terminalValue!=0){
            Allocate(item!.value); Allocate(item!.infSize)
            item!.value!.undefined <- facts.terminalValue==2
            item!.viewMode <- vmOverlay; item!.itmMode <- mItem
            if(facts.terminalValue==1){item!.setToNull(); item!.identityName <- facts.identity}
            if(facts.boundary!=NULL){item!.identityName <- facts.boundary!.pItem!.identityName}
            item!.innr <- NULL; item!.intersectPos <- ipNoIntersect
            item!.type <- NULL; item!.addedTypes.clear(); item!.wrkList <- frame!.retainedWork
            item!.isNormed <- true; item!.worldScalarCompletionOwner <- item; request!.publications <+- 1; return()
        }
        item!.addedTypes.clear()
        if(facts.inheritedName and facts.nominal!=NULL){item!.type <- NULL; item!.addedTypes.append(facts.nominal)}
        else{item!.type <- facts.nominal}
        withEach word in facts.qualifications{item!.addedTypes.append(word)}
        item!.wordDerefed <- facts.meaningApplied
        if(job.newAlternatives!=NULL){
            our infonState:: value; value!.overlayType <- tUnknown; value!.evalMode <- emIntersection
            our infonState:: size; size!.overlayType <- NUM; size!.evalMode <- emUnknown
            item!.value <- value; item!.infSize <- size; item!.innr <- job.newAlternatives
            item!.viewMode <- vmOverlay; item!.intersectPos <- ipGetLast
            item!.hasInnrOutr <- false; item!.intersectMarkedRetPOV <- NULL
            item!.wrkList <- frame!.retainedWork; item!.isNormed <- false
            item!.worldScalarCompletionOwner <- NULL; request!.publications <+- 1; return()
        }
        if((frame!.selection!=NULL or frame!.path!=NULL) and !facts.hasValue and !facts.hasRange){
            our infonState:: value; value!.overlayType <- tUnknown; value!.evalMode <- emUnknown
            our infonState:: size; size!.overlayType <- NUM; size!.evalMode <- emUnknown
            item!.value <- value; item!.infSize <- size; item!.viewMode <- vmAny
        }
        if(frame!.selection!=NULL){
            if(frame!.selection!.oneOf or frame!.selection!.openResult){
                our infonState:: value; value!.overlayType <- tUnknown; value!.evalMode <- emUnknown
                our infonState:: size; size!.overlayType <- NUM; size!.evalMode <- emUnknown
                item!.value <- value; item!.infSize <- size; item!.viewMode <- vmAny
            }
            item!.innr <- NULL; item!.intersectPos <- ipNoIntersect
            item!.hasInnrOutr <- false; item!.intersectMarkedRetPOV <- NULL
        }
        if(job.newList!=NULL){item!.value <- job.newList}
        // Detached suffixes join the target only after every destination has
        // passed publication checks, preserving the original prefix POVs.
        if(job.reorderFields){
            item!.value!.items.clear()
            withEach field in job.fieldOrder{item!.value!.items.appendPov(field)}
        }else if(job.appendedList!=NULL){
            our POV: member <- job.appendedList!.items.head
            while(member!=NULL){
                our POV: next <- member!.next
                item!.value!.items.appendPov(member); member <- next
            }
        }
        if(facts.overlay==LST){
            item!.value!.tailUnfinished <- facts.openTail; item!.value!.timelike <- facts.timelike
            if(facts.order!=uUnknown){item!.orderMode <- facts.order}
        }
        if(facts.overlay==LST and item!.value!.listSpec!=NULL and
           ((!openLayout(facts) and facts.dischargeListSpec and facts.hasSize and facts.size==FlexNum(sequenceLength(facts.sequence))) or
            coveredListSpec(frame))){item!.value!.listSpec <- NULL}
        // An unresolved expression is still the representation of its partial
        // result. Type evidence alone must not turn its body into 0 or ''.
        if(item!.value!.evalMode==emConcat and !facts.hasValue and !facts.hasRange){return()}
        me bool: sameView <- item===frame!.node!.pItem
        if(sameView and item!.infSize!.evalMode!=emConcat and facts.hasRange and frame!.bodyBounds.same(facts.bounds()) and
           frame!.bodyHasSize==facts.hasSize and (!facts.hasSize or frame!.bodySize==facts.size)){
            // The existing expression already represents these facts. Only
            // discharge work, without allocating an equivalent partial body.
            if(item!.wrkList.size()!=frame!.retainedWork.size()){
                item!.wrkList <- frame!.retainedWork; request!.publications <+- 1
            }
            return()
        }
        // Scalar states may be shared by other views. Publish through fresh
        // state objects, never overwrite another occurrence's borrowed payload.
        me bool: changedRange <- facts.hasRange and (!sameView or !frame!.bodyBounds.same(facts.bounds()))
        if(facts.overlay!=LST){
            our infonState:: nextValue; nextValue! <- item!.value!; item!.value <- nextValue
        }
        our infonState:: nextSize; nextSize! <- item!.infSize!; item!.infSize <- nextSize
        if(facts.overlay>=0){
            item!.viewMode <- vmOverlay
            if(!facts.hasRange and facts.overlay!=LST){item!.value!.overlayType <- facts.overlay}
        }
        // Selection and replacement discard the previous view's extent,
        // including when the new value has no known size.
        if((frame!.selection!=NULL or frame!.path!=NULL or frame!.preparedReplacement!=NULL) and !facts.hasSize){
            item!.infSize!.overlayType <- NUM; item!.infSize!.evalMode <- emUnknown; item!.infSize!.items.clear()
        }
        if(facts.overlay==LST and facts.order==uUnordered and !facts.explicitSize){item!.infSize!.evalMode <- emUnknown}
        if(facts.hasSize){
            item!.infSize!.overlayType <- NUM; item!.infSize!.evalMode <- emLiteral; item!.infSize!.num <- facts.size
            item!.infSize!.items.clear()
        }
        if(facts.hasValue and facts.overlay!=LST){
            item!.value!.evalMode <- emLiteral
            item!.value!.items.clear()
            item!.value!.num <- facts.number
            if(facts.overlay==STR){
                me WorldTextCursor: text; text.push(facts.textSource, facts.textLength)
                item!.value!.str <- ""
                withEach pos in range 0 .. facts.textLength{item!.value!.str <+- text.next()}
                request!.publishedTextBytes <+- facts.textLength
                request!.publishedTextNodes <+- text.visits
            }
            item!.value!.inverted <- false
            item!.value!.numericExtentApplied <- facts.extentApplied
        }
        if(changedRange){
            item!.value!.overlayType <- LST; item!.value!.evalMode <- emConcat
            item!.value!.items.clear()
            withEach part in range 0 .. 2{
                our infonView:: term
                term!.viewMode <- vmOverlay; term!.itmMode <- mItem; term!.streamState <- parseDone
                term!.infSize!.overlayType <- NUM; term!.value!.overlayType <- NUM
                if(part==0){
                    term!.infSize!.evalMode <- emLiteral; term!.infSize!.num <- facts.upper-facts.lower
                    term!.value!.evalMode <- emUnknown; term!.value!.sizeMode <- fromGiven
                }else{
                    term!.infSize!.evalMode <- emUnknown
                    term!.value!.evalMode <- emLiteral; term!.value!.num <- facts.lower
                    term!.value!.sizeMode <- fromContext
                }
                our POV: operand <- item!.value!.items.append(term, false, 932)
                operand!.pParent <- job.target
            }
        }
        if(facts.overlay!=LST){
            if(facts.explicitSize){item!.value!.sizeMode <- fromGiven}
            else{item!.value!.sizeMode <- fromCount}
        }
        if(facts.overlay==LST and facts.openTail and facts.nominal==NULL and item!.value!.listSpec!=NULL){modelMngr.completeItemsType(item)}
        item!.invertMatch <- facts.negative
        // Discharge represented work even if no value was supplied. Exhausted
        // unknowns remain partial; removing a tautology does not invent a value.
        item!.wrkList <- frame!.retainedWork
        request!.publications <+- 1
        if(completeFacts(facts, request!.requireSize and job.target===request!.target)){
            item!.isNormed <- true; item!.worldScalarCompletionOwner <- item
        }
    }
}

struct WorldManager {
    our WorldControl: control
    void: INIT() <- {Allocate(control)}
    me WorldPOVGraph: graph

    // Parser readiness and wait registration use the same model lock.
    void: prepareInput(our infonView: item) <- {
        me WorldModelLock: lock{control!.mutex}
        item!.streamState <- parseStarted; item!.graphParseError <- ""
    }
    void: failInput(our infonView: item, me string: message) <- {
        me WorldModelLock: lock{control!.mutex}
        item!.graphParseError <- message; item!.streamState <- parseDone
        inputReady(item)
    }
    void: setOrigin(our infonView: item, me uint64: origin) <- {
        me WorldModelLock: lock{control!.mutex}
        item!.originID <- origin
    }
    void: inputReady(our infonView: item) <- {
        me WorldModelLock: lock{control!.mutex}
        if(!control!.inputWaiters.containsKey(item)){return()}
        our WorldInputWaiters: waiters <- control!.inputWaiters.at(item)
        control!.inputWaiters.erase(item)
        withEach request in waiters!.requests{
            if(request!.outcome==worldWaiting and request!.waitingInput===item){
                request!.waitingInput <- NULL
                request!.ready.append(request!.waitingFrame); request!.waitingFrame <- NULL
                request!.outcome <- worldReady; request!.detail <- ""
                run(request)
            }
        }
    }

    // Closed parsing uses the existing parser without constructing the old engine.
    me WorldParseResult: parse(me string: source) <- {
        me WorldParseResult: result
        me ProteusParser: parser{NULL, false, 0}
        parser.initParseFromString("WorldManager", source)
        our infonView:: item
        parser.doParse(item)
        if(parser.doesParseHaveError()){result.error <- parser.formattedError(); return(result)}
        Allocate(result.target, 930); result.target!.pItem <- item
        return(result)
    }

    our WorldFrame: makeFrame(our WorldRequest: request, our POV: node, our WorldPosition: context <- NULL, me bool: requireSize <- false) <- {
        if(request!.edits.containsKey(node!.pItem)){return(request!.edits.at(node!.pItem))}
        if(context!=NULL and request!.completedOccurrences.containsKey(node)){
            our WorldFrame: prior <- request!.completedOccurrences.at(node)
            if(graph.samePosition(prior!.navigation, context) and graph.completeFacts(prior!.facts, requireSize)){return(prior)}
        }
        our WorldFrame:: frame
        frame!.node <- node; frame!.demandSize <- requireSize
        frame!.context <- context; frame!.navigation <- context
        if(context!=NULL){
            frame!.expressionParent <- node!.pParent; frame!.parentContext <- context!.parent
            if(request!.activeContexts.containsKey(node!.pItem)){
                frame!.initialized <- true; frame!.facts.outcome <- worldUnsupported
                frame!.facts.detail <- "Cyclic contextual prerequisites need a joint proof"
            }else{request!.activeContexts.insert(node!.pItem, frame)}
        }
        else{
            if(request!.attempts.containsKey(node!.pItem)){request!.attempts.at(node!.pItem) <- frame}
            else{request!.attempts.insert(node!.pItem, frame)}
        }
        request!.framesCreated <+- 1
        return(frame)
    }

    // Rejection returns through required dependencies. An OR collector alone
    // can discard it; a contradiction on a required route still rejects.
    void: stopFrame(our WorldRequest: request, our WorldFrame: frame) <- {
        if(frame!.facts.outcome==worldPartial or frame!.facts.outcome==worldRejected){frame!.finished <- true}
        else{request!.outcome <- frame!.facts.outcome; request!.detail <- frame!.facts.detail}
    }

    // Correspondence and listSpec projection share the same derived relationship.
    // Source frames stay immutable; each occurrence holds its own combined facts.
    our WorldFrame: projectFrame(our WorldRequest: request, our WorldFrame: left) <- {
        our WorldFrame:: pair
        pair!.node <- left!.node; pair!.facts <- left!.facts; pair!.navigation <- left!.navigation; pair!.contextual <- left!.contextual; pair!.argumentEdge <- left!.argumentEdge
        pair!.selection <- left!.selection; pair!.acquireOnly <- left!.acquireOnly
        pair!.correspondenceResult <- left!.correspondenceResult; pair!.preparedReplacement <- left!.preparedReplacement
        pair!.retainedWork <- left!.retainedWork
        pair!.listSpecFrame <- left!.listSpecFrame; pair!.listSpecEdge <- left!.listSpecEdge
        pair!.tailRequirements <- left!.tailRequirements; pair!.pendingRequirements <- left!.pendingRequirements
        pair!.bodyBounds <- left!.bodyBounds; pair!.bodyHasSize <- left!.bodyHasSize; pair!.bodySize <- left!.bodySize
        pair!.initialized <- true; pair!.projected <- true
        request!.framesCreated <+- 1
        return(pair)
    }

    our WorldFrame: derivePair(our WorldRequest: request, our WorldFrame: left,
                              our WorldFrame: right, our POV: edge, me bool: inheritedName <- false) <- {
        our WorldFrame: pair <- projectFrame(request, left)
        pair!.sourceEdge <- edge; pair!.prerequisite <- right; pair!.sourceNameInherited <- inheritedName
        return(pair)
    }

    our WorldFrame: projectListSpec(our WorldRequest: request, our WorldFrame: left,
                                   our WorldFrame: spec, our POV: edge) <- {
        our WorldFrame: pair <- projectFrame(request, left)
        pair!.pendingRequirements <- graph.joinRequirements(pair!.pendingRequirements, graph.requirement(spec, edge))
        pair!.facts.contentsComplete <- false
        return(pair)
    }

    // Batch pending ancestor projections through each wrapper. Only semantic
    // consumers demand this walk; structural containment can carry it onward.
    our WorldFrame: resolveRequirements(our WorldRequest: request, our WorldFrame: left,
                                       our WorldRequirement: inherited <- NULL) <- {
        our WorldFrame: pair <- projectFrame(request, left)
        graph.beginRequirements(pair, inherited)
        return(pair)
    }

    me bool: applyMemberRequirement(our WorldRequest: request, our WorldFrame: frame) <- {
        if(frame!.pairedMember!.facts.outcome!=worldReady){return(false)}
        me uint64: before <- frame!.memberRequirements.visits
        our WorldRequirement: requirement <- frame!.memberRequirements.next()
        request!.requirementVisits <+- frame!.memberRequirements.visits-before
        if(requirement==NULL){return(false)}
        frame!.pairedMember <- derivePair(request, frame!.pairedMember, requirement!.frame, requirement!.edge, true)
        request!.templateApplications <+- 1; request!.ready.append(frame!.pairedMember)
        return(true)
    }

    // Nominal field alignment preserves supplied occurrence order. Missing
    // declaration fields are inserted before the next corresponding field.
    // The index excludes inheritance ambiguity before any pair is accepted.
    // A stronger demand continues the saved cursor; it does not reread the
    // member's expressions or identities. Predicate frames remain reusable.
    our WorldFrame: fieldValue(our WorldRequest: request, our WorldFrame: member, our WorldFrame: owner) <- {
        if(owner!.acquireOnly or owner!.predicateOnly or member!.facts.meaningApplied or
           !(member!.acquireOnly or member!.predicateOnly)){return(member)}
        our WorldFrame:: value; value! <- member!
        value!.finished <- false; value!.acquireOnly <- false; value!.predicateOnly <- false
        request!.framesCreated <+- 1
        return(value)
    }
    void: beginFields(our WorldRequest: request, our WorldFrame: frame) <- {
        frame!.contextual <- frame!.contextual or frame!.prerequisite!.contextual
        if(!graph.representableFacts(frame!.prerequisite!.facts) or !frame!.prerequisite!.retainedWork.isEmpty()){
            frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Record meaning still has unresolved relationships"; stopFrame(request, frame); return()
        }
        frame!.facts <- graph.mergeNames(frame!.facts, frame!.prerequisite!.facts, frame!.sourceEdge)
        if(frame!.facts.outcome!=worldReady){stopFrame(request, frame); return()}
        our WorldFieldMerge:: fields
        me List<our WorldFrame>: definitions
        me List<our WorldFrame>: supplied
        me Map<string, int64>: byName
        me Set<string>: present
        me WorldListCursor: cursor; cursor.push(frame!.prerequisite!.facts.sequence)
        our WorldFrame: member <- cursor.next()
        while(member!=NULL){
            me string: key <- member!.facts.nominal!.typeID()
            if(byName.containsKey(key)){
                frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Record field identity needs additional nominal evidence"; stopFrame(request, frame); return()
            }
            byName.insert(key, definitions.size()); definitions.append(member); member <- cursor.next()
        }
        request!.sequenceVisits <+- cursor.visits; me WorldListCursor: actuals; cursor <- actuals; cursor.push(frame!.facts.sequence)
        member <- cursor.next()
        while(member!=NULL){
            me string: key <- member!.facts.nominal!.typeID()
            if(present.contains(key)){
                frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Record field identity needs additional nominal evidence"; stopFrame(request, frame); return()
            }
            present.insert(key); supplied.append(member); member <- cursor.next()
        }
        request!.sequenceVisits <+- cursor.visits
        our POV: edge <- graph.memberRelationship(frame!.sourceEdge); edge!.trueByDefinition <- false
        me int64: next <- 0
        withEach actual in supplied{
            me string: key <- actual!.facts.nominal!.typeID()
            if(byName.containsKey(key)){
                me int64: index <- byName.at(key)
                while(next<index){
                    our WorldFrame: omitted <- definitions[next]; next <+- 1
                    if(!present.contains(omitted!.facts.nominal!.typeID())){fields!.members.append(fieldValue(request, omitted, frame))}
                }
                our WorldFrame: required <- definitions[index]
                me WorldOutcome: identity <- graph.compareNominal(actual!.facts.nominal, required!.facts.nominal)
                if(identity!=worldReady){frame!.facts.outcome <- identity; frame!.facts.detail <- "Record fields do not have a proved identity"; stopFrame(request, frame); return()}
                fields!.members.append(derivePair(request, actual, required, edge)); request!.memberPairs <+- 1
            }else{
                if(!frame!.prerequisite!.facts.openTail and (frame!.prerequisite!.facts.order!=uUnordered or frame!.prerequisite!.facts.hasSize)){
                    frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Record field lies outside its closed meaning"; stopFrame(request, frame); return()
                }
                fields!.members.append(actual)
            }
        }
        while(next<definitions.size()){
            our WorldFrame: omitted <- definitions[next]; next <+- 1
            if(!present.contains(omitted!.facts.nominal!.typeID())){fields!.members.append(fieldValue(request, omitted, frame))}
        }
        frame!.fields <- fields
        frame!.facts.contentsComplete <- true; frame!.facts.representable <- true
        request!.ready.append(frame)
    }
    void: mergeFields(our WorldRequest: request, our WorldFrame: frame) <- {
        our WorldFieldMerge: fields <- frame!.fields
        while(fields!.next<fields!.members.size()){
            our WorldFrame: member <- fields!.members[fields!.next]
            if(!member!.finished){request!.ready.append(frame); request!.ready.append(member); return()}
            if(member!.facts.outcome!=worldReady){frame!.facts <- member!.facts; stopFrame(request, frame); return()}
            if(!member!.retainedWork.isEmpty() or member!.facts.pendingChecks!=NULL){
                frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Record field still has unresolved relationships"; stopFrame(request, frame); return()
            }
            graph.appendMember(fields!.sequence, member)
            frame!.contextual <- frame!.contextual or member!.contextual
            frame!.facts.contentsComplete <- frame!.facts.contentsComplete and graph.completeFacts(member!.facts, false)
            frame!.facts.representable <- frame!.facts.representable and graph.representableFacts(member!.facts)
            fields!.next <+- 1
        }
        if(frame!.facts.explicitSize and frame!.facts.hasSize and frame!.facts.size!=FlexNum(graph.sequenceLength(fields!.sequence))){
            frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Record fields do not fit the given extent"; stopFrame(request, frame); return()
        }
        if(frame!.prerequisite!.facts.order==uUnordered){frame!.facts.order <- uUnordered}
        frame!.facts.sequence <- fields!.sequence; frame!.facts.hasSize <- !frame!.facts.openTail and (frame!.facts.order!=uUnordered or frame!.facts.explicitSize)
        if(frame!.facts.hasSize){frame!.facts.size <- graph.sequenceLength(fields!.sequence)}
        frame!.facts.fieldLayout <- true
        frame!.facts.timelike <- frame!.facts.timelike or frame!.prerequisite!.facts.timelike
        if(frame!.sourceEdge!.trueByDefinition){frame!.facts.meaningApplied <- true}
        frame!.prerequisite <- NULL; frame!.fields <- NULL; request!.ready.append(frame)
    }

    // A pair is a derived strict member relationship, evaluated by the same
    // merge operation. Nested lists return here through the retained stack.
    void: correspond(our WorldRequest: request, our WorldFrame: frame) <- {
        if(frame!.pairedMember!=NULL){
            if(frame!.pairedMember!.facts.outcome==worldRejected){
                frame!.facts <- frame!.pairedMember!.facts; stopFrame(request, frame); return()
            }
            if(applyMemberRequirement(request, frame)){return()}
            frame!.memberRequirements <- WorldRequirementCursor()
            if(frame!.pairedEmbedded and frame!.pairedMember!.facts.outcome==worldPartial){
                frame!.facts.outcome <- worldPartial; frame!.facts.detail <- frame!.pairedMember!.facts.detail; return()
            }
            if(!graph.appendMember(frame!.pairedSequence, frame!.pairedMember, frame!.pairedEmbedded)){
                request!.outcome <- worldError; request!.detail <- "List exceeds representable length"; return()
            }
            frame!.facts.contentsComplete <- frame!.facts.contentsComplete and graph.completeFacts(frame!.pairedMember!.facts, false)
            frame!.facts.representable <- frame!.facts.representable and graph.representableFacts(frame!.pairedMember!.facts)
            frame!.pairedMember <- NULL
        }
        me WorldMember: left <- frame!.leftMembers.nextMember(false)
        if(left.frame==NULL and frame!.extendingTail and frame!.openAlignment!=NULL){
            our WorldOpenAlignment: alignment <- frame!.openAlignment
            alignment!.pastGap <- true
            me int64: prefixIndex <- alignment!.leftPrefixCount+alignment!.addedPrefix
            me int64: extraSuffix <- alignment!.right!.suffixCount-alignment!.leftSuffixCount
            if(extraSuffix<0){extraSuffix <- 0}
            our WorldFrame: member
            frame!.pairedEmbedded <- false
            if(prefixIndex<alignment!.right!.prefixCount){
                member <- alignment!.right!.prefix[prefixIndex]; alignment!.addedPrefix <+- 1
            }else if(extraSuffix>0 and !alignment!.remainderAdded){
                // An incoming suffix moves the unresolved tail inside this
                // occurrence. Retain a symbolic span, never invent its width.
                member <- projectFrame(request, frame)
                Allocate(member!.facts.sequence); member!.facts.hasSize <- false
                member!.facts.openTail <- true; member!.facts.contentsComplete <- false
                member!.retainedWork.clear(); member!.listSpecFrame <- NULL; member!.listSpecEdge <- NULL
                member!.tailRequirements <- graph.joinRequirements(frame!.tailRequirements, alignment!.right!.gap!.tailRequirements)
                member!.finished <- true; frame!.pairedEmbedded <- true
                alignment!.remainderAdded <- true
            }else if(alignment!.addedSuffix<extraSuffix){
                member <- alignment!.right!.suffix[alignment!.addedSuffix]; alignment!.addedSuffix <+- 1
            }
            if(member!=NULL){
                frame!.pairedMember <- member
                if(!frame!.pairedEmbedded){
                    request!.tailMembers <+- 1; frame!.memberRequirements.push(frame!.tailRequirements)
                    applyMemberRequirement(request, frame)
                }
                return()
            }
            frame!.extendingTail <- false; frame!.facts.openTail <- extraSuffix==0
            if(frame!.facts.openTail){frame!.tailRequirements <- graph.joinRequirements(frame!.tailRequirements, alignment!.right!.gap!.tailRequirements)}
        }
        if(left.frame==NULL and frame!.extendingTail){
            // The closed source proved the extent. Continue its cursor for
            // the unique remainder; never enumerate from a declared size.
            our WorldFrame: member
            if(frame!.remaining>0){member <- frame!.rightMembers!.next()}
            if(member!=NULL){
                frame!.remaining <- frame!.remaining-1
                frame!.pairedEmbedded <- false; request!.tailMembers <+- 1
                frame!.pairedMember <- member
                frame!.memberRequirements.push(frame!.tailRequirements)
                applyMemberRequirement(request, frame)
                return()
            }
            frame!.extendingTail <- false; frame!.facts.openTail <- false
        }
        if(left.frame==NULL){
            frame!.facts.sequence <- frame!.pairedSequence; frame!.pairedSequence <- NULL
            frame!.pendingRequirements <- NULL
            if(!frame!.applyingListSpec and frame!.openAlignment==NULL and frame!.remaining!=0){
                request!.outcome <- worldError; request!.detail <- "Correspondence source ended before its checked extent"; return()
            }
            if(frame!.openAlignment!=NULL and graph.openLayout(frame!.facts) and frame!.openAlignment!.right!.gap!.tailRequirements!=NULL){
                // Future source requirements still need their containing
                // relationship in the stored partial result.
                frame!.facts.representable <- false
            }
            frame!.facts.dischargeListSpec <- frame!.facts.representable and !graph.openLayout(frame!.facts)
            if(!frame!.projected and !frame!.applyingListSpec and (frame!.retainSource or !frame!.facts.representable)){
                frame!.retainedWork.append(frame!.sourceEdge)
            }
            request!.sequenceVisits <+- frame!.leftMembers.visits
            if(frame!.ownsRightCursor){request!.sequenceVisits <+- frame!.rightMembers!.visits}
            frame!.leftMembers <- WorldListCursor(); frame!.rightMembers <- NULL; frame!.ownsRightCursor <- false
            if(frame!.lookup!.normalized){
                // Refining a captured value does not change which source
                // occurrence the selection identified for a later write.
                if(frame!.correspondenceResult==NULL){frame!.correspondenceResult <- frame!.lookup!.result}
                frame!.lookup <- NULL
            }
            frame!.corresponding <- false; frame!.applyingListSpec <- false; frame!.openAlignment <- NULL
        }else{
            our WorldFrame: pair
            if(left.embedded){
                // Preserve the left wrapper; its leaves continue the same RHS cursor.
                if(frame!.applyingListSpec){
                    pair <- resolveRequirements(request, left.frame, frame!.pendingRequirements)
                }else{
                    pair <- projectFrame(request, left.frame)
                    pair!.sourceEdge <- frame!.sourceEdge; pair!.rightMembers <- frame!.rightMembers
                    pair!.openAlignment <- frame!.openAlignment
                    me FlexNum: extent <- graph.minimumWidth(left.frame!.facts)
                    if(left.frame!.facts.hasSize){extent <- left.frame!.facts.size}
                    else if(graph.freeSpans(left.frame!.facts)>0){extent <+- frame!.gapWidth}
                    graph.beginCorrespondence(pair, extent)
                    frame!.remaining <- frame!.remaining-extent
                    if(pair!.facts.outcome==worldReady and pair!.openAlignment==NULL){pair!.facts.hasSize <- true; pair!.facts.size <- extent}
                }
            }else{
                if(frame!.applyingListSpec){
                    frame!.pairedMember <- left.frame; frame!.pairedEmbedded <- false
                    frame!.memberRequirements.push(frame!.pendingRequirements)
                    applyMemberRequirement(request, frame); return()
                }
                if(frame!.openAlignment!=NULL){
                    our WorldOpenAlignment: alignment <- frame!.openAlignment
                    our WorldFrame: right
                    if(!alignment!.pastGap){
                        if(alignment!.prefixPosition<alignment!.right!.prefixCount){right <- alignment!.right!.prefix[alignment!.prefixPosition]}
                        alignment!.prefixPosition <+- 1
                    }else{
                        me int64: index <- alignment!.suffixPosition+alignment!.right!.suffixCount-alignment!.leftSuffixCount
                        if(index>=0){right <- alignment!.right!.suffix[index]}
                        alignment!.suffixPosition <+- 1
                    }
                    if(right!=NULL){pair <- derivePair(request, left.frame, right, frame!.sourceEdge); request!.memberPairs <+- 1}
                    else{
                        frame!.pairedMember <- left.frame; frame!.pairedEmbedded <- false
                        frame!.memberRequirements.push(alignment!.right!.gap!.tailRequirements)
                        applyMemberRequirement(request, frame); return()
                    }
                }else{
                    our WorldFrame: right <- frame!.rightMembers!.next()
                    frame!.remaining <- frame!.remaining-1; request!.memberPairs <+- 1
                    pair <- derivePair(request, left.frame, right, frame!.sourceEdge)
                }
            }
            frame!.pairedMember <- pair; frame!.pairedEmbedded <- left.embedded
            request!.ready.append(pair)
        }
    }

    // One step either discovers one edge, consumes its result, or finishes a frame.
    void: waitAt(our WorldRequest: request, our WorldFrame: frame, our infonView: input) <- {
        request!.outcome <- worldWaiting; request!.waitingFrame <- frame; request!.waitingInput <- input
        if(!control!.inputWaiters.containsKey(input)){
            our WorldInputWaiters:: waiters; control!.inputWaiters.insert(input, waiters)
        }
        control!.inputWaiters.at(input)!.requests.append(request)
    }
    me bool: walkReady(our WorldRequest: request, our WorldFrame: frame, our WorldWalk: walk) <- {
        if(walk!.requestedLayout!=NULL){
            if(walk!.layoutFrame==NULL){
                walk!.layoutFrame <- makeFrame(request, walk!.requestedLayout!.node, walk!.requestedLayout)
                walk!.layoutFrame!.acquireOnly <- true
                walk!.layoutFrame!.referenceOnly <- true
                request!.ready.append(frame); request!.ready.append(walk!.layoutFrame); return(false)
            }
            if(walk!.layoutFrame!.facts.outcome!=worldReady){frame!.facts <- walk!.layoutFrame!.facts; stopFrame(request, frame); return(false)}
            our WorldCorrespondenceResult: result <- walk!.layoutFrame!.correspondenceResult
            if(result==NULL or result!.position==NULL){
                frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Path has not established one list occurrence"; stopFrame(request, frame); return(false)
            }
            if(graph.samePosition(result!.position, walk!.requestedLayout)){
                frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Cyclic path layout"; stopFrame(request, frame); return(false)
            }
            walk!.levels.last()!.position <- result!.position
            walk!.requestedLayout <- NULL; walk!.layoutFrame <- NULL
            walk!.outcome <- worldReady; walk!.detail <- ""
            request!.ready.append(frame); return(false)
        }

        if(walk!.outcome==worldReady){return(true)}
        if(walk!.outcome==worldWaiting){waitAt(request, frame, walk!.waiting)}
        else{frame!.facts.outcome <- walk!.outcome; frame!.facts.detail <- walk!.detail; stopFrame(request, frame)}
        return(false)
    }
    // Intersection syntax only exposes the selected occurrence and its input
    // relationship. That occurrence uses ordinary RHS discovery and solving.
    void: selectMember(our WorldRequest: request, our WorldFrame: frame) <- {
        our infonView: item <- frame!.node!.pItem
        if(frame!.selection==NULL){
            me WorldScalar: header <- graph.read(request, frame!.node, frame!.expressionParent, false, true)
            if(header.outcome==worldWaiting){waitAt(request, frame, item); return()}
            if(header.outcome!=worldReady){frame!.facts <- header; stopFrame(request, frame); return()}
            if(item!.innr!=NULL and (item!.innr!.value==NULL or item!.innr!.infSize==NULL)){
                frame!.facts.outcome <- worldError; frame!.facts.detail <- "Missing intersection body state"; stopFrame(request, frame); return()
            }
            if(item!.innr==NULL or item!.type!=NULL or !item!.addedTypes.isEmpty() or
               item!.invertMatch or item!.funcArgs!=NULL or item!.argPos!=apNoArgs or item!.partRef!=NULL or !item!.parts.isEmpty()){
                frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Intersection needs additional selection semantics"; stopFrame(request, frame); return()
            }
            our POV:: body{936}; body!.pItem <- item!.innr
            me WorldScalar: bodyHeader <- graph.read(request, body, NULL, item!.hasInnrOutr)
            if(bodyHeader.outcome==worldWaiting){waitAt(request, frame, item!.innr); return()}
            if(bodyHeader.outcome!=worldReady){frame!.facts <- bodyHeader; stopFrame(request, frame); return()}
            Allocate(frame!.selection)
            frame!.selection!.oneOf <- item!.isOrLike()
            our WorldPosition: root <- graph.position(body)
            if(item!.hasInnrOutr and item!.innr!.funcArgs!=NULL and item!.innr!.argPos==apNoArgs){
                Allocate(root!.input, 936); root!.input!.pItem <- item!.innr!.funcArgs; root!.input!.looseTop <- true
            }
            if(frame!.selection!.oneOf and root!.input!=NULL){
                // An unconstrained open domain denotes each input alternative.
                // Patterned domains need correlated template/input matching.
                if(item!.innr!.value!.items.head!=NULL or !item!.innr!.value!.tailUnfinished or
                   item!.innr!.value!.listSpec!=NULL or !item!.innr!.wrkList.isEmpty()){
                    frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "One-of input needs patterned domain matching"; stopFrame(request, frame); return()
                }
                root <- graph.position(root!.input)
            }
            frame!.selection!.domain <- root; frame!.selection!.walk!.push(root)
            frame!.selection!.walk!.stopAt <- item!.intersectMarkedRetPOV
            // An unbounded, unconstrained return position contributes no facts
            // of its own. Its supplied RHSs use the ordinary merge operation.
            if(!frame!.selection!.oneOf and item!.intersectPos==ipGetLast and
               root!.input==NULL and !bodyHeader.hasSize and !bodyHeader.explicitSize and
               item!.innr!.value!.tailUnfinished and item!.innr!.value!.items.head==NULL and
               item!.innr!.value!.listSpec==NULL and item!.innr!.wrkList.isEmpty()){
                frame!.selection!.openResult <- true; frame!.initialized <- true; frame!.expressionSlot <- 3
                request!.ready.append(frame); return()
            }
            if(frame!.selection!.oneOf){
                Allocate(frame!.facts.alternatives); frame!.selection!.walk!.checkExtents <- true; frame!.selection!.walk!.requireClosedRelations <- true
            }
            else if(item!.innr!.value!.sizeMode==fromGiven){
                if(item!.innr!.infSize!.evalMode==emLiteral){
                    if(item!.innr!.infSize!.num==0 or item!.innr!.infSize!.num.getDenominator()!=1){
                        frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Selection needs a nonzero integer position"; stopFrame(request, frame); return()
                    }
                    frame!.selection!.index <- item!.innr!.infSize!.num
                }else{
                    our POV:: coordinate{940}; Allocate(coordinate!.pItem)
                    coordinate!.pItem!.itmMode <- mItem; coordinate!.pItem!.streamState <- parseDone
                    coordinate!.pItem!.value <- item!.innr!.infSize
                    coordinate!.pItem!.infSize!.overlayType <- NUM; coordinate!.pItem!.infSize!.evalMode <- emUnknown
                    frame!.selection!.coordinate <- makeFrame(request, coordinate)
                }
            }else if(item!.intersectPos==ipGetFirst){frame!.selection!.index <- 1}
        }
        our WorldSelection: selection <- frame!.selection
        if(selection!.oneOf){collectAlternatives(request, frame); return()}
        if(selection!.coordinate!=NULL){
            if(!selection!.coordinate!.finished){request!.ready.append(frame); request!.ready.append(selection!.coordinate); return()}
            me WorldScalar: index <- selection!.coordinate!.facts
            if(index.outcome!=worldReady){frame!.facts <- index; stopFrame(request, frame); return()}
            if(index.overlay!=NUM or !index.hasValue or index.number==0 or index.number.getDenominator()!=1){
                frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Selection needs a known nonzero integer coordinate"; stopFrame(request, frame); return()
            }
            selection!.index <- index.number; selection!.coordinate <- NULL
        }
        if(selectUnitPattern(request, frame)){return()}
        if(selection!.index<0){
            if(selection!.domain!.input==NULL){frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "End-relative pattern needs a source endpoint"; stopFrame(request, frame); return()}
            our POV: source <- selection!.domain!.input
            me WorldScalar: endpoint <- graph.read(request, source, source!.pParent)
            if(endpoint.outcome==worldWaiting){waitAt(request, frame, source!.pItem); return()}
            if(endpoint.outcome!=worldReady){frame!.facts <- endpoint; stopFrame(request, frame); return()}
            if(!endpoint.hasSize or endpoint.size<0 or endpoint.size.getDenominator()!=1 or endpoint.size+selection!.index<0){
                frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "End-relative pattern needs a sufficient known endpoint"; stopFrame(request, frame); return()
            }
            selection!.domain <- graph.offsetDomain(selection!.domain, endpoint.size+selection!.index)
            their POV: marked <- selection!.walk!.stopAt
            Allocate(selection!.walk); selection!.walk!.push(selection!.domain); selection!.walk!.stopAt <- marked
            selection!.index <- 0
        }
        selection!.walk!.stopIndex <- selection!.index
        while(!selection!.located){
            our WorldPosition: at <- graph.nextPosition(request, selection!.walk)
            if(!walkReady(request, frame, selection!.walk)){return()}
            if(at==NULL){
                if(selection!.lastTail or (item!.intersectPos==ipGetMarked and selection!.selected==NULL)){
                    frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Selected position needs open-span selection"; stopFrame(request, frame); return()
                }
                if(selection!.selected==NULL){
                    frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Selected position is not established"; stopFrame(request, frame); return()
                }
                selection!.located <- true; break()
            }
            if(at!.tail){
                if(selection!.index>0){frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Indexed selection crosses an unknown span"; stopFrame(request, frame); return()}
                selection!.lastTail <- true; continue()
            }
            selection!.position <- selection!.walk!.position; selection!.lastTail <- false
            if(item!.intersectPos==ipGetMarked){
                if(at!.node===item!.intersectMarkedRetPOV or at!.node===item!.innr!.intersectMarkedRetPOV){selection!.selected <- at; selection!.located <- true}
            }else if(selection!.index>0){
                if(selection!.position==selection!.index){selection!.selected <- at; selection!.located <- true}
            }else{selection!.selected <- at}
        }
        frame!.prerequisite <- makeFrame(request, selection!.selected!.node, selection!.selected, frame!.demandSize)
        frame!.prerequisite!.acquireOnly <- frame!.acquireOnly
        frame!.prerequisite!.referenceOnly <- frame!.referenceOnly
        frame!.selecting <- true; frame!.initialized <- true; frame!.expressionSlot <- 3
        request!.ready.append(frame); request!.ready.append(frame!.prerequisite)
    }

    // A finite alternative domain uses the ordinary structural cursor and
    // scalar frames. Unknown candidates remain candidates, never rejections.
    void: collectAlternatives(our WorldRequest: request, our WorldFrame: frame) <- {
        our WorldSelection: selection <- frame!.selection
        if(!selection!.domainChecked){
            our POV: domain <- selection!.domain!.node
            me WorldScalar: header <- graph.read(request, domain, domain!.pParent)
            if(header.outcome==worldWaiting){waitAt(request, frame, domain!.pItem); return()}
            if(header.outcome!=worldReady){frame!.facts <- header; stopFrame(request, frame); return()}
            if(!domain!.pItem!.wrkList.isEmpty()){
                frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "One-of domain has unresolved layout relationships"; stopFrame(request, frame); return()
            }
            selection!.domainChecked <- true
        }
        if(selection!.candidate!=NULL){
            our WorldFrame: candidate <- selection!.candidate
            if(candidate!.facts.outcome!=worldRejected){
                if(candidate!.facts.outcome!=worldReady){frame!.facts <- candidate!.facts; stopFrame(request, frame); return()}
                if(candidate!.facts.overlay==LST or !candidate!.retainedWork.isEmpty()){
                    frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "One-of alternatives need structured or retained-work semantics"; stopFrame(request, frame); return()
                }
                if(candidate!.facts.alternatives!=NULL){
                    withEach branch in candidate!.facts.alternatives!.members{frame!.facts.alternatives!.members.append(branch)}
                }else{frame!.facts.alternatives!.members.append(candidate)}
            }
            selection!.candidate <- NULL
        }
        our WorldPosition: at <- graph.nextPosition(request, selection!.walk)
        if(!walkReady(request, frame, selection!.walk)){return()}
        if(at==NULL){
            if(frame!.facts.alternatives!.members.isEmpty()){
                frame!.facts.outcome <- worldRejected; frame!.facts.detail <- "No viable alternative"; stopFrame(request, frame); return()
            }
            frame!.initialized <- true; frame!.expressionSlot <- 3; request!.ready.append(frame); return()
        }
        if(at!.tail){
            frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "One-of domain still has an open remainder"; stopFrame(request, frame); return()
        }
        selection!.candidate <- makeFrame(request, at!.node, at)
        request!.ready.append(frame); request!.ready.append(selection!.candidate)
    }

    // Each pair is the existing merge operation. The two indices and in-flight
    // pair survive waits. In particular, later RHSs filter the surviving OR,
    // rather than starting again from the original domain.
    void: mergeAlternatives(our WorldRequest: request, our WorldFrame: frame) <- {
        if(frame!.sourceEdge!.trueByDefinition and frame!.prerequisite!.facts.alternatives!=NULL and
           frame!.facts.overlay<0 and !frame!.facts.hasSize and !frame!.facts.hasValue and
           !frame!.facts.negative and frame!.facts.pendingChecks==NULL){
            frame!.facts <- frame!.prerequisite!.facts; frame!.prerequisite <- NULL
            request!.ready.append(frame); return()
        }
        if(frame!.choiceMerge==NULL){
            Allocate(frame!.choiceMerge)
            our WorldChoiceMerge: merge <- frame!.choiceMerge
            merge!.left <- frame!.facts.alternatives; merge!.right <- frame!.prerequisite!.facts.alternatives
            if(merge!.left==NULL){Allocate(merge!.left); merge!.left!.members.append(projectFrame(request, frame))}
            if(merge!.right==NULL){Allocate(merge!.right); merge!.right!.members.append(frame!.prerequisite)}
            Allocate(merge!.result); merge!.edge <- frame!.sourceEdge
            // Outer constraints descend into a target domain. A source OR
            // supplies alternative RHS values under the original relationship.
            if(frame!.facts.alternatives!=NULL){merge!.edge <- graph.memberRelationship(frame!.sourceEdge)}
        }
        our WorldChoiceMerge: merge <- frame!.choiceMerge
        if(merge!.pair!=NULL){
            if(merge!.pair!.facts.outcome!=worldRejected){
                if(merge!.pair!.facts.outcome!=worldReady){frame!.facts <- merge!.pair!.facts; stopFrame(request, frame); return()}
                merge!.result!.members.append(merge!.pair)
            }
            merge!.pair <- NULL; merge!.rhs <+- 1
            if(merge!.rhs==merge!.right!.members.size()){merge!.rhs <- 0; merge!.lhs <+- 1}
        }
        if(merge!.lhs==merge!.left!.members.size()){
            frame!.facts <- WorldScalar(); frame!.facts.alternatives <- merge!.result
            frame!.prerequisite <- NULL; frame!.choiceMerge <- NULL
            if(frame!.facts.alternatives!.members.isEmpty()){
                frame!.facts.outcome <- worldRejected; frame!.facts.detail <- "No alternative satisfies the relationship"; stopFrame(request, frame); return()
            }
            request!.ready.append(frame); return()
        }
        merge!.pair <- derivePair(request, merge!.left!.members[merge!.lhs], merge!.right!.members[merge!.rhs], merge!.edge)
        request!.alternativePairs <+- 1
        request!.ready.append(frame); request!.ready.append(merge!.pair)
    }
    // Identical proved scalar results do not represent different answers.
    // Compare to the first result once; no quadratic duplicate search.
    void: settleAlternatives(our WorldFrame: frame) <- {
        if(frame!.facts.alternatives==NULL){return()}
        our WorldFrame: first <- frame!.facts.alternatives!.members[0]
        if(frame!.facts.alternatives!.members.size()>1){
            if((first!.facts.overlay!=NUM and first!.facts.overlay!=STR) or !graph.completeFacts(first!.facts, false)){return()}
            withEach member in frame!.facts.alternatives!.members{
                if(!graph.completeFacts(member!.facts, false) or first!.facts.hasSize!=member!.facts.hasSize or
                   graph.compare(first!.facts, member!.facts)!=worldReady or graph.compare(member!.facts, first!.facts)!=worldReady){return()}
            }
        }
        frame!.facts <- first!.facts; frame!.retainedWork <- first!.retainedWork
        graph.adoptListRequirements(frame, first)
    }

    void: supplyCorrespondence(our WorldRequest: request, our WorldFrame: frame) <- {
        our WorldCorrespondence: lookup <- frame!.lookup
        if(frame!.referenceOnly){
            frame!.correspondenceResult <- lookup!.result; frame!.lookup <- NULL
            frame!.finished <- true; return()
        }
        our POV: edge <- graph.memberRelationship(lookup!.query!.relation); edge!.pItem <- lookup!.result!.position!.node!.pItem
        if(lookup!.query!.testPattern and (frame!.facts.negative or graph.rangePredicate(frame!.facts) or graph.typePredicate(frame!.facts))){
            if(lookup!.result!.facts==NULL){
                lookup!.result!.facts <- makeFrame(request, lookup!.result!.position!.node, lookup!.result!.position)
                lookup!.result!.facts!.acquireOnly <- frame!.acquireOnly
                if(lookup!.accepted!=NULL and lookup!.accepted!.capture!=NULL){lookup!.accepted!.capture!.facts <- lookup!.result!.facts}
                request!.ready.append(frame); request!.ready.append(lookup!.result!.facts); return()
            }
            frame!.facts <- graph.matchPosition(frame!.facts, lookup!.result!.facts!.facts, edge)
            frame!.contextual <- frame!.contextual or lookup!.result!.facts!.contextual
            if(frame!.facts.overlay==LST){graph.adoptListRequirements(frame, lookup!.result!.facts)}
            frame!.correspondenceResult <- lookup!.result; frame!.lookup <- NULL
            request!.ready.append(frame); return()
        }
        frame!.sourceEdge <- edge; frame!.sourceIsOperand <- false; frame!.sourceIsListSpec <- false
        frame!.prerequisite <- lookup!.result!.facts
        if(frame!.prerequisite==NULL){frame!.prerequisite <- makeFrame(request, lookup!.result!.position!.node, lookup!.result!.position)}
        frame!.prerequisite!.acquireOnly <- frame!.acquireOnly
        frame!.correspondenceResult <- lookup!.result
        frame!.lookup <- NULL; request!.relationshipsRead <+- 1
        request!.ready.append(frame)
        if(!frame!.prerequisite!.finished){request!.ready.append(frame!.prerequisite)}
    }
    our WorldMatch: advanceMatch(our WorldMatch: state, me int64: slot) <- {
        our WorldMatch:: result; result! <- state!; result!.slot <- slot
        return(result)
    }
    void: joinMatch(our WorldRequest: request, our WorldMatch: into, our WorldMatch: from) <- {
        // A selected occurrence needs only capture ambiguity. Whole-list
        // requests additionally retain the distinct member/span assignments.
        into!.ambiguous <- into!.ambiguous or from!.ambiguous or into!.capture!==from!.capture
        if(into!.mapping!==from!.mapping){
            our WorldMapping:: choice
            choice!.choice <- true; choice!.prior <- into!.mapping; choice!.alternative <- from!.mapping
            into!.mapping <- choice; into!.ambiguous <- true; request!.correspondenceMappings <+- 1
        }
    }
    // Compile checked target members into the same chart predicates. Embedded
    // occurrences get derived frames so their proved extents stay independent,
    // including two occurrences that borrow the same underlying model.
    me bool: prepareListPattern(our WorldRequest: request, our WorldFrame: frame) <- {
        our WorldCorrespondence: lookup <- frame!.lookup
        if(graph.openLayout(frame!.facts) and frame!.facts.hasSize){
            frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Pattern has a constrained open extent"; stopFrame(request, frame); return(false)
        }
        lookup!.layout <- projectFrame(request, frame); lookup!.layouts.append(lookup!.layout)
        me List<our WorldOpenScan>: pending
        our WorldOpenScan:: root; root!.frame <- lookup!.layout
        root!.members.push(frame!.facts.sequence); Allocate(root!.frame!.facts.sequence); pending.append(root)
        while(!pending.isEmpty()){
            our WorldOpenScan: scan <- pending.last()
            me WorldMember: member <- scan!.members.nextMember(false)
            if(member.frame==NULL){
                request!.sequenceVisits <+- scan!.members.visits; pending.popLast()
                if(scan!.frame!.facts.openTail){
                    our WorldPattern:: token; token!.owner <- scan!.frame
                    token!.position <- graph.position(scan!.frame!.node); token!.position!.tail <- true
                    me WorldRequirementCursor: requirements; requirements.push(scan!.frame!.tailRequirements)
                    our WorldRequirement: requirement <- requirements.next()
                    while(requirement!=NULL){token!.requirements.append(requirement); requirement <- requirements.next()}
                    request!.requirementVisits <+- requirements.visits
                    if(token!.requirements.isEmpty()){
                        Allocate(token!.predicate); token!.predicate!.initialized <- true; token!.predicate!.finished <- true
                    }else{token!.predicate <- token!.requirements[0]!.frame}
                    lookup!.pattern.append(token)
                }
            }else if(member.embedded){
                our WorldFrame: child <- projectFrame(request, member.frame)
                if(!child!.retainedWork.isEmpty()){
                    frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Pattern span still has unresolved relationships"; stopFrame(request, frame); return(false)
                }
                if(graph.openLayout(child!.facts) and child!.facts.hasSize){
                    frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Pattern has a constrained open extent"; stopFrame(request, frame); return(false)
                }
                graph.appendMember(scan!.frame!.facts.sequence, child, true); lookup!.layouts.append(child)
                our WorldOpenScan:: next; next!.frame <- child; next!.members.push(child!.facts.sequence)
                Allocate(child!.facts.sequence); pending.append(next)
            }else{
                graph.appendMember(scan!.frame!.facts.sequence, member.frame)
                our WorldPattern:: token; token!.predicate <- member.frame; token!.position <- graph.position(member.frame!.node)
                lookup!.pattern.append(token)
            }
        }
        lookup!.patternDone <- true; return(true)
    }
    // Replay only the accepted bindings, never the matcher. Known widths feed
    // ordinary list correspondence; its derived pairs and staged publication
    // remain the only way values reach the target.
    void: supplyListCorrespondence(our WorldRequest: request, our WorldFrame: frame) <- {
        our WorldCorrespondence: lookup <- frame!.lookup
        if(!lookup!.materializing){
            our WorldMapping: mapping <- lookup!.accepted!.mapping
            while(mapping!=NULL){
                lookup!.mapped.append(mapping)
                our WorldPattern: token <- lookup!.pattern[mapping!.slot]
                if(token!.position!.tail){token!.owner!.remaining <+- 1}
                mapping <- mapping!.prior
            }
            while(!lookup!.layouts.isEmpty()){
                our WorldFrame: layout <- lookup!.layouts.popLast()
                me WorldListCursor: members; members.push(layout!.facts.sequence); Allocate(layout!.facts.sequence)
                me WorldMember: member <- members.nextMember(false)
                while(member.frame!=NULL){graph.appendMember(layout!.facts.sequence, member.frame, member.embedded); member <- members.nextMember(false)}
                request!.sequenceVisits <+- members.visits
                me FlexNum: extent <- graph.minimumWidth(layout!.facts)+layout!.remaining
                if(layout!.facts.hasSize and layout!.facts.size!=extent){
                    frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Matched pattern extent differs from its given size"; stopFrame(request, frame); return()
                }
                layout!.facts.hasSize <- true; layout!.facts.size <- extent
            }
            Allocate(lookup!.supplied); lookup!.supplied!.node <- lookup!.query!.relation
            lookup!.supplied!.initialized <- true; lookup!.supplied!.finished <- true
            lookup!.supplied!.facts.overlay <- LST; lookup!.supplied!.facts.hasValue <- true
            lookup!.supplied!.facts.hasSize <- true; lookup!.supplied!.facts.size <- lookup!.mapped.size()
            Allocate(lookup!.supplied!.facts.sequence); request!.framesCreated <+- 1
            lookup!.materializing <- true
        }
        while(!lookup!.mapped.isEmpty()){
            our WorldCapture: capture <- lookup!.mapped.last()!.capture
            if(capture!.facts==NULL){
                capture!.facts <- makeFrame(request, capture!.position!.node, capture!.position)
                request!.ready.append(frame); request!.ready.append(capture!.facts); return()
            }
            if(capture!.facts!.facts.outcome!=worldReady){frame!.facts <- capture!.facts!.facts; stopFrame(request, frame); return()}
            graph.appendMember(lookup!.supplied!.facts.sequence, capture!.facts)
            lookup!.supplied!.facts.contentsComplete <- lookup!.supplied!.facts.contentsComplete and graph.completeFacts(capture!.facts!.facts, false)
            lookup!.supplied!.facts.representable <- lookup!.supplied!.facts.representable and graph.representableFacts(capture!.facts!.facts)
            lookup!.mapped.popLast()
        }
        lookup!.result!.bindings <- lookup!.accepted!.mapping
        frame!.correspondenceResult <- lookup!.result
        frame!.facts <- lookup!.layout!.facts; frame!.sourceEdge <- lookup!.memberEdge
        frame!.prerequisite <- lookup!.supplied; frame!.lookup <- NULL
        request!.ready.append(frame)
    }
    // Only this demanded candidate is evaluated. Pure type predicates can use
    // its header, including the type of an ordinary list with unknown contents.
    me bool: correspondenceCandidate(our WorldRequest: request, our WorldFrame: frame,
                                    me WorldScalar: predicate, their WorldScalar: actual) <- {
        our WorldCorrespondence: lookup <- frame!.lookup
        me bool: headerOnly <- (graph.typePredicate(predicate) or predicate.nominal!=NULL) and lookup!.rhs!.node!.pItem!.wrkList.isEmpty()
        our WorldPosition: parent <- lookup!.rhs!.parent
        while(headerOnly and parent!=NULL){
            if(parent!.node!.pItem!.value!.listSpec!=NULL or !parent!.node!.pItem!.wrkList.isEmpty() or parent!.input!=NULL){headerOnly <- false}
            if(!parent!.embedded){break()}
            parent <- parent!.parent
        }
        if(headerOnly){
            actual! <- graph.read(request, lookup!.rhs!.node, lookup!.rhs!.node!.pParent)
            if(actual!.outcome==worldWaiting){waitAt(request, frame, lookup!.rhs!.node!.pItem); return(false)}
            // A different nominal type disproves this candidate even when the
            // selected pattern also asks for a value. Do not evaluate a known
            // nonmatch merely to prove the same mismatch again with more facts.
            if(actual!.outcome==worldReady and graph.compareNames(predicate, actual!)!=worldRejected and
               (!graph.typePredicate(predicate) or graph.compareNames(predicate, actual!)!=worldReady or
                (actual!.overlay<0 and !(predicate.nominal!=NULL and actual!.nominal!=NULL)))){headerOnly <- false}
        }
        if(!headerOnly){
            if(lookup!.candidate==NULL){
                lookup!.candidate <- makeFrame(request, lookup!.rhs!.node, lookup!.rhs)
                lookup!.candidate!.acquireOnly <- predicate.overlay==LST
                if(lookup!.capture!=NULL){lookup!.capture!.facts <- lookup!.candidate}
                request!.ready.append(frame); request!.ready.append(lookup!.candidate); return(false)
            }
            actual! <- lookup!.candidate!.facts
        }
        return(true)
    }
    // A streaming chart over the same borrowed positions used by assertions.
    // Each pattern/source pair is checked once; epsilon exits do not consume
    // input. Rejection removes one branch, never a viable sibling branch.
    void: matchCorrespondence(our WorldRequest: request, our WorldFrame: frame) <- {
        our WorldCorrespondence: lookup <- frame!.lookup
        if(lookup!.materializing){supplyListCorrespondence(request, frame); return()}
        if(!lookup!.started){
            if(lookup!.query!.allMembers){
                if(!graph.enterLayout(request, lookup!.right)){walkReady(request, frame, lookup!.right); return()}
                if(!prepareListPattern(request, frame)){return()}
            }
            Allocate(lookup!.branch); lookup!.branch!.capture <- lookup!.priorCapture; lookup!.started <- true
        }
        while(true){
            if(lookup!.branch==NULL){
                if(lookup!.checking){
                    if(lookup!.cursor<lookup!.consuming.size()){
                        lookup!.branch <- lookup!.consuming[lookup!.cursor]; lookup!.cursor <+- 1
                    }else{
                        lookup!.active <- lookup!.following; lookup!.following.clear(); lookup!.consuming.clear()
                        lookup!.cursor <- 0; lookup!.checking <- false
                        lookup!.rhs <- NULL; lookup!.candidate <- NULL; lookup!.capture <- NULL; continue()
                    }
                }else if(lookup!.epsilon!=NULL){lookup!.branch <- lookup!.epsilon; lookup!.epsilon <- NULL}
                else if(lookup!.cursor<lookup!.active.size()){
                    lookup!.branch <- lookup!.active[lookup!.cursor]; lookup!.cursor <+- 1
                }else{
                    // Close zero-width exits before requesting another source.
                    // An accepted capture is final if no live continuation can
                    // select a different occurrence. Optional suffix work ends.
                    me bool: determined <- !lookup!.query!.allMembers and lookup!.accepted!=NULL and lookup!.accepted!.capture!=NULL
                    withEach state in lookup!.consuming{
                        if(!determined){break()}
                        if(state!.ambiguous or state!.capture!==lookup!.accepted!.capture){determined <- false}
                    }
                    if(determined or lookup!.consuming.isEmpty() or (lookup!.accepted!=NULL and lookup!.accepted!.ambiguous)){
                        if(lookup!.accepted==NULL or (!lookup!.query!.allMembers and lookup!.accepted!.capture==NULL) or lookup!.accepted!.ambiguous){
                            frame!.facts.outcome <- worldPartial
                            frame!.facts.detail <- "Pattern leaves the selected correspondence unresolved"
                            if(lookup!.query!.allMembers){frame!.facts.detail <- "Pattern leaves several member or span mappings possible"}
                            if(lookup!.accepted==NULL and !lookup!.sourceDone){
                                frame!.facts.outcome <- worldRejected; frame!.facts.detail <- "No pattern correspondence matches"
                            }
                            stopFrame(request, frame); return()
                        }
                        if(!lookup!.right!.listTypeProved){
                            frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Correspondence still needs the source list type"
                            stopFrame(request, frame); return()
                        }
                        if(lookup!.query!.allMembers){supplyListCorrespondence(request, frame); return()}
                        lookup!.result!.position <- lookup!.accepted!.capture!.position; lookup!.result!.facts <- lookup!.accepted!.capture!.facts
                        supplyCorrespondence(request, frame); return()
                    }
                    lookup!.checking <- true; lookup!.cursor <- 0; continue()
                }
            }
            our WorldMatch: branch <- lookup!.branch
            if(!lookup!.checking){
                if(branch!.slot==lookup!.pattern.size() and !lookup!.patternDone){
                    our WorldPosition: at <- graph.nextPosition(request, lookup!.left)
                    if(!walkReady(request, frame, lookup!.left)){return()}
                    if(at==NULL){lookup!.patternDone <- true}
                    else{
                        if(at!.tail and at!.node!.pItem!.value!.sizeMode==fromGiven){
                            frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Requested correspondence crosses an unresolved pattern span"; stopFrame(request, frame); return()
                        }
                        our WorldPattern:: token; token!.position <- at; lookup!.pattern.append(token)
                    }
                }
                if(branch!.slot==lookup!.pattern.size()){
                    if(lookup!.accepted==NULL){lookup!.accepted <- branch}
                    else{joinMatch(request, lookup!.accepted, branch)}
                }else{
                    if(lookup!.pattern[branch!.slot]!.position!.tail){
                        our WorldMatch: exit <- advanceMatch(branch, branch!.slot+1)
                        if(lookup!.cursor<lookup!.active.size() and lookup!.active[lookup!.cursor]!.slot==exit!.slot){joinMatch(request, lookup!.active[lookup!.cursor], exit)}
                        else{lookup!.epsilon <- exit}
                    }
                    lookup!.consuming.append(branch)
                }
                lookup!.branch <- NULL; continue()
            }
            our WorldPattern: token <- lookup!.pattern[branch!.slot]
            me bool: repeated <- token!.position!.tail
            if(lookup!.rhs==NULL and !lookup!.sourceDone){
                lookup!.rhs <- graph.nextPosition(request, lookup!.right)
                if(!walkReady(request, frame, lookup!.right)){return()}
                lookup!.sourceDone <- lookup!.rhs==NULL
            }
            if(lookup!.sourceDone){lookup!.branch <- NULL; continue()}
            if(lookup!.rhs!.tail){
                frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Correspondence needs more source positions"; stopFrame(request, frame); return()
            }
            me bool: selected <- !repeated and graph.samePosition(token!.position, lookup!.query!.target)
            if(token!.predicate==NULL){
                if(selected){token!.predicate <- projectFrame(request, frame); token!.predicate!.finished <- true}
                else{
                    if(repeated){
                        our infonView: listSpec <- token!.position!.node!.pItem!.value!.listSpec
                        if(listSpec==NULL){
                            Allocate(token!.predicate); token!.predicate!.initialized <- true; token!.predicate!.finished <- true
                        }else{
                            our POV:: spec{937}; spec!.pItem <- listSpec
                            token!.predicate <- makeFrame(request, spec)
                        }
                    }else{
                        token!.predicate <- makeFrame(request, token!.position!.node, token!.position)
                    }
                    token!.predicate!.predicateOnly <- true
                    request!.ready.append(frame); request!.ready.append(token!.predicate); return()
                }
            }
            our WorldFrame: predicate <- token!.predicate
            our POV: edge <- lookup!.memberEdge
            if(lookup!.query!.allMembers and repeated and !token!.requirements.isEmpty()){
                predicate <- token!.requirements[lookup!.predicateIndex]!.frame
                edge <- token!.requirements[lookup!.predicateIndex]!.edge
            }
            me WorldScalar: actual
            if(!correspondenceCandidate(request, frame, predicate!.facts, actual)){return()}
            request!.correspondenceChecks <+- 1
            me WorldScalar: matched <- graph.matchPosition(predicate!.facts, actual, edge, repeated)
            if(matched.outcome==worldRejected){lookup!.branch <- NULL; lookup!.predicateIndex <- 0; continue()}
            if(matched.outcome!=worldReady or matched.needsEvidence){
                frame!.facts.outcome <- matched.outcome; frame!.facts.detail <- matched.detail
                if(matched.needsEvidence){frame!.facts.outcome <- worldPartial}
                stopFrame(request, frame); return()
            }
            lookup!.predicateIndex <+- 1
            if(lookup!.predicateIndex<token!.requirements.size()){continue()}
            lookup!.predicateIndex <- 0
            me int64: destination <- branch!.slot+1
            if(repeated){destination <- branch!.slot}
            our WorldMatch: next <- advanceMatch(branch, destination)
            if(selected or lookup!.query!.allMembers){
                if(lookup!.capture==NULL){
                    Allocate(lookup!.capture); lookup!.capture!.position <- lookup!.rhs; lookup!.capture!.facts <- lookup!.candidate
                }
                if(selected){next!.capture <- lookup!.capture}
                if(lookup!.query!.allMembers){
                    our WorldMapping:: mapping; mapping!.prior <- branch!.mapping
                    mapping!.slot <- branch!.slot; mapping!.capture <- lookup!.capture
                    next!.mapping <- mapping; request!.correspondenceMappings <+- 1
                }
            }
            if(!lookup!.following.isEmpty() and lookup!.following.last()!.slot==destination){joinMatch(request, lookup!.following.last(), next)}
            else{lookup!.following.append(next)}
            lookup!.branch <- NULL
        }
    }
    // Fixed coordinates supply a span as one borrowed RHS. The two cursors
    // advance once; a known-width unconstrained prefix needs no virtual items.
    void: locateSpanRHS(our WorldRequest: request, our WorldFrame: frame) <- {
        our WorldCorrespondence: lookup <- frame!.lookup
        if(!lookup!.started){
            if(!graph.enterLayout(request, lookup!.right)){walkReady(request, frame, lookup!.right); return()}
            lookup!.started <- true
        }
        while(true){
            if(lookup!.lhs==NULL){
                if(!lookup!.captured or lookup!.query!.testPattern){lookup!.lhs <- graph.nextPosition(request, lookup!.left)}
                if(!walkReady(request, frame, lookup!.left)){return()}
                if(lookup!.lhs==NULL or (lookup!.captured and !lookup!.query!.testPattern)){
                    if(!lookup!.captured){frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Selected span has no established coordinates"; stopFrame(request, frame); return()}
                    if(!lookup!.right!.listTypeProved){
                        frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Correspondence still needs the source list type"
                        stopFrame(request, frame); return()
                    }
                    if(!lookup!.query!.target!.embedded){supplyCorrespondence(request, frame); return()}
                    frame!.sourceEdge <- lookup!.memberEdge; frame!.prerequisite <- lookup!.supplied
                    frame!.correspondenceResult <- lookup!.result
                    frame!.lookup <- NULL; request!.relationshipsRead <+- 1; request!.ready.append(frame); return()
                }
            }
            if(lookup!.remaining==0){
                our WorldPosition: at <- lookup!.lhs
                if(graph.samePosition(at, lookup!.query!.target)){
                    if(at!.embedded and (!frame!.facts.hasSize or frame!.facts.size<0 or frame!.facts.size.getDenominator()!=1)){
                        frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Selected span needs a known nonnegative extent"; stopFrame(request, frame); return()
                    }
                    lookup!.capturing <- true; lookup!.result!.span <- at!.embedded
                    if(at!.embedded){lookup!.remaining <- frame!.facts.size}else{lookup!.remaining <+- 1}
                    if(at!.embedded){
                        Allocate(lookup!.supplied); lookup!.supplied!.node <- lookup!.query!.relation
                        lookup!.supplied!.initialized <- true; lookup!.supplied!.finished <- true
                        lookup!.supplied!.facts.overlay <- LST; lookup!.supplied!.facts.hasValue <- true
                        lookup!.supplied!.facts.hasSize <- true; lookup!.supplied!.facts.size <- frame!.facts.size
                        Allocate(lookup!.supplied!.facts.sequence); request!.framesCreated <+- 1
                    }
                }else{
                    me bool: contains <- false
                    our WorldPosition: ancestor <- lookup!.query!.target!.parent
                    while(ancestor!=NULL){
                        if(graph.samePosition(at, ancestor)){contains <- true; break()}
                        ancestor <- ancestor!.parent
                    }
                    if(contains){lookup!.left!.push(at); lookup!.lhs <- NULL; continue()}
                    if(at!.tail){
                        if(at!.node!.pItem!.value!.sizeMode==fromGiven){
                            frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Counted template needs bounded predicate propagation"; stopFrame(request, frame); return()
                        }
                        // The traversed prefix already proved its coordinates.
                        // Continue the chart at this first variable-width event;
                        // neither cursor nor any completed predicate is replayed.
                        if(lookup!.captured){
                            Allocate(lookup!.priorCapture)
                            lookup!.priorCapture!.position <- lookup!.result!.position
                            lookup!.priorCapture!.facts <- lookup!.result!.facts
                            if(lookup!.query!.target!.embedded){
                                lookup!.priorCapture!.position <- graph.position(lookup!.supplied!.node)
                                lookup!.priorCapture!.facts <- lookup!.supplied
                            }
                        }
                        our WorldPattern:: token; token!.position <- at
                        lookup!.pattern.append(token)
                        lookup!.bounded <- false; lookup!.query!.testPattern <- true
                        lookup!.left!.shallow <- false; lookup!.right!.shallow <- false
                        lookup!.started <- false; lookup!.lhs <- NULL
                        matchCorrespondence(request, frame); return()
                    }
                    if(at!.embedded or lookup!.query!.testPattern){
                        me WorldScalar: header <- graph.read(request, at!.node, at!.node!.pParent, false, false, lookup!.query!.testPattern)
                        if(header.outcome==worldWaiting){waitAt(request, frame, at!.node!.pItem); return()}
                        if(header.outcome!=worldReady){frame!.facts <- header; stopFrame(request, frame); return()}
                        our infonView: item <- at!.node!.pItem
                        me bool: unconstrained <- item!.wrkList.isEmpty() and !header.negative
                        if(at!.embedded){
                            unconstrained <- unconstrained and header.overlay==LST and header.hasValue and
                                item!.value!.listSpec==NULL and item!.value!.items.head==NULL and header.openTail
                            if(!header.hasSize or (lookup!.query!.testPattern and !unconstrained)){
                                lookup!.left!.push(at); lookup!.lhs <- NULL; continue()
                            }
                            if(!item!.wrkList.isEmpty() or header.size<0 or header.size.getDenominator()!=1){
                                frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Prefix span extent still needs evidence"; stopFrame(request, frame); return()
                            }
                            lookup!.remaining <- header.size
                        }else{
                            if(!unconstrained or header.overlay>=0 or header.hasSize or header.hasValue or header.nominal!=NULL){
                                if(lookup!.prefixPredicate==NULL){
                                    lookup!.prefixPredicate <- makeFrame(request, at!.node, at)
                                    lookup!.prefixPredicate!.predicateOnly <- true
                                    request!.ready.append(frame); request!.ready.append(lookup!.prefixPredicate); return()
                                }
                            }
                            lookup!.remaining <+- 1
                        }
                    }else{lookup!.remaining <+- 1}
                }
            }
            while(lookup!.remaining>0){
                if(lookup!.rhs==NULL){
                    lookup!.rhs <- graph.nextPosition(request, lookup!.right)
                    if(!walkReady(request, frame, lookup!.right)){return()}
                }
                our WorldPosition: source <- lookup!.rhs
                if(source==NULL or source!.tail){frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Selected span needs more source positions"; stopFrame(request, frame); return()}
                if(source!.embedded){
                    me WorldScalar: header <- graph.read(request, source!.node, source!.node!.pParent)
                    if(header.outcome==worldWaiting){waitAt(request, frame, source!.node!.pItem); return()}
                    if(header.outcome!=worldReady){frame!.facts <- header; stopFrame(request, frame); return()}
                    if(!source!.node!.pItem!.wrkList.isEmpty()){
                        frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Embedded layout has unresolved relationships"; stopFrame(request, frame); return()
                    }
                    // A counted closed layout or an empty given open span
                    // proves a skippable width without inspecting its values.
                    if(!lookup!.capturing and lookup!.prefixPredicate==NULL and graph.skippableWidth(header, source!.node) and
                       (header.size<=lookup!.remaining or (header.openTail and source!.node!.pItem!.value!.items.head==NULL and source!.node!.pItem!.value!.listSpec==NULL))){
                        me FlexNum: width <- header.size-lookup!.sourceOffset
                        if(width>lookup!.remaining){width <- lookup!.remaining}
                        our WorldWalkLevel: level <- lookup!.right!.levels.last()
                        if(level!.hasLimit and lookup!.right!.position+width>level!.limit){
                            frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Correspondence exceeds a known source endpoint"; stopFrame(request, frame); return()
                        }
                        lookup!.remaining <- lookup!.remaining-width; lookup!.right!.position <+- width; lookup!.sourceOffset <+- width
                        if(lookup!.sourceOffset<header.size){continue()}
                        lookup!.sourceOffset <- 0
                    }else{lookup!.right!.push(source)}
                    lookup!.rhs <- NULL; continue()
                }
                if(lookup!.prefixPredicate!=NULL){
                    me WorldScalar: actual
                    if(!correspondenceCandidate(request, frame, lookup!.prefixPredicate!.facts, actual)){return()}
                    me WorldScalar: matched <- graph.matchPosition(lookup!.prefixPredicate!.facts, actual, lookup!.memberEdge)
                    request!.correspondenceChecks <+- 1
                    if(matched.outcome!=worldReady or matched.needsEvidence){
                        frame!.facts <- matched
                        if(matched.needsEvidence){frame!.facts.outcome <- worldPartial}
                        stopFrame(request, frame); return()
                    }
                    lookup!.candidate <- NULL; lookup!.prefixPredicate <- NULL
                }
                if(lookup!.capturing){
                    if(lookup!.candidate==NULL){
                        lookup!.candidate <- makeFrame(request, source!.node, source)
                        request!.ready.append(frame); request!.ready.append(lookup!.candidate); return()
                    }
                    if(!graph.representableFacts(lookup!.candidate!.facts)){
                        frame!.facts <- lookup!.candidate!.facts
                        if(frame!.facts.outcome==worldReady){frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Selected source member still needs evidence"}
                        stopFrame(request, frame); return()
                    }
                    lookup!.result!.positions.append(source)
                    if(!lookup!.query!.target!.embedded){
                        lookup!.result!.position <- source; lookup!.result!.facts <- lookup!.candidate
                    }
                    if(lookup!.supplied!=NULL){
                        graph.appendMember(lookup!.supplied!.facts.sequence, lookup!.candidate)
                        lookup!.supplied!.facts.contentsComplete <- lookup!.supplied!.facts.contentsComplete and graph.completeFacts(lookup!.candidate!.facts, false)
                    }
                    lookup!.candidate <- NULL
                }
                lookup!.remaining <- lookup!.remaining-1; lookup!.rhs <- NULL
            }
            if(lookup!.capturing){lookup!.captured <- true; lookup!.capturing <- false}
            lookup!.lhs <- NULL
        }
    }
    // A member request borrows template structure. Its siblings become goals
    // only when their width or predicate is needed to establish the mapping.
    our WorldFrame: patternFrame(our WorldRequest: request, our WorldFrame: consumer, our WorldPosition: position) <- {
        if(graph.samePosition(position, consumer!.lookup!.query!.target)){
            our WorldFrame: result <- projectFrame(request, consumer); result!.context <- position; result!.finished <- true
            return(result)
        }
        our WorldFrame:: result; result!.node <- position!.node; result!.context <- position
        result!.expressionParent <- position!.node!.pParent; result!.lazyPattern <- true; result!.predicateOnly <- true
        request!.framesCreated <+- 1; return(result)
    }
    me bool: preparePattern(our WorldRequest: request, our WorldFrame: consumer, our WorldPatternGoal: goal) <- {
        our WorldFrame: pattern <- goal!.pattern
        if(!pattern!.lazyPattern){return(true)}
        our infonView: item <- pattern!.node!.pItem
        if(graph.projectionTemplate(item)){
            me WorldScalar: header <- graph.read(request, pattern!.node, pattern!.expressionParent, false, true, true)
            if(header.outcome==worldWaiting){waitAt(request, consumer, item); return(false)}
            if(header.outcome!=worldReady){consumer!.facts <- header; stopFrame(request, consumer); return(false)}
            if(item!.type!=NULL or item!.invertMatch or item!.funcArgs!=NULL or item!.innr!.funcArgs!=NULL or !item!.wrkList.isEmpty()){
                consumer!.facts.outcome <- worldUnsupported; consumer!.facts.detail <- "Projected pattern has additional obligations"; stopFrame(request, consumer); return(false)
            }
            our POV:: body{941}; body!.pItem <- item!.innr
            me WorldScalar: bodyHeader <- graph.read(request, body, NULL, false, false, true)
            if(bodyHeader.outcome==worldWaiting){waitAt(request, consumer, item!.innr); return(false)}
            if(bodyHeader.outcome!=worldReady){consumer!.facts <- bodyHeader; stopFrame(request, consumer); return(false)}
            if(item!.innr!.value!.sizeMode==fromGiven and
               (item!.innr!.infSize!.evalMode!=emLiteral or item!.innr!.infSize!.num<=0 or item!.innr!.infSize!.num.getDenominator()!=1)){
                consumer!.facts.outcome <- worldUnsupported; consumer!.facts.detail <- "Projected pattern needs an established position"; stopFrame(request, consumer); return(false)
            }
            // A pure repeated body needs only the indexed prefix. Explicit
            // body members retain their own layout independently of the index.
            if(item!.innr!.value!.sizeMode==fromGiven and
               (item!.innr!.value!.items.head!=NULL or !item!.innr!.value!.tailUnfinished)){
                body!.pItem <- graph.pathBody(item!.innr, false)
                Allocate(body!.pItem!.infSize); body!.pItem!.infSize!.overlayType <- NUM; body!.pItem!.infSize!.evalMode <- emUnknown
            }
            pattern!.projectionBody <- patternFrame(request, consumer, graph.position(body))
            pattern!.facts <- header; pattern!.initialized <- true; pattern!.finished <- true; pattern!.lazyPattern <- false
            return(true)
        }
        me WorldScalar: header <- graph.read(request, pattern!.node, pattern!.expressionParent,
            pattern!.context!=NULL and pattern!.context!.input!=NULL, false, true)
        if(header.outcome==worldWaiting){waitAt(request, consumer, pattern!.node!.pItem); return(false)}
        if(header.outcome!=worldReady){consumer!.facts <- header; stopFrame(request, consumer); return(false)}
        me bool: root <- goal===consumer!.lookup!.chart!.root
        if(header.overlay==LST and header.hasValue and (root or item!.wrkList.isEmpty()) and
           (root or header.nominal==NULL)){
            pattern!.facts <- header; pattern!.initialized <- true; pattern!.finished <- true
            Allocate(pattern!.facts.sequence)
            our POV: member <- item!.value!.items.head
            while(member!=NULL){
                our WorldFrame: child <- patternFrame(request, consumer, graph.position(member, pattern!.context))
                graph.appendMember(pattern!.facts.sequence, child, member!.isSubItm)
                member <- member!.next
            }
            if(item!.value!.listSpec!=NULL){
                our POV:: spec{937}; spec!.pItem <- item!.value!.listSpec
                our WorldFrame: requirement <- patternFrame(request, consumer, graph.position(spec))
                pattern!.tailRequirements <- graph.requirement(requirement, spec)
                if(item!.value!.items.head!=NULL and !(root and consumer!.inputEdge!=NULL and graph.projectionTemplate(item!.value!.listSpec))){
                    consumer!.facts.outcome <- worldUnsupported; consumer!.facts.detail <- "Selected structured template needs prefix requirements"
                    stopFrame(request, consumer); return(false)
                }
            }
        }else if(!consumer!.lookup!.query!.testPattern and header.overlay==STR and (header.hasSize or header.hasValue)){
            // An asserted predecessor supplies an extent, not a value goal.
            pattern!.facts <- header; pattern!.initialized <- true; pattern!.finished <- true
        }else{
            pattern!.lazyPattern <- false
            request!.ready.append(consumer); request!.ready.append(pattern); return(false)
        }
        pattern!.lazyPattern <- false; return(true)
    }
    our WorldPatternGoal: patternGoal(our WorldRequest: request, our WorldPatternChart: chart,
                                     our WorldFrame: pattern, me int64: start) <- {
        if(!chart!.memo.containsKey(pattern)){
            our WorldPatternStarts:: starts; chart!.memo.insert(pattern, starts)
        }
        our WorldPatternStarts: starts <- chart!.memo.at(pattern)
        if(starts!.goals.containsKey(start)){return(starts!.goals.at(start))}
        our WorldPatternGoal:: goal; goal!.pattern <- pattern; goal!.start <- start
        starts!.goals.insert(start, goal); request!.correspondenceChecks <+- 1
        return(goal)
    }
    void: patternState(our WorldRequest: request, our WorldPatternGoal: goal, our WorldPatternState: state) <- {
        me string: key <- toString(state!.slot)+":"+toString(state!.end)
        // Only a given member count can affect the remaining transitions.
        if(goal!.pattern!.facts.hasSize){key <+- ":"+toString(graph.sequenceLength(state!.sequence))}
        if(goal!.states.containsKey(key)){goal!.states.at(key)!.proof!.ambiguous <- true}
        else{goal!.states.insert(key, state); goal!.pending.append(state); request!.correspondenceMappings <+- 1}
    }
    void: patternResult(our WorldPatternGoal: goal, our WorldPatternResult: result) <- {
        if(goal!.ends.containsKey(result!.end)){goal!.ends.at(result!.end)!.proof!.ambiguous <- true}
        else{goal!.ends.insert(result!.end, result); goal!.results.append(result)}
    }
    // Cache only demanded source positions. Every virtual cursor step and
    // candidate normalization is shared by all branches at that boundary.
    me bool: patternInput(our WorldRequest: request, our WorldFrame: frame, me int64: index) <- {
        our WorldCorrespondence: lookup <- frame!.lookup
        our WorldPatternChart: chart <- lookup!.chart
        while(index>=chart!.input.size() and !chart!.ended){
            our WorldPosition: at <- graph.nextPosition(request, lookup!.right)
            if(!walkReady(request, frame, lookup!.right)){return(false)}
            if(at==NULL){chart!.ended <- true}
            else if(at!.tail){
                frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Structured pattern needs a bounded source span"; stopFrame(request, frame); return(false)
            }else{
                our WorldCapture:: capture; capture!.position <- at; chart!.input.append(capture)
            }
        }
        return(true)
    }
    // Index borrowed leaves once, lazily through the demanded endpoint.
    // Consecutive windows use the cached leaf; a branch that jumps backward
    // uses binary lookup rather than traversing a rope again from its root.
    our WorldText: patternText(our WorldRequest: request, our WorldPatternChart: chart, me int64: start, me int64: length) <- {
        while(chart!.textIndexed<start+length){
            me uint64: before <- chart!.textCursor.visits
            chart!.textCursor.nextLeaf(); request!.textSourceNodes <+- chart!.textCursor.visits-before
            me WorldTextSpan: span; Allocate(span.text); span.text!.source <- chart!.textCursor.source
            span.text!.start <- chart!.textCursor.pos; span.start <- chart!.textIndexed; span.length <- chart!.textCursor.remaining
            chart!.textSpans.append(span); chart!.textIndexed <+- span.length; chart!.textCursor.remaining <- 0
        }
        if(length==0){return(NULL)}
        me int64: index <- chart!.textIndex
        if(chart!.textSpans[index].start+chart!.textSpans[index].length==start and index+1<chart!.textSpans.size()){index <+- 1}
        if(start<chart!.textSpans[index].start or start>=chart!.textSpans[index].start+chart!.textSpans[index].length){
            me int64: low <- 0; me int64: high <- chart!.textSpans.size()
            while(low<high){
                me int64: middle <- (low+high)/2
                if(chart!.textSpans[middle].start+chart!.textSpans[middle].length<=start){low <- middle+1}else{high <- middle}
            }
            index <- low
        }
        our WorldText: result
        me int64: consumed <- 0
        while(consumed<length){
            me WorldTextSpan: span <- chart!.textSpans[index]
            me int64: offset <- start+consumed-span.start
            me int64: width <- min(length-consumed, span.length-offset)
            our WorldText:: part; part!.source <- span.text!.source; part!.start <- span.text!.start+offset
            if(result==NULL){result <- part}
            else{our WorldText:: joined; joined!.left <- result; joined!.right <- part; joined!.leftLength <- consumed; result <- joined}
            consumed <+- width; chart!.textIndex <- index; index <+- 1; request!.textWindowNodes <+- 1
        }
        return(result)
    }
    me bool: patternLeaf(our WorldRequest: request, our WorldFrame: frame, our WorldPatternGoal: goal) <- {
        our WorldCorrespondence: lookup <- frame!.lookup
        our WorldPatternChart: chart <- lookup!.chart
        me WorldScalar: required <- goal!.pattern!.facts
        me WorldScalar: actual
        me int64: end <- goal!.start+1
        if(chart!.text){
            me FlexNum: width
            if(required.hasValue and required.overlay==STR){width <- required.textLength}
            else if(required.hasSize and required.overlay==STR){width <- required.size}
            else{
                frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Text pattern needs an established token width"; stopFrame(request, frame); return(false)
            }
            if(width<0 or width.getDenominator()!=1 or width>chart!.source!.facts.textLength-goal!.start){return(true)}
            me int64: length <- width.getNumerator().convertToIntVal()
            end <- goal!.start+length
            actual.overlay <- STR; actual.hasValue <- true; actual.hasSize <- true
            actual.size <- length; actual.textLength <- length
            actual.textSource <- patternText(request, chart, goal!.start, length)
        }else{
            if(!patternInput(request, frame, goal!.start)){return(false)}
            if(goal!.start>=chart!.input.size()){return(true)}
            our WorldCapture: capture <- chart!.input[goal!.start]
            if(capture!.facts==NULL){
                capture!.facts <- makeFrame(request, capture!.position!.node, capture!.position)
                request!.ready.append(frame); request!.ready.append(capture!.facts); return(false)
            }
            actual <- capture!.facts!.facts
            if(actual.outcome!=worldReady){frame!.facts <- actual; stopFrame(request, frame); return(false)}
        }
        me WorldScalar: matched <- required
        if(lookup!.query!.testPattern or graph.samePosition(goal!.pattern!.context, lookup!.query!.target)){
            matched <- graph.matchPosition(required, actual, lookup!.memberEdge)
        }
        if(matched.outcome==worldRejected){return(true)}
        if(matched.outcome!=worldReady or matched.needsEvidence or matched.pendingChecks!=NULL){
            frame!.facts <- matched
            if(matched.needsEvidence or matched.pendingChecks!=NULL){frame!.facts.outcome <- worldPartial}
            stopFrame(request, frame); return(false)
        }
        our WorldPatternResult:: result; result!.end <- end
        result!.frame <- projectFrame(request, goal!.pattern); result!.frame!.facts <- matched
        result!.frame!.finished <- true; Allocate(result!.proof)
        if(lookup!.query!.target!=NULL and graph.samePosition(goal!.pattern!.context, lookup!.query!.target)){result!.selected <- result!.frame}
        patternResult(goal, result)
        return(true)
    }
    // A projected pattern consumes its body's span and returns one of its
    // proved members. Embedded captures keep their own list result.
    our WorldFrame: projectPatternResult(our WorldRequest: request, our WorldFrame: pattern, our WorldFrame: body) <- {
        our infonView: item <- pattern!.node!.pItem
        me WorldListCursor: members; members.push(body!.facts.sequence)
        me WorldMember: occurrence <- members.nextMember(false)
        our WorldFrame: selected
        me int64: index <- 0
        me bool: indexed <- item!.innr!.value!.sizeMode==fromGiven
        while(occurrence.frame!=NULL){
            our WorldFrame: member <- occurrence.frame
            if(!indexed and item!.intersectPos==ipGetMarked and
               (member!.node===item!.intersectMarkedRetPOV or member!.node===item!.innr!.intersectMarkedRetPOV)){selected <- member; break()}
            if(occurrence.embedded){members.push(member!.facts.sequence)}
            else{
                index <+- 1
                if((indexed and item!.innr!.infSize!.num==FlexNum(index)) or
                   (!indexed and (item!.intersectPos==ipGetLast or (item!.intersectPos==ipGetFirst and index==1)))){selected <- member}
            }
            occurrence <- members.nextMember(false)
        }
        request!.sequenceVisits <+- members.visits
        return(selected)
    }
    // Nested grouping, repetition and OR all compose the same span results.
    // A goal/template/source-boundary triple is solved once. States with the
    // same continuation share a packed proof instead of enumerating paths.
    void: matchStructuredCorrespondence(our WorldRequest: request, our WorldFrame: frame) <- {
        our WorldCorrespondence: lookup <- frame!.lookup
        our WorldPatternChart: chart <- lookup!.chart
        if(!chart!.initialized){
            if(chart!.source==NULL){
                if(chart!.sourceProbe==NULL){chart!.sourceProbe <- lookup!.result!.sourceDomain!.node}
                me WorldScalar: header
                while(true){
                    header <- graph.read(request, chart!.sourceProbe, chart!.sourceProbe!.pParent)
                    if(header.outcome==worldWaiting){waitAt(request, frame, chart!.sourceProbe!.pItem); return()}
                    if(header.outcome!=worldReady){frame!.facts <- header; stopFrame(request, frame); return()}
                    // A concatenation's container has no value type. Borrow
                    // its first operand's header to choose list/text access;
                    // the ordinary walker still checks every demanded layout.
                    if(header.overlay<0 and !header.hasValue and header.nominal!=NULL and
                       header.nominal!.defToUse!=NULL and chart!.sourceProbe!.pItem!.wrkList.isEmpty()){
                        if(chart!.sourcePath.contains(chart!.sourceProbe!.pItem)){
                            frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Cyclic named sequence source"; stopFrame(request, frame); return()
                        }
                        chart!.sourcePath.insert(chart!.sourceProbe!.pItem)
                        our POV:: meaning{939}; meaning!.pItem <- header.nominal!.defToUse; chart!.sourceProbe <- meaning
                        continue()
                    }
                    if(!graph.scalarExpression(chart!.sourceProbe!.pItem!.value)){break()}
                    if(chart!.sourcePath.contains(chart!.sourceProbe!.pItem)){
                        frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Cyclic sequence source"; stopFrame(request, frame); return()
                    }
                    chart!.sourcePath.insert(chart!.sourceProbe!.pItem)
                    chart!.sourceProbe <- chart!.sourceProbe!.pItem!.value!.items.head
                }
                if(header.overlay==LST and lookup!.query!.target!=NULL){
                    me WorldScalar: patternHeader <- graph.read(request, chart!.patternPosition!.node, chart!.patternPosition!.node!.pParent, chart!.patternPosition!.input!=NULL)
                    if(!lookup!.query!.testPattern and patternHeader.hasSize and header.hasSize and
                       ((!lookup!.query!.relation!.looseSize() and patternHeader.size!=header.size) or
                        (lookup!.query!.relation!.looseSize() and patternHeader.size>header.size))){
                        frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Parent endpoints need span alignment"; stopFrame(request, frame); return()
                    }
                    lookup!.chart <- NULL; request!.ready.append(frame); return()
                }
                if(header.overlay!=LST){
                    chart!.source <- makeFrame(request, lookup!.query!.relation)
                    request!.ready.append(frame); request!.ready.append(chart!.source); return()
                }
            }
            if(chart!.source!=NULL){
                me WorldScalar: source <- chart!.source!.facts
                if(source.outcome!=worldReady){frame!.facts <- source; stopFrame(request, frame); return()}
                if((source.overlay!=STR and source.overlay!=LST) or !source.hasValue){
                    frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Structured pattern needs a list or known text source"; stopFrame(request, frame); return()
                }
                chart!.text <- source.overlay==STR
                if(chart!.text){chart!.textCursor.push(source.textSource, source.textLength)}
            }
            if(chart!.patternPosition!=NULL){chart!.pattern <- patternFrame(request, frame, chart!.patternPosition)}
            if(chart!.pattern==NULL){chart!.pattern <- projectFrame(request, frame)}
            chart!.root <- patternGoal(request, chart, chart!.pattern, 0)
            chart!.pending.append(chart!.root); chart!.initialized <- true
        }
        while(!chart!.pending.isEmpty()){
            our WorldPatternGoal: goal <- chart!.pending.last()
            our WorldFrame: pattern <- goal!.pattern
            if(!goal!.initialized){
                if(!preparePattern(request, frame, goal)){return()}
                if(pattern!.facts.outcome!=worldReady or pattern!.facts.pendingChecks!=NULL or !pattern!.retainedWork.isEmpty()){
                    frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Pattern still has unresolved requirements"; stopFrame(request, frame); return()
                }
                if(pattern!.projectionBody!=NULL){goal!.child <- patternGoal(request, chart, pattern!.projectionBody, goal!.start)}
                if(pattern!.facts.alternatives==NULL and pattern!.facts.overlay==LST){
                    if(!pattern!.facts.hasValue or pattern!.facts.negative or
                       (pattern!.facts.hasSize and (pattern!.facts.size<0 or pattern!.facts.size.getDenominator()!=1))){
                        frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Pattern needs a positive ordered list layout"; stopFrame(request, frame); return()
                    }
                    goal!.projectedPrefix <- goal===chart!.root and frame!.inputEdge!=NULL and graph.projectionTemplate(pattern!.node!.pItem!.value!.listSpec)
                    me WorldListCursor: members; members.push(pattern!.facts.sequence)
                    me WorldMember: member <- members.nextMember(false)
                    while(member.frame!=NULL){goal!.members.append(member); member <- members.nextMember(false)}
                    request!.sequenceVisits <+- members.visits
                    if(pattern!.facts.openTail){
                        goal!.requirements.push(pattern!.tailRequirements)
                        our WorldRequirement: requirement <- goal!.requirements.next()
                        if(requirement==NULL){
                            Allocate(goal!.repeated); goal!.repeated!.node <- pattern!.node
                            goal!.repeated!.initialized <- true; goal!.repeated!.finished <- true
                        }else{
                            goal!.repeated <- requirement!.frame
                        }
                        request!.requirementVisits <+- goal!.requirements.visits
                    }
                    our WorldPatternState:: state; state!.end <- goal!.start; patternState(request, goal, state)
                }
                goal!.initialized <- true
            }
            if(goal!.repeated!=NULL){
                if(!goal!.repeated!.finished and !goal!.repeated!.lazyPattern){request!.ready.append(frame); request!.ready.append(goal!.repeated); return()}
                me uint64: before <- goal!.requirements.visits
                our WorldRequirement: requirement <- goal!.requirements.next()
                request!.requirementVisits <+- goal!.requirements.visits-before
                if(requirement!=NULL){
                    goal!.repeated <- derivePair(request, goal!.repeated, requirement!.frame, requirement!.edge)
                    continue()
                }
            }
            if(goal!.child!=NULL){
                if(!goal!.child!.finished){chart!.pending.append(goal!.child); continue()}
                if(goal!.child!.results.size()>1){chart!.deterministic <- false}
                withEach child in goal!.child!.results{
                    if(child!.selected!=NULL and !lookup!.query!.testPattern and chart!.deterministic){
                        chart!.accepted <- child; chart!.selectedEarly <- true; break()
                    }
                    if(pattern!.projectionBody!=NULL){
                        our WorldFrame: selected <- projectPatternResult(request, pattern, child!.frame)
                        if(selected!=NULL){
                            our WorldPatternResult:: result; result!.end <- child!.end; result!.frame <- selected; result!.proof <- child!.proof
                            result!.selected <- child!.selected
                            if(lookup!.query!.target!=NULL and graph.samePosition(pattern!.context, lookup!.query!.target)){result!.selected <- selected}
                            patternResult(goal, result)
                        }
                    }else if(pattern!.facts.alternatives!=NULL){
                        our WorldPatternResult:: result; result!.end <- child!.end; result!.frame <- child!.frame
                        Allocate(result!.proof); result!.proof!.child <- child!.proof; result!.selected <- child!.selected; patternResult(goal, result)
                    }
                    else{
                        me bool: tail <- goal!.state!.slot==goal!.members.size()
                        if(tail and child!.end==goal!.state!.end and !pattern!.facts.hasSize){
                            frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Repeated pattern can consume no source positions"; stopFrame(request, frame); return()
                        }
                        if(goal!.projectedPrefix and !tail){
                            our WorldFrame: required <- goal!.members[goal!.state!.slot].frame
                            me WorldScalar: matched <- graph.matchPosition(required!.facts, child!.frame!.facts, lookup!.memberEdge)
                            if(matched.outcome==worldRejected){continue()}
                            if(matched.outcome!=worldReady or matched.needsEvidence or matched.pendingChecks!=NULL){
                                frame!.facts <- matched; if(matched.needsEvidence or matched.pendingChecks!=NULL){frame!.facts.outcome <- worldPartial}
                                stopFrame(request, frame); return()
                            }
                            our WorldPatternResult:: refined; refined! <- child!
                            refined!.frame <- projectFrame(request, child!.frame); refined!.frame!.facts <- matched; child <- refined
                        }
                        me bool: embedded <- false
                        if(!tail){embedded <- goal!.members[goal!.state!.slot].embedded}
                        our WorldList:: one; graph.appendMember(one, child!.frame, embedded)
                        our WorldPatternState:: next; next!.slot <- goal!.state!.slot
                        if(!tail){next!.slot <+- 1}
                        next!.selected <- goal!.state!.selected; if(child!.selected!=NULL){next!.selected <- child!.selected}
                        next!.end <- child!.end; next!.sequence <- graph.join(goal!.state!.sequence, one)
                        next!.proof!.prior <- goal!.state!.proof; next!.proof!.child <- child!.proof
                        next!.complete <- goal!.state!.complete and graph.completeFacts(child!.frame!.facts, false)
                        next!.representable <- goal!.state!.representable and graph.representableFacts(child!.frame!.facts)
                        if(!pattern!.facts.hasSize or FlexNum(next!.sequence!.length)<=pattern!.facts.size){patternState(request, goal, next)}
                    }
                }
                if(chart!.selectedEarly){break()}
                goal!.child <- NULL; goal!.state <- NULL; goal!.alternative <+- 1
            }
            if(pattern!.projectionBody!=NULL){}
            else if(pattern!.facts.alternatives!=NULL){
                if(goal!.alternative<pattern!.facts.alternatives!.members.size()){
                    goal!.child <- patternGoal(request, chart, pattern!.facts.alternatives!.members[goal!.alternative], goal!.start)
                    continue()
                }
            }else if(pattern!.facts.overlay!=LST){
                if(!patternLeaf(request, frame, goal)){return()}
            }else if(!goal!.pending.isEmpty() or goal!.state!=NULL){
                if(goal!.state==NULL){goal!.state <- goal!.pending.popLast()}
                our WorldPatternState: state <- goal!.state
                me int64: count <- graph.sequenceLength(state!.sequence)
                if(state!.slot==goal!.members.size() and (!pattern!.facts.hasSize or pattern!.facts.size==FlexNum(count))){
                    our WorldPatternResult:: result; result!.end <- state!.end; result!.proof <- state!.proof
                    result!.frame <- projectFrame(request, pattern); result!.frame!.finished <- true
                    result!.frame!.facts.sequence <- state!.sequence
                    result!.frame!.facts.openTail <- false; result!.frame!.facts.hasSize <- true; result!.frame!.facts.size <- count
                    result!.frame!.facts.contentsComplete <- state!.complete; result!.frame!.facts.representable <- state!.representable
                    result!.frame!.facts.dischargeListSpec <- true
                    result!.frame!.tailRequirements <- NULL; result!.frame!.pendingRequirements <- NULL
                    result!.frame!.listSpecFrame <- NULL; result!.frame!.listSpecEdge <- NULL
                    result!.selected <- state!.selected
                    if(lookup!.query!.target!=NULL and graph.samePosition(pattern!.context, lookup!.query!.target)){result!.selected <- result!.frame}
                    patternResult(goal, result)
                }
                if(goal!.projectedPrefix and state!.slot<goal!.members.size()){
                    our WorldFrame: constraint <- goal!.members[state!.slot].frame
                    // These are already supplied output constraints. The
                    // generating listSpec is not another requirement on them.
                    if(constraint!.lazyPattern){constraint!.lazyPattern <- false; constraint!.context <- NULL; constraint!.parentContext <- NULL}
                    if(!constraint!.finished){request!.ready.append(frame); request!.ready.append(constraint); return()}
                    if(constraint!.facts.outcome!=worldReady or constraint!.facts.pendingChecks!=NULL){
                        frame!.facts <- constraint!.facts; if(constraint!.facts.pendingChecks!=NULL){frame!.facts.outcome <- worldPartial}
                        stopFrame(request, frame); return()
                    }
                }
                our WorldFrame: child
                if(state!.slot<goal!.members.size()){
                    if(goal!.projectedPrefix){child <- goal!.repeated}else{child <- goal!.members[state!.slot].frame}
                }
                else if(goal!.repeated!=NULL and (!pattern!.facts.hasSize or FlexNum(count)<pattern!.facts.size)){child <- goal!.repeated}
                if(child!=NULL){goal!.child <- patternGoal(request, chart, child, state!.end)}
                else{goal!.state <- NULL}
                continue()
            }
            goal!.finished <- true; chart!.pending.popLast()
        }
        while(!chart!.selectedEarly and chart!.resultIndex<chart!.root!.results.size()){
            our WorldPatternResult: result <- chart!.root!.results[chart!.resultIndex]
            me bool: accepted <- lookup!.query!.relation!.looseSize()
            if(!accepted){
                if(chart!.text){accepted <- result!.end==chart!.source!.facts.textLength}
                else{
                    if(!patternInput(request, frame, result!.end)){return()}
                    accepted <- chart!.ended and result!.end==chart!.input.size()
                }
            }
            if(accepted){
                if(chart!.accepted!=NULL){
                    frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Pattern has several accepted span mappings"; stopFrame(request, frame); return()
                }
                chart!.accepted <- result
            }
            chart!.resultIndex <+- 1
        }
        if(chart!.accepted==NULL and frame!.inputEdge!=NULL and (chart!.text or chart!.ended) and
           !chart!.root!.pattern!.facts.hasSize and chart!.root!.pattern!.facts.openTail and chart!.root!.repeated!=NULL and chart!.root!.repeated!.projectionBody!=NULL){
            // No complete next projection: keep the longest proved output
            // prefix and the original relation that still constrains its tail.
            withEach result in chart!.root!.results{
                if(chart!.accepted==NULL or result!.end>chart!.accepted!.end){chart!.accepted <- result}
            }
            if(chart!.accepted!=NULL){
                our WorldFrame: answer <- chart!.accepted!.frame
                answer!.facts.openTail <- true; answer!.facts.hasSize <- false
                answer!.facts.dischargeListSpec <- false; answer!.facts.contentsComplete <- false
                frame!.retainedWork.append(frame!.inputEdge)
            }
        }
        if(chart!.accepted==NULL){
            frame!.facts.outcome <- worldRejected; frame!.facts.detail <- "No structured correspondence matches"; stopFrame(request, frame); return()
        }
        me List<our WorldPatternProof>: proofs; proofs.append(chart!.accepted!.proof)
        me Set<our WorldPatternProof>: visited
        while(!proofs.isEmpty()){
            our WorldPatternProof: proof <- proofs.popLast()
            if(proof==NULL or visited.contains(proof)){continue()}
            visited.insert(proof)
            if(proof!.ambiguous){
                frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Pattern has several accepted member mappings"; stopFrame(request, frame); return()
            }
            proofs.append(proof!.prior); proofs.append(proof!.child)
        }
        our WorldFrame: answer <- chart!.accepted!.frame
        if(lookup!.query!.target!=NULL){
            answer <- chart!.accepted!.selected
            if(answer==NULL){frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Structured mapping did not establish the selected member"; stopFrame(request, frame); return()}
            lookup!.result!.facts <- answer
        }
        frame!.facts <- answer!.facts
        graph.adoptListRequirements(frame, answer)
        frame!.correspondenceResult <- lookup!.result; frame!.lookup <- NULL
        request!.ready.append(frame)
    }

    // Return a read-only RHS for this member; neither containing list is a
    // value-normalization prerequisite. The cursors/chart survive local waits.
    void: locateRHS(our WorldRequest: request, our WorldFrame: frame) <- {
        our WorldCorrespondence: lookup <- frame!.lookup
        if(!lookup!.sourceResolved){
            our POV: source <- lookup!.query!.relation
            if(source!.pItem!.viewMode==vmCursor or source!.pItem!.partRef!=NULL or !source!.pItem!.parts.isEmpty()){
                if(lookup!.sourceReference==NULL){
                    lookup!.sourceReference <- makeFrame(request, source)
                    lookup!.sourceReference!.referenceOnly <- true; lookup!.sourceReference!.acquireOnly <- true
                    request!.ready.append(frame); request!.ready.append(lookup!.sourceReference); return()
                }
                if(lookup!.sourceReference!.facts.outcome!=worldReady){frame!.facts <- lookup!.sourceReference!.facts; stopFrame(request, frame); return()}
                our WorldCorrespondenceResult: result <- lookup!.sourceReference!.correspondenceResult
                if(result==NULL or result!.position==NULL){
                    frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Correspondence source needs one occurrence"; stopFrame(request, frame); return()
                }
                lookup!.result!.sourceDomain <- result!.position
                lookup!.right!.levels.last()!.position <- result!.position
            }
            lookup!.sourceResolved <- true
        }
        if(lookup!.chart!=NULL){matchStructuredCorrespondence(request, frame); return()}
        if(lookup!.normalized){request!.ready.append(frame); correspond(request, frame); return()}
        if(lookup!.bounded){locateSpanRHS(request, frame); return()}
        matchCorrespondence(request, frame)
    }
    me bool: requestParentRHS(our WorldRequest: request, our WorldFrame: frame) <- {
        while(frame!.parentContext!=NULL){
            our WorldPosition: parent <- frame!.parentContext
            our infonView: item <- parent!.node!.pItem
            me WorldScalar: parentHeader <- graph.read(request, parent!.node, parent!.node!.pParent, parent!.input!=NULL)
            if(parentHeader.outcome==worldWaiting){waitAt(request, frame, item); return(true)}
            if(parentHeader.outcome!=worldReady){frame!.facts <- parentHeader; stopFrame(request, frame); return(true)}
            if(frame!.context!.embedded and item!.value!.listSpec!=NULL){
                frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Selected span needs enclosing template projection"; stopFrame(request, frame); return(true)
            }
            if(frame!.parentWork<0){
                frame!.parentWork <- 0
                if(item!.value!.listSpec!=NULL){
                    our POV:: spec{937}; spec!.pItem <- item!.value!.listSpec
                    frame!.sourceEdge <- spec; frame!.sourceIsOperand <- false; frame!.sourceIsListSpec <- false; frame!.sourceNameInherited <- true
                    frame!.prerequisite <- makeFrame(request, spec)
                    request!.relationshipsRead <+- 1
                    request!.ready.append(frame); request!.ready.append(frame!.prerequisite); return(true)
                }
            }
            our POV: relation
            me bool: input <- false
            if(!frame!.predicateOnly and parent!.input!=NULL and frame!.parentWork==0){relation <- parent!.input; input <- true; frame!.parentWork <+- 1}
            else{
                me int64: index <- frame!.parentWork
                if(parent!.input!=NULL){index <- index-1}
                if(!frame!.predicateOnly and !graph.completeFacts(frame!.facts, frame!.demandSize) and index<item!.wrkList.size()){
                    relation <- item!.wrkList[index]; frame!.parentWork <+- 1
                    if(relation==NULL){frame!.facts.outcome <- worldError; frame!.facts.detail <- "Empty parent relationship"; stopFrame(request, frame); return(true)}
                }else if(!frame!.predicateOnly and !graph.completeFacts(frame!.facts, frame!.demandSize) and index==item!.wrkList.size()){
                    if(parent!.argumentEdge==NULL){parent!.argumentEdge <- graph.argumentRelation(item, parentHeader)}
                    relation <- parent!.argumentEdge; frame!.parentWork <+- 1
                }
            }
            if(relation!=NULL){
                if(relation!.pParent!=NULL){frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Contextual parent RHS needs occurrence projection"; stopFrame(request, frame); return(true)}
                if(relation!.forceID){frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Replacement correspondence is not implemented"; stopFrame(request, frame); return(true)}
                me WorldScalar: leftHeader <- parentHeader
                me WorldScalar: rightHeader <- graph.read(request, relation, relation!.pParent)
                if(!input and !relation!.looseMode and leftHeader.outcome==worldReady and rightHeader.outcome==worldReady and
                   leftHeader.hasSize and rightHeader.hasSize and
                   ((!relation!.looseSize() and leftHeader.size!=rightHeader.size) or (relation!.looseSize() and leftHeader.size>rightHeader.size))){
                    frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Parent endpoints need span alignment"; stopFrame(request, frame); return(true)
                }
                frame!.lookup <- graph.correspondence(parent, relation, frame!.context, input)
                // A member is a width-one capture. Fixed member and span
                // requests share coordinates, predicates and symbolic skips.
                frame!.lookup!.bounded <- true
                if(relation!.looseMode or input){
                    Allocate(frame!.lookup!.chart)
                    frame!.lookup!.chart!.patternPosition <- parent
                }
                frame!.lookup!.left!.shallow <- true; frame!.lookup!.right!.shallow <- true
                frame!.lookup!.right!.checkExtents <- true
                request!.parentLookups <+- 1; request!.ready.append(frame); return(true)
            }
            // An embedded parent's coordinates belong to the enclosing list.
            if(parent!.embedded){frame!.parentContext <- parent!.parent; frame!.parentWork <- -1}
            else{frame!.parentContext <- NULL}
        }
        return(false)
    }

    // A finite homogeneous pattern has an arithmetic alignment in leaf units.
    // Grouping changes the returned view, not the identity of its container.
    me bool: selectUnitPattern(our WorldRequest: request, our WorldFrame: frame) <- {
        our WorldSelection: selected <- frame!.selection
        our infonView: body <- selected!.domain!.node!.pItem
        if(selected!.domain!.input==NULL or selected!.index>0 or body!.orderMode==uUnordered or
           body!.value!.tailUnfinished or body!.value!.listSpec!=NULL or !body!.wrkList.isEmpty()){return(false)}
        their POV: target <- frame!.node!.pItem!.intersectMarkedRetPOV
        if(target==NULL){
            if(frame!.node!.pItem!.intersectPos==ipGetFirst){target <- body!.value!.items.head}
            else{target <- body!.value!.items.tail}
        }
        our WorldUnitSelection:: units
        me FlexNum: before
        me FlexNum: after
        me bool: found <- false
        our WordUse: base
        our WorldUnit: numeric
        our POV: hint <- body!.value!.items.head
        while(hint!=NULL and numeric==NULL){
            numeric <- graph.unitType(request, hint!.pItem)
            if(numeric==NULL){numeric <- graph.unitType(request, hint!.pItem!.value!.listSpec)}
            hint <- hint!.next
        }
        if(numeric!=NULL){while(numeric!.member!=NULL){numeric <- numeric!.member}}
        our POV: at <- body!.value!.items.head
        while(at!=NULL){
            our infonView: item <- at!.pItem
            if(!item!.wrkList.isEmpty() or item!.partRef!=NULL or !item!.parts.isEmpty() or item!.invertMatch or
               item!.funcArgs!=NULL or item!.innr!=NULL or item!.argPos!=apNoArgs){return(false)}
            our WorldUnit: unit <- graph.unitType(request, item)
            me FlexNum: count <- FlexNum("1")
            me bool: span <- false
            if(unit==NULL and item!.value!.overlayType==LST and item!.value!.evalMode==emLiteral and
               item!.value!.items.head==NULL and item!.value!.tailUnfinished and item!.infSize!.evalMode==emLiteral and
               item!.infSize!.num>=0 and item!.infSize!.num.getDenominator()==1 and item!.orderMode!=uUnordered){
                unit <- graph.unitType(request, item!.value!.listSpec); count <- item!.infSize!.num; span <- true
            }
            if(unit==NULL and item!.type==NULL and item!.addedTypes.isEmpty() and item!.viewMode==vmOverlay and
               item!.value!.overlayType==NUM and item!.value!.evalMode==emUnknown and item!.infSize!.evalMode==emUnknown){unit <- numeric}
            if(unit==NULL){return(false)}
            if(base==NULL){base <- unit!.base}
            else if(graph.compareNominal(base, unit!.base)!=worldReady){return(false)}
            if(at===target){units!.unit <- unit; units!.count <- count; units!.span <- span; found <- true}
            else if(found){after <+- count*unit!.width}
            else{before <+- count*unit!.width}
            at <- at!.next
        }
        if(!found){return(false)}
        units!.prefix <- before/units!.unit!.width; units!.suffix <- after/units!.unit!.width
        if(units!.prefix.getDenominator()!=1 or units!.suffix.getDenominator()!=1){return(false)}
        units!.coordinate <- selected!.index; units!.explicitSpec <- true
        units!.source <- graph.position(selected!.domain!.input); units!.writeThrough <- !frame!.node!.pItem!.wrkList.isEmpty()
        frame!.unitSelection <- units; request!.ready.append(frame)
        return(true)
    }

    our WorldFrame: unitOperation(our WorldRequest: request, our WorldPosition: source, our PartPath: part, our WorldFrame: index) <- {
        if(source!.node!.pItem!.orderMode==uUnordered or !source!.node!.pItem!.wrkList.isEmpty() or source!.node!.pItem!.argPos!=apNoArgs){return(NULL)}
        me Set<our infonView>: sourceSeen
        our WorldUnit: declaredSource <- graph.unitMeasure(request, source!.node!.pItem!.type, sourceSeen)
        if((declaredSource==NULL or declaredSource!.member==NULL) and graph.unitType(request, source!.node!.pItem!.value!.listSpec)==NULL){return(NULL)}
        our WorldUnit: unit
        me FlexNum: count <- FlexNum("1")
        me bool: span <- false
        if(part!.pathMode==idxField){
            if(part!.spec!=NULL){
                if(part!.spec!.value!.overlayType==LST and part!.spec!.value!.evalMode==emLiteral and
                   part!.spec!.value!.items.head==NULL and part!.spec!.value!.tailUnfinished and
                   part!.spec!.infSize!.evalMode==emLiteral and part!.spec!.infSize!.num>=0 and part!.spec!.infSize!.num.getDenominator()==1){
                    unit <- graph.unitType(request, part!.spec!.value!.listSpec); span <- true; count <- part!.spec!.infSize!.num
                }else{unit <- graph.unitType(request, part!.spec)}
            }else{
                me Set<our infonView>: seen
                our WorldUnit: parent <- graph.unitMeasure(request, source!.node!.pItem!.type, seen)
                if(parent!=NULL){unit <- parent!.member}
                if(unit==NULL){unit <- graph.unitType(request, source!.node!.pItem!.value!.listSpec)}
            }
        }else if(part!.pathMode==dotField){unit <- graph.unitType(request, part!.path)}
        if(unit==NULL or (unit!.member==NULL and part!.pathMode!=idxField)){return(NULL)}
        our POV:: node{941}; Allocate(node!.pItem)
        our WorldFrame: result <- makeFrame(request, node)
        Allocate(result!.unitSelection)
        result!.unitSelection!.source <- source; result!.unitSelection!.unit <- unit
        result!.unitSelection!.count <- count; result!.unitSelection!.span <- span
        result!.unitSelection!.explicitSpec <- part!.spec!=NULL
        if(index!=NULL){result!.unitSelection!.coordinate <- index!.facts.number}
        else{result!.unitSelection!.coordinate <- FlexNum("1")}
        our infonView: work <- part!.path
        if(part!.pathMode==idxField){work <- part!.continuation}
        if(work!=NULL){node!.pItem!.wrkList <- work!.wrkList}
        result!.acquireOnly <- work==NULL or work!.wrkList.isEmpty()
        result!.referenceOnly <- work!=NULL and work!.wrkList.isEmpty() and (work!.partRef!=NULL or !work!.parts.isEmpty())
        return(result)
    }
    me bool: pushUnitLevel(our WorldRequest: request, our WorldFrame: frame, our WorldPosition: source, our WorldUnit: inherited) <- {
        our WorldUnitSelection: selection <- frame!.unitSelection
        if(selection!.active.contains(source!.node!.pItem)){
            frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Cyclic unit representation"; stopFrame(request, frame); return(false)
        }
        our WorldUnit: member <- graph.writtenUnit(request, source, inherited)
        if(member==NULL or graph.compareNominal(selection!.unit!.base, member!.base)!=worldReady){
            frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Stored list has no compatible homogeneous unit"; stopFrame(request, frame); return(false)
        }
        our WorldUnitLevel:: level; level!.source <- source!.node!.pItem; level!.member <- member; level!.start <- selection!.end
        level!.walk!.push(source); selection!.levels.append(level); selection!.active.insert(source!.node!.pItem)
        return(true)
    }
    // Create only the demanded view. Leaves borrow facts from their original
    // occurrences; the request records where a later checked write belongs.
    our POV: unitView(our WorldRequest: request, our WorldUnitSelection: selection, our WorldUnit: unit, me FlexNum: start, me FlexNum: count, me bool: collection) <- {
        while(selection!.segment<selection!.segments.size() and
              selection!.segments[selection!.segment].start+selection!.segments[selection!.segment].width<=start){selection!.segment <+- 1}
        me WorldUnitSegment: segment
        if(selection!.segment<selection!.segments.size()){segment <- selection!.segments[selection!.segment]}
        else if(!collection or count!=0){return(NULL)}
        our WorldUnitOrigin: gap
        if(segment.gap){
            Allocate(gap); gap!.sparse <- true; gap!.source <- segment.source
            gap!.offset <- start-segment.start; gap!.count <- segment.width
            if(request!.unitOrigins.containsKey(segment.source!.node!.pItem)){
                our WorldUnitOrigin: original <- request!.unitOrigins.at(segment.source!.node!.pItem)
                if(original!.sparse){gap!.source <- original!.source; gap!.offset <+- original!.offset; gap!.count <- original!.count}
                else{return(NULL)}
            }else if(segment.member!.member!=NULL){return(NULL)}
        }
        if(unit!.member==NULL and !collection){
            our POV:: leaf{941}; Allocate(leaf!.pItem)
            if(segment.gap){
                leaf!.pItem!.itmMode <- mItem; leaf!.pItem!.streamState <- parseDone
                leaf!.pItem!.type <- unit!.word
                leaf!.pItem!.infSize!.evalMode <- emUnknown; leaf!.pItem!.infSize!.overlayType <- NUM
            }
            else{leaf!.pItem! <- segment.source!.node!.pItem!}
            leaf!.pItem!.isNormed <- false; leaf!.pItem!.worldScalarCompletionOwner <- NULL
            if(leaf!.pItem!.type==NULL and leaf!.pItem!.addedTypes.isEmpty()){leaf!.pItem!.addedTypes.append(unit!.word)}
            our WorldUnitOrigin:: origin; origin!.source <- segment.source
            if(gap!=NULL){origin <- gap}
            request!.unitOrigins.insert(leaf!.pItem, origin)
            return(leaf)
        }
        our POV:: result{941}; Allocate(result!.pItem)
        our infonView: body <- result!.pItem
        body!.itmMode <- mItem; body!.streamState <- parseDone; body!.viewMode <- vmOverlay; body!.orderMode <- uOrdered
        body!.value!.overlayType <- LST; body!.value!.evalMode <- emLiteral
        body!.infSize!.overlayType <- NUM; body!.infSize!.evalMode <- emLiteral; body!.value!.sizeMode <- fromCount
        body!.wordDerefed <- true
        our WorldUnit: member <- unit
        if(!collection){body!.type <- unit!.word; body!.value!.timelike <- unit!.word!.defToUse!.value!.timelike; member <- unit!.member; count <- unit!.count}
        body!.infSize!.num <- count
        if(gap!=NULL and start+count*member!.width<=segment.start+segment.width){
            Allocate(body!.value!.listSpec); body!.value!.listSpec!.itmMode <- mItem; body!.value!.listSpec!.streamState <- parseDone
            body!.value!.listSpec!.infSize!.evalMode <- emUnknown; body!.value!.listSpec!.infSize!.overlayType <- NUM
            body!.value!.listSpec!.type <- member!.word; body!.value!.tailUnfinished <- true; body!.value!.sizeMode <- fromGiven
            gap!.member <- member; gap!.membersCount <- count; request!.unitOrigins.insert(body, gap)
            return(result)
        }
        our WorldUnitOrigin:: origin
        me FlexNum: n
        while(n<count){
            our POV: child <- unitView(request, selection, member, start+n*member!.width, FlexNum("1"), false)
            if(child==NULL){return(NULL)}
            body!.value!.items.appendPov(child); child!.pParent <- result
            origin!.members.append(child); n <+- 1
        }
        request!.unitOrigins.insert(body, origin)
        return(result)
    }
    void: selectUnit(our WorldRequest: request, our WorldFrame: frame) <- {
        our WorldUnitSelection: selection <- frame!.unitSelection
        if(selection!.result!=NULL){
            if(selection!.result!.facts.outcome!=worldReady){frame!.facts <- selection!.result!.facts; stopFrame(request, frame); return()}
            frame!.facts <- selection!.result!.facts; frame!.retainedWork <- selection!.result!.retainedWork
            graph.adoptListRequirements(frame, selection!.result)
            Allocate(frame!.correspondenceResult); frame!.correspondenceResult!.position <- graph.position(selection!.result!.node)
            if(selection!.writeThrough and !stageSelection(request, frame)){return()}
            frame!.initialized <- true; frame!.finished <- true; return()
        }
        if(!selection!.entered and (selection!.source!.node!.pItem!.viewMode==vmCursor or
           selection!.source!.node!.pItem!.partRef!=NULL or !selection!.source!.node!.pItem!.parts.isEmpty())){
            if(selection!.sourceReference==NULL){
                selection!.sourceReference <- makeFrame(request, selection!.source!.node, selection!.source)
                selection!.sourceReference!.referenceOnly <- true
                request!.ready.append(frame); request!.ready.append(selection!.sourceReference); return()
            }
            if(selection!.sourceReference!.facts.outcome!=worldReady){frame!.facts <- selection!.sourceReference!.facts; stopFrame(request, frame); return()}
            our WorldCorrespondenceResult: source <- selection!.sourceReference!.correspondenceResult
            if(source==NULL or source!.position==NULL){frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Unit correspondence needs one source occurrence"; stopFrame(request, frame); return()}
            selection!.source <- source!.position
        }
        if(!selection!.entered){
            our WorldUnit: leaf <- selection!.unit
            while(leaf!.member!=NULL){leaf <- leaf!.member}
            if(!pushUnitLevel(request, frame, selection!.source, leaf)){return()}
            selection!.entered <- true
        }
        me FlexNum: index <- selection!.coordinate
        if(index>=0 and !selection!.explicitSpec){index <- index-1}
        if(selection!.coordinate==0 and !selection!.explicitSpec){
            frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Selected unit index is outside the source"; stopFrame(request, frame); return()
        }
        while(!selection!.levels.isEmpty()){
            if(index>=0 and selection!.end>=(index+selection!.prefix+selection!.count+selection!.suffix)*selection!.unit!.width){break()}
            our WorldUnitLevel: level <- selection!.levels.last()
            if(level!.pending==NULL){level!.pending <- graph.nextPosition(request, level!.walk)}
            if(!walkReady(request, frame, level!.walk)){return()}
            our WorldPosition: position <- level!.pending
            if(position==NULL){
                // A level's source is retained by its active entry until exit.
                selection!.active.erase(level!.source); selection!.levels.popLast(); continue()
            }
            me WorldScalar: header <- graph.read(request, position!.node, position!.node!.pParent)
            if(header.outcome==worldWaiting){waitAt(request, frame, position!.node!.pItem); return()}
            if(header.outcome!=worldReady){frame!.facts <- header; stopFrame(request, frame); return()}
            if(position!.tail){
                if(!header.hasSize){frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Unit window crosses an unknown endpoint"; stopFrame(request, frame); return()}
                me FlexNum: width <- header.size*level!.member!.width-(selection!.end-level!.start)
                if(width<0){frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Unit representation exceeds its extent"; stopFrame(request, frame); return()}
                if(width>0){me WorldUnitSegment: gap; gap.member <- level!.member; gap.source <- position; gap.start <- selection!.end; gap.width <- width; gap.gap <- true; selection!.segments.append(gap); selection!.end <+- width}
                level!.pending <- NULL; continue()
            }
            if(position!.embedded){
                if(!pushUnitLevel(request, frame, position, level!.member)){return()}
                level!.pending <- NULL; continue()
            }
            our WorldUnit: actual <- level!.member
            if(header.nominal!=NULL){
                me Set<our infonView>: seen
                actual <- graph.unitMeasure(request, header.nominal, seen)
            }
            if(actual==NULL or graph.compareNominal(selection!.unit!.base, actual!.base)!=worldReady){
                frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Stored member has incompatible unit evidence"; stopFrame(request, frame); return()
            }
            if(actual!.member!=NULL){
                if(!pushUnitLevel(request, frame, position, actual!.member)){return()}
            }else{
                if(header.overlay!=NUM and header.overlay>=0){frame!.facts.outcome <- worldRejected; frame!.facts.detail <- "Unit leaf contradicts its numeric definition"; stopFrame(request, frame); return()}
                me WorldUnitSegment: segment; segment.member <- actual; segment.source <- position; segment.start <- selection!.end; segment.width <- FlexNum("1")
                selection!.segments.append(segment); selection!.end <+- 1
            }
            level!.pending <- NULL
        }
        if(index<0){
            me FlexNum: extent <- selection!.end/selection!.unit!.width
            if(extent.getDenominator()!=1){frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Source endpoint does not align to requested units"; stopFrame(request, frame); return()}
            index <+- extent
        }
        if(index<0 or (index+selection!.prefix+selection!.count+selection!.suffix)*selection!.unit!.width>selection!.end){
            frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Selected unit window is outside the source"; stopFrame(request, frame); return()
        }
        our POV: projected <- unitView(request, selection, selection!.unit, (index+selection!.prefix)*selection!.unit!.width, selection!.count, selection!.span)
        if(projected==NULL){frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Unit view needs a demanded sparse occurrence"; stopFrame(request, frame); return()}
        projected!.pItem!.wrkList <- frame!.node!.pItem!.wrkList
        selection!.result <- makeFrame(request, projected)
        selection!.result!.referenceOnly <- frame!.referenceOnly
        // Positional acquisition can return the bare sparse recipe. An
        // explicit numeric pattern instead asks its ordinary frame for NUM.
        if(frame!.acquireOnly and selection!.unit!.member==NULL and !selection!.span and
           request!.unitOrigins.containsKey(projected!.pItem) and request!.unitOrigins.at(projected!.pItem)!.sparse){selection!.result!.referenceOnly <- true}
        request!.ready.append(frame); request!.ready.append(selection!.result)
    }


    // Paths describe consumers of selection, never a separate search engine.
    our WorldFrame: pathSelection(our WorldRequest: request, our WorldPosition: source,
                                 our PartPath: part, our WorldFrame: index) <- {
        our WorldFrame: units <- unitOperation(request, source, part, index)
        if(units!=NULL){return(units)}
        if(part!.pathMode==idxField and part!.spec!=NULL and part!.spec!.value!.overlayType!=LST){
            me FlexNum: boundary <- index!.facts.number
            our PartPath:: search; search!.pathMode <- dotField; search!.path <- part!.spec
            our WorldFrame: result <- pathSelection(request, source, search, NULL)
            if(boundary<0){
                me WorldScalar: header <- graph.read(request, source!.node, source!.node!.pParent)
                if(header.outcome!=worldReady or !header.hasSize){result!.facts.outcome <- worldPartial; result!.facts.detail <- "Search boundary needs a known endpoint"; result!.initialized <- true; result!.finished <- true; return(result)}
                boundary <+- header.size
            }
            if(boundary<0){result!.facts.outcome <- worldPartial; result!.facts.detail <- "Search boundary is outside the source"; result!.initialized <- true; result!.finished <- true; return(result)}
            result!.selection!.domain <- graph.offsetDomain(result!.selection!.domain, boundary)
            Allocate(result!.selection!.walk); result!.selection!.walk!.push(result!.selection!.domain)
            result!.selection!.walk!.stopAt <- result!.node!.pItem!.intersectMarkedRetPOV
            result!.node!.pItem!.wrkList.clear()
            if(part!.continuation!=NULL){result!.node!.pItem!.wrkList <- part!.continuation!.wrkList}
            result!.acquireOnly <- result!.node!.pItem!.wrkList.isEmpty()
            return(result)
        }
        our infonView:: query
        query!.itmMode <- mItem; query!.streamState <- parseDone
        query!.viewMode <- vmOverlay; query!.value!.evalMode <- emIntersection
        query!.value!.overlayType <- tUnknown; query!.intersectPos <- ipGetLast
        Allocate(query!.innr); query!.innr!.itmMode <- mItem; query!.innr!.streamState <- parseDone
        query!.innr!.value!.overlayType <- LST; query!.innr!.value!.evalMode <- emLiteral
        query!.innr!.infSize!.overlayType <- NUM; query!.innr!.infSize!.evalMode <- emUnknown
        our POV:: node{940}; node!.pItem <- query
        our WorldFrame: operation <- makeFrame(request, node)
        Allocate(operation!.selection)
        our WorldSelection: selection <- operation!.selection
        our infonView: work <- part!.path
        if(part!.pathMode==idxField){work <- part!.continuation}
        if(work!=NULL){query!.wrkList <- work!.wrkList}
        me string: primitive <- graph.pathOperator(part!.path)
        if(part!.pathMode==idxField or
           (source!.node!.pItem!.orderMode!=uUnordered and (primitive=="first" or primitive=="last"))){
            selection!.domain <- source; selection!.walk!.push(source)
            if(part!.pathMode==idxField){selection!.index <- index!.facts.number}
            else if(primitive=="first"){selection!.index <+- 1}
            // Last is the ordinary end-based selection. A negative index is
            // converted only with a proved endpoint, never the physical tail.
            if(selection!.index<0){
                me WorldScalar: header <- graph.read(request, source!.node, source!.node!.pParent)
                if(header.outcome!=worldReady or !header.hasSize){
                    operation!.facts.outcome <- worldPartial; operation!.facts.detail <- "End-relative selection needs a known endpoint"
                    operation!.initialized <- true; operation!.finished <- true; return(operation)
                }
                selection!.index <+- header.size
                if(part!.spec==NULL){selection!.index <+- 1}
            }
            if(part!.pathMode==idxField and (selection!.index<0 or (selection!.index==0 and part!.spec==NULL))){
                operation!.facts.outcome <- worldPartial; operation!.facts.detail <- "Selected index is outside the source"
                operation!.initialized <- true; operation!.finished <- true; return(operation)
            }
            if(part!.spec!=NULL){
                if(part!.spec!.value!.overlayType!=LST or part!.spec!.value!.evalMode!=emLiteral or
                   part!.spec!.partRef!=NULL or !part!.spec!.parts.isEmpty()){
                    operation!.facts.outcome <- worldUnsupported; operation!.facts.detail <- "Slice specification needs a list-valued layout"
                    operation!.initialized <- true; operation!.finished <- true; return(operation)
                }
                // A slice starts at a zero-based boundary. Scalar item
                // indices remain one-based; negative coordinates share the end.
                our infonView: capture <- graph.pathBody(part!.spec, false)
                query!.intersectMarkedRetPOV <- query!.innr!.value!.items.append(capture, true, 940)
                query!.intersectPos <- ipGetMarked
                our POV:: body{940}; body!.pItem <- query!.innr
                selection!.domain <- graph.position(body)
                our POV:: input{940}; input! <- source!.node!; input!.pParent <- NULL; input!.looseTop <- true
                selection!.domain!.input <- input; selection!.domain!.inputContext <- source
                selection!.domain <- graph.offsetDomain(selection!.domain, selection!.index)
                Allocate(selection!.walk); selection!.walk!.push(selection!.domain)
                selection!.walk!.stopAt <- query!.intersectMarkedRetPOV; selection!.index <- 0
            }
        }else{
            our infonView: predicate <- graph.pathBody(part!.path, true)
            our infonView: negative <- graph.pathBody(predicate, true); negative!.invertMatch <- !predicate!.invertMatch
            our infonView:: skip
            skip!.itmMode <- mItem; skip!.streamState <- parseDone; skip!.viewMode <- vmOverlay
            skip!.value!.overlayType <- LST; skip!.value!.evalMode <- emLiteral
            skip!.value!.tailUnfinished <- true; skip!.value!.listSpec <- negative
            skip!.infSize!.overlayType <- NUM; skip!.infSize!.evalMode <- emUnknown
            query!.innr!.value!.items.append(skip, true, 940)
            query!.intersectMarkedRetPOV <- query!.innr!.value!.items.append(predicate, false, 940)
            query!.intersectPos <- ipGetMarked
            our POV:: body{940}; body!.pItem <- query!.innr
            selection!.domain <- graph.position(body)
            our POV:: input{940}; input! <- source!.node!; input!.pParent <- NULL; input!.looseTop <- true
            selection!.domain!.input <- input; selection!.domain!.inputContext <- source
            selection!.walk!.push(selection!.domain); selection!.walk!.stopAt <- query!.intersectMarkedRetPOV
        }
        operation!.acquireOnly <- work==NULL or work!.wrkList.isEmpty()
        operation!.referenceOnly <- operation!.acquireOnly and work!=NULL and (work!.partRef!=NULL or !work!.parts.isEmpty())
        return(operation)
    }

    me bool: stageOccurrence(our WorldRequest: request, our WorldPosition: destination, our WorldFrame: facts) <- {
        if(destination==NULL){request!.outcome <- worldPartial; request!.detail <- "Write needs an established source occurrence"; return(false)}
        if(request!.unitOrigins.containsKey(destination!.node!.pItem)){
            our WorldUnitOrigin: origin <- request!.unitOrigins.at(destination!.node!.pItem)
            if(origin!.sparse){
                if(origin!.member!=NULL){
                    if(facts!.facts.overlay!=LST or graph.openLayout(facts!.facts) or
                       FlexNum(graph.sequenceLength(facts!.facts.sequence))!=origin!.membersCount){
                        request!.outcome <- worldPartial; request!.detail <- "Sparse window write needs corresponding member extents"; return(false)
                    }
                    me WorldListCursor: values; values.push(facts!.facts.sequence)
                    our WorldFrame: member <- values.next(); me FlexNum: offset <- origin!.offset
                    while(member!=NULL){
                        our POV:: node{942}; Allocate(node!.pItem); node!.pItem! <- member!.node!.pItem!
                        our WorldUnitOrigin:: child; child!.sparse <- true; child!.source <- origin!.source
                        child!.offset <- offset; child!.count <- origin!.count
                        child!.member <- origin!.member!.member; child!.membersCount <- origin!.member!.count
                        request!.unitOrigins.insert(node!.pItem, child)
                        if(!stageOccurrence(request, graph.position(node), member)){return(false)}
                        offset <+- origin!.member!.width; member <- values.next()
                    }
                    return(true)
                }
                if(!origin!.source!.writable or origin!.offset<0 or origin!.offset>=origin!.count or
                   origin!.offset.getDenominator()!=1 or origin!.count.getDenominator()!=1 or
                   origin!.count>FlexNum("9223372036854775807")){
                    request!.outcome <- worldUnsupported; request!.detail <- "Sparse destination exceeds model coordinate bounds"; return(false)
                }
                our infonView: key <- origin!.source!.node!.pItem
                if(!request!.sparseEdits.containsKey(key)){
                    our WorldSparseBatch:: batch; batch!.source <- origin!.source; batch!.count <- origin!.count.convertToInt()
                    request!.sparseEdits.insert(key, batch)
                }
                our WorldSparseBatch: batch <- request!.sparseEdits.at(key)
                me int64: index <- origin!.offset.convertToInt()
                if(batch!.edits.containsKey(index)){
                    our WorldFrame: prior <- batch!.edits.at(index)!.frame
                    our POV:: equality{942}
                    me WorldScalar: checked <- graph.merge(prior!.facts, facts!.facts, equality)
                    if(checked.outcome!=worldReady){request!.outcome <- checked.outcome; request!.detail <- checked.detail; return(false)}
                    prior!.facts <- checked; return(true)
                }
                our WorldSparseEdit:: edit; edit!.index <- index; edit!.frame <- projectFrame(request, facts)
                our POV:: node{942}; Allocate(node!.pItem); node!.pItem! <- destination!.node!.pItem!
                edit!.frame!.node <- node; edit!.frame!.context <- NULL; edit!.frame!.selection <- NULL; edit!.frame!.finished <- true
                batch!.edits.insert(index, edit); request!.edits.insert(node!.pItem, edit!.frame)
                return(true)
            }
            if(origin!.source!=NULL){return(stageOccurrence(request, origin!.source, facts))}
            if(facts!.facts.overlay!=LST or graph.openLayout(facts!.facts) or graph.sequenceLength(facts!.facts.sequence)!=origin!.members.size()){
                request!.outcome <- worldPartial; request!.detail <- "Unit write needs corresponding member extents"; return(false)
            }
            me WorldListCursor: members; members.push(facts!.facts.sequence)
            withEach member in origin!.members{if(!stageOccurrence(request, graph.position(member), members.next())){return(false)}}
            return(true)
        }
        if(!destination!.writable){
            request!.outcome <- worldUnsupported; request!.detail <- "Write needs an instance of the borrowed definition occurrence"; return(false)
        }
        our WorldFrame: update <- projectFrame(request, facts)
        update!.node <- destination!.node; update!.context <- destination
        update!.finished <- true; update!.selection <- NULL
        if(request!.edits.containsKey(update!.node!.pItem)){request!.edits.at(update!.node!.pItem) <- update}
        else{request!.edits.insert(update!.node!.pItem, update)}
        return(true)
    }
    me bool: stageSelection(our WorldRequest: request, our WorldFrame: operation) <- {
        our WorldCorrespondenceResult: selected <- operation!.correspondenceResult
        if(selected==NULL or !graph.representableFacts(operation!.facts)){
            request!.outcome <- worldPartial; request!.detail <- "Write needs established correspondence and facts"; return(false)
        }
        if(!selected!.span){return(stageOccurrence(request, selected!.position, operation))}
        if(operation!.facts.overlay!=LST or graph.openLayout(operation!.facts) or
           graph.sequenceLength(operation!.facts.sequence)!=selected!.positions.size()){
            request!.outcome <- worldPartial; request!.detail <- "Span write needs matched extents"; return(false)
        }
        me WorldListCursor: members; members.push(operation!.facts.sequence)
        withEach destination in selected!.positions{
            if(!stageOccurrence(request, destination, members.next())){return(false)}
        }
        return(true)
    }

    // A temporal neighbour is justified by a closed occurrence boundary.
    // Keep the occurrence cursor across header waits; do not search an S-list.
    me bool: cursorSource(our WorldRequest: request, our WorldFrame: frame) <- {
        our WorldPath: path <- frame!.path
        me bool: previous <- frame!.node!.pItem!.cursorMode==cmTPrev
        if(path!.cursor==NULL){path!.cursor <- frame!.navigation}
        while(path!.cursor!=NULL){
            our WorldPosition: at <- path!.cursor
            if(path!.descending){
                if(at!.node!.pItem!.viewMode==vmCursor or at!.node!.pItem!.partRef!=NULL or !at!.node!.pItem!.parts.isEmpty()){
                    path!.source <- at; return(true)
                }
                me WorldScalar: header <- graph.read(request, at!.node, at!.node!.pParent)
                if(header.outcome==worldWaiting){waitAt(request, frame, at!.node!.pItem); return(false)}
                if(header.outcome!=worldReady){frame!.facts <- header; stopFrame(request, frame); return(false)}
                if(header.overlay<0 and !header.hasValue and header.nominal!=NULL and header.nominal!.defToUse!=NULL){
                    if(path!.cursorLayout==NULL){Allocate(path!.cursorLayout); path!.cursorLayout!.push(at)}
                    if(!graph.enterLayout(request, path!.cursorLayout)){
                        our WorldPosition: resolved <- path!.cursorLayout!.levels.last()!.position
                        me WorldScalar: value <- graph.read(request, resolved!.node, resolved!.node!.pParent)
                        if(path!.cursorLayout!.outcome==worldUnsupported and value.outcome==worldReady and value.overlay>=0 and value.overlay!=LST){path!.source <- at; path!.cursorLayout <- NULL; return(true)}
                        walkReady(request, frame, path!.cursorLayout); return(false)
                    }
                    path!.cursor <- path!.cursorLayout!.levels.last()!.position; path!.cursorLayout <- NULL; continue()
                }
                if(header.overlay!=LST or !header.timelike or header.order==uUnordered){path!.source <- at; return(true)}
                if(previous and header.openTail){frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Temporal neighbour needs the preceding endpoint"; stopFrame(request, frame); return(false)}
                our POV: member <- at!.node!.pItem!.value!.items.head
                if(previous){member <- at!.node!.pItem!.value!.items.tail}
                if(member!=NULL){path!.cursor <- graph.position(member, at); continue()}
                if(header.openTail){frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Temporal neighbour needs a represented occurrence"; stopFrame(request, frame); return(false)}
                path!.descending <- false
            }
            our WorldPosition: parent <- at!.parent
            if(parent==NULL){break()}
            me WorldScalar: header <- graph.read(request, parent!.node, parent!.node!.pParent)
            if(header.outcome==worldWaiting){waitAt(request, frame, parent!.node!.pItem); return(false)}
            if(header.outcome!=worldReady){frame!.facts <- header; stopFrame(request, frame); return(false)}
            if(header.overlay!=LST or !header.timelike or header.order==uUnordered){break()}
            our POV: member <- at!.owner!.next
            if(previous){member <- at!.owner!.prev}
            if(member!=NULL){path!.cursor <- graph.position(member, parent); path!.descending <- true; continue()}
            if(!previous and header.openTail){frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Temporal neighbour needs a represented successor"; stopFrame(request, frame); return(false)}
            path!.cursor <- parent
        }
        our POV:: absent{944}; Allocate(absent!.pItem)
        absent!.pItem!.itmMode <- mItem; absent!.pItem!.streamState <- parseDone
        absent!.pItem!.value!.undefined <- true
        path!.source <- graph.position(absent)
        return(true)
    }

    void: pathStep(our WorldRequest: request, our WorldFrame: frame) <- {
        frame!.contextual <- true
        if(frame!.node!.pItem!.streamState==parseStarted or frame!.node!.pItem!.streamState==parseListReady){waitAt(request, frame, frame!.node!.pItem); return()}
        if(frame!.node!.pItem!.graphParseError!=""){frame!.facts.outcome <- worldError; frame!.facts.detail <- frame!.node!.pItem!.graphParseError; stopFrame(request, frame); return()}
        if(frame!.path==NULL){Allocate(frame!.path)}
        if(frame!.path!.source==NULL){
            our POV:: base{940}; base! <- frame!.node!
            our infonView: item <- frame!.node!.pItem
            if(item!.viewMode==vmCursor){
                if(item!.cursorMode==cmTPrev or item!.cursorMode==cmTNext){
                    if(!cursorSource(request, frame)){return()}
                }else if(item!.cursorMode==cmSelf){
                    our WorldPosition: instance <- frame!.navigation
                    while(instance!=NULL and !instance!.node!.trueByDefinition){instance <- instance!.parent}
                    if(instance==NULL){frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Self needs a containing definition occurrence"; stopFrame(request, frame); return()}
                    frame!.path!.source <- graph.position(instance!.owner, instance!.parent)
                }else if(item!.cursorMode==cmWorld){
                    if(request!.worldSource==NULL){frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "World source is not available"; stopFrame(request, frame); return()}
                    if(control!.worldRoot==NULL or control!.worldRoot!.pItem!==request!.worldSource){Allocate(control!.worldRoot, 944); control!.worldRoot!.pItem <- request!.worldSource}
                    frame!.path!.source <- graph.position(control!.worldRoot)
                }else{frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Cursor needs an occurrence provider"; stopFrame(request, frame); return()}
            }else{
                base!.pItem <- graph.pathBody(item, false)
                frame!.path!.source <- graph.position(base); frame!.path!.source!.owner <- frame!.node; frame!.path!.source!.occurrence <- frame!.node
                if(frame!.context!=NULL){
                    frame!.path!.source!.parent <- frame!.context!.parent
                    frame!.path!.source!.owner <- frame!.context!.owner; frame!.path!.source!.occurrence <- frame!.context!.occurrence
                    frame!.path!.source!.writable <- frame!.context!.writable
                }
            }
        }
        our WorldPath: path <- frame!.path
        our infonView: instructions <- frame!.node!.pItem
        if(path!.part==NULL){
            if(path!.next<instructions!.parts.size()){
                path!.part <- instructions!.parts[path!.next]; path!.next <+- 1
            }else if(!path!.returned and instructions!.partRef!=NULL){
                path!.part <- instructions!.partRef; path!.returned <- true
            }else{
                if(frame!.referenceOnly){
                    frame!.facts <- graph.read(request, path!.source!.node, path!.source!.node!.pParent)
                    if(frame!.facts.outcome==worldWaiting){waitAt(request, frame, path!.source!.node!.pItem); return()}
                    Allocate(frame!.correspondenceResult); frame!.correspondenceResult!.position <- path!.source
                    frame!.initialized <- true; frame!.finished <- true
                    if(frame!.facts.outcome!=worldReady){stopFrame(request, frame)}
                    return()
                }
                if(path!.operation==NULL){
                    // A retained parent is itself the requested value. Its
                    // outstanding meanings remain ordinary normalization work.
                    path!.operation <- makeFrame(request, path!.source!.node, path!.source, frame!.demandSize)
                    path!.operation!.referenceOnly <- frame!.referenceOnly
                    request!.ready.append(frame); request!.ready.append(path!.operation); return()
                }
                frame!.facts <- path!.operation!.facts; frame!.retainedWork <- path!.operation!.retainedWork
                graph.adoptListRequirements(frame, path!.operation)
                Allocate(frame!.correspondenceResult); frame!.correspondenceResult!.position <- path!.source
                frame!.initialized <- true; frame!.finished <- true
                if(frame!.facts.outcome!=worldReady){stopFrame(request, frame)}
                return()
            }
            me string: primitive <- graph.pathOperator(path!.part!.path)
            if(path!.part!.pathMode==dotField and (primitive=="cut" or primitive=="astlist")){
                frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Path needs a boundary occurrence provider"; stopFrame(request, frame); return()
            }
            if(path!.part!.pathMode!=dotField and path!.part!.pathMode!=idxField){
                frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Path needs an additional relation provider"; stopFrame(request, frame); return()
            }
        }
        me string: primitive <- graph.pathOperator(path!.part!.path)
        if(path!.part!.pathMode==idxField and path!.index==NULL){
            our POV:: index{940}; index!.pItem <- path!.part!.path
            path!.index <- makeFrame(request, index)
            request!.ready.append(frame); request!.ready.append(path!.index); return()
        }
        if(path!.operation==NULL){
            if(path!.index!=NULL and (path!.index!.facts.outcome!=worldReady or !path!.index!.facts.hasValue or
               path!.index!.facts.overlay!=NUM or path!.index!.facts.number.getDenominator()!=1)){
                frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Index needs an integer value"; stopFrame(request, frame); return()
            }
            if(path!.part!.pathMode==dotField and (primitive=="begin" or primitive=="end")){
                if(!path!.part!.path!.wrkList.isEmpty()){
                    frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Boundary constraints need occurrence identity proof"; stopFrame(request, frame); return()
                }
                our infonView: source <- path!.source!.node!.pItem
                if(source!.graphParseError!=""){frame!.facts.outcome <- worldError; frame!.facts.detail <- source!.graphParseError; stopFrame(request, frame); return()}
                if(source!.streamState==parseStarted or source!.streamState==parseListReady){waitAt(request, frame, source); return()}
                our POV: boundary <- graph.boundaryOf(request, path!.source, primitive=="end")
                our WorldPosition: position <- graph.position(boundary)
                path!.operation <- makeFrame(request, boundary, position)
                Allocate(path!.operation!.correspondenceResult); path!.operation!.correspondenceResult!.position <- position
            }else{path!.operation <- pathSelection(request, path!.source, path!.part, path!.index)}
            path!.operation!.demandSize <- frame!.demandSize
            if(frame!.referenceOnly and path!.operation!.acquireOnly){path!.operation!.referenceOnly <- true}
            request!.ready.append(frame); request!.ready.append(path!.operation); return()
        }
        if(path!.operation!.facts.outcome!=worldReady){frame!.facts <- path!.operation!.facts; stopFrame(request, frame); return()}
        our infonView: work <- path!.part!.path
        if(path!.part!.pathMode==idxField){work <- path!.part!.continuation}
        if(!path!.applied){
            if(work!=NULL and !work!.wrkList.isEmpty() and !stageSelection(request, path!.operation)){return()}
            path!.applied <- true
        }
        if(work!=NULL and (work!.partRef!=NULL or !work!.parts.isEmpty())){
            if(path!.nested==NULL){
                our WorldCorrespondenceResult: selected <- path!.operation!.correspondenceResult
                if(selected==NULL or selected!.position==NULL){frame!.facts.outcome <- worldPartial; frame!.facts.detail <- "Chained path needs one source occurrence"; stopFrame(request, frame); return()}
                our POV:: child{940}; child!.pItem <- graph.pathBody(selected!.position!.node!.pItem, false)
                child!.pItem!.partRef <- work!.partRef; child!.pItem!.parts <- work!.parts
                path!.nested <- makeFrame(request, child, NULL, frame!.demandSize)
                path!.nested!.referenceOnly <- frame!.referenceOnly
                Allocate(path!.nested!.path); path!.nested!.path!.source <- selected!.position
                request!.ready.append(frame); request!.ready.append(path!.nested); return()
            }
            if(path!.nested!.facts.outcome!=worldReady){frame!.facts <- path!.nested!.facts; stopFrame(request, frame); return()}
        }
        if(path!.returned){
            our WorldFrame: result <- path!.operation
            if(path!.nested!=NULL){result <- path!.nested}
            frame!.facts <- result!.facts; frame!.retainedWork <- result!.retainedWork
            graph.adoptListRequirements(frame, result)
            frame!.correspondenceResult <- result!.correspondenceResult
            frame!.initialized <- true; frame!.finished <- true; return()
        }
        path!.operation <- NULL; path!.nested <- NULL; path!.index <- NULL; path!.part <- NULL; path!.applied <- false
        request!.ready.append(frame)
    }

    void: step(our WorldRequest: request, our WorldFrame: frame) <- {
        if(frame!.unitSelection!=NULL){selectUnit(request, frame); return()}
        if(frame!.fields!=NULL){mergeFields(request, frame); return()}
        if(!frame!.initialized and (frame!.path!=NULL or frame!.node!.pItem!.viewMode==vmCursor or frame!.node!.pItem!.partRef!=NULL or !frame!.node!.pItem!.parts.isEmpty())){pathStep(request, frame); return()}
        if(!frame!.initialized and frame!.node!.pItem!.value!=NULL and frame!.node!.pItem!.value!.evalMode==emIntersection){selectMember(request, frame); return()}
        if(!frame!.initialized){
            our infonView: input <- frame!.node!.pItem
            me bool: suppliedProjection <- input!.value!=NULL and graph.projectionTemplate(input!.value!.listSpec) and !input!.wrkList.isEmpty() and
                input!.wrkList[0]!.looseMode and !input!.wrkList[0]!.forceID
            me bool: hasInput <- input!.value!=NULL and input!.argPos==apNoArgs and ((input!.hasInnrOutr and input!.funcArgs!=NULL) or suppliedProjection) and
                input!.value!.evalMode==emLiteral and input!.value!.overlayType==LST
            frame!.facts <- graph.read(request, frame!.node, frame!.expressionParent, hasInput, false, frame!.predicateOnly)
            if(hasInput and frame!.facts.outcome==worldReady){
                Allocate(frame!.inputEdge, 941); frame!.inputEdge!.pItem <- input!.funcArgs; frame!.inputEdge!.looseMode <- true
                if(input!.funcArgs==NULL){frame!.inputEdge <- input!.wrkList[0]; frame!.nextWork <- 1}
                frame!.lookup <- graph.correspondence(NULL, frame!.inputEdge, NULL, true, true)
                // Input feeds a pattern; each projected body's predicates use
                // ordinary membership proof rather than endpoint unification.
                Allocate(frame!.lookup!.memberEdge, 941); frame!.lookup!.memberEdge!.pItem <- frame!.inputEdge!.pItem
                Allocate(frame!.lookup!.chart)
                our WorldPosition: position <- graph.position(frame!.node); position!.input <- frame!.inputEdge
                frame!.lookup!.chart!.patternPosition <- position; frame!.expressionSlot <- 3
            }
            if(frame!.facts.declaration!=NULL){
                frame!.facts.declaration <- graph.stageDefinition(request, frame!.node!.pItem)
            }
            // A pending header has not been inspected. Resume this exact read,
            // preserving all earlier frames and relationship cursors.
            if(frame!.facts.outcome==worldWaiting){
                request!.waitingFrame <- frame; request!.waitingInput <- frame!.node!.pItem
                if(!control!.inputWaiters.containsKey(request!.waitingInput)){
                    our WorldInputWaiters:: waiters
                    control!.inputWaiters.insert(request!.waitingInput, waiters)
                }
                control!.inputWaiters.at(request!.waitingInput)!.requests.append(request)
            }else{frame!.initialized <- true}
        }
        if(frame!.facts.outcome!=worldReady){
            stopFrame(request, frame); return()
        }
        if(frame!.referenceOnly and !frame!.selecting and frame!.lookup==NULL and
           (frame!.correspondenceResult!=NULL or frame!.context==NULL or frame!.context!.parent==NULL or frame!.context!.parent!.input==NULL)){
            frame!.finished <- true; return()
        }
        if(frame!.lookup!=NULL and !frame!.applyingListSpec){locateRHS(request, frame); return()}
        if(frame!.selecting and frame!.prerequisite!=NULL){
            frame!.contextual <- frame!.contextual or frame!.prerequisite!.contextual
            if(frame!.selection!.domain!.input!=NULL){frame!.correspondenceResult <- frame!.prerequisite!.correspondenceResult}
            else{
                Allocate(frame!.correspondenceResult); frame!.correspondenceResult!.position <- frame!.selection!.selected
                frame!.correspondenceResult!.facts <- frame!.prerequisite
            }
            frame!.facts <- frame!.prerequisite!.facts
            frame!.retainedWork <- frame!.prerequisite!.retainedWork
            graph.adoptListRequirements(frame, frame!.prerequisite)
            frame!.prerequisite <- NULL; frame!.selecting <- false
            if(frame!.facts.outcome!=worldReady){stopFrame(request, frame); return()}
        }
        if(frame!.prerequisite!=NULL){
            if(frame!.sourceEdge!=NULL and frame!.sourceEdge!.forceID and frame!.preparedReplacement!==frame!.sourceEdge and
               !frame!.sourceEdge!.looseType() and !frame!.facts.negative and frame!.facts.overlay!=LST and
               frame!.prerequisite!.facts.outcome==worldReady and !frame!.prerequisite!.facts.negative and
               frame!.prerequisite!.facts.hasValue and
               (frame!.prerequisite!.facts.overlay==NUM or frame!.prerequisite!.facts.overlay==STR)){
                // A replacement is a new value goal at the same destination.
                // Its old value's meaning/listSpec proofs cannot be reused.
                our WorldFrame: replacement <- projectFrame(request, frame!.prerequisite)
                replacement!.projected <- false; replacement!.acquireOnly <- false; replacement!.expressionSlot <- 3
                replacement!.nextWork <- replacement!.node!.pItem!.wrkList.size()
                if(replacement!.facts.nominal==NULL){
                    replacement!.facts.nominal <- frame!.facts.nominal; replacement!.facts.inheritedName <- frame!.facts.inheritedName
                    replacement!.facts.meaningApplied <- false
                }
                our WorldPosition: destination <- frame!.context
                if(frame!.correspondenceResult!=NULL){destination <- frame!.correspondenceResult!.position}
                replacement!.context <- destination
                replacement!.navigation <- frame!.navigation; replacement!.expressionParent <- frame!.expressionParent
                if(destination!=NULL){replacement!.parentContext <- destination!.parent; replacement!.navigation <- destination}
                frame!.preparedReplacement <- frame!.sourceEdge; frame!.prerequisite <- replacement
                request!.ready.append(frame); request!.ready.append(replacement); return()
            }
            if(frame!.prerequisite!.facts.outcome==worldRejected){frame!.facts <- frame!.prerequisite!.facts; stopFrame(request, frame); return()}
            if(frame!.facts.alternatives!=NULL or frame!.prerequisite!.facts.alternatives!=NULL){
                if(frame!.sourceIsOperand and !graph.memberSequence(frame)){
                    frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Alternative operands need expression or template distribution"; stopFrame(request, frame); return()
                }
                if(!frame!.sourceIsOperand and !frame!.sourceIsListSpec){mergeAlternatives(request, frame); return()}
            }
            if(graph.needsRequirements(frame!.prerequisite) and
               !(frame!.sourceIsOperand and graph.memberSequence(frame) and frame!.sourceEdge!.isSubItm)){
                frame!.prerequisite <- resolveRequirements(request, frame!.prerequisite)
                request!.ready.append(frame); request!.ready.append(frame!.prerequisite); return()
            }
            if(frame!.sourceIsOperand and graph.memberSequence(frame) and frame!.sourceEdge!.isSubItm and
               !graph.checkEmbedded(frame)){stopFrame(request, frame); return()}
            if(frame!.sourceIsOperand and graph.memberSequence(frame) and
               frame!.listSpecFrame!=NULL and !frame!.memberSpecified and
               frame!.prerequisite!.facts.outcome==worldReady){
                if(frame!.sourceEdge!.isSubItm){
                    frame!.prerequisite <- projectListSpec(request, frame!.prerequisite, frame!.listSpecFrame, frame!.listSpecEdge)
                }else{
                    frame!.prerequisite <- derivePair(request, frame!.prerequisite, frame!.listSpecFrame, frame!.listSpecEdge, true)
                    request!.templateApplications <+- 1
                }
                frame!.memberSpecified <- true
                request!.ready.append(frame); request!.ready.append(frame!.prerequisite); return()
            }
            if(!frame!.sourceIsOperand and !frame!.sourceIsListSpec and (frame!.sourceEdge!.trueByDefinition or frame!.facts.order==uUnordered or frame!.prerequisite!.facts.order==uUnordered) and
               !frame!.prerequisite!.facts.explicitSize and frame!.prerequisite!.tailRequirements==NULL and
               frame!.prerequisite!.listSpecFrame==NULL and graph.namedFields(frame!.facts) and graph.namedFields(frame!.prerequisite!.facts)){
                beginFields(request, frame); return()
            }
            if(!frame!.sourceIsOperand and !frame!.sourceIsListSpec and
               frame!.facts.overlay==LST and frame!.facts.hasValue and
               frame!.prerequisite!.facts.overlay==LST and frame!.prerequisite!.facts.hasValue and
               (frame!.facts.order==uUnordered or frame!.prerequisite!.facts.order==uUnordered)){
                frame!.facts.outcome <- worldUnsupported; frame!.facts.detail <- "Unordered correspondence needs member matching"; stopFrame(request, frame); return()
            }
            // A closed target proves the endpoint of a strict open source.
            // Project that source with the same correspondence operation, then
            // merge its checked result back into the original target shape.
            if(!frame!.sourceIsOperand and !frame!.sourceIsListSpec and
               !frame!.sourceEdge!.forceID and !frame!.sourceEdge!.looseType() and
               frame!.facts.overlay==LST and frame!.facts.hasValue and frame!.facts.hasSize and
               !graph.openLayout(frame!.facts) and frame!.facts.size==FlexNum(graph.sequenceLength(frame!.facts.sequence)) and
               frame!.prerequisite!.facts.outcome==worldReady and frame!.prerequisite!.facts.overlay==LST and
               frame!.prerequisite!.facts.hasValue and graph.openLayout(frame!.prerequisite!.facts)){
                our WorldFrame: endpoint <- projectFrame(request, frame); endpoint!.finished <- true
                // Nonnegative widths summing to zero are all zero. The checked
                // header proves emptiness without unfolding shared source spans.
                me bool: emptyProof <- false
                if(frame!.facts.size==0 and graph.representableFacts(frame!.prerequisite!.facts)){
                    me WorldScalar: bounded <- graph.fitExtent(frame!.prerequisite!.facts, FlexNum())
                    emptyProof <- bounded.outcome==worldReady
                }
                if(emptyProof){frame!.prerequisite <- endpoint}
                else{
                    frame!.prerequisite <- derivePair(request, frame!.prerequisite, endpoint, frame!.sourceEdge)
                    request!.ready.append(frame); request!.ready.append(frame!.prerequisite); return()
                }
            }
            if(!frame!.sourceIsOperand and !frame!.sourceIsListSpec and
               graph.openLayout(frame!.facts) and graph.openLayout(frame!.prerequisite!.facts)){
                frame!.openAlignment <- graph.alignOpen(request, frame)
            }
            graph.consumePrerequisite(request, frame)
            frame!.memberSpecified <- false
            if(frame!.facts.outcome!=worldReady){
                stopFrame(request, frame); return()
            }
        }
        if(frame!.corresponding){
            request!.ready.append(frame); correspond(request, frame); return()
        }
        if(frame!.projected){settleAlternatives(frame); frame!.finished <- true; return()}
        frame!.sourceEdge <- graph.nextRelationship(request, frame)
        if(frame!.sourceEdge==NULL){
            if(graph.needsRequirements(frame) and (frame===request!.root or !frame!.node!.pItem!.wrkList.isEmpty() or frame!.node!.pItem!.argPos!=apNoArgs)){
                graph.beginRequirements(frame); request!.ready.append(frame); return()
            }
            if(frame!.facts.outcome==worldReady and requestParentRHS(request, frame)){return()}
            if(frame!.acquireOnly and !frame!.facts.hasValue and frame!.facts.nominal!=NULL and
               frame!.facts.nominal!.defToUse!=NULL and !frame!.facts.meaningApplied and !frame!.meaningRequested and !frame!.predicateOnly){
                request!.ready.append(frame); return()
            }
            settleAlternatives(frame); frame!.finished <- true
            if(frame!.facts.outcome!=worldReady){stopFrame(request, frame)}
            return()
        }
        request!.relationshipsRead <+- 1
        our POV: source <- frame!.sourceEdge
        if(source!.pItem==NULL){request!.outcome <- worldError; request!.detail <- "Empty relationship"; return()}
        if(source!.viewMap.sourcePov!=NULL or source!.referenceAlias.sourcePov!=NULL or
           (source!.pParent!=NULL and (!frame!.sourceIsOperand or source!.pParent!==frame!.node))){
            request!.outcome <- worldUnsupported; request!.detail <- "Contextual expression source"; return()
        }
        if(!frame!.sourceIsOperand and !frame!.sourceIsListSpec and source!.looseMode and
           !source!.forceID and frame!.facts.overlay==LST and frame!.facts.hasValue and !frame!.facts.negative){
            frame!.lookup <- graph.correspondence(NULL, source, NULL, true, true)
            Allocate(frame!.lookup!.chart); frame!.lookup!.right!.checkExtents <- true
            request!.ready.append(frame); return()
        }
        // A top-only prefix relationship asks for a matched span, not the
        // normalized value of the entire source list (including its suffix).
        if(!frame!.sourceIsOperand and !frame!.sourceIsListSpec and
           source!.looseTop and !source!.looseMode and !source!.looseInhtd and !source!.forceID and
           frame!.facts.overlay==LST and frame!.facts.hasValue and !frame!.facts.negative){
            frame!.lookup <- graph.correspondence(NULL, source, NULL, true, true)
            frame!.lookup!.right!.checkExtents <- true
            if(graph.needsRequirements(frame)){graph.beginRequirements(frame)}
            request!.ready.append(frame); return()
        }
        our WorldPosition: position
        if(frame!.sourceIsOperand and graph.memberSequence(frame)){
            our WorldPosition: parent <- frame!.navigation
            if(parent==NULL){parent <- graph.position(frame!.node)}
            position <- graph.position(source, parent)
        }else if(source!.trueByDefinition){
            position <- graph.position(source)
            position!.owner <- frame!.node; position!.occurrence <- frame!.node
            if(frame!.navigation!=NULL){
                position!.parent <- frame!.navigation!.parent
                position!.owner <- frame!.navigation!.owner; position!.occurrence <- frame!.navigation!.occurrence
            }
        }
        if(position==NULL and !frame!.sourceIsListSpec){position <- frame!.navigation}
        if(request!.edits.containsKey(source!.pItem)){
            frame!.prerequisite <- request!.edits.at(source!.pItem); request!.ready.append(frame)
        }else if(request!.attempts.containsKey(source!.pItem) and
                 (!request!.attempts.at(source!.pItem)!.finished or !request!.attempts.at(source!.pItem)!.contextual or
                  graph.samePosition(request!.attempts.at(source!.pItem)!.navigation, position))){
            frame!.prerequisite <- request!.attempts.at(source!.pItem)
            if(!frame!.prerequisite!.finished){
                request!.outcome <- worldUnsupported
                request!.detail <- "Cyclic scalar prerequisites need the continuation stage"
                frame!.prerequisite <- NULL; return()
            }
            request!.ready.append(frame)
        }else{
            frame!.prerequisite <- makeFrame(request, source)
            frame!.prerequisite!.navigation <- position
            if(frame!.sourceIsListSpec){frame!.prerequisite!.expressionParent <- frame!.node}
            if(frame!.sourceIsOperand){frame!.prerequisite!.expressionParent <- frame!.node; frame!.prerequisite!.acquireOnly <- frame!.acquireOnly or (graph.memberSequence(frame) and source!.pItem!.value!.overlayType==LST and source!.pItem!.value!.evalMode==emLiteral); frame!.prerequisite!.predicateOnly <- frame!.predicateOnly}
            if(source!.trueByDefinition and frame!.facts.overlay==LST and frame!.facts.hasValue){
                frame!.prerequisite!.acquireOnly <- true; frame!.prerequisite!.predicateOnly <- true
            }
            request!.ready.append(frame)
            request!.ready.append(frame!.prerequisite)
        }
    }

    our WorldRequest: normalize(our WorldSession: session, our POV: target, me bool: requireSize <- false, me string: language <- "", our infonView: worldSource <- NULL, our IdentityRegistry: identities <- NULL) <- {
        me WorldModelLock: lock{control!.mutex}
        our WorldRequest:: request
        request!.control <- control; request!.vocabulary.init(language); request!.worldSource <- worldSource
        request!.identities <- identities; if(identities==NULL){request!.identities <- control!.identities}
        request!.target <- target; request!.requireSize <- requireSize
        if(session==NULL or session!.closed){
            request!.outcome <- worldError; request!.detail <- "An open Agent session is required"; return(request)
        }
        session!.requests.append(request)
        if(target==NULL or target!.pItem==NULL){
            request!.outcome <- worldError; request!.detail <- "Missing target POV"; return(request)
        }
        if(graph.satisfied(target, requireSize)){
            request!.outcome <- worldComplete; return(request)
        }
        our WorldPosition: context
        if(target!.pParent!=NULL){
            context <- graph.occurrencePath(target)
            if(context==NULL){request!.outcome <- worldUnsupported; request!.detail <- "Invalid or cyclic occurrence path"; return(request)}
        }
        request!.root <- makeFrame(request, target, context, requireSize)
        request!.ready.append(request!.root)
        run(request)
        return(request)
    }

    void: run(our WorldRequest: request) <- {
        while(request!.outcome==worldReady and !request!.ready.isEmpty()){
            our WorldFrame: frame <- request!.ready.popLast()
            step(request, frame)
            if(frame!.finished and frame!.navigation!=NULL and graph.completeFacts(frame!.facts, false)){
                if(request!.completedOccurrences.containsKey(frame!.node)){request!.completedOccurrences.at(frame!.node) <- frame}
                else{request!.completedOccurrences.insert(frame!.node, frame)}
            }
            if(frame!.finished and frame!.context!=NULL and request!.activeContexts.containsKey(frame!.node!.pItem) and
               request!.activeContexts.at(frame!.node!.pItem)===frame){request!.activeContexts.erase(frame!.node!.pItem)}
        }
        if(request!.outcome==worldReady){graph.finish(request)}
        if(request!.outcome!=worldWaiting){request!.releaseProgress()}
    }

    void: cancel(our WorldRequest: request) <- {request!.cancel()}
    void: closeSession(our WorldSession: session) <- {
        me WorldModelLock: lock{control!.mutex}
        if(session!.closed){return()}
        withEach request in session!.requests{cancel(request)}
        session!.requests.clear(); session!.closed <- true
    }
}
