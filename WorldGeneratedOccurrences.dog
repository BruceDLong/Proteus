// Generated occurrences have coordinates, not an immortal POV per state.
// These identity tokens are metadata owned by represented model sites. They
// never point back to the model, a session, or a production continuation.
struct WorldGeneratedAnchorIdentity {}
struct WorldGeneratedDeclarationIdentity {}
struct WordDefn {
    // Copies of a declaration retain its identity, without retaining the
    // declaration or its model through generated occurrence keys.
    our WorldGeneratedDeclarationIdentity: generatedDeclarationIdentity
}
struct WorldGeneratedBindingIdentity {
    our WorldGeneratedDeclarationIdentity: declaration
    our WorldGeneratedScopeKey: application
    me bool: canonical <- false
}
struct WorldGeneratedScopeKey {
    our WorldGeneratedAnchorIdentity: occurrence
    our WorldGeneratedBindingIdentity: parameters
    me bool: generated <- false
    me int64: ordinal <- 0
    our WorldGeneratedScopeKey: parent
}
struct WorldGeneratedScopePair {
    our WorldGeneratedScopeKey: left
    our WorldGeneratedScopeKey: right
}
struct WorldGeneratedScopeMatches {
    me Set<our WorldGeneratedScopeKey>: right
}
struct WorldGeneratedAddress {
    me int64: ordinal <- 0
    our WorldGeneratedScopeKey: ownerKey
    // A fixed member keeps its exact original structural occurrence even when
    // an embedded segment is viewed at the logical generated sequence level.
    our WorldGeneratedScopeKey: representedKey
}
struct WorldGeneratedWriteProof {
    their infonView: source
    our WorldDemandHeaderIdentity: identity
    me uint64: revision <- 0
    me bool: ready <- false
}
struct WorldGeneratedWriteScope {
    our WorldGeneratedScopeKey: ownerKey
    me Map<int64, our POV>: values
    me Map<int64, our WorldGeneratedWriteProof>: proofs
    me uint64: revision <- 0
}
struct WorldGeneratedAssertions {
    me List<our WorldGeneratedWriteScope>: scopes
    me uint64: writes <- 0
}
struct POV {
    our WorldGeneratedAddress: generatedAddress
    our WorldProductionEvidenceIdentity: generatedProductionIdentity
    // A transient generated value retains its qualified model parent, never
    // a navigation position which owns the value itself. Durable copies clear
    // this link because their canonical parent already owns the assertion.
    our WorldPosition: generatedParentContext
    our WorldGeneratedAnchorIdentity: generatedAnchorIdentity
    their POV: generatedAnchorOwner <- NULL
    our WorldGeneratedAssertions: generatedAssertions
}
struct WorldBindings {
    our WorldGeneratedBindingIdentity: generatedBindingIdentity
    me bool: productionSnapshot <- false
    me bool: productionScalarContext <- false
    our WorldBindings: productionParent
}
struct WorldArgumentBinding {
    // Live bindings expose the supplied header to dependency capture. Detached
    // production environments retain its checked scalar copy instead.
    our infonView: sourceDescription
    me bool: immutable <- false
    our infonView: productionSource
    our WorldBindings: productionCaller
}
struct WorldPosition {
    our WorldGeneratedAddress: generatedAddress
}
struct WorldGeneratedSeries {
    our WorldPosition: owner
    // Independent of value-cache policy: generated topology is always bounded.
    me int: recentLimit <- 8
    me int: recentSlot <- 0
    me List<int64>: recentOrder
    me Map<int64, our POV>: recent
    me Map<int64, our POV>: leased
    me uint64: created <- 0
    me uint64: evicted <- 0
    me uint64: peakRetained <- 0
    me int: retainedCount() <- {return(recent.size()+leased.size())}
}
struct WorldSession {
    // One entry per qualified source list, never one entry per generated state.
    me List<our WorldGeneratedSeries>: generatedSeries
}

struct WorldPOVGraph {
    me bool: hasGeneratedOwner(their POV: node) <- {
        me Set<their POV>: seen
        while(node!=NULL and !seen.contains(node)){
            if(node!.generatedAddress!=NULL){return(true)}
            seen.insert(node); node <- node!.pParent
        }
        return(false)
    }
    our WorldGeneratedAnchorIdentity: generatedAnchor(their POV: node) <- {
        if(node==NULL){return(NULL)}
        if(node!.generatedAnchorIdentity==NULL or node!.generatedAnchorOwner!==node){
            Allocate(node!.generatedAnchorIdentity); node!.generatedAnchorOwner <- node
        }
        return(node!.generatedAnchorIdentity)
    }
    our WorldGeneratedBindingIdentity: generatedBinding(our WorldBindings: bindings) <- {
        if(bindings==NULL){return(NULL)}
        if(bindings!.generatedBindingIdentity==NULL){Allocate(bindings!.generatedBindingIdentity)}
        return(bindings!.generatedBindingIdentity)
    }
    our WorldGeneratedDeclarationIdentity: generatedDeclaration(our WordDefn: definition) <- {
        if(definition==NULL){return(NULL)}
        if(definition!.generatedDeclarationIdentity==NULL){Allocate(definition!.generatedDeclarationIdentity)}
        return(definition!.generatedDeclarationIdentity)
    }
    void: identifyApplication(our WorldBindings: bindings, our infonView: item, our WorldPosition: caller) <- {
        our WorldGeneratedBindingIdentity: identity <- generatedBinding(bindings)
        identity!.declaration <- generatedDeclaration(bindings!.definition)
        // A relationship can apply a word to another destination. Until that
        // separate syntax site is represented, keep its binding identity local.
        // An ordinary application is qualified by its occurrence, not by its
        // argument values or the allocation of a transient binding object.
        if(caller!=NULL and (caller!.node!.pItem===item or
           (caller!.occurrence!=NULL and caller!.occurrence!.pItem===item))){
            identity!.application <- generatedScopeKey(caller)
            identity!.canonical <- identity!.application!=NULL
        }
    }
    me bool: sameGeneratedBinding(our WorldGeneratedBindingIdentity: left, our WorldGeneratedBindingIdentity: right) <- {
        if(left===right){return(true)}
        if(left==NULL or right==NULL or !left!.canonical or !right!.canonical or
           left!.declaration!==right!.declaration){return(false)}
        return(sameGeneratedScope(left!.application,right!.application))
    }
    me bool: sameBindings(our WorldBindings: left, our WorldBindings: right) <- {
        if(left===right){return(true)}
        return(sameGeneratedBinding(generatedBinding(left),generatedBinding(right)))
    }
    // Copy lexical scope, not caller occurrences. Supplied arguments stay lazy
    // until the ordinary parameter path asks for their checked scalar value.
    our WorldBindings: detachedProductionBindings(our WorldRequest: request, our WorldBindings: bindings,
                                                   our WorldProductionFrontier: frontier, me bool: canonical <- true, me bool: retained <- true) <- {
        if(bindings==NULL){return(NULL)}
        if(bindings!.productionSnapshot){return(bindings)}
        if(request!.productionBindingActive.contains(bindings)){
            request!.outcome <- worldUnsupported; request!.detail <- "Cyclic production argument scope"; return(NULL)
        }
        withEach copiedScope in request!.productionBindingCopies{
            if(copiedScope!.source===bindings and copiedScope!.frontier===frontier){return(copiedScope!.snapshot)}
        }
        our WorldGeneratedBindingIdentity: identity <- generatedBinding(bindings)
        if(canonical and !identity!.canonical){
            request!.outcome <- worldUnsupported; request!.detail <- "Generated parameter context needs an established application occurrence"; return(NULL)
        }
        request!.productionBindingActive.insert(bindings)
        our WorldBindings:: detached; detached!.generatedBindingIdentity <- identity; detached!.productionSnapshot <- true
        our WorldProductionBindingCopy:: copiedScope
        copiedScope!.source <- bindings;copiedScope!.snapshot <- detached;copiedScope!.frontier <- frontier
        request!.productionBindingCopies.append(copiedScope)
        if(retained){frontier!.parameterScopes.append(detached)}
        else{request!.productionArgumentScopes.insert(detached,frontier)}
        detached!.productionParent <- detachedProductionBindings(request,parameterScope(bindings!.caller),frontier,false,retained)
        withEach (name,argument) in bindings!.arguments{
            our WorldArgumentBinding:: copied
            copied!.omitted <- argument!.omitted; copied!.borrowed <- true; copied!.immutable <- true
            Allocate(copied!.expression,947); Allocate(copied!.expression!.pItem)
            copied!.expression!.pItem!.itmMode <- mItem; copied!.expression!.pItem!.streamState <- parseDone
            copied!.expression!.pItem!.viewMode <- vmAny
            copied!.expression!.pItem!.value!.evalMode <- emUnknown
            copied!.expression!.pItem!.infSize!.evalMode <- emUnknown
            if(!argument!.omitted){
                copied!.productionSource <- argument!.sourceDescription
                if(copied!.productionSource==NULL){copied!.productionSource <- argument!.expression!.pItem}
                copied!.productionCaller <- detachedProductionBindings(request,parameterScope(argument!.caller),frontier,false,retained)
            }
            detached!.arguments.insert(name,copied)
        }
        request!.productionBindingActive.erase(bindings)
        return(detached)
    }
    our WorldProductionFrontier: productionBindingFrontier(our WorldRequest: request, our WorldBindings: scope) <- {
        if(request!.productionSession==NULL){return(NULL)}
        me Set<our WorldBindings>: seen
        while(scope!=NULL and !seen.contains(scope)){
            seen.insert(scope)
            if(request!.productionArgumentScopes.containsKey(scope)){return(request!.productionArgumentScopes.at(scope))}
            if(scope!.productionSnapshot){
                withEach series in request!.productionSession!.generatedSeries{
                    if(series!.production==NULL){continue()}
                    withEach candidate in series!.production!.parameterScopes{if(candidate===scope){return(series!.production)}}
                }
                scope <- scope!.productionParent
            }else{scope <- parameterScope(scope!.caller)}
        }
        return(NULL)
    }
    our WorldProductionFrontier: productionFrameFrontier(our WorldRequest: request, our WorldFrame: frame) <- {
        our WorldProductionFrontier: frontier <- productionBindingFrontier(request,frame!.lexicalParameters)
        if(frontier!=NULL or request!.productionSession==NULL){return(frontier)}
        our WorldPosition: at <- frame!.navigation
        while(at!=NULL){
            if(at!.generatedAddress!=NULL and at!.parent!=NULL){
                withEach series in request!.productionSession!.generatedSeries{
                    if(series!.production!=NULL and samePosition(series!.owner,at!.parent)){return(series!.production)}
                }
            }
            at <- at!.parent
        }
        return(NULL)
    }
    our WorldBindings: scalarProductionScope(our WorldRequest: request, our WorldBindings: lexical, our WorldProductionFrontier: frontier) <- {
        if(lexical!=NULL and lexical!.productionScalarContext){return(lexical)}
        our WorldBindings:: scope
        if(lexical!=NULL){scope! <- lexical!}
        scope!.productionSnapshot <- true; scope!.productionScalarContext <- true
        request!.productionArgumentScopes.insert(scope,frontier)
        return(scope)
    }
    // Scalar arguments have lexical scope only. Their ordinary expression
    // evaluator must not silently acquire an object or external occurrence.
    me bool: productionScalarSource(our infonView: root) <- {
        me List<our infonView>: pending; pending.append(root); me Set<our infonView>: seen
        while(!pending.isEmpty()){
            our infonView: item <- pending.popLast()
            if(item==NULL or seen.contains(item)){continue()}
            seen.insert(item)
            if(item!.streamState==parseStarted or item!.streamState==parseListReady){continue()}
            if(item!.itmMode==mIncludeStream or item!.itmMode==mWordDefn or
               (item!.viewMode==vmCursor and item!.cursorMode!=cmParameter) or
               (item!.value!.overlayType==LST and item!.value!.evalMode==emLiteral) or
               item!.partRef!=NULL or !item!.parts.isEmpty() or item!.includeInfn!=NULL or
               item!.proxy!=NULL or item!.copySource!=NULL or item!.thisPtr!=NULL or
               item!.temporalValueSource!=NULL or item!.temporalPredecessor!=NULL or
               !item!.retainedPOVs.isEmpty() or !item!.sourceGraphDependencies.isEmpty()){return(false)}
            our POV: member <- item!.value!.items.head
            while(member!=NULL){pending.append(member!.pItem);member <- member!.next}
            member <- item!.infSize!.items.head
            while(member!=NULL){pending.append(member!.pItem);member <- member!.next}
            withEach relation in item!.wrkList{pending.append(relation!.pItem)}
            if(item!.innr!=NULL){pending.append(item!.innr)}
            if(item!.funcArgs!=NULL){pending.append(item!.funcArgs)}
            // Attached actuals are screened when their parameter is read.
        }
        return(true)
    }
    // This is a compact qualified identity, not a retained WorldPosition path.
    // A durable write can keep it without keeping the containing model alive.
    our WorldGeneratedScopeKey: generatedScopeKey(our WorldPosition: at) <- {
        me List<our WorldPosition>: pending
        me Set<our WorldPosition>: seen
        while(at!=NULL){
            if(seen.contains(at)){return(NULL)}
            seen.insert(at); pending.append(at); at <- at!.parent
        }
        our WorldGeneratedScopeKey: parent
        while(!pending.isEmpty()){
            our WorldPosition: source <- pending.popLast()
            our WorldGeneratedScopeKey:: key; key!.parent <- parent
            key!.parameters <- generatedBinding(source!.parameters)
            if(source!.generatedAddress!=NULL){
                key!.generated <- true; key!.ordinal <- source!.generatedAddress!.ordinal
            }else{key!.occurrence <- generatedAnchor(source!.occurrence)}
            parent <- key
        }
        return(parent)
    }
    me bool: sameGeneratedScope(our WorldGeneratedScopeKey: left, our WorldGeneratedScopeKey: right) <- {
        if(left===right){return(true)}
        me List<WorldGeneratedScopePair>: pending
        me Map<our WorldGeneratedScopeKey, our WorldGeneratedScopeMatches>: compared
        me WorldGeneratedScopePair: initial; initial.left <- left; initial.right <- right; pending.append(initial)
        // Nested application keys share ancestor subgraphs. Compare each pair
        // once for this operation, rather than recursively revisiting a common
        // caller for every enclosing binding. Nothing is retained afterwards.
        while(!pending.isEmpty()){
            me WorldGeneratedScopePair: comparison <- pending.popLast()
            left <- comparison.left; right <- comparison.right
            while(left!==right){
                if(left==NULL or right==NULL){return(false)}
                if(compared.containsKey(left) and compared.at(left)!.right.contains(right)){break()}
                if(left!.generated!=right!.generated or left!.ordinal!=right!.ordinal or
                   left!.occurrence!==right!.occurrence){return(false)}
                if(!compared.containsKey(left)){our WorldGeneratedScopeMatches:: matches; compared.insert(left,matches)}
                compared.at(left)!.right.insert(right)
                if(left!.parameters!==right!.parameters){
                    our WorldGeneratedBindingIdentity: leftBinding <- left!.parameters
                    our WorldGeneratedBindingIdentity: rightBinding <- right!.parameters
                    if(leftBinding==NULL or rightBinding==NULL or !leftBinding!.canonical or !rightBinding!.canonical or
                       leftBinding!.declaration!==rightBinding!.declaration){return(false)}
                    me WorldGeneratedScopePair: application
                    application.left <- leftBinding!.application; application.right <- rightBinding!.application
                    pending.append(application)
                }
                left <- left!.parent; right <- right!.parent
            }
        }
        return(true)
    }
    our WorldPosition: validateGeneratedPath(our WorldPosition: result) <- {
        our WorldPosition: at <- result
        while(at!=NULL){
            if(at!.generatedAddress!=NULL and
               !sameGeneratedScope(at!.generatedAddress!.ownerKey, generatedScopeKey(at!.parent))){return(NULL)}
            at <- at!.parent
        }
        return(result)
    }
    // samePosition still compares enclosing positions and binding scope. A
    // generated coordinate has the same identity in different sessions.
    me bool: sameGeneratedOccurrence(our WorldPosition: left, our WorldPosition: right) <- {
        if(left!.generatedAddress==NULL or right!.generatedAddress==NULL){
            // A detached checked view of an already represented member keeps
            // that original occurrence, including when reached by production.
            return(left!.occurrence===right!.occurrence)
        }
        return(left!.generatedAddress!.ordinal==right!.generatedAddress!.ordinal)
    }
    our WorldGeneratedWriteScope: generatedWriteScope(their POV: owner, our WorldGeneratedScopeKey: key, me bool: create <- false) <- {
        if(owner==NULL or key==NULL){return(NULL)}
        if(owner!.generatedAssertions==NULL){
            if(!create){return(NULL)}
            Allocate(owner!.generatedAssertions)
        }
        withEach scope in owner!.generatedAssertions!.scopes{
            if(sameGeneratedScope(scope!.ownerKey, key)){return(scope)}
        }
        if(!create){return(NULL)}
        our WorldGeneratedWriteScope:: scope; scope!.ownerKey <- key
        owner!.generatedAssertions!.scopes.append(scope); return(scope)
    }
    our POV: generatedWrittenValue(our WorldPosition: owner, me int64: ordinal) <- {
        if(owner==NULL){return(NULL)}
        our WorldGeneratedWriteScope: scope <- generatedWriteScope(owner!.occurrence, generatedScopeKey(owner))
        if(scope==NULL or !scope!.values.containsKey(ordinal)){return(NULL)}
        return(scope!.values.at(ordinal))
    }
    me uint64: generatedWriteRevision(our WorldPosition: owner) <- {
        if(owner==NULL){return(0)}
        our WorldGeneratedWriteScope: scope <- generatedWriteScope(owner!.occurrence, generatedScopeKey(owner))
        if(scope==NULL){return(0)}
        return(scope!.revision)
    }
    me uint64: generatedContextRevision(our WorldPosition: at) <- {
        while(at!=NULL){
            if(at!.generatedAddress!=NULL){return(generatedWriteRevision(at!.parent))}
            at <- at!.parent
        }
        return(0)
    }
    // Publication has already validated this assertion. The sparse write map
    // owns only explicitly written states; the state's parent pointer is raw.
    void: preserveGeneratedValue(their POV: node) <- {
        if(node==NULL or node!.generatedAddress==NULL or node!.pParent==NULL){return()}
        our WorldGeneratedWriteScope: scope <- generatedWriteScope(node!.pParent, node!.generatedAddress!.ownerKey, true)
        if(scope==NULL){return()}
        me int64: ordinal <- node!.generatedAddress!.ordinal
        me bool: ready <- node!.cursorValue!=NULL and node!.cursorValue!.ready
        if(scope!.proofs.containsKey(ordinal)){
            our WorldGeneratedWriteProof: previous <- scope!.proofs.at(ordinal)
            if(previous!.source===node!.pItem and previous!.identity===demandHeaderIdentity(node!.pItem) and
               previous!.revision==node!.pItem!.cursorRevision and previous!.ready==ready){return()}
        }
        // A descendant publication reaches its ancestor through a raw parent.
        // Store a shallow occurrence wrapper rather than manufacturing shared
        // ownership from that pointer. Values remain shared and coordinates
        // retain identity; subsequent writes replace this sparse assertion.
        our POV:: written{951}; written! <- node!
        written!.next <- NULL; written!.prev <- NULL; written!.worldContext <- NULL
        written!.generatedParentContext <- NULL
        Allocate(written!.pItem); copyDescription(written,node!.pItem,true)
        written!.cursorValue <- NULL
        if(node!.cursorValue!=NULL){
            Allocate(written!.cursorValue)
            written!.cursorValue!.owner <- written; written!.cursorValue!.value <- written!.pItem
            written!.cursorValue!.revision <- written!.pItem!.cursorRevision
            written!.cursorValue!.outcome <- node!.cursorValue!.outcome
            written!.cursorValue!.ready <- node!.cursorValue!.ready
            written!.cursorValue!.permanent <- true
        }
        if(scope!.values.containsKey(ordinal)){scope!.values.at(ordinal) <- written}
        else{scope!.values.insert(ordinal, written); node!.pParent!.generatedAssertions!.writes <+- 1}
        our WorldGeneratedWriteProof:: proof
        proof!.source <- node!.pItem; proof!.identity <- demandHeaderIdentity(node!.pItem)
        proof!.revision <- node!.pItem!.cursorRevision; proof!.ready <- ready
        if(scope!.proofs.containsKey(ordinal)){scope!.proofs.at(ordinal) <- proof}else{scope!.proofs.insert(ordinal,proof)}
        scope!.revision <+- 1
    }
    void: preserveGeneratedAncestors(our POV: target) <- {
        // Deferred publication may attach a source snapshot whose owner is
        // this destination. Once the write is validated, owned descendants
        // use their raw parent route and the generated root's qualified parent
        // instead of keeping that self-owning snapshot navigation.
        their POV: at <- target
        me List<their POV>: ownedPath
        me Set<their POV>: inspected
        while(at!=NULL and !inspected.contains(at)){
            inspected.insert(at); ownedPath.append(at)
            if(at!.generatedAddress!=NULL){
                withEach member in ownedPath{member!.worldContext <- NULL}
                break()
            }
            at <- at!.pParent
        }
        at <- target
        me Set<their POV>: seen
        while(at!=NULL and !seen.contains(at)){
            seen.insert(at); preserveGeneratedValue(at); at <- at!.pParent
        }
    }
    // Private candidates are not inserted in a session cache until checked.
    // No neighbour pointer owns an earlier or later generated occurrence.
    our WorldPosition: newGeneratedPosition(our WorldPosition: list, me int64: ordinal, our infonView: recipe) <- {
        if(list==NULL or recipe==NULL or ordinal<1){return(NULL)}
        our POV:: node{951}; node!.pItem <- recipe; node!.pParent <- list!.occurrence
        node!.generatedParentContext <- list
        Allocate(node!.generatedAddress); node!.generatedAddress!.ordinal <- ordinal
        node!.generatedAddress!.ownerKey <- generatedScopeKey(list)
        our WorldPosition: result <- position(node, list)
        result!.generatedAddress <- node!.generatedAddress; return(result)
    }
}

struct WorldManager {
    our WorldGeneratedSeries: generatedSeries(their WorldSession: session, our WorldPosition: list) <- {
        if(session==NULL or session!.closed or list==NULL){return(NULL)}
        withEach series in session!.generatedSeries{
            if(graph.samePosition(series!.owner, list)){return(series)}
        }
        our WorldGeneratedSeries:: series; series!.owner <- list
        session!.generatedSeries.append(series); return(series)
    }
    // Expired ring entries remain indexed only while an actual cursor/checkpoint
    // lease uses their value. A later access removes released leases.
    void: trimGeneratedLeases(our WorldGeneratedSeries: series) <- {
        me List<int64>: expired
        withEach node in series!.leased{
            if(node!.cursorValue!=NULL and node!.cursorValue!.permanent){expired.append(node!.generatedAddress!.ordinal)}
            else if(node!.cursorValue==NULL or !node!.cursorValue!.inUse()){expired.append(node!.generatedAddress!.ordinal)}
        }
        withEach ordinal in expired{series!.leased.erase(ordinal); series!.evicted <+- 1}
    }
    void: rememberGeneratedPosition(their WorldSession: session, our WorldPosition: at) <- {
        if(at==NULL or at!.generatedAddress==NULL or at!.parent==NULL){return()}
        our WorldGeneratedSeries: series <- generatedSeries(session, at!.parent)
        if(series==NULL){return()}
        trimGeneratedLeases(series)
        me int64: ordinal <- at!.generatedAddress!.ordinal
        // Explicit publication already owns durable assertions. Retaining a read
        // must never rewrite one or invalidate the production frontier.
        if(at!.node!.cursorValue!=NULL and at!.node!.cursorValue!.permanent){return()}
        if(series!.recent.containsKey(ordinal)){series!.recent.at(ordinal) <- at!.node; return()}
        if(series!.leased.containsKey(ordinal)){series!.leased.at(ordinal) <- at!.node; return()}
        if(series!.recentLimit<=0){return()}
        if(series!.recentOrder.size()<series!.recentLimit){series!.recentOrder.append(ordinal)}
        else{
            me int64: old <- series!.recentOrder[series!.recentSlot]
            our POV: node <- series!.recent.at(old); series!.recent.erase(old)
            if(node!.cursorValue!=NULL and node!.cursorValue!.permanent){series!.evicted <+- 1}
            else if(node!.cursorValue!=NULL and node!.cursorValue!.inUse()){series!.leased.insert(old, node)}
            else{series!.evicted <+- 1}
            series!.recentOrder[series!.recentSlot] <- ordinal
            series!.recentSlot <+- 1; if(series!.recentSlot==series!.recentLimit){series!.recentSlot <- 0}
        }
        series!.recent.insert(ordinal, at!.node)
        if(series!.retainedCount()>series!.peakRetained){series!.peakRetained <- series!.retainedCount()}
    }
    me int: clearGeneratedCache(their WorldSession: session, our WorldPosition: list) <- {
        if(session==NULL or session!.closed or list==NULL){return(0)}
        me WorldModelLock: lock{control!.mutex}
        me int: cleared <- 0
        withEach series in session!.generatedSeries{
            if(!graph.samePosition(series!.owner, list)){continue()}
            me int: before <- series!.retainedCount()
            trimGeneratedLeases(series)
            me List<int64>: kept
            withEach ordinal in series!.recentOrder{
                our POV: node <- series!.recent.at(ordinal)
                if(node!.cursorValue!=NULL and node!.cursorValue!.inUse()){kept.append(ordinal); continue()}
                series!.recent.erase(ordinal); series!.evicted <+- 1
            }
            series!.recentOrder <- kept; series!.recentSlot <- 0
            cleared <+- before-series!.retainedCount()
        }
        return(cleared)
    }
}
