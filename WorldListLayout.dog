// A layout proof establishes occurrence positions and temporal context, not
// member values or validity of the containing definition. The exact template
// obligations remain available to ordinary acquisition and publication.
struct WorldTemplateLayout {
    our infonView: source
    our WorldPosition: scope
    our WorldPosition: position
    me Set<our infonView>: visited
    me WorldOutcome: outcome <- worldReady
    me bool: finished <- false
}
struct WorldListLayout {
    our WorldPosition: position
    me WorldScalar: header
    me WorldOutcome: outcome <- worldReady
    me string: detail
    our infonView: waiting
    me bool: finished <- false
    // An unread or dynamic meaning cannot authorize physical coordinates.
    // A completed ordinary-literal chain can explicitly retain the older
    // correspondence path without claiming template projection was proved.
    me bool: layoutRequired <- true
    me bool: templateLayoutRequired <- false
    me bool: ordinaryLayout <- false
    // A bare application can obtain its structure from its declaration. This
    // remains a borrowed source; the application occurrence owns any result.
    me bool: definitionOwnsLayout <- false
    our WorldPosition: ownedSource
    our WorldTemplateLayout: templateShape
    our WorldPosition: source
    our POV: edge
    me Set<our infonView>: visited
    me List<our POV>: templates
}
struct WorldRequest {
    me Map<our POV, our WorldListLayout>: listLayouts
    me uint64: listLayoutHeaders <- 0
    me uint64: listLayoutHits <- 0
}
struct WorldFrame {
    me bool: layoutPrepared <- false
    me int64: parentLayoutTemplate <- 0
}

struct WorldPOVGraph {
    // Positive structural evidence for one repeated occurrence. In particular,
    // an unrecognized unit is not evidence that regrouping is unnecessary.
    // Record interiors and scalar values are not acquired by this proof.
    me WorldOutcome: oneOccurrenceTemplate(our WorldRequest: request, our POV: spec,
                                           our WorldPosition: context, our WorldListLayout: proof) <- {
        our WorldTemplateLayout: shape <- proof!.templateShape
        if(shape==NULL or shape!.source!==spec!.pItem or shape!.scope!==context){
            Allocate(shape); shape!.source <- spec!.pItem; shape!.scope <- context
            shape!.position <- position(spec, context); proof!.templateShape <- shape
        }
        if(shape!.finished){return(shape!.outcome)}
        while(shape!.position!=NULL){
            our WorldPosition: at <- shape!.position
            our infonView: item <- at!.node!.pItem
            if(item==NULL or item!.value==NULL or item!.infSize==NULL){shape!.outcome <- worldError; break()}
            if(item!.graphParseError!=""){proof!.detail <- item!.graphParseError; shape!.outcome <- worldError; break()}
            if(item!.streamState==parseStarted or item!.streamState==parseListReady){proof!.waiting <- item; return(worldWaiting)}
            if(shape!.visited.contains(item)){shape!.outcome <- worldUnsupported; break()}
            shape!.visited.insert(item); request!.listLayoutHeaders <+- 1
            // These roots can supply another shape. An unexamined refinement
            // or qualification is not evidence of one occurrence.
            if(item!.innr!=NULL or item!.partRef!=NULL or !item!.parts.isEmpty() or item!.proxy!=NULL or
               item!.argPos!=apNoArgs or item!.funcArgs!=NULL or item!.invertMatch or
               !item!.wrkList.isEmpty() or !item!.addedTypes.isEmpty() or item!.value!.undefined or
               (item!.itmMode!=mItem and item!.itmMode!=mNone)){
                shape!.outcome <- worldUnsupported; break()
            }
            if(item!.viewMode==vmCursor){
                if(item!.cursorMode!=cmParameter or item!.type!=NULL or item!.wordArguments!=NULL){shape!.outcome <- worldUnsupported; break()}
                our WorldBindings: bindings <- parameterScope(at)
                if(bindings==NULL or !bindings!.arguments.containsKey(item!.parameterName)){shape!.outcome <- worldUnsupported; break()}
                our WorldArgumentBinding: argument <- bindings!.arguments.at(item!.parameterName)
                // An omitted argument has no established structural kind.
                if(argument!.omitted or argument!.expression==NULL){shape!.outcome <- worldUnsupported; break()}
                shape!.position <- position(argument!.expression, argument!.caller); continue()
            }
            me WorldScalar: binding; binding <- bind(request, binding, item!.type)
            if(binding.outcome!=worldReady){shape!.outcome <- binding.outcome; break()}
            if(binding.nominal!=NULL and binding.nominal!.defToUse!=NULL and
               (binding.nominal!.defToUse!.streamState==parseStarted or binding.nominal!.defToUse!.streamState==parseListReady)){
                // Resume this nominal classification after parsing, rather
                // than mistaking the eventual definition body for anonymous
                // shape evidence and bypassing its coordinate semantics.
                shape!.visited.erase(item); proof!.waiting <- binding.nominal!.defToUse
                return(worldWaiting)
            }
            // A named unit specifies coordinates as well as scalar shape.
            // Even a width-one base may be supplied in larger stored groups;
            // only the unit correspondence provider can prove that mapping.
            me Set<our infonView>: unitsSeen
            if(unitMeasure(request, binding.nominal, unitsSeen)!=NULL){shape!.outcome <- worldUnsupported; break()}
            me string: argumentError <- checkArguments(item, binding.nominal)
            if(argumentError!=""){
                proof!.detail <- argumentError; shape!.outcome <- worldRejected
                if(binding.nominal==NULL or binding.nominal!.baseDefinition==NULL){shape!.outcome <- worldUnsupported}
                break()
            }
            if(item!.value!.evalMode==emConcat){
                if(!scalarExpression(item!.value)){shape!.outcome <- worldUnsupported; break()}
                our POV: operand <- item!.value!.items.head
                if(operand==NULL or operand!.isSubItm){shape!.outcome <- worldUnsupported; break()}
                if(operand!.next==NULL){
                    // Both a wrapper meaning and its operand would need shape
                    // proofs. Leave that composition to general correspondence.
                    if(binding.nominal!=NULL and binding.nominal!.defToUse!=NULL){shape!.outcome <- worldUnsupported; break()}
                    shape!.position <- position(operand, at); continue()
                }
                // A literal scalar fixes concatenation's scalar kind. Dynamic
                // operands still receive their ordinary value constraints.
                me bool: scalar <- false
                while(operand!=NULL){
                    if(operand!.isSubItm){shape!.outcome <- worldUnsupported; break()}
                    if(operand!.pItem!.value!.evalMode==emLiteral and
                       (operand!.pItem!.value!.overlayType==NUM or operand!.pItem!.value!.overlayType==STR)){scalar <- true}
                    operand <- operand!.next
                }
                if(shape!.outcome!=worldReady){break()}
                if(!scalar){shape!.outcome <- worldUnsupported; break()}
            }else{
                if(item!.value!.evalMode!=emLiteral and item!.value!.evalMode!=emUnknown){shape!.outcome <- worldUnsupported; break()}
                if(item!.value!.overlayType==LST){
                    if(item!.orderMode!=uUnordered or item!.value!.listSpec!=NULL or !stableRecordLayout(request, item)){
                        shape!.outcome <- worldUnsupported; break()
                    }
                }else if(item!.value!.overlayType!=NUM and item!.value!.overlayType!=STR and
                         !((item!.value!.overlayType==tUnknown or item!.value!.overlayType==tUnset) and item!.value!.evalMode==emUnknown)){
                    shape!.outcome <- worldUnsupported; break()
                }
            }
            if(binding.nominal==NULL or binding.nominal!.defToUse==NULL){shape!.position <- NULL; break()}
            our POV:: meaning{939}; meaning!.pItem <- binding.nominal!.defToUse; meaning!.trueByDefinition <- true
            meaning!.definitionParameters <- bindArguments(request, binding.nominal, item, at)
            if(request!.outcome!=worldReady){shape!.outcome <- request!.outcome; break()}
            // Each named application establishes its own lexical boundary;
            // actual arguments are inspected in the caller's saved scope.
            shape!.position <- position(meaning, at)
            shape!.position!.parameters <- meaning!.definitionParameters
            shape!.position!.writable <- false
        }
        shape!.finished <- true
        return(shape!.outcome)
    }

    our WorldListLayout: listLayout(our WorldRequest: request, our WorldPosition: at) <- {
        our WorldListLayout: proof
        if(request!.listLayouts.containsKey(at!.owner)){
            proof <- request!.listLayouts.at(at!.owner)
            if(!sameProofPosition(proof!.position, at)){proof <- NULL}
        }
        if(proof==NULL){
            Allocate(proof); proof!.position <- at; proof!.source <- at
            proof!.header <- read(request, at!.node, at!.node!.pParent, at!.input!=NULL)
            our infonView: applied <- at!.node!.pItem
            proof!.definitionOwnsLayout <- !proof!.header.hasValue and !proof!.header.hasSize and
                applied!.value!.evalMode==emUnknown and applied!.wrkList.isEmpty() and
                applied!.innr==NULL and applied!.partRef==NULL and applied!.parts.isEmpty() and
                applied!.funcArgs==NULL and applied!.argPos==apNoArgs and applied!.proxy==NULL and !applied!.invertMatch
            if(request!.listLayouts.containsKey(at!.owner)){request!.listLayouts.at(at!.owner) <- proof}
            else{request!.listLayouts.insert(at!.owner, proof)}
        }else{request!.listLayoutHits <+- 1}
        if(proof!.finished){return(proof)}
        proof!.outcome <- worldReady; proof!.waiting <- NULL
        while(proof!.source!=NULL){
            our POV: source <- proof!.source!.node
            if(proof!.edge!=NULL and source!.pItem!.value!=NULL and
               (source!.pItem!.value!.timelike or source!.pItem!.value!.listSpec!=NULL)){proof!.templateLayoutRequired <- true}
            me WorldScalar: header <- read(request, source, source!.pParent, proof!.source!.input!=NULL)
            request!.listLayoutHeaders <+- 1
            if(header.outcome!=worldReady){
                proof!.outcome <- header.outcome; proof!.detail <- header.detail
                if(header.outcome==worldWaiting){proof!.waiting <- source!.pItem}
                return(proof)
            }
            if(proof!.edge==NULL){proof!.header <- header}
            else{
                our infonView: body <- source!.pItem
                if(!body!.wrkList.isEmpty() or body!.argPos!=apNoArgs or body!.funcArgs!=NULL or
                   body!.innr!=NULL or body!.partRef!=NULL or !body!.parts.isEmpty() or body!.proxy!=NULL or header.negative){
                    proof!.outcome <- worldUnsupported; proof!.detail <- "Named list layout needs general template correspondence"; proof!.finished <- true; return(proof)
                }
                if(proof!.definitionOwnsLayout and header.hasValue and header.overlay==LST and
                   header.timelike and header.order!=uUnordered and body!.value!.evalMode==emLiteral){
                    proof!.ownedSource <- proof!.source; proof!.header <- header
                    proof!.finished <- true; return(proof)
                }
                // A closed ordinary literal retains the established field or
                // positional correspondence path. Inspect the rest of its
                // declaration chain before concluding that T or grouping is
                // absent; an alias alone proves neither.
                me bool: ordinary <- header.overlay==LST and header.hasValue and body!.value!.evalMode==emLiteral and
                    !header.timelike and !header.openTail and body!.value!.listSpec==NULL
                if(ordinary){proof!.ordinaryLayout <- true}
                else if(header.hasValue and (header.overlay!=LST or header.order==uUnordered or
                        !header.openTail or header.hasSize or body!.value!.items.head!=NULL)){
                    proof!.outcome <- worldUnsupported; proof!.detail <- "Named list layout needs general template correspondence"; proof!.finished <- true; return(proof)
                }
                // A pure open repetition imposes one constraint per existing
                // member. It contributes no prefix, boundary or new occurrence.
                if(!ordinary and header.overlay==LST and header.hasValue){
                    if(proof!.header.order==uUnordered){
                        proof!.outcome <- worldUnsupported; proof!.detail <- "Ordered named template needs unordered member correspondence"
                        proof!.finished <- true; return(proof)
                    }
                    if(body!.value!.listSpec!=NULL){
                        our POV:: spec{939}; spec!.pItem <- body!.value!.listSpec
                        me WorldOutcome: shape <- oneOccurrenceTemplate(request, spec, proof!.source, proof)
                        if(shape!=worldReady){
                            proof!.outcome <- shape; proof!.detail <- "Named list template needs an occurrence-width proof"
                            if(shape!=worldWaiting){proof!.finished <- true}
                            return(proof)
                        }
                        spec!.definitionParameters <- proof!.source!.parameters
                        proof!.templates.append(spec)
                    }
                    proof!.header.timelike <- proof!.header.timelike or header.timelike
                    if(proof!.header.order==uUnknown){proof!.header.order <- header.order}
                }
            }
            if(header.meaningApplied or header.nominal==NULL or header.nominal!.defToUse==NULL or
               header.nominal!.defToUse===source!.pItem){proof!.source <- NULL; break()}
            our infonView: meaning <- header.nominal!.defToUse
            if(proof!.visited.contains(meaning)){
                proof!.outcome <- worldUnsupported; proof!.detail <- "Cyclic named list layout"; proof!.finished <- true; return(proof)
            }
            proof!.visited.insert(meaning)
            our POV:: edge{939}; edge!.pItem <- meaning; edge!.trueByDefinition <- true
            edge!.definitionParameters <- bindArguments(request, header.nominal, source!.pItem, proof!.source)
            if(request!.outcome!=worldReady){
                proof!.outcome <- request!.outcome; proof!.detail <- request!.detail
                proof!.finished <- proof!.outcome!=worldWaiting; return(proof)
            }
            our WorldPosition: next <- representedPosition(edge, proof!.source)
            next!.parameters <- edge!.definitionParameters; next!.writable <- false
            proof!.edge <- edge; proof!.source <- next
        }
        if(proof!.ordinaryLayout){
            proof!.outcome <- worldUnsupported
            proof!.detail <- "Ordinary named layout retains its existing correspondence path"
            proof!.layoutRequired <- proof!.templateLayoutRequired
        }
        proof!.finished <- true; return(proof)
    }
}
