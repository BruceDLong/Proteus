import os

env = Environment(ENV=os.environ)
env.MergeFlags('-g -std=gnu++17 -fpermissive  -fdiagnostics-color=always')
env.Decider("timestamp-newer")
env["CPPPATH"]=[
]
env["LIBPATH"]=[
     r"/home/bruce/devl/CodeDog",
]
env["LIBS"] = ["gmp", "gmpxx"]
env.MergeFlags("-pthread")
env.ParseConfig("pkg-config --libs --cflags icu-uc icu-io")
env.MergeFlags("-pthread")
env.Program(
    target="trace-probe",
    source=[r"trace-probe.cpp"],
    )

