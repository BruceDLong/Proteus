digraph G {
graph [rankdir=LR, bgcolor="transparent", pad="0.25", nodesep="0.6", ranksep="0.8", fontname="DejaVu Sans"];
node [shape=box, style="rounded,filled", fillcolor="#f4f7fb", color="#c8d3e3", fontname="DejaVu Sans", fontsize=12, margin="0.16,0.12"];
edge [fontname="DejaVu Sans", fontsize=10, color="#247387", fontcolor="#17586a", arrowsize=0.8];
N1 [label="N1 / I1 · intersection\nsize unknown · [? *10+7]"];
N2 [label="N2 / I3 · ?\nsize, value and overlay unknown"];
N3 [label="N3 / I4 · last member\nsize 10 · value 7"];
N1 -> N2 [label="list position ×3"];
N2 -> N3 [label="list position ×2"];
N3 -> N1 [label="list boundary ×2"];
N1 -> N3 [label="intersection result position ×2"];
N3 -> N3 [label="selected intersection member ×2"];
N1 -> N3 [label="registry identity ×3", color="#a46120", fontcolor="#8f4d10"];
N3 -> N1 [label="registry identity ×1", color="#a46120", fontcolor="#8f4d10"];
}