
// Infon List
struct GLOBAL{
    const int: povSrcSparseSpanRemainder <- 601
    const int: povSrcSparseExposedHead   <- 602
    const int: povSrcConcreteSpanPrefix  <- 603
    const int: povSrcConcreteSpanRemainder <- 604
    const int: povSrcListSpecSparseTail  <- 605
    const int: povSrcEndRelativeReference <- 606
    const int: povSrcImplicitItem        <- 607
    const int: povSrcEndRelativeView     <- 608
    const int: povSrcTemporalBoundary    <- 609
}

struct POVPedigree{
    me int: source
}
struct ViewMap{
    // NULL means this POV is not derived as a view/span of another POV.
    // Otherwise, this POV defines the traversal context and stopping boundary.
    our POV: sourcePov
    // The source item corresponding to local item 0 in the derived view/span.
    our POV: startPov
}
struct ImplicitItemMap{
    // Non-owning because the repetition family retains the canonical
    // occurrence POV while the source span supplies its current local mapping.
    their POV: sourcePov
    // Zero-based position in sourcePov's logical item sequence.
    me int64: sourceIndex
}
struct RepetitionSpanMap{
    // All split spans retain one logical repetition family.  startOrdinal maps
    // local sparse indexes into that family's stable coordinate space.
    our RepetitionFamily: family
    me int64: startOrdinal
}
struct TemporalBoundaryViewMap{
    // The ordered T-list view containing this cut.  Keep this non-owning like
    // pParent; selected temporary sources are retained by the boundary value.
    their POV: sourcePov
    // End remains meaningful before its exact coordinate is known.
    flag: tracksEnd
    flag: cutIndexKnown
    // Zero-based half-open boundary coordinate: 0 is begin, extent is end.
    me int64: cutIndex
}
model POV{ // Point-Of-View
    our infonView: pItem   // The POV item
    our POV: next
    our POV: prev
    our POV: altPOV     // NEXT OR
    our POV: outerPOV   // POV outside of an alt
    their POV: pParent
    mode[aCopyOf, aRefTo]: accessMode
    flag: forceID
    flag: looseMode
    flag: looseTop      // Top LHS/RHS pair is looseMode
    flag: looseInhtd    // Parent was looseMode
    flag: wasRejected
    flag: tentFromDots
    flag: isFromALT
    flag: readyToResolve
    flag: trueByDefinition // If true by definition there are no contradictions in type.
    flag: addNewSubDots
    flag: keepDots
    flag: listClosed
    flag: hasPropagated
    flag: isSubItm
    me int: AlternativesNestLvl
    me List<our POV>: predecessors
    me POVPedigree: pedigree
    // When this POV is stored in an infonView wrkList, distinguish matching
    // machinery owned by a selector from a constraint owned by the expression
    // consuming the selected result. An ordinary work POV is consumer work.
    flag: selectorLocalWork
    // infonView remains locally zero-based; origins and traversal boundaries
    // for derived views/spans are represented by POV navigation.
    me ViewMap: viewMap
    // Provenance is present on every local view. Only final result selection
    // grants a mapped POV authority to write through that provenance.
    flag: viewMapWriteEnabled
    // Set only when this ordinary POV represents a logical source item that
    // has not been expanded into the physical POV list.
    me ImplicitItemMap: implicitItem
    // Non-owning access to the semantic universe that owns identities for this
    // POV.  Agent owns the registry; repetition records retain their POVs.
    their IdentityRegistry: identityRegistry
    me RepetitionSpanMap: repetitionSpan
    // Present on both a virtual repetition reference and its concrete
    // materialization, allowing either side to recover the same occurrence.
    their RepetitionOccurrence: repetitionOccurrence
    // A boundary is an identity-bearing view of a cut in one T-list.  Its
    // pItem is only the algebraic null value and must not define its identity.
    me TemporalBoundaryViewMap: temporalBoundary
    me List<our POV>: candidatesForLastItem
    flag: endRelativeReference
    flag: endRelativeResolved
    me int64: endRelativeOffset
    flag: forLastUseLastItem
    flag: forLastUseOutrPov
    flag: isOutrFeed
    our POV: markedOuterPOV
    me int: linearAltID
    // Incremented whenever this work POV gains information while a merge may
    // still be evaluating an earlier revision.
    me uint64: workRevision
    flag: rejected         // At least one item on the worklist was rejected.
    flag: doNotEnter       // Use for single level normalizing
    flag: propagateInMrg2  // For when propagation won't happen in merge 1

    our infonView: dpItem() <- {
        our infonView: retVal <- NULL
        our infonView: crntProxy <- pItem
        while(crntProxy!=NULL){
            retVal <- crntProxy
            if(retVal===crntProxy!.proxy){return(retVal)} // TODO: Can we just avoid setting proxy to itself?
            crntProxy <- crntProxy!.proxy
        }
        return(retVal)
    }
    me bool: isFirst() <- {return(prev==NULL)}
    me bool: isLast()  <- {return(next==NULL)}
    me bool: looseSize() <- {return(looseInhtd or looseTop)}
    me bool: looseType() <- {return(looseMode or looseTop or looseInhtd)}
    void: mapViewToSource(our POV: sourceContextPOV,
            our POV: sourceStartPOV) <- {
        if(sourceContextPOV==NULL or sourceStartPOV==NULL){return()}
        viewMap.sourcePov <- sourceContextPOV
        viewMap.startPov <- sourceStartPOV
        accessMode <- aRefTo
    }
    // Traversal seeds inherited list-spec work on the source item before an
    // ordered-span replacement can be built. The replacement materializes
    // that type shape, so consume only the represented seed; persistent source
    // constraints remain in place.
    void: consumeSeededListSpecWorkForLocalCopy() <- {
        if(pItem==NULL){return()}
        me List<our POV>: retainedSourceWork
        me bool: consumedSeededWork <- false
        withEach sourceWorkPOV in pItem!.wrkList{
            if(sourceWorkPOV!=NULL and sourceWorkPOV!.pItem!=NULL and
                    sourceWorkPOV!.pItem!.copySourceType==cstListSpec){
                consumedSeededWork <- true
            }else{
                retainedSourceWork.append(sourceWorkPOV)
            }
        }
        if(consumedSeededWork){
            pItem!.wrkList <- retainedSourceWork
            pItem!.pruneDeferredWrkList()
        }
    }
    // Map a recursively copied local item to the source item with the same
    // shape. Structural parent links remain local; ViewMap carries source
    // provenance for the copied root and every corresponding descendant.
    void: mapLocalCopyTreeToSource(our POV: sourceContextPOV,
            our POV: sourceStartPOV) <- {
        if(sourceContextPOV==NULL or sourceStartPOV==NULL or
                pItem==NULL or sourceStartPOV!.pItem==NULL){return()}
        mapViewToSource(sourceContextPOV, sourceStartPOV)
        sourceStartPOV!.consumeSeededListSpecWorkForLocalCopy()
        if(pItem!.value!.overlayType!=LST or
                sourceStartPOV!.pItem!.value!.overlayType!=LST){return()}
        our POV: localChild <- pItem!.value!.items.head
        our POV: sourceChild <- sourceStartPOV!.pItem!.value!.items.head
        while(localChild!=NULL and sourceChild!=NULL){
            localChild!.pParent <- self
            localChild!.mapLocalCopyTreeToSource(
                    sourceContextPOV, sourceChild)
            localChild <- localChild!.next
            sourceChild <- sourceChild!.next
        }
    }
    // Follow only ViewMap relationships. Legacy outer identity remains a
    // separate fallback at the write site.
    our POV: ultimateMappedSourcePOV() <- {
        our POV: immediateSourcePOV <- viewMap.startPov
        if(immediateSourcePOV==NULL){return(NULL)}
        if(immediateSourcePOV===self){return(immediateSourcePOV)}
        our POV: ultimateSourcePOV <-
                immediateSourcePOV!.ultimateMappedSourcePOV()
        if(ultimateSourcePOV!=NULL){return(ultimateSourcePOV)}
        return(immediateSourcePOV)
    }
    void: noteMarkedOuterFrom(our POV: transparentPOV) <- {
        if(markedOuterPOV!=NULL or transparentPOV==NULL){return()}
        // Tight traversal treats &{...} as transparent and returns an inner POV.
        // When the skipped transparent POV was marked with <...>, keep that origin
        // on the returned inner POV so Propagate can map its LHS match to the RHS source.
        if(transparentPOV!.markedOuterPOV!=NULL){markedOuterPOV <- transparentPOV!.markedOuterPOV}
        else if(transparentPOV!.pParent!=NULL and transparentPOV!.pParent!.pItem!.intersectMarkedRetPOV===transparentPOV){
            markedOuterPOV <- transparentPOV
        }
    }
    void: insertNewPctTag(me string: tag, our POV: newPOV) <- {
        /*our POV[itr map string]: tagPOV <- pctTags.find(tag)
        if(tagPOV == pctTags.end()){
            pctTags.insert(tag, newPOV)
        }else{
            tagPOV.val.item.addInfItrToWrkList(newPOV)
        }*/
    }
    void: addCandidateForLastItem(our POV: candidate) <- {
        withEach cdat in candidatesForLastItem {
            if(cdat===candidate){return()}
        }
        candidatesForLastItem.append(candidate)
    }
    me bool: hasSparseOrderedSpanValue() <- {
        if(pItem==NULL){return(false)}
        if(pItem!.value!.overlayType!=LST or pItem!.value!.evalMode!=emLiteral){return(false)}
        if(!pItem!.value!.tailUnfinished){return(false)}
        if(pItem!.value!.listSpec==NULL){return(false)}
        if(pItem!.infSize!.overlayType!=NUM or pItem!.infSize!.evalMode!=emLiteral){return(false)}
        if(!pItem!.value!.items.isEmpty()){return(false)}
        return(true)
    }
    me bool: isSparseOrderedSpan() <- {
        return(isSubItm and hasSparseOrderedSpanValue())
    }
    me int64: sparseSpanCount() <- {
        if(!hasSparseOrderedSpanValue()){return(0)}
        return(pItem!.infSize!.num.convertToInt())
    }
    me bool: isImplicitItemPOV() <- {
        return(implicitItem.sourcePov!=NULL)
    }
    void: bindIdentityRegistry(our IdentityRegistry: registry) <- {
        if(registry!=NULL){identityRegistry <- registry}
    }
    their IdentityRegistry: effectiveIdentityRegistry() <- {
        if(identityRegistry!=NULL){return(identityRegistry)}
        if(repetitionSpan.family!=NULL and
                repetitionSpan.family!.registry!=NULL){
            return(repetitionSpan.family!.registry)
        }
        if(implicitItem.sourcePov!=NULL){
            return(implicitItem.sourcePov!.effectiveIdentityRegistry())
        }
        if(viewMap.sourcePov!=NULL){
            return(viewMap.sourcePov!.effectiveIdentityRegistry())
        }
        if(pParent!=NULL){return(pParent!.effectiveIdentityRegistry())}
        return(NULL)
    }
    our POV: findImplicitItemPOV(me int64: sourceIndex) <- {
        if(pItem==NULL or sourceIndex<0){return(NULL)}
        their IdentityRegistry: registry <- effectiveIdentityRegistry()
        if(registry==NULL){return(NULL)}
        return(registry!.findIndexedRepetitionOccurrence(self, sourceIndex))
    }
    our POV: getOrCreateImplicitItemPOV(me int64: sourceIndex) <- {
        if(!hasSparseOrderedSpanValue() or sourceIndex<0 or
                sourceIndex>=sparseSpanCount()){return(NULL)}
        their IdentityRegistry: registry <- effectiveIdentityRegistry()
        if(registry==NULL){return(NULL)}
        return(registry!.getOrCreateIndexedRepetitionOccurrence(
                self, sourceIndex))
    }
    // Navigate compressed logical items arithmetically. This may retain a
    // canonical implicit POV, but never changes the physical source list.
    our POV: logicalSiblingAtOffset(me int64: offset) <- {
        if(offset<0){return(NULL)}
        our POV: pov
        if(isImplicitItemPOV()){
            their POV: sourcePOV <- implicitItem.sourcePov
            if(sourcePOV==NULL or
                    !sourcePOV!.hasSparseOrderedSpanValue()){return(NULL)}
            me int64: available <- sourcePOV!.sparseSpanCount() - implicitItem.sourceIndex
            if(available<=0){return(NULL)}
            if(offset<available){
                return(sourcePOV!.getOrCreateImplicitItemPOV(
                        implicitItem.sourceIndex + offset))
            }
            if(!sourcePOV!.isSubItm){return(NULL)}
            offset <- offset - available
            pov <- sourcePOV!.next
            if(pov!=NULL){pov!.pParent <- sourcePOV!.pParent}
        }else{
            pov <- listNodeForSelf()
            if(pov==NULL){
                if(hasSparseOrderedSpanValue() and
                        offset<sparseSpanCount()){
                    return(getOrCreateImplicitItemPOV(offset))
                }
                return(NULL)
            }
        }

        while(pov!=NULL){
            if(pov!.isSparseOrderedSpan()){
                me int64: spanCount <- pov!.sparseSpanCount()
                if(offset<spanCount){return(pov!.getOrCreateImplicitItemPOV(offset))}
                offset <- offset - spanCount
            }else{
                if(offset==0){return(pov)}
                offset <-- 1
            }
            our POV: priorPOV <- pov
            pov <- pov!.next
            if(pov!=NULL){pov!.pParent <- priorPOV!.pParent}
        }
        return(NULL)
    }
    our POV: logicalNextItemPOV() <- {
        return(logicalSiblingAtOffset(1))
    }
    me bool: hasLogicalItemsFromHere(me int64: itemCount) <- {
        if(itemCount<=0){return(true)}
        return(logicalSiblingAtOffset(itemCount - 1)!=NULL)
    }
    // Find a zero-based logical item within this traversal context. Subitems
    // are transparent, and counted sparse spans yield canonical implicit POVs.
    our POV: logicalItemAtIndex(me int64: itemIndex) <- {
        if(itemIndex<0 or pItem==NULL or
                pItem!.value!.overlayType!=LST or
                pItem!.value!.evalMode==emUnknown){return(NULL)}
        // A counted typed sparse POV is itself the compressed run. It has no
        // material child node to enter, but each logical position still has a
        // canonical implicit POV.
        if(hasSparseOrderedSpanValue()){
            if(itemIndex>=sparseSpanCount()){return(NULL)}
            return(getOrCreateImplicitItemPOV(itemIndex))
        }
        our POV: childPOV <- pItem!.value!.items.head
        while(childPOV!=NULL){
            childPOV!.pParent <- self
            if(childPOV!.isSparseOrderedSpan()){
                me int64: spanCount <- childPOV!.sparseSpanCount()
                if(itemIndex<spanCount){
                    return(childPOV!.getOrCreateImplicitItemPOV(itemIndex))
                }
                itemIndex <- itemIndex - spanCount
            }else if(childPOV!.isSubItm){
                me FlexNum: childSize <- childPOV!.pItem!.sizeIfKnown()
                if(childSize==-1){return(NULL)}
                me int64: childCount <- childSize.convertToInt()
                if(itemIndex<childCount){
                    return(childPOV!.logicalItemAtIndex(itemIndex))
                }
                itemIndex <- itemIndex - childCount
            }else{
                if(itemIndex==0){return(childPOV)}
                itemIndex <-- 1
            }
            childPOV <- childPOV!.next
        }
        return(NULL)
    }
    // Resolve a window coordinate relative to this POV's own logical end.
    // Exact extent and position availability are deliberately separate: a
    // counted list can establish the coordinate before all positions exist.
    me EndRelativeWindowAvailability: endRelativeWindowAvailability(
            me int64: offset, me int64: itemCount) <- {
        me EndRelativeWindowAvailability: result
        result.itemCount <- itemCount
        if(pItem==NULL){
            result.status <- erwcIncompatible
            result.extent.status <- eresIncompatible
            return(result)
        }
        result.extent <- pItem!.endRelativeExtent()
        if(result.extent.status==eresIncompatible){
            result.status <- erwcIncompatible
            return(result)
        }
        if(result.extent.status!=eresExact){return(result)}

        result.startIndex <- result.extent.exactExtent + offset
        if(offset>=0 or itemCount<=0 or result.startIndex<0 or
                itemCount>result.extent.exactExtent-result.startIndex){
            result.status <- erwcOutOfRange
            return(result)
        }

        me int64: itemIndex <- result.startIndex
        while(itemIndex<result.startIndex+itemCount){
            our POV: sourceItemPOV <- logicalItemAtIndex(itemIndex)
            if(sourceItemPOV==NULL){return(result)}
            if(result.firstSourcePOV==NULL){
                result.firstSourcePOV <- sourceItemPOV
            }
            result.lastSourcePOV <- sourceItemPOV
            itemIndex <+- 1
        }
        result.status <- erwcAvailable
        return(result)
    }
    // Build a locally zero-based view over the final -offset logical items.
    // sourcePov remains the traversal boundary even when startPov is nested.
    our POV: makeEndRelativeSpanView(our POV: sourceContextPOV,
            me int64: offset, me int: source) <- {
        if(sourceContextPOV==NULL){return(NULL)}
        me int64: itemCount <- 0 - offset
        me EndRelativeWindowAvailability: availability <-
                endRelativeWindowAvailability(offset, itemCount)
        if(availability.status!=erwcAvailable){return(NULL)}
        me int64: finalExtent <- availability.extent.exactExtent
        me int64: startIndex <- availability.startIndex
        our POV: firstSourcePOV <- availability.firstSourcePOV

        our infonView:: span
        span!.setToList()
        span!.value!.listSpec <- pItem!.value!.listSpec
        span!.orderMode <- pItem!.orderMode
        span!.value!.sizeMode <- fromCount
        span!.value!.tailUnfinished <- false
        span!.infSize!.overlayType <- NUM
        span!.infSize!.evalMode <- emLiteral
        span!.infSize!.num <- itemCount

        our POV:: spanPOV{source}
        spanPOV!.pItem <- span
        spanPOV!.isSubItm <- true
        spanPOV!.pParent <- pParent
        spanPOV!.mapViewToSource(sourceContextPOV, firstSourcePOV)

        me int64: itemIndex <- startIndex
        while(itemIndex<finalExtent){
            our POV: sourceItemPOV <- logicalItemAtIndex(itemIndex)
            if(sourceItemPOV==NULL){return(NULL)}
            // Matching a view must refine only the local projection.  The
            // source is changed later, through ViewMap, if the selected view
            // is assigned to.
            our infonView:: localItem
            sourceItemPOV!.pItem!.copyAsTypeTo(localItem, false, false)
            our POV: localPOV <- span!.value!.items.append(
                    localItem, sourceItemPOV!.isSubItm, source)
            localPOV!.pParent <- spanPOV
            localPOV!.tentFromDots <- sourceItemPOV!.tentFromDots
            localPOV!.mapLocalCopyTreeToSource(
                    sourceContextPOV, sourceItemPOV)
            itemIndex <+- 1
        }
        return(spanPOV)
    }
    me string: sparseSpanListSpecTypeID() <- {
        if(!isSparseOrderedSpan()){return("")}
        if(pItem!.value!.listSpec!.type==NULL){return("")}
        return(pItem!.value!.listSpec!.type!.typeID())
    }
    me bool: sparseSpanCompatibleWith(our POV: other) <- {
        if(!isSparseOrderedSpan() or other==NULL or !other!.isSparseOrderedSpan()){return(false)}
        me string: mySpec <- sparseSpanListSpecTypeID()
        me string: otherSpec <- other!.sparseSpanListSpecTypeID()
        if(mySpec=="" or otherSpec==""){return(false)}
        return(mySpec==otherSpec)
    }
    our infonView: makeSparseSpanCopy(me int64: count) <- {
        our infonView:: span
        pItem!.copyAsTypeTo(span, false, true)
        span!.value!.items.clear()
        span!.value!.listSpec <- pItem!.value!.listSpec
        span!.infSize!.overlayType <- NUM
        span!.infSize!.evalMode <- emLiteral
        span!.infSize!.num <- count
        // A split creates a new compressed &{...} remainder whose explicit
        // infSize overrides its zero physically stored children.
        span!.value!.sizeMode <- fromGiven
        span!.value!.tailUnfinished <- true
        return(span)
    }
    me bool: isThisPOV(our POV: candidate) <- <%!%1.get()==this%>
    our POV: listNodeForSelf() <- {
        if(pParent==NULL or pParent!.pItem==NULL){return(NULL)}
        our POV: candidate <- pParent!.pItem!.value!.items.head
        while(candidate!=NULL){
            if(isThisPOV(candidate)){return(candidate)}
            candidate <- candidate!.next
        }
        return(NULL)
    }

    our POV: splitSparseSpanPrefix(me int64: prefixCount) <- {
        if(!isSparseOrderedSpan() or pParent==NULL or pParent!.pItem==NULL){return(NULL)}
        our POV: spanPOV <- listNodeForSelf()
        if(spanPOV==NULL){return(NULL)}
        me int64: totalCount <- sparseSpanCount()
        if(prefixCount<=0 or prefixCount>=totalCount){return(NULL)}

        our infonView: remainder <- makeSparseSpanCopy(totalCount - prefixCount)
        me int64: oldStartOrdinal <- repetitionSpan.startOrdinal
        me int64: oldEndOrdinal <- oldStartOrdinal + totalCount
        pItem!.infSize!.num <- prefixCount

        our POV: remainderPOV <- pParent!.pItem!.value!.items.insertAfter(spanPOV, remainder, povSrcSparseSpanRemainder)
        remainderPOV!.isSubItm <- true
        remainderPOV!.pParent <- pParent
        remainderPOV!.identityRegistry <- effectiveIdentityRegistry()
        remainderPOV!.repetitionSpan.family <- repetitionSpan.family
        remainderPOV!.repetitionSpan.startOrdinal <-
                oldStartOrdinal + prefixCount
        their IdentityRegistry: registry <- effectiveIdentityRegistry()
        if(registry!=NULL and repetitionSpan.family!=NULL){
            registry!.remapSplitRepetitionOccurrences(
                    self, remainderPOV, oldEndOrdinal)
        }
        return(remainderPOV)
    }
    our POV: exposeSparseHeadWithItem(our infonView: headItem) <- {
        if(!isSparseOrderedSpan() or pParent==NULL or pParent!.pItem==NULL){return(NULL)}
        our POV: spanPOV <- listNodeForSelf()
        if(spanPOV==NULL){return(NULL)}
        me int64: totalCount <- sparseSpanCount()
        if(totalCount<=0){return(NULL)}
        me int64: oldStartOrdinal <- repetitionSpan.startOrdinal
        me int64: oldEndOrdinal <- oldStartOrdinal + totalCount
        // Exact head exposure is the materialization of this repetition
        // occurrence.  Name it even when no earlier selection demanded it so
        // the identity is explicit and reversible in either direction.
        our POV: occurrenceReference <- getOrCreateImplicitItemPOV(0)

        our POV: headPOV <- pParent!.pItem!.value!.items.insertBefore(spanPOV, headItem, povSrcSparseExposedHead)
        headPOV!.isSubItm <- false
        headPOV!.pParent <- pParent
        headPOV!.identityRegistry <- effectiveIdentityRegistry()

        if(totalCount==1){
            pParent!.pItem!.value!.items.erase(spanPOV)
        }else{
            pItem!.infSize!.num <- totalCount - 1
            repetitionSpan.startOrdinal <+- 1
            their IdentityRegistry: registry <- effectiveIdentityRegistry()
            if(registry!=NULL and repetitionSpan.family!=NULL){
                registry!.remapExposedHeadRemainder(self, oldEndOrdinal)
            }
        }
        if(occurrenceReference!=NULL){
            their IdentityRegistry: registry <- effectiveIdentityRegistry()
            if(registry!=NULL){
                registry!.recordRepetitionMaterialization(
                        occurrenceReference, headPOV, 0)
            }
        }
        return(headPOV)
    }
    our POV: exposeSparseHead(me bool: typeOnlyHead <- false) <- {
        our infonView: headItem
        if(typeOnlyHead){headItem <- makeSparseSpanMemberTypeOnlyInfonView()}
        else{headItem <- makePotentialMemberInfonView()}
        return(exposeSparseHeadWithItem(headItem))
    }
    our POV: siblingAtOffset(me int64: offset) <- {
        if(offset<0){return(NULL)}
        if(isImplicitItemPOV()){return(logicalSiblingAtOffset(offset))}
        our POV: pov <- listNodeForSelf()
        while(pov!=NULL and offset>0){
            pov <- pov!.next
            offset <-- 1
        }
        if(pov!=NULL){pov!.pParent <- pParent}
        return(pov)
    }
    me int64: countConcreteSiblingsFromHere() <- {
        me int64: count <- 0
        our POV: pov <- listNodeForSelf()
        while(pov!=NULL){
            count <+- 1
            pov <- pov!.next
        }
        return(count)
    }
    me bool: concreteSiblingParentTailUnfinished() <- {
        if(pParent==NULL or pParent!.pItem==NULL){return(false)}
        return(pParent!.pItem!.value!.tailUnfinished)
    }
    our POV: makeLogicalSiblingSpanView(our POV: sourceContextPOV,
            me int64: itemCount, me bool: keepTail, me int: source,
            me bool: crossSparseBoundaries <- false) <- {
        if(pItem==NULL or sourceContextPOV==NULL or itemCount<0){return(NULL)}
        if(itemCount==0 and !keepTail){return(NULL)}
        our POV: firstSibling
        if(isImplicitItemPOV()){firstSibling <- logicalSiblingAtOffset(0)}
        else if(crossSparseBoundaries and hasSparseOrderedSpanValue()){
            firstSibling <- getOrCreateImplicitItemPOV(0)
        }
        else{firstSibling <- listNodeForSelf()}
        if(firstSibling==NULL){return(NULL)}

        our infonView:: span
        span!.setToList()
        their POV: spanParent <- pParent
        if(isImplicitItemPOV() and implicitItem.sourcePov!=NULL){
            spanParent <- implicitItem.sourcePov!.pParent
            span!.value!.listSpec <- implicitItem.sourcePov!.pItem!.value!.listSpec
            span!.orderMode <- implicitItem.sourcePov!.pItem!.orderMode
        }else if(spanParent!=NULL and spanParent!.pItem!=NULL){
            span!.value!.listSpec <- spanParent!.pItem!.value!.listSpec
            span!.orderMode <- spanParent!.pItem!.orderMode
        }
        span!.value!.sizeMode <- fromCount
        span!.value!.tailUnfinished <- keepTail
        if(keepTail){
            span!.infSize!.overlayType <- NUM
            span!.infSize!.evalMode <- emUnknown
        }else{
            span!.infSize!.overlayType <- NUM
            span!.infSize!.evalMode <- emLiteral
            span!.infSize!.num <- itemCount
        }

        our POV:: spanPOV{source}
        spanPOV!.pItem <- span
        spanPOV!.isSubItm <- true
        spanPOV!.pParent <- spanParent
        spanPOV!.mapViewToSource(sourceContextPOV, firstSibling)

        me int64: copied <- 0
        our POV: itemPOV <- firstSibling
        while(itemPOV!=NULL and copied<itemCount){
            our infonView:: localItem
            itemPOV!.pItem!.copyAsTypeTo(localItem, false, false)
            our POV: newPOV <- span!.value!.items.append(
                    localItem, itemPOV!.isSubItm, source)
            newPOV!.pParent <- spanPOV
            newPOV!.tentFromDots <- itemPOV!.tentFromDots
            newPOV!.mapLocalCopyTreeToSource(
                    sourceContextPOV, itemPOV)
            copied <+- 1
            if(copied<itemCount){
                if(crossSparseBoundaries){
                    itemPOV <- firstSibling!.
                            logicalSiblingAtOffset(copied)
                }else if(itemPOV!.isImplicitItemPOV()){
                    itemPOV <- itemPOV!.logicalNextItemPOV()
                }else{itemPOV <- itemPOV!.next}
            }
        }
        if(copied<itemCount){return(NULL)}
        return(spanPOV)
    }
    void: insertChildDotsBefore(our POV: position) <- {
        our infonView:: newSubDots
        newSubDots!.viewMode <- vmOverlay
        newSubDots!.value!.tailUnfinished <- true
        newSubDots!.value!.overlayType <- LST
        newSubDots!.value!.evalMode <- emLiteral
        our POV: newPOV <- pItem!.value!.items.insertBefore(position, newSubDots, 100)
        newPOV!.isSubItm <- true
        pItem!.value!.tailUnfinished <- false
    }
    void: closeItemsAtPOV(our POV: lastItem) <- {
        if(listClosed){return()}else{listClosed<-true}
        //log("closeItemsAtPOV:" + stringify() + "  lastItem:"+lastItem.stringify())
        while(!pItem!.value!.items.isEmpty() and !(pItem!.value!.items.last() === lastItem!.pItem)){
            pItem!.value!.items.popLast()
        }
        our POV: pov <- pItem!.value!.items.head
        while(pov != NULL){
            // Remove exploatory tentatives
            if(pov!.isSubItm and pov!.pItem!.value!.tailUnfinished and !pov!.pItem!.value!.items.isEmpty() and pov!.pItem!.value!.items.last()!.isTentative){
                pov!.pItem!.value!.items.popLast()
            }
            if(pov!.pItem!.isTentative){
                //:l/PAI::logSeg(" resetTent:A")
            }
            pov!.pItem!.isTentative <- false
            //log("reseting_isTentative:"+toString(pov!.pItem)+"   addNewSubDots:"+toString(pov!.addNewSubDots))
            if(pov!.addNewSubDots){
                me bool: preserveParentDots <- (pov!.pParent!.keepDots and pov!.pParent!.pParent==NULL)
                pov!.pParent!.insertChildDotsBefore(pov)
                if(preserveParentDots){pov!.pParent!.pItem!.value!.tailUnfinished <- true}
                else{pov!.pParent!.keepDots <- false}
            }
            pov <- pov!.next
        }
        if(!keepDots){
            pItem!.value!.tailUnfinished <- false
            pItem!.countSize(false)
        }
    }
    me bool: seedTypeSpecs(our infonView: newInfon, me bool: infonIsBlank) <- {
        if(newInfon!.addedTypesAlreadyCopied){return(true)}
        newInfon!.addedTypesAlreadyCopied <- true
        return(seedNewlyVisibleTypeSpecs(newInfon, infonIsBlank))
    }
    me bool: seedNewlyVisibleTypeSpecs(
            our infonView: newInfon, me bool: infonIsBlank) <- {
        their POV: lSpec <- self
        me List<our infonView>: newTypeSpecs
        while(lSpec != NULL){
            our infonView: lSpecInf <- lSpec!.pItem!.value!.listSpec
            if(lSpecInf!=NULL){
                if(lSpecInf!.asWrkLstOutr){
                    lSpecInf!.innr!.cnvtToFunc <- true
                    lSpecInf <- lSpecInf!.innr
                }
                newTypeSpecs.prepend(lSpecInf)
            }
            if(lSpec!.isSubItm){lSpec <- lSpec!.pParent}
            else{lSpec <- NULL}
        }
        if(newTypeSpecs.isEmpty()){return(false)}
        me bool: changeMade <- false
        withEach tSpec in newTypeSpecs{
            me bool: alreadyApplied <- false
            withEach appliedListSpec in newInfon!.appliedListSpecs{
                if(appliedListSpec===tSpec){alreadyApplied <- true; break()}
            }
            if(alreadyApplied){continue()}
            //TODO: optimize with COW
            if(infonIsBlank){
                tSpec!.copyAsTypeTo(newInfon, true, true);
                newInfon!.copySource <- tSpec
                newInfon!.copySourceType <- cstListSpec
                infonIsBlank<-false
            }
            else{
                our infonView: specCopy
                Allocate(specCopy)
                tSpec!.copyAsTypeTo(specCopy, true, true)
                specCopy!.copySource <- tSpec
                specCopy!.copySourceType <- cstListSpec
                newInfon!.addInfonViewToWorkListWithPriority(specCopy, false)
            }
            newInfon!.appliedListSpecs.append(tSpec)
            changeMade <- true
        }
        //TODO: apply outr idents
        return(changeMade)
    }
    our infonView: makePotentialMemberInfonView() <- {
        our infonView:: newInfon
        if(!seedTypeSpecs(newInfon, true)){
            newInfon!.value!.overlayType   <- tUnknown
            newInfon!.value!.evalMode  <- emUnknown
            newInfon!.viewMode       <- vmAny
        }
        newInfon!.itmMode       <- mItem
        if(isSubItm){
            if((pParent!=NULL and pParent!.pItem!.isInnr) or pItem!.useMode==umQuestion){
                //log("QUESTION pParent:"+pParent!.pItem!.mySymbol()+" = "+toString(pParent!.pItem))
                newInfon!.useMode <- umQuestion
                //log("QUESTION-in-c:"+newInfon.mySymbol()+" = "+toString(newInfon))
            }
        }
        return(newInfon)
    }
    our infonView: makeSparseSpanMemberTypeOnlyInfonView() <- {
        our infonView:: newInfon
        if(pItem!=NULL and pItem!.value!.listSpec!=NULL and pItem!.value!.listSpec!.type!=NULL){
            newInfon!.type <- pItem!.value!.listSpec!.type
            newInfon!.copySource <- pItem!.value!.listSpec
            newInfon!.copySourceType <- cstListSpec
        }
        newInfon!.itmMode <- mItem
        newInfon!.viewMode <- vmAny
        newInfon!.value!.overlayType <- tUnknown
        newInfon!.value!.evalMode <- emUnknown
        newInfon!.infSize!.evalMode <- emUnknown
        newInfon!.wordDerefed <- true
        newInfon!.alreadyTypeChecked <- true
        if(isSubItm){
            if((pParent!=NULL and pParent!.pItem!.isInnr) or pItem!.useMode==umQuestion){
                newInfon!.useMode <- umQuestion
            }
        }
        return(newInfon)
    }
    me int64: listSpecSparseRemainingCount() <- {
        if(pItem==NULL){return(0)}
        if(pItem!.value!.overlayType!=LST or pItem!.value!.evalMode!=emLiteral){return(0)}
        if(pItem!.value!.listSpec==NULL){return(0)}
        if(pItem!.value!.listSpec!.type==NULL){return(0)}
        if(pItem!.value!.listSpec!.asWrkLstOutr){return(0)}

        me FlexNum: givenCount <- pItem!.countGivenItems()
        if(givenCount<0){return(0)}
        me FlexNum: availableCount
        if(!listSpecSparseAvailableCount(availableCount)){return(0)}
        me FlexNum: remainingCount <- availableCount - givenCount
        if(remainingCount<=1){return(0)}
        return(remainingCount.convertToInt())
    }
    me bool: listSpecSparseHasRoom() <- {
        if(pItem==NULL){return(false)}
        if(pItem!.value!.overlayType!=LST or pItem!.value!.evalMode!=emLiteral){return(false)}
        if(pItem!.value!.listSpec==NULL){return(false)}
        if(pItem!.value!.listSpec!.type==NULL){return(false)}
        if(pItem!.value!.listSpec!.asWrkLstOutr){return(false)}

        me FlexNum: givenCount <- pItem!.countGivenItems()
        if(givenCount<0){return(false)}
        me FlexNum: availableCount
        if(!listSpecSparseAvailableCount(availableCount)){return(false)}
        return(givenCount < availableCount)
    }
    me bool: evalListSpecSparseRange(our infonView: infn, their FlexNum: lowest, their FlexNum: highest) <- {
        if(infn!.value!.evalMode!=emConcat){
            if(infn!.value!.overlayType==NUM){
                if(infn!.infSize!.evalMode==emLiteral){
                    if(infn!.value!.evalMode==emLiteral){
                        lowest! <- infn!.value!.num
                        highest! <- lowest!
                        return(true)
                    }else if(infn!.value!.evalMode==emUnknown){
                        lowest! <- 0
                        highest! <- infn!.infSize!.num
                        return(true)
                    }
                }else if(infn!.infSize!.evalMode==emUnknown){
                    if(infn!.value!.evalMode==emLiteral){
                        lowest! <- infn!.value!.num
                        highest! <- infn!.value!.num
                        return(true)
                    }
                }
            }
            return(false)
        }
        if(infn!.value!.items.size()==2){
            our infonView: first <- infn!.value!.items.first()
            our infonView: second <- infn!.value!.items.last()
            if(first!.value!.overlayType==NUM and first!.value!.evalMode==emUnknown and first!.infSize!.evalMode==emLiteral and
               second!.value!.overlayType==NUM and second!.value!.evalMode==emLiteral and second!.infSize!.evalMode==emUnknown and second!.value!.sizeMode==fromContext){
                lowest! <- second!.value!.num
                highest! <- lowest! + first!.infSize!.num
                return(true)
            }
            if(first!.value!.overlayType==NUM and first!.value!.evalMode==emLiteral and second!.value!.evalMode==emUnknown){
                lowest! <- first!.value!.num
                highest! <- first!.value!.num
                return(true)
            }
        }
        return(false)
    }
    me bool: listSpecSparseAvailableCount(their FlexNum: availableCount) <- {
        if(pItem!.infSize!.evalMode==emLiteral){
            availableCount! <- pItem!.infSize!.num
            return(true)
        }
        if(pItem!.infSize!.evalMode==emConcat){
            our infonView:: sizeInfon
            sizeInfon!.itmMode <- mItem
            sizeInfon!.viewMode <- vmOverlay
            sizeInfon!.value! <- pItem!.infSize!
            me FlexNum: lowCount
            me FlexNum: highCount
            if(evalListSpecSparseRange(sizeInfon, lowCount, highCount)){
                availableCount! <- max(lowCount, highCount)
                return(true)
            }
        }
        return(false)
    }
    our POV: tryAddingListSpecSparseTail() <- {
        if(pItem!.value!.items.tail!=NULL and pItem!.value!.items.tail!.isSparseOrderedSpan()){
            return(pItem!.value!.items.tail)
        }
        me int64: remainingCount <- listSpecSparseRemainingCount()
        if(remainingCount<=1){return(NULL)}

        our infonView:: sparseTail
        sparseTail!.setToList()
        sparseTail!.value!.listSpec <- pItem!.value!.listSpec
        sparseTail!.orderMode <- pItem!.orderMode
        sparseTail!.value!.sizeMode <- fromCount
        sparseTail!.value!.tailUnfinished <- true
        sparseTail!.infSize!.overlayType <- NUM
        sparseTail!.infSize!.evalMode <- emLiteral
        sparseTail!.infSize!.num <- remainingCount

        our POV: tailPOV <- pItem!.value!.items.append(sparseTail, true, povSrcListSpecSparseTail)
        tailPOV!.pParent <- self
        return(tailPOV)
    }
    our POV: tryAddingTentativeChild() <- {
        our POV: sparseTail <- tryAddingListSpecSparseTail()
        if(sparseTail!=NULL){return(sparseTail)}
        if(pItem!.value!.listSpec!=NULL and pItem!.value!.listSpec!.type!=NULL and !listSpecSparseHasRoom()){
            me FlexNum: availableCount
            if(listSpecSparseAvailableCount(availableCount)){
                pItem!.value!.tailUnfinished <- false
                return(NULL)
            }
        }
        if(!pItem!.value!.tailUnfinished and !listSpecSparseHasRoom()){return(NULL)}
        me string: lenStatus <- pItem!.lengthStatus()
        if(lenStatus == "L" or lenStatus == "?"){
            our infonView: newInfon <- makePotentialMemberInfonView()
            our POV: newInfNode <- pItem!.value!.items.append(newInfon, false, 103)
           newInfNode!.pParent <- self
            if(lenStatus == "?"){
                newInfon!.isTentative  <- true
                newInfNode!.tentFromDots <- true
            }
            return(newInfNode)
        }else if(lenStatus == "E"){
            pItem!.value!.tailUnfinished <- false
            return(NULL)
        }else if(lenStatus == "G"){log("INFON TOO BIG")}
        return(NULL)
    }
    our POV: getFirst(me int64: skipDots, their int:waitState) <- { // WARNING: pItem must be a literal List.
        if (streamingNormMode) {
            me MutexMngr: mtxMgr{streamingNormMutex}
            while(pItem!.streamState == parseStarted){
                if(waitState!=NULL){waitState!<-propWaitWithinList; return(NULL)}
                log("### >>NORM getFirstPOV-LOCKING-a:"+streamStateStrings[pItem!.streamState]+":: "+pItem!.mySymbol()+" = "+shortedStr(toString(pItem),100))
                streamingNormLock.wait(mtxMgr)
                log("### NORM getFirstPOV-UNLOCKED-a:"+pItem!.mySymbol())
            }
            log("### <<NORM getFirstPOV-DONE_WAITING-a on:"+pItem!.mySymbol()+shortedStr(toString(pItem),100))
        }

        our POV: firstNode
        if(pItem!.value!.items.isEmpty()){
            if(skipDots<=0 and (pItem!.value!.tailUnfinished or listSpecSparseHasRoom())){
                firstNode <- tryAddingTentativeChild()
                if(firstNode == NULL){return(NULL)}
            }else{return(NULL)}
        }else{
            firstNode <- pItem!.value!.items.begin()
            if (streamingNormMode) {
                me MutexMngr: mtxMgr{streamingNormMutex}
                while(firstNode!.pItem!.streamState == parseStarted){
                    if(waitState!=NULL){waitState!<-propWaitWithinList; return(NULL)}
                    log("### >>NORM getFirstPOV-LOCKING-b:"+streamStateStrings[firstNode!.pItem!.streamState]+":: "+firstNode!.mySymbol()+" = "+shortedStr(toString(firstNode!.pItem),100))
                    streamingNormLock.wait(mtxMgr)
                    log("### NORM getFirstPOV-UNLOCKED-b:"+pItem!.mySymbol())
                }
                log("### <<NORM getFirstPOV-DONE_WAITING-b on:"+pItem!.mySymbol()+shortedStr(toString(pItem),100))
            }
           seedTypeSpecs(firstNode!.pItem, false)//, true)
        }
        firstNode!.pParent <- self
        return(firstNode)
    }
    me bool: canAdvance() <- {
        // Case A: There is a known next sibling.
        if (next != NULL) {
            // Safe to descend into a list once the list structure is ready.
            //log("CanAdvance check with next: " + pItem!.mySymbol() + " state=" + streamStateStrings[pItem!.streamState] + "  next=" + next!.pItem!.mySymbol() + " state=" + streamStateStrings[next!.pItem!.streamState])
            return(next!.pItem!.streamState != parseStarted)
        }
        // Case B: No known next sibling yet; only stop waiting if the current level is closed.
        if (pParent != NULL) {
            log("Non-top-level canAdvance check: " + pItem!.mySymbol() + " state=" + streamStateStrings[pItem!.streamState] + "  parent=" + pParent!.pItem!.mySymbol() + " state=" + streamStateStrings[pParent!.pItem!.streamState])
            return(pParent!.pItem!.streamState == parseDone or pParent!.pItem!.streamState == notParsing)
        } else {
            // Top-level: done when the top item is done.
            if (pItem!.streamState == notParsing) {
                // Since this was generated not parsed, assume the sibling is also generated.
                // These come from POVs with pedigree.source of 402, 417 or 700.
                return(true)
            }
            log("Top-level canAdvance check: " + pItem!.mySymbol()
               +"   pItem:" + shortedStr(toString(pItem),100)
               +" source=" + toString(pedigree.source))
            return(true)
        }
    }
    our POV: getNext(me int64: skipDots, their int:waitState) <- {
        if (streamingNormMode) {
            me MutexMngr: mtxMgr{streamingNormMutex}
            while(!canAdvance()){
                if(waitState!=NULL){waitState!<-propWaitWithinList; return(NULL)}
                log("### >>NORM getNextPOV-LOCKING:"+pItem!.mySymbol()+" = "+shortedStr(toString(pItem),100))
                streamingNormLock.wait(mtxMgr)
                log("### NORM getNextPOV-UNLOCKED:"+pItem!.mySymbol())
            }
            log("### <<NORM getNextPOV-DONE_WAITING on:"+pItem!.mySymbol()+" = "+shortedStr(toString(pItem),100))
        }

        if(isImplicitItemPOV()){return(logicalNextItemPOV())}

        our POV: nextNode <- next
        if(nextNode==NULL){
            if(skipDots<=0){ //log("DOTS:"+toString(skipDots))
                if(pParent != NULL and pParent!.pItem != NULL and (pParent!.pItem!.value!.tailUnfinished or pParent!.listSpecSparseHasRoom())){
                    nextNode <- pParent!.tryAddingTentativeChild()
                }
            } else if(skipDots<1000000 and pParent != NULL and pParent!.pItem != NULL and !pParent!.isSubItm){ //log("FINISHING:"+pParent.stringify());
                pParent!.forLastUseLastItem<-true;
            }
        }else{seedTypeSpecs(nextNode!.pItem, false)}
        if(nextNode != NULL){nextNode!.pParent <- pParent}
        return(nextNode)
    }
    our POV: getFirstTight(our infItr: ii, me int64: skipDots, their int64: numLvlsUp, their int:waitState, their Agent: agent) <- {
        //log("[GFT: infItr:"+ii.mySymbol())
        me int64: dummyFlag
        our POV: nextPOV <- getFirst(skipDots, waitState)
        if(nextPOV == NULL and (waitState!=NULL and waitState! != propWaitNone)){return(NULL)}
        if(nextPOV != NULL and nextPOV!.isSparseOrderedSpan()){
            return(nextPOV)
        } else if(nextPOV != NULL and nextPOV!.isSubItm){
            me bool: setProp <- false
            if(nextPOV!.pItem!.value!.evalMode!=emLiteral or nextPOV!.pItem!.intersectPos!=ipNoIntersect){
                agent!.normalizeOneLevel(nextPOV)
                setProp <- true
            }
            our POV: firstPOV <- nextPOV!.getFirstTight(ii, skipDots, dummyFlag, waitState, agent)
            if(firstPOV!=NULL){firstPOV!.noteMarkedOuterFrom(nextPOV)}
            if(firstPOV == NULL){nextPOV <- nextPOV!.getNextTight(ii, skipDots, numLvlsUp, false, false, waitState, agent)}
            else{nextPOV <- firstPOV}
        }
        //log("]gft")
        return(nextPOV)
    }
    our POV: getNextTight(our infItr: ii, me int64: skipDots, their int64: numLvlsUp, me bool: getDeep, me bool: itrBeginning, their int:waitState, their Agent: agent) <- {
        //log("[GNT: infItr:"+ii.mySymbol()+"  skipdots:"+toString(skipDots)+"   pItem:"+pItem!.mySymbol()+":"+toString(pItem))
        our POV: nextPOV
        me int64: dummyFlag
        if(itrBeginning){
            if(doNotEnter){
                return(NULL)
            }
            nextPOV <- getFirstTight(ii, skipDots, numLvlsUp, waitState, agent)
        }
        else{
            nextPOV <- getNext(skipDots, waitState)
            if(nextPOV == NULL){
                if(waitState!=NULL and waitState! != propWaitNone){return(NULL)}
                their POV: traversalPOV <- self
                if(isImplicitItemPOV() and implicitItem.sourcePov!=NULL){
                    traversalPOV <- implicitItem.sourcePov
                }
                our infItr: nxtInfItr <- ii
                if(traversalPOV!.pParent==NULL or !traversalPOV!.pParent!.isSubItm){
                    numLvlsUp! <+- 1
                    if(traversalPOV!.pParent==NULL){/*log("]gnt-NULLa")*/ return(NULL)} else {skipDots <+- 1}
                    if(ii != NULL and ii!.iParent!=NULL){nxtInfItr <- ii!.iParent}
                }else if(traversalPOV!.pParent === ii!.topPOV){/*log("]gnt-NULLb")*/ return(NULL)}
                if(traversalPOV!.pParent!.outerPOV!=NULL){//log("UP-OTR")
                    nextPOV <- traversalPOV!.pParent!.outerPOV!.getNextTight(nxtInfItr, skipDots-1, numLvlsUp, getDeep, itrBeginning, waitState, agent)
                }else{//log("UP")
                    nextPOV <- traversalPOV!.pParent!.getNextTight(nxtInfItr, skipDots-1, numLvlsUp, getDeep, itrBeginning, waitState, agent)
                }
            }else if(nextPOV!.isSparseOrderedSpan()){
            }else if(nextPOV!.isSubItm or (nextPOV!.pItem!.value!.overlayType==LST and getDeep)){
                our POV: firstPOV <- nextPOV!.getFirstTight(ii, skipDots, dummyFlag, waitState, agent)
                if(firstPOV!=NULL){firstPOV!.noteMarkedOuterFrom(nextPOV)}
                if(firstPOV == NULL){nextPOV <- nextPOV!.getNextTight(ii, skipDots, numLvlsUp, getDeep, itrBeginning, waitState, agent)}
                else{nextPOV <- firstPOV}
            }
        }
        if(nextPOV!=NULL and markedOuterPOV!=NULL and nextPOV!.markedOuterPOV==NULL){
            nextPOV!.markedOuterPOV <- markedOuterPOV
        }
        if(nextPOV!=NULL and (waitState==NULL or waitState! == propWaitNone) and nextPOV!.altPOV==NULL and nextPOV!.pItem!.isTentative){
            me int: tmpWS<- -2
            if(waitState!=NULL){tmpWS <- waitState!}
            //log("GETTING_ALT: AlreadyGot:"+nextPOV.stringify()+"  waitState:"+toString(tmpWS));
            nextPOV!.altPOV <- nextPOV!.getNextTight(ii, INT64_MAX, dummyFlag, getDeep, false, waitState, agent)
        if(waitState!=NULL){tmpWS <- waitState!}
            //log("GETTING_ALT: ALT:"+nextPOV!.altPOV.mySymbol()+"  waitState:"+toString(tmpWS));
            //if(nextPOV!.altPOV){log("  altPOV = "+nextPOV!.altPOV!.stringify())}
        }
        //if(nextPOV){log("]gntA:"+nextPOV.stringify())} else{log("]gntA: NULL")}
        return(nextPOV)
    }

    me bool: applyAsNot(our POV: RHS)<-{
        if(RHS!=NULL and RHS!.pItem!=NULL and RHS!.pItem!.asRHSInternalIdent){return(false)}
        return(pItem!.invertMatch)
    }

    void: pushPredecessor(our POV: pred)<-{
        withEach crntPred in predecessors{
            if(crntPred===pred){
               // log("WARNING: "+pred!.mySymbol()+" already exists in "+mySymbol())
                return()
            }
        }
        predecessors.append(pred)
    }
    void: INIT() <- {clearSymbol(self);}

    me string: stringify()<-{
        me string: S
        if(self == NULL){S <- "NULL"}
        else{S <+- pItem!.mySymbol()+":"+toString(pItem)
            if(predecessors.size() >0){
                //S <+- " PREDS["
                withEach pred in predecessors{
                    //S <+- ":"+pred!.mySymbol()
                }
                //S <+- "] "
            }
            if(altPOV!=NULL){S <+- "  ALT_OR:" + altPOV!.stringify()}
            if(outerPOV!=NULL){S <+- "  <outerPOV:" +outerPOV!.mySymbol()+" " + outerPOV!.stringify()+">"}
        }
        return (S)
    }
    none: POV(me int: source) <- {
        INIT()  // TODO:
        flags     <- 0
        pItem     <- NULL
        next      <- NULL
        prev      <- NULL
        altPOV    <- NULL
        outerPOV  <- NULL
        pParent   <- NULL
        AlternativesNestLvl <- 0
        linearAltID <- 0
        workRevision <- 0
        pedigree.source <- source
        viewMap.sourcePov <- NULL
        viewMap.startPov <- NULL
        implicitItem.sourcePov <- NULL
        implicitItem.sourceIndex <- -1
        identityRegistry <- NULL
        repetitionSpan.family <- NULL
        repetitionSpan.startOrdinal <- 0
        repetitionOccurrence <- NULL
        temporalBoundary.sourcePov <- NULL
        temporalBoundary.cutIndex <- -1
    }
}

model PovList: implements = list {
    our POV: head
    our POV: tail
    me Mutex: povLstMtx

    void: clear() <- {
        protect(povLstMtx){
            head <- NULL; tail <- NULL;
        }
    }


    our POV: appendPov(our POV: newNode) <- {
        protect(povLstMtx){
            newNode!.prev <- tail
            newNode!.next <- NULL
            if(tail!=NULL) {tail!.next <- newNode}
            if(head==NULL) {head <- newNode}
            tail <- newNode
        }
        return(newNode)
    }

    our POV: append_actual_(our infonView: i, me bool: isSubItm, me int: source) <- {
        our POV:: newNode{source}
        newNode!.pItem <- i
        newNode!.next  <- NULL
        newNode!.prev  <- tail
        newNode!.isSubItm <- isSubItm
        if(tail!=NULL) {tail!.next <- newNode}
        if(head==NULL) {head <- newNode}
        tail <- newNode
        return(newNode)
    }

    our POV: append(our infonView: i, me bool: isSubItm, me int: source) <- {
        our POV: newNode
        protect(povLstMtx){
            newNode <- append_actual_(i, isSubItm, source)
        }
        return(newNode)
    }
    our POV: prepend(our infonView: i, me int: source) <- {
        our POV:: newNode{source}
        protect(povLstMtx){
            newNode!.pItem <- i
            newNode!.next  <- head
            newNode!.prev  <- NULL
            if(head!=NULL){head!.prev <- newNode}
            if(tail==NULL) {tail <- newNode}
            head <- newNode
        }
        return(newNode)
    }
    our POV: pushAsAlt(our POV: pov, our infonView: toPush, our POV: pred) <- {
        our POV: newAlt
        protect(povLstMtx){
            newAlt <- append_actual_(toPush, pov!.isSubItm, 110)
            newAlt!.outerPOV <- pov
                newAlt!.looseInhtd <- pov!.looseInhtd
                newAlt!.looseTop   <- pov!.looseTop
                newAlt!.looseMode  <- pov!.looseMode
            newAlt!.pushPredecessor(pred)
        }
        return(newAlt)
    }
    our POV: erase(our POV: toDel) <- {
        our POV: retVal
        protect(povLstMtx){
            retVal <- toDel!.prev
            if(toDel===head){head<-head!.next}
            if(toDel===tail){tail<-tail!.prev}
            if(toDel!.prev!=NULL){toDel!.prev!.next <- toDel!.next}
            if(toDel!.next!=NULL){toDel!.next!.prev <- toDel!.prev}
        }
        return(retVal)
    }

    our POV: insertBefore(our POV: position, our infonView: i, me int: source) <- {
//        if(position==NULL){return(append_actual_(i), 113)}
        our POV:: newNode{source}
        protect(povLstMtx){
            our POV: prevNode <- position!.prev
            newNode!.pItem <- i
            newNode!.next  <- position
            newNode!.prev  <- prevNode
            if(prevNode!=NULL){prevNode!.next <- newNode}
            position!.prev <- newNode
            if(head === position){head <- newNode}
        }
        return(newNode)
    }

    our POV: insertAfter(our POV: position, our infonView: i, me int: source) <- {
//        if(position==NULL){return(append_actual_(i), 112)}
        our POV:: newNode{source}
        protect(povLstMtx){
            our POV: nextNode <- position!.next
            newNode!.pItem <- i
            newNode!.next  <- nextNode
            newNode!.prev  <- position
            if(nextNode!=NULL){nextNode!.prev <- newNode}
            position!.next <- newNode
            if(tail === position){tail <- newNode}
        }
        return(newNode)
    }

    our infonView: popFirst() <- {
        our infonView: retVal
        protect(povLstMtx){
            retVal <- head!.pItem
            if(head!=NULL){
                head <- head!.next
                if(head==NULL){tail <- NULL}
                else{head!.prev <- NULL}
            }
        }
        return(retVal)
    }

    our infonView: popLast() <- {
        our infonView: retVal
        protect(povLstMtx){
            retVal <- tail!.pItem
            if(tail!=NULL){
                tail <- tail!.prev
                if(tail==NULL){head <- NULL}
                else{tail!.next <- NULL}
            }
        }
        return(retVal)
    }

    me bool: isEmpty() <- {
        return(head==NULL)
    }

    our infonView: first() <- {
        our infonView: retVal <- NULL
        protect(povLstMtx){
            if(head!=NULL) {retVal <- head!.pItem}
        }
        return(retVal)
    }

    our infonView: last() <- {
        our infonView: retVal <- NULL
        protect(povLstMtx){
            if(tail!=NULL) {retVal <- tail!.pItem}
        }
        return(retVal)
    }

    our POV: begin()  <- {return(head)} // Remove these 4 when iterators work correctly
    our POV: end()    <- {return(NULL)}
    our POV: rbegin() <- {return(tail)}
    our POV: rend()   <- {return(NULL)}

    our POV: front()  <- {return(head)}
    our POV: back()   <- {return(tail)}

    our POV: at(me int: N)  <- {
        our POV: retVal
        protect(povLstMtx){
            if (head == NULL){return(NULL)}
            retVal <- begin()
            withEach x in range 0..N{
                retVal <- retVal!.next
                if (retVal == NULL){return(NULL)}
            }
        }
        return(retVal)
    }

    me int: size() <- {
        me int: count <- 0
        protect(povLstMtx){
            our POV: pov <- head
            while(pov != NULL){
                count <- count+1
                pov <- pov!.next
            }
        }
        return(count)
    }
    void: __opAssign(me PovList: povLst) <- {head<-povLst.head; tail<-povLst.tail;}
}

struct POV {}
struct PovList {}
