////////////////////////////////////////////////////////////////////////
//// Validate Various rules about AItems

// aitemSrcID: [srcPMVA, srcPiCVA, srcNrmSize, srcNormInit, srcMrg0, srcPropagate, srcPartsPath, srcItsALT, srcItsFunc, srcUnordd]> {}

model AItemTrace{
    me uint64: normalizationID
    me uint64: runID
    me uint64: aItemID
    me uint64: enqueueID
    me string: recordKey
    me string: semanticCaseKey
    me string: executionContextKey
    me string: handlerEvents
    me string: lhsBefore
    me string: rhsBefore
    me string: lhsAfter
    me string: rhsAfter
    me string: observedLegacyOutcome
    me string: invariantFailures
    me int: stepBefore
    me int: stepAfter
    me int: pendingBefore
    me int: pendingAfter
    me int: heldPendingBefore
    me int: heldPendingAfter
    me uint64: aItemsAddedBefore
    me uint64: aItemsAddedAfter
    me uint64: propagationsQueuedBefore
    me uint64: propagationsQueuedAfter
    me uint64: propagationsProcessedBefore
    me uint64: propagationsProcessedAfter
    me bool: lhsChanged
    me bool: rhsChanged
    me bool: rejected
    me bool: workEnqueued
    me bool: propagationQueued
    me bool: propagationProcessed
    me bool: stepChanged
    me bool: pendingChanged
    me bool: unsupportedReached
}
struct AItemTrace{}

struct AItemValidator {
    Map<string, int: rangeIteration=logarithmic>: semanticCaseCounts
    Map<string, int: rangeIteration=logarithmic>: executionContextCounts
    Map<string, int: rangeIteration=logarithmic>: handlerCounts
    Map<string, int: rangeIteration=logarithmic>: semanticHandlerCounts
    Map<string, int: rangeIteration=logarithmic>: unsupportedCaseCounts
    Map<string, int: rangeIteration=logarithmic>: rejectedCaseCounts
    Map<string, int: rangeIteration=logarithmic>: mutatedCaseCounts
    Map<string, int: rangeIteration=logarithmic>: enqueuedCaseCounts
    me List<me string>: semanticCaseKeys
    me List<me string>: executionContextKeys
    me List<me string>: handlerKeys
    me List<me string>: semanticHandlerKeys
    me List<me string>: unsupportedCaseKeys
    me List<me string>: rejectedCaseKeys
    me List<me string>: mutatedCaseKeys
    me List<me string>: enqueuedCaseKeys
    me List<our AItemTrace>: traces

    me string: boolString(me bool: value) <- {
        if(value){return("true")}
        return("false")
    }

    me string: safeRuleSet(me int: value) <- {
        switch(value){
            case rsInfon:{return("rsInfon")}
            case rsMerge:{return("rsMerge")}
            case rsIntersect:{return("rsIntersect")}
            case rsPure:{return("rsPure")}
        }
        return("invalidRuleSet")
    }

    me string: safeMergeStatus(me int: value) <- {
        switch(value){
            case msUnknown:{return("msUnknown")}
            case msPending:{return("msPending")}
            case msAccept:{return("msAccept")}
            case msReject:{return("msReject")}
        }
        return("invalidMergeStatus")
    }

    me string: safeSource(me int: value) <- {
        switch(value){
            case srcPMVA1:{return("srcPMVA1")}
            case srcPMVA2:{return("srcPMVA2")}
            case srcPiCVA:{return("srcPiCVA")}
            case srcNrmSize:{return("srcNrmSize")}
            case srcNormInit:{return("srcNormInit")}
            case srcMrg0:{return("srcMrg0")}
            case srcPropagate:{return("srcPropagate")}
            case srcPartsPath:{return("srcPartsPath")}
            case srcItsALT:{return("srcItsALT")}
            case srcItsFunc:{return("srcItsFunc")}
            case srcUnordd:{return("srcUnordd")}
        }
        return("invalidSource")
    }

    me string: safeViewMode(me int: value) <- {
        switch(value){case vmAny:{return("vmAny")} case vmCursor:{return("vmCursor")} case vmOverlay:{return("vmOverlay")}}
        return("invalidViewMode")
    }

    me string: safeOverlayType(me int: value) <- {
        switch(value){case tUnset:{return("tUnset")} case tUnknown:{return("tUnknown")} case NUM:{return("NUM")} case STR:{return("STR")} case LST:{return("LST")}}
        return("invalidOverlayType")
    }

    me string: safeEvalMode(me int: value) <- {
        switch(value){case emUnknown:{return("emUnknown")} case emConcat:{return("emConcat")} case emLiteral:{return("emLiteral")} case emIntersection:{return("emIntersection")}}
        return("invalidEvalMode")
    }

    me string: safeOrderMode(me int: value) <- {
        switch(value){case uUnknown:{return("uUnknown")} case uOrdered:{return("uOrdered")} case uUnordered:{return("uUnordered")}}
        return("invalidOrderMode")
    }

    me string: safeIntersectPos(me int: value) <- {
        switch(value){case ipNoIntersect:{return("ipNoIntersect")} case ipGetLast:{return("ipGetLast")} case ipGetFirst:{return("ipGetFirst")} case ipGetMarked:{return("ipGetMarked")}}
        return("invalidIntersectPos")
    }

    me string: safeAccessMode(me int: value) <- {
        switch(value){case aCopyOf:{return("aCopyOf")} case aRefTo:{return("aRefTo")}}
        return("invalidAccessMode")
    }

    me string: povSnapshot(our POV: pov) <- {
        if(pov==NULL){return("NULL")}
        if(pov!.pItem==NULL){return("POV_WITHOUT_ITEM")}
        return(shortedStr(toString(pov!.pItem), 4000))
    }

    me string: povShape(our POV: pov) <- {
        if(pov==NULL){return("NULL")}
        if(pov!.pItem==NULL){return("POV_WITHOUT_ITEM")}
        our infonView: inf <- pov!.pItem
        if(inf!.value==NULL or inf!.infSize==NULL){return("INFON_WITHOUT_STATE")}
        me string: shape <- safeViewMode(inf!.viewMode)
        shape <+- "/"+safeOverlayType(inf!.value!.overlayType)
        shape <+- "/"+safeEvalMode(inf!.value!.evalMode)
        shape <+- "/size="+safeOverlayType(inf!.infSize!.overlayType)
        shape <+- "/"+safeEvalMode(inf!.infSize!.evalMode)
        shape <+- "/order="+safeOrderMode(inf!.orderMode)
        shape <+- "/intersect="+safeIntersectPos(inf!.intersectPos)
        shape <+- "/access="+safeAccessMode(pov!.accessMode)
        return(shape)
    }

    me string: semanticCaseKey(our AItem: aItem) <- {
        me string: key <- safeRuleSet(aItem!.ruleSet)+"|L="+povShape(aItem!.LHS_item)
        if(aItem!.ruleSet==rsMerge){
            me string: identityMode <- "strict"
            if(aItem!.RHS!=NULL and aItem!.RHS!.looseType()){identityMode <- "loose"}
            key <+- "|ID="+identityMode
            key <+- "|looseSize="+boolString(aItem!.looseSize)
            key <+- "|R="+povShape(aItem!.RHS)
        }
        return(key)
    }

    me string: executionContextKey(our AItem: aItem) <- {
        return(safeRuleSet(aItem!.ruleSet)+"|step="+toString(aItem!.step)+"|source="+safeSource(aItem!.pedigree.source))
    }

    me bool: rejectedState(our AItem: aItem) <- {
        if(aItem!.mergeStatus==msReject){return(true)}
        if(aItem!.LHS_item!=NULL and aItem!.LHS_item!.rejected){return(true)}
        return(false)
    }

    void: addInvariantFailure(our AItemTrace: trace, me string: phase, me string: message) <- {
        if(trace!.invariantFailures!=""){trace!.invariantFailures <+- ";"}
        trace!.invariantFailures <+- phase+":"+message
    }

    void: validateRepresentation(our AItemTrace: trace, our AItem: aItem, me string: phase) <- {
        if(aItem!.pendingTasks<0){addInvariantFailure(trace, phase, "pendingTasks<0")}
        if(aItem!.heldPendingTasks<0){addInvariantFailure(trace, phase, "heldPendingTasks<0")}
        if(aItem!.step<0){addInvariantFailure(trace, phase, "step<0")}
        if(aItem!.LHS_item!=NULL and aItem!.LHS_item!.pItem==NULL){addInvariantFailure(trace, phase, "LHS POV has no pItem")}
        if(aItem!.RHS!=NULL and aItem!.RHS!.pItem==NULL){addInvariantFailure(trace, phase, "RHS POV has no pItem")}
        if(aItem!.LHS_item!=NULL and aItem!.LHS_item!.pItem!=NULL and safeOrderMode(aItem!.LHS_item!.pItem!.orderMode)=="invalidOrderMode"){
            addInvariantFailure(trace, phase, "LHS has invalid orderMode")
        }
        if(aItem!.RHS!=NULL and aItem!.RHS!.pItem!=NULL and safeOrderMode(aItem!.RHS!.pItem!.orderMode)=="invalidOrderMode"){
            addInvariantFailure(trace, phase, "RHS has invalid orderMode")
        }
        if(aItem!.ruleSet==rsMerge){
            if(aItem!.LHS_item==NULL){addInvariantFailure(trace, phase, "merge has no LHS")}
            // Step zero legitimately supports single-sided merge setup. Step one is
            // the existing RHS-dependent path unless RHS use was explicitly skipped.
            if(phase=="before" and aItem!.step==1 and !aItem!.skipRHSUsageInPAI and aItem!.RHS==NULL){
                addInvariantFailure(trace, phase, "merge step 1 has no RHS")
            }
        }
        if(aItem!.ruleSet==rsIntersect and aItem!.LHS_item==NULL){addInvariantFailure(trace, phase, "intersect has no LHS")}
    }

    our AItemTrace: beginAItem(their Agenda: agenda, our AItem: aItem, me bool: validateAitems) <- {
        aItem!.phase1BeginRun()
        our AItemTrace:: trace
        trace!.normalizationID <- agenda!.normalizationID
        trace!.runID <- aItem!.runID
        trace!.aItemID <- aItem!.aItemID
        trace!.enqueueID <- aItem!.lastEnqueueID
        trace!.semanticCaseKey <- semanticCaseKey(aItem)
        trace!.executionContextKey <- executionContextKey(aItem)
        trace!.lhsBefore <- povSnapshot(aItem!.LHS_item)
        trace!.rhsBefore <- povSnapshot(aItem!.RHS)
        trace!.stepBefore <- aItem!.step
        trace!.pendingBefore <- aItem!.pendingTasks
        trace!.heldPendingBefore <- aItem!.heldPendingTasks
        trace!.aItemsAddedBefore <- agenda!.totalAItemsAdded
        trace!.propagationsQueuedBefore <- agenda!.totalPropagationsQueued
        trace!.propagationsProcessedBefore <- agenda!.totalPropagationsProcessed
        if(validateAitems){trace!.recordKey <- validateAItem(agenda, aItem)}
        validateRepresentation(trace, aItem, "before")
        return(trace)
    }

    void: incrementCoverage(our AItemTrace: trace, our AItem: aItem) <- {
        me string: key <- trace!.semanticCaseKey
        if(!semanticCaseCounts.containsKey(key)){semanticCaseKeys.append(key); semanticCaseCounts[key] <- 0}
        semanticCaseCounts[key] <+- 1

        key <- trace!.executionContextKey
        if(!executionContextCounts.containsKey(key)){executionContextKeys.append(key); executionContextCounts[key] <- 0}
        executionContextCounts[key] <+- 1

        if(aItem!.phase1HandlerEvents.isEmpty()){
            key <- "UNCLASSIFIED"
            if(!handlerCounts.containsKey(key)){handlerKeys.append(key); handlerCounts[key] <- 0}
            handlerCounts[key] <+- 1
            key <- trace!.semanticCaseKey+" -> UNCLASSIFIED"
            if(!semanticHandlerCounts.containsKey(key)){semanticHandlerKeys.append(key); semanticHandlerCounts[key] <- 0}
            semanticHandlerCounts[key] <+- 1
        }else{
            withEach handlerID in aItem!.phase1HandlerEvents{
                key <- handlerID
                if(!handlerCounts.containsKey(key)){handlerKeys.append(key); handlerCounts[key] <- 0}
                handlerCounts[key] <+- 1
                key <- trace!.semanticCaseKey+" -> "+handlerID
                if(!semanticHandlerCounts.containsKey(key)){semanticHandlerKeys.append(key); semanticHandlerCounts[key] <- 0}
                semanticHandlerCounts[key] <+- 1
            }
        }

        if(trace!.unsupportedReached){
            key <- trace!.semanticCaseKey
            if(!unsupportedCaseCounts.containsKey(key)){unsupportedCaseKeys.append(key); unsupportedCaseCounts[key] <- 0}
            unsupportedCaseCounts[key] <+- 1
        }
        if(trace!.rejected){
            key <- trace!.semanticCaseKey
            if(!rejectedCaseCounts.containsKey(key)){rejectedCaseKeys.append(key); rejectedCaseCounts[key] <- 0}
            rejectedCaseCounts[key] <+- 1
        }
        if(trace!.lhsChanged or trace!.rhsChanged){
            key <- trace!.semanticCaseKey
            if(!mutatedCaseCounts.containsKey(key)){mutatedCaseKeys.append(key); mutatedCaseCounts[key] <- 0}
            mutatedCaseCounts[key] <+- 1
        }
        if(trace!.workEnqueued){
            key <- trace!.semanticCaseKey
            if(!enqueuedCaseCounts.containsKey(key)){enqueuedCaseKeys.append(key); enqueuedCaseCounts[key] <- 0}
            enqueuedCaseCounts[key] <+- 1
        }
    }

    me string: traceLine(our AItemTrace: trace) <- {
        me string: effects <- "lhsChanged="+boolString(trace!.lhsChanged)
        effects <+- ",rhsChanged="+boolString(trace!.rhsChanged)
        effects <+- ",rejected="+boolString(trace!.rejected)
        effects <+- ",workEnqueued="+boolString(trace!.workEnqueued)
        effects <+- ",propagationQueued="+boolString(trace!.propagationQueued)
        effects <+- ",propagationProcessed="+boolString(trace!.propagationProcessed)
        effects <+- ",stepChanged="+boolString(trace!.stepChanged)
        effects <+- ",pendingChanged="+boolString(trace!.pendingChanged)
        effects <+- ",unsupported="+boolString(trace!.unsupportedReached)
        me string: line <- "PHASE1_TRACE|normalization="+toString(trace!.normalizationID)
        line <+- "|run="+toString(trace!.runID)+"|aItem="+toString(trace!.aItemID)+"|enqueue="+toString(trace!.enqueueID)
        line <+- "|semantic={"+trace!.semanticCaseKey+"}|execution={"+trace!.executionContextKey+"}"
        line <+- "|handlers={"+trace!.handlerEvents+"}|legacy={"+trace!.observedLegacyOutcome+"}"
        line <+- "|effects={"+effects+"}|invariants={"+trace!.invariantFailures+"}"
        line <+- "|before={LHS:"+shortedStr(trace!.lhsBefore, 500)+" RHS:"+shortedStr(trace!.rhsBefore, 500)+" step:"+toString(trace!.stepBefore)+" pending:"+toString(trace!.pendingBefore)+" held:"+toString(trace!.heldPendingBefore)+"}"
        line <+- "|after={LHS:"+shortedStr(trace!.lhsAfter, 500)+" RHS:"+shortedStr(trace!.rhsAfter, 500)+" step:"+toString(trace!.stepAfter)+" pending:"+toString(trace!.pendingAfter)+" held:"+toString(trace!.heldPendingAfter)+"}"
        return(line)
    }

    void: endAItem(their Agenda: agenda, our AItem: aItem, our AItemTrace: trace, me bool: validateAitems) <- {
        trace!.lhsAfter <- povSnapshot(aItem!.LHS_item)
        trace!.rhsAfter <- povSnapshot(aItem!.RHS)
        trace!.stepAfter <- aItem!.step
        trace!.pendingAfter <- aItem!.pendingTasks
        trace!.heldPendingAfter <- aItem!.heldPendingTasks
        trace!.aItemsAddedAfter <- agenda!.totalAItemsAdded
        trace!.propagationsQueuedAfter <- agenda!.totalPropagationsQueued
        trace!.propagationsProcessedAfter <- agenda!.totalPropagationsProcessed
        trace!.handlerEvents <- aItem!.phase1HandlerSummary()
        trace!.lhsChanged <- trace!.lhsBefore!=trace!.lhsAfter
        trace!.rhsChanged <- trace!.rhsBefore!=trace!.rhsAfter
        trace!.rejected <- rejectedState(aItem)
        trace!.workEnqueued <- trace!.aItemsAddedAfter>trace!.aItemsAddedBefore
        trace!.propagationQueued <- trace!.propagationsQueuedAfter>trace!.propagationsQueuedBefore
        trace!.propagationProcessed <- trace!.propagationsProcessedAfter>trace!.propagationsProcessedBefore
        trace!.stepChanged <- trace!.stepBefore!=trace!.stepAfter
        trace!.pendingChanged <- trace!.pendingBefore!=trace!.pendingAfter or trace!.heldPendingBefore!=trace!.heldPendingAfter
        trace!.unsupportedReached <- aItem!.phase1UnsupportedReached
        trace!.observedLegacyOutcome <- safeMergeStatus(aItem!.mergeStatus)+",rejected="+boolString(trace!.rejected)
        validateRepresentation(trace, aItem, "after")
        if(validateAitems){closeRecord(trace!.recordKey)}
        incrementCoverage(trace, aItem)
        traces.append(trace)
        log(traceLine(trace))
    }

    me string: coverageReport(me uint64: normalizationID) <- {
        me string: report <- "PHASE1_COVERAGE_BEGIN|normalization="+toString(normalizationID)+"|traces="+toString(traces.size())+"\n"
        withEach caseKey in semanticCaseKeys{report <+- "PHASE1_CASE|"+toString(semanticCaseCounts[caseKey])+"|"+caseKey+"\n"}
        withEach caseKey in executionContextKeys{report <+- "PHASE1_EXECUTION|"+toString(executionContextCounts[caseKey])+"|"+caseKey+"\n"}
        withEach caseKey in handlerKeys{report <+- "PHASE1_HANDLER|"+toString(handlerCounts[caseKey])+"|"+caseKey+"\n"}
        withEach caseKey in semanticHandlerKeys{report <+- "PHASE1_CASE_HANDLER|"+toString(semanticHandlerCounts[caseKey])+"|"+caseKey+"\n"}
        withEach caseKey in unsupportedCaseKeys{report <+- "PHASE1_UNSUPPORTED|"+toString(unsupportedCaseCounts[caseKey])+"|"+caseKey+"\n"}
        withEach caseKey in rejectedCaseKeys{report <+- "PHASE1_REJECTED|"+toString(rejectedCaseCounts[caseKey])+"|"+caseKey+"\n"}
        withEach caseKey in mutatedCaseKeys{report <+- "PHASE1_MUTATED|"+toString(mutatedCaseCounts[caseKey])+"|"+caseKey+"\n"}
        withEach caseKey in enqueuedCaseKeys{report <+- "PHASE1_ENQUEUED|"+toString(enqueuedCaseCounts[caseKey])+"|"+caseKey+"\n"}
        report <+- "PHASE1_COVERAGE_END|normalization="+toString(normalizationID)
        return(report)
    }
}

struct AItemValidator {
    Map<string, int: rangeIteration=logarithmic>: aItemRecords

    void: NotifyOfError(me string: recordKey, me string: msg, our AItem: aItem) <- {
        me string: error <- "DEBSYS_ERROR:" + recordKey + " :: " + msg+"       aItem:"+toString(aItem)
        log(error)
        print("\n\n",error,"\n")
        //exit(1)  // EXPERIMENT: temporarily commented to allow full traces.
    }

    me string: getFullKey(our AItem: aItem) <- {
        me string: key <- aItem!.mySymbol()+":"+aitemSrcIDStrings[aItem!.pedigree.source]+":"+toString(aItem!.step)
        return(key)
    }

    me string: getPartialKey(our AItem: aItem) <-{
        me string: key <- aItem!.mySymbol()+":"+aitemSrcIDStrings[aItem!.pedigree.source]
        return(key)
    }

    me string: makeSteppedKey(our AItem: aItem, me int: step) <- {
        me string: key <- getPartialKey(aItem)+":"+toString(step)
        return(key)
    }

    me int: getSteppedKeyValue(our AItem: aItem, me int: step) <- {
        me string: key <- makeSteppedKey(aItem, step)
        if(aItemRecords.containsKey(key)){
            return(aItemRecords[key])
        }
        return(-1)
    }

    me int: getFullKeyValue(our AItem: aItem) <- {
        me string: key <- getFullKey(aItem)
        if(aItemRecords.containsKey(key)){
            return(aItemRecords[key])
        }
        return(-1)
    }

    me int: getLastPartialKeyValue(our AItem: aItem) <- {
        me string: key <- getPartialKey(aItem)
        me aItemRecords.iterator: upper <- aItemRecords.upper_bound(key)
        if(upper == aItemRecords.end()){
            return(-1)
        }
        return(upper.val)
    }

    me string: getSubscriberKey(our AItem: aItem) <- {
        if(!aItem!.subscribers.isEmpty()){
            our AItem: subscriber <- aItem!.subscribers[0]
            me string: key <- getPartialKey(subscriber)
            return(key)
        }
        return("")
    }

    me int: getSubscriberKeyValue(our AItem: aItem) <- {
        if(!aItem!.subscribers.isEmpty()){
            our AItem: subscriber <- aItem!.subscribers[0]
            me int: key <- getLastPartialKeyValue(subscriber)
            return(key)
        }
        return(-1)
    }

    me string: getParentKey(our AItem: aItem) <- {
        if(aItem!.parent!=NULL){
            our AItem: parent <- aItem!.parent
            me string: key <- getPartialKey(parent)
            return(key)
        }
        return("")
    }

    me int: getParentKeyValue(our AItem: aItem) <- {
        if(aItem!.parent!=NULL){
            our AItem: parent <- aItem!.parent
            me int: key <- getLastPartialKeyValue(parent)
            return(key)
        }
        return(-1)
    }

    me void: assertStep0Complete(our AItem: aItem, me string: errMsg) <- {
        me string: step0Key <- makeSteppedKey(aItem, 0)
        if(!aItemRecords.containsKey(step0Key)){
            NotifyOfError(step0Key, errMsg+" Step 0 key not found. :: "+step0Key, aItem)
        } else if(aItemRecords[step0Key]<1){
            NotifyOfError(step0Key, errMsg +" Step 0 key not closed. :: "+step0Key, aItem)
        }
    }

    me void: assertStep1NotExists(our AItem: aItem, me string: errMsg) <- {
        me string: step1Key <- makeSteppedKey(aItem, 1)
        if(aItemRecords.containsKey(step1Key)){
            NotifyOfError(step1Key, errMsg+" :: "+step1Key, aItem)
        }
    }

    me void: logAitemData(our AItem: aItem, me string: label) <- {
        log(" AItem_Label: "+label)
        if(aItem==NULL){
            log("   AItem is NULL!\n")
            return()
        }
        log("    record: "+getFullKey(aItem)+" = "+toString(getFullKeyValue(aItem)))
        log("    string: "+aItem!.stringify()+"\n")
    }

    // Speculative early-wake passes intentionally revisit an AItem before its
    // real subscriber edge has been fulfilled, so the normal stepped-order
    // checks do not apply to that pass.
    me bool: shouldValidateAItem(our AItem: aItem) <- {
        return(!aItem!.wokenEarly)
    }

    me string: validateAItem(their Agenda: agenda, our AItem: aItem) <- {
        if(!shouldValidateAItem(aItem)){return("")}
        me string: recordKey <- getFullKey(aItem)
//       log(" Validating AItem recordKey: "+recordKey)

        // Check if already recorded
        if(aItemRecords.containsKey(recordKey)){
            NotifyOfError(recordKey, " Duplicate AItem record!", aItem)
        }

        // If step > 0, ensure previous step exists and is closed
        if(aItem!.step > 0){
            me int: stepToCheck <- aItem!.step-1
            // If reMrg we currently skip step 0
            if(aItem!.ruleSet==rsMerge and aItem!.step==2){stepToCheck <- 0}
            if(!(getSteppedKeyValue(aItem, stepToCheck) >= 0)){
                NotifyOfError(recordKey, " Previous step not found", aItem)
            }
        }

        // Validate according to ruleset and source
        switch(aItem!.pedigree.source){
            case srcPropagate:{ // Subscriber: NULL    Parent: Usually yes, but may be NULL when propagation climbs to top-level.
                me string: parentKey <- getParentKey(aItem)

                if(aItem!.step==0){
                    // Predecessor must exist and be closed
                    if(aItem!.debugArg!=NULL){
                        // debugArg is a merge. Get the pred from it.
                        our AItem: predAItem <- aItem!.debugArg!.debugArg
                        if(predAItem==NULL){
                            NotifyOfError(recordKey, " debugArg's debugArg (predAItem) is NULL!", aItem)
                            break()
                        }
                        me int: prevItmKeyVal <- getLastPartialKeyValue(predAItem)
                        if(prevItmKeyVal<=0){ // print for now
                            NotifyOfError(recordKey, " prevItm AItem not closed yet!", aItem)
                        }
                    }

                    // Parent must have step 0 but not 1
                    if(aItem!.parent==NULL){
                        // propagate() can legitimately walk nxtsParent above the highest
                        // AItem parent when lvlsUpOnLeft climbs back to top-level.
                        // debugArg still records the originating parent for ordering checks.
                        if(aItem!.debugArg==NULL){
                            NotifyOfError(recordKey, " Parent is NULL and debugArg is NULL!", aItem)
                        }
                    } else if(aItem!.parent!.parent==NULL){
                        NotifyOfError(recordKey, " Parent's list is NULL!", aItem)
                    } else {
                        our AItem: parentList <- aItem!.parent!.parent
                        assertStep0Complete(parentList, "Parent list step 0 is not complete.")
                        if(parentList!.pendingTasks==0){
                        assertStep1NotExists(parentList, "Parent list step 1 should not have started yet.")
                    }
                    }
                }
             //   logAitemData(aItem, "srcPropagateTEST")
             //   logAitemData(aItem!.parent, "srcPropagateTEST_PARENT")
            }
            case srcNrmSize:{ // Subscriber: NULL    Parent: Yes
                me string: parentKey <- getParentKey(aItem)
//                log("  $ srcNrmSize recordKey: "+recordKey+"         parentKey: "+parentKey)
            }
            case srcNormInit:{ // Subscriber: NULL    Parent: NULL
            }
            case srcItsALT:{ // Subscriber: NULL    Parent: Yes
                me string: parentKey <- getParentKey(aItem)
//                log("  $ srcItsALT recordKey: "+recordKey+"         parentKey: "+parentKey)
            }
            case srcItsFunc:{ // Subscriber: Yes    Parent: NULL
                me string: subKey <- getSubscriberKey(aItem)
//                log("  $ srcItsFunc recordKey: "+recordKey+"         subscriberKey: "+subKey)
            }
            case srcUnordd:{ // Subscriber: NULL    Parent: Yes
                me string: parentKey <- getParentKey(aItem)
//                log("  $ Unord recordKey: "+recordKey+"         parentKey: "+parentKey)
            }
            case srcPartsPath:{ // Subscriber: NULL    Parent: Yes
                me string: parentKey <- getParentKey(aItem)
//                log("  $ srcPartsPath recordKey: "+recordKey+"         parentKey: "+parentKey)
            }
            case srcMrg0:{ // Subscriber: Yes    Parent: NULL
                me string: subKey <- getSubscriberKey(aItem)
//                log("  $ srcMrg0 recordKey: "+recordKey+"         subscriberKey: "+subKey)
            }
            case srcPMVA1:{ // Subscriber: NULL    Parent: Yes
                me string: parentKey <- getParentKey(aItem)
//                log("  $ srcPMVA1 recordKey: "+recordKey+"         parentKey: "+parentKey)
            }
            case srcPMVA2:{ // Subscriber: NULL    Parent: Yes
                me string: parentKey <- getParentKey(aItem)
//                log("  $ srcPMVA recordKey: "+recordKey+"         parentKey: "+parentKey)
            }
            case srcPiCVA:{ // Subscriber: NULL    Parent: Yes
                me string: parentKey <- getParentKey(aItem)
//                log("  $ srcPiCVA recordKey: "+recordKey+"         parentKey: "+parentKey)
            }

            default:{
                print("FATAL ERROR: AItem recordKey with invalid source! :: "+aItem!.mySymbol()+"   source:"+aitemSrcIDStrings[aItem!.pedigree.source]+"\n")
            }
        }
        aItemRecords[recordKey] <- 0
        return(recordKey)
    }

    void: closeRecord(me string: recordKey) <- {
        if(recordKey==""){return()}
        aItemRecords[recordKey] <- 1
    }
}

////////////////////////////////////////////////////////////////////////
//// AItem Graph Creator
struct AItemGrapherData{
    bool: graphNodeFirstTime <- false
    string: recSym
    string: label
    string: attrs
    Map<string,string>: labels // recSym -> label
    int: count <- 0
}

struct GLOBAL {
    void: GraphNode_prePAI(our AItem: aItem, their AItemGrapherData: GD) <- {
        GD!.attrs <- "";
        if(aItem!.ruleSet==rsInfon){GD!.attrs <- "style=filled color=skyblue"}
        else if(aItem!.ruleSet==rsMerge){GD!.attrs <- "style=filled color=steelblue2"}
        else if(aItem!.ruleSet==rsIntersect){GD!.attrs <- "style=filled color=royalblue3"}
        GD!.recSym <- aItem!.mySymbol()
        GD!.label <- GD!.labels[GD!.recSym]
        if(GD!.label==""){
            GD!.graphNodeFirstTime<-true
            GD!.label <- GD!.recSym +":" +toString(GD!.count) + "\n" +aItem!.stringify()
            if(aItem!.parent!=NULL){grapher.addArrow(GD!.recSym, aItem!.parent!.mySymbol(), "parent", "color=magenta weight=1000")}
            else {
                if(!aItem!.subscribers.isEmpty()){
                    grapher.addArrow(GD!.recSym, aItem!.subscribers[0]!.mySymbol(), "subscriber", "color=brown weight=1000")
                }
            }
        }
    }

    void: GraphNode_postPAI(our AItem: aItem, their AItemGrapherData: GD) <- {
        GD!.label <+- "\n"+aItem!.stringify()
        if(aItem!.mergeStatus==msReject){GD!.label<+-"-R"}
        GD!.labels[GD!.recSym] <- GD!.label
        grapher.addNode(GD!.recSym, GD!.label, GD!.attrs)
        if(GD!.graphNodeFirstTime and aItem!.RHSItr!=NULL){grapher.addArrow(GD!.recSym, aItem!.RHSItr!.mySymbol()+"R", "RHSItr", "color=orange")}
        if(GD!.graphNodeFirstTime and aItem!.LHSItr!=NULL){grapher.addArrow(GD!.recSym, aItem!.LHSItr!.mySymbol()+"L", "LHSItr", "color=gold")}
        GD!.count <- GD!.count + 1
    }
}
