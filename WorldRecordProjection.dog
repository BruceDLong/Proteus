// A parent record can constrain some fields without describing every field of
// the instance. This result concerns one projection of one source; it neither
// establishes a missing queried object nor completes the target's value.
struct WorldCorrespondenceQuery {
    me bool: parentRequirement <- false
}
struct WorldCorrespondenceResult {
    me bool: noConstraint <- false
}
struct WorldCorrespondence {
    me bool: fieldAllowsExtra <- false
}
struct WorldRequest {
    me uint64: recordProjectionChecks <- 0
    me uint64: recordProjectionSkips <- 0
}

struct WorldPOVGraph {
    // Layout borrowing follows bare named aliases. Do not mistake a wrapper
    // with additional obligations for a transparent alias when proving that a
    // source contributes no constraint. Field values themselves remain lazy.
    me bool: pureRecordProjectionRoot(our infonView: item) <- {
        return(item!=NULL and item!.streamState==parseDone and item!.value!=NULL and item!.infSize!=NULL and
            item!.wrkList.isEmpty() and item!.addedTypes.isEmpty() and item!.argPos==apNoArgs and
            item!.funcArgs==NULL and item!.innr==NULL and item!.proxy==NULL and item!.partRef==NULL and
            item!.parts.isEmpty() and !item!.invertMatch and !item!.value!.inverted and !item!.value!.undefined and
            !item!.infSize!.inverted and !item!.infSize!.undefined and item!.viewMode!=vmCursor and
            !item!.doReply and item!.identityName==NULL and item!.temporalValueSource==NULL and item!.temporalPredecessor==NULL and
            (item!.infSize!.evalMode==emUnknown or item!.infSize!.evalMode==emLiteral))
    }

    // An implicit unordered remainder permits extra instance fields, but is
    // not proof that an arbitrary query is absent. The retained field walk
    // must still finish with unique, known identities and no symbolic spans.
    me bool: recordProjectionAllowsExtra(our WorldRequest: request, our WorldCorrespondence: lookup,
                                         me WorldScalar: header) <- {
        if(!lookup!.query!.parentRequirement or lookup!.query!.testPattern or lookup!.right!.levels.size()!=1){return(false)}
        our POV: relation <- lookup!.query!.relation
        if(relation==NULL or relation!.forceID or relation!.looseMode or relation!.looseTop or relation!.looseInhtd){return(false)}
        our WorldWalkLevel: level <- lookup!.right!.levels.last()
        our infonView: item <- level!.position!.node!.pItem
        request!.recordProjectionChecks <+- 1
        if(level!.position!.input!=NULL or !pureRecordProjectionRoot(item) or
           header.outcome!=worldReady or header.overlay!=LST or !header.hasValue or header.order!=uUnordered or
           header.explicitSize or header.hasSize or header.openTail or header.negative or
           item!.value!.listSpec!=NULL or item!.value!.evalMode!=emLiteral or
           (!header.meaningApplied and header.nominal!=NULL and header.nominal!.defToUse!=NULL)){return(false)}
        withEach wrapper in level!.namedLayouts{
            request!.recordProjectionChecks <+- 1
            if(!pureRecordProjectionRoot(wrapper) or wrapper!.type==NULL or wrapper!.wordArguments!=NULL or
               wrapper!.value!.evalMode!=emUnknown or wrapper!.infSize!.evalMode!=emUnknown){return(false)}
        }
        return(true)
    }
}
