// Native lifetime operations only. Layout, acquisition, navigation and cache
// policy remain ordinary CodeDog; weak ownership supplies no solver behavior.
struct WorldWeakReference<nodeType>: wraps=weak_ptr native=lang {
    void: set(our nodeType: node) <- <%!%0 = %1%>
    void: clear() <- <%!reset()%>
    our nodeType: lock() <- <%!lock()%>
    me bool: expired() <- <%!expired()%>
}
struct POV {
    me WorldWeakReference<POV>: privatePrevious
    our POV: previousNode() <- {
        if(prev!=NULL){return(prev)}
        return(privatePrevious.lock())
    }
}
struct infonView {
    // Only private immutable/acquired representations use weak backward links.
    // Ordinary supplied model lists keep their existing ownership contract.
    me bool: privateMemberLinks <- false
}
