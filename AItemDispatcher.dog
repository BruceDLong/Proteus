// Routes agenda items to their structural processor without owning semantics.
struct AItemDispatcher{
    me InfonProcessor: infonProcessor
    me MergeProcessor: mergeProcessor
    me IntersectProcessor: intersectProcessor

    void: dispatch(their WorldManager: worldManager, their Agenda: agenda, our AItem: aItem, me int: alternativesNestLvl) <- {
        switch(aItem!.ruleSet){
            case rsInfon:{infonProcessor.process(worldManager, agenda, aItem, alternativesNestLvl)}
            case rsMerge:{mergeProcessor.process(worldManager, agenda, aItem, alternativesNestLvl)}
            case rsIntersect:{intersectProcessor.process(worldManager, agenda, aItem, alternativesNestLvl)}
            case rsPure:{worldManager!.processAgendaItemLegacy(agenda, aItem, alternativesNestLvl)}
            default:{worldManager!.processAgendaItemLegacy(agenda, aItem, alternativesNestLvl)}
        }
    }
}
