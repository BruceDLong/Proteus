// Semantic outcome of inspecting an rsMerge item before its first control
// transition. MergeProcessor applies the returned step transition and work.
struct MergeStep0SemanticResult{
    mode[ms0SingleSided, ms0RHSReady, ms0NormalizeRHS]: action
}

// Semantic outcome of an rsMerge step. This describes control effects without
// making MergeProcessor interpret or mutate merge meaning.
struct MergeStepSemanticResult{
    me bool: advanceToStep2 <- false
    me bool: stopCurrentDispatch <- false
    me bool: requestPropagation <- false
    our POV: propagationRHS
    our POV: propagationRemainder
    me bool: propagationLooseSize <- false
    me bool: propagationDontEnque <- false
    me bool: completeSourceWork <- false
    me bool: fulfillSubscribers <- false
    me bool: retainPendingIntersectionTraversal <- false
    me List<our AItem>: requestedWork
}

// Owns local infon-state semantics while unimplemented merge families remain
// generated as explicit WorldManager semantic traps.
struct InfonViewReasoningResult{
    mode[rrNotApplicable, rrHandledNoChange, rrRejected, rrPlannedChange,
         rrNeedsWork]: status
    mode[dcNone, dcCopyLiteralValueToUnknown, dcLiteralAlreadyConstrainsUnknown,
         dcNumLiteralStrictEquality, dcStringLiteralStrictEquality,
         dcStrictOverlayTypeMismatch, dcScalarUnknownWithoutConstraints,
         dcLooseNumericRangeLiteral, dcLooseStringWholeCopy,
         dcLooseStringExactLiteral, dcLooseStringRemainder,
         dcStrictAnyCopiesIdentity,
         dcScalarUnknownCopiesIdentity, dcScalarUnknownCopiesConstraints,
         dcLooseAnyCopiesValue, dcLooseScalarUnknownWithoutConstraints,
         dcNumericRangeDeepCopy, dcConcatRangeIntersection,
         dcEquivalentNumericTemplatePolarity,
         dcUnresolvedNumericTemplatePolarity]: directCase
    mode[lcNone, lcStrictUnknownLists, lcStrictUnknownFromLiteralList,
         lcStrictLiteralAgainstUnknownList, lcUnresolvedListTemplatePolarity,
         lcStrictLiteralLists, lcLooseUnknownLists,
         lcLooseUnknownFromLiteralList, lcLooseLiteralAgainstUnknownList,
         lcLooseLiteralLists,
         lcLooseListAgainstScalar]: listCase
    mode[icNone, icStrictScalarAgainstIntersection,
         icAnyAgainstIntersection, icStrictListAgainstIntersection,
         icConcatAgainstIntersection, icNestedIntersection]: intersectionCase
    mode[ocNone, ocExactAlignment, ocSplitRHS, ocSplitLHS]: orderedSpanCase
    mode[rcNone, rcCopySourceIdentity]: referenceCase
    mode[caNone, caCopyRHSValueToLHS, caCopyRHSRangeMatchToLHS,
         caCopyRHSWholeStringToLHS, caCopyRHSIdentityToLHS,
         caCopyRHSWorkListToLHS, caCopyRHSValueAndTypeToLHS,
         caMergeRHSIntersection, caMergeLooseStrings,
         caCopyRHSInfonToLHS, caMergeANDRanges,
         caPrepareUnknownListForPropagation, caMergeRHSListConstraints,
         caApplyOrderedSpanPlan]: consolidationAction
    mode[waNone, waStartListPropagation,
         waInstantiateDefinitionListMembers]: workAction
    mode[cpNonInvertedAcceptance, cpPositiveTemplateAcceptance,
         cpFinalAcceptance]: actionCommitPolicy
    me ConstraintDisposition: constraintDisposition <- cdDischarged
    // True when status already accounts for both top-level template polarities;
    // AgendaEngine must not apply the legacy LHS-only inversion afterward.
    me bool: statusIncludesPolarity <- false
    me bool: copySize
    // Definition-backed list shape is a consequence of accepting this merge,
    // not prerequisite normalization. Keep each effect explicit so execution
    // can commit the complete accepted shape without re-deciding semantics.
    me bool: copyDefinitionListSpec <- false
    me bool: copyDefinitionOrderMode <- false
    me bool: copyDefinitionSize <- false
    me bool: openDefinitionTail <- false
    // Identity with a T-list makes the result a T-list.  Keep this separate
    // from definition-shape copying because it is implied by every accepted
    // list identity, not only by definitions.
    me bool: copyRHSTimelikeToLHS <- false
    me bool: emitRejectLog
    me int64: orderedSpanSplitCount
    me int64: orderedSpanSizeToCopy
}

// Records the mutations, ownership, and blockers discovered by the read-only
// pre-consolidation inspection. Definition-backed shape changes are planned in
// their historical order before the generic strict-size decision is made.
struct MergePreparationPlan{
    me bool: copyDefinitionListSpec
    me bool: copyDefinitionOrderMode
    me bool: copyDefinitionSize
    me bool: openDefinitionTail
    mode[mdsNotApplicable, mdsPromotedToConsolidation,
         mdsUnclaimed]: definitionShapeAction
    mode[mpsNotApplicable, mpsOwnedByConsolidation,
         mpsPromotedToConsolidation, mpsUnclaimed, mpsBlocked]: sizeAction
    me bool: sizeBlockedByOverlayType
    me bool: sizeBlockedByListOutput

    me bool: hasDefinitionListShapeChange() <- {
        return(copyDefinitionListSpec or copyDefinitionOrderMode or
                copyDefinitionSize or openDefinitionTail)
    }

    me bool: hasPreparationDecision() <- {
        return(hasDefinitionListShapeChange() or sizeAction!=mpsNotApplicable)
    }
}

model MappedWritePair{
    me List<our POV>: localViewPOVs
    our POV: targetSourcePOV
    our POV: rhsPOV
    our WordUse: preservedTargetType
    our infonView: preservedTargetListSpec
    me uint64: preservedTargetItemMode
    flag: materializeSparseTarget
}
struct MappedWritePair{}

model MappedSpanWritePlan{
    mode[mwpNotApplicable, mwpRejected,
         mwpReady, mwpCommitted]: status
    our POV: selectedViewPOV
    our POV: sourceContextPOV
    me List<our MappedWritePair>: pairs
    me string: diagnostic
}
struct MappedSpanWritePlan{}

// Owns the graph-identity precedence formerly hidden at the end of the
// ordered-span legacy hook. Local value comparison must stand aside when a
// source-backed reference is being identified with its candidate.
struct ReferenceConsolidationStrategy{
    me bool: identityTakesPriority(our AItem: aItem) <- {
        return(aItem!=NULL and aItem!.LHS_item!=NULL and
                aItem!.LHS_item!.accessMode==aRefTo and
                aItem!.LHS_item!.pItem!=NULL and
                ((aItem!.LHS_item!.viewMap.sourcePov!=NULL and
                  aItem!.LHS_item!.viewMap.startPov!=NULL and
                  aItem!.LHS_item!.viewMapWriteEnabled) or
                 ((aItem!.LHS_item!.viewMap.sourcePov==NULL or
                   aItem!.LHS_item!.viewMap.startPov==NULL) and
                  aItem!.LHS_item!.outerPOV!=NULL and
                  aItem!.LHS_item!.outerPOV!.pItem===aItem!.LHS_item!.pItem)) and
                aItem!.RHS!=NULL and aItem!.RHS!.pItem!=NULL and
                !aItem!.RHS!.pItem!.asRHSInternalIdent and
                !(aItem!.RHS!.pParent!=NULL and
                  aItem!.RHS!.pParent!.pItem!.asRHSInternalIdent))
    }

    me InfonViewReasoningResult: planConsolidation(our AItem: aItem) <- {
        me InfonViewReasoningResult: result
        result.status <- rrNotApplicable
        result.directCase <- dcNone
        result.listCase <- lcNone
        result.intersectionCase <- icNone
        result.orderedSpanCase <- ocNone
        result.referenceCase <- rcNone
        result.consolidationAction <- caNone
        result.workAction <- waNone
        result.actionCommitPolicy <- cpNonInvertedAcceptance
        result.copySize <- false
        result.emitRejectLog <- false
        if(!identityTakesPriority(aItem)){return(result)}

        result.referenceCase <- rcCopySourceIdentity
        result.status <- rrPlannedChange
        result.consolidationAction <- caCopyRHSIdentityToLHS
        // The legacy path materialized the positive identity before applying
        // top-level inversion. Preserve that ordering during this migration.
        result.actionCommitPolicy <- cpPositiveTemplateAcceptance
        return(result)
    }

    me bool: isOpenListShape(our infonView: item) <- {
        return(item!=NULL and item!.value!.overlayType==LST and
                item!.value!.evalMode==emLiteral and
                item!.value!.items.isEmpty() and
                item!.value!.tailUnfinished and
                item!.value!.listSpec!=NULL)
    }

    me bool: hasConcreteLiteralListItems(our infonView: item) <- {
        return(item!=NULL and item!.value!.overlayType==LST and
                item!.value!.evalMode==emLiteral and
                !item!.value!.items.isEmpty())
    }

    me bool: hasConcreteListSpec(our infonView: item) <- {
        return(hasConcreteLiteralListItems(item) and
                item!.value!.listSpec!=NULL)
    }

    our POV: mappedWriteSourcePOV(our POV: viewPOV) <- {
        if(viewPOV==NULL){return(NULL)}
        our POV: mappedSourcePOV <- viewPOV!.ultimateMappedSourcePOV()
        if(mappedSourcePOV!=NULL){return(mappedSourcePOV)}
        if(viewPOV!.outerPOV!=NULL){
            mappedSourcePOV <-
                    viewPOV!.outerPOV!.ultimateMappedSourcePOV()
            if(mappedSourcePOV!=NULL){return(mappedSourcePOV)}
            if(viewPOV!.outerPOV!.pItem===viewPOV!.pItem){
                return(viewPOV!.outerPOV)
            }
        }
        return(NULL)
    }

    me void: rejectMappedWritePlan(our MappedSpanWritePlan: plan,
            me string: diagnostic) <- {
        if(plan==NULL or plan!.status==mwpRejected){return()}
        plan!.status <- mwpRejected
        plan!.diagnostic <- diagnostic
    }

    me bool: sourceContextContainsPOV(our POV: sourceContextPOV,
            their POV: candidatePOV, me int: depth) <- {
        if(sourceContextPOV==NULL or candidatePOV==NULL or depth>128){return(false)}
        if(sourceContextPOV===candidatePOV){return(true)}
        if(candidatePOV!.viewMap.sourcePov===sourceContextPOV and
                candidatePOV!.viewMap.startPov!=NULL){
            return(sourceContextContainsPOV(sourceContextPOV,
                    candidatePOV!.viewMap.startPov, depth + 1))
        }
        if(candidatePOV!.isImplicitItemPOV()){
            return(sourceContextContainsPOV(sourceContextPOV,
                    candidatePOV!.implicitItem.sourcePov, depth + 1))
        }
        if(sourceContextPOV!.pItem==NULL or
                sourceContextPOV!.pItem!.value!.overlayType!=LST){return(false)}
        our POV: childPOV <- sourceContextPOV!.pItem!.value!.items.head
        while(childPOV!=NULL){
            if(sourceContextContainsPOV(
                    childPOV, candidatePOV, depth + 1)){return(true)}
            childPOV <- childPOV!.next
        }
        return(false)
    }

    our POV: validatedMappedWriteSourcePOV(our POV: viewPOV,
            me int: depth) <- {
        if(viewPOV==NULL or depth>128 or
                viewPOV!.viewMap.sourcePov==NULL or
                viewPOV!.viewMap.startPov==NULL){return(NULL)}
        our POV: sourceContextPOV <- viewPOV!.viewMap.sourcePov
        our POV: sourceStartPOV <- viewPOV!.viewMap.startPov
        if(!sourceContextContainsPOV(
                sourceContextPOV, sourceStartPOV, 0)){return(NULL)}
        if(sourceStartPOV===viewPOV){return(sourceStartPOV)}
        if(sourceStartPOV!.viewMap.sourcePov!=NULL or
                sourceStartPOV!.viewMap.startPov!=NULL){
            if(sourceStartPOV!.viewMap.sourcePov==NULL or
                    sourceStartPOV!.viewMap.startPov==NULL){return(NULL)}
            return(validatedMappedWriteSourcePOV(
                    sourceStartPOV, depth + 1))
        }
        return(sourceStartPOV)
    }

    me bool: mappedWriteTypesAreCompatible(
            their WorldManager: worldManager,
            our infonView: selected, our infonView: RHS) <- {
        if(selected==NULL or RHS==NULL){return(false)}
        me int: compatibility <- selected!.isCompatibleWith(RHS, false)
        if(compatibility!=tvFalse){return(true)}
        if(selected!.value!.overlayType!=LST or
                RHS!.value!.overlayType!=LST or
                selected!.type==NULL or RHS!.type==NULL){return(false)}
        me vocabularySpec: vSpec
        vSpec.init(worldManager!.agent!.getLocaleBaseName())
        our OrderedSpanConverter: converter <- modelMngr.
                getOrderedSpanConverter(selected!.type, RHS!.type, vSpec)
        return(converter!=NULL and converter!.valid and
                converter!.fromBaseCount==converter!.toBaseCount)
    }

    me bool: mappedRHSAssertionsAreEquivalent(
            our infonView: first, our infonView: second) <- {
        if(first==NULL or second==NULL){return(false)}
        if(first===second){return(true)}
        if(first!.value!.overlayType!=second!.value!.overlayType or
                first!.value!.evalMode!=second!.value!.evalMode or
                first!.infSize!.evalMode!=second!.infSize!.evalMode){
            return(false)
        }
        if(first!.type!=NULL and second!.type!=NULL and
                first!.type!.typeID()!=second!.type!.typeID()){return(false)}
        if(first!.value!.evalMode==emLiteral){
            if(first!.value!.overlayType==NUM){
                if(first!.value!.num!=second!.value!.num){return(false)}
            }else if(first!.value!.overlayType==STR){
                if(first!.value!.str!=second!.value!.str){return(false)}
            }else{return(false)}
        }
        if(first!.infSize!.evalMode==emLiteral and
                first!.infSize!.num!=second!.infSize!.num){return(false)}
        return(true)
    }

    our MappedWritePair: makeMappedWritePair(our POV: localViewPOV,
            our POV: targetSourcePOV, our POV: rhsPOV) <- {
        if(localViewPOV==NULL or targetSourcePOV==NULL or
                targetSourcePOV!.pItem==NULL or rhsPOV==NULL or
                rhsPOV!.pItem==NULL){return(NULL)}
        our MappedWritePair:: pair
        pair!.localViewPOVs.append(localViewPOV)
        pair!.targetSourcePOV <- targetSourcePOV
        pair!.rhsPOV <- rhsPOV
        pair!.preservedTargetType <- targetSourcePOV!.pItem!.type
        if(targetSourcePOV!.pItem!.value!.listSpec!=NULL and
                !hasConcreteListSpec(rhsPOV!.pItem)){
            pair!.preservedTargetListSpec <-
                    targetSourcePOV!.pItem!.value!.listSpec
        }
        pair!.preservedTargetItemMode <- targetSourcePOV!.pItem!.itmMode
        if(targetSourcePOV!.isImplicitItemPOV() and
                targetSourcePOV!.implicitItem.sourcePov!=NULL and
                targetSourcePOV!.implicitItem.sourcePov!.isSparseOrderedSpan()){
            pair!.materializeSparseTarget <- true
        }
        return(pair)
    }

    me void: appendMappedWritePair(their WorldManager: worldManager,
            our POV: localViewPOV, our POV: rhsPOV,
            our MappedSpanWritePlan: plan) <- {
        if(plan==NULL or plan!.status!=mwpReady){return()}
        if(localViewPOV==NULL or rhsPOV==NULL or
                localViewPOV!.viewMap.sourcePov!==plan!.sourceContextPOV){
            rejectMappedWritePlan(plan, "mapped-write-source-context")
            return()
        }
        our POV: targetSourcePOV <-
                validatedMappedWriteSourcePOV(localViewPOV, 0)
        if(targetSourcePOV==NULL or targetSourcePOV!.pItem==NULL){
            rejectMappedWritePlan(plan, "mapped-write-unresolved-target")
            return()
        }
        if(!mappedWriteTypesAreCompatible(
                worldManager, targetSourcePOV!.pItem, rhsPOV!.pItem)){
            rejectMappedWritePlan(plan, "mapped-write-target-type")
            return()
        }
        withEach existingPair in plan!.pairs{
            if(existingPair!.targetSourcePOV===targetSourcePOV or
                    existingPair!.targetSourcePOV!.pItem===
                            targetSourcePOV!.pItem){
                if(!mappedRHSAssertionsAreEquivalent(
                        existingPair!.rhsPOV!.pItem, rhsPOV!.pItem)){
                    rejectMappedWritePlan(
                            plan, "mapped-write-conflicting-target")
                    return()
                }
                existingPair!.localViewPOVs.append(localViewPOV)
                return()
            }
        }
        our MappedWritePair: pair <- makeMappedWritePair(
                localViewPOV, targetSourcePOV, rhsPOV)
        if(pair==NULL){
            rejectMappedWritePlan(plan, "mapped-write-invalid-pair")
            return()
        }
        if(pair!.materializeSparseTarget){
            their POV: sparseSourcePOV <-
                    targetSourcePOV!.implicitItem.sourcePov
            if(sparseSourcePOV==NULL or
                    targetSourcePOV!.implicitItem.sourceIndex<0 or
                    targetSourcePOV!.implicitItem.sourceIndex>=
                            sparseSourcePOV!.sparseSpanCount() or
                    sparseSourcePOV!.listNodeForSelf()==NULL){
                rejectMappedWritePlan(
                        plan, "mapped-write-sparse-materialization")
                return()
            }
        }
        plan!.pairs.append(pair)
    }

    me void: planMappedWriteNode(their WorldManager: worldManager,
            our POV: localViewPOV, our POV: rhsPOV,
            our MappedSpanWritePlan: plan) <- {
        if(plan==NULL or plan!.status!=mwpReady){return()}
        if(localViewPOV==NULL or localViewPOV!.pItem==NULL or
                rhsPOV==NULL or rhsPOV!.pItem==NULL){
            rejectMappedWritePlan(plan, "mapped-write-missing-node")
            return()
        }
        our infonView: selected <- localViewPOV!.pItem
        our infonView: RHS <- rhsPOV!.pItem
        me bool: selectedIsList <- selected!.value!.overlayType==LST
        me bool: rhsIsList <- RHS!.value!.overlayType==LST
        if(selectedIsList!=rhsIsList){
            rejectMappedWritePlan(plan, "mapped-write-shape")
            return()
        }
        if(!mappedWriteTypesAreCompatible(worldManager, selected, RHS)){
            rejectMappedWritePlan(plan, "mapped-write-type")
            return()
        }
        if(!selectedIsList){
            if(selected!.value!.overlayType!=tUnknown and
                    selected!.value!.overlayType!=tUnset and
                    RHS!.value!.overlayType!=tUnknown and
                    RHS!.value!.overlayType!=tUnset and
                    selected!.value!.overlayType!=RHS!.value!.overlayType){
                rejectMappedWritePlan(plan, "mapped-write-scalar-shape")
                return()
            }
            appendMappedWritePair(
                    worldManager, localViewPOV, rhsPOV, plan)
            return()
        }
        if(selected!.value!.evalMode!=emLiteral or
                RHS!.value!.evalMode!=emLiteral){
            rejectMappedWritePlan(plan, "mapped-write-list-state")
            return()
        }

        if(selected!.value!.items.isEmpty() and
                localViewPOV!.hasSparseOrderedSpanValue()){
            me int64: selectedCount <- localViewPOV!.sparseSpanCount()
            if(selectedCount<=0 or RHS!.value!.items.size()!=selectedCount){
                rejectMappedWritePlan(plan, "mapped-write-list-extent")
                return()
            }
            our POV: sourceStartPOV <- localViewPOV!.viewMap.startPov
            if(sourceStartPOV==NULL){
                rejectMappedWritePlan(plan, "mapped-write-sparse-origin")
                return()
            }
            our POV: rhsChildPOV <- RHS!.value!.items.head
            me int64: childIndex <- 0
            while(childIndex<selectedCount and rhsChildPOV!=NULL){
                our POV: localChildPOV <- localViewPOV!.
                        getOrCreateImplicitItemPOV(childIndex)
                our POV: sourceChildPOV <- sourceStartPOV!.
                        logicalSiblingAtOffset(childIndex)
                if(localChildPOV==NULL or sourceChildPOV==NULL){
                    rejectMappedWritePlan(
                            plan, "mapped-write-sparse-position")
                    return()
                }
                localChildPOV!.mapViewToSource(
                        plan!.sourceContextPOV, sourceChildPOV)
                planMappedWriteNode(worldManager,
                        localChildPOV, rhsChildPOV, plan)
                childIndex <+- 1
                rhsChildPOV <- rhsChildPOV!.next
            }
            return()
        }

        if(selected!.value!.items.size()!=RHS!.value!.items.size()){
            rejectMappedWritePlan(plan, "mapped-write-list-extent")
            return()
        }
        our POV: selectedChildPOV <- selected!.value!.items.head
        our POV: rhsChildPOV <- RHS!.value!.items.head
        while(selectedChildPOV!=NULL and rhsChildPOV!=NULL){
            planMappedWriteNode(worldManager,
                    selectedChildPOV, rhsChildPOV, plan)
            if(plan!.status==mwpRejected){return()}
            selectedChildPOV <- selectedChildPOV!.next
            rhsChildPOV <- rhsChildPOV!.next
        }
    }

    our MappedSpanWritePlan: buildMappedSpanWritePlan(
            their WorldManager: worldManager, our POV: selectedViewPOV,
            our POV: rhsPOV) <- {
        our MappedSpanWritePlan:: plan
        if(selectedViewPOV==NULL or !selectedViewPOV!.viewMapWriteEnabled or
                selectedViewPOV!.viewMap.sourcePov==NULL or
                selectedViewPOV!.viewMap.startPov==NULL){return(plan)}
        plan!.status <- mwpReady
        plan!.selectedViewPOV <- selectedViewPOV
        plan!.sourceContextPOV <- selectedViewPOV!.viewMap.sourcePov
        if(!sourceContextContainsPOV(plan!.sourceContextPOV,
                selectedViewPOV!.viewMap.startPov, 0)){
            rejectMappedWritePlan(plan, "mapped-write-root-context")
            return(plan)
        }
        planMappedWriteNode(
                worldManager, selectedViewPOV, rhsPOV, plan)
        if(plan!.status==mwpReady and plan!.pairs.isEmpty()){
            rejectMappedWritePlan(plan, "mapped-write-empty")
        }
        return(plan)
    }

    me bool: materializeMappedWritePairTarget(
            our MappedWritePair: pair) <- {
        if(pair==NULL or !pair!.materializeSparseTarget){return(true)}
        our POV: implicitTargetPOV <- pair!.targetSourcePOV
        if(implicitTargetPOV==NULL or
                !implicitTargetPOV!.isImplicitItemPOV()){return(false)}
        their POV: sparseSourcePOV <-
                implicitTargetPOV!.implicitItem.sourcePov
        me int64: sourceIndex <-
                implicitTargetPOV!.implicitItem.sourceIndex
        if(sparseSourcePOV==NULL or !sparseSourcePOV!.isSparseOrderedSpan() or
                sourceIndex<0 or sourceIndex>=sparseSourcePOV!.sparseSpanCount()){
            return(false)
        }
        our POV: selectedSparsePOV <- sparseSourcePOV!.listNodeForSelf()
        if(selectedSparsePOV==NULL){return(false)}
        if(sourceIndex>0){
            selectedSparsePOV <- sparseSourcePOV!.
                    splitSparseSpanPrefix(sourceIndex)
        }
        if(selectedSparsePOV==NULL){return(false)}
        our POV: concreteTargetPOV <- selectedSparsePOV!.
                exposeSparseHeadWithItem(implicitTargetPOV!.pItem)
        if(concreteTargetPOV==NULL){return(false)}
        pair!.targetSourcePOV <- concreteTargetPOV
        pair!.materializeSparseTarget <- false
        return(true)
    }

    // Validate every sparse publication against the still-unmodified source,
    // then publish higher logical indexes first within each sparse span. Once
    // this preflight succeeds, the ordered operations cannot invalidate a
    // later target in the single-threaded normalization transaction.
    me bool: materializeMappedWriteTargets(
            our MappedSpanWritePlan: plan) <- {
        if(plan==NULL or plan!.status!=mwpReady){return(false)}
        withEach pair in plan!.pairs{
            if(pair==NULL){return(false)}
            if(pair!.materializeSparseTarget){
                our POV: implicitTargetPOV <- pair!.targetSourcePOV
                if(implicitTargetPOV==NULL or
                        !implicitTargetPOV!.isImplicitItemPOV() or
                        implicitTargetPOV!.implicitItem.sourcePov==NULL or
                        !implicitTargetPOV!.implicitItem.sourcePov!.
                                isSparseOrderedSpan() or
                        implicitTargetPOV!.implicitItem.sourceIndex<0 or
                        implicitTargetPOV!.implicitItem.sourceIndex>=
                                implicitTargetPOV!.implicitItem.sourcePov!.
                                        sparseSpanCount() or
                        implicitTargetPOV!.implicitItem.sourcePov!.
                                listNodeForSelf()==NULL){
                    return(false)
                }
            }
        }

        while(true){
            our MappedWritePair: nextPair <- NULL
            withEach pair in plan!.pairs{
                if(pair!.materializeSparseTarget and
                        (nextPair==NULL or
                         pair!.targetSourcePOV!.implicitItem.sourceIndex>
                                nextPair!.targetSourcePOV!.
                                        implicitItem.sourceIndex)){
                    nextPair <- pair
                }
            }
            if(nextPair==NULL){break()}
            if(!materializeMappedWritePairTarget(nextPair)){
                // Preflight plus descending publication makes this an engine
                // invariant, not a recoverable half-committed write.
                logFatalError(
                        "Mapped sparse publication invalidated its plan")
                return(false)
            }
        }
        return(true)
    }

    me void: commitMappedWritePair(our MappedWritePair: pair) <- {
        our infonView: target <- pair!.targetSourcePOV!.pItem
        pair!.rhsPOV!.pItem!.copyAsTypeTo(target, false, true)
        if(pair!.preservedTargetType!=NULL){
            target!.type <- pair!.preservedTargetType
        }
        if(pair!.preservedTargetListSpec!=NULL){
            target!.value!.listSpec <- pair!.preservedTargetListSpec
        }
        if(pair!.preservedTargetItemMode!=mNone){
            target!.itmMode <- pair!.preservedTargetItemMode
        }
        withEach localViewPOV in pair!.localViewPOVs{
            localViewPOV!.pItem <- target
        }
    }

    me void: reevaluateMappedWriteCompletion(our POV: changedPOV) <- {
        their POV: parentPOV <- NULL
        if(changedPOV!=NULL){parentPOV <- changedPOV!.pParent}
        while(parentPOV!=NULL){
            if(parentPOV!.pItem!=NULL and
                    parentPOV!.pItem!.value!.overlayType==LST and
                    parentPOV!.pItem!.value!.tailUnfinished and
                    parentPOV!.pItem!.infSize!.evalMode==emLiteral){
                parentPOV!.pItem!.countSize(true)
            }
            parentPOV <- parentPOV!.pParent
        }
    }

    me bool: commitMappedSpanWritePlan(our MappedSpanWritePlan: plan) <- {
        if(plan==NULL or plan!.status!=mwpReady){return(false)}
        if(!materializeMappedWriteTargets(plan)){
            rejectMappedWritePlan(
                    plan, "mapped-write-stale-sparse-plan")
            return(false)
        }
        withEach pair in plan!.pairs{commitMappedWritePair(pair)}
        withEach pair in plan!.pairs{
            reevaluateMappedWriteCompletion(pair!.targetSourcePOV)
        }
        if(plan!.sourceContextPOV!=NULL and
                plan!.sourceContextPOV!.pItem!=NULL and
                plan!.sourceContextPOV!.pItem!.value!.overlayType==LST and
                plan!.sourceContextPOV!.pItem!.value!.tailUnfinished and
                plan!.sourceContextPOV!.pItem!.infSize!.evalMode==emLiteral){
            plan!.sourceContextPOV!.pItem!.countSize(true)
        }
        plan!.status <- mwpCommitted
        return(true)
    }

    me bool: executeMappedWrite(their WorldManager: worldManager,
            our AItem: aItem) <- {
        our MappedSpanWritePlan: plan <- buildMappedSpanWritePlan(
                worldManager, aItem!.LHS_item, aItem!.RHS)
        if(plan!.status==mwpNotApplicable){return(false)}
        if(plan!.status==mwpRejected or
                !commitMappedSpanWritePlan(plan)){
            aItem!.mergeStatus <- msReject
            aItem!.LHS_item!.rejected <- true
        }
        return(true)
    }

    me bool: isSourceBackedPOV(our POV: pov) <- {
        return(pov!=NULL and pov!.accessMode==aRefTo and
                ((pov!.viewMap.sourcePov!=NULL and
                  pov!.viewMap.startPov!=NULL and
                  pov!.viewMapWriteEnabled) or
                 ((pov!.viewMap.sourcePov==NULL or
                   pov!.viewMap.startPov==NULL) and
                  pov!.outerPOV!=NULL and
                  pov!.outerPOV!.pItem===pov!.pItem)))
    }

    me bool: mergeOpenListShapeIntoConcreteList(our AItem: aItem,
            our infonView: RHS, me uint64: lhsItmMode) <- {
        if(!isOpenListShape(RHS) or
                !hasConcreteLiteralListItems(aItem!.LHS_item!.pItem)){
            return(false)
        }
        if(aItem!.LHS_item!.pItem!.type==NULL and RHS!.type!=NULL){
            aItem!.LHS_item!.pItem!.type <- RHS!.type
        }
        if(aItem!.LHS_item!.pItem!.value!.listSpec==NULL and
                RHS!.value!.listSpec!=NULL){
            aItem!.LHS_item!.pItem!.value!.listSpec <- RHS!.value!.listSpec
        }
        if(aItem!.LHS_item!.pItem!.orderMode==uUnknown and
                RHS!.orderMode!=uUnknown){
            aItem!.LHS_item!.pItem!.orderMode <- RHS!.orderMode
        }
        if(lhsItmMode!=mNone){
            aItem!.LHS_item!.pItem!.itmMode <- lhsItmMode
        }
        return(true)
    }

    me void: preserveLHSSlotMetadata(our AItem: aItem,
            our WordUse: oldType, our infonView: oldListSpec,
            our infonView: RHS) <- {
        if(oldType!=NULL){aItem!.LHS_item!.pItem!.type <- oldType}
        // A selector's listSpec is only a request shape. If the RHS is already
        // a concrete typed list, preserve the real RHS listSpec.
        if(oldListSpec!=NULL and !hasConcreteListSpec(RHS)){
            aItem!.LHS_item!.pItem!.value!.listSpec <- oldListSpec
        }
    }

    me void: copyIdentity(their WorldManager: worldManager,
            our AItem: aItem) <- {
        our infonView: RHS <- aItem!.RHS!.pItem
        if(executeMappedWrite(worldManager, aItem)){return()}
        me bool: writeToSource <- isSourceBackedPOV(aItem!.LHS_item)
        our POV: mappedSourcePOV
        if(writeToSource){
            mappedSourcePOV <- mappedWriteSourcePOV(aItem!.LHS_item)
        }
        our infonView: target <- aItem!.LHS_item!.pItem
        if(mappedSourcePOV!=NULL and mappedSourcePOV!.pItem!=NULL){
            target <- mappedSourcePOV!.pItem
        }
        our WordUse: oldType <- target!.type
        our infonView: oldListSpec <- target!.value!.listSpec
        me uint64: lhsItmMode <- target!.itmMode

        if(mergeOpenListShapeIntoConcreteList(aItem, RHS, lhsItmMode)){
            return()
        }

        if(writeToSource){
            our MappedWritePair: scalarPair <- makeMappedWritePair(
                    aItem!.LHS_item, mappedSourcePOV, aItem!.RHS)
            commitMappedWritePair(scalarPair)
            if(!aItem!.RHS!.pItem!.isTentative){
                aItem!.LHS_item!.pItem!.isTentative <- false
            }
        }else{
            aItem!.LHS_item!.pItem <- aItem!.RHS!.pItem
            if(lhsItmMode!=mNone){
                aItem!.LHS_item!.pItem!.itmMode <- lhsItmMode
            }
        }

        preserveLHSSlotMetadata(aItem, oldType, oldListSpec, RHS)
    }
}

// Plans local consolidation cases whose complete outcome can be determined
// without scheduling or partial graph mutation.
struct DirectConsolidationStrategy{
    me ReferenceConsolidationStrategy: referenceConsolidationStrategy

    me int: evalForRange(our infonView: infn, their FlexNum: lowest,
            their FlexNum: highest) <- {
        if(infn!.value!.evalMode!=emConcat){
            if(infn!.value!.overlayType==NUM){
                if(infn!.infSize!.evalMode==emLiteral){
                    if(infn!.value!.evalMode==emLiteral){
                        lowest! <- infn!.value!.num
                        highest! <- lowest!
                    }
                    else if(infn!.value!.evalMode==emUnknown){
                        lowest! <- 0
                        highest! <- infn!.infSize!.num
                    }
                    else{return(1)}
                }
                else if(infn!.infSize!.evalMode==emUnknown){
                    if(infn!.value!.evalMode==emLiteral){
                        lowest! <- infn!.value!.num
                        highest! <- infn!.value!.num
                    }
                    else{return(1)}
                }
                else{return(1)}
            }
            else{logFatalError("    evalForRange:error")}
            return(3)
        }
        else if(infn!.value!.items.size()==2){
            our infonView: first <- infn!.value!.items.first()
            our infonView: secnd <- infn!.value!.items.last()
            if(first!.value!.overlayType==NUM and first!.value!.evalMode==emUnknown and
                    first!.infSize!.evalMode==emLiteral and
                    secnd!.value!.overlayType==NUM and secnd!.value!.evalMode==emLiteral and
                    secnd!.infSize!.evalMode==emUnknown and
                    secnd!.value!.sizeMode==fromContext){
                lowest! <- secnd!.value!.num
                highest! <- lowest! + first!.infSize!.num
            }
            return(3)
        }
        return(1)
    }

    void: resetNumRange(our infonView: infn, their FlexNum: lowest,
            their FlexNum: highest) <- {
        if(infn!.value!.evalMode!=emConcat){
            logFatalError("TODO: handle non-concat in resetNumRange")
        }
        if(infn!.value!.items.size()==2){
            our infonView: first <- infn!.value!.items.first()
            our infonView: secnd <- infn!.value!.items.last()
            if(first!.value!.overlayType==NUM and
                    first!.value!.evalMode==emUnknown and
                    first!.infSize!.evalMode==emLiteral and
                    secnd!.value!.overlayType==NUM and
                    secnd!.value!.evalMode==emLiteral and
                    secnd!.infSize!.evalMode==emUnknown and
                    secnd!.value!.sizeMode==fromContext){
                secnd!.value!.num <- lowest!
                first!.infSize!.num <- highest! - lowest!
            }
        }
    }

    me bool: mergeANDRanges(our AItem: aItem) <- {
        me FlexNum: lowestLHS
        me FlexNum: highestLHS
        me FlexNum: lowestRHS
        me FlexNum: highestRHS
        our infonView: LHSInfon <- aItem!.LHS_item!.pItem
        me int: rangeResultLHS <- evalForRange(
                LHSInfon, lowestLHS, highestLHS)
        if(rangeResultLHS!=pass){return(true)}
        me int: rangeResultRHS <- evalForRange(
                aItem!.RHS!.pItem, lowestRHS, highestRHS)
        if(rangeResultRHS!=pass){return(true)}
        me FlexNum: lowestNew <- max(lowestLHS, lowestRHS)
        me FlexNum: highestNew <- min(highestLHS, highestRHS)
        resetNumRange(LHSInfon, lowestNew, highestNew)
        return(false)
    }

    me int: matchLength(me string: left, me string: right) <- {
        me int: lastChar <- min(left.size(), right.size())
        if(lastChar==0){return(0)}
        withEach pos in range 0 .. lastChar{
            if(left[pos]!=right[pos]){return(pos-1)}
        }
        return(lastChar)
    }

    our POV: mergeLooseStrings(our AItem: aItem) <- {
        our infonView: LHS <- aItem!.LHS_item!.pItem
        our infonView: RHS <- aItem!.RHS!.pItem
        me int64: sizeDiff
        me int64: RSize <- RHS!.value!.str.size()
        me int64: LSize
        if(LHS!.value!.evalMode==emUnknown){
            if(LHS!.infSize!.evalMode==emUnknown){
                sizeDiff <- 0
                LHS!.value!.evalMode <- emLiteral
                LHS!.value!.str <- RHS!.value!.str
                LHS!.value!.sizeMode <- fromGiven
            }else if(LHS!.infSize!.evalMode==emLiteral){
                LSize <- LHS!.infSize!.num.convertToFloat()
                sizeDiff <- RSize - LSize
                LHS!.value!.evalMode <- emLiteral
                LHS!.value!.str <- RHS!.value!.str.subStr(0, LSize)
                LHS!.value!.sizeMode <- fromCount
            }
        }else{
            LSize <- LHS!.value!.str.size()
            me int: matchLen <- matchLength(
                    LHS!.value!.str, RHS!.value!.str)
            me bool: matchFailed
            if(matchLen==-1 or (matchLen<LSize and matchLen<RSize)){
                matchFailed <- true
                aItem!.mergeStatus <- msReject
                aItem!.LHS_item!.rejected <- true
            }else{
                sizeDiff <- RSize - LSize
                matchFailed <- false
            }
        }
        if(sizeDiff>0){
            me string: remainderStr <- RHS!.value!.str.subStr(
                    convertToIntVal(RSize-sizeDiff), convertToIntVal(sizeDiff))
            our infonView: remainderInfon
            Allocate(remainderInfon,remainderStr)
            our POV:: remainder{21}
            remainder! <- aItem!.RHS!
            remainder!.pItem <- remainderInfon
            aItem!.sizeToCopy <- RSize - sizeDiff
            return(remainder)
        }else if(sizeDiff==0){
            aItem!.sizeToCopy <- RSize
        }
        return(NULL)
    }

    // Extract the positive numeric set denoted by a fully constrained numeric
    // template. This deliberately excludes a bare unknown such as `_`: under
    // template-style negation it contributes no negative constraint.
    me bool: knownNumericTemplateBounds(our infonView: infn,
            their FlexNum: lowest, their FlexNum: highest) <- {
        if(infn==NULL){return(false)}
        if(infn!.value!.evalMode!=emConcat){
            if(infn!.value!.overlayType!=NUM){return(false)}
            if(infn!.infSize!.evalMode==emLiteral){
                if(infn!.value!.evalMode==emLiteral){
                    lowest! <- infn!.value!.num
                    highest! <- lowest!
                    return(true)
                }
                if(infn!.value!.evalMode==emUnknown){
                    lowest! <- 0
                    highest! <- infn!.infSize!.num
                    return(true)
                }
                return(false)
            }
            if(infn!.infSize!.evalMode==emUnknown and
                    infn!.value!.evalMode==emLiteral){
                lowest! <- infn!.value!.num
                highest! <- lowest!
                return(true)
            }
            return(false)
        }
        if(infn!.value!.items.size()!=2){return(false)}
        our infonView: first <- infn!.value!.items.first()
        our infonView: secnd <- infn!.value!.items.last()
        if(first!.value!.overlayType!=NUM or first!.value!.evalMode!=emUnknown or
                first!.infSize!.evalMode!=emLiteral or
                secnd!.value!.overlayType!=NUM or secnd!.value!.evalMode!=emLiteral or
                secnd!.infSize!.evalMode!=emUnknown or
                secnd!.value!.sizeMode!=fromContext){return(false)}
        lowest! <- secnd!.value!.num
        highest! <- lowest! + first!.infSize!.num
        return(true)
    }

    me bool: equivalentNumericTemplates(our infonView: LHS,
            our infonView: RHS) <- {
        if(LHS==NULL or RHS==NULL or LHS!.getTypeStr()!=RHS!.getTypeStr()){
            return(false)
        }
        me bool: lhsIsConcat <- LHS!.value!.evalMode==emConcat
        me bool: rhsIsConcat <- RHS!.value!.evalMode==emConcat
        if(lhsIsConcat!=rhsIsConcat){return(false)}
        if(!lhsIsConcat){
            if(LHS!.value!.overlayType!=NUM or RHS!.value!.overlayType!=NUM or
                    LHS!.value!.evalMode!=RHS!.value!.evalMode or
                    LHS!.infSize!.evalMode!=RHS!.infSize!.evalMode){
                return(false)
            }
            if(LHS!.value!.evalMode==emLiteral){
                if(LHS!.value!.num!=RHS!.value!.num){return(false)}
            }else if(LHS!.value!.evalMode!=emUnknown){return(false)}
            if(LHS!.infSize!.evalMode==emLiteral){
                if(LHS!.infSize!.num!=RHS!.infSize!.num){return(false)}
            }else if(LHS!.infSize!.evalMode!=emUnknown){return(false)}
            // A bare numeric unknown is an unconstrained template, so its
            // polarity does not establish an equality or contradiction.
            return(LHS!.value!.evalMode!=emUnknown or
                    LHS!.infSize!.evalMode!=emUnknown)
        }
        me FlexNum: lowestLHS
        me FlexNum: highestLHS
        me FlexNum: lowestRHS
        me FlexNum: highestRHS
        if(!knownNumericTemplateBounds(LHS, lowestLHS, highestLHS) or
                !knownNumericTemplateBounds(RHS, lowestRHS, highestRHS)){
            return(false)
        }
        return(lowestLHS==lowestRHS and highestLHS==highestRHS)
    }

    me bool: checkNumRange(our infonView: LHS, our infonView: RHS) <- {
        me FlexNum: lowestLHS
        me FlexNum: highestLHS
        me FlexNum: lowestRHS
        me FlexNum: highestRHS
        me int: rangeResultLHS <- evalForRange(LHS, lowestLHS, highestLHS)
        if(rangeResultLHS!=pass){return(true)}
        me int: rangeResultRHS <- evalForRange(RHS, lowestRHS, highestRHS)
        if(rangeResultRHS==pass){
            return(lowestLHS <= lowestRHS and highestLHS > highestRHS)
        }
        return(true)
    }

    me bool: looseStringPrefixesAreCompatible(me string: LHS, me string: RHS) <- {
        me int64: prefixSize <- min(LHS.size(), RHS.size())
        withEach pos in range 0 .. prefixSize{
            if(LHS[pos]!=RHS[pos]){return(false)}
        }
        return(true)
    }

    me bool: shouldCopySize(our AItem: aItem, our infonView: LHS,
            our infonView: RHS) <- {
        return(!aItem!.looseSize and
                LHS!.infSize!.evalMode==emUnknown and RHS!.infSize!.evalMode==emLiteral and
                (LHS!.viewMode!=vmOverlay or RHS!.value!.overlayType==LHS!.value!.overlayType) and
                (LHS!.value!.listSpec==NULL or !LHS!.value!.listSpec!.asWrkLstOutr))
    }

    me InfonViewReasoningResult: planConsolidation(our AItem: aItem) <- {
        me InfonViewReasoningResult: result
        result.status <- rrNotApplicable
        result.directCase <- dcNone
        result.listCase <- lcNone
        result.intersectionCase <- icNone
        result.orderedSpanCase <- ocNone
        result.referenceCase <- rcNone
        result.consolidationAction <- caNone
        result.workAction <- waNone
        result.actionCommitPolicy <- cpNonInvertedAcceptance
        result.copySize <- false
        result.emitRejectLog <- false
        if(aItem==NULL or aItem!.LHS_item==NULL or aItem!.LHS_item!.pItem==NULL or
                aItem!.RHS==NULL or aItem!.RHS!.pItem==NULL){return(result)}

        our infonView: LHS <- aItem!.LHS_item!.pItem
        our infonView: RHS <- aItem!.RHS!.pItem
        // An unconstrained strict any takes the candidate's graph identity.
        // A tentative complemented traversal node also needs that positive
        // match materialized before local inversion rejects it, so nested path
        // traversal can continue through the candidate graph.
        if(LHS!.viewMode==vmAny and !aItem!.RHS!.looseType() and
                (RHS!.value!.overlayType==NUM or RHS!.value!.overlayType==STR or
                 RHS!.value!.overlayType==LST) and
                (!LHS!.invertMatch or LHS!.isTentative) and !RHS!.invertMatch){
            result.directCase <- dcStrictAnyCopiesIdentity
            result.status <- rrPlannedChange
            result.consolidationAction <- caCopyRHSIdentityToLHS
            if(LHS!.invertMatch){
                result.actionCommitPolicy <- cpPositiveTemplateAcceptance
            }
            result.copySize <- shouldCopySize(aItem, LHS, RHS)
            return(result)
        }
        if(LHS!.viewMode==vmAny and aItem!.RHS!.looseType() and
                (RHS!.value!.overlayType==NUM or RHS!.value!.overlayType==STR or
                 RHS!.value!.overlayType==LST) and
                !LHS!.invertMatch and !RHS!.invertMatch){
            result.directCase <- dcLooseAnyCopiesValue
            result.status <- rrPlannedChange
            result.consolidationAction <- caCopyRHSValueAndTypeToLHS
            result.copySize <- shouldCopySize(aItem, LHS, RHS)
            return(result)
        }
        // Strict scalar unknowns either acquire reference identity, inherit the
        // candidate's pending constraints, or need no local state change. A
        // one-sided complement is local only when neither of the mutating
        // alternatives applies; combining two complements remains deferred.
        if((LHS!.value!.overlayType==NUM or LHS!.value!.overlayType==STR) and
                LHS!.value!.evalMode==emUnknown and !aItem!.RHS!.looseType() and
                RHS!.value!.overlayType==LHS!.value!.overlayType and
                RHS!.value!.evalMode==emUnknown and
                ((!LHS!.invertMatch and !RHS!.invertMatch) or
                 (LHS!.invertMatch!=RHS!.invertMatch and
                  aItem!.LHS_item!.accessMode!=aRefTo and RHS!.wrkList.isEmpty()))){
            if(aItem!.LHS_item!.accessMode==aRefTo){
                result.directCase <- dcScalarUnknownCopiesIdentity
                result.status <- rrPlannedChange
                result.consolidationAction <- caCopyRHSIdentityToLHS
            }
            else if(!RHS!.wrkList.isEmpty()){
                result.directCase <- dcScalarUnknownCopiesConstraints
                result.status <- rrPlannedChange
                result.consolidationAction <- caCopyRHSWorkListToLHS
            }
            else{
                result.directCase <- dcScalarUnknownWithoutConstraints
                result.status <- rrHandledNoChange
            }
            result.copySize <- shouldCopySize(aItem, LHS, RHS)
            return(result)
        }
        // Loose unknown scalars impose no local value constraint. Common size
        // handling still applies, but identity is deliberately not copied.
        if((LHS!.value!.overlayType==NUM or LHS!.value!.overlayType==STR) and
                LHS!.value!.evalMode==emUnknown and aItem!.RHS!.looseType() and
                RHS!.value!.overlayType==LHS!.value!.overlayType and
                RHS!.value!.evalMode==emUnknown and
                !RHS!.invertMatch){
            result.directCase <- dcLooseScalarUnknownWithoutConstraints
            result.status <- rrHandledNoChange
            result.copySize <- shouldCopySize(aItem, LHS, RHS)
            return(result)
        }
        if(LHS!.viewMode==vmAny or RHS!.viewMode==vmAny){return(result)}
        // A self-outer aRefTo carries graph identity semantics that must be
        // resolved before comparing its current local value.
        if(referenceConsolidationStrategy.identityTakesPriority(aItem)){return(result)}

        // Equal positive numeric templates have a complete polarity relation.
        // Same polarity is idempotent; opposite polarity is contradictory.
        // This is equality of represented numeric sets, not graph identity.
        if(!aItem!.RHS!.looseType() and !RHS!.asRHSInternalIdent and
                (LHS!.invertMatch or RHS!.invertMatch) and
                equivalentNumericTemplates(LHS, RHS)){
            result.directCase <- dcEquivalentNumericTemplatePolarity
            result.statusIncludesPolarity <- true
            if(LHS!.invertMatch==RHS!.invertMatch){
                result.status <- rrHandledNoChange
                result.constraintDisposition <- cdRedundant
            }else{
                result.status <- rrRejected
                result.constraintDisposition <- cdContradiction
            }
            return(result)
        }
        // A concrete field in a negative template cannot yet be decided
        // against the corresponding unknown candidate field. Likewise, two
        // non-equivalent negative templates need a future conjunction model.
        // Keep the original semantic obligation on wrkList for a later pass.
        if(!aItem!.RHS!.looseType() and !RHS!.asRHSInternalIdent and
                LHS!.value!.overlayType==NUM and RHS!.value!.overlayType==NUM and
                (LHS!.invertMatch or RHS!.invertMatch) and
                ((LHS!.invertMatch and RHS!.invertMatch) or
                 (LHS!.invertMatch and !RHS!.invertMatch and
                  ((LHS!.value!.evalMode==emLiteral and RHS!.value!.evalMode==emUnknown) or
                   (LHS!.infSize!.evalMode==emLiteral and RHS!.infSize!.evalMode==emUnknown))) or
                 (RHS!.invertMatch and !LHS!.invertMatch and
                  ((RHS!.value!.evalMode==emLiteral and LHS!.value!.evalMode==emUnknown) or
                   (RHS!.infSize!.evalMode==emLiteral and LHS!.infSize!.evalMode==emUnknown))))){
            result.directCase <- dcUnresolvedNumericTemplatePolarity
            result.status <- rrHandledNoChange
            result.constraintDisposition <- cdRetained
            result.statusIncludesPolarity <- true
            return(result)
        }

        if(!aItem!.RHS!.looseType() and LHS!.value!.evalMode==emUnknown and
                RHS!.value!.evalMode==emLiteral and
                LHS!.value!.overlayType==RHS!.value!.overlayType and
                (LHS!.value!.overlayType==NUM or LHS!.value!.overlayType==STR)){
            result.directCase <- dcCopyLiteralValueToUnknown
            result.status <- rrPlannedChange
            result.consolidationAction <- caCopyRHSValueToLHS
        }
        else if(!aItem!.RHS!.looseType() and LHS!.value!.evalMode==emLiteral and
                RHS!.value!.evalMode==emUnknown and
                LHS!.value!.overlayType==RHS!.value!.overlayType and
                (LHS!.value!.overlayType==NUM or LHS!.value!.overlayType==STR)){
            result.directCase <- dcLiteralAlreadyConstrainsUnknown
            result.status <- rrHandledNoChange
        }
        else if(LHS!.value!.overlayType==NUM and LHS!.value!.evalMode==emLiteral and
                !aItem!.RHS!.looseType() and
                RHS!.value!.overlayType==NUM and RHS!.value!.evalMode==emLiteral){
            result.directCase <- dcNumLiteralStrictEquality
            if(LHS!.value!.num==RHS!.value!.num){result.status <- rrHandledNoChange}
            else{
                result.status <- rrRejected
                result.emitRejectLog <- true
            }
        }
        else if(LHS!.value!.overlayType==STR and LHS!.value!.evalMode==emLiteral and
                !aItem!.RHS!.looseType() and
                RHS!.value!.overlayType==STR and RHS!.value!.evalMode==emLiteral){
            result.directCase <- dcStringLiteralStrictEquality
            if(LHS!.value!.str==RHS!.value!.str){result.status <- rrHandledNoChange}
            else{result.status <- rrRejected}
        }
        else if(!aItem!.RHS!.looseType() and
                ((LHS!.value!.overlayType==NUM and
                  (RHS!.value!.overlayType==STR or RHS!.value!.overlayType==LST) and
                  (RHS!.value!.evalMode==emUnknown or RHS!.value!.evalMode==emLiteral)) or
                 (LHS!.value!.overlayType==STR and
                  (RHS!.value!.overlayType==NUM or RHS!.value!.overlayType==LST)) or
                 (LHS!.value!.overlayType==LST and
                  (LHS!.value!.evalMode==emUnknown or LHS!.value!.evalMode==emLiteral) and
                  (RHS!.value!.overlayType==NUM or RHS!.value!.overlayType==STR)))){
            result.directCase <- dcStrictOverlayTypeMismatch
            result.status <- rrRejected
        }
        // A complemented range is evaluated as the ordinary positive range,
        // but its tentative result is populated only when the final, inverted
        // decision accepts. RHS inversion remains deferred because combining
        // two negative constraints needs an explicit constraint model.
        else if(LHS!.value!.overlayType==NUM and LHS!.value!.evalMode==emUnknown and
                aItem!.RHS!.looseType() and
                RHS!.value!.overlayType==NUM and RHS!.value!.evalMode==emLiteral and
                !RHS!.invertMatch){
            result.directCase <- dcLooseNumericRangeLiteral
            result.consolidationAction <- caCopyRHSRangeMatchToLHS
            if(LHS!.invertMatch){result.actionCommitPolicy <- cpFinalAcceptance}
            if(checkNumRange(LHS, RHS)){
                result.status <- rrPlannedChange
            }
            else{
                result.status <- rrRejected
                result.emitRejectLog <- true
            }
        }
        else if(!RHS!.invertMatch and
                (((LHS!.value!.overlayType==NUM or LHS!.value!.overlayType==LST) and
                  LHS!.value!.evalMode==emConcat and
                  RHS!.value!.overlayType==NUM and RHS!.value!.evalMode==emLiteral) or
                 (LHS!.value!.overlayType==NUM and LHS!.value!.evalMode==emUnknown and
                  aItem!.RHS!.looseType() and RHS!.value!.overlayType==LST and
                  RHS!.value!.evalMode==emConcat))){
            result.directCase <- dcNumericRangeDeepCopy
            result.consolidationAction <- caCopyRHSInfonToLHS
            if(LHS!.invertMatch){result.actionCommitPolicy <- cpFinalAcceptance}
            if(checkNumRange(LHS, RHS)){
                result.status <- rrPlannedChange
            }
            else{
                result.status <- rrRejected
                result.emitRejectLog <- true
            }
        }
        else if(LHS!.value!.overlayType==LST and LHS!.value!.evalMode==emConcat and
                !aItem!.RHS!.looseType() and
                RHS!.value!.overlayType==LST and RHS!.value!.evalMode==emConcat and
                !LHS!.invertMatch and !RHS!.invertMatch){
            result.directCase <- dcConcatRangeIntersection
            result.status <- rrPlannedChange
            result.consolidationAction <- caMergeANDRanges
        }
        // Loose string prefixes can return a remainder that must be scheduled by
        // the agenda. Only take cases where both sides consume the same width.
        // Unequal widths and inverted templates retain the generated behavior.
        else if(LHS!.value!.overlayType==STR and LHS!.value!.evalMode==emUnknown and
                aItem!.RHS!.looseType() and
                RHS!.value!.overlayType==STR and RHS!.value!.evalMode==emLiteral and
                (LHS!.infSize!.evalMode==emUnknown or
                 (LHS!.infSize!.evalMode==emLiteral and
                  LHS!.infSize!.num.convertToFloat()==RHS!.value!.str.size())) and
                !LHS!.invertMatch and !RHS!.invertMatch){
            result.directCase <- dcLooseStringWholeCopy
            result.status <- rrPlannedChange
            result.consolidationAction <- caCopyRHSWholeStringToLHS
        }
        else if(LHS!.value!.overlayType==STR and LHS!.value!.evalMode==emLiteral and
                aItem!.RHS!.looseType() and
                RHS!.value!.overlayType==STR and RHS!.value!.evalMode==emLiteral and
                LHS!.value!.str.size()==RHS!.value!.str.size() and
                !LHS!.invertMatch and !RHS!.invertMatch){
            result.directCase <- dcLooseStringExactLiteral
            if(LHS!.value!.str==RHS!.value!.str){result.status <- rrHandledNoChange}
            else{result.status <- rrRejected}
        }
        else if(LHS!.value!.overlayType==STR and
                (LHS!.value!.evalMode==emUnknown or LHS!.value!.evalMode==emLiteral) and
                aItem!.RHS!.looseType() and
                RHS!.value!.overlayType==STR and RHS!.value!.evalMode==emLiteral and
                !LHS!.invertMatch and !RHS!.invertMatch){
            result.directCase <- dcLooseStringRemainder
            if(LHS!.value!.evalMode==emLiteral and
                    !looseStringPrefixesAreCompatible(LHS!.value!.str, RHS!.value!.str)){
                result.status <- rrRejected
            }
            else{
                result.status <- rrPlannedChange
                result.consolidationAction <- caMergeLooseStrings
            }
        }
        if(result.directCase!=dcNone and shouldCopySize(aItem, LHS, RHS)){
            result.copySize <- true
        }
        return(result)
    }
}

// Owns local concat normalization after its members have been normalized by
// the agenda. This layer joins adjacent literal fragments and collapses a
// single remaining fragment without making scheduling decisions.
struct ConcatReasoner{
    me bool: joinOnRight(our infonView: LHS, our infonView: RHS) <- {
        if(LHS!.value!.evalMode==emLiteral and RHS!.value!.evalMode==emLiteral){
            me int: LHSType <- LHS!.value!.overlayType
            if(LHSType == RHS!.value!.overlayType){
                switch(LHSType){
                    case NUM: {
                        if(RHS!.value!.sizeMode==fromContext){
                            LHS!.value!.num <+- RHS!.value!.num
                        }else{
                            LHS!.infSize!.num <- LHS!.infSize!.num * RHS!.infSize!.num
                            LHS!.value!.num <- (LHS!.value!.num * RHS!.infSize!.num) + RHS!.value!.num
                        }
                    }
                    case STR: {
                        LHS!.value!.str.append(RHS!.value!.str)
                        LHS!.infSize!.num <- LHS!.value!.str.size()
                    }
                    case LST: {
                        our POV: povElement <- RHS!.value!.items.head
                        while(povElement != NULL){
                            our infonView: pItemElement <- povElement!.pItem
                            LHS!.value!.items.append(pItemElement,
                                    povElement!.isSubItm, 12)
                            povElement <- povElement!.next
                        }
                    }
                    default: {return(false)}
                }
            }
            return(true)
        }
        return(false)
    }

    me bool: collapseSingletonConcat(our infonView: infn) <- {
        me bool: changeMade <- false
        while(infn!.value!.evalMode==emConcat and
                !infn!.value!.items.isEmpty() and
                infn!.value!.items.head!.isLast()){
            if(infn!.infSize!.evalMode!=emUnknown){
                infn!.value! <- infn!.value!.items.first()!.value!
                infn!.value!.sizeMode <- fromGiven
            }else{
                infn! <- infn!.value!.items.first()!
            }
            changeMade <- true
        }
        return(changeMade)
    }

    me bool: joinIfConcat(our POV: pov) <- {
        me bool: changeMade <- false
        if(pov!.pParent!=NULL and
                pov!.pParent!.pItem!.value!.evalMode==emConcat){
            if(!pov!.isFirst()){
                our POV: prev <- pov!.prev
                if(prev!=NULL and joinOnRight(prev!.pItem, pov!.pItem)){
                    pov!.pParent!.pItem!.value!.items.erase(pov)
                    changeMade <- true
                }
            }
            our infonView: parentInfonView <- pov!.pParent!.pItem
            if(collapseSingletonConcat(parentInfonView)){changeMade <- true}
        }
        return(changeMade)
    }

    me bool: processConcat(our AItem: aItem) <- {
        me bool: changeMade <- false
        if(aItem!.concatProcessed){return(changeMade)}
        aItem!.concatProcessed <- true
        if(joinIfConcat(aItem!.LHS_item)){changeMade <- true}
        return(changeMade)
    }
}

// T-LIST IDENTITY INVENTORY
//
// `timelike` is semantic compression: setting it implies identities in
// addition to ordinary ordered-list identities.  Keep those implications
// named here so extending T semantics is an explicit two-part change:
// change the model field, then enumerate/implement its identity consequences.
//
// Implemented:
//   1. list-context identity
//      LHS = RHS(T)  =>  LHS is interpreted in the same T-context.
//
// Present in lower-level cursor/list machinery, but not yet represented as
// generated semantic identities:
//   2. current.%prev = previous structural item in an ordered list;
//   3. current.%next = next structural item in an ordered list;
//
// Implemented as explicit identity or reversible-projection implications:
//   4. L.begin and L.end are identity-bearing views of cuts in L.  Both have
//      the algebraic null value, but boundaries at different cuts remain
//      distinct; an unknown L.end remains a symbolic end-relative boundary;
//   5. adjacent T-spans imply preceding.end = following.begin.  The stored
//      relation contains those actual boundary views, not merely the spans;
//   6. current.%tprev/current.%tnext is identified with the occurrence proved
//      by local adjacency or one of those boundary identities.  Both
//      directions use the same stored relation, even when cursor evaluation
//      materializes the selected value directly.  Temporal navigation never
//      falls back to an S-list.
//   9. a whole-interval nested T-list's entry and exit are identical to its
//      host entry and exit.  The host exit can then reach the enclosing
//      continuation through item 5's ordinary end=begin identity.
//  12. item.asTList is a reversible item <-> temporal-view projection.  If
//      item is already a T-list the two POVs are strictly identical.  For any
//      other item, the projection relation remains distinct from identity and
//      initially has an open, given-unknown extent; component and rooting
//      identities may refine it without enumerating an entire lifetime.
//  13. every contiguous ordered-span view of a T-list is also a T-list.  Its
//      ViewMap retains the source context and first source occurrence, so
//      `.begin` and `.end` remain temporal cuts instead of ordinary fields.
//  14. an accepted, positive equality between two temporal-boundary POVs
//      records those exact cuts as identical.  Equal algebraic zero values
//      without boundary provenance never imply this identity.
//  15. L.cut creates one lazy split L = prefix + suffix.  It records
//      L.begin = prefix.begin, prefix.end = suffix.begin, and
//      suffix.end = L.end.  The middle boundary is the returned symbolic cut.
//      Neither witness span is enumerated, and repeated `.cut` expressions
//      remain distinct until another identity proves them equal.  Later
//      boundary evidence is added only through resolveTemporalSplit(), which
//      rejects L.begin/L.end for a strict-interior cut and conflicting known
//      coordinates in the same source span.
//  16. when an accepted boundary identity aligns an exact item's asTList view
//      with a cut in a parent T-span, a TemporalRootingReference retains the
//      child occurrence, parent span, and the ordinary identity evidence.
//      Re-evaluating the generic item type never substitutes for that exact
//      occurrence reference.
//
// Not yet implemented:
//   7. a transition identity reads RHS references from its entry/previous
//      S-context and constrains its exit/next S-context;
//   8. each unchanged component of adjacent S-contexts is identical
//      (component-wise persistence, never whole-state identity);
//  10. each repeated T-description's exit is identical to the next
//      repetition's entry;
//  11. rooted containment identifies aligned parent/child temporal
//      occurrences while preserving distinct occurrence identity.
//
// Items 7-8 and 10-11 deliberately have no fallback mutation here.  Each must become a
// concrete identity-expansion plan with tests before it affects normalization.
struct GLOBAL{
    const int: tsrsInvalid          <- 0
    const int: tsrsAccepted         <- 1
    const int: tsrsAlreadyResolved  <- 2
    const int: tsrsEndpointRejected <- 3
    const int: tsrsConflictRejected <- 4
}

struct TemporalIdentityReasoner{
    me bool: isTemporalSpanPOV(their POV: pov) <- {
        return(pov!=NULL and pov!.pItem!=NULL and
                pov!.pItem!.value!.overlayType==LST and
                pov!.pItem!.value!.timelike)
    }

    me bool: temporalSpanHasKnownEnd(their POV: spanPOV) <- {
        if(!isTemporalSpanPOV(spanPOV)){return(false)}
        me EndRelativeExtentResult: extent <-
                spanPOV!.pItem!.endRelativeExtent()
        return(extent.status==eresExact)
    }

    our POV: makeOpenTemporalSplitSpan(their POV: sourceSpan) <- {
        if(!isTemporalSpanPOV(sourceSpan)){return(NULL)}
        our POV:: splitSpan{povSrcTemporalSplit}
        Allocate(splitSpan!.pItem)
        splitSpan!.pItem!.setToList()
        splitSpan!.pItem!.value!.timelike <- true
        splitSpan!.pItem!.value!.tailUnfinished <- true
        splitSpan!.pItem!.value!.sizeMode <- fromGiven
        splitSpan!.pItem!.infSize!.overlayType <- NUM
        splitSpan!.pItem!.infSize!.evalMode <- emUnknown
        splitSpan!.pItem!.originID <- sourceSpan!.pItem!.originID
        splitSpan!.pItem!.infCharPos <- sourceSpan!.pItem!.infCharPos
        splitSpan!.pParent <- sourceSpan!.pParent
        splitSpan!.accessMode <- aRefTo
        splitSpan!.bindIdentityRegistry(
                sourceSpan!.effectiveIdentityRegistry())
        return(splitSpan)
    }

    // A symbolic cut is represented by the end of one lazy span identified
    // with the beginning of the next.  The returned boundary therefore has a
    // unique source even when its coordinate is not known, and all inverse
    // inferences travel through ordinary IdentityRelation edges.
    our TemporalSplitReference: makeTemporalSplit(
            our POV: sourceSpan, me uint64: normalizationID) <- {
        if(!isTemporalSpanPOV(sourceSpan)){return(NULL)}
        their IdentityRegistry: registry <-
                sourceSpan!.effectiveIdentityRegistry()
        if(registry==NULL){return(NULL)}
        our POV: prefixSpan <- makeOpenTemporalSplitSpan(sourceSpan)
        our POV: suffixSpan <- makeOpenTemporalSplitSpan(sourceSpan)
        if(prefixSpan==NULL or suffixSpan==NULL){return(NULL)}

        our POV: sourceBegin <- makeTemporalBoundaryPOV(sourceSpan, false)
        our POV: prefixBegin <- makeTemporalBoundaryPOV(prefixSpan, false)
        our POV: symbolicCut <- makeTemporalBoundaryPOV(prefixSpan, true)
        our POV: suffixBegin <- makeTemporalBoundaryPOV(suffixSpan, false)
        our POV: suffixEnd <- makeTemporalBoundaryPOV(suffixSpan, true)
        our POV: sourceEnd <- makeTemporalBoundaryPOV(sourceSpan, true)
        return(registry!.recordTemporalSplit(
                sourceSpan, prefixSpan, suffixSpan,
                sourceBegin, prefixBegin, symbolicCut, suffixBegin,
                suffixEnd, sourceEnd, normalizationID))
    }

    // Make a concrete cut view without changing or materializing the source
    // T-list.  Begin and end retain their canonical endpoint representation;
    // an interior coordinate is a separate boundary POV in that same span.
    our POV: makeKnownTemporalBoundaryPOV(
            their POV: sourceSpan, me int64: cutIndex) <- {
        if(!isTemporalSpanPOV(sourceSpan) or cutIndex<0){return(NULL)}
        me EndRelativeExtentResult: extent <-
                sourceSpan!.pItem!.endRelativeExtent()
        if(extent.status==eresExact and cutIndex>extent.exactExtent){
            return(NULL)
        }
        if(cutIndex==0){return(makeTemporalBoundaryPOV(sourceSpan, false))}
        if(extent.status==eresExact and cutIndex==extent.exactExtent){
            return(makeTemporalBoundaryPOV(sourceSpan, true))
        }
        our POV: boundaryPOV <- makeTemporalBoundaryValuePOV(sourceSpan)
        if(boundaryPOV==NULL){return(NULL)}
        boundaryPOV!.temporalBoundary.cutIndexKnown <- true
        boundaryPOV!.temporalBoundary.cutIndex <- cutIndex
        return(boundaryPOV)
    }

    me bool: boundarySourcesShareCoordinates(their POV: first,
            their POV: second) <- {
        if(first==NULL or second==NULL or
                first!.temporalBoundary.sourcePov==NULL or
                second!.temporalBoundary.sourcePov==NULL){return(false)}
        if(first!.temporalBoundary.sourcePov===
                second!.temporalBoundary.sourcePov){return(true)}
        their POV: firstSource <- first!.temporalBoundary.sourcePov
        their POV: secondSource <- second!.temporalBoundary.sourcePov
        if(firstSource!.repetitionOccurrence!=NULL or
                secondSource!.repetitionOccurrence!=NULL){
            return(firstSource!.repetitionOccurrence!=NULL and
                    firstSource!.repetitionOccurrence===
                            secondSource!.repetitionOccurrence)
        }
        return(firstSource!.pItem!=NULL and
                firstSource!.pItem===secondSource!.pItem and
                firstSource!.pParent===secondSource!.pParent)
    }

    me bool: boundariesHaveSameKnownCoordinate(their POV: first,
            their POV: second) <- {
        return(boundarySourcesShareCoordinates(first, second) and
                first!.temporalBoundary.cutIndexKnown and
                second!.temporalBoundary.cutIndexKnown and
                first!.temporalBoundary.cutIndex==
                        second!.temporalBoundary.cutIndex)
    }

    me bool: boundariesHaveConflictingKnownCoordinates(their POV: first,
            their POV: second) <- {
        return(boundarySourcesShareCoordinates(first, second) and
                first!.temporalBoundary.cutIndexKnown and
                second!.temporalBoundary.cutIndexKnown and
                first!.temporalBoundary.cutIndex!=
                        second!.temporalBoundary.cutIndex)
    }

    me int: temporalSplitResolutionStatus(
            their TemporalSplitReference: reference,
            our POV: candidateBoundary) <- {
        if(reference==NULL or candidateBoundary==NULL or
                reference!.symbolicCut==NULL or
                candidateBoundary!.temporalBoundary.sourcePov==NULL){
            return(tsrsInvalid)
        }
        their IdentityRegistry: registry <-
                reference!.symbolicCut!.effectiveIdentityRegistry()
        if(registry==NULL or candidateBoundary!.
                effectiveIdentityRegistry()!==registry){return(tsrsInvalid)}
        if(reference!.strictInterior and
                (registry!.areIdentical(
                        candidateBoundary, reference!.sourceBegin) or
                 registry!.areIdentical(
                        candidateBoundary, reference!.sourceEnd) or
                 sameTemporalBoundary(
                        candidateBoundary, reference!.sourceBegin) or
                 sameTemporalBoundary(
                        candidateBoundary, reference!.sourceEnd) or
                 boundariesHaveSameKnownCoordinate(
                        candidateBoundary, reference!.sourceBegin) or
                 boundariesHaveSameKnownCoordinate(
                        candidateBoundary, reference!.sourceEnd))){
            return(tsrsEndpointRejected)
        }
        if(registry!.areIdentical(
                reference!.symbolicCut, candidateBoundary)){
            return(tsrsAlreadyResolved)
        }
        withEach existingBoundary in reference!.resolutionBoundaries{
            if(registry!.areIdentical(existingBoundary, candidateBoundary) or
                    sameTemporalBoundary(
                            existingBoundary, candidateBoundary) or
                    boundariesHaveSameKnownCoordinate(
                            existingBoundary, candidateBoundary)){
                return(tsrsAlreadyResolved)
            }
            if(boundariesHaveConflictingKnownCoordinates(
                    existingBoundary, candidateBoundary)){
                return(tsrsConflictRejected)
            }
        }
        return(tsrsAccepted)
    }

    me bool: temporalSplitResolutionsConflict(
            their TemporalSplitReference: first,
            their TemporalSplitReference: second) <- {
        if(first==NULL or second==NULL){return(false)}
        withEach firstBoundary in first!.resolutionBoundaries{
            withEach secondBoundary in second!.resolutionBoundaries{
                if(boundariesHaveConflictingKnownCoordinates(
                        firstBoundary, secondBoundary)){
                    return(true)
                }
            }
        }
        return(false)
    }

    void: retainTemporalSplitResolution(
            their TemporalSplitReference: reference,
            our POV: candidateBoundary,
            our IdentityRelation: identity) <- {
        if(reference==NULL or candidateBoundary==NULL){return()}
        me bool: boundaryAlreadyRetained <- false
        withEach existingBoundary in reference!.resolutionBoundaries{
            if(existingBoundary===candidateBoundary){
                boundaryAlreadyRetained <- true
                break()
            }
        }
        if(!boundaryAlreadyRetained){
            reference!.resolutionBoundaries.append(candidateBoundary)
        }
        if(identity==NULL){return()}
        withEach existingIdentity in
                reference!.resolutionIdentityRelations{
            if(existingIdentity===identity){return()}
        }
        reference!.resolutionIdentityRelations.append(identity)
    }

    // This is the single mutation point for refining a symbolic split.  The
    // caller supplies a boundary established by an assertion or theorem; the
    // registry stores the equality used for forward and inverse inference. If
    // the boundary is another symbolic cut, both splits are validated before
    // either is changed and both retain the same symmetric identity evidence.
    me int: resolveTemporalSplit(
            their TemporalSplitReference: reference,
            our POV: candidateBoundary,
            me IdentityEvidenceKind: evidenceKind,
            me uint64: normalizationID) <- {
        me int: status <-
                temporalSplitResolutionStatus(reference, candidateBoundary)
        if(status!=tsrsAccepted and status!=tsrsAlreadyResolved){
            return(status)
        }
        their TemporalSplitReference: candidateReference <-
                candidateBoundary!.temporalSplit.reference
        if(candidateReference===reference){
            candidateReference <- NULL
        }
        if(candidateReference!=NULL){
            me int: candidateStatus <- temporalSplitResolutionStatus(
                    candidateReference, reference!.symbolicCut)
            if(candidateStatus!=tsrsAccepted and
                    candidateStatus!=tsrsAlreadyResolved){
                return(candidateStatus)
            }
            if(temporalSplitResolutionsConflict(
                    reference, candidateReference)){
                return(tsrsConflictRejected)
            }
        }
        their IdentityRegistry: registry <-
                reference!.symbolicCut!.effectiveIdentityRegistry()
        our IdentityRelation: identity <- registry!.recordIdentity(
                reference!.symbolicCut, candidateBoundary,
                evidenceKind, normalizationID)
        retainTemporalSplitResolution(
                reference, candidateBoundary, identity)
        if(candidateReference!=NULL){
            retainTemporalSplitResolution(
                    candidateReference, reference!.symbolicCut, identity)
        }
        return(status)
    }

    me bool: temporalBoundaryAssertionCanBeAccepted(
            our POV: leftBoundary, our POV: rightBoundary) <- {
        if(leftBoundary==NULL or rightBoundary==NULL or
                leftBoundary!.temporalBoundary.sourcePov==NULL or
                rightBoundary!.temporalBoundary.sourcePov==NULL){return(true)}
        their TemporalSplitReference: leftReference <-
                leftBoundary!.temporalSplit.reference
        their TemporalSplitReference: rightReference <-
                rightBoundary!.temporalSplit.reference
        if(leftReference!=NULL){
            me int: leftStatus <-
                    temporalSplitResolutionStatus(
                            leftReference, rightBoundary)
            if(leftStatus==tsrsEndpointRejected or
                    leftStatus==tsrsConflictRejected or
                    leftStatus==tsrsInvalid){return(false)}
        }
        if(rightReference!=NULL){
            me int: rightStatus <-
                    temporalSplitResolutionStatus(
                            rightReference, leftBoundary)
            if(rightStatus==tsrsEndpointRejected or
                    rightStatus==tsrsConflictRejected or
                    rightStatus==tsrsInvalid){return(false)}
        }
        if(leftReference!=NULL and rightReference!=NULL and
                leftReference!==rightReference and
                temporalSplitResolutionsConflict(
                        leftReference, rightReference)){
            return(false)
        }
        return(true)
    }

    void: recordTemporalRootingFromBoundaryIdentity(
            their TemporalSplitReference: parentSplit,
            our POV: childBoundary,
            me IdentityEvidenceKind: evidenceKind,
            me uint64: normalizationID) <- {
        if(parentSplit==NULL or parentSplit!.symbolicCut==NULL or
                childBoundary==NULL or
                childBoundary!.temporalBoundary.sourcePov==NULL){return()}
        their POV: childProjectionPOV <-
                childBoundary!.temporalBoundary.sourcePov
        their TemporalProjectionReference: childProjection <-
                childProjectionPOV!.temporalProjection.reference
        if(childProjection==NULL or
                !childProjectionPOV!.temporalProjection.isProjection or
                childProjection!.projectionPOV!==childProjectionPOV or
                childProjection!.sourcePOV==NULL){return()}
        their IdentityRegistry: registry <-
                parentSplit!.symbolicCut!.effectiveIdentityRegistry()
        if(registry==NULL or childBoundary!.
                effectiveIdentityRegistry()!==registry){return()}
        our IdentityRelation: boundaryIdentity <- registry!.recordIdentity(
                parentSplit!.symbolicCut, childBoundary,
                evidenceKind, normalizationID)
        if(boundaryIdentity==NULL){return()}
        registry!.recordTemporalRooting(
                childProjection, childBoundary,
                parentSplit, parentSplit!.symbolicCut,
                boundaryIdentity, normalizationID)
    }

    // Merge acceptance is the proof point for a written boundary equality.
    // Store the POV identity here instead of relying on the merge's value
    // copying: both boundaries stringify as zero, but their cut provenance is
    // the semantic information needed for inverse inference.
    void: recordAcceptedBoundaryAssertionIdentity(our AItem: aItem) <- {
        if(aItem==NULL or aItem!.mergeStatus!=msAccept or
                aItem!.LHS_item==NULL or aItem!.RHS==NULL or
                aItem!.LHS_item!.temporalBoundary.sourcePov==NULL or
                aItem!.RHS!.temporalBoundary.sourcePov==NULL or
                aItem!.LHS_item!.applyAsNot(aItem!.RHS)){return()}
        their IdentityRegistry: lhsRegistry <-
                aItem!.LHS_item!.effectiveIdentityRegistry()
        their IdentityRegistry: rhsRegistry <-
                aItem!.RHS!.effectiveIdentityRegistry()
        if(lhsRegistry==NULL or rhsRegistry==NULL or
                lhsRegistry!==rhsRegistry){return()}
        their TemporalSplitReference: lhsSplit <-
                aItem!.LHS_item!.temporalSplit.reference
        their TemporalSplitReference: rhsSplit <-
                aItem!.RHS!.temporalSplit.reference
        if(lhsSplit!=NULL){
            me int: lhsStatus <- resolveTemporalSplit(
                    lhsSplit, aItem!.RHS, iekAssertion, 0)
            if(lhsStatus==tsrsAccepted or
                    lhsStatus==tsrsAlreadyResolved){
                recordTemporalRootingFromBoundaryIdentity(
                        lhsSplit, aItem!.RHS, iekAssertion, 0)
            }
        }
        if(rhsSplit!=NULL){
            me int: rhsStatus <- resolveTemporalSplit(
                    rhsSplit, aItem!.LHS_item, iekAssertion, 0)
            if(rhsStatus==tsrsAccepted or
                    rhsStatus==tsrsAlreadyResolved){
                recordTemporalRootingFromBoundaryIdentity(
                        rhsSplit, aItem!.LHS_item, iekAssertion, 0)
            }
        }
        if(lhsSplit==NULL and rhsSplit==NULL){
            lhsRegistry!.recordIdentity(
                    aItem!.LHS_item, aItem!.RHS, iekAssertion, 0)
        }
    }

    // A boundary's value is the unique null state.  Its identity lives on the
    // POV map below, so equal zero values at different cuts never collapse the
    // cuts themselves.
    our POV: makeTemporalBoundaryPOV(their POV: sourceSpan,
            me bool: tracksEnd) <- {
        if(!isTemporalSpanPOV(sourceSpan)){return(NULL)}
        their POV: stableSource <- sourceSpan
        their TemporalProjectionReference: projectionReference <-
                sourceSpan!.temporalProjection.reference
        if(projectionReference!=NULL and
                sourceSpan!.temporalProjection.isProjection and
                projectionReference!.projectionPOV!=NULL){
            stableSource <- projectionReference!.projectionPOV
            our POV: existingBoundary <- projectionReference!.beginBoundary
            if(tracksEnd){existingBoundary <- projectionReference!.endBoundary}
            if(existingBoundary!=NULL){
                if(tracksEnd){
                    me EndRelativeExtentResult: currentExtent <-
                            stableSource!.pItem!.endRelativeExtent()
                    existingBoundary!.temporalBoundary.cutIndexKnown <- false
                    existingBoundary!.temporalBoundary.cutIndex <- -1
                    if(currentExtent.status==eresExact){
                        existingBoundary!.temporalBoundary.cutIndexKnown <- true
                        existingBoundary!.temporalBoundary.cutIndex <-
                                currentExtent.exactExtent
                    }
                }
                return(existingBoundary)
            }
        }
        our POV: boundaryPOV <- makeTemporalBoundaryValuePOV(stableSource)
        if(boundaryPOV==NULL){return(NULL)}
        boundaryPOV!.temporalBoundary.tracksEnd <- tracksEnd
        if(!tracksEnd){
            boundaryPOV!.temporalBoundary.cutIndexKnown <- true
            boundaryPOV!.temporalBoundary.cutIndex <- 0
        }else{
            me EndRelativeExtentResult: extent <-
                    stableSource!.pItem!.endRelativeExtent()
            if(extent.status==eresExact){
                boundaryPOV!.temporalBoundary.cutIndexKnown <- true
                boundaryPOV!.temporalBoundary.cutIndex <- extent.exactExtent
            }
        }
        if(projectionReference!=NULL and
                stableSource===projectionReference!.projectionPOV){
            if(tracksEnd){projectionReference!.endBoundary <- boundaryPOV}
            else{projectionReference!.beginBoundary <- boundaryPOV}
        }
        return(boundaryPOV)
    }

    our POV: makeTemporalBoundaryValuePOV(their POV: stableSource) <- {
        if(!isTemporalSpanPOV(stableSource)){return(NULL)}
        our POV:: boundaryPOV{povSrcTemporalBoundary}
        Allocate(boundaryPOV!.pItem)
        boundaryPOV!.pItem!.itmMode <- mItem
        boundaryPOV!.pItem!.viewMode <- vmOverlay
        boundaryPOV!.pItem!.infSize!.overlayType <- NUM
        boundaryPOV!.pItem!.infSize!.evalMode <- emUnknown
        boundaryPOV!.pItem!.value!.overlayType <- NUM
        boundaryPOV!.pItem!.value!.evalMode <- emLiteral
        boundaryPOV!.pItem!.value!.sizeMode <- fromCount
        boundaryPOV!.pItem!.value!.num <- 0
        boundaryPOV!.pItem!.originID <- stableSource!.pItem!.originID
        boundaryPOV!.pItem!.infCharPos <- stableSource!.pItem!.infCharPos
        boundaryPOV!.pParent <- stableSource!.pParent
        boundaryPOV!.accessMode <- aRefTo
        boundaryPOV!.identityRegistry <-
                stableSource!.effectiveIdentityRegistry()
        boundaryPOV!.temporalBoundary.sourcePov <- stableSource
        return(boundaryPOV)
    }

    me bool: sameTemporalBoundary(their POV: first,
            their POV: second) <- {
        if(first===second){return(true)}
        if(first==NULL or second==NULL or
                first!.temporalBoundary.sourcePov==NULL or
                second!.temporalBoundary.sourcePov==NULL or
                first!.temporalBoundary.sourcePov!==
                        second!.temporalBoundary.sourcePov){return(false)}
        if(first!.temporalBoundary.cutIndexKnown and
                second!.temporalBoundary.cutIndexKnown){
            return(first!.temporalBoundary.cutIndex==
                    second!.temporalBoundary.cutIndex)
        }
        return(first!.temporalBoundary.tracksEnd and
                second!.temporalBoundary.tracksEnd)
    }

    // Identity traversal is deliberately symmetric.  Callers may ask from
    // either endpoint; no merge direction is encoded in the identity.
    our POV: boundaryAcrossIdentity(their TemporalBoundaryIdentity: identity,
            their POV: knownBoundary) <- {
        if(identity==NULL or knownBoundary==NULL or
                identity!.identityRelation==NULL){return(NULL)}
        their IdentityRegistry: registry <-
                identity!.endingBoundary!.effectiveIdentityRegistry()
        if(registry==NULL or !registry!.areIdentical(
                identity!.endingBoundary,
                identity!.beginningBoundary)){return(NULL)}
        if(sameTemporalBoundary(
                knownBoundary, identity!.endingBoundary)){
            return(identity!.beginningBoundary)
        }
        if(sameTemporalBoundary(
                knownBoundary, identity!.beginningBoundary)){
            return(identity!.endingBoundary)
        }
        return(NULL)
    }

    me bool: boundaryIdentityAlreadyRecorded(our infonView: owner,
            our POV: endingSpan, our POV: beginningSpan) <- {
        withEach identity in owner!.temporalBoundaryIdentities{
            if(identity!.endingSpan===endingSpan and
                    identity!.beginningSpan===beginningSpan){return(true)}
        }
        return(false)
    }

    me bool: rootedContainmentAlreadyRecorded(our infonView: host,
            our POV: containedSpan) <- {
        withEach identity in host!.temporalContainmentIdentities{
            if(identity!.containedSpan===containedSpan){return(true)}
        }
        return(false)
    }

    our TemporalContainmentIdentity: rootedContainmentForContainedSpan(
            our POV: containedSpan) <- {
        if(containedSpan==NULL or containedSpan!.pParent==NULL or
                containedSpan!.pParent!.pItem==NULL){return(NULL)}
        withEach identity in containedSpan!.pParent!.pItem!.
                temporalContainmentIdentities{
            if(identity!.hostSpan===containedSpan!.pParent and
                    identity!.containedSpan===containedSpan){
                return(identity)
            }
        }
        return(NULL)
    }

    // Enumerate only the unambiguous whole-interval form: one embedded T-span
    // is the complete temporal component of one host T-span.  Multiple
    // components need their own alignment facts and are intentionally not
    // guessed from storage order.
    me void: enumerateRootedContainmentIdentities(our POV: hostSpan) <- {
        if(!isTemporalSpanPOV(hostSpan)){return()}
        our infonView: host <- hostSpan!.pItem
        if(host!.value!.items.size()!=1){return()}
        our POV: containedSpan <- host!.value!.items.head
        if(containedSpan==NULL or !containedSpan!.isSubItm or
                !isTemporalSpanPOV(containedSpan) or
                rootedContainmentAlreadyRecorded(host, containedSpan)){
            return()
        }
        containedSpan!.pParent <- hostSpan
        their IdentityRegistry: registry <-
                hostSpan!.effectiveIdentityRegistry()
        if(registry==NULL){return()}

        our POV: hostBegin <- makeTemporalBoundaryPOV(hostSpan, false)
        our POV: containedBegin <-
                makeTemporalBoundaryPOV(containedSpan, false)
        our POV: hostEnd <- makeTemporalBoundaryPOV(hostSpan, true)
        our POV: containedEnd <-
                makeTemporalBoundaryPOV(containedSpan, true)
        if(hostBegin==NULL or containedBegin==NULL or hostEnd==NULL or
                containedEnd==NULL){return()}

        our TemporalContainmentIdentity:: identity
        identity!.hostSpan <- hostSpan
        identity!.containedSpan <- containedSpan
        identity!.hostBegin <- hostBegin
        identity!.containedBegin <- containedBegin
        identity!.hostEnd <- hostEnd
        identity!.containedEnd <- containedEnd
        identity!.beginIdentityRelation <- registry!.recordIdentity(
                hostBegin, containedBegin,
                iekTemporalContainment, 0)
        identity!.endIdentityRelation <- registry!.recordIdentity(
                hostEnd, containedEnd,
                iekTemporalContainment, 0)
        if(identity!.beginIdentityRelation==NULL or
                identity!.endIdentityRelation==NULL){return()}
        host!.temporalContainmentIdentities.append(identity)
    }

    // A contained sparse T-list is itself the stable component timeline named
    // by the host/component boundary identities.  Expose its first occurrence
    // inside that root instead of flattening the occurrence beside the root;
    // subsequent queries then traverse the same identity-bearing component.
    our POV: materializeRootedContainedSpanHead(
            our POV: containedSpan, our infonView: headItem) <- {
        our TemporalContainmentIdentity: containment <-
                rootedContainmentForContainedSpan(containedSpan)
        if(containment==NULL or headItem==NULL or
                containedSpan!.pItem==NULL or
                !containedSpan!.isSparseOrderedSpan()){
            return(NULL)
        }
        me int64: totalCount <- containedSpan!.sparseSpanCount()
        if(totalCount<=0){return(NULL)}
        me int64: oldStartOrdinal <-
                containedSpan!.repetitionSpan.startOrdinal
        me int64: oldEndOrdinal <- oldStartOrdinal + totalCount
        our POV: occurrenceReference <-
                containedSpan!.getOrCreateImplicitItemPOV(0)
        our infonView: remainder
        if(totalCount>1){
            remainder <- containedSpan!.makeSparseSpanCopy(totalCount - 1)
        }

        // Preserve this infonView as the component root.  Its explicit size is
        // semantic and therefore continues to override its compressed child
        // count after the first occurrence is materialized.
        containedSpan!.pItem!.value!.items.clear()
        containedSpan!.pItem!.value!.sizeMode <- fromGiven
        containedSpan!.pItem!.value!.tailUnfinished <- false
        containedSpan!.pItem!.infSize!.overlayType <- NUM
        containedSpan!.pItem!.infSize!.evalMode <- emLiteral
        containedSpan!.pItem!.infSize!.num <- totalCount

        our POV: headPOV <- containedSpan!.pItem!.value!.items.append(
                headItem, false, povSrcSparseExposedHead)
        headPOV!.pParent <- containedSpan
        headPOV!.identityRegistry <- containedSpan!.effectiveIdentityRegistry()

        our POV: remainderPOV
        if(remainder!=NULL){
            remainderPOV <- containedSpan!.pItem!.value!.items.append(
                    remainder, true, povSrcSparseSpanRemainder)
            remainderPOV!.pParent <- containedSpan
            remainderPOV!.identityRegistry <-
                    containedSpan!.effectiveIdentityRegistry()
            remainderPOV!.repetitionSpan.family <-
                    containedSpan!.repetitionSpan.family
            remainderPOV!.repetitionSpan.startOrdinal <- oldStartOrdinal + 1
        }

        their IdentityRegistry: registry <-
                containedSpan!.effectiveIdentityRegistry()
        if(registry!=NULL and containedSpan!.repetitionSpan.family!=NULL){
            if(remainderPOV!=NULL){
                registry!.remapExposedHeadRemainder(
                        remainderPOV, oldEndOrdinal)
            }
            if(occurrenceReference!=NULL){
                registry!.recordRepetitionMaterialization(
                        occurrenceReference, headPOV, 0)
            }
        }
        return(headPOV)
    }

    our POV: spanAcrossRootedContainmentIdentity(
            their TemporalContainmentIdentity: identity,
            their POV: knownSpan) <- {
        if(identity==NULL or knownSpan==NULL or
                identity!.beginIdentityRelation==NULL or
                identity!.endIdentityRelation==NULL){return(NULL)}
        their IdentityRegistry: registry <-
                identity!.hostSpan!.effectiveIdentityRegistry()
        if(registry==NULL or !registry!.areIdentical(
                identity!.hostBegin, identity!.containedBegin) or
                !registry!.areIdentical(
                        identity!.hostEnd, identity!.containedEnd)){
            return(NULL)
        }
        if(knownSpan===identity!.hostSpan){return(identity!.containedSpan)}
        if(knownSpan===identity!.containedSpan){return(identity!.hostSpan)}
        return(NULL)
    }

    our POV: containedSpanFromRootIdentity(our POV: hostSpan) <- {
        if(hostSpan==NULL or hostSpan!.pItem==NULL){return(NULL)}
        enumerateRootedContainmentIdentities(hostSpan)
        withEach identity in
                hostSpan!.pItem!.temporalContainmentIdentities{
            our POV: contained <- spanAcrossRootedContainmentIdentity(
                    identity, hostSpan)
            if(contained!=NULL){return(contained)}
        }
        return(NULL)
    }

    // Enumerate only identities implied by direct sequence adjacency.  Sharing
    // a temporal root is intentionally insufficient: an intervening non-T
    // item prevents this identity from being emitted.  An unknown prior end
    // does not: it contributes a symbolic end boundary that can be resolved
    // later, without pretending that a concrete last occurrence is available.
    me void: enumerateAdjacentSpanBoundaryIdentities(their POV: ownerPOV) <- {
        if(!isTemporalSpanPOV(ownerPOV)){return()}
        their IdentityRegistry: registry <-
                ownerPOV!.effectiveIdentityRegistry()
        if(registry==NULL){return()}
        our infonView: owner <- ownerPOV!.pItem
        our POV: precedingSpan <- NULL
        our POV: child <- owner!.value!.items.head
        while(child!=NULL){
            child!.pParent <- ownerPOV
            if(isTemporalSpanPOV(child)){
                if(precedingSpan!=NULL and
                        !boundaryIdentityAlreadyRecorded(
                                owner, precedingSpan, child)){
                    our POV: endingBoundary <-
                            makeTemporalBoundaryPOV(precedingSpan, true)
                    our POV: beginningBoundary <-
                            makeTemporalBoundaryPOV(child, false)
                    if(endingBoundary==NULL or beginningBoundary==NULL){
                        precedingSpan <- child
                        child <- child!.next
                        continue()
                    }
                    our TemporalBoundaryIdentity:: identity
                    identity!.endingSpan <- precedingSpan
                    identity!.beginningSpan <- child
                    identity!.endingBoundary <- endingBoundary
                    identity!.beginningBoundary <- beginningBoundary
                    identity!.identityRelation <- registry!.recordIdentity(
                            endingBoundary, beginningBoundary,
                            iekTemporalBoundary, 0)
                    if(identity!.identityRelation==NULL){
                        precedingSpan <- child
                        child <- child!.next
                        continue()
                    }
                    owner!.temporalBoundaryIdentities.append(identity)
                }
                precedingSpan <- child
            }else{
                // Only immediately adjacent spans share a boundary by syntax.
                precedingSpan <- NULL
            }
            child <- child!.next
        }
    }

    our POV: firstTemporalOccurrence(our POV: spanPOV, me int: depth) <- {
        if(!isTemporalSpanPOV(spanPOV) or depth>128){return(NULL)}
        our POV: first <- spanPOV!.pItem!.value!.items.head
        if(first==NULL){return(NULL)}
        first!.pParent <- spanPOV
        if(isTemporalSpanPOV(first)){
            return(firstTemporalOccurrence(first, depth + 1))
        }
        return(first)
    }

    our POV: lastTemporalOccurrence(our POV: spanPOV, me int: depth) <- {
        if(!temporalSpanHasKnownEnd(spanPOV) or depth>128){return(NULL)}
        our POV: last <- spanPOV!.pItem!.value!.items.tail
        if(last==NULL){return(NULL)}
        last!.pParent <- spanPOV
        if(isTemporalSpanPOV(last)){
            return(lastTemporalOccurrence(last, depth + 1))
        }
        return(last)
    }

    // Apply the same symmetric end=begin evidence in either direction.  This
    // is deliberately separate from cursor evaluation so later theorem search
    // can enumerate the identity without executing a cursor.
    our POV: occurrenceAcrossAdjacentSpanBoundary(their POV: anchor,
            me bool: previous) <- {
        if(anchor==NULL or anchor!.pParent==NULL){return(NULL)}
        their POV: currentSpan <- anchor!.pParent
        if(!isTemporalSpanPOV(currentSpan) or
                currentSpan!.pParent==NULL){return(NULL)}
        their POV: ownerPOV <- currentSpan!.pParent
        if(!isTemporalSpanPOV(ownerPOV)){return(NULL)}
        enumerateAdjacentSpanBoundaryIdentities(ownerPOV)
        our POV: currentBoundary <-
                makeTemporalBoundaryPOV(currentSpan, !previous)
        withEach identity in ownerPOV!.pItem!.
                temporalBoundaryIdentities{
            our POV: oppositeBoundary <-
                    boundaryAcrossIdentity(identity, currentBoundary)
            if(oppositeBoundary!=NULL){
                if(previous and oppositeBoundary!.temporalBoundary.
                        sourcePov===identity!.endingSpan){
                    return(lastTemporalOccurrence(identity!.endingSpan, 0))
                }
                if(!previous and oppositeBoundary!.temporalBoundary.
                        sourcePov===identity!.beginningSpan){
                    return(firstTemporalOccurrence(
                            identity!.beginningSpan, 0))
                }
            }
        }
        return(NULL)
    }

    our POV: temporalNeighborFromIdentity(their POV: anchor,
            me bool: previous) <- {
        if(anchor==NULL){return(NULL)}
        if(previous and anchor!.prev!=NULL){return(anchor!.prev)}
        if(!previous and anchor!.next!=NULL){return(anchor!.next)}
        return(occurrenceAcrossAdjacentSpanBoundary(anchor, previous))
    }

    void: enumerateListIdentityImplications(our AItem: aItem,
            their InfonViewReasoningResult: plan) <- {
        if(aItem==NULL or aItem!.LHS_item==NULL or
                aItem!.LHS_item!.pItem==NULL or aItem!.RHS==NULL or
                aItem!.RHS!.pItem==NULL){return()}
        if(plan.status==rrNotApplicable or plan.status==rrRejected){return()}
        our infonView: LHS <- aItem!.LHS_item!.pItem
        our infonView: RHS <- aItem!.RHS!.pItem
        if(LHS!.value!.overlayType==LST and
                RHS!.value!.overlayType==LST and
                !LHS!.value!.timelike and RHS!.value!.timelike){
            plan!.copyRHSTimelikeToLHS <- true
        }
    }

    void: execListIdentityImplications(our AItem: aItem,
            their InfonViewReasoningResult: plan) <- {
        if(!plan.copyRHSTimelikeToLHS){return()}
        aItem!.LHS_item!.pItem!.value!.timelike <- true
        aItem!.phase1RecordHandler(
                "temporalIdentity:listContextCopied", false)
    }
}

// `asTList` is a lazy, reversible temporal projection. The reference itself
// is semantic: callers can navigate item -> temporal view or temporal view ->
// item without expanding every component timeline. An item already expressed
// as a T-list produces a second POV over the same span and an explicit identity.
// A non-T item receives an open T-list placeholder; later component/rooting
// identities refine that view rather than this operation guessing an alignment.
struct TemporalProjectionReasoner{
    our TemporalProjectionReference: projectAsTList(
            our POV: sourcePOV, me uint64: normalizationID) <- {
        if(sourcePOV==NULL or sourcePOV!.pItem==NULL){return(NULL)}
        their IdentityRegistry: registry <-
                sourcePOV!.effectiveIdentityRegistry()
        if(registry==NULL){return(NULL)}

        our TemporalProjectionReference: existing <-
                registry!.findTemporalProjectionForSource(sourcePOV)
        if(existing!=NULL){return(existing)}

        // Applying asTList to an asTList view is idempotent.
        if(sourcePOV!.temporalProjection.reference!=NULL and
                sourcePOV!.temporalProjection.isProjection){
            return(registry!.findTemporalProjectionForView(sourcePOV))
        }

        our POV:: projectionPOV{povSrcTemporalProjection}
        if(sourcePOV!.pItem!.value!.overlayType==LST and
                sourcePOV!.pItem!.value!.timelike){
            projectionPOV!.pItem <- sourcePOV!.pItem
        }else{
            Allocate(projectionPOV!.pItem)
            projectionPOV!.pItem!.setToList()
            projectionPOV!.pItem!.value!.timelike <- true
            // The projection relation, rather than the number of materialized
            // children, supplies this list's extent.  Until component/rooting
            // identities determine that extent it must remain given-unknown;
            // counting the empty physical representation would falsely close
            // the lifetime as an empty T-list.
            projectionPOV!.pItem!.value!.sizeMode <- fromGiven
            projectionPOV!.pItem!.originID <- sourcePOV!.pItem!.originID
            projectionPOV!.pItem!.infCharPos <- sourcePOV!.pItem!.infCharPos
        }
        projectionPOV!.pParent <- sourcePOV!.pParent
        projectionPOV!.accessMode <- aRefTo
        projectionPOV!.bindIdentityRegistry(registry)

        our TemporalProjectionReference: reference <-
                registry!.recordTemporalProjection(sourcePOV, projectionPOV)
        if(reference!=NULL and reference!.identityRelation==NULL and
                sourcePOV!.pItem!.value!.overlayType==LST and
                sourcePOV!.pItem!.value!.timelike){
            reference!.identityRelation <- registry!.recordIdentity(
                    reference!.sourcePOV, reference!.projectionPOV,
                    iekTemporalProjection, normalizationID)
        }
        return(reference)
    }

    our POV: oppositeProjectionEndpoint(
            their TemporalProjectionReference: reference,
            their POV: knownPOV) <- {
        if(reference==NULL or knownPOV==NULL){return(NULL)}
        if(knownPOV===reference!.sourcePOV or
                (knownPOV!.temporalProjection.reference===reference and
                 !knownPOV!.temporalProjection.isProjection)){
            return(reference!.projectionPOV)
        }
        if(knownPOV===reference!.projectionPOV or
                (knownPOV!.temporalProjection.reference===reference and
                 knownPOV!.temporalProjection.isProjection)){
            return(reference!.sourcePOV)
        }
        return(NULL)
    }
}

// Owns definition-backed list shape inheritance. These are semantic list
// operations, not generated merge-matrix cases.
struct ListShapeStrategy{
    me MergePreparationPlan: planDefinitionListShape(our AItem: aItem) <- {
        me MergePreparationPlan: plan
        plan.copyDefinitionListSpec <- false
        plan.copyDefinitionOrderMode <- false
        plan.copyDefinitionSize <- false
        plan.openDefinitionTail <- false
        plan.definitionShapeAction <- mdsNotApplicable
        plan.sizeAction <- mpsNotApplicable
        plan.sizeBlockedByOverlayType <- false
        plan.sizeBlockedByListOutput <- false

        if(aItem!.RHS==NULL or !aItem!.RHS!.trueByDefinition){return(plan)}
        our infonView: LHS <- aItem!.LHS_item!.pItem
        our infonView: RHS <- aItem!.RHS!.pItem
        if(LHS==NULL or RHS==NULL){return(plan)}
        if(LHS!.value!.overlayType!=LST or LHS!.value!.evalMode!=emLiteral){return(plan)}
        if(RHS!.value!.overlayType!=LST or RHS!.value!.evalMode!=emLiteral){return(plan)}

        if(LHS!.value!.listSpec==NULL and RHS!.value!.listSpec!=NULL){
            plan.copyDefinitionListSpec <- true
        }
        if(LHS!.orderMode==uUnknown and RHS!.orderMode!=uUnknown){
            plan.copyDefinitionOrderMode <- true
        }
        me bool: lhsHasOnlyDefaultZeroSize <- LHS!.value!.items.isEmpty() and
                LHS!.infSize!.evalMode==emLiteral and LHS!.infSize!.num==0
        if((LHS!.infSize!.evalMode==emUnknown or lhsHasOnlyDefaultZeroSize) and
                RHS!.infSize!.evalMode!=emUnknown){
            plan.copyDefinitionSize <- true
        }
        if(RHS!.value!.tailUnfinished and !LHS!.value!.tailUnfinished){
            plan.openDefinitionTail <- true
        }
        if(plan.hasDefinitionListShapeChange()){
            plan.definitionShapeAction <- mdsUnclaimed
        }
        return(plan)
    }

    // Attach definition-derived shape to an already-claimed local merge. The
    // preparation plan remains read-only; no LHS field changes here.
    void: promoteDefinitionListShapeToConsolidation(
            their InfonViewReasoningResult: consolidationPlan,
            their MergePreparationPlan: preparationPlan,
            me bool: consolidationCanExecute) <- {
        if(!preparationPlan.hasDefinitionListShapeChange()){return()}
        if(!consolidationCanExecute or
                consolidationPlan.status==rrNotApplicable){return()}
        consolidationPlan!.copyDefinitionListSpec <-
                preparationPlan.copyDefinitionListSpec
        consolidationPlan!.copyDefinitionOrderMode <-
                preparationPlan.copyDefinitionOrderMode
        consolidationPlan!.copyDefinitionSize <-
                preparationPlan.copyDefinitionSize
        consolidationPlan!.openDefinitionTail <-
                preparationPlan.openDefinitionTail
        preparationPlan!.definitionShapeAction <- mdsPromotedToConsolidation
    }

    void: execDefinitionListShape(our AItem: aItem,
            their InfonViewReasoningResult: plan) <- {
        our infonView: LHS <- aItem!.LHS_item!.pItem
        our infonView: RHS <- aItem!.RHS!.pItem
        if(plan.copyDefinitionListSpec){
            LHS!.value!.listSpec <- RHS!.value!.listSpec
            aItem!.phase1RecordHandler(
                    "mergePreparation:definitionListSpecCopied", false)
        }
        if(plan.copyDefinitionOrderMode){
            LHS!.orderMode <- RHS!.orderMode
            aItem!.phase1RecordHandler(
                    "mergePreparation:definitionOrderModeCopied", false)
        }
        if(plan.copyDefinitionSize){
            LHS!.infSize! <- RHS!.infSize!
            aItem!.phase1RecordHandler(
                    "mergePreparation:definitionSizeCopied", false)
        }
        if(plan.openDefinitionTail){
            LHS!.value!.tailUnfinished <- true
            aItem!.phase1RecordHandler(
                    "mergePreparation:definitionTailOpened", false)
        }
    }

    me bool: isDefinitionListShapeOnly(our AItem: aItem) <- {
        if(aItem!.RHS==NULL or !aItem!.RHS!.trueByDefinition){return(false)}
        our infonView: RHS <- aItem!.RHS!.pItem
        if(RHS==NULL){return(false)}
        if(RHS!.value!.overlayType!=LST or RHS!.value!.evalMode!=emLiteral){return(false)}
        if(!RHS!.value!.tailUnfinished or RHS!.value!.listSpec==NULL){return(false)}
        return(RHS!.value!.items.isEmpty())
    }

    me bool: definitionListShapeNeedsMemberInstantiation(
            our AItem: aItem) <- {
        if(!isDefinitionListShapeOnly(aItem)){return(false)}
        our infonView: memberTemplate <-
                aItem!.RHS!.pItem!.value!.listSpec
        return(memberTemplate!.value!.overlayType==LST and
                memberTemplate!.value!.evalMode==emLiteral)
    }

    me bool: inheritDefinitionListShapeForInfonView(their WorldManager: worldManager,
            our infonView: target) <- {
        if(target==NULL or target!.type==NULL){return(false)}
        if(target!.value!.overlayType!=LST or target!.value!.evalMode!=emLiteral){
            return(false)
        }
        me vocabularySpec: vSpec
        vSpec.init(worldManager!.agent!.getLocaleBaseName())
        our WordDefn: defn <- modelMngr.lookupSingleDefinitionForType(target!.type, vSpec)
        if(defn==NULL or defn!.meaning==NULL){return(false)}
        our infonView: meaning <- defn!.meaning
        if(meaning!.value!.overlayType!=LST or meaning!.value!.evalMode!=emLiteral){
            return(false)
        }
        if(!meaning!.value!.tailUnfinished or !meaning!.value!.items.isEmpty() or
                meaning!.value!.listSpec==NULL){return(false)}

        me bool: changeMade <- false
        if(target!.value!.listSpec==NULL){
            target!.value!.listSpec <- meaning!.value!.listSpec
            changeMade <- true
        }
        if(target!.orderMode==uUnknown and meaning!.orderMode!=uUnknown){
            target!.orderMode <- meaning!.orderMode
            changeMade <- true
        }
        me bool: targetHasOnlyDefaultZeroSize <- target!.value!.items.isEmpty() and
                target!.infSize!.evalMode==emLiteral and target!.infSize!.num==0
        if((target!.infSize!.evalMode==emUnknown or targetHasOnlyDefaultZeroSize) and
                meaning!.infSize!.evalMode!=emUnknown){
            target!.infSize! <- meaning!.infSize!
            changeMade <- true
        }
        if(target!.value!.sizeMode!=meaning!.value!.sizeMode){
            target!.value!.sizeMode <- meaning!.value!.sizeMode
            changeMade <- true
        }
        if(meaning!.value!.tailUnfinished and !target!.value!.tailUnfinished){
            target!.value!.tailUnfinished <- true
            changeMade <- true
        }
        return(changeMade)
    }
}

// Owns the generic strict-size part of pre-consolidation inspection. Planning
// observes the effective state after the preceding definition-backed shape
// plan. Validation rejects any effect that has no atomic consolidation owner.
struct MergeSizeStrategy{
    void: planPreparation(our AItem: aItem,
            me bool: sizeCopyAlreadyOwnedByConsolidation,
            their MergePreparationPlan: plan) <- {
        // A planned definition-size copy happens first and makes the LHS size
        // non-unknown before the old generic rule would inspect it.
        if(!plan.copyDefinitionSize and !aItem!.looseSize and
                aItem!.LHS_item!.pItem!.infSize!.evalMode==emUnknown and
                aItem!.RHS!.pItem!.infSize!.evalMode==emLiteral){
            if(sizeCopyAlreadyOwnedByConsolidation){
                plan!.sizeAction <- mpsOwnedByConsolidation
                return()
            }
            plan!.sizeBlockedByOverlayType <-
                    aItem!.LHS_item!.pItem!.viewMode==vmOverlay and
                    aItem!.RHS!.pItem!.value!.overlayType!=
                            aItem!.LHS_item!.pItem!.value!.overlayType

            // Definition-backed list-spec inheritance also precedes this
            // decision, so use the source spec when that copy is planned.
            if(plan.copyDefinitionListSpec){
                plan!.sizeBlockedByListOutput <-
                        aItem!.RHS!.pItem!.value!.listSpec!=NULL and
                        aItem!.RHS!.pItem!.value!.listSpec!.asWrkLstOutr
            }else{
                plan!.sizeBlockedByListOutput <-
                        aItem!.LHS_item!.pItem!.value!.listSpec!=NULL and
                        aItem!.LHS_item!.pItem!.value!.listSpec!.asWrkLstOutr
            }
            if(plan.sizeBlockedByOverlayType or plan.sizeBlockedByListOutput){
                plan!.sizeAction <- mpsBlocked
            }else{
                // No mutation is permitted without an explicit accepting
                // consolidation owner. Promotion below either supplies that
                // owner or leaves an explicit semantic trap.
                plan!.sizeAction <- mpsUnclaimed
            }
        }
    }

    // Every claimed local strategy runs through the consolidation commit
    // boundary. Move the generic size effect into that plan so an uncommitted
    // or rejected plan cannot partially mutate the LHS.
    void: promoteSizeCopyToConsolidation(
            their InfonViewReasoningResult: consolidationPlan,
            their MergePreparationPlan: preparationPlan,
            me bool: consolidationCanExecute) <- {
        if(!consolidationCanExecute or
                preparationPlan.sizeAction!=mpsUnclaimed){return()}
        if(consolidationPlan.status==rrNotApplicable){return()}
        consolidationPlan!.copySize <- true
        preparationPlan!.sizeAction <- mpsPromotedToConsolidation
    }

    void: recordPreparationHandlers(our AItem: aItem,
            their MergePreparationPlan: plan) <- {
        if(!plan.hasPreparationDecision()){return()}
        aItem!.phase1RecordHandler("strategy:mergePreparation", false)
        if(plan.definitionShapeAction==mdsPromotedToConsolidation){
            aItem!.phase1RecordHandler(
                    "mergePreparation:definitionShapePromotedToConsolidation",
                    false)
        }else if(plan.definitionShapeAction==mdsUnclaimed){
            aItem!.phase1RecordHandler(
                    "mergePreparation:definitionShapeUnclaimed", true)
        }
        if(plan.sizeAction==mpsOwnedByConsolidation){
            aItem!.phase1RecordHandler(
                    "mergePreparation:sizeOwnedByConsolidation", false)
        }else if(plan.sizeAction==mpsPromotedToConsolidation){
            aItem!.phase1RecordHandler(
                    "mergePreparation:sizePromotedToConsolidation", false)
        }else if(plan.sizeAction==mpsUnclaimed){
            aItem!.phase1RecordHandler(
                    "mergePreparation:sizeUnclaimed", true)
        }else if(plan.sizeAction==mpsBlocked){
            if(plan.sizeBlockedByOverlayType){
                aItem!.phase1RecordHandler(
                        "mergePreparation:sizeBlockedByOverlayType", false)
            }
            if(plan.sizeBlockedByListOutput){
                aItem!.phase1RecordHandler(
                        "mergePreparation:sizeBlockedByListOutput", false)
            }
        }
    }

    void: validatePreparation(our AItem: aItem,
            their MergePreparationPlan: plan) <- {
        recordPreparationHandlers(aItem, plan)
        if(plan.definitionShapeAction==mdsUnclaimed){
            // TODO: Give the special-precedence merge path an explicit atomic
            // owner if a real case reaches this boundary.
            log("Not Implemented Yet: definition-backed list shape has no atomic consolidation owner: "+toString(aItem))
            logFlush()
            exit(2)
        }
        if(plan.sizeAction==mpsUnclaimed){
            // TODO: Classify the reached merge family and make its accepting
            // strategy own this size effect before enabling it.
            log("Not Implemented Yet: merge size copy has no atomic consolidation owner: "+toString(aItem))
            logFlush()
            exit(2)
        }
    }
}

// Owns list-state implications that require a propagation continuation rather
// than a complete local consolidation result.
struct ListConsolidationStrategy{
    me bool: hasRHSListConstraintsToMerge(our infonView: LHS,
            our infonView: RHS) <- {
        return((LHS!.type==NULL and RHS!.type!=NULL) or
                (LHS!.value!.listSpec==NULL and RHS!.value!.listSpec!=NULL) or
                (LHS!.orderMode==uUnknown and RHS!.orderMode!=uUnknown) or
                !RHS!.wrkList.isEmpty())
    }

    me void: mergeRHSListConstraints(our AItem: aItem) <- {
        our infonView: LHS <- aItem!.LHS_item!.pItem
        our infonView: RHS <- aItem!.RHS!.pItem
        if(LHS!.type==NULL and RHS!.type!=NULL){LHS!.type <- RHS!.type}
        if(LHS!.value!.listSpec==NULL and RHS!.value!.listSpec!=NULL){
            LHS!.value!.listSpec <- RHS!.value!.listSpec
        }
        if(LHS!.orderMode==uUnknown and RHS!.orderMode!=uUnknown){
            LHS!.orderMode <- RHS!.orderMode
        }
        if(!RHS!.wrkList.isEmpty()){LHS!.copyWrkListFrom(RHS)}
    }

    me void: prepareUnknownListForPropagation(our AItem: aItem) <- {
        our infonView: LHS <- aItem!.LHS_item!.pItem
        our infonView: RHS <- aItem!.RHS!.pItem
        mergeRHSListConstraints(aItem)
        LHS!.value!.evalMode <- emLiteral

        me bool: rhsIsClosedEmpty <- RHS!.value!.items.isEmpty() and
                !RHS!.value!.tailUnfinished and
                (RHS!.streamState==notParsing or RHS!.streamState==parseDone)
        if(rhsIsClosedEmpty){
            LHS!.value!.tailUnfinished <- false
            LHS!.countSize(false)
        }else{
            // This is a temporary construction tail. It lets ordinary list
            // traversal create one tentative LHS slot for each RHS member.
            // Existing propagation closes it when a finite RHS closes.
            LHS!.value!.tailUnfinished <- true
        }
    }

    me bool: execStartPropagation(their WorldManager: worldManager,
            our AItem: aItem) <- {
        me bool: changeMade <- false
        me bool: looseSize <- aItem!.RHS!.looseType()
        me bool: sizesCompatible <- false
        if(!looseSize){
            sizesCompatible <- worldManager!.sizesAreCompatable(
                    aItem!.LHS_item!.pItem, aItem!.RHS!.pItem)
        }
        me bool: lhsEmpty <- !aItem!.LHS_item!.pItem!.value!.tailUnfinished and
                aItem!.LHS_item!.pItem!.value!.items.size()==0
        me bool: rhsIsPureDots <- aItem!.RHS!.pItem!.value!.tailUnfinished and
                aItem!.RHS!.pItem!.value!.items.size()==0

        aItem!.phase1RecordHandler("strategy:listPropagation", false)
        if(!looseSize and !sizesCompatible){
            aItem!.phase1RecordHandler(
                    "startProp:!looseSize|!sizesCompat||->REJECT", false)
            aItem!.mergeStatus <- msReject
            aItem!.LHS_item!.rejected <- true
            changeMade <- true
        }
        else if(!looseSize and sizesCompatible and lhsEmpty and !rhsIsPureDots){
            aItem!.phase1RecordHandler(
                    "startProp:!looseSize|sizesCompat|LHSEmpty|!RHSisPureDots->SKIP",
                    false)
            changeMade <- true
        }
        else if(!looseSize and sizesCompatible and rhsIsPureDots){
            aItem!.phase1RecordHandler(
                    "startProp:!looseSize|sizesCompat||RHSisPureDots->initListIterators",
                    false)
            worldManager!.initListIterators(aItem)
            aItem!.mergeStatus <- msUnknown
            changeMade <- true
        }
        else if(!looseSize and sizesCompatible and !lhsEmpty and !rhsIsPureDots){
            aItem!.phase1RecordHandler(
                    "startProp:!looseSize|sizesCompat|!LHSEmpty|!RHSisPureDots->initListIterators",
                    false)
            worldManager!.initListIterators(aItem)
            aItem!.mergeStatus <- msUnknown
            changeMade <- true
        }
        else if(looseSize){
            aItem!.phase1RecordHandler(
                    "startProp:looseSize|||->initListIterators", false)
            worldManager!.initListIterators(aItem)
            aItem!.mergeStatus <- msUnknown
            changeMade <- true
        }
        return(changeMade)
    }

    // A definition such as {T {memberType}| ... } supplies a template for
    // existing members, but its open tail is a compact promise of possible
    // future members. Snapshot the materialized prefix and instantiate only
    // those members; ordinary normalization then resolves each private copy.
    me void: prepareDefinitionListMemberWork(
            their WorldManager: worldManager, their Agenda: agenda,
            our AItem: aItem,
            their List<our AItem>: requestedWork) <- {
        me List<our POV>: materializedMembers
        our POV: member <- aItem!.LHS_item!.pItem!.value!.items.head
        while(member!=NULL){
            if(!member!.isSparseOrderedSpan()){
                materializedMembers.append(member)
            }
            member <- member!.next
        }

        withEach materializedMember in materializedMembers{
            if(materializedMember!.pParent==NULL){
                materializedMember!.pParent <- aItem!.LHS_item
            }
            if(aItem!.LHS_item!.seedNewlyVisibleTypeSpecs(
                    materializedMember!.pItem, false)){
                our AItem: memberWork <- worldManager!.prepareInfonWork(
                        agenda, materializedMember, NULL, aItem,
                        aprListCompletion, aItem!.priority+1,
                        srcPropagate)
                if(memberWork!=NULL){requestedWork.append(memberWork)}
            }
        }
        aItem!.phase1RecordHandler(
                "strategy:definitionListMembers", false)
    }

    me InfonViewReasoningResult: planConsolidation(their WorldManager: worldManager,
            our AItem: aItem) <- {
        me InfonViewReasoningResult: result
        result.status <- rrNotApplicable
        result.directCase <- dcNone
        result.listCase <- lcNone
        result.intersectionCase <- icNone
        result.orderedSpanCase <- ocNone
        result.referenceCase <- rcNone
        result.consolidationAction <- caNone
        result.workAction <- waNone
        result.actionCommitPolicy <- cpNonInvertedAcceptance
        result.copySize <- false
        result.emitRejectLog <- false
        if(aItem==NULL or aItem!.LHS_item==NULL or aItem!.LHS_item!.pItem==NULL or
                aItem!.RHS==NULL or aItem!.RHS!.pItem==NULL){return(result)}

        our infonView: LHS <- aItem!.LHS_item!.pItem
        our infonView: RHS <- aItem!.RHS!.pItem
        // Sparse ordered spans have a higher-precedence merge path that can
        // split either side and return a remainder. Keep that path in the
        // legacy strategy until its result can be represented explicitly.
        if(aItem!.LHS_item!.isSparseOrderedSpan() and aItem!.RHS!.isSparseOrderedSpan()){
            return(result)
        }
        if(!aItem!.RHS!.looseType() and
                LHS!.value!.overlayType==LST and RHS!.value!.overlayType==LST and
                (LHS!.value!.evalMode==emUnknown or
                 RHS!.value!.evalMode==emUnknown) and
                (LHS!.value!.evalMode==emUnknown or
                 LHS!.value!.evalMode==emLiteral) and
                (RHS!.value!.evalMode==emUnknown or
                 RHS!.value!.evalMode==emLiteral)){
            if(LHS!.invertMatch or RHS!.invertMatch){
                result.listCase <- lcUnresolvedListTemplatePolarity
                result.status <- rrHandledNoChange
                result.constraintDisposition <- cdRetained
                result.statusIncludesPolarity <- true
                return(result)
            }
            if(LHS!.value!.evalMode==emUnknown and
                    RHS!.value!.evalMode==emUnknown){
                result.listCase <- lcStrictUnknownLists
                if(aItem!.LHS_item!.accessMode==aRefTo){
                    result.status <- rrPlannedChange
                    result.consolidationAction <- caCopyRHSIdentityToLHS
                }
                else if(hasRHSListConstraintsToMerge(LHS, RHS)){
                    result.status <- rrPlannedChange
                    result.consolidationAction <- caMergeRHSListConstraints
                }
                else{result.status <- rrHandledNoChange}
                return(result)
            }
            if(LHS!.value!.evalMode==emUnknown){
                result.listCase <- lcStrictUnknownFromLiteralList
                if(aItem!.LHS_item!.accessMode==aRefTo){
                    result.status <- rrPlannedChange
                    result.consolidationAction <- caCopyRHSIdentityToLHS
                }else{
                    result.status <- rrNeedsWork
                    result.consolidationAction <- caPrepareUnknownListForPropagation
                    result.workAction <- waStartListPropagation
                }
                return(result)
            }
            result.listCase <- lcStrictLiteralAgainstUnknownList
            if(aItem!.LHS_item!.accessMode==aRefTo){
                result.status <- rrPlannedChange
                result.consolidationAction <- caCopyRHSIdentityToLHS
            }
            else if(hasRHSListConstraintsToMerge(LHS, RHS)){
                result.status <- rrPlannedChange
                result.consolidationAction <- caMergeRHSListConstraints
            }
            else{result.status <- rrHandledNoChange}
            return(result)
        }
        if(aItem!.RHS!.looseType() and
                LHS!.value!.overlayType==LST and RHS!.value!.overlayType==LST and
                (LHS!.value!.evalMode==emUnknown or
                 RHS!.value!.evalMode==emUnknown) and
                (LHS!.value!.evalMode==emUnknown or
                 LHS!.value!.evalMode==emLiteral) and
                (RHS!.value!.evalMode==emUnknown or
                 RHS!.value!.evalMode==emLiteral)){
            if(LHS!.invertMatch or RHS!.invertMatch){
                result.listCase <- lcUnresolvedListTemplatePolarity
                result.status <- rrHandledNoChange
                result.constraintDisposition <- cdRetained
                result.statusIncludesPolarity <- true
                return(result)
            }
            if(LHS!.value!.evalMode==emUnknown and
                    RHS!.value!.evalMode==emUnknown){
                result.listCase <- lcLooseUnknownLists
                if(hasRHSListConstraintsToMerge(LHS, RHS)){
                    result.status <- rrPlannedChange
                    result.consolidationAction <- caMergeRHSListConstraints
                }
                else{result.status <- rrHandledNoChange}
                return(result)
            }
            if(LHS!.value!.evalMode==emUnknown){
                result.listCase <- lcLooseUnknownFromLiteralList
                result.status <- rrNeedsWork
                result.consolidationAction <- caPrepareUnknownListForPropagation
                result.workAction <- waStartListPropagation
                return(result)
            }
            result.listCase <- lcLooseLiteralAgainstUnknownList
            if(hasRHSListConstraintsToMerge(LHS, RHS)){
                result.status <- rrPlannedChange
                result.consolidationAction <- caMergeRHSListConstraints
            }
            else{result.status <- rrHandledNoChange}
            return(result)
        }
        if(LHS!.value!.overlayType==LST and
                (LHS!.value!.evalMode==emUnknown or LHS!.value!.evalMode==emLiteral) and
                aItem!.RHS!.looseType() and
                (RHS!.value!.overlayType==NUM or RHS!.value!.overlayType==STR) and
                !LHS!.invertMatch and !RHS!.invertMatch){
            result.listCase <- lcLooseListAgainstScalar
            result.status <- rrNeedsWork
            result.workAction <- waStartListPropagation
            return(result)
        }
        if(LHS!.value!.overlayType!=LST or LHS!.value!.evalMode!=emLiteral or
                RHS!.value!.overlayType!=LST or RHS!.value!.evalMode!=emLiteral or
                LHS!.invertMatch or RHS!.invertMatch){return(result)}

        if(!aItem!.RHS!.looseType()){
            result.listCase <- lcStrictLiteralLists
            if(worldManager!.isDefinitionListShapeOnly(aItem)){
                if(LHS!.value!.items.isEmpty() or
                        !worldManager!.
                        definitionListShapeNeedsMemberInstantiation(aItem)){
                    result.status <- rrHandledNoChange
                }else{
                    result.status <- rrNeedsWork
                    result.workAction <-
                            waInstantiateDefinitionListMembers
                }
            }
            else if(aItem!.LHS_item!.accessMode==aRefTo){
                result.status <- rrPlannedChange
                result.consolidationAction <- caCopyRHSIdentityToLHS
            }
            else{
                result.status <- rrNeedsWork
                result.workAction <- waStartListPropagation
            }
        }
        else{
            result.listCase <- lcLooseLiteralLists
            if(worldManager!.isDefinitionListShapeOnly(aItem)){
                if(LHS!.value!.items.isEmpty() or
                        !worldManager!.
                        definitionListShapeNeedsMemberInstantiation(aItem)){
                    result.status <- rrHandledNoChange
                }else{
                    result.status <- rrNeedsWork
                    result.workAction <-
                            waInstantiateDefinitionListMembers
                }
            }
            else{
                result.status <- rrNeedsWork
                result.workAction <- waStartListPropagation
            }
        }
        return(result)
    }
}

// Owns conversion of a local constraint against RHS alternatives into an
// intersection whose alternatives each retain that constraint.
struct IntersectionConsolidationStrategy{
    me InfonViewReasoningResult: planConsolidation(our AItem: aItem) <- {
        me InfonViewReasoningResult: result
        result.status <- rrNotApplicable
        result.directCase <- dcNone
        result.listCase <- lcNone
        result.intersectionCase <- icNone
        result.orderedSpanCase <- ocNone
        result.referenceCase <- rcNone
        result.consolidationAction <- caNone
        result.workAction <- waNone
        result.actionCommitPolicy <- cpNonInvertedAcceptance
        result.copySize <- false
        result.emitRejectLog <- false
        if(aItem==NULL or aItem!.LHS_item==NULL or aItem!.LHS_item!.pItem==NULL or
                aItem!.RHS==NULL or aItem!.RHS!.pItem==NULL){return(result)}

        our infonView: LHS <- aItem!.LHS_item!.pItem
        our infonView: RHS <- aItem!.RHS!.pItem
        if(LHS!.invertMatch or RHS!.invertMatch or
                RHS!.value!.evalMode!=emIntersection){return(result)}
        if(!aItem!.RHS!.looseType() and
                (LHS!.value!.overlayType==NUM or LHS!.value!.overlayType==STR) and
                (LHS!.value!.evalMode==emUnknown or LHS!.value!.evalMode==emLiteral) and
                (RHS!.value!.overlayType==tUnknown or
                 RHS!.value!.overlayType==LHS!.value!.overlayType) and
                RHS!.value!.evalMode==emIntersection){
            result.intersectionCase <- icStrictScalarAgainstIntersection
            result.status <- rrPlannedChange
            result.consolidationAction <- caMergeRHSIntersection
        }
        else if(LHS!.viewMode==vmAny and RHS!.value!.overlayType==tUnknown){
            result.intersectionCase <- icAnyAgainstIntersection
            result.status <- rrPlannedChange
            result.consolidationAction <- caMergeRHSIntersection
        }
        else if(!aItem!.RHS!.looseType() and LHS!.value!.overlayType==LST and
                (LHS!.value!.evalMode==emUnknown or LHS!.value!.evalMode==emLiteral) and
                (RHS!.value!.overlayType==tUnknown or RHS!.value!.overlayType==LST)){
            result.intersectionCase <- icStrictListAgainstIntersection
            result.status <- rrPlannedChange
            result.consolidationAction <- caMergeRHSIntersection
        }
        else if(LHS!.value!.evalMode==emConcat and
                (LHS!.value!.overlayType==NUM or LHS!.value!.overlayType==STR or
                 LHS!.value!.overlayType==LST)){
            result.intersectionCase <- icConcatAgainstIntersection
            result.status <- rrPlannedChange
            result.consolidationAction <- caMergeRHSIntersection
        }
        else if(!aItem!.RHS!.looseType() and
                LHS!.value!.overlayType==LST and LHS!.value!.evalMode==emIntersection and
                RHS!.value!.overlayType==tUnknown){
            result.intersectionCase <- icNestedIntersection
            result.status <- rrPlannedChange
            result.consolidationAction <- caMergeRHSIntersection
        }
        return(result)
    }

    me void: mergeRHSIntersect(our AItem: aItem) <- {
        our infonView: LHS <- aItem!.LHS_item!.pItem
        our infonView: RHS <- aItem!.RHS!.pItem
        if(RHS!.isOrLike()){
            me bool: isFromAlt <- aItem!.RHS!.linearAltID>0
            if(true or isFromAlt){RHS!.innr!.value!.tailUnfinished <- false}
            our infonView: newListInfon <- makeInnrInfonView()
            our POV: pov <- RHS!.innr!.value!.items.head
            while(pov!=NULL){
                our infonView:: altItem
                LHS!.copyAsTypeTo(altItem, false, true)
                altItem!.isTentative <- true
                our POV:: RHSPov{22}
                RHSPov! <- pov!
                RHSPov!.selectorLocalWork <- true
                altItem!.addPOVToWrkList(RHSPov)
                our POV: LHSPOV <- newListInfon!.value!.items.append(
                        altItem, pov!.isSubItm, 23)
                if(isFromAlt){LHSPOV!.isFromALT <- true}
                LHSPOV!.outerPOV <- aItem!.LHS_item
                LHSPOV!.predecessors <- pov!.predecessors
                pov <- pov!.next
            }
            LHS!.convertThisToIntersection(newListInfon, fromGiven)
            LHS!.innr!.value!.tailUnfinished <-
                    RHS!.innr!.value!.tailUnfinished
            LHS!.innr!.value!.sizeMode <- fromGiven
            LHS!.altRulesApplied <- false
        }else{
            log("MG_RHS_INSCT_NotAlt:"+aItem!.stringify())
        }
    }
}

// Owns local intersection semantics. IntersectProcessor retains only the
// rsIntersect continuation state machine, handler tracing, and lifecycle
// result; this reasoner prepares inner work and selects or installs results.
struct IntersectionReasoner{
    me IntersectionConsolidationStrategy: consolidationStrategy

    // An ordinary intersection may identify its selected source only through
    // the accepted alternative's predecessor chain. Accept the mapping only
    // when every mapped predecessor agrees on one exact source occurrence.
    me ViewMap: acceptedAlternativeSourceMap(our POV: selectedPOV) <- {
        me ViewMap: sourceMap
        if(selectedPOV==NULL){return(sourceMap)}
        me ViewMap: directMap <- matchedSourceMap(selectedPOV, NULL)
        if(directMap.sourcePov!=NULL and directMap.startPov!=NULL){
            return(directMap)
        }
        withEach predecessor in selectedPOV!.predecessors{
            me ViewMap: predecessorMap <-
                    matchedSourceMap(predecessor, NULL)
            if(predecessorMap.sourcePov==NULL or
                    predecessorMap.startPov==NULL){continue()}
            // A predecessor is the preceding pattern position, so its mapped
            // source occurrence is immediately before the surviving result.
            // Navigate by POV relationship; do not manufacture an index.
            our POV: selectedSourcePOV <-
                    predecessorMap.startPov!.logicalSiblingAtOffset(1)
            if(selectedSourcePOV==NULL){continue()}
            predecessorMap.startPov <- selectedSourcePOV
            if(sourceMap.sourcePov==NULL){
                sourceMap <- predecessorMap
            }else if(sourceMap.sourcePov!==predecessorMap.sourcePov or
                    sourceMap.startPov!==predecessorMap.startPov){
                me ViewMap: ambiguousMap
                return(ambiguousMap)
            }
        }
        return(sourceMap)
    }

    void: recordSelectedAlternativeReference(
            our AItem: aItem, our POV: selectedPOV) <- {
        if(aItem==NULL or aItem!.LHS_item==NULL or selectedPOV==NULL){return()}
        me ViewMap: sourceMap <-
                acceptedAlternativeSourceMap(selectedPOV)
        if(sourceMap.sourcePov==NULL or sourceMap.startPov==NULL){return()}
        their IdentityRegistry: registry <-
                sourceMap.sourcePov!.effectiveIdentityRegistry()
        if(registry==NULL){return()}
        registry!.recordSelectionReference(
                selectedPOV, aItem!.LHS_item,
                sourceMap.sourcePov, sourceMap.startPov,
                srkIntersectionCorrespondence, 0)
    }

    our SelectionReference: recordSelectedFunctionReference(
            our AItem: aItem, our POV: selectedPOV,
            our infonView: selectedResult) <- {
        if(aItem==NULL or aItem!.LHS_item==NULL or
                selectedPOV==NULL or selectedResult==NULL){return(NULL)}
        me ViewMap: sourceMap <-
                matchedSourceMap(aItem!.LHS_item, NULL)
        if(sourceMap.sourcePov==NULL or sourceMap.startPov==NULL){
            sourceMap <- matchedSourceMap(selectedPOV, NULL)
        }
        if(sourceMap.sourcePov==NULL or sourceMap.startPov==NULL){return(NULL)}
        their IdentityRegistry: registry <-
                sourceMap.sourcePov!.effectiveIdentityRegistry()
        if(registry==NULL){return(NULL)}
        me SelectionReferenceKind: referenceKind <- srkPositionalSelection
        if(aItem!.LHS_item!.pItem!=NULL and
                !aItem!.LHS_item!.pItem!.positionalSelection and
                aItem!.LHS_item!.pItem!.intersectPos==ipGetMarked){
            referenceKind <- srkIntersectionCorrespondence
        }
        if(aItem!.LHS_item!.pItem!=NULL and
                aItem!.LHS_item!.pItem!.selectionRequestID!=0){
            our SelectionRequest: request <- registry!.findSelectionRequest(
                    aItem!.LHS_item!.pItem!.selectionRequestID)
            if(request!=NULL and
                    request!.referenceKind==referenceKind){
                our POV: requestResultPOV <- request!.consumerResultPOV
                if(requestResultPOV==NULL){
                    requestResultPOV <- aItem!.LHS_item
                }
                return(registry!.recordSelectionReferenceForRequest(
                        request, requestResultPOV,
                        sourceMap.startPov))
            }
        }
        return(registry!.recordSelectionReference(
                selectedPOV, aItem!.LHS_item,
                sourceMap.sourcePov, sourceMap.startPov,
                referenceKind, 0))
    }

    me ViewMap: registeredSelectionSourceMap(our POV: resultPOV) <- {
        me ViewMap: sourceMap
        if(resultPOV==NULL){return(sourceMap)}
        their IdentityRegistry: registry <-
                resultPOV!.effectiveIdentityRegistry()
        if(registry==NULL){return(sourceMap)}
        our SelectionResolution: resolution <-
                registry!.resolveSelectionForResult(resultPOV)
        if(resolution==NULL or
                resolution!.resolutionState!=srsUnique or
                resolution!.references.isEmpty()){
            return(sourceMap)
        }
        our SelectionReference: reference <-
                resolution!.references.first()
        sourceMap.sourcePov <- reference!.sourceContextPOV
        sourceMap.startPov <- reference!.sourceStartPOV
        return(sourceMap)
    }

    // A mark is both a query occurrence and the value requested by <...>.
    // Recover the complete accepted relation so callers use its stored source
    // coordinate as well as its result POV.
    our SelectionReference: registeredMarkedSelectionReference(
            our POV: queryPOV) <- {
        if(queryPOV==NULL){return(NULL)}
        their IdentityRegistry: registry <-
                queryPOV!.effectiveIdentityRegistry()
        if(registry==NULL){return(NULL)}
        our SelectionResolution: resolution <-
                registry!.resolveSelectionForQuery(
                        queryPOV, srkMarkedSelection)
        if(resolution==NULL or
                resolution!.resolutionState!=srsUnique or
                resolution!.references.isEmpty()){
            return(NULL)
        }
        return(resolution!.references.first())
    }

    me ViewMap: matchedSourceMap(our POV: localViewPOV,
            our IntersectionTraversalPlan: plan) <- {
        me ViewMap: sourceMap
        if(localViewPOV==NULL){return(sourceMap)}
        if(localViewPOV!.viewMap.sourcePov!=NULL and
                localViewPOV!.viewMap.startPov!=NULL){
            sourceMap.sourcePov <- localViewPOV!.viewMap.sourcePov
            sourceMap.startPov <- localViewPOV!.viewMap.startPov
            return(sourceMap)
        }
        sourceMap <- registeredSelectionSourceMap(localViewPOV)
        if(sourceMap.sourcePov!=NULL and sourceMap.startPov!=NULL){
            return(sourceMap)
        }
        if(localViewPOV!.outerPOV!=NULL and
                !(localViewPOV!.outerPOV===localViewPOV)){
            sourceMap <- matchedSourceMap(localViewPOV!.outerPOV, plan)
            if(sourceMap.sourcePov!=NULL and sourceMap.startPov!=NULL){
                return(sourceMap)
            }
        }
        if(plan!=NULL and plan!.status==itpResolved and
                localViewPOV===plan!.localSourceViewPOV){
            sourceMap.sourcePov <- plan!.sourceContextPOV
            sourceMap.startPov <- plan!.sourceStartPOV
        }
        return(sourceMap)
    }

    void: mapAcceptedLocalViewTree(
            our IntersectionTraversalPlan: plan,
            our POV: localViewPOV) <- {
        if(plan==NULL or localViewPOV==NULL or localViewPOV!.pItem==NULL or
                localViewPOV!.pItem!.value!.overlayType!=LST){return()}
        our POV: localChild <- localViewPOV!.pItem!.value!.items.head
        while(localChild!=NULL){
            me ViewMap: childSourceMap <- matchedSourceMap(localChild, plan)
            if(childSourceMap.sourcePov!=NULL and
                    childSourceMap.startPov!=NULL){
                localChild!.mapViewToSource(
                        childSourceMap.sourcePov,
                        childSourceMap.startPov)
            }
            mapAcceptedLocalViewTree(plan, localChild)
            localChild <- localChild!.next
        }
    }

    void: recordAcceptedPOVPair(
            our IntersectionTraversalPlan: plan,
            our POV: patternPOV, our POV: localViewPOV) <- {
        if(plan==NULL or patternPOV==NULL or localViewPOV==NULL or
                patternPOV!.pItem==NULL or localViewPOV!.pItem==NULL){return()}
        me ViewMap: sourceMap <- matchedSourceMap(localViewPOV, plan)
        if(sourceMap.sourcePov==NULL or sourceMap.startPov==NULL){return()}
        localViewPOV!.mapViewToSource(
                sourceMap.sourcePov, sourceMap.startPov)
        patternPOV!.mapViewToSource(
                sourceMap.sourcePov, sourceMap.startPov)
        plan!.recordCorrespondence(patternPOV, localViewPOV,
                sourceMap.sourcePov, sourceMap.startPov)
        their IdentityRegistry: registry <-
                sourceMap.sourcePov!.effectiveIdentityRegistry()
        if(registry!=NULL){
            registry!.recordSelectionReference(
                    patternPOV, localViewPOV,
                    sourceMap.sourcePov, sourceMap.startPov,
                    srkIntersectionCorrespondence, 0)
        }
        mapAcceptedLocalViewTree(plan, localViewPOV)

        if(patternPOV!.pItem!.value!.overlayType!=LST or
                localViewPOV!.pItem!.value!.overlayType!=LST or
                patternPOV!.pItem!.value!.items.size()!=
                        localViewPOV!.pItem!.value!.items.size()){
            return()
        }
        our POV: patternChild <- patternPOV!.pItem!.value!.items.head
        our POV: localChild <- localViewPOV!.pItem!.value!.items.head
        while(patternChild!=NULL and localChild!=NULL){
            recordAcceptedPOVPair(plan, patternChild, localChild)
            patternChild <- patternChild!.next
            localChild <- localChild!.next
        }
    }

    me void: recordAcceptedPendingMarkedSelection(our AItem: aItem) <- {
        if(aItem==NULL or aItem!.pendingMarkedSelection==NULL){return()}
        our PendingSelectionCorrespondence: pending <-
                aItem!.pendingMarkedSelection
        enumerateAcceptedCompositeMarkedIdentity(pending)
        if(pending!.queryPOV==NULL or pending!.resultPOV==NULL or
                pending!.sourceContextPOV==NULL or
                pending!.sourceStartPOV==NULL){return()}
        their IdentityRegistry: registry <-
                pending!.sourceContextPOV!.effectiveIdentityRegistry()
        if(registry==NULL){return()}

        // A lower-level accepted merge may already have published this exact
        // marked occurrence before its enclosing list merge accepts.
        me List<our SelectionReference>: existingReferences
        registry!.collectSelectionReferencesForQuery(
                pending!.queryPOV, existingReferences)
        withEach existing in existingReferences{
            if(existing!.referenceKind==srkMarkedSelection and
                    existing!.resultPOV===pending!.resultPOV and
                    existing!.sourceStartPOV===pending!.sourceStartPOV){
                return()
            }
        }
        registry!.recordSelectionReference(
                pending!.queryPOV, pending!.resultPOV,
                pending!.sourceContextPOV, pending!.sourceStartPOV,
                srkMarkedSelection, 0)
    }

    // A transparent marked list is traversed as individual children. Once
    // every child has accepted an exact, consecutive source occurrence, list
    // identity implies the complete marked occurrence. Enumerate that
    // implication here; the first child alone is deliberately insufficient.
    me void: enumerateAcceptedCompositeMarkedIdentity(
            our PendingSelectionCorrespondence: pending) <- {
        if(pending==NULL or pending!.queryPOV==NULL or
                pending!.queryPOV!.pItem==NULL or
                pending!.queryPOV!.pItem!.value!.overlayType!=LST or
                pending!.queryPOV!.pItem!.value!.items.isEmpty()){
            return()
        }
        our POV: childPOV <-
                pending!.queryPOV!.pItem!.value!.items.head
        our POV: sourceContextPOV <- childPOV!.viewMap.sourcePov
        our POV: sourceStartPOV <- childPOV!.viewMap.startPov
        if(sourceContextPOV==NULL or sourceStartPOV==NULL){return()}

        me int64: childOffset <- 0
        while(childPOV!=NULL){
            if(!sameSourceContextView(
                        childPOV!.viewMap.sourcePov,
                        sourceContextPOV) or
                    childPOV!.viewMap.startPov==NULL){return()}
            our POV: expectedSourcePOV <-
                    sourceStartPOV!.logicalSiblingAtOffset(childOffset)
            if(expectedSourcePOV==NULL or
                    childPOV!.viewMap.startPov!==expectedSourcePOV){return()}
            childOffset <+- 1
            childPOV <- childPOV!.next
        }

        pending!.queryPOV!.mapViewToSource(
                sourceContextPOV, sourceStartPOV)
        pending!.resultPOV <- pending!.queryPOV
        pending!.sourceContextPOV <- sourceContextPOV
        pending!.sourceStartPOV <- sourceStartPOV
    }

    // carryPassiveSelectionSource takes owning snapshots of a raw traversal
    // parent. Distinct snapshots of the same pItem under the same parent name
    // the same source collection; the exact child POV still distinguishes
    // repeated occurrences within that collection.
    me bool: sameSourceContextView(our POV: first, our POV: second) <- {
        if(first===second){return(true)}
        return(first!=NULL and second!=NULL and
                first!.pItem===second!.pItem and
                first!.pParent===second!.pParent)
    }

    // Record source provenance only after this merge has accepted the POV
    // pair. Candidate propagation is not proof that the pair matched.
    void: recordAcceptedCorrespondence(our AItem: aItem) <- {
        if(aItem==NULL or aItem!.mergeStatus!=msAccept or
                aItem!.LHS_item==NULL or aItem!.RHS==NULL or
                aItem!.RHS!.pItem==NULL){return()}
        recordAcceptedPendingMarkedSelection(aItem)
        our IntersectionTraversalPlan: plan <-
                aItem!.activeIntersectionTraversalPlan()
        if(plan!=NULL and plan!.status==itpResolved){
            recordAcceptedPOVPair(plan, aItem!.LHS_item, aItem!.RHS)
            if(aItem!.LHS_item!.markedOuterPOV!=NULL and
                    aItem!.RHS!.pParent!=NULL and
                    aItem!.RHS!.pParent!.pItem!=NULL){
                // Tight traversal matched a child of a transparent marked
                // span. Reify the already matched local parent as the window
                // POV so the outer mark and every child receive one complete
                // correspondence instead of reconstructing it at selection.
                our POV:: matchedWindowPOV{povSrcConcreteSpanPrefix}
                matchedWindowPOV!.pItem <- aItem!.RHS!.pParent!.pItem
                recordAcceptedPOVPair(plan,
                        aItem!.LHS_item!.markedOuterPOV,
                        matchedWindowPOV)
            }
            return()
        }

        // For an ordinary intersection, carryPassiveSelectionSource has named
        // the exact candidate source on the pattern POV. Record the accepted
        // pair now; candidate propagation alone is not evidence.
        me ViewMap: sourceMap <- matchedSourceMap(
                aItem!.LHS_item, NULL)
        if(sourceMap.sourcePov==NULL or sourceMap.startPov==NULL){return()}
        their IdentityRegistry: registry <-
                sourceMap.sourcePov!.effectiveIdentityRegistry()
        if(registry==NULL){return()}
        registry!.recordSelectionReference(
                aItem!.LHS_item, aItem!.RHS,
                sourceMap.sourcePov, sourceMap.startPov,
                srkIntersectionCorrespondence, 0)
        if(aItem!.LHS_item!.markedOuterPOV!=NULL){
            // Tight traversal may accept a scalar inside a transparent marked
            // span. The accepted inner POV and the outer mark are two views
            // of the same selection result, so retain the explicit reverse
            // route instead of reconstructing it from tree shape later.
            registry!.recordSelectionReference(
                    aItem!.LHS_item,
                    aItem!.LHS_item!.markedOuterPOV,
                    sourceMap.sourcePov, sourceMap.startPov,
                    srkIntersectionCorrespondence, 0)
        }
    }

    me InfonViewReasoningResult: planConsolidation(our AItem: aItem) <- {
        return(consolidationStrategy.planConsolidation(aItem))
    }

    me void: mergeRHSIntersect(our AItem: aItem) <- {
        consolidationStrategy.mergeRHSIntersect(aItem)
    }

    // A negative size on an intersection inner list is an end-relative
    // origin, not a negative local cardinality. Resolve that origin into a
    // source-backed view before ordinary intersection propagation begins.
    our POV: prepareEndRelativeSourceView(our POV: lhsPOV,
            our POV: sourcePOV, me int64: sourceItemCount,
            our POV: preparedViewPOV) <- {
        if(lhsPOV==NULL or lhsPOV!.pItem==NULL or sourcePOV==NULL or
                sourcePOV!.pItem==NULL){return(sourcePOV)}
        our infonView: lhs <- lhsPOV!.pItem
        if(!lhs!.isInnr or lhs!.infSize!.overlayType!=NUM or
                lhs!.infSize!.evalMode!=emLiteral or lhs!.infSize!.num>=0){
            return(sourcePOV)
        }

        me int64: offset <- lhs!.infSize!.num.convertToInt()
        me int64: patternItemCount <- 0 - offset
        if(sourceItemCount<=0){sourceItemCount <- patternItemCount}
        our POV: viewPOV <- preparedViewPOV
        if(viewPOV==NULL){
            viewPOV <- sourcePOV!.makeEndRelativeSpanView(
                    sourcePOV, 0 - sourceItemCount,
                    povSrcEndRelativeView)
        }
        if(viewPOV==NULL){return(sourcePOV)}

        viewPOV!.looseMode <- sourcePOV!.looseMode
        viewPOV!.looseTop <- sourcePOV!.looseTop
        viewPOV!.looseInhtd <- sourcePOV!.looseInhtd
        viewPOV!.isOutrFeed <- sourcePOV!.isOutrFeed
        lhs!.infSize!.num <- patternItemCount
        lhs!.retainPOV(viewPOV)
        return(viewPOV)
    }

    me void: prepareInnerContext(our AItem: aItem) <- {
        our infonView: CI <- aItem!.LHS_item!.pItem
        if(CI!.hasInnrOutr){
            our POV: newPOV <- CI!.innr!.addInfonViewToWrkList(
                    CI!.innr!.funcArgs, true, 24)
            newPOV!.selectorLocalWork <- true
            newPOV!.looseTop <- true
            CI!.hasInnrOutr <- false
            CI!.innr!.funcArgs <- NULL
        }
        if(CI!.intersectMarkedRetPOV!=NULL){
            CI!.innr!.intersectMarkedRetPOV <- CI!.intersectMarkedRetPOV
        }
    }

    me void: prepareAlternatives(their WorldManager: worldManager,
            their Agenda: agenda, our AItem: aItem,
            their List<our AItem>: requestedWork) <- {
        our infonView: CI <- aItem!.LHS_item!.pItem
        our infonView: innr <- CI!.innr
        // EXPERIMENT for the innr/oneOf/Aaron bug: always normalize the innr.
        // Its members each normalize individually, getting aRefTo (identity)
        // + umQuestion (filter) via the child-direction flags propagated
        // through prepareInfonWork. No separate buildIntersectOrAlts pass;
        // selection later picks the survivor. But get the other tests to pass
        // as the above makes many tests fail.
        if(!innr!.value!.tailUnfinished){
            our POV: innrPov <- innr!.value!.items.head
            while(innrPov != NULL){
                if(innrPov!.outerPOV==NULL){
                    innrPov!.outerPOV <- aItem!.LHS_item
                }
                our AItem: PIVA <- worldManager!.prepareInfonWork(
                        agenda, innrPov, NULL, aItem, aprListCompletion,
                        aItem!.priority, srcItsALT)
                PIVA!.LHS_item!.pItem!.takeWrkListFrom(
                        aItem!.LHS_item!.pItem, false)
                PIVA!.LHS_item!.accessMode <- aRefTo
                PIVA!.LHS_item!.pItem!.useMode <- umQuestion
                //log("QUESTION-in-b:"+PIVA!.LHS_item!.pItem!.mySymbol()+" = "+toString(PIVA!.LHS_item!.pItem))
                //:l/PAI::logSeg(" IC0_orPIVA:"+PIVA!.mySymbol())
                addDebugEvent("RegisterPIVA to integrate OR intersect "+
                        innrPov!.pItem!.mySymbol()+":"+
                        toString(innrPov!.pItem), innrPov!.pItem)
                requestedWork.append(PIVA)
                innrPov <- innrPov!.next
            }
            aItem!.LHS_item!.pItem!.clearWrkList() //TODO: is this necessary?
        }
    }

    me void: prepareFunction(their WorldManager: worldManager,
            their Agenda: agenda, our AItem: aItem,
            their List<our AItem>: requestedWork) <- {
        our infonView: CI <- aItem!.LHS_item!.pItem
        our POV:: srcPOV{25}
        srcPOV!.pItem <- CI!.innr
        srcPOV!.bindIdentityRegistry(
                aItem!.LHS_item!.effectiveIdentityRegistry())
        CI!.retainPOV(srcPOV)
        our AItem: PIVA <- worldManager!.prepareInfonWork(
                agenda, srcPOV, aItem, NULL, aprNoParent,
                aItem!.priority, srcItsFunc)
        if(PIVA!=NULL){
            //:l/PAI::logSeg(" IC0_funcPIVA:"+PIVA!.mySymbol())
            requestedWork.append(PIVA)
            //:l/PAI::logSeg(" IC0_funcPIVA:"+PIVA!.mySymbol())
            addDebugEvent("RegisterPIVA to integrate func intersect "+
                    srcPOV!.pItem!.mySymbol()+":"+toString(srcPOV!.pItem),
                    srcPOV!.pItem)
        }
    }

    our infonView: selectAlternative(their WorldManager: worldManager,
            our AItem: aItem) <- {
        our infonView: CI <- aItem!.LHS_item!.pItem
        our infonView: innr <- CI!.innr
        our infonView: newTop <- NULL
        me string: idnt <- indentStr(aItem!.indentLvl)
        // Eliminate if only 1 non-rejected alternative remains.
        //TODO: Perhaps we can skip the following if there is exactly one candidateForLast
        if(!innr!.value!.tailUnfinished){
            our POV: lastOK <- NULL
            me int: numOK <- 0
            our POV: pov <- innr!.value!.items.head
            while(pov != NULL){
                // TODO: if(sizesNotCompatable()){markAsReject or notLast}
                me string: logPredString
                if(!pov!.predecessors.isEmpty()){
                    logPredString <- "  Pred:"+pov!.predecessors[0]!.stringify()
                }
                // Is this really valid? The correct item could merely be
                // unknown. Existing tests currently depend on this filter.
                me bool: unresolvedAlt <- pov!.pItem!.type==NULL and
                        pov!.pItem!.viewMode==vmAny and
                        (pov!.pItem!.value!.overlayType==tUnknown or
                         pov!.pItem!.value!.overlayType==tUnset)
                if(!pov!.rejected and !unresolvedAlt){
                    //:l/PAI::log(idnt+"            ALT:"+ pov!.mySymbol()+":"+ shortedStr(pov!.stringify(),100) + shortedStr(logPredString,100))
                    numOK <+- 1
                    lastOK <- pov
                }else{
                    //:l/PAI::log(idnt+"          x ALT:"+ pov!.mySymbol()+":"+ shortedStr(pov!.stringify(),100) + shortedStr(logPredString,100))
                }
                pov <- pov!.next
            }
            if(numOK==1){
                newTop <- lastOK!.pItem
                recordSelectedAlternativeReference(aItem, lastOK)
                aItem!.parent!.dontProcess <- true
                aItem!.LHS_item!.forLastUseOutrPov <- true
                if(!(lastOK!.outerPOV!=NULL and
                        lastOK!.outerPOV===aItem!.LHS_item)){
                    aItem!.LHS_item!.predecessors <- lastOK!.predecessors
                }
                if(newTop!.isTentative){
                    newTop!.isTentative <- aItem!.LHS_item!.pItem!.isTentative
                    if(lastOK!.predecessors.size()==1){
                        our POV: pred <- lastOK!.predecessors[0]
                        worldManager!.validateItem(pred)
                    }
                }
            }else if(numOK==0){
                innr!.value!.items.clear()
                innr!.value!.sizeMode <- fromCount
                innr!.infSize!.num <- 0
                innr!.infSize!.evalMode <- emLiteral
                CI!.value!.undefined <- true
                CI!.partRef <- NULL
                CI!.parts.clear()
            }
        }else{log("TODO: IS_OR_LIKE: tailUnfinished")}
        return(newTop)
    }

    our infonView: selectFunctionResult(their WorldManager: worldManager,
            our AItem: aItem) <- {
        our infonView: CI <- aItem!.LHS_item!.pItem
        our infonView: innr <- CI!.innr
        our infonView: newTop <- NULL
        our POV: selectedResultPOV
        switch(CI!.intersectPos){
            case ipGetLast:{
                our POV: innrSourcePOV <- NULL
                withEach retainedPOV in CI!.retainedPOVs{
                    if(retainedPOV!=NULL and retainedPOV!.pItem===innr){
                        innrSourcePOV <- retainedPOV
                        break()
                    }
                }
                if(innrSourcePOV==NULL){
                    Allocate(innrSourcePOV)
                    innrSourcePOV!.pedigree.source <-
                            povSrcEndRelativeReference
                    innrSourcePOV!.pItem <- innr
                    innrSourcePOV!.bindIdentityRegistry(
                            aItem!.LHS_item!.
                            effectiveIdentityRegistry())
                    CI!.retainPOV(innrSourcePOV)
                }
                selectedResultPOV <- innrSourcePOV!.getLastPOV()
                newTop <- worldManager!.selectReturnedInfonViewFromPOV(
                        aItem, selectedResultPOV)
            }
            case ipGetFirst:{
                newTop <- innr!.getFirstItem(aItem!.LHS_item!.isSubItm)
                selectedResultPOV <- innr!.value!.items.head
                if(selectedResultPOV!=NULL and
                        selectedResultPOV!.pItem!==newTop){
                    // getFirstItem may descend through a subitem. Preserve
                    // that established behavior until its exact nested POV
                    // is returned by the navigation API.
                    selectedResultPOV <- NULL
                }
            }
            case ipGetMarked:{
                if(innr!.intersectMarkedRetPOV!=NULL and
                        innr!.intersectMarkedRetPOV!.pItem!.isTentative and
                        innr!.intersectMarkedRetPOV!.pParent!=NULL and
                        !(innr!.intersectMarkedRetPOV!.pParent!.pItem===innr)){
                    Allocate(newTop)
                    newTop!.viewMode <- vmOverlay
                    newTop!.infSize!.evalMode <- emUnknown
                    newTop!.value!.evalMode <- emLiteral
                    newTop!.value!.overlayType <- LST
                    innr!.intersectMarkedRetPOV!.addNewSubDots <- true
                    // The mark selects a slice position. Keep the list-view
                    // shape, but tie its first slot back to the source POV.
                    our POV: markedWrapperPOV <- newTop!.value!.items.append(
                            innr!.intersectMarkedRetPOV!.pItem,
                            innr!.intersectMarkedRetPOV!.isSubItm, 304)
                    markedWrapperPOV!.outerPOV <- innr!.intersectMarkedRetPOV
                    markedWrapperPOV!.accessMode <- aRefTo
                    markedWrapperPOV!.tentFromDots <-
                            innr!.intersectMarkedRetPOV!.tentFromDots
                    newTop!.countSize(false)
                }else{
                    // TODO: Is this sparse exposed-head case special, or
                    // should it be generalized?
                    if(innr!.intersectMarkedRetPOV!=NULL and
                            innr!.intersectMarkedRetPOV!.pedigree.source==
                                    povSrcSparseExposedHead){
                        newTop <- innr!.intersectMarkedRetPOV!.pItem
                    }else if(CI!.intersectMarkedRetPOV!=NULL){
                        newTop <- CI!.intersectMarkedRetPOV!.pItem
                    }
                }
            }
        }
        our POV: mappedSelectionPOV <- NULL
        our POV: selectedSingleOccurrence
        me bool: requiresRelationalListMerge <- false
        withEach consumerWorkPOV in CI!.wrkList{
            if(consumerWorkPOV!=NULL and
                    !consumerWorkPOV!.selectorLocalWork and
                    consumerWorkPOV!.pItem!=NULL and
                    consumerWorkPOV!.pItem!.value!.overlayType==LST and
                    consumerWorkPOV!.pItem!.value!.tailUnfinished){
                requiresRelationalListMerge <- true
                break()
            }
        }
        me ViewMap: mappedSelectionSourceMap
        if(CI!.intersectPos==ipGetMarked and innr!=NULL){
            mappedSelectionPOV <- innr!.intersectMarkedRetPOV
            our SelectionReference: registeredSelection <-
                    registeredMarkedSelectionReference(
                            mappedSelectionPOV)
            if(registeredSelection!=NULL){
                mappedSelectionPOV <- registeredSelection!.resultPOV
                newTop <- mappedSelectionPOV!.pItem
                mappedSelectionSourceMap.sourcePov <-
                        registeredSelection!.sourceContextPOV
                mappedSelectionSourceMap.startPov <-
                        registeredSelection!.sourceStartPOV
            }
            selectedResultPOV <- mappedSelectionPOV
            if(mappedSelectionSourceMap.sourcePov==NULL or
                    mappedSelectionSourceMap.startPov==NULL){
                mappedSelectionSourceMap <-
                        matchedSourceMap(mappedSelectionPOV, NULL)
            }
            if(mappedSelectionSourceMap.sourcePov!=NULL and
                    mappedSelectionSourceMap.startPov!=NULL){
                // Materialize this implication on the result wrapper so the
                // ordinary reference recorder and mapped-write planner both
                // consume the same accepted registry evidence.
                aItem!.LHS_item!.viewMap.sourcePov <-
                        mappedSelectionSourceMap.sourcePov
                aItem!.LHS_item!.viewMap.startPov <-
                        mappedSelectionSourceMap.startPov
            }
        }
        our SelectionReference: selectedReference
        if(newTop!=NULL){
            selectedReference <- recordSelectedFunctionReference(
                    aItem, selectedResultPOV, newTop)
        }
        if(CI!.selectionRequestID!=0){
            their IdentityRegistry: registry <-
                    aItem!.LHS_item!.effectiveIdentityRegistry()
            if(registry!=NULL){
                our SelectionRequest: request <-
                        registry!.findSelectionRequest(
                                CI!.selectionRequestID)
                our POV: exactSourceStart
                if(mappedSelectionSourceMap.sourcePov!=NULL and
                        mappedSelectionSourceMap.startPov!=NULL){
                    exactSourceStart <-
                            mappedSelectionSourceMap.startPov
                }else if(selectedReference!=NULL and
                        selectedReference!.sourceStartPOV!=NULL){
                    exactSourceStart <-
                            selectedReference!.sourceStartPOV
                }else if(aItem!.LHS_item!.viewMap.sourcePov!=NULL and
                        aItem!.LHS_item!.viewMap.startPov!=NULL){
                    exactSourceStart <-
                            aItem!.LHS_item!.viewMap.startPov
                }
                if(request!=NULL and exactSourceStart!=NULL){
                    our POV: requestResultPOV <-
                            request!.consumerResultPOV
                    if(requestResultPOV==NULL){
                        requestResultPOV <- aItem!.LHS_item
                    }
                    registry!.recordSelectionReferenceForRequest(
                            request, requestResultPOV,
                            exactSourceStart)
                    selectedSingleOccurrence <- registry!.
                            resolveSingleSelectedOccurrence(
                                    request!.requestID)
                }
            }
        }
        if(CI!.intersectPos==ipGetMarked and
                mappedSelectionPOV!=NULL and
                mappedSelectionSourceMap.sourcePov!=NULL and
                mappedSelectionSourceMap.startPov!=NULL){
            aItem!.LHS_item!.viewMap.sourcePov <-
                    mappedSelectionSourceMap.sourcePov
            aItem!.LHS_item!.viewMap.startPov <-
                    mappedSelectionSourceMap.startPov
            if(mappedSelectionPOV!.pItem!=NULL and
                    mappedSelectionPOV!.pItem!.value!.overlayType==LST){
                newTop <- mappedSelectionPOV!.pItem
            }
            if(CI!.partRef==NULL and CI!.parts.isEmpty() and
                    CI!.hasConsumerWork()){
                if(requiresRelationalListMerge){
                    // An open list is a relation to solve against the selected
                    // span, not a fixed positional replacement. Its accepted
                    // child correspondences retain the source routes used by
                    // ordinary propagation.
                    mappedSelectionPOV!.viewMapWriteEnabled <- false
                    aItem!.LHS_item!.accessMode <- aCopyOf
                    aItem!.LHS_item!.viewMapWriteEnabled <- false
                }else{
                    mappedSelectionPOV!.viewMapWriteEnabled <- true
                    aItem!.LHS_item!.accessMode <- aRefTo
                    aItem!.LHS_item!.viewMapWriteEnabled <- true
                }
            }
            if(aItem!.LHS_item!.viewMapWriteEnabled and
                    CI!.intersectMarkedRetPOV!=NULL and
                    CI!.intersectMarkedRetPOV!.pItem!=NULL and
                    CI!.intersectMarkedRetPOV!.pItem!.value!.overlayType!=LST){
                    newTop <- mappedSelectionSourceMap.startPov!.pItem
            }else if(mappedSelectionPOV!.pItem!=NULL and
                    mappedSelectionPOV!.pItem!.value!.overlayType!=LST){
                // The mapped scalar names an exact source for reads too. Keep
                // the result detached unless consumer work explicitly grants
                // write-through authority above.
                our infonView:: detachedMappedValue
                mappedSelectionSourceMap.startPov!.pItem!.copyAsTypeTo(
                        detachedMappedValue, false, false)
                newTop <- detachedMappedValue
            }
        }else if(CI!.intersectPos==ipGetMarked and
                newTop!=NULL and
                newTop!.value!.overlayType!=LST and
                selectedReference!=NULL){
            // A transparent/nested match can return the exact materialized
            // source POV without putting a ViewMap on the marked wrapper.
            // Use only the accepted registry relation; never infer a
            // composite result from its first child.
            aItem!.LHS_item!.viewMap.sourcePov <-
                    selectedReference!.sourceContextPOV
            aItem!.LHS_item!.viewMap.startPov <-
                    selectedReference!.sourceStartPOV
            if(CI!.partRef==NULL and CI!.parts.isEmpty() and
                    CI!.hasConsumerWork()){
                aItem!.LHS_item!.accessMode <- aRefTo
                aItem!.LHS_item!.viewMapWriteEnabled <- true
                newTop <- selectedReference!.sourceStartPOV!.pItem
            }else{
                // A read returns the value at the exact accepted source, but
                // remains detached so installing reply metadata cannot mutate
                // that source or accidentally grant write-through authority.
                our infonView:: detachedSelectedValue
                selectedReference!.sourceStartPOV!.pItem!.copyAsTypeTo(
                        detachedSelectedValue, false, false)
                newTop <- detachedSelectedValue
            }
        }
        if(selectedSingleOccurrence!=NULL and
                CI!.partRef==NULL and CI!.parts.isEmpty() and
                CI!.hasConsumerWork()){
            // Apply the consumer's identity to the source endpoint obtained
            // by reversing the accepted single-item selection relation.  A
            // range remains a mapped view because its first source POV is not
            // the whole selected span.  The selection relation is not itself
            // a full graph identity: install the resolved source infon and let
            // its ordinary consumer work perform the requested merge.
            aItem!.LHS_item!.accessMode <- aCopyOf
            aItem!.LHS_item!.viewMapWriteEnabled <- false
            newTop <- selectedSingleOccurrence!.pItem
        }
        if(newTop!=NULL){
            // The selected value owns only work from its consumer. Matching
            // obligations remain local to the selector that created them.
            newTop!.discardSelectorLocalWork()
            newTop!.takeConsumerWorkFrom(CI, true)
            //:l/PAI::logSeg(" GET_LAST")
        }else{CI!.value!.undefined <- true}
        return(newTop)
    }

    me void: installSelectedResult(our AItem: aItem,
            our infonView: newTop) <- {
        if(newTop==NULL){return()}
        our infonView: CI <- aItem!.LHS_item!.pItem
        if(CI!.itmMode!=mNone){newTop!.itmMode <- CI!.itmMode}
        newTop!.doReply <- CI!.doReply
        newTop!.partRef <- CI!.partRef
        newTop!.parts <- CI!.parts
        // TODO: This changes the original; origin probably belongs on the POV
        // or AItem instead.
        newTop!.originID <- CI!.originID
        newTop!.infCharPos <- CI!.infCharPos
        if(CI!.value!.undefined){newTop!.value!.undefined <- true}
        if(newTop!==CI){
            // The selected graph may still reach temporary POVs through
            // non-owning pParent links after the intersection wrapper is gone.
            withEach retainedPOV in CI!.retainedPOVs{
                newTop!.retainPOV(retainedPOV)
            }
        }
        aItem!.LHS_item!.pItem <- newTop
    }
}

// Plans sparse ordered-span alignment without mutating either source graph.
// Execution performs at most one prefix split and returns an RHS remainder
// through the same propagation contract used by the legacy implementation.
struct OrderedSpanReasoner{
    me InfonViewReasoningResult: planConsolidation(their WorldManager: worldManager,
            our AItem: aItem) <- {
        me InfonViewReasoningResult: result
        result.status <- rrNotApplicable
        result.directCase <- dcNone
        result.listCase <- lcNone
        result.intersectionCase <- icNone
        result.orderedSpanCase <- ocNone
        result.referenceCase <- rcNone
        result.consolidationAction <- caNone
        result.workAction <- waNone
        result.actionCommitPolicy <- cpNonInvertedAcceptance
        result.copySize <- false
        result.emitRejectLog <- false
        if(aItem==NULL or aItem!.LHS_item==NULL or aItem!.RHS==NULL or
                !aItem!.LHS_item!.isSparseOrderedSpan() or
                !aItem!.RHS!.isSparseOrderedSpan()){
            return(result)
        }

        me int64: lhsCount <- aItem!.LHS_item!.sparseSpanCount()
        me int64: rhsCount <- aItem!.RHS!.sparseSpanCount()
        if(aItem!.LHS_item!.sparseSpanCompatibleWith(aItem!.RHS)){
            if(lhsCount==rhsCount){
                result.orderedSpanCase <- ocExactAlignment
                result.orderedSpanSizeToCopy <- lhsCount
            }
            else if(lhsCount<rhsCount){
                result.orderedSpanCase <- ocSplitRHS
                result.orderedSpanSplitCount <- lhsCount
                result.orderedSpanSizeToCopy <- lhsCount
            }
            else{
                result.orderedSpanCase <- ocSplitLHS
                result.orderedSpanSplitCount <- rhsCount
                result.orderedSpanSizeToCopy <- rhsCount
            }
        }
        else{
            me vocabularySpec: vSpec
            vSpec.init(worldManager!.agent!.getLocaleBaseName())
            our OrderedSpanConverter: spanConverter <- modelMngr.getOrderedSpanConverter(
                    aItem!.LHS_item!.pItem!.value!.listSpec!.type,
                    aItem!.RHS!.pItem!.value!.listSpec!.type, vSpec)
            if(spanConverter==NULL or !spanConverter!.valid){return(result)}

            me int64: lhsBaseCount <- lhsCount * spanConverter!.fromBaseCount
            me int64: rhsBaseCount <- rhsCount * spanConverter!.toBaseCount
            if(lhsBaseCount==rhsBaseCount){
                result.orderedSpanCase <- ocExactAlignment
                result.orderedSpanSizeToCopy <- lhsCount
            }
            else if(lhsBaseCount<rhsBaseCount){
                me int64: rhsPrefixCount <- lhsBaseCount / spanConverter!.toBaseCount
                if(rhsPrefixCount<=0 or rhsPrefixCount>=rhsCount or
                        rhsPrefixCount*spanConverter!.toBaseCount!=lhsBaseCount){
                    return(result)
                }
                result.orderedSpanCase <- ocSplitRHS
                result.orderedSpanSplitCount <- rhsPrefixCount
                result.orderedSpanSizeToCopy <- lhsCount
            }
            else{
                me int64: lhsPrefixCount <- rhsBaseCount / spanConverter!.fromBaseCount
                if(lhsPrefixCount<=0 or lhsPrefixCount>=lhsCount or
                        lhsPrefixCount*spanConverter!.fromBaseCount!=rhsBaseCount){
                    return(result)
                }
                result.orderedSpanCase <- ocSplitLHS
                result.orderedSpanSplitCount <- lhsPrefixCount
                result.orderedSpanSizeToCopy <- lhsPrefixCount
            }
        }

        result.status <- rrPlannedChange
        result.consolidationAction <- caApplyOrderedSpanPlan
        // Match the legacy merge's positive-template mutation ordering.
        result.actionCommitPolicy <- cpPositiveTemplateAcceptance
        return(result)
    }

    our POV: execConsolidationPlan(our AItem: aItem,
            their InfonViewReasoningResult: result) <- {
        our POV: remainder <- NULL
        aItem!.sizeToCopy <- result.orderedSpanSizeToCopy
        if(result.orderedSpanCase==ocSplitRHS){
            remainder <- aItem!.RHS!.splitSparseSpanPrefix(result.orderedSpanSplitCount)
        }
        else if(result.orderedSpanCase==ocSplitLHS){
            aItem!.LHS_item!.splitSparseSpanPrefix(result.orderedSpanSplitCount)
        }
        return(remainder)
    }
}

// Retains the generated semantic traps as an explicit diagnostic boundary for
// merge families that have not yet acquired agreed behavior.
struct GeneratedMergeTrapStrategy{
    our POV: mergeInfonStates(their WorldManager: worldManager, our AItem: aItem) <- {
        aItem!.phase1RecordHandler("strategy:generatedMergeTrap", false)
        return(worldManager!.mergeRules(aItem))
    }
}

// Discovers member correspondence for unordered records, placing compatible
// RHS fields on the matching LHS work lists for ordinary local reasoning.
struct CorrespondenceReasoner{
    me bool: processUnorderedInfonViews(their WorldManager: worldManager,
            their Agenda: agenda, our AItem: aItem, their bool: contnue,
            their List<our AItem>: requestedWork) <- {
        // Handle Unordered infons
        our infonView: LHS_item <- aItem!.LHS_item!.pItem
        me OrderMode: LHSOrderMode <- LHS_item!.getOrderMode(worldManager!.agent)
        me OrderMode: RHSOrderMode <- uOrdered
        //log("LHSOrderMode: "+OrderModeStrings[LHSOrderMode]+" RHSOrderMode:"+OrderModeStrings[RHSOrderMode])
        if(aItem!.RHS!=NULL){RHSOrderMode <- aItem!.RHS!.pItem!.getOrderMode(worldManager!.agent)}
        if(aItem!.RHS!=NULL and(LHSOrderMode==uUnordered or RHSOrderMode==uUnordered)){
            if(LHSOrderMode==uUnordered and RHSOrderMode==uUnordered){
                me int: count <- 0
                our POV: RHS_pov <- aItem!.RHS!.pItem!.value!.items.head
                me int64: crntPriority <- aItem!.priority
                me int: priorityIdx <- 0
                while(RHS_pov != NULL){
                    our infonView: RHS_item <- RHS_pov!.pItem
                    me string: fieldName <- ""
                    fleshOutWord(worldManager!.agent, RHS_item)
                    if(RHS_item!.type!=NULL){
                        fieldName <- RHS_item!.type!.typeID()
                        our POV: LHS_Pov <- LHS_item!.fetchCompatibleField(worldManager!.agent, RHS_item)
                        if(LHS_Pov!=NULL){
                            // This 'if' is an optimization. Something similar can be done for "ordered" infons.
                            // NOTE (search/adj1 investigation, 2026-04):
                            // If this optimization skips merge work for a same-type "type example",
                            // verify that no concrete constraints are being skipped with it.
                            if(!(LHS_Pov!.pItem!.type!=NULL and RHS_item!.type!=NULL and RHS_item!.isTypeExample and LHS_Pov!.pItem!.infonViewHasType(RHS_item!.type!.typeID()))){
                                our POV: pov <- LHS_Pov!.pItem!.addInfonViewToWrkList(RHS_item, true, 417)
                                RHS_item!.streamState <- notParsing
                                if(pov!=NULL and LHS_Pov!.hasPropagated){
                                    our AItem: PIVA <- worldManager!.prepareInfonWork(
                                            agenda, LHS_Pov, NULL, aItem,
                                            aprListCompletion,
                                            crntPriority+priorityIdx,
                                            srcUnordd)
                                    if(PIVA!=NULL){
                                        //:l/PAI::logSeg(" UNORD_PIVA:"+PIVA!.mySymbol())
                                        requestedWork.append(PIVA) // PIVA
                                        contnue! <- false
                                    }
                                    priorityIdx <- priorityIdx + 1
                                }
                              //  S <+- "    FOUND("+fieldName+"):"+LHS_Pov!.pItem!.type!.typeID()+" = "+toString(RHS_item)+"\n"
                            }//else{S <+- "    SKIPPING "+fieldName+"\n"}
                        } else {
                            if(RHS_item!.isFromDefn){ // Create the field. Optimize: Only do this when needed; COW
                                our infonView:: newField
                                newField! <- RHS_item!
                                newField!.copySource <- RHS_item
                                newField!.copySourceType <- cstDefinition
                                our POV: newPov <- LHS_item!.value!.items.append(newField, RHS_pov!.isSubItm, 444)
                                LHS_item!.infSize!.num <+- 1
                              //  S <+- "    Creating field: '"+fieldName+"' = "+toString(RHS_item)+"\n"
                            } else {
                                print("WARNING: compatable LHS infon Field not found: '",fieldName,"'\n")
                                log("// Proteus WARNING: compatable LHS infon Field not found. '"+fieldName+"'::"+toString(aItem))
                            }
                        }
                    } else {
                        //logFatalError("RHS infon Field not identified:'"+fieldName+"'::"+toString(aItem))
                        print("// Proteus WARNING: could not find:"+toString(RHS_item)+" in:\n    "+toString(LHS_item)+"\n")
                    } // TODO: Try . find
                    count <- count+1
                    RHS_pov <- RHS_pov!.next
                }
     // ** This 'regular' norming needs to happen at least once. After that, We can add "FOUND" items directly to the agenda. Should they be interweaved or done 1 at a time with subscriptions?
                aItem!.skipRHSUsageInPAI <- true
            } else {
                if(aItem!.RHS!=NULL and aItem!.RHS!.pItem!.intersectPos==ipNoIntersect){
                    me bool: LHSIsUnresolvedUnknown <- LHS_item!.viewMode==vmAny and (LHS_item!.value!.overlayType==tUnknown or LHS_item!.value!.overlayType==tUnset)
                    me bool: RHSIsUnresolvedUnknown <- aItem!.RHS!.pItem!.viewMode==vmAny and (aItem!.RHS!.pItem!.value!.overlayType==tUnknown or aItem!.RHS!.pItem!.value!.overlayType==tUnset)
                    if(LHSIsUnresolvedUnknown or RHSIsUnresolvedUnknown){
                        return(false)
                    }else{
                        aItem!.mergeStatus <- msReject
                        print("// Proteus NOTICE: Unordered/ordered missmatch: "+aItem!.stringify()+"\n")
                    }
                }
               // log("Unordered infon + ordered infon not yet handled. "+toString(aItem)+" LHSOrderMode:"+OrderModeStrings[LHSOrderMode]+" RHSOrderMode:"+OrderModeStrings[RHSOrderMode])
                return(false)
            }
            return(true)
        }
        return(false)
    }
}

// Maps word references and function arguments to the definition-backed or
// member-backed RHS candidates they imply.
struct ReferenceMapper{
    me bool: derefInfonView(their WorldManager: worldManager, our infonView: CI) <- {
        if(CI!.wordDerefed){return(false)}
        me bool: changeMade  <- false
        modelMngr.completeItemsType(CI)
        if(CI!.wordDerefed){return(true)}
        if(CI!.type!=NULL and CI!.itmMode!=mWordDefn){
        // TODO: move vSpec into agent
        me vocabularySpec: vSpec
        vSpec.init(worldManager!.agent!.getLocaleBaseName())
            our infonView: infModel  <- modelMngr.constructAltModelFromWord(worldManager!.agent, CI!.type, vSpec, "scope")
            if(infModel!=NULL){
                //log("derefWord:'"+CI!.type!.asGiven+"'    infModel:"+toString(infModel))
                infModel!.generality <- gAbstract
                if(CI!.viewMode!=vmAny){
                    if(infModel!.viewMode!=vmAny){
                        //:l/PAI::logSeg(" WRD_VAL:'"+CI!.type!.asGiven+"'")
                        CI!.generality <- gConcrete  // TODO: This may not always be the case.
                        our POV: newPov <- CI!.addInfonViewToWorkListWithPriority(infModel, true)
                        if(newPov===NULL){return(false)}
                        else{newPov!.trueByDefinition <- true}
                    }// else{log("SKIPPED:"+toString(infModel)}
                }else{
                    //:l/PAI::logSeg(" WRDxVAL:'"+CI!.type!.asGiven+"'")
                    our WordUse:CIsType <- CI!.type
                    me bool: invertMatch <- CI!.invertMatch
                    me uint64: itmMode <- CI!.itmMode
                    me List<our PartPath>: parts <- CI!.parts
                    our PartPath: partRef <- CI!.partRef
                    infModel!.copyAsTypeTo(CI, false, false)
                    CI!.copySource <- infModel
                    CI!.copySourceType <- cstDefinition
                    CI!.type    <- CIsType
                    CI!.invertMatch   <- invertMatch
                    CI!.parts   <- parts
                    CI!.partRef <- partRef
                    CI!.itmMode <- itmMode
                    CI!.isTypeExample <- true
                    CI!.alreadyTypeChecked <- true
                }
                if(infModel!.type!=NULL and !CI!.infonViewHasType(infModel!.type!.typeID())){CI!.addedTypes.append(infModel!.type)}
                changeMade <- true
            }else{
                //:l/PAI::logSeg(" WRD:ERR")
                worldManager!.agent!.setErrorState("'"+CI!.type!.asGiven+"' is not defined\n\n")
                //print("\n\n The word '"+CI!.type!.asGiven+"' is not defined\n\n"); exit(3)
                //log("// Proteus NOTICE: The word '"+CI!.type!.asGiven+"' is not defined")
            }
            CI!.wordDerefed <-true
        }
        return(changeMade)
    }
    me bool: derefWordRules(their WorldManager: worldManager, our AItem: aItem) <- {
        our POV: CIPov    <- aItem!.LHS_item
        our infonView: CI     <- CIPov!.pItem
        me bool: derefLHS <- false
        if(CIPov!=NULL){derefLHS <- derefInfonView(worldManager, CIPov!.pItem)}
        me bool: derefRHS <- false
        if(aItem!.RHS!=NULL){derefInfonView(worldManager, aItem!.RHS!.pItem)}
        if(derefLHS){
            if(CIPov!.pParent!=NULL and CIPov!.pParent!.pItem!=NULL){
                CIPov!.pParent!.pItem!.value!.index.insert(CI!.type!.typeID(), CI)
            }else{ // This section is to get items into World. In a fully streaming mode this isn't needed.
                worldManager!.agent!.world!.value!.index.insert(CI!.type!.typeID(), CI)
            }
        }
        return(derefLHS or derefRHS)
    }
    me bool: funcArgRules(our AItem: aItem) <- {
        our infonView: CI        <- aItem!.LHS_item!.pItem
        me bool: changeMade  <- false
        if(CI!.argPos != apNoArgs){
            //:l/PAI::logSeg(" fArgs")
            our infonView: tmp
            if(CI!.argPos == apArgIsFirstItem){tmp <- CI!.getFirstItem(aItem!.LHS_item!.isSubItm)}
            else {tmp <- aItem!.LHS_item!.getLastInfonView()}
            if(tmp!=NULL){
                our POV:: newPov{9}
                newPov!.pItem    <- CI!.funcArgs
                newPov!.pItem!.asRHSInternalIdent <- true
                tmp!.addPOVToWrkList(newPov)
                CI!.funcArgs <- NULL
                CI!.argPos   <- apNoArgs
                changeMade  <- true
            }
            //if(CI!.value!.overlayType==LST){ciItr.state <- sFirstVisit}
            //else if(CI!.value!.overlayType!=LST){ciItr.state <- sNotASeq}
        }
        return(changeMade)
    }
}

// Resolves deferred path navigation once its source POV has enough structure
// to identify the requested field or position.  This remains a POV-level
// operation: it discovers the next view and then schedules ordinary infon
// processing rather than performing local value consolidation itself.
struct CursorPathResolver{
    our infonView: getSelfInfonView(our POV: startAnchor,
            our POV: cursorAnchor) <- {
        their POV: anchor <- startAnchor
        if(cursorAnchor!=NULL){anchor <- cursorAnchor}
        while(anchor!=NULL and
                anchor!.pItem!.copySourceType!=cstDefinition){
            anchor <- anchor!.pParent
        }
        if(anchor!=NULL and anchor!.pItem!=NULL){return(anchor!.pItem)}
        return(NULL)
    }

    their POV: getRelativeAnchor(our POV: startAnchor,
            our POV: cursorAnchor) <- {
        their POV: anchor <- startAnchor
        if(cursorAnchor!=NULL){anchor <- cursorAnchor}
        while(anchor!.pParent!=NULL and
                anchor!.pItem!.copySourceType!=cstListSpec){
            anchor <- anchor!.pParent
        }
        if(anchor!=NULL){return(anchor)}
        return(NULL)
    }

    // Find the current occurrence at the nearest enclosing T-level.  This is
    // intentionally different from getRelativeAnchor(): copied ListSpecs and
    // nested S-lists are execution/structure boundaries, not temporal levels.
    their POV: getTemporalRelativeAnchor(our POV: startAnchor,
            our POV: cursorAnchor) <- {
        their POV: anchor <- startAnchor
        if(startAnchor!=NULL and startAnchor!.pItem!=NULL and
                startAnchor!.pItem!.copySourceType==cstListSpec and
                cursorAnchor!=NULL){anchor <- cursorAnchor}
        while(anchor!=NULL){
            if(anchor!.pParent!=NULL and anchor!.pParent!.pItem!=NULL and
                    anchor!.pParent!.pItem!.value!.overlayType==LST and
                    anchor!.pParent!.pItem!.value!.timelike){
                return(anchor)
            }
            anchor <- anchor!.pParent
        }
        // A copied ListSpec cursor may not itself be attached at the runtime
        // occurrence. Only then use the explicit execution anchor.
        anchor <- cursorAnchor
        while(anchor!=NULL){
            if(anchor!.pParent!=NULL and anchor!.pParent!.pItem!=NULL and
                    anchor!.pParent!.pItem!.value!.overlayType==LST and
                    anchor!.pParent!.pItem!.value!.timelike){
                return(anchor)
            }
            anchor <- anchor!.pParent
        }
        return(NULL)
    }

    me bool: infonViewContainsNestedCursorLookup(their infonView: infn,
            their List<their infonView>: seen) <- {
        if(infn==NULL){return(false)}
        withEach seenInfn in seen{
            if(seenInfn===infn){return(false)}
        }
        seen.append(infn)
        if(infn!.viewMode==vmCursor or infn!.cursorMode!=cmNone){return(true)}
        our POV: child <- infn!.value!.items.head
        while(child!=NULL){
            if(infonViewContainsNestedCursorLookup(child!.pItem, seen)){
                return(true)
            }
            child <- child!.next
        }
        withEach wrkPov in infn!.wrkList{
            if(infonViewContainsNestedCursorLookup(wrkPov!.pItem, seen)){
                return(true)
            }
        }
        if(infonViewContainsNestedCursorLookup(infn!.funcArgs, seen)){
            return(true)
        }
        if(infonViewContainsNestedCursorLookup(infn!.innr, seen)){
            return(true)
        }
        return(false)
    }

    me bool: RHSNeedsNestedCursorNormalization(
            their infonView: infn) <- {
        // A true result here prevents the RHS from completing during merge.
        // That can leave later typed-list alternatives as bare word references
        // (e.g. rubixCube's second time state remains solvedState2).
        //me List<their infonView>: seen
        //return(infonViewContainsNestedCursorLookup(infn, seen))
        return(false)
    }

    me bool: lookUpCursor(their WorldManager: worldManager,
            our AItem: aItem,
            their TemporalIdentityReasoner: temporalIdentityReasoner) <- {
        our infonView: CI <- aItem!.LHS_item!.pItem
        our infonView: newTop <- NULL
        me bool: changeMade <- false
        me bool: detachCursorResult <- false
        if(CI!.viewMode==vmCursor){
            switch(CI!.cursorMode){
                case cmWorld:{newTop <- worldManager!.agent!.world}
                case cmContext:{
                    newTop <- worldManager!.agent!.context.topicHistory
                    aItem!.dontProcess <- true
                }
                case cmUser:{newTop <- worldManager!.agent!.user}
                case cmArgs:{
                    newTop <- aItem!.LHS_item!.pParent!.pItem!.value!.items.first()
                }
                case cmVars:{}
                case cmSelf:{newTop <- CI!.thisPtr}
                case cmPrev:{
                    their POV: anchor <- getRelativeAnchor(
                            aItem!.LHS_item, aItem!.cursorAnchor)
                    if(anchor!=NULL and anchor!.prev!=NULL){
                        newTop <- anchor!.prev!.pItem
                        detachCursorResult <- true
                    }else{
                        CI!.value!.undefined <- true
                    }
                }
                case cmNext:{
                    their POV: anchor <- getRelativeAnchor(
                            aItem!.LHS_item, aItem!.cursorAnchor)
                    if(anchor!=NULL and anchor!.next!=NULL){
                        newTop <- anchor!.next!.pItem
                        detachCursorResult <- true
                    }else{
                        CI!.value!.undefined <- true
                    }
                }
                case cmTPrev:{
                    their POV: anchor <- getTemporalRelativeAnchor(
                            aItem!.LHS_item, aItem!.cursorAnchor)
                    our POV: temporalSource <- temporalIdentityReasoner!.
                            temporalNeighborFromIdentity(anchor, true)
                    if(temporalSource!=NULL){
                        newTop <- temporalSource!.pItem
                        detachCursorResult <- true
                    }else{
                        CI!.value!.undefined <- true
                    }
                }
                case cmTNext:{
                    their POV: anchor <- getTemporalRelativeAnchor(
                            aItem!.LHS_item, aItem!.cursorAnchor)
                    our POV: temporalSource <- temporalIdentityReasoner!.
                            temporalNeighborFromIdentity(anchor, false)
                    if(temporalSource!=NULL){
                        newTop <- temporalSource!.pItem
                        detachCursorResult <- true
                    }else{
                        CI!.value!.undefined <- true
                    }
                }
            }
            if(newTop!=NULL){
                our PartPath: partRef <- CI!.partRef
                me bool: doReply <- CI!.doReply
                me uint64: originID <- CI!.originID
                me uint64: infCharPos <- CI!.infCharPos
                me uint64: itmMode <- CI!.itmMode
                if(CI!.cursorMode==cmWorld){
                    worldManager!.infonViewReasoner.inheritDefinitionListShapeForInfonView(
                            worldManager, newTop)
                }
                if(CI!.cursorMode==cmWorld and partRef==NULL and
                        CI!.parts.isEmpty()){
                    aItem!.LHS_item!.pItem <- newTop
                    aItem!.LHS_item!.accessMode <- aRefTo
                    CI <- aItem!.LHS_item!.pItem
                }else if(detachCursorResult){
                    our infonView:: detachedTop
                    newTop!.copyAsTypeTo(detachedTop, false, false)
                    CI! <- detachedTop!
                }else{
                    CI! <- newTop!
                }
                CI!.partRef <- partRef
                CI!.doReply <- doReply
                CI!.originID <- originID
                CI!.infCharPos <- infCharPos
                CI!.itmMode <- itmMode
                aItem!.LHS_item!.propagateInMrg2 <- true
                CI!.clearWrkList()
                changeMade <- true
            }
        }
        return(changeMade)
    }

    me bool: povIsUnderIncompleteStream(their POV: pov) <- {
        their POV: crnt <- pov
        while(crnt!=NULL){
            if(crnt!.pItem!=NULL and
                    (crnt!.pItem!.streamState==parseStarted or
                     crnt!.pItem!.streamState==parseListReady)){
                return(true)
            }
            crnt <- crnt!.pParent
        }
        return(false)
    }

    me bool: hasLocalNullableContinuation(our AItem: aItem) <- {
        if(!povIsUnderIncompleteStream(aItem!.LHS_item)){return(false)}
        our infonView: CI <- aItem!.LHS_item!.pItem
        return(CI!.partRef!=NULL or !CI!.parts.isEmpty())
    }

    me bool: processLocalNullableContinuation(their WorldManager: worldManager,
            their Agenda: agenda, our AItem: aItem,
            their bool: nxtAction,
            their List<our AItem>: requestedWork,
            their TemporalIdentityReasoner: temporalIdentityReasoner) <- {
        if(hasLocalNullableContinuation(aItem)){
            return(resolveParts(worldManager, agenda, aItem, nxtAction,
                    requestedWork, temporalIdentityReasoner))
        }
        return(false)
    }

    our infonView: makePositionalIndexSkip(
            their infonState: skipSize) <- {
        if(skipSize==NULL){return(NULL)}
        our infonView:: skipPart
        skipPart!.setToList()
        skipPart!.infSize! <- skipSize!
        skipPart!.value!.sizeMode <- fromGiven
        skipPart!.positionalIndexSkip <- true

        // A non-NULL unknown ListSpec makes this a sparse run without
        // asserting a member type. Once paired with the selected source,
        // OrderedSpanReasoner substitutes that source member shape and can
        // align the entire skip arithmetically.
        our infonView:: unknownMember
        unknownMember!.itmMode <- mItem
        unknownMember!.viewMode <- vmAny
        unknownMember!.infSize!.evalMode <- emUnknown
        unknownMember!.value!.overlayType <- tUnknown
        unknownMember!.value!.evalMode <- emUnknown
        skipPart!.value!.listSpec <- unknownMember
        return(skipPart)
    }

    // @[...] is only syntax sugar. Construct its item/span forms at one intersection
    // boundary, with the signed index deciding whether the unselected extent is
    // a forward prefix or an end-aligned suffix.
    our infonView: buildIndexIntersection(our infonView: source,
            our PartPath: part) <- {
        if(source==NULL or part==NULL or part!.path==NULL or
                part!.path!.value!.overlayType!=NUM){return(NULL)}

        me bool: doReply <- source!.doReply
        if(doReply){source!.doReply <- false}

        me bool: hasSpec <- part!.spec!=NULL
        our infonView: target
        if(hasSpec){
            target <- part!.spec
        }else{
            Allocate(target)
            target!.itmMode <- mItem
            target!.viewMode <- vmAny
            target!.infSize!.evalMode <- emUnknown
            target!.value!.evalMode <- emUnknown
        }

        our infonView: newInnr <- makeInnrInfonView()
        our POV: targetPOV
        me bool: literalIndex <-
                part!.path!.value!.evalMode==emLiteral
        me int64: signedIndex <- 0
        if(literalIndex){signedIndex <- part!.path!.fetchInt()}

        if(literalIndex and signedIndex<0){
            // The negative size is the low-level source-end anchor.  Keep the
            // marked target first, then represent the remaining suffix as one
            // counted wildcard span so large offsets stay sparse.
            newInnr!.value!.tailUnfinished <- false
            newInnr!.value!.sizeMode <- fromCount
            newInnr!.infSize!.overlayType <- NUM
            newInnr!.infSize!.evalMode <- emLiteral
            newInnr!.infSize!.inverted <- false
            newInnr!.infSize!.num <- signedIndex

            me int64: selectedExtent <- 1
            if(hasSpec and target!.value!.overlayType==LST and
                    target!.infSize!.overlayType==NUM and
                    target!.infSize!.evalMode==emLiteral and
                    target!.infSize!.num>0){
                selectedExtent <- target!.infSize!.num.convertToInt()
            }
            // A repeated span contributes each of its logical units to the
            // end-relative pattern. A one-unit item/span remains opaque.
            targetPOV <- newInnr!.value!.items.append(
                    target, selectedExtent>1, 18)
            me int64: suffixCount <- 0 - signedIndex - selectedExtent
            if(suffixCount>0){
                our infonView:: suffixSpec
                suffixSpec!.itmMode <- mItem
                suffixSpec!.viewMode <- vmAny
                suffixSpec!.infSize!.evalMode <- emUnknown
                suffixSpec!.value!.evalMode <- emUnknown
                our infonView:: suffixPart
                suffixPart!.setToList()
                suffixPart!.value!.listSpec <- suffixSpec
                suffixPart!.value!.sizeMode <- fromGiven
                suffixPart!.infSize!.overlayType <- NUM
                suffixPart!.infSize!.evalMode <- emLiteral
                suffixPart!.infSize!.num <- suffixCount
                newInnr!.value!.items.append(suffixPart, true, 17)
            }
        }else if(literalIndex and hasSpec){
            // Item indexes are one-based, while span indexes are zero-based
            // boundary counts.  A positive span becomes a forward prefix
            // followed by the same marked target term.
            me int64: prefixCount <- signedIndex
            newInnr!.value!.tailUnfinished <- false
            if(prefixCount>0){
                our infonState:: prefixSize
                prefixSize!.overlayType <- NUM
                prefixSize!.evalMode <- emLiteral
                prefixSize!.num <- prefixCount
                our infonView: skipPart <-
                        makePositionalIndexSkip(prefixSize)
                newInnr!.value!.items.append(skipPart, true, 17)
            }
            targetPOV <- newInnr!.value!.items.append(target, true, 18)
        }else if(hasSpec){
            // Preserve general, unresolved forward-index behavior until the
            // index expression becomes literal.
            our infonView: skipPart <-
                    makePositionalIndexSkip(part!.path!.value)
            newInnr!.value!.tailUnfinished <- false
            newInnr!.value!.items.append(skipPart, true, 17)
            targetPOV <- newInnr!.value!.items.append(target, true, 18)
        }else{
            // Preserve the established forward item-index representation. Its
            // generated final position remains the ordinary ipGetLast result;
            // negative literals have already taken the marked path above.
            newInnr!.value!.tailUnfinished <- true
            newInnr!.infSize! <- part!.path!.value!
            newInnr!.value!.sizeMode <- fromCount
        }

        our infonView:: result
        result!.convertThisToIntersection(newInnr, fromGiven)
        result!.positionalSelection <- true
        if(!hasSpec or (literalIndex and signedIndex<0)){
            newInnr!.value!.sizeMode <- fromCount
        }
        result!.doReply <- doReply
        result!.value!.sizeMode <- fromCount
        if(hasSpec){result!.value!.sizeMode <- fromGiven}
        result!.infSize!.overlayType <- NUM
        result!.originID <- source!.originID
        result!.infCharPos <- source!.infCharPos
        if(targetPOV!=NULL){
            result!.intersectPos <- ipGetMarked
            result!.intersectMarkedRetPOV <- targetPOV
        }
        // A bracketed index gives the parser an explicit boundary between the
        // index expression and operations on the selected result.
        if(part!.continuation!=NULL){
            result!.takeConsumerWorkFrom(part!.continuation, true)
            result!.parts <- part!.continuation!.parts
            result!.partRef <- part!.continuation!.partRef
            part!.continuation!.parts.clear()
            part!.continuation!.partRef <- NULL
        }

        // Work parsed on the selector target belongs to the selected result,
        // not to the pattern used to locate it.  Move it to the wrapper before
        // source is attached as selector-local input so a composite marked
        // result receives mapped-write authority.
        result!.takeConsumerWorkFrom(target, true)
        result!.takeConsumerWorkFrom(source, true)
        me int: sourcePedigree <- 16
        if(hasSpec){sourcePedigree <- 19}
        our POV: sourceWorkPOV <- result!.innr!.addInfonViewToWrkList(
                source, true, sourcePedigree)
        sourceWorkPOV!.selectorLocalWork <- true
        sourceWorkPOV!.looseMode <- false
        sourceWorkPOV!.looseTop <- true
        return(result)
    }

    me bool: resolveParts(their WorldManager: worldManager,
            their Agenda: agenda, our AItem: aItem,
            their bool: nxtAction,
            their List<our AItem>: requestedWork,
            their TemporalIdentityReasoner: temporalIdentityReasoner) <- {
        me bool: changeMade <- false
        me TemporalProjectionReasoner: temporalProjectionReasoner
        nxtAction! <- true
        our infonView: CI <- aItem!.LHS_item!.pItem
        if(CI!.partRef!=NULL){
            CI!.parts.append(CI!.partRef)
            CI!.partRef <- NULL
        }
        if(!CI!.parts.isEmpty()){
            withEach part in CI!.parts{
                me string: partTag
                if(part!.path!.type != NULL){
                    partTag <- part!.path!.type!.typeID()
                }
                our infonView: newPath
                our POV: newPov
                our POV: selectedTemporalBoundary
                our TemporalProjectionReference: selectedTemporalProjection
                our TemporalSplitReference: selectedTemporalSplit
                our POV: selectedSourcePOV
                our POV: selectionSourceSnapshot
                our POV: selectionQueryPOV
                our POV: selectionResultPOV
                me SelectionReferenceKind: selectionReferenceKind <-
                        srkPartPathSelection
                if(part!.wasTransfered){
                    continue()
                }else{
                    part!.wasTransfered <- true
                }
                if(part!.pathMode==dotField or
                        part!.pathMode==idxField){
                    // Capture the operation before lowering it.  The source
                    // and query remain stable even when the working POV's
                    // pItem is replaced by an unresolved intersection.
                    selectionSourceSnapshot <-
                            aItem!.LHS_item!.snapshotView(
                                    povSrcPartPathSelection)
                    if(selectionSourceSnapshot!=NULL){
                        our POV:: queryPOV{povSrcPartPathSelection}
                        queryPOV!.pItem <- part!.path
                        queryPOV!.bindIdentityRegistry(
                                selectionSourceSnapshot!.
                                effectiveIdentityRegistry())
                        selectionQueryPOV <- queryPOV
                    }
                }
                switch(part!.pathMode){
                    case dotField:{
                        if(CI!.value!.overlayType==LST and
                                CI!.value!.timelike and
                                part!.path!.type!=NULL and
                                (partTag=="begin" or partTag=="end" or
                                 partTag=="cut")){
                            // The working POV is about to be replaced by the
                            // selected result.  Give the boundary a stable
                            // source view that survives that replacement.
                            our POV: sourceSnapshot <-
                                    aItem!.LHS_item!.snapshotView(
                                            povSrcTemporalBoundary)
                            if(partTag=="cut"){
                                selectedTemporalSplit <-
                                        temporalIdentityReasoner!.
                                        makeTemporalSplit(sourceSnapshot,
                                                agenda!.normalizationID)
                                if(selectedTemporalSplit!=NULL){
                                    selectedTemporalBoundary <-
                                            selectedTemporalSplit!.
                                            symbolicCut
                                }
                            }else{
                                selectedTemporalBoundary <-
                                        temporalIdentityReasoner!.
                                        makeTemporalBoundaryPOV(sourceSnapshot,
                                                partTag=="end")
                            }
                            if(selectedTemporalBoundary!=NULL){
                                selectedTemporalBoundary!.pItem!.
                                        addSourceGraphDependency(
                                                sourceSnapshot)
                                newPath <- selectedTemporalBoundary!.pItem
                            }
                        }
                        if(newPath==NULL and CI!.orderMode==uUnordered){
                            selectedSourcePOV <- CI!.fetchField(partTag)
                            if(selectedSourcePOV!=NULL){
                                newPath <- selectedSourcePOV!.pItem
                            }
                        } else if(newPath==NULL and part!.path!.type != NULL){
                            if(partTag == "first"){
                                newPath <- CI!.getFirstItem(aItem!.LHS_item!.isSubItm)
                                selectedSourcePOV <- CI!.value!.items.head
                                if(selectedSourcePOV!=NULL and
                                        selectedSourcePOV!.pItem!==newPath){
                                    selectedSourcePOV <- NULL
                                }
                                selectionReferenceKind <-
                                        srkPositionalSelection
                            }
                            else if(partTag == "last"){
                                selectedSourcePOV <-
                                        aItem!.LHS_item!.getLastPOV()
                                if(selectedSourcePOV!=NULL){
                                    newPath <- selectedSourcePOV!.pItem
                                }
                                selectionReferenceKind <-
                                        srkPositionalSelection
                            }
                        }
                        if(newPath==NULL){
                            me bool: doReply <- CI!.doReply
                            if(doReply){CI!.doReply <- false}
                            our infonView:: skipPtn
                                part!.path!.copyAsTypeTo(skipPtn, false, false)
                                // Keep !path as the written selector token;
                                // local word defs should not stop the scan.
                                skipPtn!.wordDerefed <- true
                                skipPtn!.invertMatch <- true
                            our infonView:: matchPtn
                                part!.path!.copyAsTypeTo(matchPtn, false, false)
                            our infonView:: skipPart
                                skipPart!.setToList()
                                skipPart!.value!.sizeMode <- fromCount
                                skipPart!.infSize!.overlayType <- NUM
                                skipPart!.infSize!.evalMode <- emUnknown
                                skipPart!.value!.listSpec <- skipPtn
                            our infonView: newInnr <- makeInnrInfonView()
                                newInnr!.value!.items.append(skipPart, true, 13)
                                newInnr!.value!.items.append(matchPtn, false, 14)
                                newInnr!.orderMode <- CI!.orderMode
                            Allocate(newPath)
                                newPath!.convertThisToIntersection(newInnr, fromGiven)
                                newPath!.doReply <- doReply
                                newInnr!.value!.sizeMode <- fromCount
                                newPath!.value!.sizeMode <- fromCount
                                newPath!.infSize!.overlayType <- NUM
                                newPath!.originID <- CI!.originID
                                newPath!.infCharPos <- CI!.infCharPos
                                newPath!.orderMode <- CI!.orderMode
                                if(part!.path!.partRef!=NULL){
                                    newPath!.partRef <- part!.path!.partRef
                                    part!.path!.partRef <- NULL
                                }else{
                                    newPath!.parts <- part!.path!.parts
                                }
                            newPov <- newPath!.innr!.addInfonViewToWrkList(
                                    CI, true, 15)
                            newPov!.selectorLocalWork <- true
                            newPov!.looseMode <- false
                            newPov!.looseTop <- true
                        }
                    }
                    case upField:{}
                    case idxField:{
                        selectionReferenceKind <- srkPositionalSelection
                        newPath <- buildIndexIntersection(CI, part)
                    }
                    case colonField:{}
                    case asTListField:{
                        our POV: projectionSource <-
                                aItem!.LHS_item!.snapshotView(
                                        povSrcTemporalProjection)
                        selectedTemporalProjection <-
                                temporalProjectionReasoner.projectAsTList(
                                        projectionSource,
                                        agenda!.normalizationID)
                        if(selectedTemporalProjection!=NULL and
                                selectedTemporalProjection!.projectionPOV!=NULL){
                            newPath <- selectedTemporalProjection!.
                                    projectionPOV!.pItem
                            if(part!.path!.partRef!=NULL){
                                newPath!.partRef <- part!.path!.partRef
                                part!.path!.partRef <- NULL
                            }else if(!part!.path!.parts.isEmpty() and
                                    newPath!==CI){
                                newPath!.parts <- part!.path!.parts
                            }
                        }
                    }
                }
                if(newPath==NULL){logFatalError("Handle newPath is null")}
                newPath!.takeWrkListFrom(part!.path, true)
                if(!part!.hasSemiColon){
                    aItem!.LHS_item!.pItem <- newPath
                    aItem!.LHS_item!.temporalBoundary.sourcePov <- NULL
                    aItem!.LHS_item!.temporalBoundary.tracksEnd <- false
                    aItem!.LHS_item!.temporalBoundary.cutIndexKnown <- false
                    aItem!.LHS_item!.temporalBoundary.cutIndex <- -1
                    aItem!.LHS_item!.temporalProjection.reference <- NULL
                    aItem!.LHS_item!.temporalProjection.isProjection <- false
                    aItem!.LHS_item!.temporalSplit.reference <- NULL
                    if(selectedTemporalBoundary!=NULL){
                        aItem!.LHS_item!.temporalBoundary.sourcePov <-
                                selectedTemporalBoundary!.
                                temporalBoundary.sourcePov
                        aItem!.LHS_item!.temporalBoundary.tracksEnd <-
                                selectedTemporalBoundary!.
                                temporalBoundary.tracksEnd
                        aItem!.LHS_item!.temporalBoundary.cutIndexKnown <-
                                selectedTemporalBoundary!.
                                temporalBoundary.cutIndexKnown
                        aItem!.LHS_item!.temporalBoundary.cutIndex <-
                                selectedTemporalBoundary!.
                                temporalBoundary.cutIndex
                        aItem!.LHS_item!.temporalSplit.reference <-
                                selectedTemporalBoundary!.
                                temporalSplit.reference
                        aItem!.LHS_item!.accessMode <- aRefTo
                        their IdentityRegistry: boundaryRegistry <-
                                selectedTemporalBoundary!.
                                effectiveIdentityRegistry()
                        if(boundaryRegistry!=NULL){
                            aItem!.LHS_item!.bindIdentityRegistry(
                                    boundaryRegistry)
                            boundaryRegistry!.recordIdentity(
                                    aItem!.LHS_item,
                                    selectedTemporalBoundary,
                                    iekTemporalBoundary,
                                    agenda!.normalizationID)
                        }
                    }
                    if(selectedTemporalProjection!=NULL){
                        aItem!.LHS_item!.temporalProjection.reference <-
                                selectedTemporalProjection
                        aItem!.LHS_item!.temporalProjection.isProjection <- true
                        aItem!.LHS_item!.accessMode <- aRefTo
                    }
                    nxtAction! <- true
                    selectionResultPOV <- aItem!.LHS_item
                }else{
                    our POV:: pathPov{20}
                    pathPov!.pItem <- newPath
                    if(selectedTemporalBoundary!=NULL){
                        pathPov!.temporalBoundary.sourcePov <-
                                selectedTemporalBoundary!.
                                temporalBoundary.sourcePov
                        pathPov!.temporalBoundary.tracksEnd <-
                                selectedTemporalBoundary!.
                                temporalBoundary.tracksEnd
                        pathPov!.temporalBoundary.cutIndexKnown <-
                                selectedTemporalBoundary!.
                                temporalBoundary.cutIndexKnown
                        pathPov!.temporalBoundary.cutIndex <-
                                selectedTemporalBoundary!.
                                temporalBoundary.cutIndex
                        pathPov!.temporalSplit.reference <-
                                selectedTemporalBoundary!.
                                temporalSplit.reference
                        pathPov!.accessMode <- aRefTo
                        their IdentityRegistry: boundaryRegistry <-
                                selectedTemporalBoundary!.
                                effectiveIdentityRegistry()
                        if(boundaryRegistry!=NULL){
                            pathPov!.bindIdentityRegistry(boundaryRegistry)
                            boundaryRegistry!.recordIdentity(
                                    pathPov, selectedTemporalBoundary,
                                    iekTemporalBoundary,
                                    agenda!.normalizationID)
                        }
                    }
                    if(selectedTemporalProjection!=NULL){
                        pathPov!.temporalProjection.reference <-
                                selectedTemporalProjection
                        pathPov!.temporalProjection.isProjection <- true
                        pathPov!.accessMode <- aRefTo
                    }
                    aItem!.LHS_item!.pItem!.retainPOV(pathPov)
                    our AItem: newAItem <- worldManager!.prepareInfonWork(
                            agenda, pathPov, NULL, aItem,
                            aprListCompletion, aItem!.priority, srcPartsPath)
                    if(newAItem!=NULL){
                        addDebugEvent("RegisterPIVA to integrate "+
                                newPath!.mySymbol()+":"+toString(newPath), newPath)
                        requestedWork.append(newAItem)
                    }
                    nxtAction! <- false
                    selectionResultPOV <- pathPov
                }
                if(selectedTemporalBoundary==NULL and
                        selectionQueryPOV!=NULL and
                        selectionResultPOV!=NULL and
                        selectionSourceSnapshot!=NULL){
                    their IdentityRegistry: registry <-
                            selectionSourceSnapshot!.
                            effectiveIdentityRegistry()
                    if(registry!=NULL){
                        our SelectionRequest: selectionRequest <-
                                registry!.getOrCreateSelectionRequest(
                                selectionQueryPOV, selectionResultPOV,
                                selectionSourceSnapshot,
                                selectionReferenceKind,
                                agenda!.normalizationID)
                        if(selectionRequest!=NULL){
                            selectionRequest!.selectorSpec <- part!.spec
                            if(selectedSourcePOV!=NULL){
                                registry!.
                                        recordSelectionReferenceForRequest(
                                                selectionRequest,
                                                selectionResultPOV,
                                                selectedSourcePOV)
                            }else{
                                newPath!.selectionRequestID <-
                                        selectionRequest!.requestID
                                if(newPath!.innr!=NULL){
                                    withEach selectionWork in
                                            newPath!.innr!.wrkList{
                                        if(selectionWork!.
                                                selectorLocalWork){
                                            selectionWork!.
                                                    selectionRequestID <-
                                                    selectionRequest!.
                                                    requestID
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
                changeMade <- true
            }
        }
        return(changeMade)
    }
}

// Traverses corresponding parent members to discover the next local identity
// candidate. Agenda queuing and subscription lifecycle remain with the engine;
// this class owns only the POV-level correspondence walk.
struct ParentMemberReasoner{
    our POV: findNextLHS(their WorldManager: worldManager,
            our POV: LHSPov, our infItr: ii, me int64: skipDots,
            their int64: lvlsUpOnLeft, me bool: itrBeginning,
            me bool: LHSIsLST, me bool: RHSIsLST,
            me bool: unknownAsList, their int: waitState) <- {
        our POV: LHSPovNxt
        if((!LHSIsLST and !unknownAsList) and RHSIsLST){
            LHSPovNxt <- LHSPov
        }else{
            LHSPovNxt <- LHSPov!.getNextTight(ii, skipDots,
                    lvlsUpOnLeft, false, itrBeginning, waitState,
                    worldManager!.agent)
        }
        return(LHSPovNxt)
    }

    our POV: findNextRHS(their WorldManager: worldManager,
            our POV: RHSPov, our infItr: ii, me int64: skipDots,
            their int64: lvlsUpOnRight, me bool: itrBeginning,
            me bool: LHSIsLST, me bool: RHSIsLST,
            their int: waitState) <- {
        our POV: RHSPovNxt
        if(LHSIsLST and !RHSIsLST and itrBeginning){
            Allocate(RHSPovNxt)
            RHSPovNxt! <- RHSPov!
            if(RHSPovNxt!.pedigree.source==0){
                RHSPovNxt!.pedigree.source <- 456
            }
            RHSPovNxt!.looseInhtd <- true
        }else{
            RHSPovNxt <- RHSPov!.getNextTight(ii, skipDots,
                    lvlsUpOnRight, false, itrBeginning, waitState,
                    worldManager!.agent)
        }
        return(RHSPovNxt)
    }

    our AItem: propagate(their WorldManager: worldManager, their Agenda: agenda, our AItem: aItem, our POV: LHSPov, our POV: RHSPov, our POV: remainder, me bool: looseSize, bool: dontEnque, their int:waitState) <- {
        // Log LHS==RHS
        me string: idnt <- indentStr(aItem!.indentLvl)
        me string: logStr <- idnt+"    PROPAGATE:"+shortedStr(toString(LHSPov!.pItem), 400)
        if(RHSPov!=NULL){
            if(RHSPov!.looseSize()){logStr <+- " =="}else{logStr <+- " ="}
            if(RHSPov!.looseTop){logStr <+- ":"}
            logStr <+- " " + shortedStr(toString(RHSPov!.pItem),400)
        }else{
            if(remainder!=NULL){logStr <+- " REM:"+shortedStr(toString(remainder!.pItem),400)}
            else{logStr <+- " (No_RHS)"}
        }
        //log(logStr)
        //:l/PAI::logSegIn(" PROP")
        // Gather information
        me bool: RhsAttached<- true
        me bool: RHSExists  <- RHSPov != NULL
        me bool: RorRExists <- RHSExists or remainder!=NULL
        me bool: LHSIsLST   <- (LHSPov!.pItem!.value!.overlayType==LST and LHSPov!.pItem!.value!.evalMode!=emConcat)
        me bool: RHSIsLST   <- (RHSExists and RHSPov!.pItem!.value!.overlayType==LST and RHSPov!.pItem!.value!.evalMode!=emConcat)
        me bool: identIsInternal <- RHSExists and (RHSPov!.pItem!.asRHSInternalIdent or (RHSPov!.pParent!=NULL and RHSPov!.pParent!.pItem!.asRHSInternalIdent))
        me bool: LHSitrBeginning <- aItem!.LHSItr!=NULL and LHSPov===aItem!.LHSItr!.topPOV
        me bool: RHSitrBeginning <- aItem!.RHSItr!=NULL and RHSPov===aItem!.RHSItr!.topPOV
        me bool: LHSIsFromALT
        our POV: adjLhsPOV  <- LHSPov
        our POV: adjRhsPOV  <- RHSPov
        while(adjLhsPOV!.outerPOV != NULL and !LHSitrBeginning){LHSIsFromALT <- adjLhsPOV!.isFromALT; adjLhsPOV <- adjLhsPOV!.outerPOV}
        while(RHSExists and adjRhsPOV!.outerPOV != NULL and !RHSitrBeginning){adjRhsPOV <- adjRhsPOV!.outerPOV}
        our POV: LHSPovNext
        our POV: RHSPovNext
        me int64: lvlsUpOnLeft
        me int64: lvlsUpOnRight
        if(!RHSExists and !adjLhsPOV!.pItem!.hasInnrOutr){
            if(adjLhsPOV!.pItem!.value!.items.isEmpty()){LHSitrBeginning <- false}
        }
        our AItem: aParent <- aItem
        if(!LHSitrBeginning){
            if(aItem!.ruleSet==rsInfon){aParent <- aItem!.parent}
            else{aParent <- aItem!.parent!.parent}
        }
        while(aParent!=NULL and aParent!.ruleSet==rsIntersect){aParent <- aParent!.parent!.parent}

        // Fetch next RHS: CHECK: aParent
        if(remainder!=NULL){RHSPovNext <- remainder}
        else if(RHSExists and aParent != NULL and aParent!.RHSItr != NULL){
            me int64: skipDotsR <- 0; if(dontEnque){skipDotsR<-INT64_MAX}
            RHSPovNext <- findNextRHS(worldManager, adjRhsPOV, aParent!.RHSItr, skipDotsR, lvlsUpOnRight, RHSitrBeginning, LHSIsLST, RHSIsLST, waitState)
            if(waitState!=NULL and waitState! != propWaitNone){
                if(waitState! == propWaitWithinList and lvlsUpOnRight>0){
                    waitState! <- propWaitAfterListBoundary
                }
                //log("SKIPPING_FETCH_RHS:"+aItem!.stringify())
                return(NULL)
            }
            if(RHSPovNext==NULL and adjRhsPOV!.pItem!.intersectPos != ipNoIntersect and adjRhsPOV!.next==NULL){
                RhsAttached <- false // RHS is an unattached intersect
            }
        }
        if(RHSExists and aParent!=NULL and aParent!.LHS_item!.pItem!.value!.sizeMode!=fromGiven and LHSPov!.pItem!.isTentative and !LHSPov!.applyAsNot(RHSPov) and !RHSPov!.pItem!.isTentative and !identIsInternal and RhsAttached){
            LHSPov!.pItem!.isTentative <- false
            //:l/PAI::logSeg(" resetTent:D")
        }

        // Fetch next LHS
        if(aParent == NULL){LHSPovNext <- NULL}  // At very top infon or propagating a lone RHS or intersect.
        else{
            me int64: skipDotsL <- 0;   if(RHSPovNext == NULL){ skipDotsL <- lvlsUpOnRight}    if(skipDotsL==0 and (dontEnque or !RorRExists)){ skipDotsL<-INT64_MAX}
            LHSPovNext <- findNextLHS(worldManager, adjLhsPOV, aParent!.LHSItr, skipDotsL, lvlsUpOnLeft, LHSitrBeginning, LHSIsLST, RHSIsLST, false, waitState)
            if(waitState!=NULL and waitState! != propWaitNone){
                if(waitState! == propWaitWithinList and lvlsUpOnLeft>0){
                    waitState! <- propWaitAfterListBoundary
                }
                //log("SKIPPING_FETCH_LHS:"+aItem!.stringify())
                return(NULL)
            }
            if(lvlsUpOnLeft>0 and LHSPovNext!=NULL and LHSPovNext!.applyAsNot(RHSPovNext)){ // Eg Coming out of an LHS like: !char:{...}
                if(aParent!.mergeStatus==msUnknown){ // If it's msUnknown no 'mismatch' has been found so it's really a reject.
                    aParent!.mergeStatus<-msReject
                    LHSPovNext!.rejected <- true
                    dontEnque  <- true
                }
            }
        }

        // A generated sparse head is transparent: after its nested member is
        // normalized, LHS traversal continues into the still-compressed
        // remainder. The matching concrete RHS member can be nested inside
        // wrappers, so its inner iterator stops even though an enclosing typed
        // list still has materialized siblings. Resume only the nearest RHS
        // iterator with the same list-spec type as the sparse LHS remainder.
        if(RHSPovNext==NULL and LHSPovNext!=NULL and
                LHSPovNext!.isSparseOrderedSpan() and RhsAttached and
                aParent!=NULL and aParent!.RHS!=NULL and
                aParent!.RHSItr!=NULL){
            me string: sparseLHSListSpecTypeID <-
                    LHSPovNext!.sparseSpanListSpecTypeID()
            our infItr: enclosingRHSItr <- aParent!.RHSItr!.iParent
            while(enclosingRHSItr!=NULL){
                if(sparseLHSListSpecTypeID!="" and
                        enclosingRHSItr!.topPOV!=NULL and
                        enclosingRHSItr!.topPOV!.pItem!.value!.listSpec!=NULL and
                        enclosingRHSItr!.topPOV!.pItem!.value!.
                                listSpec!.type!=NULL and
                        enclosingRHSItr!.topPOV!.pItem!.value!.listSpec!.
                                type!.typeID()==sparseLHSListSpecTypeID){
                    break()
                }
                enclosingRHSItr <- enclosingRHSItr!.iParent
            }
            if(enclosingRHSItr!=NULL){
                me int64: enclosingLvlsUpOnRight
                me int64: enclosingSkipDotsR <- 0
                if(dontEnque){enclosingSkipDotsR<-INT64_MAX}
                RHSPovNext <- findNextRHS(
                        worldManager, aParent!.RHS,
                        enclosingRHSItr, enclosingSkipDotsR,
                        enclosingLvlsUpOnRight, false,
                        LHSIsLST, RHSIsLST, waitState)
                if(waitState!=NULL and waitState! != propWaitNone){
                    if(waitState! == propWaitWithinList and
                            enclosingLvlsUpOnRight>0){
                        waitState! <- propWaitAfterListBoundary
                    }
                    return(NULL)
                }
                if(RHSPovNext!=NULL){
                    lvlsUpOnRight <- enclosingLvlsUpOnRight
                }
            }
        }

        our POV: orderedSpanSourceContextPOV <- RHSPovNext
        if(aParent!=NULL and aParent!.RHS!=NULL){
            orderedSpanSourceContextPOV <- aParent!.RHS
        }
        our IntersectionTraversalPlan: activeTraversalPlan
        if(aParent!=NULL){
            activeTraversalPlan <-
                    aParent!.activeIntersectionTraversalPlan()
        }
        if(activeTraversalPlan!=NULL and
                activeTraversalPlan!.status==itpResolved and
                activeTraversalPlan!.sourceContextPOV!=NULL){
            orderedSpanSourceContextPOV <-
                    activeTraversalPlan!.sourceContextPOV
        }

        if(LHSPovNext!=NULL and RHSPovNext!=NULL and
                orderedSpanSourceContextPOV!=NULL){
            our OrderedSpanTraversalWindow: spanWindow <- worldManager!.
                    tryBuildOrderedSpanTraversalWindow(
                            LHSPovNext, orderedSpanSourceContextPOV,
                            RHSPovNext)
            if(spanWindow!=NULL and spanWindow!.valid){
                LHSPovNext <- spanWindow!.lhsPOV
                RHSPovNext <- spanWindow!.rhsPOV
            }
        }

        // A sparse marked span may have to be exposed one logical item at a
        // time to match concrete source items. Capture the whole occurrence
        // before that destructive refinement changes the marked span's size.
        // Keep this as a candidate identity on the accepting merge: replacing
        // intersectMarkedRetPOV with the mapped view would perform the forward
        // selection while losing the query side needed for inverse inference.
        if(aParent!=NULL and LHSPovNext!=NULL and RHSPovNext!=NULL and
                orderedSpanSourceContextPOV!=NULL and
                aParent!.LHS_item!.pItem!.intersectMarkedRetPOV===
                        LHSPovNext and
                LHSPovNext!.hasSparseOrderedSpanValue() and
                !RHSPovNext!.isSparseOrderedSpan()){
            our POV: mappedMarkedView <- worldManager!.
                    makeMappedMarkedSparseSpan(
                            LHSPovNext, orderedSpanSourceContextPOV,
                            RHSPovNext)
            if(mappedMarkedView!=NULL){
                our PendingSelectionCorrespondence:: pendingSelection
                pendingSelection!.queryPOV <- LHSPovNext
                pendingSelection!.resultPOV <- mappedMarkedView
                pendingSelection!.sourceContextPOV <-
                        mappedMarkedView!.viewMap.sourcePov
                pendingSelection!.sourceStartPOV <-
                        mappedMarkedView!.viewMap.startPov
                if(pendingSelection!.sourceContextPOV!=NULL and
                        pendingSelection!.sourceStartPOV!=NULL and
                        aParent!.pendingMarkedSelection==NULL){
                    aParent!.pendingMarkedSelection <- pendingSelection
                }
            }
        }

        if(LHSPovNext!=NULL and RHSPovNext!=NULL){
            if(!LHSPovNext!.isSparseOrderedSpan() and RHSPovNext!.isSparseOrderedSpan()){
                our POV: exposedRHS <- worldManager!.exposeSparseOrderedSpanHeadForTraversal(RHSPovNext)
                if(exposedRHS!=NULL){RHSPovNext <- exposedRHS}
            }
            if(LHSPovNext!=NULL and RHSPovNext!=NULL and LHSPovNext!.isSparseOrderedSpan() and !RHSPovNext!.isSparseOrderedSpan()){
                our POV: exposedLHS <- worldManager!.exposeSparseOrderedSpanHeadForTraversal(LHSPovNext)
                if(exposedLHS!=NULL){LHSPovNext <- exposedLHS}
            }
        }

        if(LHSPovNext!=NULL and RHSPovNext!=NULL and
                orderedSpanSourceContextPOV!=NULL){
            our OrderedSpanTraversalWindow: spanWindow <- worldManager!.
                    tryBuildOrderedSpanTraversalWindow(
                            LHSPovNext, orderedSpanSourceContextPOV,
                            RHSPovNext)
            if(spanWindow!=NULL and spanWindow!.valid){
                LHSPovNext <- spanWindow!.lhsPOV
                RHSPovNext <- spanWindow!.rhsPOV
            }
        }

        if(aParent!=NULL and aParent!.LHS_item!.pItem!.intersectMarkedRetPOV!=NULL){
            // getFirst/NextTight can step through a marked transparent &{...} and return
            // one of its inner POVs. If that inner LHS POV matches here, use the matched
            // RHS POV as the source-backed marked return so writes target the source list.
            our POV: markedMatch <- NULL
            our POV: markedPOV <- aParent!.LHS_item!.pItem!.intersectMarkedRetPOV
            me bool: markedReturnAlreadyMapped <- false
            if(markedPOV!=NULL and markedPOV!.pParent!=NULL){
                if(!markedPOV!.pParent!.pItem!.isInnr and (aParent!.LHS_item!.pItem!.innr==NULL or !(markedPOV!.pParent!.pItem===aParent!.LHS_item!.pItem!.innr))){
                    markedReturnAlreadyMapped <- true
                }
            }
            if(!markedReturnAlreadyMapped){
                // An exact sparse-span match is a composite occurrence, not
                // merely a compatible type. Record that concrete pairing so
                // selection can route its later write through ViewMap.
                if(LHSPov!=NULL and RHSExists and
                        markedPOV===LHSPov and
                        markedPOV!.hasSparseOrderedSpanValue() and
                        RHSPov!.hasSparseOrderedSpanValue()){
                    markedMatch <- RHSPov
                }
                if(LHSPovNext!=NULL and RHSPovNext!=NULL and
                        markedPOV===LHSPovNext and
                        markedPOV!.hasSparseOrderedSpanValue() and
                        orderedSpanSourceContextPOV!=NULL){
                    if(RHSPovNext!.hasSparseOrderedSpanValue() and
                            markedPOV!.pItem!.value!.listSpec!=NULL and
                            markedPOV!.pItem!.value!.listSpec!.type!=NULL and
                            RHSPovNext!.pItem!.value!.listSpec!=NULL and
                            RHSPovNext!.pItem!.value!.listSpec!.type!=NULL and
                            markedPOV!.pItem!.value!.listSpec!.type!.typeID()==
                                    RHSPovNext!.pItem!.value!.
                                            listSpec!.type!.typeID() and
                            markedPOV!.sparseSpanCount()==
                                    RHSPovNext!.sparseSpanCount()){
                        // Preserve an exact sparse occurrence as compressed.
                        // Logical expansion is only needed when the selected
                        // extent crosses this source span's boundary.
                        markedMatch <- RHSPovNext
                    }else{
                        markedMatch <- worldManager!.
                                makeMappedMarkedSparseSpan(
                                        markedPOV,
                                        orderedSpanSourceContextPOV,
                                        RHSPovNext)
                    }
                }
                if(markedMatch==NULL and LHSPov!=NULL and RHSExists and RHSPov!.pedigree.source==povSrcSparseExposedHead and markedPOV===LHSPov){markedMatch <- RHSPov}
                if(markedMatch==NULL and LHSPovNext!=NULL and RHSPovNext!=NULL and RHSPovNext!.pedigree.source==povSrcSparseExposedHead and markedPOV===LHSPovNext){markedMatch <- RHSPovNext}
                if(markedMatch==NULL and LHSPov!=NULL and RHSExists and RHSPov!.pedigree.source==povSrcSparseExposedHead and markedPOV!.pItem===LHSPov!.pItem){markedMatch <- RHSPov}
                if(markedMatch==NULL and LHSPovNext!=NULL and RHSPovNext!=NULL and RHSPovNext!.pedigree.source==povSrcSparseExposedHead and markedPOV!.pItem===LHSPovNext!.pItem){markedMatch <- RHSPovNext}
                if(markedMatch==NULL and LHSPovNext!=NULL and RHSPovNext!=NULL and RHSPovNext!.pedigree.source==povSrcSparseExposedHead){
                    if(markedPOV!=NULL and markedPOV!.pItem!=NULL and markedPOV!.pItem!.type!=NULL and RHSPovNext!.pItem!=NULL and RHSPovNext!.pItem!.type!=NULL){
                        if(markedPOV!.pItem!.isCompatibleWith(RHSPovNext!.pItem, false)==tvTrue){markedMatch <- RHSPovNext}
                    }
                }
                if(markedMatch==NULL and LHSPov!.markedOuterPOV!=NULL and RHSExists){markedMatch <- RHSPov}
                if(markedMatch==NULL and LHSPovNext!=NULL and LHSPovNext!.markedOuterPOV!=NULL and RHSPovNext!=NULL){markedMatch <- RHSPovNext}
            }
            if(markedMatch!=NULL){
                our PendingSelectionCorrespondence:: pendingSelection
                pendingSelection!.queryPOV <- markedPOV
                pendingSelection!.resultPOV <- markedMatch
                if(markedMatch!.viewMap.sourcePov!=NULL and
                        markedMatch!.viewMap.startPov!=NULL){
                    pendingSelection!.sourceContextPOV <-
                            markedMatch!.viewMap.sourcePov
                    pendingSelection!.sourceStartPOV <-
                            markedMatch!.viewMap.startPov
                }else{
                    pendingSelection!.sourceContextPOV <-
                            orderedSpanSourceContextPOV
                    pendingSelection!.sourceStartPOV <- markedMatch
                }
                // The first relation covers the complete marked occurrence.
                // Later propagation visits its children and must not replace
                // that result with a narrower descendant correspondence.
                if(aParent!.pendingMarkedSelection==NULL){
                    aParent!.pendingMarkedSelection <- pendingSelection
                }
                if(markedPOV!.hasSparseOrderedSpanValue() and
                        markedMatch!.hasSparseOrderedSpanValue() and
                        orderedSpanSourceContextPOV!=NULL){
                    markedPOV!.mapViewToSource(
                            orderedSpanSourceContextPOV, markedMatch)
                    aParent!.LHS_item!.pItem!.intersectMarkedRetPOV <-
                            markedPOV
                }else{
                    // Preserve the marked query POV.  The candidate source is
                    // carried through propagation and becomes a reversible
                    // SelectionReference only after its merge accepts;
                    // replacing this pointer with markedMatch would perform
                    // the forward selection without recording its inverse.
                    aParent!.LHS_item!.pItem!.intersectMarkedRetPOV <-
                            markedPOV
                }
                if(markedMatch!.pItem!.isTentative){
                    markedMatch!.addNewSubDots <- true
                    if(markedMatch!.pParent!=NULL){markedMatch!.pParent!.keepDots <- true}
                }
            }
        }

        //log("RHSPovNext:"+RHSPovNext.mySymbol()+":"+RHSPovNext.stringify())
        //log("LHSPovNext:"+LHSPovNext.mySymbol()+":"+LHSPovNext.stringify())

        // Find the aParent for the next LHS item.
        our AItem: nxtsParent <- aParent
        withEach aitm in range 0 .. lvlsUpOnLeft{
            if(nxtsParent==NULL or nxtsParent!.parent==NULL){break()}
            nxtsParent <- nxtsParent!.parent!.parent
            if(nxtsParent!=NULL and (nxtsParent!.parent==NULL or nxtsParent!.parent!.parent==NULL)){break()}
            if(nxtsParent != NULL and nxtsParent!.ruleSet==rsIntersect and nxtsParent!.parent != NULL and nxtsParent!.parent!.parent != NULL){aitm <-- 1}
        }

        me bool: candidateForLast <- false
        if(!dontEnque){
            // Set povParent's CandidateForLastItem flag and povParent!.keepDots.
            {  // REfs after wait(): LHSPovNext==NULL, LHSPovNext!.tentFromDots, lvlsUpOnLeft, RHSPovNext==NULL, RhsAttached, lvlsUpOnRight; SETs: candidateForLast, povParent!.keepDots
                me bool: isLooseSize  <- aParent!=NULL and aParent!.RHS!=NULL and aParent!.RHS!.looseSize()
                me bool: LHSisFinished <- LHSPovNext == NULL or lvlsUpOnLeft>0 or LHSPovNext!.tentFromDots
                me bool: RHSisFinished <- (RHSPovNext == NULL and RhsAttached) or lvlsUpOnRight>0
                their POV: povParent; if(LHSitrBeginning){povParent <- adjLhsPOV} else {povParent <- adjLhsPOV!.pParent}
                if((RorRExists and ((LHSisFinished and RHSisFinished) or (isLooseSize and (povParent!=NULL and povParent!.pItem!.infSize!.evalMode==emUnknown) )))
                    or (lvlsUpOnLeft>0 and LHSPov!.outerPOV==NULL and (povParent!=NULL and !povParent!.pItem!.value!.tailUnfinished))
                  ){
                    if(LHSitrBeginning){ //log(idnt+"   candidatesForLastItem:" + adjLhsPOV.stringify() + "   EndsOnA:"+LHSPovNext.stringify())
                        if(LHSPovNext!=NULL){
                            povParent!.addCandidateForLastItem(LHSPovNext)
                            candidateForLast <- true
                        }
                    }else{
                        if(LHSPov!.pItem!.intersectPos == ipNoIntersect and povParent!=NULL){
                            povParent!.addCandidateForLastItem(LHSPov)
                            candidateForLast <- true
                        }//else {log("NO_candidatesForLastItem due to [...] or atTop")}
                    }
                }
                if(!RorRExists and povParent!=NULL){povParent!.keepDots <- true}
            }
            if(LHSPovNext == NULL){
                //:l/PAI::logSegOut("NO_NXTa")
                return(NULL)
            }
            //ENQUEUE FOR PROCESSING
            ///me int: RHSsAvailable <- 0; our POV: RHSAltCnt <- RHSPovNext; while(RHSAltCnt){RHSsAvailable <+- 1; RHSAltCnt <- RHSAltCnt.altPOV}; if(LHSIsFromALT){RHSsAvailable <+- 1} // This may be needed later
            me bool: LHSHasAlt <- (LHSPovNext != NULL and LHSPovNext!.altPOV != NULL)
            me bool: RHSHasAlt <- (RHSPovNext != NULL and RHSPovNext!.altPOV != NULL)
            me int: lCount <- 0
            our POV: LHSAlt <- LHSPovNext
            while(LHSAlt!=NULL){
                /// me int: numRHSs <- RHSsAvailable; if(RHSHasAlt and LHSAlt!.pItem!.isTentative){numRHSs <-- 1} // numRHSs can be used as an alternate way to do this, and may be needed later.
                our POV: RHSAlt <- RHSPovNext
                me bool: predPushed <- false
                while(RHSAlt!=NULL){
                    if(LHSAlt!.pItem!.isTentative and RHSAlt!.pItem!.isTentative){  // ?=?
                        //:l/PAI::logSeg(" ?=?")
                        LHSAlt!.addNewSubDots <- true
                        LHSAlt!.pParent!.keepDots <- true
                        //log(idnt+"    ENQUEq:"+  LHSAlt.stringify() + " === " + RHSAlt.stringify())
                    } else {
                        if((lCount>0 and (LHSHasAlt or RHSHasAlt)) or LHSIsFromALT){    /// if(numRHSs>1 or lCount>0){
                                if(nxtsParent!.RHS!=NULL){
                                    RHSAlt!.looseInhtd <- nxtsParent!.RHS!.looseInhtd or nxtsParent!.RHS!.looseMode
                                    RHSAlt!.looseTop   <- false
                                }
         //           log("LHSIterator:"+nxtsParent!.LHSItr!.mySymbol()+":"+toString(nxtsParent!.LHSItr!.lineAltID)+"   QX_aParent:"+nxtsParent.mySymbol()+":"+nxtsParent.stringify())
                                //logSeg(" EnqX")
                                LHSAlt!.pItem!.pushAltIntoLineAlt(LHSPov, nxtsParent!.LHSItr!.lineAltID, RHSAlt!.pItem, RHSAlt, LHSIsFromALT)
         //                       log(idnt+"    ENQUEx:"+LHSAlt.mySymbol()+":" + LHSAlt.stringify() + " <== " + RHSAlt.stringify()+"  PREDx:"+LHSPov.mySymbol()+":"+LHSPov.stringify())
                        } else {
                            if(!predPushed){
                                if(!(LHSAlt===LHSPov)){ // push pred, but not to self
                                    LHSAlt!.pushPredecessor(LHSPov)
                                    predPushed <- true
                                }
                            }
                            if(aParent!.RHS!=NULL){
                                RHSAlt!.looseInhtd <- aParent!.RHS!.looseInhtd or aParent!.RHS!.looseMode
                                RHSAlt!.looseTop   <- false
                            }
                            //logSeg(" EnqY")
                            if(aParent!.
                                    activeIntersectionTraversalPlan()==NULL){
                                worldManager!.carryPassiveSelectionSource(
                                        LHSAlt, RHSAlt)
                            }
                            RHSAlt!.selectorLocalWork <- true
                            LHSAlt!.pItem!.addPOVToWrkList(RHSAlt)
         //                   log(idnt+"    ENQUEy:" + LHSAlt.stringify() + " === " + RHSAlt.stringify())
                        }
                    }
                    RHSAlt <- RHSAlt!.altPOV
                }
                lCount <+- 1
                LHSAlt <- LHSAlt!.altPOV
            }
        } else {if(LHSPovNext == NULL){
            //:l/PAI::logSegOut("NO_NXTb")
            return(NULL)}
        }
        // Schedule Process Infon Via Agenda
        our AItem: PIVA
        if(RhsAttached){
            // The source constraint remains on wrkList while this merge is in
            // flight. It and deferred residuals do not block propagation; a
            // different ready conjunction term still does.
            if(aParent!.LHS_item!.pItem!.hasReadyWrkListPOV(aParent!.sourceWorkPOV)){
                return(NULL)
            }
            me AItemParentRole: nextParentRole <- aprNoParent
            if(nxtsParent!=NULL){nextParentRole <- aprListCompletion}
            PIVA <- worldManager!.prepareInfonWork(agenda, LHSPovNext, NULL,
                    nxtsParent, nextParentRole, aItem!.priority+1,
                    srcPropagate)
            if(PIVA!=NULL){
                PIVA!.candidateForLast <- candidateForLast
                PIVA!.debugArg <- aParent
                //:l/PAI::logSeg(" PropPIVA:"+PIVA!.mySymbol())
                addDebugEvent("RegisterPIVA to propagate "+aItem!.stringify()+"\n    TO:"+LHSPovNext!.pItem!.mySymbol()+":"+toString(LHSPovNext!.pItem)+"\n", LHSPovNext!.pItem)
            }
        }
        // Clean and return
        if(!candidateForLast){LHSPovNext!.altPOV <- NULL}
        if(RHSPovNext!=NULL){RHSPovNext!.altPOV <- NULL}
        //:l/PAI::logSegOut("");
        return(PIVA)
    }
}

// Selects persistent constraints attached to a POV and prepares ordinary
// local merge work for the next eligible one. The wrkList remains the
// semantic AND representation; deferredWrkList is only its execution index
// for candidates that cannot make progress yet.
struct WorkListReasoner{
    me bool: processWorkList(their WorldManager: worldManager,
            their Agenda: agenda, our AItem: aItem,
            their List<our AItem>: requestedWork) <- {
        // If "{[....]| ... } <~ outr", prepend outr to wrkList.
        our infonView: lSpecItem <- aItem!.LHS_item!.pItem
        our infonView: lSpec <- lSpecItem!.value!.listSpec
        if(lSpec!=NULL and lSpecItem!.hasInnrOutr and
                lSpecItem!.intersectPos==ipNoIntersect and
                lSpec!.intersectPos!=ipNoIntersect){
            our POV:: newPov{11}
            newPov!.pItem <- lSpecItem!.funcArgs
            newPov!.selectorLocalWork <- true
            newPov!.looseMode <- true
            newPov!.isOutrFeed <- true
            newPov!.pItem!.asRHSInternalIdent <- true
            lSpecItem!.addPOVToWrkList(newPov)
            lSpecItem!.hasInnrOutr <- false
            lSpecItem!.funcArgs <- NULL
            lSpec!.asWrkLstOutr <- true
        }

        me bool: stopAndWait <- false
        our POV: LHSPov <- aItem!.LHS_item
        our POV: RHSPov <- NULL
        me bool: looseSize <- false
        if(!lSpecItem!.wrkList.isEmpty()){
            withEach candidateWorkPOV in lSpecItem!.wrkList{
                me bool: candidateDeferred <-
                        lSpecItem!.deferredWorkListContainsPOV(candidateWorkPOV)
                if(!candidateDeferred and
                        !(aItem!.inFlightWorkPOV===candidateWorkPOV)){
                    RHSPov <- candidateWorkPOV
                    break()
                }
            }
        }
        if(RHSPov!=NULL){
            looseSize <- RHSPov!.looseSize()
            LHSPov!.hasPropagated <- true
            if(!aItem!.dontProcess){
                our AItem: newAItem <- worldManager!.prepareMergeWork(
                        agenda, LHSPov, RHSPov, looseSize, aItem, aItem,
                        aprContextOnly, aItem!.priority, srcPMVA1)
                newAItem!.debugArg <- aItem
                newAItem!.sourceWorkOwner <- lSpecItem
                newAItem!.sourceWorkPOV <- RHSPov
                newAItem!.sourceWorkParent <- aItem
                newAItem!.sourceWorkRevision <- RHSPov!.workRevision
                newAItem!.constraintDisposition <- cdInFlight
                aItem!.inFlightWorkPOV <- RHSPov
                requestedWork.append(newAItem)
                stopAndWait <- true
            }else{
                lSpecItem!.discardWrkListPOV(RHSPov)
                log("DONT_PROCESS-a:"+aItem!.stringify())
            }
        }
        if(!LHSPov!.hasPropagated){
            if(!aItem!.dontProcess){
                our AItem: newAItem <- worldManager!.prepareMergeWork(
                        agenda, LHSPov, RHSPov, false, aItem, aItem,
                        aprContextOnly, aItem!.priority, srcPMVA2)
                newAItem!.debugArg <- aItem
                requestedWork.append(newAItem)
                stopAndWait <- true
                LHSPov!.hasPropagated <- true
            }else{
                log("DONT_PROCESS-b:"+aItem!.stringify())
            }
        }
        return(stopAndWait)
    }
}

// Coordinates POV-level candidate discovery while delegating each source to
// its owning reasoner.
struct POVLevelReasoner{
    me WorkListReasoner: workListReasoner
    me CorrespondenceReasoner: correspondenceReasoner
    me ReferenceMapper: referenceMapper
    me CursorPathResolver: cursorPathResolver
    me ParentMemberReasoner: parentMemberReasoner
    me TemporalIdentityReasoner: temporalIdentityReasoner

    me bool: derefInfonView(their WorldManager: worldManager,
            our infonView: CI) <- {
        return(referenceMapper.derefInfonView(worldManager, CI))
    }

    me bool: derefWordRules(their WorldManager: worldManager,
            our AItem: aItem) <- {
        return(referenceMapper.derefWordRules(worldManager, aItem))
    }

    me bool: funcArgRules(our AItem: aItem) <- {
        return(referenceMapper.funcArgRules(aItem))
    }

    me bool: processUnorderedInfonViews(their WorldManager: worldManager,
            their Agenda: agenda, our AItem: aItem,
            their bool: contnue,
            their List<our AItem>: requestedWork) <- {
        return(correspondenceReasoner.processUnorderedInfonViews(
                worldManager, agenda, aItem, contnue, requestedWork))
    }

    our POV: findNextLHS(their WorldManager: worldManager,
            our POV: LHSPov, our infItr: ii, me int64: skipDots,
            their int64: lvlsUpOnLeft, me bool: itrBeginning,
            me bool: LHSIsLST, me bool: RHSIsLST,
            me bool: unknownAsList, their int: waitState) <- {
        return(parentMemberReasoner.findNextLHS(worldManager, LHSPov, ii,
                skipDots, lvlsUpOnLeft, itrBeginning, LHSIsLST, RHSIsLST,
                unknownAsList, waitState))
    }

    our POV: findNextRHS(their WorldManager: worldManager,
            our POV: RHSPov, our infItr: ii, me int64: skipDots,
            their int64: lvlsUpOnRight, me bool: itrBeginning,
            me bool: LHSIsLST, me bool: RHSIsLST,
            their int: waitState) <- {
        return(parentMemberReasoner.findNextRHS(worldManager, RHSPov, ii,
                skipDots, lvlsUpOnRight, itrBeginning, LHSIsLST, RHSIsLST,
                waitState))
    }

    our AItem: propagate(their WorldManager: worldManager,
            their Agenda: agenda, our AItem: aItem,
            our POV: LHSPov, our POV: RHSPov, our POV: remainder,
            me bool: looseSize, bool: dontEnque,
            their int: waitState) <- {
        return(parentMemberReasoner.propagate(worldManager, agenda, aItem,
                LHSPov, RHSPov, remainder, looseSize, dontEnque, waitState))
    }

    our infonView: getSelfInfonView(our POV: startAnchor,
            our POV: cursorAnchor) <- {
        return(cursorPathResolver.getSelfInfonView(startAnchor, cursorAnchor))
    }

    their POV: getRelativeAnchor(our POV: startAnchor,
            our POV: cursorAnchor) <- {
        return(cursorPathResolver.getRelativeAnchor(startAnchor, cursorAnchor))
    }

    me bool: infonViewContainsNestedCursorLookup(their infonView: infn,
            their List<their infonView>: seen) <- {
        return(cursorPathResolver.infonViewContainsNestedCursorLookup(
                infn, seen))
    }

    me bool: RHSNeedsNestedCursorNormalization(
            their infonView: infn) <- {
        return(cursorPathResolver.RHSNeedsNestedCursorNormalization(infn))
    }

    me bool: lookUpCursor(their WorldManager: worldManager,
            our AItem: aItem) <- {
        return(cursorPathResolver.lookUpCursor(
                worldManager, aItem, temporalIdentityReasoner))
    }

    me bool: povIsUnderIncompleteStream(their POV: pov) <- {
        return(cursorPathResolver.povIsUnderIncompleteStream(pov))
    }

    me bool: hasLocalNullableContinuation(our AItem: aItem) <- {
        return(cursorPathResolver.hasLocalNullableContinuation(aItem))
    }

    me bool: processLocalNullableContinuation(
            their WorldManager: worldManager, their Agenda: agenda,
            our AItem: aItem, their bool: nxtAction,
            their List<our AItem>: requestedWork) <- {
        return(cursorPathResolver.processLocalNullableContinuation(
                worldManager, agenda, aItem, nxtAction, requestedWork,
                temporalIdentityReasoner))
    }

    me bool: resolveParts(their WorldManager: worldManager,
            their Agenda: agenda, our AItem: aItem,
            their bool: nxtAction,
            their List<our AItem>: requestedWork) <- {
        return(cursorPathResolver.resolveParts(
                worldManager, agenda, aItem, nxtAction, requestedWork,
                temporalIdentityReasoner))
    }

    me bool: processWorkList(their WorldManager: worldManager,
            their Agenda: agenda, our AItem: aItem,
            their List<our AItem>: requestedWork) <- {
        return(workListReasoner.processWorkList(
                worldManager, agenda, aItem, requestedWork))
    }
}

struct InfonViewReasoner{
    me ConcatReasoner: concatReasoner
    me ListShapeStrategy: listShapeStrategy
    me MergeSizeStrategy: mergeSizeStrategy
    me DirectConsolidationStrategy: directConsolidationStrategy
    me ListConsolidationStrategy: listConsolidationStrategy
    me IntersectionReasoner: intersectionReasoner

    our IntersectionTraversalPlan: planEndRelativeIntersectionTraversal(
            their WorldManager: worldManager, our POV: lhsPOV,
            our POV: sourcePOV) <- {
        our IntersectionTraversalPlan:: plan
        if(lhsPOV==NULL or lhsPOV!.pItem==NULL){return(plan)}
        our infonView: lhs <- lhsPOV!.pItem
        if(!lhs!.isInnr or lhs!.infSize!.overlayType!=NUM or
                lhs!.infSize!.evalMode!=emLiteral or lhs!.infSize!.num>=0){
            return(plan)
        }

        plan!.origin <- itoSourceEnd
        protect(streamingNormMutex){
            plan!.observedStreamingRevision <- streamingStateRevision
        }
        me int64: maxPatternExtent <- INT64_MAX
        me FlexNum: maxPatternExtentNum <- maxPatternExtent
        me FlexNum: minimumPatternOffset <- -maxPatternExtentNum
        if(lhs!.infSize!.num < minimumPatternOffset){
            plan!.status <- itpRejected
            plan!.patternMeasureStatus <- erpmInvalidRequest
            plan!.diagnostic <- "end-relative pattern extent exceeds int64"
            return(plan)
        }
        plan!.patternOffset <- lhs!.infSize!.num.convertToInt()
        plan!.patternLogicalExtent <- 0 - plan!.patternOffset
        if(sourcePOV==NULL or sourcePOV!.pItem==NULL){
            plan!.status <- itpRejected
            plan!.extentStatus <- eresIncompatible
            plan!.windowContentStatus <- erwcIncompatible
            plan!.diagnostic <- "end-relative traversal has no source POV"
            return(plan)
        }
        plan!.sourceContextPOV <- sourcePOV
        plan!.retainDependency(sourcePOV)

        me vocabularySpec: vSpec
        vSpec.init(worldManager!.agent!.getLocaleBaseName())
        me EndRelativePatternMeasureResult: measurement <-
                orderedSpanReasoner.measureEndRelativeFixedPattern(
                        lhsPOV, sourcePOV,
                        plan!.patternLogicalExtent, vSpec)
        plan!.patternMeasureStatus <- measurement.status
        plan!.sourceWindowLogicalExtent <-
                measurement.sourceLogicalExtent
        plan!.traversalUnit <- measurement.traversalUnit

        me EndRelativeExtentResult: extent <- orderedSpanReasoner.
                measureSourceExtentInUnit(
                        sourcePOV, plan!.traversalUnit, vSpec)
        plan!.extentStatus <- extent.status
        if(extent.status==eresExact){
            plan!.sourceLogicalExtent <- extent.exactExtent
        }

        if(extent.status==eresIncompatible){
            plan!.status <- itpRejected
            plan!.windowContentStatus <- erwcIncompatible
            plan!.diagnostic <- "end-relative source is not a logical list"
            return(plan)
        }
        if(extent.status!=eresExact){
            plan!.status <- itpPending
            plan!.diagnostic <- "end-relative source extent is not exact"
            return(plan)
        }
        if(measurement.status==erpmPending){
            plan!.status <- itpPending
            plan!.diagnostic <- "end-relative pattern measurement is pending"
            return(plan)
        }
        if(measurement.status!=erpmResolved){
            plan!.status <- itpRejected
            plan!.windowContentStatus <- erwcIncompatible
            if(measurement.status==erpmNonIntegralUnit){
                plan!.diagnostic <- "end-relative unit conversion is nonintegral"
            }else if(measurement.status==erpmIncompatibleUnit){
                plan!.diagnostic <- "end-relative unit is incompatible with source"
            }else if(measurement.status==erpmExtentOverflow){
                plan!.diagnostic <- "end-relative measured extent exceeds int64"
            }else{
                plan!.diagnostic <- "end-relative pattern measurement is invalid"
            }
            return(plan)
        }

        me EndRelativeWindowAvailability: availability
        if(plan!.traversalUnit==NULL){
            availability <- sourcePOV!.endRelativeWindowAvailability(
                    0-plan!.sourceWindowLogicalExtent,
                    plan!.sourceWindowLogicalExtent)
        }else{
            availability <- orderedSpanReasoner.endRelativeWindowInUnit(
                    sourcePOV, plan!.traversalUnit,
                    0-plan!.sourceWindowLogicalExtent,
                    plan!.sourceWindowLogicalExtent, vSpec)
        }
        plan!.windowContentStatus <- availability.status
        plan!.sourceStartIndex <- availability.startIndex
        if(availability.status==erwcPending){
            plan!.status <- itpPending
            plan!.diagnostic <- "end-relative source window is pending"
            return(plan)
        }
        if(availability.status!=erwcAvailable){
            plan!.status <- itpRejected
            if(availability.status==erwcOutOfRange){
                plan!.diagnostic <- "end-relative source window is out of range"
            }else{
                plan!.diagnostic <- "end-relative source window is incompatible"
            }
            return(plan)
        }

        plan!.sourceStartPOV <- availability.firstSourcePOV
        plan!.retainDependency(plan!.sourceStartPOV)
        plan!.status <- itpResolved
        return(plan)
    }

    our POV: realizeEndRelativeIntersectionTraversal(
            their WorldManager: worldManager,
            our POV: lhsPOV, our POV: sourcePOV,
            our IntersectionTraversalPlan: plan) <- {
        if(plan==NULL or plan!.status!=itpResolved){return(sourcePOV)}
        our POV: preparedViewPOV <- NULL
        me vocabularySpec: vSpec
        vSpec.init(worldManager!.agent!.getLocaleBaseName())
        our WordUse: immediateSourceUnit <-
                orderedSpanReasoner.orderedSpanImmediateUnitType(sourcePOV)
        if(plan!.traversalUnit!=NULL and immediateSourceUnit!=NULL and
                !orderedSpanReasoner.orderedSpanTypesMatch(
                        plan!.traversalUnit, immediateSourceUnit)){
            preparedViewPOV <- orderedSpanReasoner.
                    makeEndRelativeTraversalUnitView(
                            sourcePOV, plan!.traversalUnit,
                            plan!.sourceStartIndex,
                            plan!.sourceWindowLogicalExtent, vSpec)
        }
        our POV: localSourceViewPOV <-
                intersectionReasoner.prepareEndRelativeSourceView(
                        lhsPOV, sourcePOV,
                        plan!.sourceWindowLogicalExtent,
                        preparedViewPOV)
        if(localSourceViewPOV==NULL or localSourceViewPOV===sourcePOV){
            plan!.status <- itpRejected
            plan!.diagnostic <-
                    "resolved end-relative projection could not be constructed"
            return(sourcePOV)
        }
        if(localSourceViewPOV!.viewMap.sourcePov!==
                    plan!.sourceContextPOV or
                localSourceViewPOV!.viewMap.startPov!==
                    plan!.sourceStartPOV){
            logFatalError("End-relative traversal plan disagrees with projection")
        }
        plan!.localSourceViewPOV <- localSourceViewPOV
        plan!.retainDependency(localSourceViewPOV)
        return(localSourceViewPOV)
    }
    me OrderedSpanReasoner: orderedSpanReasoner
    me ReferenceConsolidationStrategy: referenceConsolidationStrategy
    me GeneratedMergeTrapStrategy: generatedMergeTrapStrategy
    me TemporalIdentityReasoner: temporalIdentityReasoner

    me InfonViewReasoningResult: planConsolidation(their WorldManager: worldManager,
            our AItem: aItem) <- {
        me InfonViewReasoningResult: result <- directConsolidationStrategy.planConsolidation(aItem)
        if(result.status!=rrNotApplicable){
            temporalIdentityReasoner.enumerateListIdentityImplications(
                    aItem, result)
            return(result)
        }
        // A mapped composite span identifies storage, so it must be handled
        // before ordinary list merging can consume it as a local value. Keep
        // the established ordering for every non-derived merge.
        if(aItem!.LHS_item!.viewMapWriteEnabled and
                aItem!.LHS_item!.viewMap.sourcePov!=NULL and
                aItem!.LHS_item!.viewMap.startPov!=NULL and
                aItem!.LHS_item!.pItem!.value!.overlayType==LST and
                aItem!.RHS!=NULL and aItem!.RHS!.pItem!=NULL and
                aItem!.RHS!.pItem!.value!.overlayType==LST){
            result <- referenceConsolidationStrategy.planConsolidation(aItem)
            if(result.status!=rrNotApplicable){
                temporalIdentityReasoner.enumerateListIdentityImplications(
                        aItem, result)
                return(result)
            }
        }
        result <- listConsolidationStrategy.planConsolidation(worldManager, aItem)
        if(result.status!=rrNotApplicable){
            temporalIdentityReasoner.enumerateListIdentityImplications(
                    aItem, result)
            return(result)
        }
        result <- intersectionReasoner.planConsolidation(aItem)
        if(result.status!=rrNotApplicable){
            temporalIdentityReasoner.enumerateListIdentityImplications(
                    aItem, result)
            return(result)
        }
        result <- orderedSpanReasoner.planConsolidation(worldManager, aItem)
        if(result.status!=rrNotApplicable){
            temporalIdentityReasoner.enumerateListIdentityImplications(
                    aItem, result)
            return(result)
        }
        result <- referenceConsolidationStrategy.planConsolidation(aItem)
        temporalIdentityReasoner.enumerateListIdentityImplications(
                aItem, result)
        return(result)
    }

    me bool: isDefinitionListShapeOnly(our AItem: aItem) <- {
        return(listShapeStrategy.isDefinitionListShapeOnly(aItem))
    }

    me bool: definitionListShapeNeedsMemberInstantiation(
            our AItem: aItem) <- {
        return(listShapeStrategy.
                definitionListShapeNeedsMemberInstantiation(aItem))
    }

    me bool: inheritDefinitionListShapeForInfonView(their WorldManager: worldManager,
            our infonView: target) <- {
        return(listShapeStrategy.inheritDefinitionListShapeForInfonView(
                worldManager, target))
    }

    me MergePreparationPlan: planMergePreparation(our AItem: aItem,
            me bool: sizeCopyAlreadyOwnedByConsolidation) <- {
        me MergePreparationPlan: plan <-
                listShapeStrategy.planDefinitionListShape(aItem)
        mergeSizeStrategy.planPreparation(aItem,
                sizeCopyAlreadyOwnedByConsolidation, plan)
        return(plan)
    }

    void: promoteMergePreparationToConsolidation(
            their InfonViewReasoningResult: consolidationPlan,
            their MergePreparationPlan: preparationPlan,
            me bool: consolidationCanExecute) <- {
        listShapeStrategy.promoteDefinitionListShapeToConsolidation(
                consolidationPlan, preparationPlan, consolidationCanExecute)
        mergeSizeStrategy.promoteSizeCopyToConsolidation(
                consolidationPlan, preparationPlan, consolidationCanExecute)
    }

    void: validateMergePreparation(our AItem: aItem,
            their MergePreparationPlan: plan) <- {
        mergeSizeStrategy.validatePreparation(aItem, plan)
    }

    me bool: processConcat(our AItem: aItem) <- {
        return(concatReasoner.processConcat(aItem))
    }

    me void: prepareIntersectionContext(our AItem: aItem) <- {
        intersectionReasoner.prepareInnerContext(aItem)
    }

    me void: prepareIntersectionAlternatives(
            their WorldManager: worldManager, their Agenda: agenda,
            our AItem: aItem,
            their List<our AItem>: requestedWork) <- {
        intersectionReasoner.prepareAlternatives(
                worldManager, agenda, aItem, requestedWork)
    }

    me void: prepareIntersectionFunction(
            their WorldManager: worldManager, their Agenda: agenda,
            our AItem: aItem,
            their List<our AItem>: requestedWork) <- {
        intersectionReasoner.prepareFunction(
                worldManager, agenda, aItem, requestedWork)
    }

    our infonView: selectIntersectionAlternative(
            their WorldManager: worldManager, our AItem: aItem) <- {
        return(intersectionReasoner.selectAlternative(worldManager, aItem))
    }

    our infonView: selectIntersectionFunctionResult(
            their WorldManager: worldManager, our AItem: aItem) <- {
        return(intersectionReasoner.selectFunctionResult(
                worldManager, aItem))
    }

    me void: installIntersectionResult(our AItem: aItem,
            our infonView: newTop) <- {
        intersectionReasoner.installSelectedResult(aItem, newTop)
    }

    void: recordAcceptedIntersectionCorrespondence(our AItem: aItem) <- {
        temporalIdentityReasoner.
                recordAcceptedBoundaryAssertionIdentity(aItem)
        intersectionReasoner.recordAcceptedCorrespondence(aItem)
    }

    me bool: temporalBoundaryAssertionCanBeAccepted(
            their AItem: aItem) <- {
        if(aItem==NULL){return(true)}
        return(temporalIdentityReasoner.
                temporalBoundaryAssertionCanBeAccepted(
                        aItem!.LHS_item, aItem!.RHS))
    }

    void: recordReasoningHandlers(our AItem: aItem,
            their InfonViewReasoningResult: result) <- {
        if(result.directCase!=dcNone){
            aItem!.phase1RecordHandler("strategy:directConsolidation", false)
        }
        else if(result.listCase!=lcNone){
            aItem!.phase1RecordHandler("strategy:listConsolidation", false)
        }
        else if(result.intersectionCase!=icNone){
            aItem!.phase1RecordHandler("strategy:intersectionConsolidation", false)
        }
        else if(result.orderedSpanCase!=ocNone){
            aItem!.phase1RecordHandler("strategy:orderedSpanConsolidation", false)
        }
        else if(result.referenceCase!=rcNone){
            aItem!.phase1RecordHandler("strategy:referenceConsolidation", false)
        }
        else{return()}
        if(result.directCase==dcCopyLiteralValueToUnknown){
            aItem!.phase1RecordHandler("direct:copyLiteralValueToUnknown", false)
        }
        else if(result.directCase==dcLiteralAlreadyConstrainsUnknown){
            aItem!.phase1RecordHandler("direct:literalAlreadyConstrainsUnknown", false)
        }
        else if(result.directCase==dcNumLiteralStrictEquality){
            aItem!.phase1RecordHandler("direct:numLiteralStrictEquality", false)
        }
        else if(result.directCase==dcStringLiteralStrictEquality){
            aItem!.phase1RecordHandler("direct:stringLiteralStrictEquality", false)
        }
        else if(result.directCase==dcStrictOverlayTypeMismatch){
            aItem!.phase1RecordHandler("direct:strictOverlayTypeMismatch", false)
        }
        else if(result.directCase==dcScalarUnknownWithoutConstraints){
            aItem!.phase1RecordHandler("direct:scalarUnknownWithoutConstraints", false)
        }
        else if(result.directCase==dcLooseNumericRangeLiteral){
            aItem!.phase1RecordHandler("direct:looseNumericRangeLiteral", false)
        }
        else if(result.directCase==dcLooseStringWholeCopy){
            aItem!.phase1RecordHandler("direct:looseStringWholeCopy", false)
        }
        else if(result.directCase==dcLooseStringExactLiteral){
            aItem!.phase1RecordHandler("direct:looseStringExactLiteral", false)
        }
        else if(result.directCase==dcLooseStringRemainder){
            aItem!.phase1RecordHandler("direct:looseStringRemainder", false)
        }
        else if(result.directCase==dcStrictAnyCopiesIdentity){
            aItem!.phase1RecordHandler("direct:strictAnyCopiesIdentity", false)
        }
        else if(result.directCase==dcScalarUnknownCopiesIdentity){
            aItem!.phase1RecordHandler("direct:scalarUnknownCopiesIdentity", false)
        }
        else if(result.directCase==dcScalarUnknownCopiesConstraints){
            aItem!.phase1RecordHandler("direct:scalarUnknownCopiesConstraints", false)
        }
        else if(result.directCase==dcLooseAnyCopiesValue){
            aItem!.phase1RecordHandler("direct:looseAnyCopiesValue", false)
        }
        else if(result.directCase==dcLooseScalarUnknownWithoutConstraints){
            aItem!.phase1RecordHandler("direct:looseScalarUnknownWithoutConstraints", false)
        }
        else if(result.directCase==dcNumericRangeDeepCopy){
            aItem!.phase1RecordHandler("direct:numericRangeDeepCopy", false)
        }
        else if(result.directCase==dcConcatRangeIntersection){
            aItem!.phase1RecordHandler("direct:concatRangeIntersection", false)
        }
        else if(result.directCase==dcEquivalentNumericTemplatePolarity){
            aItem!.phase1RecordHandler("direct:equivalentNumericTemplatePolarity", false)
        }
        else if(result.directCase==dcUnresolvedNumericTemplatePolarity){
            aItem!.phase1RecordHandler("direct:unresolvedNumericTemplatePolarity", false)
        }
        else if(result.listCase==lcStrictUnknownLists){
            aItem!.phase1RecordHandler("list:strictUnknownLists", false)
        }
        else if(result.listCase==lcStrictUnknownFromLiteralList){
            aItem!.phase1RecordHandler("list:strictUnknownFromLiteralList", false)
        }
        else if(result.listCase==lcStrictLiteralAgainstUnknownList){
            aItem!.phase1RecordHandler("list:strictLiteralAgainstUnknownList", false)
        }
        else if(result.listCase==lcUnresolvedListTemplatePolarity){
            aItem!.phase1RecordHandler("list:unresolvedTemplatePolarity", false)
        }
        else if(result.listCase==lcStrictLiteralLists){
            aItem!.phase1RecordHandler("list:strictLiteralLists", false)
        }
        else if(result.listCase==lcLooseUnknownLists){
            aItem!.phase1RecordHandler("list:looseUnknownLists", false)
        }
        else if(result.listCase==lcLooseUnknownFromLiteralList){
            aItem!.phase1RecordHandler("list:looseUnknownFromLiteralList", false)
        }
        else if(result.listCase==lcLooseLiteralAgainstUnknownList){
            aItem!.phase1RecordHandler("list:looseLiteralAgainstUnknownList", false)
        }
        else if(result.listCase==lcLooseLiteralLists){
            aItem!.phase1RecordHandler("list:looseLiteralLists", false)
        }
        else if(result.listCase==lcLooseListAgainstScalar){
            aItem!.phase1RecordHandler("list:looseListAgainstScalar", false)
        }
        else if(result.intersectionCase==icStrictScalarAgainstIntersection){
            aItem!.phase1RecordHandler("intersection:strictScalarAgainstIntersection", false)
        }
        else if(result.intersectionCase==icAnyAgainstIntersection){
            aItem!.phase1RecordHandler("intersection:anyAgainstIntersection", false)
        }
        else if(result.intersectionCase==icStrictListAgainstIntersection){
            aItem!.phase1RecordHandler("intersection:strictListAgainstIntersection", false)
        }
        else if(result.intersectionCase==icConcatAgainstIntersection){
            aItem!.phase1RecordHandler("intersection:concatAgainstIntersection", false)
        }
        else if(result.intersectionCase==icNestedIntersection){
            aItem!.phase1RecordHandler("intersection:nestedIntersection", false)
        }
        else if(result.orderedSpanCase==ocExactAlignment){
            aItem!.phase1RecordHandler("orderedSpan:exactAlignment", false)
        }
        else if(result.orderedSpanCase==ocSplitRHS){
            aItem!.phase1RecordHandler("orderedSpan:splitRHS", false)
        }
        else if(result.orderedSpanCase==ocSplitLHS){
            aItem!.phase1RecordHandler("orderedSpan:splitLHS", false)
        }
        else if(result.referenceCase==rcCopySourceIdentity){
            aItem!.phase1RecordHandler("reference:copySourceIdentity", false)
        }
    }

    our POV: execConsolidationPlan(their WorldManager: worldManager, our AItem: aItem,
            their InfonViewReasoningResult: result) <- {
        our POV: remainder <- NULL
        temporalIdentityReasoner.execListIdentityImplications(aItem, result)
        // Definition-backed shape is committed first, preserving its historical
        // order relative to ordinary size/value effects while remaining atomic
        // with the accepted consolidation plan.
        listShapeStrategy.execDefinitionListShape(aItem, result)
        if(result.copySize and !result.copyDefinitionSize){
            worldManager!.DO_COPY(aItem!.RHS!.pItem!.infSize, aItem!.LHS_item!.pItem!.infSize, 0)
        }
        if(result.consolidationAction==caCopyRHSValueToLHS){
            worldManager!.DO_COPY(aItem!.RHS!.pItem!.value, aItem!.LHS_item!.pItem!.value,
                    aItem!.sizeToCopy)
        }
        else if(result.consolidationAction==caCopyRHSRangeMatchToLHS){
            worldManager!.DO_COPY(aItem!.RHS!.pItem!.value, aItem!.LHS_item!.pItem!.value,
                    aItem!.sizeToCopy)
            aItem!.LHS_item!.pItem!.invertMatch <- aItem!.RHS!.pItem!.invertMatch
            if(aItem!.LHS_item!.outerPOV!=NULL){
                aItem!.LHS_item!.outerPOV!.pItem!.altRulesApplied <- false
            }
        }
        else if(result.consolidationAction==caCopyRHSWholeStringToLHS){
            aItem!.sizeToCopy <- aItem!.RHS!.pItem!.value!.str.size()
            aItem!.LHS_item!.pItem!.value!.evalMode <- emLiteral
            aItem!.LHS_item!.pItem!.value!.str <- aItem!.RHS!.pItem!.value!.str
            if(aItem!.LHS_item!.pItem!.infSize!.evalMode==emUnknown){
                aItem!.LHS_item!.pItem!.value!.sizeMode <- fromGiven
            }
            else{aItem!.LHS_item!.pItem!.value!.sizeMode <- fromCount}
        }
        else if(result.consolidationAction==caCopyRHSIdentityToLHS){
            referenceConsolidationStrategy.copyIdentity(worldManager, aItem)
        }
        else if(result.consolidationAction==caCopyRHSWorkListToLHS){
            aItem!.LHS_item!.pItem!.copyWrkListFrom(aItem!.RHS!.pItem)
        }
        else if(result.consolidationAction==caCopyRHSValueAndTypeToLHS){
            aItem!.LHS_item!.pItem!.value!.overlayType <- aItem!.RHS!.pItem!.value!.overlayType
            aItem!.LHS_item!.pItem!.viewMode <- aItem!.RHS!.pItem!.viewMode
            worldManager!.DO_COPY(aItem!.RHS!.pItem!.value, aItem!.LHS_item!.pItem!.value,
                    aItem!.sizeToCopy)
        }
        else if(result.consolidationAction==caMergeRHSIntersection){
            intersectionReasoner.mergeRHSIntersect(aItem)
        }
        else if(result.consolidationAction==caMergeLooseStrings){
            remainder <- directConsolidationStrategy.mergeLooseStrings(aItem)
        }
        else if(result.consolidationAction==caCopyRHSInfonToLHS){
            aItem!.LHS_item!.pItem! <- aItem!.RHS!.pItem!
            if(aItem!.LHS_item!.outerPOV!=NULL){
                aItem!.LHS_item!.outerPOV!.pItem!.altRulesApplied <- false
            }
        }
        else if(result.consolidationAction==caMergeANDRanges){
            directConsolidationStrategy.mergeANDRanges(aItem)
        }
        else if(result.consolidationAction==caPrepareUnknownListForPropagation){
            listConsolidationStrategy.prepareUnknownListForPropagation(aItem)
        }
        else if(result.consolidationAction==caMergeRHSListConstraints){
            listConsolidationStrategy.mergeRHSListConstraints(aItem)
        }
        else if(result.consolidationAction==caApplyOrderedSpanPlan){
            remainder <- orderedSpanReasoner.execConsolidationPlan(aItem, result)
        }
        if(result.workAction==waStartListPropagation){
            listConsolidationStrategy.execStartPropagation(worldManager, aItem)
        }
        return(remainder)
    }

    our POV: mergeInfonStates(their WorldManager: worldManager, our AItem: aItem,
            their InfonViewReasoningResult: result, me bool: commitConsolidationPlan) <- {
        recordReasoningHandlers(aItem, result)
        if(aItem!.sourceWorkPOV!=NULL and result.status!=rrNotApplicable){
            aItem!.constraintDisposition <- result.constraintDisposition
        }
        if(result.status==rrRejected){
            aItem!.mergeStatus <- msReject
            aItem!.LHS_item!.rejected <- true
            if(result.emitRejectLog){
                // Preserve the existing numeric-literal rejection diagnostic.
                //:l/PAI::logSeg("REJECT")
            }
            if(commitConsolidationPlan and result.actionCommitPolicy==cpFinalAcceptance){
                return(execConsolidationPlan(worldManager, aItem, result))
            }
            return(NULL)
        }
        if(result.status==rrHandledNoChange or result.status==rrPlannedChange or
                result.status==rrNeedsWork){
            if(commitConsolidationPlan){
                return(execConsolidationPlan(worldManager, aItem, result))
            }
            return(NULL)
        }
        return(generatedMergeTrapStrategy.mergeInfonStates(worldManager, aItem))
    }
}

// Owns the semantic interpretation and mutations of the rsMerge steps.
// MergeProcessor retains only step transitions, work scheduling, propagation
// invocation, and translation to the common dispatch result.
struct MergeReasoner{
    me MergeStep0SemanticResult: processStep0(
            their WorldManager: worldManager, our AItem: aItem) <- {
        me MergeStep0SemanticResult: result
        result.action <- ms0NormalizeRHS
        aItem!.mergeStatus <- msAccept
        if(aItem!.RHS==NULL or aItem!.skipRHSUsageInPAI){
            aItem!.phase1RecordHandler("merge:step0:singleSided", false)
            //:l/PAI::logSeg(" MGxR")
            if(!aItem!.LHS_item!.pItem!.wasProcessed and
                    aItem!.LHS_item!.pItem!.value!.overlayType==LST){
                worldManager!.initListIterators(aItem)
            }
            result.action <- ms0SingleSided
            return(result)
        }

        aItem!.phase1RecordHandler("merge:step0:inspectRHS", false)
        our infonView: RHS <- aItem!.RHS!.pItem
        fleshOutWord(worldManager!.agent, RHS)
        if((RHS!.type==NULL or RHS!.itmMode==mWordDefn or RHS!.isFromDefn) and
                RHS!.cursorMode==cmNone and RHS!.value!.evalMode!=emConcat and
                !worldManager!.RHSNeedsNestedCursorNormalization(RHS)){
            logSeg(":setStep1:a")
            result.action <- ms0RHSReady
        }
        return(result)
    }

    // Attach one plan to the merge AItem before any negative-sized request is
    // rewritten into the ordinary forward projection. Pending plans keep the
    // request negative and ask Agenda to retain this same lifecycle owner.
    me bool: applyEndRelativeIntersectionTraversalPlan(
            their WorldManager: worldManager, our AItem: aItem,
            their MergeStepSemanticResult: result) <- {
        our IntersectionTraversalPlan: plan <-
                worldManager!.planEndRelativeIntersectionTraversal(
                        aItem!.LHS_item, aItem!.RHS)
        if(plan==NULL or plan!.status==itpNotApplicable){return(false)}
        aItem!.intersectionTraversalPlan <- plan
        if(plan!.status==itpPending){
            aItem!.mergeStatus <- msPending
            result!.retainPendingIntersectionTraversal <- true
            result!.stopCurrentDispatch <- true
            return(true)
        }
        if(plan!.status==itpRejected){
            aItem!.mergeStatus <- msReject
            return(false)
        }

        aItem!.RHS <- worldManager!.
                realizeEndRelativeIntersectionTraversal(
                        aItem!.LHS_item, aItem!.RHS, plan)
        if(plan!.status==itpRejected){aItem!.mergeStatus <- msReject}
        return(false)
    }

    me MergeStepSemanticResult: processStep1(
            their WorldManager: worldManager, their Agenda: agenda,
            our AItem: aItem) <- {
        me MergeStepSemanticResult: result
        if(applyEndRelativeIntersectionTraversalPlan(
                worldManager, aItem, result)){
            return(result)
        }
        me bool: LHSWasTentative <- aItem!.LHS_item!.pItem!.isTentative
        me bool: invertAcceptance <- aItem!.LHS_item!.applyAsNot(aItem!.RHS)
        if(!invertAcceptance and
                !worldManager!.infonViewReasoner.
                        temporalBoundaryAssertionCanBeAccepted(aItem)){
            aItem!.mergeStatus <- msReject
            aItem!.LHS_item!.rejected <- true
        }
        our AItem: mrgParent <- aItem!.parentListsMrgAItem()
        me bool: parentListIsAsNot <- mrgParent!=NULL and
                mrgParent!.LHS_item!.applyAsNot(mrgParent!.RHS)
        our POV: remainder
        if(aItem!.RHS!.pItem!.intersectPos==ipNoIntersect){
            me int: isCompatible
            if(aItem!.LHS_item!.trueByDefinition){isCompatible <- true}
            else{
                isCompatible <- aItem!.LHS_item!.pItem!.isCompatibleWith(
                        aItem!.RHS!.pItem, aItem!.RHS!.trueByDefinition)
                if(isCompatible==tvFalse and
                        aItem!.LHS_item!.isSparseOrderedSpan() and
                        aItem!.RHS!.isSparseOrderedSpan()){
                    me vocabularySpec: vSpec
                    vSpec.init(worldManager!.agent!.getLocaleBaseName())
                    if(worldManager!.sparseOrderedSpanMergeAlignable(
                            aItem!.LHS_item, aItem!.RHS, vSpec)){
                        isCompatible <- tvTrue
                    }
                }
                if(isCompatible!=tvTrue and
                        aItem!.LHS_item!.pItem!.type!=NULL and
                        aItem!.RHS!.pItem!.value!.overlayType==LST and
                        aItem!.RHS!.pItem!.value!.listSpec!=NULL and
                        aItem!.RHS!.pItem!.value!.listSpec!.type!=NULL){
                    me vocabularySpec: vSpec
                    vSpec.init(worldManager!.agent!.getLocaleBaseName())
                    our OrderedSpanConverter: spanConverter <-
                            modelMngr.getOrderedSpanConverter(
                                    aItem!.LHS_item!.pItem!.type,
                                    aItem!.RHS!.pItem!.value!.listSpec!.type,
                                    vSpec)
                    if(spanConverter!=NULL and spanConverter!.valid and
                            spanConverter!.fromBaseCount>=
                                    spanConverter!.toBaseCount){
                        isCompatible <- tvTrue
                    }
                }
            }
            if(!aItem!.looseSize){
                if(isCompatible==tvFalse){aItem!.mergeStatus <- msReject}
                else if(isCompatible==tvUnknown and
                        aItem!.LHS_item!.pItem!.useMode==umQuestion){
                    aItem!.mergeStatus <- msReject
                }
            }
        }

        // Consolidation and preparation planning are read-only. Any
        // definition-backed shape or generic size effect is promoted into the
        // accepted consolidation plan before anything is committed.
        me InfonViewReasoningResult: consolidationPlan <-
                worldManager!.infonViewReasoner.planConsolidation(
                        worldManager, aItem)
        me bool: consolidationCanExecute <-
                !aItem!.RHS!.forceID and
                aItem!.RHS!.pItem!.getOrderMode(worldManager!.agent)!=uUnordered and
                aItem!.RHS!.pItem!.viewMode!=vmAny
        me bool: sizeCopyAlreadyOwnedByConsolidation <-
                consolidationCanExecute and consolidationPlan.copySize
        if(aItem!.mergeStatus!=msReject and
                aItem!.LHS_item!.pItem!.getOrderMode(
                        worldManager!.agent)!=uUnordered){
            me MergePreparationPlan: mergePreparationPlan <-
                    worldManager!.infonViewReasoner.planMergePreparation(
                            aItem, sizeCopyAlreadyOwnedByConsolidation)
            worldManager!.infonViewReasoner.
                    promoteMergePreparationToConsolidation(
                            consolidationPlan, mergePreparationPlan,
                            consolidationCanExecute)
            worldManager!.infonViewReasoner.validateMergePreparation(
                    aItem, mergePreparationPlan)
        }

        if(aItem!.mergeStatus!=msReject){
            if(aItem!.RHS!.forceID){
                aItem!.phase1RecordHandler("merge:forceIdentity", false)
                aItem!.RHS!.pItem!.copyAsTypeTo(
                        aItem!.LHS_item!.pItem, false, true)
            }else{
                me bool: contnue <- true
                if(worldManager!.processUnorderedInfonViews(
                        agenda, aItem, contnue, result.requestedWork)){
                    aItem!.phase1RecordHandler("merge:unordered", false)
                    if(!contnue){
                        result.advanceToStep2 <- true
                        result.stopCurrentDispatch <- true
                        return(result)
                    }
                    if(aItem!.LHS_item!.pItem!.value!.overlayType==LST){
                        our POV: tmp <- aItem!.RHS
                        aItem!.RHS <- NULL
                        worldManager!.initListIterators(aItem)
                        aItem!.RHS <- tmp
                    }
                }else{
                    if(aItem!.RHS!.pItem!.viewMode==vmAny){
                        aItem!.phase1RecordHandler("merge:rhsAny", false)
                        if(aItem!.RHS!.pItem!.type!=NULL and
                                aItem!.LHS_item!.pItem!.type==NULL){
                            log(indentStr(aItem!.indentLvl)+
                                    "        merge  |||r?|       copyType")
                            aItem!.LHS_item!.pItem!.type <-
                                    aItem!.RHS!.pItem!.type
                        }
                        if(aItem!.LHS_item!.pItem!.value!.overlayType==LST){
                            aItem!.RHS <- NULL
                            worldManager!.initListIterators(aItem)
                            aItem!.mergeStatus <- msUnknown
                        }
                    }else{
                        me bool: commitConsolidationPlan <- !invertAcceptance
                        if(consolidationPlan.actionCommitPolicy==
                                cpPositiveTemplateAcceptance){
                            commitConsolidationPlan <-
                                    consolidationPlan.status!=rrRejected
                        }
                        else if(consolidationPlan.actionCommitPolicy==
                                cpFinalAcceptance){
                            me bool: positiveTemplateAccepted <-
                                    consolidationPlan.status!=rrRejected
                            commitConsolidationPlan <-
                                    positiveTemplateAccepted!=invertAcceptance
                        }
                        remainder <- worldManager!.infonViewReasoner.
                                mergeInfonStates(worldManager, aItem,
                                        consolidationPlan,
                                        commitConsolidationPlan)
                        if(commitConsolidationPlan and
                                consolidationPlan.workAction==
                                waInstantiateDefinitionListMembers){
                            worldManager!.infonViewReasoner.
                                    listConsolidationStrategy.
                                    prepareDefinitionListMemberWork(
                                            worldManager, agenda, aItem,
                                            result.requestedWork)
                        }
                    }
                }
            }
        }

        if(invertAcceptance and !consolidationPlan.statusIncludesPolarity){
            if(aItem!.mergeStatus==msAccept){aItem!.mergeStatus <- msReject}
            else if(aItem!.mergeStatus==msReject){
                aItem!.mergeStatus <- msAccept
            }
        }
        aItem!.LHS_item!.rejected <- aItem!.mergeStatus==msReject

        if(aItem!.mergeStatus==msAccept){
            worldManager!.infonViewReasoner.
                    recordAcceptedIntersectionCorrespondence(aItem)
        }

        our POV: RHSSide
        if(remainder==NULL){RHSSide <- aItem!.RHS}
        if(aItem!.mergeStatus!=msPending){
            if(aItem!.mergeStatus!=msReject){
                // Optimization: propagate already-initialized type state.
                if(aItem!.RHS!=NULL and aItem!.RHS!.pItem!.isTypeExample){
                    me string: typeIDStr <- aItem!.RHS!.pItem!.type!.typeID()
                    withEach LHSSpec in aItem!.LHS_item!.pItem!.addedTypes{
                        if(LHSSpec!.typeID()==typeIDStr){
                            LHSSpec!.typeInitialized <- true
                            break()
                        }
                    }
                }
                if(!aItem!.looseSize and aItem!.RHS!=NULL and
                        aItem!.RHS!.pItem!.generality==gConcrete){
                    aItem!.LHS_item!.pItem!.generality <- gConcrete
                    aItem!.LHS_item!.pItem!.proxy <- aItem!.RHS!.pItem
                }
                // Propagation clears an accepted dot-created tentative when it
                // can look ahead. A terminal accepted merge has no later pass.
                if(aItem!.RHS!=NULL and LHSWasTentative and
                        aItem!.LHS_item!.tentFromDots and
                        aItem!.LHS_item!.pItem!.isTentative and
                        aItem!.LHS_item!.pItem!.value!.sizeMode!=fromGiven and
                        !aItem!.LHS_item!.applyAsNot(aItem!.RHS) and
                        !aItem!.RHS!.pItem!.isTentative and
                        !aItem!.RHS!.pItem!.asRHSInternalIdent and
                        !(aItem!.RHS!.pParent!=NULL and
                          aItem!.RHS!.pParent!.pItem!.asRHSInternalIdent)){
                    aItem!.LHS_item!.pItem!.isTentative <- false
                }
                result.advanceToStep2 <- true
                result.requestPropagation <- true
                result.propagationRHS <- RHSSide
                result.propagationRemainder <- remainder
                result.propagationLooseSize <- aItem!.looseSize
            }else{
                if(parentListIsAsNot){mrgParent!.mergeStatus <- msAccept}
                their POV: pParent <- aItem!.LHS_item!.pParent
                me bool: parentInfonIsNullableList <-
                        pParent!=NULL and
                        pParent!.pItem!.value!.items.size()==1 and
                        pParent!.pItem!.value!.tailUnfinished
                if(aItem!.parent!.candidateForLast or
                        parentInfonIsNullableList or parentListIsAsNot){
                    result.requestPropagation <- true
                    result.propagationRHS <- RHSSide
                    result.propagationRemainder <- remainder
                    result.propagationLooseSize <- aItem!.looseSize
                    result.propagationDontEnque <- !parentListIsAsNot
                }else{
                    me bool: candidatesEmpty <- true
                    if(pParent!=NULL and
                            !pParent!.candidatesForLastItem.isEmpty()){
                        candidatesEmpty <- false
                    }
                    if(!aItem!.looseSize and
                            !aItem!.LHS_item!.pItem!.isTentative and
                            !aItem!.RHS!.pItem!.isTentative and
                            candidatesEmpty){
                        // A completed list-spec group can speculatively carry
                        // its member type into the following group and reject
                        // here without corrupting the result.  Do not suppress
                        // that propagation merely to remove this notice: it
                        // currently also wakes normalization of later groups
                        // (e.g. Slipstream's Rubix widget).  First decouple that
                        // lifecycle scheduling from the speculative merge.
                        worldManager!.agent!.CORE!.handleProteusError(
                                aItem!.LHS_item!.pItem!.originID,
                                "Proteus NOTICE - Candidates Empty:\n    LHS:"+
                                shortedStr(aItem!.LHS_item!.stringify(),60)+
                                "\n    RHS:"+shortedStr(aItem!.RHS!.stringify(),60)+
                                "\n    AItem pedigree:"+
                                worldManager!.aItemSourceName(
                                        aItem!.pedigree.source)+
                                " LHS pedigree:"+
                                toString(aItem!.LHS_item!.pedigree.source)+
                                "  RHS pedigree:"+
                                toString(aItem!.RHS!.pedigree.source))
                    }
                    if(aItem!.pendingListChildren==0){
                        result.completeSourceWork <- true
                        result.fulfillSubscribers <- true
                    }
                }
            }
        }else{log("mergeStatusPENDING:")}
        return(result)
    }

    me MergeStepSemanticResult: processStep2(
            their WorldManager: worldManager, our AItem: aItem) <- {
        me MergeStepSemanticResult: result
        if(aItem!.mergeStatus==msUnknown){
            if(aItem!.LHS_item!.applyAsNot(aItem!.RHS)){
                aItem!.mergeStatus <- msReject
            }else{aItem!.mergeStatus <- msAccept}
        }
        if(aItem!.LHS_item!.pItem!.value!.tailUnfinished and
                aItem!.LHS_item!.pItem!.infSize!.evalMode==emLiteral){
            aItem!.LHS_item!.pItem!.countSize(true)
        }
        if(aItem!.mergeStatus==msAccept){
            worldManager!.infonViewReasoner.
                    recordAcceptedIntersectionCorrespondence(aItem)
        }
        if(aItem!.skipRHSUsageInPAI or
                aItem!.LHS_item!.propagateInMrg2){
            aItem!.LHSItr <- NULL
            aItem!.RHSItr <- NULL
            result.requestPropagation <- true
            result.propagationRHS <- aItem!.RHS
        }
        result.completeSourceWork <- true
        result.fulfillSubscribers <- true
        return(result)
    }
}
