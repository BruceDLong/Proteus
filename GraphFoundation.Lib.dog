// Proteus4 graph normalization foundation. Semantic knowledge remains in CodeDog;
// the native runtime supplies generic queues, costs, locking and RAII shutdown.
requirements = [[tagOneOf, Lang, [CPP]]]
interface = { provides=[GraphFoundation] libFiles=[pthread] headers=[] }
LibDescription = { useStatus=dynamic description='Proteus4 graph foundation' features=[GraphFoundation] Lang=[CPP] }

embedVeryHigh = `
# include "../graph/GraphSearch.h"
using Proteus4Handle = proteus4::NormalizationHandle<std::shared_ptr<POV>>;
using Proteus4Runtime = proteus4::GraphManager<std::shared_ptr<POV>>;
using Proteus4Publication = std::shared_ptr<proteus4::Publication<std::shared_ptr<POV>>>;
`
embedHigh = `
# include "../graph/ProteusGraph.h"
`

struct NormalizationHandle: wraps=Proteus4Handle {
    void: waitForCompletion() <- <%!waitForCompletion()%>
    void: cancel() <- <%!cancel()%>
    me bool: fullyNormed() <- <%!status().fullyNormed%>
    me bool: withSubscribers() <- <%!status().withSubscribers%>
    me bool: symbolicValues() <- <%!status().symbolicValues%>
    me bool: cancelled() <- <%!status().cancelled%>
    me bool: failed() <- <%!status().failed%>
    me bool: active() <- <%!active()%>
    me string: error() <- <%!status().error%>
    me string: stepDescription(me int64: index) <- <%!steps().at(%1).action%>
    me uint64: stepCost(me int64: index) <- <%!steps().at(%1).cost%>
    our POV: stepNode(me int64: index) <- <%!steps().at(%1).query.node%>
    me int64: stepCount() <- <%!steps().size()%>
    our POV: result() <- <%!result()%>
}
struct GraphRuntime: wraps=Proteus4Runtime {}
struct GraphPublication: wraps=Proteus4Publication {}

// A semantic context owns one graph manager and its registry. Agent uses one
// for its whole lifetime; standalone contexts remain available for experiments.
struct GraphNormalizer {
    me GraphRuntime: runtime
    our ProteusGraphAccess: access
    void: init() <- <%{
        if (access) throw std::logic_error("GraphNormalizer already initialized");
        access = std::make_shared<ProteusGraphAccess>();
        access->initialize();
        runtime.init(std::make_shared<proteus4::ProteusAccess>(access));
    }%>
    void: initWithRegistry(our IdentityRegistry: existing) <- <%{
        if (access || !existing) throw std::logic_error("new context and registry required");
        access = std::make_shared<ProteusGraphAccess>();
        access->registry = existing;
        runtime.init(std::make_shared<proteus4::ProteusAccess>(access));
    }%>
    me NormalizationHandle: normalize(our POV: target) <- <%{
        runtime.update([&] { access->bind(target); });
        return runtime.normalize({target, proteus4::sizeAndValue, 0});
    }%>
    me NormalizationHandle: normalizeWithCost(our POV: target, me uint64: maximumRoute) <- <%{
        runtime.update([&] { access->bind(target); });
        proteus4::CostPolicy policy;
        policy.maximumRoute = maximumRoute;
        return runtime.normalize({target, proteus4::sizeAndValue, 0}, policy);
    }%>
    me NormalizationHandle: findItem(our POV: source, me int64: index) <- <%{
        runtime.update([&] { access->bind(source); });
        return runtime.normalize({source, proteus4::itemAt, index});
    }%>
    void: addRHS(our POV: target, our POV: rhs) <- <%{
        runtime.update([&] {
            access->bind(target); access->bind(rhs);
            target->pItem->addPOVToWrkList(rhs);
        });
    }%>
    void: recordIdentity(our POV: left, our POV: right) <- <%{
        runtime.update([&] { access->recordIdentity(left, right); });
    }%>
    me string: stringifyResult(our POV: target) <- <%{
        return runtime.read([&] { return target->stringify(); });
    }%>
    me GraphPublication: beginPublication() <- <%{ return runtime.beginPublication(); }%>
    void: prepareInput(our infonView: inf) <- <%{
        runtime.update([&] { access->prepareInput(inf); });
    }%>
    void: waitForInput(me NormalizationHandle: handle, our POV: target) <- <%{
        handle.waitUntil([this, target] { return !access->inputPending(target); });
    }%>
    void: close() <- <%{ runtime.close(); }%>
}

// Evidence collected by a physical-member walk, not a second list or graph.
struct GraphListMeasure {
    me FlexNum: count <- 0
    me bool: known <- true
    void: reset() <- {count <- 0; known <- true}
    void: add(our POV: member) <- {
        if(member!.isSubItm){
            if(member!.pItem!.infSize!.overlayType==NUM and
                    member!.pItem!.infSize!.evalMode==emLiteral and
                    !member!.pItem!.infSize!.inverted and !member!.pItem!.infSize!.undefined and
                    member!.pItem!.infSize!.num>=0 and
                    member!.pItem!.infSize!.num.getDenominator()==1){
                count <+- member!.pItem!.infSize!.num
            }else{known <- false}
        }else if(member!.pItem!.itmMode==mItem or member!.pItem!.itmMode==mWordDefn){count <+- 1}
        else{known <- false}
    }
}

// Retain the original expression as provenance after publishing its result.
// Its operand POVs remain searchable; they are not copied into a second graph.
struct infonView {
    our infonState: sizeExpression
    our infonState: valueExpression
    our infonView: selectionExpression
    our POV: selectedResult
    me int: selectionKind <- 0
    me string: graphParseError
}
struct GraphConcatTerms { me List<our POV>: items }
struct GraphConcatPlan {
    me bool: valid <- false
    me int: type <- 0  // assigned from the first operand before the plan is valid
    me FlexNum: number
    me string: text
    me bool: sizeKnown <- false
    me FlexNum: size
    me List<our POV>: members
    me bool: open <- false
    me uint64: creations <- 0
    me uint64: visits <- 0
}

// Scalar requirements compiled from read-only definition bodies. Unknown
// fields are unconstrained; named types are separate graph obligations.
struct GraphTypeFacts {
    me bool: valid <- false
    me int: overlay <- -1
    me bool: hasSize <- false
    me bool: explicitSize <- false
    me FlexNum: size
    me bool: hasValue <- false
    me FlexNum: number
    me string: text
    me bool: same(me GraphTypeFacts: other) <- {
        return(valid==other.valid and overlay==other.overlay and hasSize==other.hasSize and
               explicitSize==other.explicitSize and
               (!hasSize or size==other.size) and hasValue==other.hasValue and
               (!hasValue or (number==other.number and text==other.text)))
    }
    me bool: combine(me GraphTypeFacts: other) <- {
        if(!other.valid){return(false)}
        if(overlay>=0 and other.overlay>=0 and overlay!=other.overlay){return(false)}
        if(hasSize and other.hasSize and size!=other.size){return(false)}
        if(hasValue and other.hasValue and (number!=other.number or text!=other.text)){return(false)}
        explicitSize <- explicitSize or other.explicitSize
        if(other.overlay>=0){overlay <- other.overlay}
        if(other.hasSize){hasSize <- true; size <- other.size}
        if(other.hasValue){hasValue <- true; number <- other.number; text <- other.text}
        valid <- true
        return(true)
    }
    me bool: accepts(me GraphTypeFacts: actual) <- {
        return(actual.valid and (overlay<0 or overlay==actual.overlay) and
               (!hasSize or (actual.hasSize and actual.size==size)) and
               (!hasValue or (actual.hasValue and actual.number==number and actual.text==text)))
    }
}

// Bits in a demand: 1=size, 2=value including its overlay type. A value is
// known only when its interpretation is known. Relationship demands are interpreted by
// the graph interface, never by the generic traverser.
struct ProteusGraphAccess {
    our IdentityRegistry: registry
    their ProteusCore: replyCore

    void: prepareInput(our infonView: inf) <- {
        inf!.streamState <- parseStarted; inf!.graphParseError <- ""
    }
    me bool: inputPending(our POV: pov) <- {
        return(pov!.pItem!.streamState==parseStarted or pov!.pItem!.streamState==parseListReady)
    }
    me bool: growingList(our POV: pov) <- {
        return(pov!.pItem!.streamState==parseListReady and pov!.pItem!.value!.overlayType==LST and
               pov!.pItem!.value!.evalMode==emLiteral and pov!.pItem!.value!.listSpec==NULL)
    }
    me string: inputError(our POV: pov) <- {return(pov!.pItem!.graphParseError)}
    me bool: replyReady(our POV: pov) <- {
        return(replyCore!=NULL and !inputPending(pov) and pov!.pItem!.graphParseError=="" and pov!.pItem!.doReply)
    }
    me uint64: replyOrigin(our POV: pov) <- {return(pov!.pItem!.originID)}
    me uint64: replyPosition(our POV: pov) <- {return(pov!.pItem!.infCharPos)}
    me uint64: replyOrder(our POV: pov) <- {return(pov!.pItem!.replyCharPos)}
    void: claimReply(our POV: pov) <- {pov!.pItem!.doReply <- false}
    me string: replyText(our POV: pov) <- {return(toString(pov!.pItem))}

    void: initialize() <- {Allocate(registry)}
    void: bind(our POV: pov) <- <%{
        if (!pov || !pov->pItem) throw std::invalid_argument("POV with infonView required");
        auto existing = pov->effectiveIdentityRegistry();
        if (existing && existing != registry.get())
            throw std::logic_error("POV belongs to another registry; use initWithRegistry");
        pov->bindIdentityRegistry(registry.get());
    }%>
    void: recordIdentity(our POV: left, our POV: right) <- {
        bind(left); bind(right)
        registry!.recordIdentity(left, right, iekAssertion, 0)
    }
    me bool: unknownOverlay(our POV: pov) <- {
        return(pov!=NULL and pov!.pItem!=NULL and
               (pov!.pItem!.value!.overlayType==tUnknown or pov!.pItem!.value!.overlayType==tUnset) and
               pov!.pItem!.value!.evalMode==emUnknown)
    }
    me bool: plain(our POV: pov, me bool: selection <- false, me bool: readingPrefix <- false) <- {
        if(pov==NULL or pov!.pItem==NULL or (inputPending(pov) and !readingPrefix)){return(false)}
        our infonView: inf <- pov!.pItem
        return((inf!.viewMode==vmOverlay or (inf!.viewMode==vmAny and unknownOverlay(pov))) and !inf!.invertMatch and
               !inf!.isTentative and
               ((inf!.type==NULL and inf!.addedTypes.isEmpty()) or definitionTypeShape(pov)) and
               (inf!.innr==NULL or selection) and inf!.proxy==NULL and inf!.partRef==NULL and
               inf!.parts.isEmpty() and inf!.funcArgs==NULL and
               (inf!.itmMode==mNone or inf!.itmMode==mItem) and
               ((inf!.infSize!.overlayType==NUM and
                 (inf!.infSize!.evalMode==emUnknown or inf!.infSize!.evalMode==emLiteral)) or
                (inf!.infSize!.overlayType==LST and inf!.infSize!.evalMode==emConcat)) and
               !inf!.hasInnrOutr and !inf!.asRHSInternalIdent and
               !inf!.value!.inverted and !inf!.value!.undefined and
               !inf!.infSize!.inverted and !inf!.infSize!.undefined and
               !pov!.looseType() and pov!.accessMode==aCopyOf and
               !pov!.selectorLocalWork and !pov!.viewMapWriteEnabled and
               pov!.viewMap.sourcePov==NULL and pov!.referenceAlias.sourcePov==NULL)
    }
    // This permits reading scalar fields, not skipping their named-type
    // obligations. Graph access always exposes a required type goal as well.
    me bool: scalarTypeShape(our POV: pov) <- {
        return((pov!.pItem!.value!.overlayType==NUM or pov!.pItem!.value!.overlayType==STR or unknownOverlay(pov)) and
               (pov!.pItem!.value!.evalMode==emUnknown or pov!.pItem!.value!.evalMode==emLiteral))
    }
    me bool: definitionTypeShape(our POV: pov) <- {
        return(scalarTypeShape(pov) or (pov!.pItem!.value!.overlayType==LST and
               (pov!.pItem!.value!.evalMode==emLiteral or pov!.pItem!.value!.evalMode==emUnknown)))
    }
    // Only loaded, closed ordered bodies are finite definition requirements.
    // Unknown scalar fields are allowed; open/template/contextual shapes wait.
    me bool: finiteDefinitionList(our POV: pov) <- {
        return(closedPhysicalList(pov) and definitionOrderedCandidate(pov) and
               pov!.pItem!.value!.sizeMode!=fromContext)
    }
    me bool: definitionOrderedCandidate(our POV: pov) <- {
        return(pov!.pItem!.orderMode==uUnknown or pov!.pItem!.orderMode==uOrdered)
    }
    me bool: definitionOrderKnown(our POV: pov) <- {return(pov!.pItem!.orderMode==uOrdered)}
    me bool: setDefinitionOrder(our POV: pov) <- {
        if(pov!.pItem!.orderMode!=uUnknown){return(false)}
        pov!.pItem!.orderMode <- uOrdered; pov!.workRevision <+- 1
        return(true)
    }
    me List<our POV>: definitionMembers(our POV: pov) <- {
        me List<our POV>: result
        if(finiteDefinitionList(pov)){
            our POV: member <- first(pov)
            while(member!=NULL){result.append(member); member <- next(member)}
        }
        return(result)
    }
    me bool: definitionEmbedded(our POV: pov) <- {return(pov!.isSubItm)}
    me bool: adoptDefinitionList(our POV: pov) <- {
        if(!adoptableList(pov)){return(false)}
        pov!.pItem!.viewMode <- vmOverlay
        pov!.pItem!.value!.overlayType <- LST
        pov!.pItem!.value!.evalMode <- emLiteral
        pov!.pItem!.value!.tailUnfinished <- true
        pov!.pItem!.isNormed <- false; pov!.workRevision <+- 1
        return(true)
    }
    our POV: appendDefinitionMember(our POV: owner, me string: typeName) <- {
        // Instance-owned storage. No identity or work edge points back into a
        // shared definition, so local values cannot specialize that definition.
        our infonView:: item
        item!.viewMode <- vmOverlay; item!.itmMode <- mItem
        item!.infSize!.evalMode <- emUnknown
        item!.value!.overlayType <- tUnknown; item!.value!.evalMode <- emUnknown
        if(typeName!=""){
            Allocate(item!.type); item!.type!.setAsGiven(typeName)
        }
        our POV: member <- owner!.pItem!.value!.items.append(item, false, 913)
        member!.pParent <- owner; bind(member)
        owner!.pItem!.isNormed <- false; owner!.workRevision <+- 1
        return(member)
    }
    me bool: hasTypeRequirements(our POV: pov) <- {
        return(pov!.pItem!.type!=NULL or !pov!.pItem!.addedTypes.isEmpty())
    }
    me List<string>: typeNames(our POV: pov) <- {
        me List<string>: names
        if(pov!.pItem!.type!=NULL){names.append(pov!.pItem!.type!.typeID())}
        withEach extra in pov!.pItem!.addedTypes{names.append(extra!.typeID())}
        return(names)
    }
    me bool: isDefinition(our POV: pov) <- {return(pov!.pItem!.itmMode==mWordDefn)}
    me bool: definitionReady(our POV: pov) <- {
        return(isDefinition(pov) and !inputPending(pov) and pov!.pItem!.graphParseError=="" and
               pov!.pItem!.definedWord!=NULL and pov!.pItem!.definedWord!.UsageTags.isEmpty() and
               pov!.pItem!.funcArgs!=NULL)
    }
    me string: definitionName(our POV: pov) <- {
        return(unicodeMgr.normalizeStr(pov!.pItem!.definedWord!.defWord))
    }
    our POV: definitionBody(our POV: declaration) <- {
        our POV:: body{910}
        body!.pItem <- declaration!.pItem!.funcArgs
        body!.pParent <- declaration
        bind(body)
        return(body)
    }
    me GraphTypeFacts: typeFacts(our POV: pov) <- {
        me GraphTypeFacts: facts
        if(!plain(pov) or !definitionTypeShape(pov) or
                pov!.pItem!.value!.sizeMode==fromContext or
                pov!.pItem!.infSize!.overlayType!=NUM){return(facts)}
        facts.valid <- true
        facts.explicitSize <- pov!.pItem!.value!.sizeMode==fromGiven
        if(!unknownOverlay(pov)){facts.overlay <- pov!.pItem!.value!.overlayType}
        facts.hasSize <- pov!.pItem!.infSize!.evalMode==emLiteral
        if(facts.hasSize){facts.size <- pov!.pItem!.infSize!.num}
        facts.hasValue <- facts.overlay!=LST and pov!.pItem!.value!.evalMode==emLiteral
        if(facts.hasValue){
            if(facts.overlay==NUM){facts.number <- pov!.pItem!.value!.num}
            else{facts.text <- pov!.pItem!.value!.str}
        }
        return(facts)
    }
    me bool: applyTypeFacts(our POV: target, me GraphTypeFacts: required) <- {
        me GraphTypeFacts: actual <- typeFacts(target)
        if(!actual.valid){return(false)}
        me GraphTypeFacts: combined <- actual
        if(!combined.combine(required)){return(false)}
        me bool: changed <- false
        if(actual.overlay<0 and required.overlay>=0){
            target!.pItem!.value!.overlayType <- required.overlay
            target!.pItem!.viewMode <- vmOverlay
            changed <- true
        }
        if(!actual.hasSize and required.hasSize){
            target!.pItem!.infSize!.evalMode <- emLiteral
            target!.pItem!.infSize!.num <- required.size
            changed <- true
        }
        if(!actual.hasValue and required.hasValue){
            target!.pItem!.value!.evalMode <- emLiteral
            if(required.overlay==NUM){target!.pItem!.value!.num <- required.number}
            else{target!.pItem!.value!.str <- required.text}
            changed <- true
        }
        // Preserve a learned explicit size in normal output. Otherwise, e.g.
        // *16+10 would print as 10 and reparse with a different numeric size.
        if(changed and required.explicitSize){target!.pItem!.value!.sizeMode <- fromGiven}
        if(changed){target!.workRevision <+- 1; target!.pItem!.isNormed <- false}
        return(changed)
    }
    me bool: scalar(our POV: pov) <- {
        if(!plain(pov)){return(false)}
        return((pov!.pItem!.value!.overlayType==NUM or
                pov!.pItem!.value!.overlayType==STR) and
               (pov!.pItem!.value!.evalMode==emLiteral or
                pov!.pItem!.value!.evalMode==emUnknown))
    }
    // An unknown overlay can acquire scalar evidence without pretending its
    // payload is already numeric or textual. Other interpretations stay deferred.
    me bool: scalarCandidate(our POV: pov) <- {
        return(plain(pov) and (scalar(pov) or unknownOverlay(pov)))
    }
    me bool: literalList(our POV: pov) <- {
        return(plain(pov) and pov!.pItem!.value!.overlayType==LST and
               pov!.pItem!.value!.evalMode==emLiteral)
    }
    // Physical contents are safe to walk without expanding templates. More
    // list representations will advertise their own edges in later slices.
    me bool: physicalList(our POV: pov) <- {
        return(literalList(pov) and pov!.pItem!.value!.listSpec==NULL and
               !pov!.pItem!.value!.timelike and
               (pov!.pItem!.streamState==parseDone or pov!.pItem!.streamState==notParsing))
    }
    // Read-only evidence from a parser-owned list. Its unfinished member and
    // eventual extent are deliberately absent from the correspondence layout.
    me bool: prefixList(our POV: pov) <- {
        return(growingList(pov) and plain(pov, false, true) and
               !pov!.pItem!.value!.timelike and orderedList(pov))
    }
    me bool: spanList(our POV: pov) <- {return(physicalList(pov) or prefixList(pov))}
    our POV: spanFirst(our POV: owner) <- {
        our POV: member <- first(owner)
        if(member!=NULL and inputPending(member)){return(NULL)}
        return(member)
    }
    our POV: spanNext(our POV: member) <- {
        our POV: result <- next(member)
        if(result!=NULL and inputPending(result)){return(NULL)}
        return(result)
    }
    me bool: unknownList(our POV: pov) <- {
        return(plain(pov) and pov!.pItem!.value!.overlayType==LST and
               pov!.pItem!.value!.evalMode==emUnknown)
    }
    me bool: adoptableList(our POV: pov) <- {
        return((scalarCandidate(pov) and unknownOverlay(pov)) or unknownList(pov))
    }
    me bool: closedPhysicalList(our POV: pov) <- {
        return(physicalList(pov) and !pov!.pItem!.value!.tailUnfinished)
    }
    me bool: listExtentAgrees(our POV: pov, me GraphListMeasure: measure) <- {
        return(measure.known and closedPhysicalList(pov) and
               pov!.pItem!.infSize!.evalMode==emLiteral and
               pov!.pItem!.infSize!.num==measure.count)
    }
    me bool: applyCountedSize(our POV: pov, me GraphListMeasure: measure) <- {
        if(!measure.known or !closedPhysicalList(pov) or
                pov!.pItem!.value!.sizeMode==fromGiven or
                pov!.pItem!.infSize!.evalMode!=emUnknown){return(false)}
        // This is count evidence, not a request to close a tail or resolve a
        // contextual reference. Preserve the representation's size mode.
        pov!.pItem!.infSize!.evalMode <- emLiteral
        pov!.pItem!.infSize!.num <- measure.count
        pov!.pItem!.isNormed <- false
        pov!.workRevision <+- 1
        return(true)
    }
    me int: known(our POV: pov) <- {
        if(pov==NULL or pov!.pItem==NULL or inputPending(pov)){return(0)}
        if(pov!.pItem!.value!.evalMode==emIntersection){return(0)}
        me int: mask <- 0
        if(pov!.pItem!.infSize!.overlayType==NUM and
                pov!.pItem!.infSize!.evalMode==emLiteral){mask <- 1}
        if((scalar(pov) or physicalList(pov)) and
                pov!.pItem!.value!.evalMode==emLiteral){mask <+- 2}
        return(mask)
    }
    // The GoalSpec calls this only at validated completion or invalidation.
    // The list goal has also checked extent and all required member goals.
    void: setNormed(our POV: pov, me bool: complete) <- {
        if(pov!=NULL and pov!.pItem!=NULL){
            pov!.pItem!.isNormed <- complete and (definitionReady(pov) or
                    ((scalar(pov) or closedPhysicalList(pov)) and known(pov)==3))
        }
    }
    // Unsupported semantics stay symbolic. This deliberately does not infer
    // equality from arbitrary cursor, range, negation or selection work.
    me bool: supports(our POV: pov, me int: demand) <- {
        if(canSelect(pov)){return(true)}
        if(!plain(pov)){return(false)}
        if(scalarCandidate(pov) or unknownList(pov) or hasConcat(pov, 2)){return(true)}
        return(physicalList(pov) or (demand==1 and literalList(pov)))
    }
    me bool: relationSupported(our POV: lhs, our POV: rhs, me int: demand) <- {
        if((adoptableList(lhs) and spanList(rhs) and orderedList(rhs)) or
           (adoptableList(rhs) and spanList(lhs) and orderedList(lhs))){return(true)}
        if(spanList(lhs) and (demand!=1 or inputPending(lhs) or inputPending(rhs))){return(correspondingLists(lhs, rhs))}
        if(scalarCandidate(lhs) and scalarCandidate(rhs)){
            return(unknownOverlay(lhs) or unknownOverlay(rhs) or
                   lhs!.pItem!.value!.overlayType==rhs!.pItem!.value!.overlayType)
        }
        return(supports(lhs, demand) and supports(rhs, demand) and
               lhs!.pItem!.value!.overlayType==rhs!.pItem!.value!.overlayType)
    }
    me bool: correspondingLists(our POV: left, our POV: right) <- {
        return(spanList(left) and spanList(right) and
               orderedList(left) and orderedList(right))
    }
    me bool: correspondingMembers(our POV: left, our POV: right) <- {
        return(left!=NULL and right!=NULL and left!.pItem!=NULL and right!.pItem!=NULL and
               !left!.isSubItm and !right!.isSubItm and
               left!.pItem!.itmMode==mItem and right!.pItem!.itmMode==mItem)
    }
    me bool: openTail(our POV: pov) <- {return(inputPending(pov) or pov!.pItem!.value!.tailUnfinished)}
    me bool: sameInfon(our POV: left, our POV: right) <- {return(left!.pItem===right!.pItem)}
    // -1 means unknown; -2 means an unsupported extent. Do not narrow an
    // arbitrary FlexNum to an index before checking the range and integrality.
    me int64: listExtent(our POV: pov) <- {
        if(inputPending(pov)){return(-1)}
        if(pov!.pItem!.infSize!.evalMode==emUnknown){return(-1)}
        if(pov!.pItem!.infSize!.evalMode!=emLiteral){return(-2)}
        if(pov!.pItem!.infSize!.num<0 or pov!.pItem!.infSize!.num.getDenominator()!=1 or
                pov!.pItem!.infSize!.num>9223372036854775807){return(-2)}
        return(pov!.pItem!.infSize!.num.getNumerator().convertToIntVal())
    }
    me bool: canMakeMember(our POV: source) <- {
        return(scalarCandidate(source) or (physicalList(source) and orderedList(source)))
    }
    our POV: appendTailMember(our POV: owner, our POV: source) <- {
        // New physical position, independent view, and a persistent identity
        // to the source. Never shallow-copy the source list's member links.
        our infonView:: item
        item!.viewMode <- vmOverlay
        item!.itmMode <- mItem
        item!.infSize!.overlayType <- NUM
        item!.infSize!.evalMode <- emUnknown
        item!.value!.overlayType <- source!.pItem!.value!.overlayType
        item!.value!.evalMode <- emUnknown
        item!.value!.sizeMode <- fromCount
        if(item!.value!.overlayType==LST){
            item!.value!.evalMode <- emLiteral
            item!.value!.tailUnfinished <- true
        }
        our POV: member <- owner!.pItem!.value!.items.append(item, false, 904)
        member!.pParent <- owner
        bind(member)
        registry!.recordIdentity(member, source, iekListCorrespondence, 0)
        owner!.workRevision <+- 1
        return(member)
    }
    me bool: finishTail(our POV: owner, me bool: close, me int64: extent) <- {
        me bool: changed <- false
        if(close and owner!.pItem!.value!.tailUnfinished){
            owner!.pItem!.value!.tailUnfinished <- false
            changed <- true
        }
        if(extent>=0 and owner!.pItem!.infSize!.evalMode==emUnknown){
            owner!.pItem!.infSize!.num <- extent
            owner!.pItem!.infSize!.evalMode <- emLiteral
            changed <- true
        }
        if(changed){owner!.workRevision <+- 1}
        return(changed)
    }
    me bool: hasDirectIdentity(our POV: left, our POV: right) <- {
        if(left===right){return(true)}
        protect(registry!.registryMutex){
            withEach identity in registry!.identities{
                if((identity!.leftPOV===left and identity!.rightPOV===right) or
                   (identity!.leftPOV===right and identity!.rightPOV===left)){return(true)}
            }
        }
        return(false)
    }
    me List<our POV>: workSources(our POV: pov) <- {
        me List<our POV>: result
        if(pov!=NULL and pov!.pItem!=NULL){
            withEach rhs in pov!.pItem!.wrkList{result.append(rhs)}
        }
        return(result)
    }
    me List<our POV>: identitySources(our POV: pov) <- {
        me List<our POV>: result
        protect(registry!.registryMutex){
            withEach identity in registry!.identities{
                if(identity!.leftPOV===pov){result.append(identity!.rightPOV)}
                else if(identity!.rightPOV===pov){result.append(identity!.leftPOV)}
            }
        }
        return(result)
    }
    // -1: conflicting literal scalar values; 0: unsupported;
    // 1: compatible in this foundation's supported subset.
    me int: compatible(our POV: target, our POV: source, me int: demand) <- {
        if(!relationSupported(target, source, demand)){return(0)}
        if(!inputPending(target) and !inputPending(source) and target!.pItem!.infSize!.evalMode==emLiteral and
                source!.pItem!.infSize!.evalMode==emLiteral and
                target!.pItem!.infSize!.num!=source!.pItem!.infSize!.num){return(0)}
        // supports() excludes references, polarity, and unsupported expressions.
        // Named scalar types have independent required validation goals.
        // Unknown fields impose no literal equality test in this subset.
        if(scalar(target) and target!.pItem!.value!.evalMode==emLiteral and
                source!.pItem!.value!.evalMode==emLiteral){
            if(target!.pItem!.value!.overlayType==NUM and
                    target!.pItem!.value!.num!=source!.pItem!.value!.num){return(-1)}
            if(target!.pItem!.value!.overlayType==STR and
                    target!.pItem!.value!.str!=source!.pItem!.value!.str){return(-1)}
        }
        return(1)
    }
    me bool: apply(our POV: target, our POV: source, me int: demand) <- {
        // The goal validated the whole path before this batch. Recheck at the
        // mutation boundary; nothing can interleave under the context lock.
        if(inputPending(target) or compatible(target, source, demand)!=1){return(false)}
        me bool: copySize <- !inputPending(source) and (demand==1 or demand==3) and
                target!.pItem!.infSize!.evalMode==emUnknown and
                source!.pItem!.infSize!.evalMode==emLiteral
        me bool: copyList <- (demand==2 or demand==3) and adoptableList(target) and
                spanList(source) and orderedList(source)
        me bool: copyType <- (demand==2 or demand==3) and
                unknownOverlay(target) and scalar(source)
        me bool: copyValue <- (demand==2 or demand==3) and
                scalarCandidate(target) and target!.pItem!.value!.evalMode==emUnknown and
                scalar(source) and source!.pItem!.value!.evalMode==emLiteral
        // A Set uses the state primitive directly and retains work constraints.
        if(copySize){target!.pItem!.infSize!.copyOverlayFrom(source!.pItem!.infSize, 0)}
        // Establish interpretation before the matching-overlay copy primitive.
        // Type-only evidence must not fabricate a value or replace metadata.
        // Adopt only the list interpretation. Correspondence fills independent
        // member views on subsequent graph passes, preserving compressed tails.
        if(copyList){
            // The admitted source is ordered, including an untyped literal
            // whose order flag was implicit. Carry that established order.
            target!.pItem!.orderMode <- uOrdered
            target!.pItem!.value!.overlayType <- LST
            target!.pItem!.value!.evalMode <- emLiteral
            target!.pItem!.value!.tailUnfinished <- true
            target!.pItem!.viewMode <- vmOverlay
        }
        if(copyType){
            target!.pItem!.value!.overlayType <- source!.pItem!.value!.overlayType
            target!.pItem!.viewMode <- vmOverlay
        }
        if(copyValue){target!.pItem!.value!.copyOverlayFrom(source!.pItem!.value, 0)}
        if(copySize or copyType or copyValue or copyList){
            target!.pItem!.isNormed <- false
            target!.workRevision <+- 1
            return(true)
        }
        return(false)
    }
    our infonView: selectionSource(our POV: pov) <- {
        if(pov==NULL or pov!.pItem==NULL){return(NULL)}
        if(pov!.pItem!.selectionExpression!=NULL){return(pov!.pItem!.selectionExpression)}
        if(pov!.pItem!.value!.evalMode==emIntersection){return(pov!.pItem!.innr)}
        return(NULL)
    }
    me int: selectionMode(our POV: pov) <- {
        if(pov!.pItem!.selectionExpression!=NULL){return(pov!.pItem!.selectionKind)}
        return(pov!.pItem!.intersectPos)
    }
    me bool: canSelect(our POV: pov) <- {
        our infonView: source <- selectionSource(pov)
        if(source==NULL or !plain(pov, true) or pov!.pItem!.positionalSelection or
                pov!.pItem!.selectionRequestID!=0 or pov!.pItem!.isOrLike()){return(false)}
        me int: resultMode <- selectionMode(pov)
        return((resultMode==ipGetFirst or resultMode==ipGetLast or resultMode==ipGetMarked) and
               source!.viewMode==vmOverlay and source!.type==NULL and source!.addedTypes.isEmpty() and
               source!.funcArgs==NULL and source!.parts.isEmpty() and source!.wrkList.isEmpty() and
               source!.value!.overlayType==LST and source!.value!.evalMode==emLiteral and
               source!.value!.listSpec==NULL and !source!.value!.timelike and
               !source!.value!.inverted and !source!.value!.undefined and !source!.invertMatch and
               (source!.orderMode==uUnknown or source!.orderMode==uOrdered))
    }
    our POV: selectionShapeFirst(our POV: owner) <- {return(selectionSource(owner)!.value!.items.head)}
    me bool: selectionExtentAgrees(our POV: owner, me GraphListMeasure: measure) <- {
        our infonView: source <- selectionSource(owner)
        me bool: given <- source!.infSize!.overlayType==NUM and source!.infSize!.evalMode==emLiteral
        if(given){
            if(source!.infSize!.num<measure.count){return(false)}
            if(!source!.value!.tailUnfinished and measure.known and source!.infSize!.num!=measure.count){return(false)}
        }
        // An explicit extent can prove a zero-width open tail. Otherwise the
        // last position remains unknown until a future publication closes it.
        if(selectionIsLast(owner) and source!.value!.tailUnfinished){
            return(given and measure.known and source!.infSize!.num==measure.count)
        }
        return(true)
    }
    me bool: selectionIsMarked(our POV: owner) <- {return(selectionMode(owner)==ipGetMarked)}
    me bool: selectionIsLast(our POV: owner) <- {return(selectionMode(owner)==ipGetLast)}
    our POV: selectionStart(our POV: owner) <- {
        our infonView: source <- selectionSource(owner)
        if(selectionIsMarked(owner)){return(source!.intersectMarkedRetPOV)}
        if(selectionIsLast(owner)){
            return(source!.value!.items.tail)
        }
        return(source!.value!.items.head)
    }
    our POV: selectionNeighbour(our POV: member, me bool: last) <- {
        if(last){return(member!.prev)}
        return(member!.next)
    }
    our POV: selectionChild(our POV: member, me bool: last) <- {
        if(last){return(member!.pItem!.value!.items.tail)}
        return(member!.pItem!.value!.items.head)
    }
    me bool: selectionSpan(our POV: member, me bool: last) <- {
        return(physicalList(member) and orderedList(member) and (!last or !openTail(member)))
    }
    me bool: selectionCycle(our POV: owner, our POV: member) <- {
        return(member!.pItem===owner!.pItem or member!.pItem===selectionSource(owner))
    }
    me bool: selectionAgrees(our POV: owner, our POV: selected) <- {
        return(canSelect(owner) and selected!=NULL and
               (owner!.pItem!.selectedResult==NULL or owner!.pItem!.selectedResult===selected))
    }
    me bool: applySelection(our POV: owner, our POV: selected) <- {
        if(!selectionAgrees(owner, selected) or owner!.pItem!.selectedResult!=NULL){return(false)}
        bind(owner); bind(selected)
        owner!.pItem!.selectionKind <- selectionMode(owner)
        owner!.pItem!.selectionExpression <- owner!.pItem!.innr
        owner!.pItem!.innr <- NULL
        owner!.pItem!.intersectPos <- ipNoIntersect
        owner!.pItem!.selectedResult <- selected
        // Keep any actual outer size constraint. The parser initializes this
        // slot as unknown when it moves the expression's extent into innr.
        our infonState:: value
        value!.overlayType <- tUnknown; value!.evalMode <- emUnknown
        owner!.pItem!.value <- value
        if(!hasDirectIdentity(owner, selected)){
            registry!.recordIdentity(owner, selected, iekListCorrespondence, 0)
        }
        owner!.workRevision <+- 1; owner!.pItem!.isNormed <- false
        return(true)
    }
    our infonState: concatSource(our POV: pov, me int: slot) <- {
        if(pov==NULL or pov!.pItem==NULL){return(NULL)}
        our infonState: source <- pov!.pItem!.valueExpression
        our infonState: current <- pov!.pItem!.value
        if(slot==1){source <- pov!.pItem!.sizeExpression; current <- pov!.pItem!.infSize}
        if(source!=NULL){return(source)}
        if(current!.evalMode==emConcat){return(current)}
        return(NULL)
    }
    me bool: hasConcat(our POV: pov, me int: slot) <- {
        our infonState: source <- concatSource(pov, slot)
        return(source!=NULL and plain(pov) and source!.overlayType==LST and
               source!.evalMode==emConcat and !source!.inverted and !source!.undefined and
               !source!.tailUnfinished and source!.listSpec==NULL and !source!.timelike)
    }
    our POV: concatFirst(our POV: pov, me int: slot) <- {
        return(concatSource(pov, slot)!.items.head)
    }
    me bool: concatNeedsRadix(our POV: member) <- {
        return(scalar(member) and member!.pItem!.value!.overlayType==NUM and
               member!.prev!=NULL and member!.pItem!.value!.sizeMode!=fromContext)
    }
    me GraphConcatPlan: planConcat(our POV: owner, me int: slot, me GraphConcatTerms: terms) <- {
        me GraphConcatPlan: plan
        if(!hasConcat(owner, slot) or terms.items.isEmpty()){return(plan)}
        me bool: first <- true
        withEach term in terms.items{
            if(term!.isSubItm or !(scalar(term) or (physicalList(term) and orderedList(term))) or
                    term!.pItem!.value!.evalMode!=emLiteral){return(plan)}
            our infonView: item <- term!.pItem
            if(first){
                plan.type <- item!.value!.overlayType
                plan.number <- item!.value!.num
                plan.sizeKnown <- item!.infSize!.overlayType==NUM and item!.infSize!.evalMode==emLiteral
                plan.size <- item!.infSize!.num
                if(plan.type==LST){plan.size <- 0; plan.sizeKnown <- true}
            }else if(plan.type!=item!.value!.overlayType){return(plan)}
            if(plan.type==NUM and !first){
                if(item!.value!.sizeMode==fromContext){plan.number <+- item!.value!.num}
                else{
                    if(item!.infSize!.evalMode!=emLiteral or item!.infSize!.overlayType!=NUM or
                            item!.infSize!.num<0){return(plan)}
                    plan.number <- plan.number*item!.infSize!.num + item!.value!.num
                    plan.size <- plan.size*item!.infSize!.num
                }
            }else if(plan.type==STR){
                plan.text.append(item!.value!.str)
                plan.size <- plan.text.size(); plan.sizeKnown <- true
            }else if(plan.type==LST){
                if(plan.open){return(plan)}
                our POV: member <- item!.value!.items.head
                while(member!=NULL){
                    if(!canMakeMember(member)){return(plan)}
                    plan.members.append(member); plan.visits <+- 1
                    member <- member!.next
                }
                plan.open <- item!.value!.tailUnfinished
                if(item!.infSize!.evalMode==emLiteral){plan.size <+- item!.infSize!.num}
                else{plan.sizeKnown <- false}
            }
            first <- false
        }
        if(slot==1){
            if(plan.type!=NUM or plan.number<0 or plan.number.getDenominator()!=1){return(plan)}
            if(owner!.pItem!.sizeExpression!=NULL and owner!.pItem!.infSize!.num!=plan.number){return(plan)}
        }else{
            if(plan.sizeKnown and owner!.pItem!.infSize!.evalMode==emLiteral and
                    owner!.pItem!.infSize!.num!=plan.size){return(plan)}
            if(owner!.pItem!.valueExpression!=NULL){
                if(owner!.pItem!.value!.overlayType!=plan.type){return(plan)}
                if(plan.type==NUM and owner!.pItem!.value!.num!=plan.number){return(plan)}
                if(plan.type==STR and owner!.pItem!.value!.str!=plan.text){return(plan)}
                if(plan.type==LST and (!owner!.pItem!.value!.tailUnfinished and
                        (plan.open or owner!.pItem!.value!.items.size()!=plan.members.size()))){return(plan)}
            }
            if(plan.type==LST){
                me int64: existing <- 0
                if(owner!.pItem!.valueExpression!=NULL){existing <- owner!.pItem!.value!.items.size()}
                if(existing>plan.members.size()){return(plan)}
                plan.creations <- 2*(plan.members.size()-existing)
            }
        }
        plan.valid <- true
        return(plan)
    }
    me bool: applyConcat(our POV: owner, me int: slot, me GraphConcatTerms: terms) <- {
        me GraphConcatPlan: plan <- planConcat(owner, slot, terms)
        if(!plan.valid){return(false)}
        withEach member in plan.members{bind(member)}
        me bool: changed <- false
        if(slot==1){
            if(owner!.pItem!.sizeExpression!=NULL){return(false)}
            owner!.pItem!.sizeExpression <- owner!.pItem!.infSize
            our infonState:: result
            result!.overlayType <- NUM; result!.evalMode <- emLiteral; result!.num <- plan.number
            owner!.pItem!.infSize <- result
            changed <- true
        }else{
            if(owner!.pItem!.valueExpression==NULL){
                owner!.pItem!.valueExpression <- owner!.pItem!.value
                our infonState:: result
                result!.overlayType <- plan.type; result!.evalMode <- emLiteral
                result!.sizeMode <- owner!.pItem!.value!.sizeMode
                if(plan.type==NUM and plan.sizeKnown){result!.sizeMode <- fromGiven}
                result!.num <- plan.number; result!.str <- plan.text
                result!.tailUnfinished <- plan.type==LST
                owner!.pItem!.value <- result
                changed <- true
            }
            if(plan.type==LST){
                me int64: existing <- owner!.pItem!.value!.items.size()
                withEach itemIndex in range existing .. plan.members.size(){
                    our POV: source <- plan.members[itemIndex]
                    our POV: member <- appendTailMember(owner, source)
                    member!.isSubItm <- source!.isSubItm
                    changed <- true
                }
                if(!plan.open and owner!.pItem!.value!.tailUnfinished){
                    owner!.pItem!.value!.tailUnfinished <- false; changed <- true
                }
            }
            if(plan.sizeKnown and owner!.pItem!.infSize!.evalMode==emUnknown){
                owner!.pItem!.infSize!.overlayType <- NUM; owner!.pItem!.infSize!.evalMode <- emLiteral
                owner!.pItem!.infSize!.num <- plan.size; changed <- true
            }
        }
        if(changed){owner!.workRevision <+- 1; owner!.pItem!.isNormed <- false}
        return(changed)
    }
    me bool: sparse(our POV: pov) <- {return(pov!.hasSparseOrderedSpanValue())}
    me int64: extent(our POV: pov) <- {return(pov!.sparseSpanCount())}
    our POV: existingSparseItem(our POV: pov, me int64: index) <- {
        return(pov!.findImplicitItemPOV(index))
    }
    our POV: sparseItem(our POV: pov, me int64: index) <- {
        bind(pov)
        return(pov!.getOrCreateImplicitItemPOV(index))
    }
    // Parsed untyped ordered literals normally retain uUnknown. Explicit
    // unordered lists and unresolved type-dependent order stay unsupported.
    me bool: orderedList(our POV: pov) <- {
        return(pov!=NULL and pov!.pItem!=NULL and
               pov!.pItem!.value!.overlayType==LST and
               pov!.pItem!.value!.evalMode==emLiteral and
               (pov!.pItem!.orderMode==uOrdered or
                (pov!.pItem!.orderMode==uUnknown and pov!.pItem!.type==NULL)))
    }
    our POV: first(our POV: pov) <- {return(pov!.pItem!.value!.items.head)}
    our POV: next(our POV: pov) <- {return(pov!.next)}
    me bool: subList(our POV: pov) <- {return(pov!.isSubItm)}
}
