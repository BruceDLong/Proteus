//////////////////  Structures For Working with Proteus
// Proteus.dog

LocalBuild: Platform='Local'  testMode='makeTests';
//LinuxTestBuild: Platform='Linux' Lang='CPP' LangVersion='GNU' testMode='makeTests';
//WindowsTestBuild: Platform='Windows' Lang='CPP' LangVersion='MSVC' testMode='makeTests';
//JavaTestBuild:  Platform='Swing' Lang='Java' testMode='makeTests';
//LinuxBuild:     Platform='Linux' LangVersion='GNU' Lang='CPP';

FileName = "Proteus"
Version = "0.8"
CopyrightMesg = "Copyright (c) 2015-2023 Bruce Long"
Authors = "Bruce Long, KT Lawrence"
Description = "Proteus Engine"
ProgramOrLibrary = "program"
TestSpec = "ProteusTests.dog"

featuresNeeded = [Unicode, BigNumbers, Threads, IOBuffer, GraphLogger, Logger]

commentsToActivate = [l/PAI/, l/merge_]

LicenseText = `This file is part of the "Proteus Language suite" All Rights Reserved.`
infonDumpMode='text'

#include infonIO.dog
#include infonList.dog
#include Functions.dog
#include ModelManager.dog
#include WorldManager.dog
#include debugSystems.dog
#include xlators/xlator_en.dog
//include DB_workAround.dog

struct SizeMode: inherits=<mode[fromCount, fromContext, fromGiven]> {}
struct evalRangeMode: inherits=<mode[error, unknown, reject, pass]> {}
struct OrderMode: inherits=<mode[uUnknown, uOrdered, uUnordered]> {}

struct aitemSrcID: inherits=<mode[srcPMVA1, srcPMVA2, srcPiCVA, srcNrmSize, srcNormInit, srcMrg0, srcPropagate, srcPartsPath, srcItsALT, srcItsFunc, srcUnordd]> {}


model infonState{
    // -----------------------------------------------------------------
    // Semantic interpretation of this overlay
    // -----------------------------------------------------------------
    mode[tUnset, tUnknown, NUM, STR, LST]: overlayType
    mode[emUnknown, emConcat, emLiteral, emIntersection]: evalMode
    me SizeMode: sizeMode <- fromCount
    flag: inverted
    flag: undefined
    // -----------------------------------------------------------------
    // Overlay payload
    // Exactly which member is meaningful depends on overlayType.
    // These are candidates for a union once CodeDog union support is reliable.
    // -----------------------------------------------------------------
    me FlexNum: num
    me string: str
    me PovList: items
    // -----------------------------------------------------------------
    // List-specific semantics
    // -----------------------------------------------------------------
    our infonView: listSpec     // Applies to every member as a template
    flag: timelike              // Additional identities to 
    flag: tailUnfinished

    // -----------------------------------------------------------------
    // Preferred external representation
    // These do not change the internally represented state.
    // -----------------------------------------------------------------
    mode[fDefault, fFloat, fFraction, fSingleQuote, fHereDoc, fSizedBin]: literalFormat
    mode[bDec, bBin, bHex]: numBase
    flag: sizeWasInner  // True when the size was written inside a list as {~S ...}


    me none: infonState(me int: N) <- {
        overlayType <- NUM
        evalMode <- emLiteral
        num <- N
    }
    me none: infonState(me string: S, me bool: isStrInf) <- {
        overlayType <- STR
        evalMode <- emLiteral
        str <- S
    }
    our POV: deleteListNode(our POV: toDel) <- {
        return(items.erase(toDel))
    }
    me FlexNum: getValAsNum() <-{
        if(inverted){return(-num)}
        else{return(num)}
    }
    void: copyAsTypeTo(their infonState: to, our infonView: topThis, their List<their infonView>: copied) <- {
        to! <- self!
        to!.items.clear()
        to!.index.clear()
        to!.T_index.clear()
        our POV: pov <- items.head
        while(pov != NULL){
            our infonView: newInfon
            Allocate(newInfon)
            pov!.pItem!._copyAsTypeTo(newInfon, true, true, topThis, copied)
            our POV: newPOV <- to!.items.append(newInfon, pov!.isSubItm, 111)
            //newPOV!.pParent <-  //TODO
            //log("copyAsTypeTo newPOV:"+newPOV.mySymbol()+".pParent:"+newPOV!.pParent.mySymbol())
            if(pov!.pItem!.type!=NULL and pov!.pItem!.type!.normalType()!=""){
                to!.index.insert(pov!.pItem!.type!.normalType(), newInfon)
            }
            pov <- pov!.next
        }
    }

    void: clear() <- {num<-0 str<-""; items.clear(); listSpec<-NULL}
}
model infonView {
    // -----------------------------------------------------------------
    // What kind of view/item is this?
    // -----------------------------------------------------------------
    flag: invertMatch

    mode[mNone, mItem, mWordDefn, mIncludeStream, mIncludeParseStr]: itmMode

    mode[vmAny, vmCursor, vmOverlay]: viewMode

    // Meaningful when viewMode == vmCursor
    mode[cmNone, cmSelf, cmWorld, cmContext, cmUser, cmArgs, cmVars, cmPrev, cmNext]:  cursorMode

    // -----------------------------------------------------------------
    // State represented by this view
    // -----------------------------------------------------------------
    our infonState: infSize
    our infonState: value

    me OrderMode: orderMode

    // -----------------------------------------------------------------
    // Intersection semantics
    // -----------------------------------------------------------------
    mode[ipNoIntersect, ipGetLast, ipGetFirst, ipGetMarked]: intersectPos

    // The internal information structure being resolved.
    our infonView: innr

    // Meaningful when intersectPos == ipGetMarked.
    // Identifies the marked occurrence within innr.
    // Keep the POV rather than merely its pItem because the occurrence/context
    // matters, and resolution may write through it.
    our POV: intersectMarkedRetPOV

    // Current representation of <~.
    // Eventually replace this flag + funcArgs overload with:
    //     our infonView: innrOutr
    flag: hasInnrOutr

    // -----------------------------------------------------------------
    // Type / definition semantics
    // -----------------------------------------------------------------
    our WordUse: type
    me List<our WordUse>: addedTypes

    // Meaningful for itmMode == mWordDefn.
    our WordDefn: definedWord

    // -----------------------------------------------------------------
    // Transitional mixed fields
    // These currently contain essential information, so cannot yet
    // be moved out of the model even though their representation is poor.
    // -----------------------------------------------------------------

    // Currently overloaded as:
    //   * definition body
    //   * <~ innrOutr
    //   * legacy function argument
    //
    // Eventually split into definitionBody / innrOutr and delete
    // the legacy function use.
    our infonView: funcArgs

    // Currently mixes persistent identity knowledge with Reasoner work.
    // Eventually split into semantic identities + Reasoner agenda state.
    me List<our POV>: wrkList
}

struct infonView{
     // -----------------------------------------------------------------
    // Legacy intersection-as-function machinery
    // Remove when the old function syntax is removed.
    // -----------------------------------------------------------------
    mode[apNoArgs, apArgIsFirstItem, apArgIsLastItem]: argPos
    flag: argsOnLeft
    flag: cnvtToFunc

    // -----------------------------------------------------------------
    // Context / reference resolution
    // Needed by the language system, not by identity logic.
    // -----------------------------------------------------------------
    mode[gUnset, gAbstract, gConcrete]: generality
    our infonView: proxy

    // Current ad-hoc instantiation/scope mechanism for
    // %self, %prev, %next, definition/listSpec copies.
    our infonView: copySource
    mode[cstNone, cstDefinition, cstListSpec]: copySourceType
    our infonView: thisPtr

    // -----------------------------------------------------------------
    // Part-path theorem execution / syntactic sugar
    // -----------------------------------------------------------------
    me List<our PartPath>: parts
    our PartPath: partRef

    // -----------------------------------------------------------------
    // External input / stream directives
    // -----------------------------------------------------------------
    me string: includeSpec
    our infonView: includeInfn

    // -----------------------------------------------------------------
    // Source / stream metadata
    // -----------------------------------------------------------------
    me uint64: originID
    me uint64: infCharPos

    // Someone wants the result delivered back to a stream/request.
    // Eventually move with origin/routing information into a
    // request/subscription object.
    flag: doReply

    // -----------------------------------------------------------------
    // Old WorldManager / Reasoner state
    // -----------------------------------------------------------------
    mode[umAssert, umQuestion, umCommand]: useMode

    flag: isNormed

    // <~ has already been translated into old wrkList machinery.
    flag: asWrkLstOutr

    // Definition/COW processing provenance.
    flag: isFromDefn

    // Type-definition application caches.
    flag: isTypeExample
    flag: alreadyTypeChecked

    // Child-side marker used by current intersection processing.
    flag: isInnr

    // Old destructive work-list retry/history state.
    me List<our POV>: usedWrkList

    // Keep-alive references for temporary POVs.
    me List<our POV>: retainedPOVs

    // Speculative candidate existence during matching.
    flag: isTentative

    // Property of a generated identity relation, currently stored
    // incorrectly on its RHS infon.
    flag: asRHSInternalIdent

    // One-pass / completion caches.
    flag: altRulesApplied
    flag: defnRegistered
    flag: sizeNormed
    flag: wordDerefed
    flag: addedTypesAlreadyCopied
    flag: wasProcessed

    // Parser-specific behavior; investigate/delete with parser cleanup.
    flag: altUse

    our POV: fetchField(me string: fieldname) <- {
        if(value!.items.isEmpty()){return(NULL)}
        me int: count <- 0
        our POV: pov <- value!.items.head
        while(pov != NULL){
            our infonView: inf <- pov!.pItem
            if(inf!.invertMatch){
                pov <- pov!.next
                continue()
            }
            if(inf!.type!=NULL and inf!.type!.typeID()==fieldname){
                return(pov)
            } else { // Try sub-types
                withEach subType in inf!.addedTypes{
                    if(subType!.typeID()==fieldname){return(pov)}
                }
            }
            count <- count+1
            pov <- pov!.next
        }
        return(NULL)
    }
    me int: isCompatibleWith(our infonView: RHSInf, me bool: trueByDefinition) <- {
        our WordUse: typeRHS <- RHSInf!.type
        our WordUse: typeLHS <- type
        if(typeLHS==NULL){return(tvTrue)}
        else if(typeRHS==NULL){return(tvUnknown)}
        if(itmMode != mNone and RHSInf!.itmMode != mNone and itmMode != RHSInf!.itmMode){return(tvFalse)}
        if(typeLHS!.asGiven == "" or typeRHS!.asGiven == ""){return(tvTrue)}
        // TODO: Make typeID() work when words aren't defined e.g.  word/findPlural lang/splitText user/getNth
        me string: rhsTypeID <- typeRHS!.typeID()
        me string: lhsTypeID <- typeLHS!.typeID()
        if(lhsTypeID == rhsTypeID){return(tvTrue)}

        withEach LHSSpec in addedTypes{
            if(LHSSpec!.typeID() == rhsTypeID){return(tvTrue)}
        }
        withEach RHSSpec in RHSInf!.addedTypes{
            if(RHSSpec!.typeID() == lhsTypeID){return(tvTrue)}
        }
        return(tvFalse)
    }
    our POV: fetchCompatibleField(their Agent: agent, our infonView: pattern) <- {
        our WordUse: patternType <- pattern!.type
        if(patternType==NULL){log("WARNING: field has no type to search on in:"+toString(pattern)); return(NULL)}
        if(value!.items.isEmpty()){return(NULL)}
        our POV: pov <- value!.items.head
        while(pov != NULL){
            our infonView: inf <- pov!.pItem
            fleshOutWord(agent, inf)
            if(inf!.type!=NULL and inf!.isCompatibleWith(pattern, pov!.trueByDefinition)==tvTrue){
                return(pov)
            }
            pov <- pov!.next
        }
        return(NULL)
    }
    me string:  fetchString()  <- {return(value!.str)}
    me FlexNum: fetchFlexNum() <- {return(value!.getValAsNum())}
    me int64:   fetchInt()     <- {return(value!.getValAsNum().convertToInt())}
    me double:  fetchDouble()  <- {if(value!.inverted){return(-value!.num.convertToFloat())}else{return(value!.num.convertToFloat())}}

    our infonView: findMatchingItem(our infonView: pattern) <- {
        me string: fieldName <- pattern!.type!.typeID()
        our POV: pov <- fetchField(fieldName)
        if(pov!=NULL){
            return(pov!.pItem)
        } else {return(NULL)}
    }

    me FlexNum: sizeIfKnown() <- {
        if(infSize!.evalMode == emLiteral){return(infSize!.num)}
        return(-1)
    }
    me FlexNum: countGivenItems() <- {
        me FlexNum: acc <- 0
        our POV: pov <- value!.items.head
        while(pov != NULL){
            our infonView: pItem <- pov!.pItem
            if(pItem!.itmMode == mItem) {
                acc <- acc + 1
            } else if(pov!.isSubItm){
                me FlexNum: childCount <- pItem!.sizeIfKnown()
                if(childCount==-1){return(-1)}
                acc <- acc + childCount
            }
            pov <- pov!.next
        }
        return(acc)
    }
    their infonState: countSize(me bool: verify) <- {
        if(infSize!.evalMode==emUnknown){verify <- false}
        if(value!.sizeMode!=fromGiven and (infSize!.evalMode==emUnknown or verify)){
            if(value!.overlayType==STR and value!.evalMode==emLiteral){
                infSize!.overlayType  <- NUM
                infSize!.evalMode <- emLiteral
                infSize!.num    <- value!.str.size()
            } else if(value!.overlayType==LST and (value!.evalMode==emLiteral or value!.evalMode==emIntersection)){
                me FlexNum: acc <- 0
                our POV: pov <- value!.items.head
                while(pov != NULL){
                    our infonView: pItem <- pov!.pItem
                    if(pItem!.itmMode == mItem or pItem!.itmMode == mWordDefn) {
                        acc <+- 1
                    } else if(pov!.isSubItm) {
                        if(pItem!.value!.tailUnfinished){return(infSize)}
                        their infonState: tmp <- pItem!.countSize(false)
                        if(tmp!.evalMode==emUnknown){return(infSize)}
                        acc <+- tmp!.num
                    }
                    pov <- pov!.next
                }
                if(verify){
                    if(infSize!.evalMode==emLiteral and infSize!.num==acc){
                        value!.tailUnfinished <- false
                    }
                }else{
                    infSize!.overlayType  <- NUM
                    infSize!.evalMode <- emLiteral
                    infSize!.num    <- acc
                    value!.tailUnfinished <- false
                }
            }
        }
        return(infSize)
    }
    me bool: isASeq() <- {return((value!.evalMode==emLiteral and value!.overlayType==LST) or value!.evalMode==emConcat)}
    me bool: isOrLike() <- {return(value!.evalMode==emIntersection and intersectPos==ipGetLast and innr!=NULL and innr!.infSize!.evalMode==emUnknown and innr!.value!.sizeMode==fromGiven and innr!.value!.evalMode==emLiteral)}
    me OrderMode: getOrderMode(their Agent: agent) <- {
        if(orderMode!=uUnknown){return(orderMode)}
        if(type!=NULL){
            me vocabularySpec: vSpec
            vSpec.init(agent!.getLocaleBaseName())
            me List<our WordDefn>: resultDefns
            me int: numAdded <- modelMngr.lookupWord(type!.typeID(), vSpec, resultDefns)
            if(!resultDefns.isEmpty()){
                our WordDefn: def <- resultDefns[0]
                orderMode <- def!.meaning!.orderMode
            }
        }
        return(orderMode)
    }
    void: setOrderMode() <- {
        if(funcArgs!=NULL){
            if(funcArgs!.orderMode!=uUnknown){
                orderMode <- funcArgs!.orderMode
            }
            else{
                if(funcArgs!.type!=NULL){
                    me vocabularySpec: vSpec
                    if(!definedWord!.UsageTags.isEmpty()){
                        vSpec.init(definedWord!.UsageTags[0])
                    }
                    me List<our WordDefn>: resultDefns
                    me int: numAdded <- modelMngr.lookupWord(funcArgs!.type!.typeID(), vSpec, resultDefns)
                    if(!resultDefns.isEmpty()){
                        our WordDefn: def <- resultDefns[0]
                        orderMode <- def!.meaning!.orderMode
                    }
                }
                funcArgs!.orderMode <- orderMode
            }
        }
    }
    me string: getTypeStr() <- {
        if(type!=NULL){return(type!.typeID())}
        return("")
    }
    our POV: getNthInfonView(me FlexNum: N) <-{
        our POV: NthPov
        me FlexNum: crntIdx <- 0
        our POV: pov <- value!.items.head
        while(pov != NULL){
            if(pov!.isSubItm){ //TODO: test mSubitems in getNthInfonView
                me FlexNum: itmSize <- sizeIfKnown()
                if(itmSize!=-1){
                    me FlexNum: offSet <- crntIdx+itmSize
                    if(offSet<=N){return(pov!.pItem!.getNthInfonView(N-crntIdx))}
                    else{crntIdx <- offSet}
                }
            }else{
                crntIdx <+- 1
                if(crntIdx==N){return(pov)}
            }
            pov <- pov!.next
        }
        return(NthPov)
    }

    our POV: getLastItem() <- {
        // ASSERT(Should be already normed and a non-concat list)
        our POV: lastItem
        if(value!.overlayType!=LST){return(NULL)}
        if(value!.evalMode==emUnknown){return(NULL)}
        if(value!.tailUnfinished){return(NULL)}
        if(value!.items.isEmpty()){return(NULL)}
        lastItem <- value!.items.tail
        if(value!.evalMode==emConcat){lastItem <- lastItem!.pItem!.getLastItem()} //TODO: test emConcat in getLastItem
        if(lastItem!.isSubItm){return(lastItem!.pItem!.getLastItem())} //TODO: if subItem was {}, return the previous... recursivly.
        return(lastItem)
    }

    our POV: getLastPOV() <- {
        our POV: lastPOV
        if(value!.sizeMode==fromGiven){
            if(infSize!.evalMode==emLiteral){
                lastPOV <- getNthInfonView(infSize!.num)
            }
        }else{
            lastPOV <- getLastItem()
        }
        if(lastPOV==NULL){
            our POV: virtualLastItem //<- searchWorkListForRelation(asLast)
            if(virtualLastItem==NULL){
            // Make a virtual last item to be joined later.
                Allocate(virtualLastItem)
                Allocate(virtualLastItem!.pItem)
                virtualLastItem!.pItem!.infSize!.evalMode <- emUnknown
                //wrkList.append(virtualLastItem)
                //TODO: integrate virtualLastItem
            }
            lastPOV <- virtualLastItem
        }
        return(lastPOV)
    }

    our infonView: getLastInfonView() <- {
        our POV: lastPOV <- getLastPOV()
        if(lastPOV==NULL){return(NULL)}
        return(lastPOV!.pItem)
    }
    our infonView: getFirstItem(me bool: isSubItm) <- {
        // ASSERT(Should be already normed)
        our infonView: firstItem
        if(!value!.items.isEmpty()) {
            firstItem <- value!.items.first()
            if(value!.evalMode==emConcat){firstItem <- firstItem!.getFirstItem(isSubItm)}
        }  else {firstItem <- NULL}
        if(firstItem!=NULL and isSubItm){
            firstItem <- firstItem!.getFirstItem(isSubItm)
        }
        return(firstItem)
    }
    our POV: deleteListNode(our POV: toDel) <- {
        // Low level delete of an item in list. Does not update size.
        if(value!.overlayType==LST){
            return (value!.deleteListNode(toDel))
        }
        return(NULL)
    }
    void: _copyAsTypeTo(our infonView: to, me bool: copyWrkList, me bool: copyPartRef, our infonView: topThis, their List<their infonView>: copied) <- {
        withEach item in copied{if(item===this){return()}}
        copied.append(self)
        to!.flags      <- flags
        to!.copySource <- copySource
        to!.doReply    <- false
        to!.originID   <- originID
        to!.infCharPos <- infCharPos
        to!.thisPtr      <- topThis
        to!.addedTypes   <- addedTypes
        to!.orderMode    <- orderMode
        if(type!=NULL){to!.type<- type}
        to!.definedWord <- definedWord
        if(includeSpec!=""){to!.includeSpec <- includeSpec}
        if(includeInfn!=NULL){to!.includeInfn <- includeInfn}
        if(copyPartRef and partRef!=NULL){
            // partRef/parts are pending path-navigation state, not passive metadata.
            // Cloning them into copies that are meant to be "plain semantic materializations"
            // can cause the path walk to be replayed on the clone.
            Allocate(to!.partRef)
            to!.partRef! <- partRef!

            if(!parts.isEmpty()){
                withEach part in parts{
                    our PartPath: newPart
                    Allocate(newPart)
                    newPart! <- part!
                    to!.parts.append(newPart)
                }
            }
        }
        infSize!.copyAsTypeTo(to!.infSize, topThis, copied)
        value!.copyAsTypeTo(to!.value, topThis, copied)
        if(intersectMarkedRetPOV!=NULL){
            our POV: srcPov <- value!.items.head
            our POV: dstPov <- to!.value!.items.head
            while(srcPov!=NULL and dstPov!=NULL){
                if(srcPov===intersectMarkedRetPOV){
                    to!.intersectMarkedRetPOV <- dstPov
                    break()
                }
                srcPov <- srcPov!.next
                dstPov <- dstPov!.next
            }
        }
        if(funcArgs!=NULL){funcArgs!.copyAsTypeTo(to!.funcArgs, true, true)}
        if(innr!=NULL){Allocate(to!.innr); innr!.copyAsTypeTo(to!.innr, true, true)}
        if(copyWrkList){to!.copyWrkListFrom(self)}
    }
    void: copyAsTypeTo(our infonView: to, me bool: copyWrkList, me bool: copyPartRef) <- {
        me List<their infonView>: copied
        if(thisPtr==NULL){
            _copyAsTypeTo(to, copyWrkList, copyPartRef, to, copied)
        }else{
            _copyAsTypeTo(to, copyWrkList, copyPartRef, thisPtr, copied)
        }
    }
    void: convertThisToIntersection(our infonView: newInnr, me SizeMode: sMode) <- {
        itmMode         <- mItem
        viewMode         <- vmOverlay
        value!.evalMode  <- emIntersection
        intersectPos    <- ipGetLast
        infSize!.evalMode  <- emUnknown
        innr            <- newInnr
        innr!.isInnr     <- true
        innr!.value!.sizeMode <- sMode

    }
    our POV: addToOrInfonView(our infonView: rItem, our POV: rNode, our POV: pred) <- {
        our POV: pov <- innr!.value!.items.head
        while(pov != NULL){  // Don't push if duplicate
            if(pov!.pItem===rNode!.pItem){return(NULL)}
            pov <- pov!.next
        }
        our POV: newAlt <- innr!.value!.items.pushAsAlt(rNode, rItem, pred)
        return(newAlt)
    }
    void: pushAltIntoLineAlt(our POV: pred, me int: lineID, our infonView: rItem, our POV: rNode, me bool: LHSIsFromALT) <- {
        // Search wrkList for lineID
        our POV: povToPushTo <- NULL
        withEach wrkItm in wrkList{
            if(wrkItm!.linearAltID==lineID){povToPushTo<-wrkItm; break()}
        }
        if(povToPushTo == NULL){
            withEach usdWrkItm in usedWrkList{
                if(usdWrkItm!.linearAltID==lineID){
                    povToPushTo<-usdWrkItm
                    // POP from used, push to wrkList
                    // DON'T REDO already done alts.
                //    usedWrkList.erase(usdWrkItm)
                    //:l/PAI::logSeg(" WLA.a:"+povToPushTo!.mySymbol())
                    wrkList.append(povToPushTo)
                    log("TODO: POP, PUSH, Don't REDO") // TODO: POP, PUSH, Don't REDO
                }
            }
        }
        if(povToPushTo == NULL){ // Make an alt item to add.
            povToPushTo <- makeOrPov(rNode, pred)
            povToPushTo!.pItem!.innr!.value!.tailUnfinished <- true
            povToPushTo!.pItem!.innr!.value!.sizeMode       <- fromGiven
            povToPushTo!.linearAltID                     <- lineID
            addPOVToWrkList(povToPushTo)
        }else{
            our POV: newAlt <- povToPushTo!.pItem!.addToOrInfonView(rItem, rNode, pred)
            if(newAlt!=NULL){newAlt!.isFromALT<-true; newAlt!.pParent  <- povToPushTo}
        }
        //log("AddedAltToLineAlt:"+povToPushTo!.mySymbol()+":"+povToPushTo.stringify()+" <pred- "+pred!.mySymbol()+":"+pred!.stringify())
    }
    bool: workListContainsInfonView(our infonView: inf) <- {
        if(self===inf){return(true)}
        withEach wrkListItem in wrkList{
            if(wrkListItem!.pItem===inf){return(true)}
        }
        return(false)
    }
    bool: infonViewHasType(me string: typeIDStr) <- {
        if(type!=NULL and type!.typeID()==typeIDStr){return(alreadyTypeChecked)}
            withEach subType in addedTypes{
            if (subType!.typeID() == typeIDStr  and subType!.typeInitialized) {
                return(true)
            }
        }
        return(false)
    }
    void: addPOVToWrkList(our POV: pov) <- {
        if(workListContainsInfonView(pov!.pItem)){return()}
        isNormed <- false
        //:l/PAI::logSeg(" WLA.b:"+pov!.mySymbol())
        wrkList.append(pov)
    }
    our POV: addInfonViewToWrkList(our infonView: i, me bool: internalIdent, me int: source) <- {
        if(workListContainsInfonView(i)){return(NULL)}
        our POV:: newPov{source}
        //i!.asRHSInternalIdent <- internalIdent     // Maybe needed for pronouns
        newPov!.pItem <- i
        isNormed <- false
        //:l/PAI::logSeg(" WLA.c:"+newPov!.mySymbol())
        wrkList.append(newPov)
        return(newPov)
    }
    our POV: addInfonViewToWorkListWithPriority(our infonView: i, me bool: internalIdent) <- {
        if(workListContainsInfonView(i)){return(NULL)}
        our POV:: newPov{402}
        i!.asRHSInternalIdent <- internalIdent
        newPov!.pItem <- i
        newPov!.pItem!.streamState <- notParsing
        isNormed <- false
        wrkList.prepend(newPov, 403)
        return(newPov)
    }
    void: copyWrkListFrom(their infonView:from) <- {
        withEach wrkListItem in from!.wrkList {
            our POV:: pov{455}
            pov! <- wrkListItem!
            if(pov!.pedigree.source==0){pov!.pedigree.source <- 455}
            Allocate(pov!.pItem)
            wrkListItem!.pItem!.copyAsTypeTo(pov!.pItem, true, true)
            //:l/PAI::logSeg(" WLA.d:"+pov!.mySymbol())
            wrkList.append(pov)
        }
    }
    void: takeWrkListFrom(our infonView:from, me bool: doClear) <- {
        withEach wrkItm in from!.wrkList{
            addPOVToWrkList(wrkItm)
        }
        if(doClear){from!.wrkList.clear()}
    }
    void: retainPOV(our POV: pov) <- {
        if(pov!=NULL){retainedPOVs.append(pov)}
    }
    our infonView: findPartPathByWord(me string: wordName) <- {
        withEach part in parts{
            if(part!.path!.type != NULL and part!.path!.type!.typeID() == wordName){
                return(part!.path)
            }
        }
        return(NULL)
    }
    me string: lengthStatus() <- {
        //MUST: complete after range functionality works
        if(infSize!.evalMode==emLiteral){
            me FlexNum: maxSize <- infSize!.num
            me FlexNum: itmCount <- countGivenItems()
            if(itmCount == -1){return("?")}
            if(itmCount < maxSize){return("L")}
            else if(itmCount == maxSize){return("E")}
            else{return("G")}
        }else{return("?")}
    }
    me string: worklistToString() <- {
        me string: S <- ""
        withEach workItm in wrkList{
            //S <- S + "\n    ::" + workItm.stringify()
        }
        return(S)
    }
    void: clear() <- {
        infSize!.clear()
        value!.clear()
        resetFlagsAndModes()
        copySource <- NULL
        funcArgs   <- NULL
        innr       <- NULL
        type       <- NULL
        retainedPOVs.clear()
    }
    void: setToList() <- {
        clear()
        itmMode      <- mItem
        viewMode      <- vmOverlay
        value!.overlayType  <- LST
        value!.evalMode <- emLiteral
        value!.sizeMode       <- fromCount
        value!.tailUnfinished <- true

        infSize!.overlayType        <- NUM
        infSize!.evalMode       <- emUnknown
    }
    void: setSelfAsAPluralOf(our infonView: toPluralize) <-{
        setToList()
        value!.listSpec <- toPluralize
        if(toPluralize!=NULL and toPluralize!.type!=NULL and toPluralize!.type!.typeID()!=""){
            me string: plural <- inflect.convert_to_modern_plural(toPluralize!.type!.typeID())
            Allocate(type)
            log("\n @@@@@@ PLURALIZING:",plural)
            type!.setAsGiven(plural)
            print("\n@@@@@@@@@@@@@ Pluralizing:"+toString(toPluralize)+"\n")
        }
    }
    void: INIT() <- {
        Allocate(infSize); infSize! <- infonState(0)
        Allocate(value)
        clearSymbol(self);
        orderMode <-uUnknown
    }
    none: infonView(me string: S) <- {
        Allocate(infSize); infSize! <- infonState(S.size())
        Allocate(value);   value!   <- infonState(S, true)
        viewMode <- vmOverlay
        itmMode <- mItem
    }
}
model infItr{
    our infItr: iParent
    their POV: topPOV
    me int: lineAltID
    void: initialize(our POV: pov) <- {topPOV <- pov}
    void: INIT() <- {clearSymbol(self);}
}

struct GLOBAL{
    me bool: streamingNormMode
    me Mutex: streamingNormMutex
    me SyncLock: streamingNormLock


    me string: crntRHSMySymbol
    me string: crntLHSMySymbol

    void: reFunctionize(our infonView: infn) <- {
        infn!.cnvtToFunc <- false
        our infonView:: newInnr
        newInnr! <- infn!
        infn!.convertThisToIntersection(newInnr, fromCount)
    }
    our infonView: makeInnrInfonView() <- {
        our infonView:: newListInfon
        newListInfon!.itmMode        <- mItem
        newListInfon!.viewMode        <- vmOverlay
        newListInfon!.infSize!.overlayType  <- NUM
        newListInfon!.infSize!.evalMode <- emUnknown
        newListInfon!.infSize!.num    <- 1
        newListInfon!.value!.overlayType    <- LST
        newListInfon!.value!.evalMode   <- emLiteral
        newListInfon!.isInnr         <- true
        return(newListInfon)
    }
    our POV: makeOrPov(our POV: nextPov, our POV: pred) <- {
        our infonView: newListInfon <- makeInnrInfonView()               // Make {...} to be used as innr
        our POV: newAlt <- newListInfon!.value!.items.pushAsAlt(nextPov, nextPov!.pItem, pred)  // Make a POV for the item.
        our infonView:: newAltInfon; newAltInfon!.value!.overlayType   <- tUnknown
            newAltInfon!.convertThisToIntersection(newListInfon, fromGiven) // Make [ ] and add innr to it
        our POV:: newAltInfPov{4}                                  // Make the POV pointing to the [...]
            newAltInfPov!.pItem <- newAltInfon
        newAlt!.looseInhtd <- nextPov!.looseInhtd
        newAlt!.looseTop   <- nextPov!.looseTop
        newAlt!.looseMode  <- nextPov!.looseMode
        newAlt!.pParent    <- newAltInfPov
        newAlt!.isFromALT  <- true
        return(newAltInfPov)
    }
    void: trimTowardInfonViewFront(our POV: parentList, our POV: itemToTrim) <- {
        if(itemToTrim!.isSubItm){
            //:l/PAI::logSeg(" trim")
            itemToTrim!.pItem!.value!.items.clear()
            itemToTrim!.pItem!.infSize!.num<-0
            if(!(parentList!.pItem!.value!.items.head===itemToTrim) and itemToTrim!.prev!=NULL){
                trimTowardInfonViewFront(parentList, itemToTrim!.prev)
            }
        }
    }
    void: fleshOutWord(their Agent: agent, our infonView: infn) <- {//  if type and no defn look up defn call derefInf()
        agent!.worldMgr.derefInfonView(infn)
    }
    me bool: descendantOwnsReply(our infonView: inf) <- {
        // Returns true if a child of `inf` (or a deeper descendant via still-parsing sub-list)
        // already owns the doReply, meaning waiting on `inf` itself for parseDone is wrong.
        our POV: crntPov <- inf!.value!.items.head
        while(crntPov != NULL){
            if(crntPov!.pItem!.doReply){return(true)}
            if(crntPov!.pItem!.value!.overlayType==LST and crntPov!.pItem!.streamState!=parseDone and crntPov!.pItem!.streamState!=notParsing){
                return(true)
            }
            crntPov <- crntPov!.next
        }
        return(false)
    }
    me bool: checkIfReplyRequested(their POV: pov) <- {
        if(pov==NULL or pov!.pItem==NULL){return(false)}
        our infonView: inf <- pov!.pItem
        // Only fire the early-wake gate when the reply is actually ready: doReply is set
        // AND there is no pending path navigation. For path expressions, intermediate
        // infons carry doReply forward through partRef/parts; firing the gate while
        // navigation is still pending wakes the parent rsInfon prematurely and skips
        // segments.
        me bool: pathPending <- (inf!.partRef!=NULL or !inf!.parts.isEmpty())
        if(inf!.doReply and !pathPending){return(true)}
        // For a streaming list at parseListReady, doReply might be set when the closing
        // `}` and `\`` are parsed. Wait briefly for that — but only when we won't end up
        // blocked on an unfinished nested sub-list (whose own close gates the parent's).
        if(streamingNormMode and inf!.value!.overlayType==LST and pov!.pParent!=NULL and inf!.streamState==parseListReady){
            me MutexMngr: MtxMgr{streamingNormMutex}
            while(inf!.streamState==parseListReady){
                if(descendantOwnsReply(inf)){break()}
                streamingNormLock.wait(MtxMgr)
            }
        }
        pathPending <- (inf!.partRef!=NULL or !inf!.parts.isEmpty())
        return(inf!.doReply and !pathPending)
    }
    me string: toString(our AItem: aItem) <- {
        me string: S <- aItem!.mySymbol()+":"+aItem!.stringify()
        if(! aItem!.subscribers.isEmpty()){
            //S <- aItem!.subscribers[0]!.mySymbol()+":"+ S
        }
        return(S)
    }
    me string: indentStr(me int: lvl) <- {
        me string: S <- ""
        withEach c in range 0 .. lvl{
            S <+- " |"
        }
        return (S)
    }
    me int: lastLineAltID <- 0
    // To use this to debug, set InfonToMonitor then from relevant places call printDebInf() passing in a tag and a sub-infon to highlight.
    our infonView: infonToMonitor
    me string: prevInfToMonitorState
    me string: debugEventList
    void: printDebInf(me string: tag, our infonView: crntInfon) <- {
        if(infonToMonitor!=NULL){
            me string: newStr <- toStringColor(infonToMonitor, 1, crntInfon)
            if(newStr!=prevInfToMonitorState){
                print(debugEventList+"\n")
                print(alignLeft(tag, 12)+":"+newStr+"\n")
                debugEventList <- ""
                prevInfToMonitorState <- newStr
            }
        }
    }
    void: setInfonViewToMonitor(our infonView: inf) <- {
        if(inf!==infonToMonitor){
            infonToMonitor <- inf
            debugEventList <- ""
            printDebInf("SET:"+inf!.mySymbol(), inf)
        }
    }
    void: addDebugEvent(me string: eventDescription, our infonView: crntInfon) <- {
        if(infonToMonitor!=NULL){
            debugEventList <+- tam.setTextColor(2) + eventDescription+ tam.setDefaultColor() + "; "
        }
    }

}
struct AItemPedigree{
    me aitemSrcID: source
}
model AItem{
    mode[rsInfon, rsMerge, rsIntersect, rsPure]: ruleSet
    me uint64: aItemID
    me uint64: runID
    me uint64: lastEnqueueID
    our POV: LHS_item
    our POV: RHS
    our POV: cursorAnchor
    our infItr: LHSItr
    our infItr: RHSItr
    me int64: priority
    flag: looseSize
    //flag: reject
    mode[msUnknown, msPending, msAccept, msReject]: mergeStatus  // Did this merge have a contradiction?
    flag: taskEnqueued
    flag: concatProcessed
    flag: dontProcess
    flag: candidateForLast
    flag: skipRHSUsageInPAI  // With unordered lists, we get the RHS another way.
    flag: wokenEarly
    me int: step
    me int: pendingTasks
    me int: heldPendingTasks
    FlexNum: sizeToCopy
    me List<our AItem>: subscribers
    me AItemPedigree: pedigree
    our AItem: parent
    our AItem: debugArg     // For debugSystems validateAItem()
    me int: indentLvl
    flag: initRulesApplied
    me List<me string>: phase1HandlerEvents
    me bool: phase1UnsupportedReached
    me int: distanceToTop() <- {
        me int: retVal <- 0
        our AItem: crnt <- parent
        while(crnt!=NULL){
            retVal <+- 1
            crnt <- crnt!.parent
        }
        return(retVal)
    }

    our AItem: prntOrSub() <- {
        if(parent!=NULL){return(parent)}
        if(!subscribers.isEmpty()){return(subscribers[0])}
        return(NULL)
    }

    our AItem: parentListsMrgAItem() <- {
        their POV: parentList <- LHS_item!.pParent
        our AItem: crnt <- prntOrSub()
        while(crnt!=NULL and crnt!.LHS_item!==parentList and crnt!.ruleSet!=rsMerge){
            crnt <- crnt!.prntOrSub()
        }
        return(crnt)
    }

    me string: stringify() <- {
        me string: S <- ""
        if(self==NULL){S<-S+"NULL"}
        else{
            S <+- LHS_item!.mySymbol()+":"+LHS_item!.pItem!.mySymbol()+":"
            const int: strLen <- 1000
            switch(ruleSet){
                case rsInfon:{
                    S <+- "INF:<"+ shortedStr(toString(LHS_item!.pItem),strLen*2)+">"
                }
                case rsMerge:{
                    S <+- "MRG:"+ shortedStr(toString(LHS_item!.pItem),strLen)
                    if(RHS!=NULL) {
                        me string: equalStr <- "="
                        if (RHS!.looseType()){equalStr <- "=="}
                        if(RHS!.looseTop){ S <+- ":"}
                        S <+- " '"+equalStr+"' "+ shortedStr(toString(RHS!.pItem),strLen)
                    }
                }
                case rsIntersect:{
                    S <+- "INSCT:"+ shortedStr(toString(LHS_item!.pItem),strLen*2)
                }
                case rsPure:{
                    S <+- "PURE:"
                }
            }
            if(mergeStatus==msReject){S <+- "REJ"}
            else if(mergeStatus==msAccept){S <+- "ACPT"}
            else if(mergeStatus==msPending){S <+- "PEND"}
            //S <+- "[P_"+toString(priority)+"]"
        }
        return (S)
    }
    void: INIT() <- {clearSymbol(self)}
    none: AItem(me aitemSrcID: source) <- {
        INIT()  // TODO:
        flags     <- 0
        aItemID   <- 0
        runID     <- 0
        lastEnqueueID <- 0
        LHS_item  <- NULL
        RHS       <- NULL
        LHSItr    <- NULL
        RHSItr    <- NULL
        parent    <- NULL
        priority  <- 0
        step      <- 0
        pendingTasks <- 1
        heldPendingTasks <- 0
        sizeToCopy   <- 0
        indentLvl    <- 0
        pedigree.source <- source
    }
}
struct AItem{
    void: phase1BeginRun() <- {
        phase1HandlerEvents.clear()
        phase1UnsupportedReached <- false
    }
    void: phase1RecordHandler(me string: handlerID, me bool: unsupported) <- {
        if(unsupported){
            phase1UnsupportedReached <- true
            phase1HandlerEvents.append("UNSUPPORTED:"+handlerID)
        }else{
            phase1HandlerEvents.append(handlerID)
        }
    }
    me string: phase1HandlerSummary() <- {
        me string: summary
        withEach handlerID in phase1HandlerEvents{
            if(summary!=""){summary <+- ";"}
            summary <+- handlerID
        }
        if(summary==""){summary <- "UNCLASSIFIED"}
        return(summary)
    }
}
model PartPath{
    our infonView: path
    our infonView: spec
    mode[dotField, upField, idxField, colonField]: pathMode
    flag: wasTransfered
    flag: hasSemiColon
}
struct PartPath{
    void: clear()<-{path<-NULL; spec<-NULL; flags<-0;}
}
struct infonState{
    me Multimap<me string, our infonView>: index
    me Multimap<me int64, our infonView: rangeIteration=logarithmic>: T_index
}
//////////////////////////
// Definition storage

struct GLOBAL{
    me ModelManager: modelMngr
    me uint64: phase1NextNormalizationID <- 1
    me Mutex: phase1NormalizationIDMutex
}

struct Agenda{
    our POV: topPOV
    me uint64: normalizationID <- 0
    me uint64: nextAItemID <- 1
    me uint64: nextRunID <- 1
    me uint64: nextEnqueueID <- 1
    me uint64: totalAItemsAdded <- 0
    me uint64: totalPropagationsQueued <- 0
    me uint64: totalPropagationsProcessed <- 0
    me Multimap<me int64, our AItem: rangeIteration=logarithmic>: AItems
    me Mutex: agendaDoneMutex
    me SyncLock: agendaDoneLock

    me List<our PropagateRecord>: propagationsTodo // Buffer for propagations

    void: insert(our AItem: aItem, me int64: priority) <- {AItems.insert(priority, aItem)}

    me bool: povIsOnAgenda(our POV:pov)<-{
        withEach aItem in AItems{
            if(aItem!.ruleSet==rsInfon and aItem!.LHS_item===pov){return(true)}
        }
        return(false)
    }
    me bool: addAItemToAgenda(our AItem: aItem) <- {
        me bool: itmAdded <- true
        if(aItem!.aItemID==0){
            aItem!.aItemID <- nextAItemID
            nextAItemID <+- 1
        }
        aItem!.lastEnqueueID <- nextEnqueueID
        nextEnqueueID <+- 1
        totalAItemsAdded <+- 1
        //me string: logStr <- "        ADD_TO_AGENDA:"+shortedStr(toString(aItem),120)+"  PRIORITY:"+toString(aItem!.priority)
        if(aItem!.ruleSet == rsInfon){
                insert(aItem, aItem!.priority)
        }else{insert(aItem, aItem!.priority)}
        //log(logStr)
        return(itmAdded)
    }
}

struct PropagateRecord{  // Store a call to propagateProxy and propagate it later. Because propagate may block so we need to delay it.
    our AItem: aItem
    our POV: LHSPov
    our POV: RHSPov
    our POV: remainder
    me bool: looseSize
    bool: dontEnque
}

//////////////////////////
// Infon Interface Routines
struct Agent{
    our infonView: foundation
    our infonView: device
    our infonView: user
    our infonView: world
    me AgentContext: context
    me WorldManager: worldMgr
    their ProteusCore: CORE
    me Locale: locale
    our Map<string, string>: settings
    me int: errorStatus
    me string: errorMesg

    void: setErrorState(me string: errorMesg) <- {
        //log("INFON ERROR: " + errorMesg)
       // print("INFON ERROR: " + errorMesg+"\n")
    }
    void: normalize(our POV: normPov) <- {
        our Agenda:: agenda{normPov}
        our AItem: normPIVA <- worldMgr.processInfonViewViaAgenda(agenda, normPov, NULL, NULL, 1, srcNormInit)
        agenda!.addAItemToAgenda(normPIVA) // PIVA init
        //log("Norm_PIVA:"+toString(normPIVA))
        worldMgr.processAgenda(agenda)
        if(agenda!.AItems.size()>0){log("// Proteus ERROR: "+toString(agenda!.AItems.size())+" items still on agenda.")}
        log("NORMED:" + toString(normPov!.pItem))
    }
    void: normalizeOneLevel(our POV: normPov) <- {
        me string: logStr <- logMgr.logger.logStr + " SUB_NORM"
        logMgr.logger.logStr <- ""
        log("NORM:________")
        normPov!.doNotEnter <- true
        normalize(normPov)
        normPov!.doNotEnter    <- false
        normPov!.hasPropagated <- false
    // TODO: this won't work if streaming. Need to set hasPropagated to false in a streaming manner
    if(!normPov!.pItem!.value!.items.isEmpty()){
        our POV: pov <- normPov!.pItem!.value!.items.head
        while(pov != NULL){
            pov!.hasPropagated <- false
            pov <- pov!.next
        }
    }
        log("NORM:________")
        //:l/PAI::logSeg(logStr)
    }
    void: appendToWorld(our infonView: newInfon) <- {
        our infonView: dotsAtTheEnd <- world!.value!.items.last()  //TODO: What is this line for?
        world!.value!.items.append(newInfon, false, 26)
    }
    void: initUser() <- {}
    void: setLocale(me string: loc) <- {
        locale <- unicodeMgr.SetLocale(loc)
        //Xlater=fetchXlater(&locale)
    }
    me string: getLocaleBaseName() <- {
        return(unicodeMgr.getLocaleBaseName(locale))
    }
    me int: setSetting(me string: key, me string: value) <- {
        settings![key] <- value
        if(key=='locale'){setLocale(value); return(2)}
        return(1)
    }
    void: init(their ProteusCore: core) <- {
        Allocate(settings)
        CORE <- core
        Allocate(device); device!.setToList()
        Allocate(user);   user!.setToList()
        Allocate(world); world!.setToList()
        context.init()
        worldMgr.init(this)
        errorStatus <- 0
        errorMesg <- ""
    }
}
struct ThreadedNormalizer: inherits=Threads {
    // Also available: start() and waitForExit()
    our infonView: item
    our POV: pov
    their Agent: agent
    void: init(their Agent: _agent, our infonView: inf) <- {
        item <- inf
        item!.streamState <- parseStarted
        agent <- _agent
        Allocate(pov, 700)
        pov!.pItem <- inf
    }
    void: run() <- {
        me string: infonSourceStr <- agent!.CORE!.getOriginIDString(item!.originID)
        log("OPENING NORM_THREAD: "+infonSourceStr)
        if(streamingNormMode){
       sleep(100) // TODO:  remove this after fixing normalize races parseer
            me MutexMngr: MtxMgr{streamingNormMutex}
            while(item!.streamState==parseStarted){  //BDL == to <=
                //log("streamingNormLock.wait::ThreadedNormalizer: "+infonSourceStr)
                streamingNormLock.wait(MtxMgr)
                //log("streamingNormLock.DONE::ThreadedNormalizer: "+infonSourceStr)
            }
            //print("TOP's FirstItem:"+item!.value!.items.first().mySymbol()+"\n")
        }
        log("OPENED NORM_THREAD: "+infonSourceStr)
        agent!.normalize(pov)
        log("CLOSING NORM_THREAD: "+infonSourceStr)
        print("CLOSING NORM_THREAD: "+infonSourceStr+"\n")
        log("RESULT:"+pov!.stringify())
    }
}
struct ProteusCore{
    me sessionFile: DB_session
    our infonView: WORLD
    our Agent: agent
    me bool: streamingMode
    me string: errorMesg

    our infonView: parse(their ProteusParser: parser, their strBuf: streamToParse) <- {
        errorMesg <- ""
        our infonView:: topParsedNode
        parser!.initParseFromStream(streamToParse)
        parser!.CORE <- self
        parser!.doParse(topParsedNode)
        if(parser!.doesParseHaveError()){
            errorMesg <- parser!.formattedError()
            return(NULL)
        } else {return(topParsedNode)}
    }

    our infonView: parseAndExtractStream(their strBuf: streamToParse) <- {
        me ProteusParser: parser{self, streamingMode, 0}
        our infonView: topParsedNode <- parse(parser, streamToParse)
        return(topParsedNode)
    }

    our infonView: parseAndExtractString(me string: textToParse, me string: streamName) <- {
        their strBuf:: bufToParse
        bufToParse!.initForString(textToParse, streamName)
        return(parseAndExtractStream(bufToParse))
    }

    void: initParserParseExtractNormalizeInfonView_stream(our POV: toFill, their strBuf: streamToParse) <- {
        our ProteusParser:: parser{self, streamingMode, 0}
        our infonView: topParsedNode <- parse(parser, streamToParse)
        if(topParsedNode!=NULL){
            toFill!.pItem <- topParsedNode
            agent!.normalize(toFill)
        }
    }

    me bool: loadFoundationContext() <- {
        me string: foundationPath <- "public/foundation.pr"
        me string: foundationStr <- readAssetAsString(foundationPath)
        if(foundationStr==""){
            errorMesg <- "Proteus file '"+foundationPath+"' not found"
            return(false)
        }
        our infonView: foundationNode <- parseAndExtractString(foundationStr, foundationPath)
        if(foundationNode == NULL){
            errorMesg <- "Proteus file '"+foundationPath+"' did not parse correctly"
            return(false)
        }
        agent!.foundation <- foundationNode
        our POV:: foundationPov{29}; foundationPov!.pItem <- agent!.foundation
        agent!.normalize(foundationPov)
        return(true)
    }

    me bool: loadWorld(me string: filename) <- {
        me string: worldFilePath <- filename
        if(findString(worldFilePath, "PublicKB.pr")!=-1){
            if(!loadFoundationContext()){return(false)}
        }
        me string: worldStr <- readAssetAsString(worldFilePath)
        if(worldStr==""){
            errorMesg <- "Proteus file '"+worldFilePath+"' not found"
            return(false)
        }
        WORLD <- parseAndExtractString(worldStr, worldFilePath)
        if(WORLD == NULL){
            errorMesg <- "Proteus file '"+worldFilePath+"' did not parse correctly"
            return(false)
        }
        agent!.world <- WORLD
        our POV:: normPov{27}; normPov!.pItem <- agent!.world
        agent!.normalize(normPov)
        return(true)
    }

    me bool: normalizeFromStreamSpec(our POV: toFill, me string: streamSpec) <- {
        trimWS(streamSpec)
        log("ProteusCORE:Normalize:"+streamSpec)
        me int: colonPos <- findString(streamSpec, ":")
        me string: streamSpecType <- streamSpec.subStr(0,colonPos)
        if(streamSpecType!="file"){
            logFatalError("Unknown file specification type:"+streamSpecType)
        }
        me string: filename <- streamSpec.subStr(colonPos+1)
        me string: infonStr <- readAssetAsString(filename)
        if(infonStr==""){
            errorMesg <- "Proteus file '"+filename+"' not found"
            return(false)
        }
        their strBuf:: bufToParse
        bufToParse!.initForString(infonStr, streamSpec)
        initParserParseExtractNormalizeInfonView_stream(toFill, bufToParse)
        return(true)
    }

    me string: resultString(our infonView: inf) <- {
        me string: result <- ""
        if(inf!=NULL){
            result <- toString(inf)
        } else {
            result <- errorMesg
        }
        return(result)
    }

    our infonView: query(me string: qry, me bool: writeToSession) <- {
        // Parse -> extract -> normalize -> sessionFile
        our infonView: result <- parseAndExtractString(qry, "query")
        if(result == NULL){log("Syntax Error in input: " + qry)}
        our POV:: normPov{28}; normPov!.pItem <- result
        agent!.normalize(normPov)
        if(writeToSession){addStatementToSession(remNewLines(qry))}
        return(normPov!.pItem)
    }

    void: loadProteusSessionFile(me string: filename) <- {
        me sessionFile: session
        if(session.openToRead(filename)){return()}
        me string: fLine
        while(! session.eof()){
            fLine <- session.readEntry()
            //ProteusQuery(fLine, false)
        }
        session.closeReading()
    }
    me void: annexSessions(me string: sessionFilename) <- {
        loadProteusSessionFile(sessionFilename)
    }
    me void: addStatementToSession(me string: stmt) <- {
        DB_session.writeEntry(stmt)
    }

    void: setStreamingMode(me bool: streamMode) <- {streamingMode <- streamMode}

    void: submitProteusResult(me uint64: originID, me uint64: pos, me string: mesg)  <- {print(mesg+"\n")}
    void: handleSystemError  (me uint64: originID, me string: mesg)  <- {print(mesg+"\n")}
    void: handleSyntaxError  (me uint64: originID, me string: mesg)  <- {print(mesg+"\n")}
    void: handleProteusError (me uint64: originID, me string: mesg)  <- {log(mesg)}
    me string: getOriginIDString(me uint64: originID) <- {
        return("source#"+toString(originID))
    }

    me bool: init(me string: worldFileName, me bool: streamingMode<-false) <- {
        errorMesg <- ""
        //log("WORLD:"+worldFileName)
        initHardFuncNames()
        setStreamingMode(streamingMode)
        Allocate(agent)
        agent!.init(this)
        Allocate(agent!.foundation)
        agent!.foundation!.setToList()
        if(worldFileName!=""){
            if(!loadWorld(worldFileName)) {logFatalError(errorMesg)}
        }
        agent!.locale <- unicodeMgr.getSystemLocale()
        me string: fileDir <- getFilesDirAsString()+"/sessionDB.pr"
        annexSessions(fileDir)
        DB_session.openSession(fileDir)
        return(true)
    }

    me void: deInit() <- {
        DB_session.closeSession()
    }
}

