//////////////////  Structures For Working with Proteus
// Proteus.dog

LocalBuild: Platform='Local'  testMode='makeTests';
//LinuxTestBuild: Platform='Linux' Lang='CPP' LangVersion='GNU' testMode='makeTests';
//WindowsTestBuild: Platform='Windows' Lang='CPP' LangVersion='MSVC' testMode='makeTests';
//JavaTestBuild:  Platform='Swing' Lang='Java' testMode='makeTests';
//LinuxBuild:     Platform='Linux' LangVersion='GNU' Lang='CPP';

FileName = "Proteus"
Version = "0.8"
CopyrightMesg = "Copyright (c) 2015-2023 Bruce Long"
Authors = "Bruce Long, KT Lawrence"
Description = "Proteus Engine"
ProgramOrLibrary = "program"
TestSpec = "ProteusTests.dog"

featuresNeeded = [Unicode, BigNumbers, Threads, IOBuffer, GraphLogger, Logger]

commentsToActivate = [l/PAI/, l/merge_]

LicenseText = `This file is part of the "Proteus Language suite" All Rights Reserved.`
infonDumpMode='text'

#include WorldManager.dog
#include infonIO.dog
#include infonList.dog
#include Functions.dog
#include ModelManager.dog
#include WordRules.dog
#include InfonStreamLoader.dog
#include xlators/xlator_en.dog
//include DB_workAround.dog

struct SizeMode: inherits=<mode[fromCount, fromContext, fromGiven]> {}
struct OrderMode: inherits=<mode[uUnknown, uOrdered, uUnordered]> {}


// End-relative navigation needs an exact coordinate, not a generally closed
// list.  Keep extent knowledge independent from availability of the logical
// positions at a requested window.
struct EndRelativeExtentStatus: inherits=<mode[
    eresExact,
    eresUnknownOrUnbounded,
    eresIncompatible
]> {}

struct EndRelativeWindowContentStatus: inherits=<mode[
    erwcAvailable,
    erwcPending,
    erwcOutOfRange,
    erwcIncompatible
]> {}

// Semantic identity evidence is distinct from selection provenance.  A
// repetition lookup names an existing logical occurrence; it does not by
// itself assert that a different infon is identical to that occurrence.
struct IdentityEvidenceKind: inherits=<mode[
    iekAssertion,
    iekTemporalBoundary,
    iekTemporalContainment,
    iekTemporalProjection,
    iekTemporalSplit,
    iekTemporalSplitResolution,
    iekEndRelativeResolution,
    iekRepetitionMaterialization,
    iekReferenceSnapshot,
    iekExternalAssociationSelection,
    iekContextReference,
    iekListCorrespondence
]> {}

model IdentityRelation{
    me uint64: evidenceID <- 0
    me IdentityEvidenceKind: evidenceKind <- iekAssertion
    me uint64: normalizationID <- 0
    our POV: leftPOV
    our POV: rightPOV
}
struct IdentityRelation{}

// A negative end-relative selector names one logical occurrence before its
// absolute position is necessarily known.  The registry owns the exact source
// infon and symbolic POV; sourcePOV is the non-owning contextual witness used
// while that source location is active.
model EndRelativeReference{
    me uint64: referenceID <- 0
    their POV: sourcePOV
    our infonView: sourceInfon
    me int64: offset <- 0
    our POV: referencePOV
    our POV: resolvedPOV
    our IdentityRelation: identityRelation
    flag: retired
}
struct EndRelativeReference{}

// Selection provenance names the exact source location found by a query or
// projection.  It is intentionally not IdentityRelation evidence: matching a
// source does not by itself assert that the query/result wrapper is identical
// to that source.
struct SelectionReferenceKind: inherits=<mode[
    srkIntersectionCorrespondence,
    srkMarkedSelection,
    srkPartPathSelection,
    srkPositionalSelection,
    srkExternalAssociation,
    srkWordResolution
]> {}

// A selector is useful before it has found a source occurrence.  Keep that
// symbolic request separate from the accepted occurrence records so an
// unresolved index, range, or description can remain on wrkList while the
// registry retains the reversible operation that the work is trying to
// establish.
struct SelectionResolutionState: inherits=<mode[
    srsNone,
    srsPending,
    srsUnique,
    srsMultiple
]> {}

model SelectionRequest{
    me uint64: requestID <- 0
    their IdentityRegistry: registry
    me SelectionReferenceKind: referenceKind <-
            srkIntersectionCorrespondence
    me uint64: normalizationID <- 0
    our POV: queryPOV
    // The stable wrapper that consumes the selected value.  Low-level match
    // requests leave this NULL because each accepted occurrence supplies its
    // own result POV.
    our POV: consumerResultPOV
    our POV: sourceContextPOV
    // Optional range/member specification paired with queryPOV.  Keeping it
    // here prevents index lowering from erasing the requested span shape.
    our infonView: selectorSpec
    me SelectionResolutionState: resolutionState <- srsPending
}
struct SelectionRequest{}

model SelectionReference{
    me uint64: referenceID <- 0
    me uint64: requestID <- 0
    // Each distinct accepted occurrence gets an opaque token.  Equal values
    // at different source locations therefore remain distinct.
    me uint64: occurrenceToken <- 0
    me SelectionReferenceKind: referenceKind <-
            srkIntersectionCorrespondence
    me uint64: normalizationID <- 0
    our POV: queryPOV
    our POV: resultPOV
    our POV: sourceContextPOV
    our POV: sourceStartPOV
    their RepetitionOccurrence: repetitionOccurrence
}
struct SelectionReference{}

// Runtime traversal never uses NULL to mean both "not found" and
// "ambiguous".  Callers may act on a unique occurrence, keep a pending
// request dormant, or preserve every member of a multiple result.
model SelectionResolution{
    me SelectionResolutionState: resolutionState <- srsNone
    me List<our SelectionRequest>: requests
    me List<our SelectionReference>: references
}
struct SelectionResolution{}

// `item.asTList` is a reversible view operation, not necessarily a merge.
// The source item and its temporal view remain distinct endpoints so inverse
// reasoning can recover either one. When the source is already a T-list the
// optional identityRelation records that the projection is the same span.
model TemporalProjectionReference{
    me uint64: referenceID <- 0
    our POV: sourcePOV
    our POV: projectionPOV
    our IdentityRelation: identityRelation
    // Boundaries derived from this stable projection are canonical views.
    our POV: beginBoundary
    our POV: endBoundary
}
struct TemporalProjectionReference{}

// `.cut` denotes one genuine, unresolved split of a temporal span.  It does
// not enumerate candidate structural items or choose a clock granularity.
// Instead, the split retains two lazy temporal witnesses and the three
// identities implied by their concatenation:
//
//     source.begin = prefix.begin
//     prefix.end   = suffix.begin
//     suffix.end   = source.end
//
// symbolicCut is prefix.end.  The middle identity makes the same cut
// reachable from either side, so a later theorem may resolve it by adding an
// identity to a more specific boundary without bypassing this representation.
model TemporalSplitReference{
    our POV: requestPOV  // Optional syntax occurrence: replay reuses this cut.
    me uint64: referenceID <- 0
    me uint64: normalizationID <- 0
    our POV: sourceSpan
    our POV: prefixSpan
    our POV: suffixSpan
    our POV: sourceBegin
    our POV: prefixBegin
    our POV: symbolicCut
    our POV: suffixBegin
    our POV: suffixEnd
    our POV: sourceEnd
    our IdentityRelation: beginIdentityRelation
    our IdentityRelation: cutIdentityRelation
    our IdentityRelation: endIdentityRelation
    // Resolution accumulates identity-backed names for the same cut.  A
    // galaxy begin is useful evidence without preventing a later theorem from
    // adding a concrete coordinate in the containing World span.
    me List<our POV>: resolutionBoundaries
    me List<our IdentityRelation>: resolutionIdentityRelations
    // A plain `.cut` is inside the span rather than one of its endpoints.
    // This condition is kept once per symbolic split; it does not materialize
    // or count either witness span.
    flag: strictInterior <- true
}
struct TemporalSplitReference{}

// One proved alignment between an exact child occurrence and a containing
// parent T-span.  The reference adds no substitute placement value: the
// boundary IdentityRelation is the semantic evidence, while these retained
// endpoints make the occurrence and the inverse parent/child traversal
// discoverable without re-evaluating the child's generic definition.
model TemporalRootingReference{
    me uint64: referenceID <- 0
    me uint64: normalizationID <- 0
    our POV: childOccurrencePOV
    our TemporalProjectionReference: childProjection
    our POV: childBoundary
    our TemporalSplitReference: parentSplit
    our POV: parentSpanPOV
    our POV: parentBoundary
    our IdentityRelation: boundaryIdentityRelation
}
struct TemporalRootingReference{}

// One external association asserted with `^`.  The anchor and value remain
// distinct occurrences; this record is the reversible relational fact that
// lets either endpoint recover the association without pretending they are
// identical.  witnessPOV is optional now and leaves room for a containing
// super-system (for example a marriage) when general `^` inference grows.
model ExternalAssociationReference{
    me uint64: referenceID <- 0
    me uint64: normalizationID <- 0
    me string: relationTypeID
    our POV: anchorPOV
    our POV: predicatePOV
    our POV: valuePOV
    our POV: witnessPOV
}
struct ExternalAssociationReference{}

// One logical member of a repetition.  occurrenceToken is opaque and stable;
// ordinal is optional knowledge about that occurrence, not its identity.
model RepetitionOccurrence{
    me uint64: occurrenceToken <- 0
    flag: ordinalKnown
    me int64: ordinal <- -1
    their RepetitionFamily: family
    our POV: referencePOV
    our POV: materializedPOV
}
struct RepetitionOccurrence{}

// A split sparse span keeps this family and changes only the local coordinate
// range represented by each resulting span POV.
model RepetitionFamily{
    me uint64: repetitionID <- 0
    their IdentityRegistry: registry
    their POV: originalSpanPOV
    me List<our RepetitionOccurrence>: occurrences
    // Only demanded, ordinal-known occurrences are indexed.  Repetition size
    // never determines registry size.
    me Map<me int64, our RepetitionOccurrence>: ordinalOccurrences
}
struct RepetitionFamily{}

// One registry belongs to one Agent/semantic universe.  Direct unit-level POV
// use may bind an explicitly constructed registry with the same contract.
// Optional occurrence names. Token identity is scoped by allocation, not by
// its printed integer. Independent imports retain a consistent remapping.
struct InfonIdentity { me uint64: id <- 0 }
struct InfonIdentityScope {
    me uint64: nextID <- 1
    me Map<me uint64, our InfonIdentity>: identities
    me Map<our InfonIdentity, our InfonIdentity>: imports
    me Mutex: scopeMutex
    our InfonIdentity: claim(me uint64: id) <- <%{
        std::lock_guard<std::mutex> lock(scopeMutex);
        if (!id || id>INT64_MAX) throw std::invalid_argument("identity ID must be positive int64");
        auto& token=identities[id];
        if(!token) {token=std::make_shared<InfonIdentity>();token->id=id;}
        nextID=std::max(nextID,id+1);
        return token;
    }%>
    our InfonIdentity: freshIdentity() <- <%{
        std::lock_guard<std::mutex> lock(scopeMutex);
        if(nextID>INT64_MAX) throw std::overflow_error("identity ID space exhausted");
        auto token=std::make_shared<InfonIdentity>();token->id=nextID++;
        identities.emplace(token->id,token);return token;
    }%>
    our InfonIdentity: importIdentity(our InfonIdentity: source) <- <%{
        if(!source) return {};
        std::lock_guard<std::mutex> lock(scopeMutex);
        auto local=identities.find(source->id);
        if(local!=identities.end() && local->second==source) return source;
        auto prior=imports.find(source);
        if(prior!=imports.end()) return prior->second;
        if(!source->id || source->id>INT64_MAX) throw std::invalid_argument("invalid imported identity ID");
        if(nextID>INT64_MAX) throw std::overflow_error("identity ID space exhausted");
        auto token=std::make_shared<InfonIdentity>();token->id=nextID++;
        identities.emplace(token->id,token);imports.emplace(source,token);return token;
    }%>
}
struct BoundaryReference {
    our POV: source
    our POV: begin
    our POV: end
}
model IdentityRegistry{
    me InfonIdentityScope: occurrenceScope
    me Map<our POV, our BoundaryReference>: boundaries
    me uint64: nextEvidenceID <- 1
    me uint64: nextReferenceID <- 1
    me uint64: nextRepetitionID <- 1
    me uint64: nextOccurrenceToken <- 1
    me List<our IdentityRelation>: identities
    me List<our EndRelativeReference>: endRelativeReferences
    me List<our SelectionRequest>: selectionRequests
    me List<our SelectionReference>: selectionReferences
    me List<our TemporalProjectionReference>: temporalProjectionReferences
    me List<our TemporalSplitReference>: temporalSplitReferences
    me List<our TemporalRootingReference>: temporalRootingReferences
    me List<our ExternalAssociationReference>: externalAssociationReferences
    me List<our RepetitionFamily>: repetitionFamilies
    me Mutex: registryMutex
}
struct IdentityRegistry{
    our ExternalAssociationReference: recordExternalAssociation(
            our POV: anchorPOV, our POV: predicatePOV,
            our POV: valuePOV, our POV: witnessPOV,
            me string: relationTypeID,
            me uint64: normalizationID) <- {
        if(anchorPOV==NULL or predicatePOV==NULL or valuePOV==NULL or
                relationTypeID==""){return(NULL)}
        protect(registryMutex){
            withEach existing in externalAssociationReferences{
                if(existing!.anchorPOV===anchorPOV and
                        existing!.relationTypeID==relationTypeID and
                        existing!.valuePOV===valuePOV and
                        existing!.witnessPOV===witnessPOV){
                    return(existing)
                }
            }
            our ExternalAssociationReference:: reference
            reference!.referenceID <- nextReferenceID
            nextReferenceID <+- 1
            reference!.normalizationID <- normalizationID
            reference!.relationTypeID <- relationTypeID
            reference!.anchorPOV <- anchorPOV
            reference!.predicatePOV <- predicatePOV
            reference!.valuePOV <- valuePOV
            reference!.witnessPOV <- witnessPOV
            externalAssociationReferences.append(reference)
            anchorPOV!.bindIdentityRegistry(self)
            predicatePOV!.bindIdentityRegistry(self)
            valuePOV!.bindIdentityRegistry(self)
            if(witnessPOV!=NULL){witnessPOV!.bindIdentityRegistry(self)}
            return(reference)
        }
    }

    // Lookups take a snapshot before following identity edges because
    // areIdentical() owns the same registry lock. Equal descriptions are not
    // enough: an association belongs to an exact occurrence or one of its
    // explicitly established aliases.
    void: collectExternalAssociationsForAnchor(our POV: anchorPOV,
            me string: relationTypeID,
            their List<our ExternalAssociationReference>: results) <- {
        if(anchorPOV==NULL or relationTypeID==""){return()}
        our POV: semanticAnchorPOV <- anchorPOV
        if(anchorPOV!.referenceAlias.sourcePov!=NULL){
            semanticAnchorPOV <- anchorPOV!.referenceAlias.sourcePov
        }
        me List<our ExternalAssociationReference>: snapshot
        me List<our POV>: anchors
        anchors.append(anchorPOV)
        if(semanticAnchorPOV!==anchorPOV){anchors.append(semanticAnchorPOV)}
        protect(registryMutex){
            withEach reference in externalAssociationReferences{
                if(reference!.relationTypeID==relationTypeID){snapshot.append(reference)}
            }
            // A later read can wrap the same stored view in another POV.
            // Include that view's explicit alias endpoints in this lookup;
            // shared storage alone does not change general POV identity.
            withEach identity in identities{
                if(identity!.leftPOV!.pItem!=NULL and (identity!.leftPOV!.pItem===anchorPOV!.pItem or identity!.leftPOV!.pItem===semanticAnchorPOV!.pItem)){anchors.append(identity!.leftPOV)}
                if(identity!.rightPOV!.pItem!=NULL and (identity!.rightPOV!.pItem===anchorPOV!.pItem or identity!.rightPOV!.pItem===semanticAnchorPOV!.pItem)){anchors.append(identity!.rightPOV)}
            }
        }
        withEach reference in snapshot{
            withEach anchor in anchors{
                if(reference!.anchorPOV===anchor or (reference!.anchorPOV!.pItem!=NULL and reference!.anchorPOV!.pItem===anchor!.pItem) or
                   areIdentical(reference!.anchorPOV, anchor)){
                    results.append(reference); break()
                }
            }
        }
    }

    void: collectExternalAssociationsForRelation(
            me string: relationTypeID,
            their List<our ExternalAssociationReference>: results) <- {
        if(relationTypeID==""){return()}
        protect(registryMutex){
            withEach reference in externalAssociationReferences{
                if(reference!.relationTypeID==relationTypeID){
                    results.append(reference)
                }
            }
        }
    }

    our TemporalProjectionReference: findTemporalProjectionForSource(
            their POV: sourcePOV) <- {
        if(sourcePOV==NULL){return(NULL)}
        protect(registryMutex){
            withEach reference in temporalProjectionReferences{
                if(reference!.sourcePOV===sourcePOV or
                        (sourcePOV!.temporalProjection.reference===reference and
                         !sourcePOV!.temporalProjection.isProjection)){
                    return(reference)
                }
            }
        }
        return(NULL)
    }

    our TemporalProjectionReference: findTemporalProjectionForView(
            their POV: projectionPOV) <- {
        if(projectionPOV==NULL){return(NULL)}
        protect(registryMutex){
            withEach reference in temporalProjectionReferences{
                if(reference!.projectionPOV===projectionPOV or
                        (projectionPOV!.temporalProjection.reference===reference and
                         projectionPOV!.temporalProjection.isProjection)){
                    return(reference)
                }
            }
        }
        return(NULL)
    }

    our TemporalProjectionReference: recordTemporalProjection(
            our POV: sourcePOV, our POV: projectionPOV) <- {
        if(sourcePOV==NULL or projectionPOV==NULL){return(NULL)}
        protect(registryMutex){
            withEach existing in temporalProjectionReferences{
                if(existing!.sourcePOV===sourcePOV){return(existing)}
            }
            our TemporalProjectionReference:: reference
            reference!.referenceID <- nextReferenceID
            nextReferenceID <+- 1
            reference!.sourcePOV <- sourcePOV
            reference!.projectionPOV <- projectionPOV
            temporalProjectionReferences.append(reference)
            sourcePOV!.identityRegistry <- self
            sourcePOV!.temporalProjection.reference <- reference
            sourcePOV!.temporalProjection.isProjection <- false
            projectionPOV!.identityRegistry <- self
            projectionPOV!.temporalProjection.reference <- reference
            projectionPOV!.temporalProjection.isProjection <- true
            return(reference)
        }
    }

    // Every invocation records a new existential cut, even when two cuts are
    // requested from the same source span.  Equal-valued descriptions must
    // not accidentally identify independent possible instants.
    our TemporalSplitReference: recordTemporalSplit(
            our POV: sourceSpan,
            our POV: prefixSpan, our POV: suffixSpan,
            our POV: sourceBegin, our POV: prefixBegin,
            our POV: symbolicCut, our POV: suffixBegin,
            our POV: suffixEnd, our POV: sourceEnd,
            me uint64: normalizationID) <- {
        if(sourceSpan==NULL or prefixSpan==NULL or suffixSpan==NULL or
                sourceBegin==NULL or prefixBegin==NULL or
                symbolicCut==NULL or suffixBegin==NULL or
                suffixEnd==NULL or sourceEnd==NULL){return(NULL)}
        our TemporalSplitReference:: reference
        protect(registryMutex){
            reference!.referenceID <- nextReferenceID
            nextReferenceID <+- 1
            reference!.normalizationID <- normalizationID
            reference!.strictInterior <- true
            reference!.sourceSpan <- sourceSpan
            reference!.prefixSpan <- prefixSpan
            reference!.suffixSpan <- suffixSpan
            reference!.sourceBegin <- sourceBegin
            reference!.prefixBegin <- prefixBegin
            reference!.symbolicCut <- symbolicCut
            reference!.suffixBegin <- suffixBegin
            reference!.suffixEnd <- suffixEnd
            reference!.sourceEnd <- sourceEnd
        }
        reference!.beginIdentityRelation <- recordIdentity(
                sourceBegin, prefixBegin,
                iekTemporalSplit, normalizationID)
        reference!.cutIdentityRelation <- recordIdentity(
                symbolicCut, suffixBegin,
                iekTemporalSplit, normalizationID)
        reference!.endIdentityRelation <- recordIdentity(
                suffixEnd, sourceEnd,
                iekTemporalSplit, normalizationID)
        sourceSpan!.identityRegistry <- self
        prefixSpan!.identityRegistry <- self
        suffixSpan!.identityRegistry <- self
        symbolicCut!.identityRegistry <- self
        symbolicCut!.temporalSplit.reference <- reference
        // Publish only after all implied identities and the cut backlink are
        // complete; registry readers must never observe a half-built split.
        protect(registryMutex){
            temporalSplitReferences.append(reference)
        }
        return(reference)
    }

    our TemporalRootingReference: recordTemporalRooting(
            their TemporalProjectionReference: childProjection,
            our POV: childBoundary,
            their TemporalSplitReference: parentSplit,
            our POV: parentBoundary,
            our IdentityRelation: boundaryIdentityRelation,
            me uint64: normalizationID) <- {
        if(childProjection==NULL or
                childProjection!.sourcePOV==NULL or
                childProjection!.projectionPOV==NULL or
                childBoundary==NULL or parentSplit==NULL or
                parentSplit!.sourceSpan==NULL or parentBoundary==NULL or
                boundaryIdentityRelation==NULL){return(NULL)}
        me bool: directBoundaryIdentity <-
                (boundaryIdentityRelation!.leftPOV===childBoundary and
                 boundaryIdentityRelation!.rightPOV===parentBoundary) or
                (boundaryIdentityRelation!.leftPOV===parentBoundary and
                 boundaryIdentityRelation!.rightPOV===childBoundary)
        if(!directBoundaryIdentity){return(NULL)}
        protect(registryMutex){
            our TemporalProjectionReference: retainedChildProjection
            withEach candidate in temporalProjectionReferences{
                if(candidate===childProjection){
                    retainedChildProjection <- candidate
                    break()
                }
            }
            our TemporalSplitReference: retainedParentSplit
            withEach candidate in temporalSplitReferences{
                if(candidate===parentSplit){
                    retainedParentSplit <- candidate
                    break()
                }
            }
            if(retainedChildProjection==NULL or retainedParentSplit==NULL){
                return(NULL)
            }
            withEach existing in temporalRootingReferences{
                if(existing!.childOccurrencePOV===
                            childProjection!.sourcePOV and
                        existing!.childBoundary===childBoundary and
                        existing!.parentSplit===parentSplit and
                        existing!.parentBoundary===parentBoundary){
                    return(existing)
                }
            }
            our TemporalRootingReference:: reference
            reference!.referenceID <- nextReferenceID
            nextReferenceID <+- 1
            reference!.normalizationID <- normalizationID
            reference!.childOccurrencePOV <- childProjection!.sourcePOV
            reference!.childProjection <- retainedChildProjection
            reference!.childBoundary <- childBoundary
            reference!.parentSplit <- retainedParentSplit
            reference!.parentSpanPOV <- parentSplit!.sourceSpan
            reference!.parentBoundary <- parentBoundary
            reference!.boundaryIdentityRelation <- boundaryIdentityRelation
            temporalRootingReferences.append(reference)
            return(reference)
        }
    }

    void: collectTemporalRootingsForChild(
            their POV: childOccurrencePOV,
            their List<our TemporalRootingReference>: results) <- {
        if(childOccurrencePOV==NULL){return()}
        protect(registryMutex){
            withEach reference in temporalRootingReferences{
                if(reference!.childOccurrencePOV===childOccurrencePOV){
                    results.append(reference)
                }
            }
        }
    }

    // Parent-boundary lookup follows identity edges so callers may start from
    // either the canonical split cut or any asserted alias of that cut.
    void: collectTemporalRootingsForParentBoundary(
            our POV: parentBoundary,
            their List<our TemporalRootingReference>: results) <- {
        if(parentBoundary==NULL){return()}
        me List<our TemporalRootingReference>: snapshot
        protect(registryMutex){
            withEach reference in temporalRootingReferences{
                snapshot.append(reference)
            }
        }
        withEach reference in snapshot{
            if(areIdentical(reference!.parentBoundary, parentBoundary)){
                results.append(reference)
            }
        }
    }

    our EndRelativeReference: findEndRelativeReference(
            their POV: sourcePOV, their infonView: sourceInfon,
            me int64: offset) <- {
        if(sourcePOV==NULL or sourceInfon==NULL or offset>=0){return(NULL)}
        protect(registryMutex){
            withEach reference in endRelativeReferences{
                if(!reference!.retired and
                        reference!.sourcePOV===sourcePOV and
                        reference!.sourceInfon===sourceInfon and
                        reference!.offset==offset){return(reference)}
            }
        }
        return(NULL)
    }

    our EndRelativeReference: getOrCreateEndRelativeReference(
            their POV: sourcePOV, me int64: offset) <- {
        if(sourcePOV==NULL or sourcePOV!.pItem==NULL or offset>=0){
            return(NULL)
        }
        our EndRelativeReference: existing <- findEndRelativeReference(
                sourcePOV, sourcePOV!.pItem, offset)
        if(existing!=NULL){return(existing)}
        protect(registryMutex){
            // Recheck under the write lock in case another parser/normalizer
            // registered the same logical reference concurrently.
            withEach reference in endRelativeReferences{
                if(!reference!.retired and
                        reference!.sourcePOV===sourcePOV and
                        reference!.sourceInfon===sourcePOV!.pItem and
                        reference!.offset==offset){return(reference)}
            }

            our POV:: virtualItem{povSrcEndRelativeReference}
            Allocate(virtualItem!.pItem)
            virtualItem!.pItem!.itmMode <- mItem
            virtualItem!.pItem!.viewMode <- vmAny
            virtualItem!.pItem!.infSize!.evalMode <- emUnknown
            virtualItem!.pItem!.value!.overlayType <- tUnknown
            virtualItem!.pItem!.value!.evalMode <- emUnknown
            virtualItem!.identityRegistry <- self
            virtualItem!.endRelativeReference <- true
            virtualItem!.endRelativeOffset <- offset

            our EndRelativeReference:: reference
            reference!.referenceID <- nextReferenceID
            nextReferenceID <+- 1
            reference!.sourcePOV <- sourcePOV
            reference!.sourceInfon <- sourcePOV!.pItem
            reference!.offset <- offset
            reference!.referencePOV <- virtualItem
            endRelativeReferences.append(reference)
            sourcePOV!.pItem!.referenceRegistry <- self
            return(reference)
        }
    }

    void: collectEndRelativeReferences(their infonView: sourceInfon,
            their List<our EndRelativeReference>: results) <- {
        if(sourceInfon==NULL){return()}
        protect(registryMutex){
            withEach reference in endRelativeReferences{
                if(!reference!.retired and
                        reference!.sourceInfon===sourceInfon){
                    results.append(reference)
                }
            }
        }
    }

    void: retireEndRelativeReferences(their infonView: sourceInfon) <- {
        if(sourceInfon==NULL){return()}
        protect(registryMutex){
            withEach reference in endRelativeReferences{
                if(reference!.sourceInfon===sourceInfon){
                    reference!.retired <- true
                }
            }
        }
    }

    our SelectionRequest: findSelectionRequest(me uint64: requestID) <- {
        if(requestID==0){return(NULL)}
        protect(registryMutex){
            withEach request in selectionRequests{
                if(request!.requestID==requestID){return(request)}
            }
        }
        return(NULL)
    }

    our SelectionRequest: getOrCreateSelectionRequest(
            our POV: queryPOV, our POV: consumerResultPOV,
            our POV: sourceContextPOV,
            me SelectionReferenceKind: referenceKind,
            me uint64: normalizationID) <- {
        if(queryPOV==NULL or sourceContextPOV==NULL){return(NULL)}
        protect(registryMutex){
            withEach request in selectionRequests{
                if(request!.referenceKind==referenceKind and
                        request!.normalizationID==normalizationID and
                        request!.queryPOV===queryPOV and
                        request!.consumerResultPOV===consumerResultPOV and
                        request!.sourceContextPOV===sourceContextPOV){
                    return(request)
                }
            }
            our SelectionRequest:: request
            request!.requestID <- nextReferenceID
            nextReferenceID <+- 1
            request!.registry <- self
            request!.referenceKind <- referenceKind
            request!.normalizationID <- normalizationID
            request!.queryPOV <- queryPOV
            request!.consumerResultPOV <- consumerResultPOV
            request!.sourceContextPOV <- sourceContextPOV
            request!.resolutionState <- srsPending
            selectionRequests.append(request)
            return(request)
        }
    }

    our SelectionReference: recordSelectionReferenceForRequest(
            our SelectionRequest: request, our POV: resultPOV,
            our POV: sourceStartPOV) <- {
        if(request==NULL or resultPOV==NULL or
                request!.registry!==self or
                request!.sourceContextPOV==NULL or
                sourceStartPOV==NULL){return(NULL)}
        protect(registryMutex){
            withEach reference in selectionReferences{
                if(reference!.requestID==request!.requestID and
                        reference!.resultPOV===resultPOV and
                        reference!.sourceStartPOV===sourceStartPOV){
                    return(reference)
                }
            }
            our SelectionReference:: reference
            reference!.referenceID <- nextReferenceID
            nextReferenceID <+- 1
            reference!.requestID <- request!.requestID
            reference!.occurrenceToken <- nextOccurrenceToken
            nextOccurrenceToken <+- 1
            reference!.referenceKind <- request!.referenceKind
            reference!.normalizationID <- request!.normalizationID
            reference!.queryPOV <- request!.queryPOV
            reference!.resultPOV <- resultPOV
            reference!.sourceContextPOV <- request!.sourceContextPOV
            reference!.sourceStartPOV <- sourceStartPOV
            reference!.repetitionOccurrence <-
                    sourceStartPOV!.repetitionOccurrence
            selectionReferences.append(reference)
            if(request!.resolutionState==srsPending){
                request!.resolutionState <- srsUnique
            }else{
                request!.resolutionState <- srsMultiple
            }
            return(reference)
        }
    }

    our SelectionReference: recordSelectionReference(
            our POV: queryPOV, our POV: resultPOV,
            our POV: sourceContextPOV, our POV: sourceStartPOV,
            me SelectionReferenceKind: referenceKind,
            me uint64: normalizationID) <- {
        if(queryPOV==NULL or resultPOV==NULL or
                sourceContextPOV==NULL or sourceStartPOV==NULL){return(NULL)}
        our SelectionRequest: request <- getOrCreateSelectionRequest(
                queryPOV, NULL, sourceContextPOV,
                referenceKind, normalizationID)
        return(recordSelectionReferenceForRequest(
                request, resultPOV, sourceStartPOV))
    }

    our SelectionResolution: resolveSelectionRequest(
            me uint64: requestID) <- {
        our SelectionResolution:: resolution
        our SelectionRequest: request <- findSelectionRequest(requestID)
        if(request==NULL){return(resolution)}
        resolution!.requests.append(request)
        protect(registryMutex){
            withEach reference in selectionReferences{
                if(reference!.requestID==requestID){
                    resolution!.references.append(reference)
                }
            }
        }
        resolution!.resolutionState <- request!.resolutionState
        return(resolution)
    }

    // A one-item positional selector has a reversible source endpoint, not a
    // copied span.  Return that occurrence only when the recorded request is
    // unambiguously the single-item form.  Range selections remain mapped
    // views because their sourceStartPOV names only the first member.
    our POV: resolveSingleSelectedOccurrence(me uint64: requestID) <- {
        our SelectionRequest: request <- findSelectionRequest(requestID)
        if(request==NULL or
                request!.referenceKind!=srkPositionalSelection or
                request!.selectorSpec!=NULL){return(NULL)}
        our SelectionResolution: resolution <-
                resolveSelectionRequest(requestID)
        if(resolution==NULL or
                resolution!.resolutionState!=srsUnique or
                resolution!.references.size()!=1){return(NULL)}
        return(resolution!.references.first()!.sourceStartPOV)
    }

    our SelectionResolution: resolveSelectionForQuery(
            their POV: queryPOV,
            me SelectionReferenceKind: referenceKind) <- {
        our SelectionResolution:: resolution
        if(queryPOV==NULL){return(resolution)}
        protect(registryMutex){
            withEach request in selectionRequests{
                if(request!.queryPOV===queryPOV and
                        request!.referenceKind==referenceKind){
                    resolution!.requests.append(request)
                }
            }
            withEach reference in selectionReferences{
                if(reference!.queryPOV===queryPOV and
                        reference!.referenceKind==referenceKind){
                    resolution!.references.append(reference)
                }
            }
        }
        if(resolution!.references.isEmpty()){
            if(!resolution!.requests.isEmpty()){
                resolution!.resolutionState <- srsPending
            }
            return(resolution)
        }
        resolution!.resolutionState <- srsUnique
        our SelectionReference: first <- resolution!.references.first()
        withEach reference in resolution!.references{
            if(reference!.resultPOV!==first!.resultPOV or
                    reference!.sourceContextPOV!==first!.sourceContextPOV or
                    reference!.sourceStartPOV!==first!.sourceStartPOV){
                resolution!.resolutionState <- srsMultiple
                break()
            }
        }
        return(resolution)
    }

    our SelectionResolution: resolveSelectionForResult(
            their POV: resultPOV) <- {
        our SelectionResolution:: resolution
        if(resultPOV==NULL){return(resolution)}
        protect(registryMutex){
            withEach request in selectionRequests{
                if(request!.consumerResultPOV===resultPOV){
                    resolution!.requests.append(request)
                }
            }
            withEach reference in selectionReferences{
                if(reference!.resultPOV===resultPOV){
                    resolution!.references.append(reference)
                }
            }
        }
        if(resolution!.references.isEmpty()){
            if(!resolution!.requests.isEmpty()){
                resolution!.resolutionState <- srsPending
            }
            return(resolution)
        }
        resolution!.resolutionState <- srsUnique
        our SelectionReference: first <- resolution!.references.first()
        withEach reference in resolution!.references{
            if(reference!.sourceContextPOV!==first!.sourceContextPOV or
                    reference!.sourceStartPOV!==first!.sourceStartPOV){
                resolution!.resolutionState <- srsMultiple
                break()
            }
        }
        return(resolution)
    }

    our SelectionResolution: resolveSelectionForSource(
            their POV: sourceContextPOV,
            their POV: sourceStartPOV) <- {
        our SelectionResolution:: resolution
        if(sourceContextPOV==NULL or sourceStartPOV==NULL){
            return(resolution)
        }
        protect(registryMutex){
            withEach reference in selectionReferences{
                if(reference!.sourceContextPOV===sourceContextPOV and
                        reference!.sourceStartPOV===sourceStartPOV){
                    resolution!.references.append(reference)
                }
            }
        }
        if(resolution!.references.isEmpty()){return(resolution)}
        resolution!.resolutionState <- srsUnique
        our SelectionReference: first <- resolution!.references.first()
        withEach reference in resolution!.references{
            if(reference!.queryPOV!==first!.queryPOV or
                    reference!.resultPOV!==first!.resultPOV){
                resolution!.resolutionState <- srsMultiple
                break()
            }
        }
        return(resolution)
    }

    void: collectSelectionReferencesForQuery(their POV: queryPOV,
            their List<our SelectionReference>: results) <- {
        if(queryPOV==NULL){return()}
        protect(registryMutex){
            withEach reference in selectionReferences{
                if(reference!.queryPOV===queryPOV){results.append(reference)}
            }
        }
    }

    void: collectSelectionReferencesForResult(their POV: resultPOV,
            their List<our SelectionReference>: results) <- {
        if(resultPOV==NULL){return()}
        protect(registryMutex){
            withEach reference in selectionReferences{
                if(reference!.resultPOV===resultPOV){results.append(reference)}
            }
        }
    }

    // Reverse lookup is by exact source POV, not an index. This distinguishes
    // repeated or description-matched occurrences even when their infons have
    // identical values.
    void: collectSelectionReferencesForSource(
            their POV: sourceContextPOV, their POV: sourceStartPOV,
            their List<our SelectionReference>: results) <- {
        if(sourceContextPOV==NULL or sourceStartPOV==NULL){return()}
        protect(registryMutex){
            withEach reference in selectionReferences{
                if(reference!.sourceContextPOV===sourceContextPOV and
                        reference!.sourceStartPOV===sourceStartPOV){
                    results.append(reference)
                }
            }
        }
    }

    our RepetitionFamily: getOrCreateRepetitionFamily(their POV: sourcePOV) <- {
        if(sourcePOV==NULL){return(NULL)}
        protect(registryMutex){
            if(sourcePOV!.repetitionSpan.family!=NULL){
                return(sourcePOV!.repetitionSpan.family)
            }
            our RepetitionFamily:: family
            family!.repetitionID <- nextRepetitionID
            nextRepetitionID <+- 1
            family!.registry <- self
            family!.originalSpanPOV <- sourcePOV
            repetitionFamilies.append(family)
            sourcePOV!.identityRegistry <- self
            sourcePOV!.repetitionSpan.family <- family
            sourcePOV!.repetitionSpan.startOrdinal <- 0
            return(family)
        }
    }

    our RepetitionOccurrence: findOrdinalOccurrence(
            their RepetitionFamily: family, me int64: ordinal) <- {
        if(family==NULL or ordinal<0){return(NULL)}
        protect(registryMutex){
            if(family!.ordinalOccurrences.containsKey(ordinal)){
                return(family!.ordinalOccurrences[ordinal])
            }
        }
        return(NULL)
    }

    our POV: findIndexedRepetitionOccurrence(
            their POV: sourcePOV, me int64: sourceIndex) <- {
        if(sourcePOV==NULL or sourceIndex<0 or
                sourcePOV!.repetitionSpan.family==NULL){return(NULL)}
        me int64: ordinal <- sourcePOV!.repetitionSpan.startOrdinal + sourceIndex
        our RepetitionOccurrence: occurrence <- findOrdinalOccurrence(
                sourcePOV!.repetitionSpan.family, ordinal)
        if(occurrence==NULL){return(NULL)}
        if(occurrence!.materializedPOV!=NULL){
            return(occurrence!.materializedPOV)
        }
        return(occurrence!.referencePOV)
    }

    // Return a concrete occurrence only through its recorded materialization
    // identity.  The occurrence table locates the candidates efficiently; it
    // does not replace the semantic evidence joining the two POVs.
    our POV: findIdentifiedMaterializedRepetitionOccurrence(
            their POV: sourcePOV, me int64: sourceIndex) <- {
        if(sourcePOV==NULL or sourceIndex<0 or
                sourcePOV!.repetitionSpan.family==NULL){return(NULL)}
        me int64: ordinal <-
                sourcePOV!.repetitionSpan.startOrdinal + sourceIndex
        our RepetitionOccurrence: occurrence <- findOrdinalOccurrence(
                sourcePOV!.repetitionSpan.family, ordinal)
        if(occurrence==NULL or occurrence!.referencePOV==NULL or
                occurrence!.materializedPOV==NULL){return(NULL)}
        if(!areIdentical(occurrence!.referencePOV,
                occurrence!.materializedPOV)){return(NULL)}
        return(occurrence!.materializedPOV)
    }

    our POV: getOrCreateIndexedRepetitionOccurrence(
            their POV: sourcePOV, me int64: sourceIndex) <- {
        // A repetition can retain published prefix members. Callers prove
        // which positions are virtual; the registry owns their stable identity.
        if(sourcePOV==NULL or sourcePOV!.pItem==NULL or sourceIndex<0){return(NULL)}
        our infonView: source <- sourcePOV!.pItem
        if(source!.value!.overlayType!=LST or source!.value!.evalMode!=emLiteral or
                !source!.value!.tailUnfinished or source!.value!.listSpec==NULL or
                source!.infSize!.overlayType!=NUM or source!.infSize!.evalMode!=emLiteral or
                source!.infSize!.num<0 or sourceIndex>=source!.infSize!.num){return(NULL)}
        our RepetitionFamily: family <- getOrCreateRepetitionFamily(sourcePOV)
        if(family==NULL){return(NULL)}
        me int64: ordinal <- sourcePOV!.repetitionSpan.startOrdinal + sourceIndex
        protect(registryMutex){
            if(family!.ordinalOccurrences.containsKey(ordinal)){
                our RepetitionOccurrence: occurrence <-
                        family!.ordinalOccurrences[ordinal]
                if(occurrence!.materializedPOV!=NULL){
                    return(occurrence!.materializedPOV)
                }
                occurrence!.referencePOV!.implicitItem.sourcePov <- sourcePOV
                occurrence!.referencePOV!.implicitItem.sourceIndex <- sourceIndex
                return(occurrence!.referencePOV)
            }

            our POV:: occurrencePOV{povSrcImplicitItem}
            occurrencePOV!.pItem <-
                    sourcePOV!.makeSparseSpanMemberTypeOnlyInfonView()
            occurrencePOV!.identityRegistry <- self
            occurrencePOV!.implicitItem.sourcePov <- sourcePOV
            occurrencePOV!.implicitItem.sourceIndex <- sourceIndex

            our RepetitionOccurrence:: occurrence
            occurrence!.occurrenceToken <- nextOccurrenceToken
            nextOccurrenceToken <+- 1
            occurrence!.ordinalKnown <- true
            occurrence!.ordinal <- ordinal
            occurrence!.family <- family
            occurrence!.referencePOV <- occurrencePOV
            occurrencePOV!.repetitionOccurrence <- occurrence
            family!.occurrences.append(occurrence)
            family!.ordinalOccurrences[ordinal] <- occurrence
            return(occurrencePOV)
        }
    }

    // Unknown repetition cardinality does not justify inventing an ordinal.
    // Allocate only the logical occurrences actually demanded by matching;
    // each can acquire an ordinal later without changing its token or POV.
    our RepetitionOccurrence: createUnknownOrdinalRepetitionOccurrence(
            their POV: sourcePOV) <- {
        if(sourcePOV==NULL or sourcePOV!.pItem==NULL or
                sourcePOV!.pItem!.value!.overlayType!=LST or
                sourcePOV!.pItem!.value!.listSpec==NULL){
            return(NULL)
        }
        our RepetitionFamily: family <- getOrCreateRepetitionFamily(sourcePOV)
        if(family==NULL){return(NULL)}
        protect(registryMutex){
            our POV:: occurrencePOV{povSrcImplicitItem}
            occurrencePOV!.pItem <-
                    sourcePOV!.makeSparseSpanMemberTypeOnlyInfonView()
            occurrencePOV!.identityRegistry <- self

            our RepetitionOccurrence:: occurrence
            occurrence!.occurrenceToken <- nextOccurrenceToken
            nextOccurrenceToken <+- 1
            occurrence!.ordinalKnown <- false
            occurrence!.ordinal <- -1
            occurrence!.family <- family
            occurrence!.referencePOV <- occurrencePOV
            occurrencePOV!.repetitionOccurrence <- occurrence
            family!.occurrences.append(occurrence)
            return(occurrence)
        }
    }

    me bool: bindRepetitionOccurrenceOrdinal(
            our RepetitionOccurrence: occurrence, me int64: ordinal) <- {
        if(occurrence==NULL or occurrence!.family==NULL or ordinal<0){
            return(false)
        }
        protect(registryMutex){
            if(occurrence!.ordinalKnown){return(occurrence!.ordinal==ordinal)}
            if(occurrence!.family!.ordinalOccurrences.containsKey(ordinal)){
                return(occurrence!.family!.ordinalOccurrences[ordinal]===
                        occurrence)
            }
            occurrence!.ordinalKnown <- true
            occurrence!.ordinal <- ordinal
            occurrence!.family!.ordinalOccurrences[ordinal] <- occurrence
            their POV: sourcePOV <- occurrence!.family!.originalSpanPOV
            if(sourcePOV!=NULL and occurrence!.referencePOV!=NULL and
                    ordinal>=sourcePOV!.repetitionSpan.startOrdinal and
                    ordinal<sourcePOV!.repetitionSpan.startOrdinal +
                            sourcePOV!.sparseSpanCount()){
                occurrence!.referencePOV!.implicitItem.sourcePov <- sourcePOV
                occurrence!.referencePOV!.implicitItem.sourceIndex <-
                        ordinal - sourcePOV!.repetitionSpan.startOrdinal
            }
            return(true)
        }
    }

    void: remapSplitRepetitionOccurrences(their POV: originalSpanPOV,
            our POV: remainderPOV, me int64: oldEndOrdinal) <- {
        if(originalSpanPOV==NULL or remainderPOV==NULL or
                originalSpanPOV!.repetitionSpan.family==NULL){return()}
        me int64: remainderStart <- remainderPOV!.repetitionSpan.startOrdinal
        protect(registryMutex){
            withEach occurrence in originalSpanPOV!.repetitionSpan.family!.
                    occurrences{
                if(occurrence!.materializedPOV==NULL and
                        occurrence!.ordinalKnown and
                        occurrence!.ordinal>=remainderStart and
                        occurrence!.ordinal<oldEndOrdinal){
                    occurrence!.referencePOV!.implicitItem.sourcePov <-
                            remainderPOV
                    occurrence!.referencePOV!.implicitItem.sourceIndex <-
                            occurrence!.ordinal - remainderStart
                }
            }
        }
    }

    void: remapExposedHeadRemainder(their POV: remainingSpanPOV,
            me int64: oldEndOrdinal) <- {
        if(remainingSpanPOV==NULL or
                remainingSpanPOV!.repetitionSpan.family==NULL){return()}
        me int64: remainingStart <-
                remainingSpanPOV!.repetitionSpan.startOrdinal
        protect(registryMutex){
            withEach occurrence in remainingSpanPOV!.repetitionSpan.family!.
                    occurrences{
                if(occurrence!.materializedPOV==NULL and
                        occurrence!.ordinalKnown and
                        occurrence!.ordinal>=remainingStart and
                        occurrence!.ordinal<oldEndOrdinal){
                    occurrence!.referencePOV!.implicitItem.sourcePov <-
                            remainingSpanPOV
                    occurrence!.referencePOV!.implicitItem.sourceIndex <-
                            occurrence!.ordinal - remainingStart
                }
            }
        }
    }

    our IdentityRelation: recordIdentity(our POV: leftPOV,
            our POV: rightPOV, me IdentityEvidenceKind: evidenceKind,
            me uint64: normalizationID) <- {
        if(leftPOV==NULL or rightPOV==NULL or leftPOV===rightPOV){return(NULL)}
        protect(registryMutex){
            withEach identity in identities{
                if((identity!.leftPOV===leftPOV and
                        identity!.rightPOV===rightPOV) or
                   (identity!.leftPOV===rightPOV and
                        identity!.rightPOV===leftPOV)){
                    return(identity)
                }
            }
            our IdentityRelation:: identity
            identity!.evidenceID <- nextEvidenceID
            nextEvidenceID <+- 1
            identity!.evidenceKind <- evidenceKind
            identity!.normalizationID <- normalizationID
            identity!.leftPOV <- leftPOV
            identity!.rightPOV <- rightPOV
            identities.append(identity)
            return(identity)
        }
    }

    // Direct occurrence identity also includes a shared scoped name token.
    me bool: sameOccurrenceIdentity(our POV: firstPOV, our POV: secondPOV) <- {
        return(firstPOV===secondPOV or
            (firstPOV!=NULL and secondPOV!=NULL and
             firstPOV!.pItem!=NULL and secondPOV!.pItem!=NULL and
             firstPOV!.pItem!.identityName!=NULL and
             firstPOV!.pItem!.identityName===secondPOV!.pItem!.identityName))
    }
    me bool: areIdentical(our POV: firstPOV, our POV: secondPOV) <- {
        if(firstPOV==NULL or secondPOV==NULL){return(false)}
        if(sameOccurrenceIdentity(firstPOV, secondPOV)){return(true)}
        me List<our POV>: pending
        pending.append(firstPOV)
        me List<our POV>: visited
        protect(registryMutex){
            while(!pending.isEmpty()){
                our POV: current <- pending.popLast()
                me bool: seen <- false
                withEach previous in visited{
                    if(previous===current){seen <- true; break()}
                }
                if(seen){continue()}
                visited.append(current)
                withEach identity in identities{
                    our POV: neighbor
                    if(sameOccurrenceIdentity(identity!.leftPOV, current)){
                        neighbor <- identity!.rightPOV
                    }else if(sameOccurrenceIdentity(identity!.rightPOV, current)){
                        neighbor <- identity!.leftPOV
                    }
                    if(neighbor==NULL){continue()}
                    if(sameOccurrenceIdentity(neighbor, secondPOV)){return(true)}
                    pending.append(neighbor)
                }
            }
        }
        return(false)
    }

    void: recordRepetitionMaterialization(our POV: occurrenceReferencePOV,
            our POV: materializedPOV, me uint64: normalizationID) <- {
        if(occurrenceReferencePOV==NULL or materializedPOV==NULL or
                occurrenceReferencePOV!.repetitionOccurrence==NULL){return()}
        their RepetitionOccurrence: occurrence <-
                occurrenceReferencePOV!.repetitionOccurrence
        occurrence!.materializedPOV <- materializedPOV
        materializedPOV!.identityRegistry <- self
        materializedPOV!.repetitionOccurrence <- occurrence
        recordIdentity(occurrenceReferencePOV, materializedPOV,
                iekRepetitionMaterialization, normalizationID)
        occurrenceReferencePOV!.implicitItem.sourcePov <- NULL
        occurrenceReferencePOV!.implicitItem.sourceIndex <- -1
    }
}

// One bidirectional identity implied by temporal sequence composition:
//
//     endingSpan.end = beginningSpan.begin
//
// Store the boundary views, rather than only a cached predecessor pointer, so
// either direction of inference can use the same semantic evidence.  The span
// witnesses explain why the identity was enumerated and support navigation to
// the adjacent concrete occurrences.
model TemporalBoundaryIdentity{
    our POV: endingSpan
    our POV: beginningSpan
    our POV: endingBoundary
    our POV: beginningBoundary
    // IdentityRegistry owns the semantic equality.  This record retains the
    // adjacency witnesses needed to enumerate and navigate that equality.
    our IdentityRelation: identityRelation
}
struct TemporalBoundaryIdentity{}

// One whole-interval containment implication:
//
//     host.begin = contained.begin
//     host.end   = contained.end
//
// The spans remain distinct occurrences.  Only their boundary views are
// identical, so either direction can recover the same rooted relationship
// without merging a coarse unit with its finer component timeline.
model TemporalContainmentIdentity{
    our POV: hostSpan
    our POV: containedSpan
    our POV: hostBegin
    our POV: containedBegin
    our POV: hostEnd
    our POV: containedEnd
    our IdentityRelation: beginIdentityRelation
    our IdentityRelation: endIdentityRelation
}
struct TemporalContainmentIdentity{}


struct EndRelativeExtentResult{
    me EndRelativeExtentStatus: status <- eresUnknownOrUnbounded
    me int64: exactExtent <- 0
}

struct EndRelativeWindowAvailability{
    me EndRelativeWindowContentStatus: status <- erwcPending
    me EndRelativeExtentResult: extent
    me int64: startIndex <- -1
    me int64: itemCount <- 0
    our POV: firstSourcePOV
    our POV: lastSourcePOV
}


model infonState{
    // -----------------------------------------------------------------
    // Semantic interpretation of this overlay
    // -----------------------------------------------------------------
    mode[tUnset, tUnknown, NUM, STR, LST]: overlayType
    mode[emUnknown, emConcat, emLiteral, emIntersection]: evalMode
    me SizeMode: sizeMode <- fromCount
    flag: inverted
    // Numeric signs live in num. This records the one-time translation of a
    // negative displacement against an extent, not another sign or size mode.
    flag: numericExtentApplied
    flag: undefined
    // -----------------------------------------------------------------
    // Overlay payload
    // Exactly which member is meaningful depends on overlayType.
    // These are candidates for a union once CodeDog union support is reliable.
    // -----------------------------------------------------------------
    me FlexNum: num
    me string: str
    me PovList: items
    // -----------------------------------------------------------------
    // List-specific semantics
    // -----------------------------------------------------------------
    our infonView: listSpec     // Applies to every member as a template
    // A T-list is an ordinary ordered list plus the explicitly enumerated
    // identity relationships; boundary composition is handled by the graph.
    flag: timelike
    flag: tailUnfinished

    // -----------------------------------------------------------------
    // Preferred external representation
    // These do not change the internally represented state.
    // -----------------------------------------------------------------
    mode[fDefault, fFloat, fFraction, fSingleQuote, fHereDoc, fSizedBin]: literalFormat
    mode[bDec, bBin, bHex]: numBase
    flag: sizeWasInner  // True when the size was written inside a list as {~S ...}


    me none: infonState(me int: N) <- {
        overlayType <- NUM
        evalMode <- emLiteral
        num <- N
    }
    me none: infonState(me string: S, me bool: isStrInf) <- {
        overlayType <- STR
        evalMode <- emLiteral
        str <- S
    }
    our POV: deleteListNode(our POV: toDel) <- {
        return(items.erase(toDel))
    }
    me FlexNum: getValAsNum() <-{
        if(inverted){return(-num)}
        else{return(num)}
    }
    // Copy a matching overlay's evaluation/size modes and payload. The caller
    // owns semantic validation and change notification. Zero copies a whole
    // string; a nonzero size copies its prefix. Other state metadata is retained.
    void: copyOverlayFrom(their infonState: from, me FlexNum: sizeToCopy) <- {
        me int: sourceType <- from!.overlayType
        if(sourceType!=overlayType){return()}
        evalMode <- from!.evalMode
        sizeMode <- from!.sizeMode
        switch(sourceType){
            case tUnknown: {num <- from!.num}
            case NUM: {num <- from!.num; numericExtentApplied <- from!.numericExtentApplied}
            case STR: {
                if(sizeToCopy==0){str <- from!.str}
                else {str <- from!.str.subStr(0, sizeToCopy.convertToFloat())}
            }
            case LST: {items <- from!.items}
        }
    }
    void: copyAsTypeTo(their infonState: to, our infonView: topThis, their List<their infonView>: copied) <- {
        to! <- self!
        to!.items.clear()
        to!.index.clear()
        to!.T_index.clear()
        our POV: pov <- items.head
        while(pov != NULL){
            our infonView: newInfon
            Allocate(newInfon)
            pov!.pItem!._copyAsTypeTo(newInfon, true, true, topThis, copied)
            newInfon.rememberContextualSource(pov!.pItem)
            our POV: newPOV <- to!.items.append(newInfon, pov!.isSubItm, 111)
            //newPOV!.pParent <-  //TODO
            //log("copyAsTypeTo newPOV:"+newPOV.mySymbol()+".pParent:"+newPOV!.pParent.mySymbol())
            if(pov!.pItem!.type!=NULL and pov!.pItem!.type!.normalType()!=""){
                to!.index.insert(pov!.pItem!.type!.normalType(), newInfon)
            }
            pov <- pov!.next
        }
    }

    void: clear() <- {num<-0 str<-""; items.clear(); listSpec<-NULL}
}
model infonView {
    // -----------------------------------------------------------------
    // What kind of view/item is this?
    // -----------------------------------------------------------------
    flag: invertMatch

    mode[mNone, mItem, mWordDefn, mIncludeStream, mIncludeParseStr]: itmMode

    mode[vmAny, vmCursor, vmOverlay]: viewMode

    // Meaningful when viewMode == vmCursor
    mode[cmNone, cmSelf, cmWorld, cmContext, cmUser, cmArgs, cmVars,
         cmPrev, cmNext, cmTPrev, cmTNext]:  cursorMode

    // -----------------------------------------------------------------
    // State represented by this view
    // -----------------------------------------------------------------
    our infonState: infSize
    our infonState: value
    // An explicit occurrence reference survives reference/view copies. Fresh
    // definition instances do not inherit it through _copyAsTypeTo().
    our InfonIdentity: identityName

    me OrderMode: orderMode

    // -----------------------------------------------------------------
    // Intersection semantics
    // -----------------------------------------------------------------
    mode[ipNoIntersect, ipGetLast, ipGetFirst, ipGetMarked]: intersectPos

    // The internal information structure being resolved.
    our infonView: innr

    // Meaningful when intersectPos == ipGetMarked.
    // Identifies the marked occurrence within innr.
    // Keep the POV rather than merely its pItem because the occurrence/context
    // matters, and resolution may write through it.
    our POV: intersectMarkedRetPOV

    // Bracketed index syntax lowers to ordinary intersection machinery, but
    // the selection relation remains positional.  Preserve that semantic
    // origin so identity enumeration does not infer it from the lowered shape.
    flag: positionalSelection

    // The counted wildcard prefix generated by a positive range selector.
    // Its unit is the selected source's immediate item unit; it is not a
    // user-written type constraint. A compatible derived view may therefore adopt
    // the source listSpec solely to align this skip as one sparse run.
    flag: positionalIndexSkip

    // Stable link from a lowered selector back to its registry-owned symbolic
    // request.  The unresolved work itself remains in wrkList.
    me uint64: selectionRequestID <- 0

    // Current representation of <~.
    // Eventually replace this flag + funcArgs overload with:
    //     our infonView: innrOutr
    flag: hasInnrOutr

    // -----------------------------------------------------------------
    // Type / definition semantics
    // -----------------------------------------------------------------
    our WordUse: type
    me List<our WordUse>: addedTypes

    // Definition-list materialization can explicitly request a newly visible
    // list template without replaying any template already received.
    me List<our infonView>: appliedListSpecs

    // Meaningful for itmMode == mWordDefn.
    our WordDefn: definedWord

    // -----------------------------------------------------------------
    // Transitional mixed fields
    // These currently contain essential information, so cannot yet
    // be moved out of the model even though their representation is poor.
    // -----------------------------------------------------------------

    // Currently overloaded as:
    //   * definition body
    //   * <~ innrOutr
    //   * legacy function argument
    //
    // Eventually split into definitionBody / innrOutr and delete
    // the legacy function use.
    our infonView: funcArgs

    // A temporal cursor reads another state value without identifying their supports.
    our POV: temporalValueSource

    // Corresponding prior part. This guarded route is not an identity or RHS.
    our POV: temporalPredecessor

    // %? withholds default value preservation at this occurrence's temporal
    // transition. It supplies no value and is independent of unknown payloads.
    flag: independentTemporalValue

    // Persistent identity relationships and pending RHS constraints.
    me List<our POV>: wrkList

    // Local adjacency index for T-list boundary implications.  The semantic
    // identity itself is owned by identityRelation in IdentityRegistry.
    me List<our TemporalBoundaryIdentity>: temporalBoundaryIdentities
    // Whole-interval T-list components retain the witnesses for their two
    // boundary identities; IdentityRegistry owns the equalities themselves.
    me List<our TemporalContainmentIdentity>:
            temporalContainmentIdentities
}

struct infonView{
    me bool: isNull() <- {
        return(infSize!=NULL and value!=NULL and
            infSize!.overlayType==NUM and infSize!.evalMode==emLiteral and infSize!.num==0 and
            value!.overlayType==tUnknown and value!.evalMode==emLiteral and value!.num==0 and
            !infSize!.inverted and !value!.inverted and !infSize!.undefined and !value!.undefined)
    }
    void: setToNull() <- {
        infSize!.clear(); value!.clear()
        infSize!.resetFlagsAndModes(); value!.resetFlagsAndModes()
        infSize!.overlayType <- NUM; infSize!.evalMode <- emLiteral
        value!.overlayType <- tUnknown; value!.evalMode <- emLiteral
        viewMode <- vmOverlay; itmMode <- mItem; isNormed <- false
    }
     // -----------------------------------------------------------------
    // Legacy intersection-as-function machinery
    // Remove when the old function syntax is removed.
    // -----------------------------------------------------------------
    mode[apNoArgs, apArgIsFirstItem, apArgIsLastItem]: argPos
    flag: argsOnLeft
    flag: cnvtToFunc

    // -----------------------------------------------------------------
    // Context / reference resolution
    // Needed by the language system, not by identity logic.
    // -----------------------------------------------------------------
    mode[gUnset, gAbstract, gConcrete]: generality
    our infonView: proxy

    // Current ad-hoc instantiation/scope mechanism for
    // %self, %prev, %next, definition/listSpec copies.
    our infonView: copySource
    mode[cstNone, cstDefinition, cstListSpec]: copySourceType
    our infonView: thisPtr

    // -----------------------------------------------------------------
    // Part-path theorem execution / syntactic sugar
    // -----------------------------------------------------------------
    me List<our PartPath>: parts
    our PartPath: partRef

    // -----------------------------------------------------------------
    // External input / stream directives
    // -----------------------------------------------------------------
    me string: includeSpec
    our infonView: includeInfn

    // -----------------------------------------------------------------
    // Source / stream metadata
    // -----------------------------------------------------------------
    me uint64: originID
    me uint64: infCharPos

    // Someone wants the result delivered back to a stream/request.
    // Eventually move with origin/routing information into a
    // request/subscription object.
    flag: doReply

    // -----------------------------------------------------------------
    // Normalization metadata and compatibility helpers
    // -----------------------------------------------------------------
    mode[umAssert, umQuestion, umCommand]: useMode

    flag: isNormed

    // <~ has already been translated into old wrkList machinery.
    flag: asWrkLstOutr

    // Definition/COW processing provenance.
    flag: isFromDefn

    // Type-definition application caches.
    flag: alreadyTypeChecked

    // Child-side marker used by current intersection processing.
    flag: isInnr


    // Keep-alive references for temporary POVs.
    me List<our POV>: retainedPOVs

    // Non-owning route to the Agent registry for source-based references.
    // The registry owns the reference records and their POVs; this field lets
    // a later list closure notify the same semantic universe.
    their IdentityRegistry: referenceRegistry

    // Source graphs still referenced through non-owning POV context links in
    // this result. These are ownership dependencies, not pending constraints.
    me List<our POV>: sourceGraphDependencies

    // Speculative candidate existence during matching.
    flag: isTentative

    // Property of a generated identity relation, currently stored
    // incorrectly on its RHS infon.
    flag: asRHSInternalIdent

    // Definition and member-copy metadata.
    flag: wordDerefed
    flag: addedTypesAlreadyCopied

    // Parser-specific behavior; investigate/delete with parser cleanup.
    flag: altUse

    our POV: fetchField(me string: fieldname) <- {
        if(value!.items.isEmpty()){return(NULL)}
        me int: count <- 0
        our POV: pov <- value!.items.head
        while(pov != NULL){
            our infonView: inf <- pov!.pItem
            if(inf!.invertMatch){
                pov <- pov!.next
                continue()
            }
            if(inf!.type!=NULL and inf!.type!.typeID()==fieldname){
                return(pov)
            } else { // Try sub-types
                withEach subType in inf!.addedTypes{
                    if(subType!.typeID()==fieldname){return(pov)}
                }
            }
            count <- count+1
            pov <- pov!.next
        }
        return(NULL)
    }
    me string:  fetchString()  <- {return(value!.str)}
    me FlexNum: fetchFlexNum() <- {return(value!.getValAsNum())}
    me int64:   fetchInt()     <- {return(value!.getValAsNum().convertToInt())}
    me double:  fetchDouble()  <- {if(value!.inverted){return(-value!.num.convertToFloat())}else{return(value!.num.convertToFloat())}}

    our infonView: findMatchingItem(our infonView: pattern) <- {
        me string: fieldName <- pattern!.type!.typeID()
        our POV: pov <- fetchField(fieldName)
        if(pov!=NULL){
            return(pov!.pItem)
        } else {return(NULL)}
    }

    me FlexNum: sizeIfKnown() <- {
        if(infSize!.evalMode == emLiteral){return(infSize!.num)}
        return(-1)
    }
    me FlexNum: countGivenItems() <- {
        me FlexNum: acc <- 0
        our POV: pov <- value!.items.head
        while(pov != NULL){
            our infonView: pItem <- pov!.pItem
            if(pItem!.itmMode == mItem) {
                acc <- acc + 1
            } else if(pov!.isSubItm){
                me FlexNum: childCount <- pItem!.sizeIfKnown()
                if(childCount==-1){return(-1)}
                acc <- acc + childCount
            }
            pov <- pov!.next
        }
        return(acc)
    }
    their infonState: countSize(me bool: verify) <- {
        // An unordered description may omit parts. Stored membership is not
        // evidence of its total size; an explicit size remains authoritative.
        if(orderMode==uUnordered and value!.overlayType==LST and value!.evalMode==emLiteral){return(infSize)}
        if(infSize!.evalMode==emUnknown){verify <- false}
        if(value!.sizeMode!=fromGiven and (infSize!.evalMode==emUnknown or verify)){
            if(value!.overlayType==STR and value!.evalMode==emLiteral){
                infSize!.overlayType  <- NUM
                infSize!.evalMode <- emLiteral
                infSize!.num    <- value!.str.size()
            } else if(value!.overlayType==LST and (value!.evalMode==emLiteral or value!.evalMode==emIntersection)){
                me FlexNum: acc <- 0
                our POV: pov <- value!.items.head
                while(pov != NULL){
                    our infonView: pItem <- pov!.pItem
                    if(pItem!.itmMode == mItem or pItem!.itmMode == mWordDefn) {
                        acc <+- 1
                    } else if(pov!.isSubItm) {
                        if(pItem!.value!.tailUnfinished){return(infSize)}
                        their infonState: tmp <- pItem!.countSize(false)
                        if(tmp!.evalMode==emUnknown){return(infSize)}
                        acc <+- tmp!.num
                    }
                    pov <- pov!.next
                }
                if(verify){
                    if(infSize!.evalMode==emLiteral and infSize!.num==acc){
                        value!.tailUnfinished <- false
                        resolveEndRelativeReferences()
                    }
                }else{
                    infSize!.overlayType  <- NUM
                    infSize!.evalMode <- emLiteral
                    infSize!.num    <- acc
                    value!.tailUnfinished <- false
                    resolveEndRelativeReferences()
                }
            }
        }
        return(infSize)
    }
    me bool: isASeq() <- {return((value!.evalMode==emLiteral and value!.overlayType==LST) or value!.evalMode==emConcat)}
    me bool: isOrLike() <- {return(value!.evalMode==emIntersection and intersectPos==ipGetLast and innr!=NULL and innr!.infSize!.evalMode==emUnknown and innr!.value!.sizeMode==fromGiven and innr!.value!.evalMode==emLiteral)}
    void: setOrderMode() <- {
        if(funcArgs!=NULL){
            if(funcArgs!.orderMode!=uUnknown){
                orderMode <- funcArgs!.orderMode
            }
            else{
                if(funcArgs!.type!=NULL){
                    me vocabularySpec: vSpec
                    if(!definedWord!.UsageTags.isEmpty()){
                        vSpec.init(definedWord!.UsageTags[0])
                    }
                    me List<our WordDefn>: resultDefns
                    me int: numAdded <- modelMngr.lookupWord(funcArgs!.type!.typeID(), vSpec, resultDefns)
                    if(!resultDefns.isEmpty()){
                        our WordDefn: def <- resultDefns[0]
                        orderMode <- def!.meaning!.orderMode
                    }
                }
                funcArgs!.orderMode <- orderMode
            }
        }
    }
    me string: getTypeStr() <- {
        if(type!=NULL){return(type!.typeID())}
        return("")
    }
    our POV: getNthInfonView(me FlexNum: N) <-{
        our POV: NthPov
        me FlexNum: crntIdx <- 0
        our POV: pov <- value!.items.head
        while(pov != NULL){
            if(pov!.isSubItm){ //TODO: test mSubitems in getNthInfonView
                me FlexNum: itmSize <- sizeIfKnown()
                if(itmSize!=-1){
                    me FlexNum: offSet <- crntIdx+itmSize
                    if(offSet<=N){return(pov!.pItem!.getNthInfonView(N-crntIdx))}
                    else{crntIdx <- offSet}
                }
            }else{
                crntIdx <+- 1
                if(crntIdx==N){return(pov)}
            }
            pov <- pov!.next
        }
        return(NthPov)
    }
    our POV: getNthEndRelativeInfonView(me FlexNum: N) <-{
        our POV: NthPov
        me FlexNum: crntIdx <- 0
        our POV: pov <- value!.items.head
        while(pov != NULL){
            if(pov!.isSubItm){
                me FlexNum: itmSize <- pov!.pItem!.sizeIfKnown()
                if(itmSize==-1){return(NULL)}
                me FlexNum: offSet <- crntIdx+itmSize
                if(N<=offSet){return(pov!.pItem!.getNthEndRelativeInfonView(N-crntIdx))}
                crntIdx <- offSet
            }else{
                crntIdx <+- 1
                if(crntIdx==N){return(pov)}
            }
            pov <- pov!.next
        }
        return(NthPov)
    }

    our POV: getLastItem() <- {
        // ASSERT(Should be already normed and a non-concat list)
        our POV: lastItem
        if(value!.overlayType!=LST){return(NULL)}
        if(value!.evalMode==emUnknown){return(NULL)}
        if(value!.tailUnfinished){return(NULL)}
        if(value!.items.isEmpty()){return(NULL)}
        lastItem <- value!.items.tail
        if(value!.evalMode==emConcat){lastItem <- lastItem!.pItem!.getLastItem()} //TODO: test emConcat in getLastItem
        if(lastItem!.isSubItm){return(lastItem!.pItem!.getLastItem())} //TODO: if subItem was {}, return the previous... recursivly.
        return(lastItem)
    }

    me EndRelativeExtentResult: endRelativeExtent() <- {
        me EndRelativeExtentResult: result
        if(value!.overlayType==tUnknown or value!.overlayType==tUnset or
                value!.evalMode==emUnknown){
            return(result)
        }
        if(value!.overlayType!=LST){
            result.status <- eresIncompatible
            return(result)
        }
        if(infSize!.evalMode!=emLiteral){return(result)}
        if(infSize!.overlayType!=NUM or infSize!.num<0){
            result.status <- eresIncompatible
            return(result)
        }
        result.status <- eresExact
        result.exactExtent <- infSize!.num.convertToInt()
        return(result)
    }
    our POV: resolveEndRelativeReference(
            their EndRelativeReference: reference) <- {
        if(reference==NULL or reference!.retired or
                reference!.sourceInfon!==self or
                reference!.referencePOV==NULL or
                !reference!.referencePOV!.endRelativeReference){return(NULL)}
        our POV: referencePOV <- reference!.referencePOV
        if(referencePOV!.endRelativeResolved){return(referencePOV)}
        me EndRelativeExtentResult: extent <- endRelativeExtent()
        if(extent.status!=eresExact){return(referencePOV)}
        me int64: ordinal <- extent.exactExtent +
                reference!.offset + 1
        if(ordinal<=0){return(referencePOV)}
        our POV: actualPOV
        if(reference!.offset==-1 and !value!.tailUnfinished){
            actualPOV <- getLastItem()
        }else if(reference!.sourcePOV!=NULL and
                reference!.sourcePOV!.pItem===self){
            actualPOV <- reference!.sourcePOV!.
                    logicalItemAtIndex(ordinal - 1)
        }else{
            actualPOV <- getNthEndRelativeInfonView(ordinal)
        }
        if(actualPOV==NULL or actualPOV!.pItem==NULL){return(referencePOV)}

        our infonView: actualItem <- actualPOV!.pItem
        referencePOV!.pItem!.addInfonViewToWrkList(actualItem, true, povSrcEndRelativeReference)
        referencePOV!.workRevision <+- 1
        referencePOV!.readyToResolve <- true
        referencePOV!.endRelativeResolved <- true
        referencePOV!.pParent <- actualPOV!.pParent
        reference!.resolvedPOV <- actualPOV
        if(referenceRegistry!=NULL){
            actualPOV!.bindIdentityRegistry(referenceRegistry)
            reference!.identityRelation <- referenceRegistry!.recordIdentity(
                    referencePOV, actualPOV,
                    iekEndRelativeResolution, 0)
        }
        actualPOV!.pItem <- referencePOV!.pItem
        return(referencePOV)
    }
    void: resolveEndRelativeReferences() <- {
        if(referenceRegistry==NULL){return()}
        me EndRelativeExtentResult: extent <- endRelativeExtent()
        if(extent.status!=eresExact){return()}
        me List<our EndRelativeReference>: references
        referenceRegistry!.collectEndRelativeReferences(self, references)
        withEach reference in references{
            if(reference!=NULL and reference!.referencePOV!=NULL and
                    !reference!.referencePOV!.endRelativeResolved){
                resolveEndRelativeReference(reference)
            }
        }
    }
    // This infon-only helper can return only an already materialized last
    // location. Creating an unresolved reference requires a POV context and
    // therefore lives on POV.getLastPOV().
    our POV: getKnownLastPOV() <- {
        our POV: lastPOV
        if(!value!.tailUnfinished and value!.sizeMode==fromGiven and infSize!.evalMode==emLiteral){
            lastPOV <- getNthInfonView(infSize!.num)
        }else{lastPOV <- getLastItem()}
        return(lastPOV)
    }

    our infonView: getKnownLastInfonView() <- {
        our POV: lastPOV <- getKnownLastPOV()
        if(lastPOV==NULL){return(NULL)}
        return(lastPOV!.pItem)
    }
    our infonView: getFirstItem(me bool: isSubItm) <- {
        // ASSERT(Should be already normed)
        our infonView: firstItem
        if(!value!.items.isEmpty()) {
            firstItem <- value!.items.first()
            if(value!.evalMode==emConcat){firstItem <- firstItem!.getFirstItem(isSubItm)}
        }  else {firstItem <- NULL}
        if(firstItem!=NULL and isSubItm){
            firstItem <- firstItem!.getFirstItem(isSubItm)
        }
        return(firstItem)
    }
    our POV: deleteListNode(our POV: toDel) <- {
        // Low level delete of an item in list. Does not update size.
        if(value!.overlayType==LST){
            return (value!.deleteListNode(toDel))
        }
        return(NULL)
    }
    void: rememberContextualSource(our infonView: source) <- {
        if(source.viewMode==vmCursor and source.cursorMode==cmSelf and copySource==NULL){
            copySource <- source
            copySourceType <- cstDefinition
        }
    }
    void: _copyAsTypeTo(our infonView: to, me bool: copyWrkList, me bool: copyPartRef, our infonView: topThis, their List<their infonView>: copied) <- {
        withEach item in copied{if(item===this){return()}}
        copied.append(self)
        to!.identityName <- NULL
        to!.flags      <- flags
        to!.copySource <- copySource
        to!.doReply    <- false
        to!.originID   <- originID
        to!.infCharPos <- infCharPos
        to!.thisPtr      <- topThis
        to!.addedTypes   <- addedTypes
        to!.appliedListSpecs <- appliedListSpecs
        to!.orderMode    <- orderMode
        if(type!=NULL){to!.type<- type}
        to!.definedWord <- definedWord
        if(includeSpec!=""){to!.includeSpec <- includeSpec}
        if(includeInfn!=NULL){to!.includeInfn <- includeInfn}
        if(copyPartRef){
            // partRef/parts are pending path-navigation state, not passive metadata.
            // Cloning them into copies that are meant to be "plain semantic materializations"
            // can cause the path walk to be replayed on the clone.
            if(partRef!=NULL){
                Allocate(to!.partRef)
                to!.partRef! <- partRef!
                if(partRef!.path!=NULL){
                    our infonView:: copiedPath
                    partRef!.path!._copyAsTypeTo(
                            copiedPath, true, true, topThis, copied)
                    to!.partRef!.path <- copiedPath
                }
                if(partRef!.spec!=NULL){
                    our infonView:: copiedSpec
                    partRef!.spec!._copyAsTypeTo(
                            copiedSpec, true, true, topThis, copied)
                    to!.partRef!.spec <- copiedSpec
                }
                if(partRef!.continuation!=NULL){
                    our infonView:: copiedContinuation
                    partRef!.continuation!._copyAsTypeTo(
                            copiedContinuation, true, true, topThis, copied)
                    to!.partRef!.continuation <- copiedContinuation
                }
            }
            if(!parts.isEmpty()){
                withEach part in parts{
                    our PartPath: newPart
                    Allocate(newPart)
                    newPart! <- part!
                    if(part!.path!=NULL){
                        our infonView:: copiedPath
                        part!.path!._copyAsTypeTo(
                                copiedPath, true, true, topThis, copied)
                        newPart!.path <- copiedPath
                    }
                    if(part!.spec!=NULL){
                        our infonView:: copiedSpec
                        part!.spec!._copyAsTypeTo(
                                copiedSpec, true, true, topThis, copied)
                        newPart!.spec <- copiedSpec
                    }
                    if(part!.continuation!=NULL){
                        our infonView:: copiedContinuation
                        part!.continuation!._copyAsTypeTo(
                                copiedContinuation, true, true,
                                topThis, copied)
                        newPart!.continuation <- copiedContinuation
                    }
                    to!.parts.append(newPart)
                }
            }
        }
        infSize!.copyAsTypeTo(to!.infSize, topThis, copied)
        value!.copyAsTypeTo(to!.value, topThis, copied)
        if(intersectMarkedRetPOV!=NULL){
            our POV: srcPov <- value!.items.head
            our POV: dstPov <- to!.value!.items.head
            while(srcPov!=NULL and dstPov!=NULL){
                if(srcPov===intersectMarkedRetPOV){
                    to!.intersectMarkedRetPOV <- dstPov
                    break()
                }
                srcPov <- srcPov!.next
                dstPov <- dstPov!.next
            }
        }
        if(funcArgs!=NULL){funcArgs!.copyAsTypeTo(to!.funcArgs, true, true)}
        if(innr!=NULL){Allocate(to!.innr); innr!.copyAsTypeTo(to!.innr, true, true)}
        if(copyWrkList){
            // A contextual RHS belongs to this instance too. Starting another
            // top-level copy here would rebind %self to the RHS itself.
            withEach source in wrkList{
                our POV:: rhs{455}
                rhs! <- source!
                Allocate(rhs!.pItem)
                source!.pItem!._copyAsTypeTo(rhs!.pItem, true, true, topThis, copied)
                rhs!.pItem.rememberContextualSource(source!.pItem)
                to!.wrkList.append(rhs)
            }
        }
    }
    void: copyAsTypeTo(our infonView: to, me bool: copyWrkList, me bool: copyPartRef) <- {
        me List<their infonView>: copied
        if(thisPtr==NULL){
            _copyAsTypeTo(to, copyWrkList, copyPartRef, to, copied)
        }else{
            _copyAsTypeTo(to, copyWrkList, copyPartRef, thisPtr, copied)
        }
    }
    void: convertThisToIntersection(our infonView: newInnr, me SizeMode: sMode) <- {
        itmMode         <- mItem
        viewMode         <- vmOverlay
        value!.evalMode  <- emIntersection
        intersectPos    <- ipGetLast
        infSize!.evalMode  <- emUnknown
        innr            <- newInnr
        innr!.isInnr     <- true
        innr!.value!.sizeMode <- sMode

    }
    our POV: addToOrInfonView(our infonView: rItem, our POV: rNode, our POV: pred) <- {
        our POV: pov <- innr!.value!.items.head
        while(pov != NULL){  // Don't push if duplicate
            if(pov!.pItem===rNode!.pItem){return(NULL)}
            pov <- pov!.next
        }
        our POV: newAlt <- innr!.value!.items.pushAsAlt(rNode, rItem, pred)
        return(newAlt)
    }
    void: pushAltIntoLineAlt(our POV: pred, me int: lineID, our infonView: rItem, our POV: rNode, me bool: LHSIsFromALT) <- {
        // Search wrkList for lineID
        our POV: povToPushTo <- NULL
        withEach wrkItm in wrkList{
            if(wrkItm!.linearAltID==lineID){povToPushTo<-wrkItm; break()}
        }
        if(povToPushTo == NULL){ // Make an alt item to add.
            povToPushTo <- makeOrPov(rNode, pred)
            povToPushTo!.pItem!.innr!.value!.tailUnfinished <- true
            povToPushTo!.pItem!.innr!.value!.sizeMode       <- fromGiven
            povToPushTo!.linearAltID                     <- lineID
            addPOVToWrkList(povToPushTo)
        }else{
            our POV: newAlt <- povToPushTo!.pItem!.addToOrInfonView(rItem, rNode, pred)
            if(newAlt!=NULL){
                newAlt!.isFromALT<-true
                newAlt!.pParent  <- povToPushTo
                povToPushTo!.workRevision <+- 1
                makeWrkListPOVReady(povToPushTo)
            }
        }
        //log("AddedAltToLineAlt:"+povToPushTo!.mySymbol()+":"+povToPushTo.stringify()+" <pred- "+pred!.mySymbol()+":"+pred!.stringify())
    }
    bool: workListContainsInfonView(our infonView: inf) <- {
        if(self===inf){return(true)}
        withEach wrkListItem in wrkList{
            if(wrkListItem!.pItem===inf){return(true)}
        }
        return(false)
    }
    bool: workListContainsPOV(our POV: target) <- {
        withEach wrkListItem in wrkList{
            if(wrkListItem===target){return(true)}
        }
        return(false)
    }
    void: removePOVFromWrkList(our POV: target) <- {
        me List<our POV>: retainedWork
        withEach wrkListItem in wrkList{
            if(!(wrkListItem===target)){retainedWork.append(wrkListItem)}
        }
        wrkList <- retainedWork
    }
    void: discardWrkListPOV(our POV: target) <- {
        removePOVFromWrkList(target)
    }
    void: makeWrkListPOVReady(our POV: target) <- {
        noteNormalizationWork()
    }
    void: clearWrkList() <- {
        wrkList.clear()
    }
    bool: infonViewHasType(me string: typeIDStr) <- {
        if(type!=NULL and type!.typeID()==typeIDStr){return(alreadyTypeChecked)}
            withEach subType in addedTypes{
            if (subType!.typeID() == typeIDStr  and subType!.typeInitialized) {
                return(true)
            }
        }
        return(false)
    }
    void: addPOVToWrkList(our POV: pov) <- {
        if(workListContainsInfonView(pov!.pItem)){return()}
        noteNormalizationWork()
        //:l/PAI::logSeg(" WLA.b:"+pov!.mySymbol())
        wrkList.append(pov)
    }
    our POV: addInfonViewToWrkList(our infonView: i, me bool: internalIdent, me int: source) <- {
        if(workListContainsInfonView(i)){return(NULL)}
        our POV:: newPov{source}
        //i!.asRHSInternalIdent <- internalIdent     // Maybe needed for pronouns
        newPov!.pItem <- i
        noteNormalizationWork()
        //:l/PAI::logSeg(" WLA.c:"+newPov!.mySymbol())
        wrkList.append(newPov)
        return(newPov)
    }
    our POV: addInfonViewToWorkListWithPriority(our infonView: i, me bool: internalIdent) <- {
        if(workListContainsInfonView(i)){return(NULL)}
        our POV:: newPov{402}
        i!.asRHSInternalIdent <- internalIdent
        newPov!.pItem <- i
        newPov!.pItem!.streamState <- notParsing
        noteNormalizationWork()
        wrkList.prepend(newPov, 403)
        return(newPov)
    }
    void: copyWrkListFrom(their infonView:from) <- {
        withEach wrkListItem in from!.wrkList {
            our POV:: pov{455}
            pov! <- wrkListItem!
            if(pov!.pedigree.source==0){pov!.pedigree.source <- 455}
            Allocate(pov!.pItem)
            wrkListItem!.pItem!.copyAsTypeTo(pov!.pItem, true, true)
            //:l/PAI::logSeg(" WLA.d:"+pov!.mySymbol())
            wrkList.append(pov)
        }
    }
    void: takeWrkListFrom(our infonView:from, me bool: doClear) <- {
        withEach wrkItm in from!.wrkList{
            addPOVToWrkList(wrkItm)
        }
        if(doClear){from!.clearWrkList()}
    }
    void: takeConsumerWorkFrom(our infonView:from, me bool: doClear) <- {
        withEach wrkItm in from!.wrkList{
            if(wrkItm!=NULL and !wrkItm!.selectorLocalWork){
                addPOVToWrkList(wrkItm)
            }
        }
        if(doClear){from!.clearWrkList()}
    }
    void: retainPOV(our POV: pov) <- {
        if(pov!=NULL){retainedPOVs.append(pov)}
    }
    void: addSourceGraphDependency(our POV: sourcePOV) <- {
        if(sourcePOV==NULL){return()}
        withEach dependencyPOV in sourceGraphDependencies{
            if(dependencyPOV===sourcePOV){return()}
        }
        sourceGraphDependencies.append(sourcePOV)
    }
    our infonView: findPartPathByWord(me string: wordName) <- {
        withEach part in parts{
            if(part!.path!.type != NULL and part!.path!.type!.typeID() == wordName){
                return(part!.path)
            }
        }
        return(NULL)
    }
    me string: lengthStatus() <- {
        //MUST: complete after range functionality works
        if(infSize!.evalMode==emLiteral){
            me FlexNum: maxSize <- infSize!.num
            me FlexNum: itmCount <- countGivenItems()
            if(itmCount == -1){return("?")}
            if(itmCount < maxSize){return("L")}
            else if(itmCount == maxSize){return("E")}
            else{return("G")}
        }else{return("?")}
    }
    me string: worklistToString() <- {
        me string: S <- ""
        withEach workItm in wrkList{
            //S <- S + "\n    ::" + workItm.stringify()
        }
        return(S)
    }
    void: clear() <- {
        if(referenceRegistry!=NULL){
            referenceRegistry!.retireEndRelativeReferences(self)
            referenceRegistry <- NULL
        }
        infSize!.clear()
        value!.clear()
        resetFlagsAndModes()
        identityName <- NULL
        copySource <- NULL
        funcArgs   <- NULL
        temporalValueSource <- NULL
        temporalPredecessor <- NULL
        innr       <- NULL
        type       <- NULL
        appliedListSpecs.clear()
        retainedPOVs.clear()
        sourceGraphDependencies.clear()
        temporalBoundaryIdentities.clear()
        temporalContainmentIdentities.clear()
    }
    void: setToList() <- {
        clear()
        itmMode      <- mItem
        viewMode      <- vmOverlay
        value!.overlayType  <- LST
        value!.evalMode <- emLiteral
        value!.sizeMode       <- fromCount
        value!.tailUnfinished <- true

        infSize!.overlayType        <- NUM
        infSize!.evalMode       <- emUnknown
    }
    void: setSelfAsAPluralOf(our infonView: toPluralize) <-{
        setToList()
        value!.listSpec <- toPluralize
        if(toPluralize!=NULL and toPluralize!.type!=NULL and toPluralize!.type!.typeID()!=""){
            me string: plural <- inflect.convert_to_modern_plural(toPluralize!.type!.typeID())
            Allocate(type)
            log("\n @@@@@@ PLURALIZING:",plural)
            type!.setAsGiven(plural)
            print("\n@@@@@@@@@@@@@ Pluralizing:"+toString(toPluralize)+"\n")
        }
    }
    void: INIT() <- {
        Allocate(infSize); infSize! <- infonState(0)
        Allocate(value)
        clearSymbol(self);
        orderMode <-uUnknown
    }
    none: infonView(me string: S) <- {
        Allocate(infSize); infSize! <- infonState(S.size())
        Allocate(value);   value!   <- infonState(S, true)
        clearSymbol(self)
        orderMode <- uUnknown
        viewMode <- vmOverlay
        itmMode <- mItem
    }
}
model infItr{
    our infItr: iParent
    their POV: topPOV
    me int: lineAltID
    void: initialize(our POV: pov) <- {topPOV <- pov}
    void: INIT() <- {clearSymbol(self);}
}

struct GLOBAL{
    // Compatibility marker for loaded-list iterators. Streaming waits and
    // resumption belong to graph sessions and parser publications.
    const int: propWaitNone              <- 0


    me string: crntRHSMySymbol
    me string: crntLHSMySymbol

    our infonView: makeInnrInfonView() <- {
        our infonView:: newListInfon
        newListInfon!.itmMode        <- mItem
        newListInfon!.viewMode        <- vmOverlay
        newListInfon!.infSize!.overlayType  <- NUM
        newListInfon!.infSize!.evalMode <- emUnknown
        newListInfon!.infSize!.num    <- 1
        newListInfon!.value!.overlayType    <- LST
        newListInfon!.value!.evalMode   <- emLiteral
        newListInfon!.isInnr         <- true
        return(newListInfon)
    }
    our POV: makeOrPov(our POV: nextPov, our POV: pred) <- {
        our infonView: newListInfon <- makeInnrInfonView()               // Make {...} to be used as innr
        our POV: newAlt <- newListInfon!.value!.items.pushAsAlt(nextPov, nextPov!.pItem, pred)  // Make a POV for the item.
        our infonView:: newAltInfon; newAltInfon!.value!.overlayType   <- tUnknown
            newAltInfon!.convertThisToIntersection(newListInfon, fromGiven) // Make [ ] and add innr to it
        our POV:: newAltInfPov{4}                                  // Make the POV pointing to the [...]
            newAltInfPov!.pItem <- newAltInfon
        newAlt!.looseInhtd <- nextPov!.looseInhtd
        newAlt!.looseTop   <- nextPov!.looseTop
        newAlt!.looseMode  <- nextPov!.looseMode
        newAlt!.pParent    <- newAltInfPov
        newAlt!.isFromALT  <- true
        return(newAltInfPov)
    }
    void: trimTowardInfonViewFront(our POV: parentList, our POV: itemToTrim) <- {
        if(itemToTrim!.isSubItm){
            //:l/PAI::logSeg(" trim")
            itemToTrim!.pItem!.value!.items.clear()
            itemToTrim!.pItem!.infSize!.num<-0
            if(!(parentList!.pItem!.value!.items.head===itemToTrim) and itemToTrim!.prev!=NULL){
                trimTowardInfonViewFront(parentList, itemToTrim!.prev)
            }
        }
    }
    // To use this to debug, set InfonToMonitor then from relevant places call printDebInf() passing in a tag and a sub-infon to highlight.
    our infonView: infonToMonitor
    me string: prevInfToMonitorState
    me string: debugEventList
    void: printDebInf(me string: tag, our infonView: crntInfon) <- {
        if(infonToMonitor!=NULL){
            me string: newStr <- toStringColor(infonToMonitor, 1, crntInfon)
            if(newStr!=prevInfToMonitorState){
                print(debugEventList+"\n")
                print(alignLeft(tag, 12)+":"+newStr+"\n")
                debugEventList <- ""
                prevInfToMonitorState <- newStr
            }
        }
    }
    void: setInfonViewToMonitor(our infonView: inf) <- {
        if(inf!==infonToMonitor){
            infonToMonitor <- inf
            debugEventList <- ""
            printDebInf("SET:"+inf!.mySymbol(), inf)
        }
    }
    void: addDebugEvent(me string: eventDescription, our infonView: crntInfon) <- {
        if(infonToMonitor!=NULL){
            debugEventList <+- tam.setTextColor(2) + eventDescription+ tam.setDefaultColor() + "; "
        }
    }

}
model PartPath{
    our infonView: path
    our infonView: spec
    // Postfix work and paths parsed after a bracketed index.  The old `#`
    // spelling folded these into `path` because it had no closing delimiter.
    our infonView: continuation
    mode[dotField, upField, resolutionField, idxField, colonField,
            asTListField]: pathMode
    flag: wasTransfered
    flag: hasSemiColon
    // The source `%ctx` was supplied by the unary `~word` shorthand rather
    // than written explicitly.  This is syntax provenance only; resolution
    // has exactly the same representation as `%ctx~word`.
    flag: implicitSource
}
struct PartPath{
    void: clear()<-{path<-NULL; spec<-NULL; continuation<-NULL; flags<-0;}
}
struct infonState{
    me Multimap<me string, our infonView>: index
    me Multimap<me int64, our infonView: rangeIteration=logarithmic>: T_index
}
//////////////////////////
// Definition storage

struct GLOBAL{
    me ModelManager: modelMngr
}


//////////////////////////
// Infon Interface Routines
struct Agent{
    // Agent owns interaction lifetimes; WorldManager owns reasoning.
    me WorldModelMutex: sessionMutex
    our WorldSession: defaultSession
    me WorldManager: worldManager
    me uint64: nextWorldSessionID <- 1
    me List<our WorldSession>: worldSessions

    our WorldSession: startSession() <- {
        me WorldModelLock: lock{sessionMutex}
        our WorldSession:: session
        session!.id <- nextWorldSessionID; nextWorldSessionID <+- 1
        worldSessions.append(session)
        return(session)
    }
    our WorldRequest: normalizeInSession(our WorldSession: session, our POV: target, me bool: requireSize <- false) <- {
        me WorldModelLock: lock{sessionMutex}
        me bool: owned <- false
        withEach candidate in worldSessions{if(candidate===session){owned <- true}}
        if(!owned){
            our WorldRequest:: result
            result!.control <- worldManager.control
            result!.outcome <- worldError; result!.detail <- "Session belongs to another Agent"; return(result)
        }
        return(worldManager.normalize(session, target, requireSize, getLocaleBaseName(), world, identityRegistry))
    }
    void: endSession(our WorldSession: session) <- {
        me WorldModelLock: lock{sessionMutex}
        me List<our WorldSession>: remaining
        withEach candidate in worldSessions{
            if(candidate===session){worldManager.closeSession(candidate)}
            else{remaining.append(candidate)}
        }
        worldSessions <- remaining
        if(defaultSession===session){defaultSession <- NULL}
    }
    void: endWorldSessions() <- {
        me WorldModelLock: lock{sessionMutex}
        withEach session in worldSessions{worldManager.closeSession(session)}
        worldSessions.clear(); defaultSession <- NULL
    }
    our infonView: kernel
    our infonView: device
    our infonView: user
    our infonView: world
    me AgentContext: context
    their ProteusCore: CORE
    me Locale: locale
    our Map<string, string>: settings
    me int: errorStatus
    me string: errorMesg
    our IdentityRegistry: identityRegistry

    void: setErrorState(me string: errorMesg) <- {
        //log("INFON ERROR: " + errorMesg)
       // print("INFON ERROR: " + errorMesg+"\n")
    }
    our WorldRequest: normalize(our POV: normPov) <- {
        me WorldModelLock: lock{sessionMutex}
        if(defaultSession==NULL){defaultSession <- startSession()}
        return(normalizeInSession(defaultSession, normPov))
    }
    // Scalar scope is identical; list scope will be implemented with lists.
    our WorldRequest: normalizeAll(our POV: normPov) <- {return(normalize(normPov))}
    void: normalizeAndWait(our POV: normPov) <- {
        me WorldModelLock: lock{sessionMutex}
        our WorldRequest: handle <- normalize(normPov)
        handle!.waitForCompletion()
        if(handle!.failed()){errorStatus <- 1; errorMesg <- handle!.error()}
        else{errorStatus <- 0; errorMesg <- ""}
    }
    void: close() <- {endWorldSessions()}
    void: appendToWorld(our infonView: newInfon) <- {
        our infonView: dotsAtTheEnd <- world!.value!.items.last()  //TODO: What is this line for?
        world!.value!.items.append(newInfon, false, 26)
    }
    void: initUser() <- {}
    void: setLocale(me string: loc) <- {
        locale <- unicodeMgr.SetLocale(loc)
        //Xlater=fetchXlater(&locale)
    }
    me string: getLocaleBaseName() <- {
        return(unicodeMgr.getLocaleBaseName(locale))
    }
    me int: setSetting(me string: key, me string: value) <- {
        settings![key] <- value
        if(key=='locale'){setLocale(value); return(2)}
        return(1)
    }
    void: init(their ProteusCore: core) <- {
        Allocate(settings)
        Allocate(identityRegistry)
        CORE <- core
        worldManager.inputHost <- core
        Allocate(device); device!.setToList()
        Allocate(user);   user!.setToList()
        Allocate(world); world!.setToList()
        context.init(identityRegistry)
        locale <- unicodeMgr.getSystemLocale()
        errorStatus <- 0
        errorMesg <- ""
    }
}
// A stream owns its normalization handle for the stream's whole lifetime.
// Current quiescence does not finish an input stream that is still open.
struct ThreadedNormalizer: inherits=Threads {
    our infonView: item
    our POV: pov
    their Agent: agent
    our WorldRequest: handle
    our WorldSession: session
    me bool: parseFirst
    their ThreadedInfonParser: parseBeforeNormalize
    me Mutex: lifecycleMutex
    me bool: cancellationRequested

    void: init(their Agent: _agent, our infonView: inf) <- {
        item <- inf; agent <- _agent
        agent!.worldManager.prepareInput(item)
        session <- agent!.startSession()
        Allocate(pov, 700); pov!.pItem <- inf
        cancellationRequested <- false
    }
    void: cancel() <- {
        protect(lifecycleMutex){
            cancellationRequested <- true
            if(handle!=NULL){handle!.cancel()}
            agent!.endSession(session)
        }
    }
    void: run() <- {
        if(parseFirst and parseBeforeNormalize!=NULL){parseBeforeNormalize!.waitForParseCompletion()}
        protect(lifecycleMutex){
            if(cancellationRequested){return()}
            handle <- agent!.normalizeInSession(session, pov)
        }
        // Keep the stream lifetime distinct from the request's current status.
        if(parseBeforeNormalize!=NULL){parseBeforeNormalize!.waitForParseCompletion()}
        handle!.waitForCompletion()
        if(handle!.failed()){
            agent!.CORE!.handleProteusError(item!.originID, handle!.error())
        }
    }
}
// These hooks are also overridden by hosts compiled outside the engine.
struct ProteusCore: virtualMethods=[makeInfonConnector, normalizeFromStreamSpecAtOrigin,
    normalizeFromStreamSpec, submitProteusResult, handleSystemError, handleSyntaxError,
    handleProteusError, getOriginIDString]{
    me sessionFile: DB_session
    our infonView: WORLD
    our Agent: agent
    me InfonStreamLoader: defaultStreamLoader
    their InfonStreamLoader: streamLoader
    me bool: streamingMode
    me string: errorMesg

    our infonView: parse(their ProteusParser: parser, their strBuf: streamToParse) <- {
        errorMesg <- ""
        our infonView:: topParsedNode
        parser!.initParseFromStream(streamToParse)
        parser!.CORE <- self
        parser!.doParse(topParsedNode)
        if(parser!.doesParseHaveError()){
            errorMesg <- parser!.formattedError()
            return(NULL)
        } else {return(topParsedNode)}
    }

    our infonView: parseAndExtractStream(their strBuf: streamToParse, me bool: independentIdentities <- false) <- {
        me ProteusParser: parser{self, streamingMode, 0}
        parser.independentIdentities <- independentIdentities
        our infonView: topParsedNode <- parse(parser, streamToParse)
        return(topParsedNode)
    }

    our infonView: parseAndExtractString(me string: textToParse, me string: streamName, me bool: independentIdentities <- false) <- {
        their strBuf:: bufToParse
        bufToParse!.initForString(textToParse, streamName)
        return(parseAndExtractStream(bufToParse, independentIdentities))
    }

    void: initParserParseExtractNormalizeInfonView_stream(our POV: toFill, their strBuf: streamToParse) <- {
        our ProteusParser:: parser{self, streamingMode, 0}
        our infonView: topParsedNode <- parse(parser, streamToParse)
        if(topParsedNode!=NULL){
            toFill!.pItem <- topParsedNode
            agent!.normalizeAndWait(toFill)
        }
    }

    // These convenience methods load a finite asset document. They wait for
    // that document only; inserted streams may remain open and subscribed.
    me bool: loadAssetInto(our infonView: target, me string: filename) <- {
        our InfonStream: stream <- streamLoader!.startNewConnection(
                target, streamLoader!.canonicalFileSpec(filename))
        if(stream==NULL){errorMesg <- "Could not open Proteus asset: "+filename; return(false)}
        stream.waitForCompletion()
        if(stream.normerThread.handle!.failed()){
            errorMesg <- stream.normerThread.handle!.error(); return(false)
        }
        return(true)
    }
    me bool: loadKernelContext() <- {
        Allocate(agent!.kernel)
        return(loadAssetInto(agent!.kernel, "public/KernelKB.pr"))
    }
    me bool: loadWorld(me string: filename) <- {
        if(findString(filename, "PublicKB.pr")!=-1){
            if(!loadKernelContext()){return(false)}
        }
        Allocate(WORLD)
        agent!.world <- WORLD
        return(loadAssetInto(WORLD, filename))
    }

    // Default asset-file policy; applications supply additional protocols.
    // NULL rejects the request before a parse/normalize stream is started.
    our InfonConnector: makeInfonConnector(me string: streamSpec, me int: loadNumber) <- {
        our InfonStreamSpec:: spec
        spec.setSpec(streamSpec)
        if(spec.protocolTag!="file"){return(NULL)}
        our AssetFileConnector:: connector
        connector.init(spec)
        if(connector.statusCode!=0){return(NULL)}
        return(connector)
    }

    // Nonblocking insertion contract: true means accepted, not finished.
    // The active loader owns the stream until shutdown; publications signal
    // readiness or failure through the existing graph subscriptions.
    me bool: requestStreamInsert(our infonView: target, me string: spec, me uint64: parentOrigin) <- {
        if(streamLoader==NULL){return(false)}
        return(streamLoader!.startNewConnection(target, spec, parentOrigin)!=NULL)
    }

    me uint64: streamSourceOriginID(our POV: sourcePOV,
            me uint64: explicitOriginID <- 0) <- {
        if(explicitOriginID>0){return(explicitOriginID)}
        their POV: crnt <- sourcePOV
        while(crnt!=NULL){
            if(crnt!.pItem!=NULL and crnt!.pItem!.originID>0){
                return(crnt!.pItem!.originID)
            }
            crnt <- crnt!.pParent
        }
        return(0)
    }

    me bool: normalizeFromStreamSpecAtOrigin(our POV: toFill,
            me string: streamSpec, me uint64: sourceOriginID) <- {
        return(requestStreamInsert(toFill!.pItem, streamSpec, streamSourceOriginID(toFill,sourceOriginID)))
    }
    me bool: normalizeFromStreamSpec(our POV: toFill, me string: streamSpec) <- {
        return(normalizeFromStreamSpecAtOrigin(toFill, streamSpec, 0))
    }

    me string: resultString(our infonView: inf) <- {
        me string: result <- ""
        if(inf!=NULL){
            result <- toString(inf)
        } else {
            result <- errorMesg
        }
        return(result)
    }

    our infonView: query(me string: qry, me bool: writeToSession) <- {
        // Parse -> extract -> normalize -> sessionFile
        our infonView: result <- parseAndExtractString(qry, "query")
        if(result == NULL){log("Syntax Error in input: " + qry)}
        our POV:: normPov{28}; normPov!.pItem <- result
        agent!.normalizeAndWait(normPov)
        if(writeToSession){addStatementToSession(remNewLines(qry))}
        return(normPov!.pItem)
    }

    void: loadProteusSessionFile(me string: filename) <- {
        me sessionFile: session
        if(session.openToRead(filename)){return()}
        me string: fLine
        while(! session.eof()){
            fLine <- session.readEntry()
            //ProteusQuery(fLine, false)
        }
        session.closeReading()
    }
    me void: annexSessions(me string: sessionFilename) <- {
        loadProteusSessionFile(sessionFilename)
    }
    me void: addStatementToSession(me string: stmt) <- {
        DB_session.writeEntry(stmt)
    }

    void: setStreamingMode(me bool: streamMode) <- {streamingMode <- streamMode}

    void: submitProteusResult(me uint64: originID, me uint64: pos, me string: mesg)  <- {print(mesg+"\n")}
    void: handleSystemError  (me uint64: originID, me string: mesg)  <- {print(mesg+"\n")}
    void: handleSyntaxError  (me uint64: originID, me string: mesg)  <- {print(mesg+"\n")}
    void: handleProteusError (me uint64: originID, me string: mesg)  <- {log(mesg)}
    me string: getOriginIDString(me uint64: originID) <- {
        if(streamLoader!=NULL){return(streamLoader!.getOriginIDString(originID))}
        return("source#"+toString(originID))
    }

    me bool: init(me string: worldFileName, me bool: streamingMode<-false) <- {
        errorMesg <- ""
        //log("WORLD:"+worldFileName)
        initHardFuncNames()
        setStreamingMode(streamingMode)
        Allocate(agent)
        agent!.init(this)
        defaultStreamLoader.init(agent, this)
        Allocate(agent!.kernel)
        agent!.kernel!.setToList()
        if(worldFileName!=""){
            if(!loadWorld(worldFileName)) {logFatalError(errorMesg)}
        }
        me string: fileDir <- getFilesDirAsString()+"/sessionDB.pr"
        annexSessions(fileDir)
        DB_session.openSession(fileDir)
        return(true)
    }

    me void: deInit() <- {
        if(streamLoader!=NULL){streamLoader!.shutdown()}
        if(agent!=NULL){agent!.close()}
        DB_session.closeSession()
    }
}

