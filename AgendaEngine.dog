// Owns the ordered rsInfon stage machine and its immediate-retry loop.
struct InfonProcessor{
    me AItemDispatchResult: process(their WorldManager: worldManager, their Agenda: agenda, our AItem: aItem, me int: alternativesNestLvl) <- {
        me bool: continueLoop <- true
        me AItemDispatchResult: result
        me string: idnt <- indentStr(aItem!.indentLvl)
        me string: endBracket <- ""
        while(continueLoop){
            continueLoop <- false // True: keep doing these steps now. False: Stop and wait for other agenda items to complete and fulfill your subscription.
            me bool: act          // Can be used to alter the next action for continueLoop
            if(aItem!.LHS_item!.pItem!.isNormed){
                aItem!.phase1RecordHandler("infon:alreadyNormed", false)
                result.fulfillSubscribers <- true
                //:l/PAI::logSegOut("NRMD")
                //:l/PAI::logSeg("{}")
                //:l/PAI::logFlush()
                break()
            }
            if(!aItem!.initRulesApplied){endBracket<-"{"; aItem!.phase1RecordHandler("infon:initRules", false)}
            worldManager!.initRules(aItem)

            if(aItem!.LHS_item!.pItem!.itmMode==mIncludeStream){ // Normalize the specified SUB-stream
                aItem!.phase1RecordHandler("infon:includeStream", false)
                //log("SUB_NORMING:"+aItem!.LHS_item!.pItem!.mySymbol()+" = "+aItem!.LHS_item!.pItem!.includeSpec)
                aItem!.LHS_item!.pItem!.itmMode <- mItem
                if(!aItem!.LHS_item!.hasPropagated){
                    if(!aItem!.dontProcess){
                        //:l/PAI::logSeg(" MG_SubNorm")
                        //log("SUB_PROPING:"+aItem!.stringify())
                        our AItem: nextAItem <- worldManager!.propagate(agenda, aItem,  aItem!.LHS_item, NULL, NULL, false, false, NULL)
                        if(nextAItem!=NULL){result.requestedWork.append(nextAItem)} // #include
                        aItem!.LHS_item!.hasPropagated <- true
                    }
                }
                aItem!.LHS_item!.pItem!.streamState <- parseStarted
                worldManager!.agent!.CORE!.normalizeFromStreamSpec(aItem!.LHS_item, aItem!.LHS_item!.pItem!.includeSpec)
                continueLoop <- false
            }
            else if(worldManager!.wordDefRules(aItem))          {aItem!.phase1RecordHandler("infon:wordDefRules", false); continueLoop <- true}
            else if(worldManager!.rangeRules(aItem))            {aItem!.phase1RecordHandler("infon:rangeRules", false); continueLoop <- true}
            else if(worldManager!.splitLangText(aItem))         {aItem!.phase1RecordHandler("infon:splitLangText", false); continueLoop <- true}
            else if(worldManager!.derefWordRules(aItem))        {aItem!.phase1RecordHandler("infon:derefWordRules", false); continueLoop <- true}
            else if(worldManager!.funcArgRules(aItem))          {aItem!.phase1RecordHandler("infon:funcArgRules", false); continueLoop <- true}
            else if(worldManager!.processEvalModes(
                    agenda, aItem, result.requestedWork)){
                aItem!.phase1RecordHandler("infon:funcAltRules", false)
                continueLoop <- false
            }
            else if(worldManager!.lookUpCursorRules(aItem)){
                aItem!.phase1RecordHandler("infon:lookUpCursorRules", false)
                worldManager!.partsRules(
                        agenda, aItem, act, result.requestedWork)
                continueLoop <- act
            }
            else if(worldManager!.normSize(
                    agenda, aItem, result.requestedWork)){
                aItem!.phase1RecordHandler("infon:normSize", false)
                continueLoop <- false
            }
            else if(worldManager!.localNullableContinuationRules(
                    agenda, aItem, act, result.requestedWork)){
                aItem!.phase1RecordHandler("infon:nullableContinuation", false)
                continueLoop <- act
            }
            else if(worldManager!.wrkLstRules(
                    agenda, aItem, result.requestedWork)){
                aItem!.phase1RecordHandler("infon:wrkLstRules", false)
                continueLoop <- false
            }
            else if(worldManager!.partsRules(
                    agenda, aItem, act, result.requestedWork)){
                aItem!.phase1RecordHandler("infon:partsRules", false)
                continueLoop <- act
            }
            else if(worldManager!.processConcat(aItem))         {aItem!.phase1RecordHandler("infon:processConcat", false); continueLoop <- true}
            else{
                aItem!.phase1RecordHandler("infon:completeOrWait", false)
                me int: readyPendingTasks <- aItem!.pendingTasks - aItem!.heldPendingTasks
                if(readyPendingTasks < 0){
                    log("WARNING!:"+aItem!.mySymbol()+"_PT="+toString(aItem!.pendingTasks)+" held="+toString(aItem!.heldPendingTasks)+":"+toString(aItem))
                }
                if(readyPendingTasks==0){
                    our infonView: CI <- aItem!.LHS_item!.pItem;
                    if(aItem!.heldPendingTasks>0){
                        aItem!.phase1RecordHandler("infon:heldPending", false)
                        if(CI!.doReply){
                            CI!.doReply <- false
                            log("DO_REPLY-PAI:"+CI!.mySymbol()+"  originID:"+toString(CI!.originID) + "  CI:"+shortedStr(toString(CI),100))
                            if(CI!.originID>0){
                                worldManager!.agent!.CORE!.submitProteusResult(CI!.originID, CI!.infCharPos, toString(CI))
                            }
                        }
                        worldManager!.collectQueuedPropagationWork(
                                agenda, result)
                        break()
                    }
                    worldManager!.cleanUpInfonView(aItem)
                    aItem!.phase1RecordHandler("infon:cleanUp", false)
                    if(CI!.cnvtToFunc){ //:l/PAI::logSeg(" ReFn")
                        aItem!.phase1RecordHandler("infon:reFunctionize", false)
                        //log("REFUNC:"+toString(CI))
                        reFunctionize(CI)
                        CI!.altRulesApplied <- false
                        continueLoop <- true
                        continue()
                    }
                    if(CI!.type!=NULL and CI!.type!.usePOS==posNoun and CI!.intersectPos==ipNoIntersect and aItem!.distanceToTop()<=2){ // Add this to context
                        worldManager!.agent!.context.addContextItem(aItem!.LHS_item!.dpItem())
                    }
                    CI!.wasProcessed <- true
                    if(CI!.doReply){
                        CI!.doReply <- false
                        log("DO_REPLY-PAI:"+CI!.mySymbol()+"  originID:"+toString(CI!.originID) + "  CI:"+shortedStr(toString(CI),100))
                        if(CI!.originID>0){
                            worldManager!.agent!.CORE!.submitProteusResult(CI!.originID, CI!.infCharPos, toString(CI))
                        }
                    }

                    worldManager!.collectQueuedPropagationWork(
                            agenda, result)

                    result.resumeParent <- true
                    result.fulfillSubscribers <- true
                } else {
                    //:l/PAI::logSeg(" TASKS>0:"+toString(aItem!.pendingTasks))
                }
            }
            printDebInf("PAI:INF", aItem!.LHS_item!.pItem)
            if(!continueLoop){if(aItem!.pendingTasks==0){endBracket<+-"}"} else if(endBracket==""){endBracket<-"}{"}}
        }
        return(result)
    }
}

// Owns only the rsMerge three-step control flow; MergeReasoner owns semantics.
struct MergeProcessor{
    me AItemDispatchResult: process(their WorldManager: worldManager, their Agenda: agenda, our AItem: aItem, me int: alternativesNestLvl) <- {
        me AItemDispatchResult: result
        me string: endBracket <- ""
        if(aItem!.step==0){
            me MergeStep0SemanticResult: step0Result <-
                    worldManager!.mergeReasoner.processStep0(worldManager, aItem)
            if(step0Result.action==ms0SingleSided){
                aItem!.step <- 2
                worldManager!.propagateProxy(agenda, aItem,
                        aItem!.LHS_item, NULL, NULL, false, false,
                        result)
                return(result)
            }
            if(step0Result.action==ms0RHSReady){aItem!.step <- 1}
        }
        if(aItem!.step==0){ //:l/PAI::logSeg(" MG0")
            aItem!.phase1RecordHandler("merge:step0:normalizeRHS", false)
            our AItem: PIVA <- worldManager!.prepareInfonWork(agenda, aItem!.RHS, aItem, NULL, aItem!.priority, srcMrg0)
            if(PIVA!=NULL){ //:l/PAI::logSeg(" RHS_PIVA:"+PIVA!.mySymbol())
                addDebugEvent("\nRegisterPIVA to norm RHS "+aItem!.RHS!.pItem!.mySymbol()+":"+toString(aItem!.RHS!.pItem)+"\n", aItem!.RHS!.pItem)
                // Preserve the outer relative-cursor context when normalizing nested RHS.
                if(aItem!.cursorAnchor!=NULL){PIVA!.cursorAnchor <- aItem!.cursorAnchor}
                else{PIVA!.cursorAnchor <- aItem!.LHS_item}
                result.requestedWork.append(PIVA)
            }
            aItem!.step <- 1
        }
        else if(aItem!.step==1){
            aItem!.phase1RecordHandler("merge:step1", false)
            me MergeStepSemanticResult: semanticResult <-
                    worldManager!.mergeReasoner.processStep1(
                            worldManager, agenda, aItem)
            withEach requestedAItem in semanticResult.requestedWork{
                result.requestedWork.append(requestedAItem)
            }
            if(semanticResult.advanceToStep2){aItem!.step <- 2}
            if(semanticResult.requestPropagation){
                worldManager!.propagateProxy(
                        agenda, aItem, aItem!.LHS_item,
                        semanticResult.propagationRHS,
                        semanticResult.propagationRemainder,
                        semanticResult.propagationLooseSize,
                        semanticResult.propagationDontEnque,
                        result)
            }
            if(semanticResult.completeSourceWork){
                result.completeSourceWork <- true
            }
            if(semanticResult.fulfillSubscribers){
                result.fulfillSubscribers <- true
            }
            if(semanticResult.stopCurrentDispatch){return(result)}
        } else if(aItem!.step==2){
            aItem!.phase1RecordHandler("merge:step2", false)
            me MergeStepSemanticResult: semanticResult <-
                    worldManager!.mergeReasoner.processStep2(aItem)
            if(semanticResult.requestPropagation){
                worldManager!.propagateProxy(
                        agenda, aItem, aItem!.LHS_item,
                        semanticResult.propagationRHS,
                        semanticResult.propagationRemainder,
                        semanticResult.propagationLooseSize,
                        semanticResult.propagationDontEnque,
                        result)
            }
            if(semanticResult.completeSourceWork){
                result.completeSourceWork <- true
            }
            if(semanticResult.fulfillSubscribers){
                result.fulfillSubscribers <- true
            }
            //:l/PAI::endBracket<-"{"
        }

        printDebInf("PAI:MRG", aItem!.LHS_item!.pItem)
        if(aItem!.pendingTasks==0){endBracket<-"{}"}
        return(result)
    }
}

// Owns the rsIntersect continuation state machine.
struct IntersectProcessor{
    me AItemDispatchResult: process(their WorldManager: worldManager, their Agenda: agenda, our AItem: aItem, me int: alternativesNestLvl) <- {
        me AItemDispatchResult: result
        me string: endBracket <- ""
        aItem!.phase1RecordHandler("intersect:step"+toString(aItem!.step), false)
        our infonView: CI   <- aItem!.LHS_item!.pItem
        switch(aItem!.step){
            case 0:{
                //:l/PAI::endBracket<-"{"
                worldManager!.infonViewReasoner.prepareIntersectionContext(
                        aItem)
                if(CI!.isOrLike()){
                    aItem!.phase1RecordHandler("intersect:normalizeAlternatives", false)
                    //:l/PAI::logSeg(" IC0_OR:[")
                    worldManager!.infonViewReasoner.
                            prepareIntersectionAlternatives(
                                    worldManager, agenda, aItem,
                                    result.requestedWork)
                    //:l/PAI::logSeg("]")
                } else {  // CI is FunctionLike
                    aItem!.phase1RecordHandler("intersect:normalizeFunction", false)
                    worldManager!.infonViewReasoner.prepareIntersectionFunction(
                            worldManager, agenda, aItem,
                            result.requestedWork)
                }
                aItem!.step <- 1
            }
            case 1:{
                //:l/PAI::logSeg(" IC1")
                //:l/PAI::endBracket<-"}"
                our infonView: newTop    <- NULL
                if(CI!.isOrLike()){  // Eliminate if only 1 non - reject.
                    aItem!.phase1RecordHandler("intersect:selectAlternative", false)
                    //:l/PAI::logSeg(" IS_OR_LIKE:"+aItem!.mySymbol())
                    newTop <- worldManager!.infonViewReasoner.
                            selectIntersectionAlternative(worldManager, aItem)
                } else {  // CI is FunctionLike
                    aItem!.phase1RecordHandler("intersect:selectFunctionResult", false)
                    //:l/PAI::logSeg(" FUNC")
                    newTop <- worldManager!.infonViewReasoner.
                            selectIntersectionFunctionResult(
                                    worldManager, aItem)
                }
                result.fulfillSubscribers <- true
                worldManager!.infonViewReasoner.installIntersectionResult(
                        aItem, newTop)
                aItem!.step <- 2
            }
        }
        return(result)
    }
}

// Routes agenda items to their structural processor without owning semantics.
struct AItemDispatcher{
    me InfonProcessor: infonProcessor
    me MergeProcessor: mergeProcessor
    me IntersectProcessor: intersectProcessor

    me AItemDispatchResult: dispatch(their WorldManager: worldManager, their Agenda: agenda, our AItem: aItem, me int: alternativesNestLvl) <- {
        me AItemDispatchResult: result
        switch(aItem!.ruleSet){
            case rsInfon:{return(infonProcessor.process(worldManager, agenda, aItem, alternativesNestLvl))}
            case rsMerge:{return(mergeProcessor.process(worldManager, agenda, aItem, alternativesNestLvl))}
            case rsIntersect:{return(intersectProcessor.process(worldManager, agenda, aItem, alternativesNestLvl))}
            case rsPure:{aItem!.phase1RecordHandler("pure:noOp", false); return(result)}
            default:{return(result)}
        }
        return(result)
    }
}
// Owns agenda execution and applies lifecycle around rule-set dispatch.
// Semantic helpers remain available through the active WorldManager.
struct AgendaEngine{
    me AItemDispatcher: dispatcher
    me AItemLifecycle: aItemLifecycle

    // Route the eval modes that are actionable at this point in the rsInfon stages.
    // Concat remains in its later stage so cursor, size, and parts processing retain
    // their existing precedence.
    me bool: processEvalModes(their Agenda: agenda, our AItem: aItem,
            their List<our AItem>: requestedWork) <- {
        our infonView: CI <- aItem!.LHS_item!.pItem
        if(CI!.altRulesApplied){return(false)}
        CI!.altRulesApplied <- true
        if(CI!.value!.evalMode==emIntersection){
            our AItem: newAItem <- prepareIntersectWork(
                    agenda, aItem!.LHS_item, aItem, aItem!.priority)
            if(newAItem!=NULL){requestedWork.append(newAItem)}
            return(true)
        }
        return(false)
    }

    // Construct ordinary infon work. The caller retains control of whether it is enqueued.
    our AItem: prepareInfonWork(their Agenda: agenda, our POV: pov, our AItem: subscriber, our AItem: aParent, me int64: priority, me aitemSrcID: source) <- {
        if(agenda!.povIsOnAgenda(pov)){return(NULL)}
        our AItem:: newAItem{source}
        newAItem!.ruleSet   <- rsInfon
        newAItem!.LHS_item  <- pov
        newAItem!.priority  <- priority
        newAItem!.step      <- 0
        newAItem!.indentLvl <- 0
        if(subscriber != NULL){
            newAItem!.subscribers.prepend(subscriber, 5)
            subscriber!.pendingTasks <+- 1
            //:l/PAI/PT::logSeg(" ++"+subscriber!.mySymbol()+"_PT:a="+toString(subscriber!.pendingTasks))
            newAItem!.indentLvl <- subscriber!.indentLvl+1
            newAItem!.cursorAnchor <- subscriber!.cursorAnchor
        }
        if(aParent != NULL){
            aParent!.taskEnqueued <- true
            newAItem!.parent <- aParent
            if(!(subscriber===aParent)) {
                aParent!.pendingTasks <+- 1
                //:l/PAI/PT::logSeg(" ++"+aParent!.mySymbol()+"_PT:b="+toString(aParent!.pendingTasks))
            }
            newAItem!.indentLvl <- aParent!.indentLvl+1
            newAItem!.cursorAnchor <- aParent!.cursorAnchor
        }else{
            //log("Parent_NULL; subscriber:"+subscriber!.mySymbol() +"  yields:"+newAItem!.mySymbol())
            //if(subscriber==NULL){log("// Proteus NOTICE: PIVA Parent_NULL; subscriber:"+subscriber!.mySymbol() +"  yields:"+newAItem!.mySymbol())}
        }
        return(newAItem)
    }

    // Construct merge work. The caller returns it to the engine.
    our AItem: prepareMergeWork(their Agenda: agenda, our POV: LHS, our POV: RHS, me bool: looseSize, our AItem: subscriber, our AItem: aParent, me int64: priority, me aitemSrcID: source) <- {
        our AItem:: newAItem{source}
        newAItem!.ruleSet   <- rsMerge
        newAItem!.LHS_item  <- LHS
        newAItem!.RHS       <- RHS
        newAItem!.looseSize <- looseSize
        newAItem!.priority  <- priority
        newAItem!.step      <- 0
        newAItem!.indentLvl <- 0
        aParent!.taskEnqueued <- true
        if(subscriber != NULL){
            newAItem!.subscribers.prepend(subscriber, 6)
            subscriber!.pendingTasks <+- 1
            //:l/PAI/PT::logSeg(" ++"+subscriber!.mySymbol()+"_PT:c="+toString(subscriber!.pendingTasks))
            newAItem!.indentLvl <- subscriber!.indentLvl+1
            newAItem!.cursorAnchor <- subscriber!.cursorAnchor
        }
        if(aParent != NULL){
            newAItem!.parent <- aParent
            if(!(subscriber===aParent)){
                aParent!.pendingTasks <+- 1
                //:l/PAI/PT::logSeg(" ++"+aParent!.mySymbol()+"_PT:g="+toString(aParent!.pendingTasks))
            }
        }else{
            //if(subscriber==NULL){log("// Proteus NOTICE: PMVA Parent_NULL; subscriber:"+subscriber!.mySymbol() +"  yields:"+newAItem!.mySymbol())}
            //if(aParent!.parent==NULL){log("// Proteus NOTICE: PMVA aParent!.parent==NULL;   yields:"+newAItem!.mySymbol())}
        }
        return(newAItem)
    }

    // Construct intersection work. The caller returns it to the engine.
    our AItem: prepareIntersectWork(their Agenda: agenda, our POV: pov, our AItem: subscriber, me int64: priority) <- {
        //log("processINTERSECTViaAgenda:"+ pov!.stringify())
        //if(subscriber!.parent!=NULL and subscriber!.parent!.LHSItr!=NULL){log("     LHSItr:"+subscriber!.parent!.LHSItr!.topPOV.stringify())}
        our AItem:: newAItem{srcPiCVA}
        newAItem!.ruleSet   <- rsIntersect
        newAItem!.LHS_item  <- pov
        newAItem!.priority  <- priority
        newAItem!.step      <- 0
        newAItem!.indentLvl <- 0
        if(subscriber != NULL){
            subscriber!.taskEnqueued <- true
            newAItem!.subscribers.prepend(subscriber, 7)
            subscriber!.pendingTasks <+- 1
            //:l/PAI/PT::logSeg(" ++"+subscriber!.mySymbol()+"_PT:d="+toString(subscriber!.pendingTasks))
            newAItem!.indentLvl <- subscriber!.indentLvl+1
            newAItem!.cursorAnchor <- subscriber!.cursorAnchor
            if(subscriber!.parent!=NULL){
                newAItem!.LHSItr <- subscriber!.parent!.LHSItr
                newAItem!.RHSItr <- subscriber!.parent!.RHSItr
            }
            newAItem!.parent <- subscriber
        }
        //:l/PAI::logSeg(" PIcVA:"+newAItem!.mySymbol())
        return(newAItem)
    }

    // Apply work returned by processors only after lifecycle effects from the
    // current dispatch have been completed.
    void: enqueueReturnedWork(their Agenda: agenda,
            their AItemDispatchResult: result) <- {
        withEach requestedAItem in result.requestedWork{
            agenda!.addAItemToAgenda(requestedAItem)
        }
    }

    // Root normalization is the one agenda entry that is not produced by an
    // active dispatch. Keep that insertion under the same queue owner.
    void: enqueueInitialWork(their Agenda: agenda, our AItem: aItem) <- {
        agenda!.addAItemToAgenda(aItem)
    }

    void: processAgendaItem(their WorldManager: worldManager, their Agenda: agenda, our AItem: aItem, me int: alternativesNestLvl) <- {
        aItemLifecycle.beginDispatch(aItem)
        me AItemDispatchResult: result <- dispatcher.dispatch(worldManager, agenda, aItem, alternativesNestLvl)
        aItemLifecycle.completeDispatch(agenda, aItem, result)
        enqueueReturnedWork(agenda, result)
    }

    void: processAgenda(their WorldManager: worldManager, their Agenda: agenda) <- {
        me Diagnostics: diagnostics
        diagnostics.beginAgenda(agenda)
        me int: count <- 0
        while(!agenda!.AItems.isEmpty()) {
            our AItem: aItem <- agenda!.AItems.popFirst()
            aItem!.runID <- agenda!.nextRunID
            agenda!.nextRunID <+- 1

            our AItemTrace: phase1Trace <- diagnostics.beginAItem(agenda, aItem)
            processAgendaItem(worldManager, agenda, aItem, 0)
            diagnostics.endAItem(agenda, aItem, phase1Trace)

            count <+- 1
        }
        diagnostics.completeAgenda(worldManager, agenda)
    }
}
