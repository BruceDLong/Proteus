// Agenda execution control for the active WorldManager.
// Semantic and lifecycle behavior remains delegated to WorldManager.
struct AgendaEngine{
    me AItemDispatcher: dispatcher

    void: processAgenda(their WorldManager: worldManager, their Agenda: agenda) <- {
        me Diagnostics: diagnostics
        diagnostics.beginAgenda(agenda)
        me int: count <- 0
        while(!agenda!.AItems.isEmpty()) {
            our AItem: aItem <- agenda!.AItems.popFirst()
            aItem!.runID <- agenda!.nextRunID
            agenda!.nextRunID <+- 1

            our AItemTrace: phase1Trace <- diagnostics.beginAItem(agenda, aItem)
            dispatcher.dispatch(worldManager, agenda, aItem, 0)
            diagnostics.endAItem(agenda, aItem, phase1Trace)

// These lines should NOT be here. But It is sometimes useful for experimental diagnostics.
// That is because a new aItem should be enqueued every single time through ProcessAgendaItem except the last time.
// So it should never be empty early.
// Remove them eventually when streaming works well enough.
//  if(agenda!.AItems.isEmpty()){addQueuedAItemsToAgenda(agenda)}
//  else{addQueuedAItemsToAgenda(agenda)}

            count <+- 1
        }
        diagnostics.completeAgenda(worldManager, agenda)
    }
}
