// This file implements parsing and printing of infons

struct parseContext:inherits=<mode[pcMainInfn, pcRHS, pcFuncLike, pcPartPaths, pcListSpec, pcDefn]>{}

struct infonView{
    flag: isFunc
    flag: isFuncArg
    flag: invertFunc
    mode[seprNone, seprComma, seprBar]: separator
    mode[notParsing, parseStarted, parseListReady, parseDone]: streamState

    void: moveThisToInnr() <- {
        Allocate(innr)
        innr!.infSize!      <- infSize!
        innr!.value!        <- value!
        innr!.itmMode      <- mItem
        innr!.viewMode      <- viewMode
        innr!.intersectPos <- ipNoIntersect
        innr!.argsOnLeft   <- argsOnLeft
        innr!.argPos       <- argPos
        innr!.funcArgs     <- funcArgs
        innr!.originID     <- originID
        innr!.isInnr       <- true
        innr!.intersectMarkedRetPOV <- intersectMarkedRetPOV
        value!.clear()
        infSize!.clear()
        argsOnLeft          <- false
        argPos              <- apNoArgs
        viewMode             <- vmOverlay
        value!.overlayType         <- tUnknown
        funcArgs            <- NULL
    }
}

#define WCHK_PEEK(POS,RET) <%if(posIsAtEOB_butNotClosed(POS)){return(RET)}else{peek<-text!.at(POS)}%>
#define CHK_PEEK(POS,RET)  <%if(waitingForBuffer(POS)){return(RET)}else{peek<-text!.at(POS)}%>
#define U_RETURN(RET)      <%pos! <- cPos; return(RET)%>

struct ppStatus:inherits=<mode[valid_EOB, valid_notDone, valid_maybeDone, valid_done, syntax_error, other_error]>{}
struct ProteusParser{
    their ProteusCore: CORE
    me bool: streamingMode
    uint64: originID
    their strBuf: text
    me string: errorMesg
    me bool: errorSet
    me int64: errAbsPos
    me int64: errLineNum
    me int64: errCharPos
    me int64: errorSuppressDepth

    void: notifyStreamState(our infonView: infn, me int: stateMrk) <- {
        //log("   NOTIFY:"+infn!.mySymbol()+" = "+shortedStr(toString(infn),120)+"  STATE:"+toString(stateMrk))
        {
            me MutexMngr: MtxMgr{streamingNormMutex}
            infn!.streamState <- stateMrk
        }
        streamingNormLock.notifyAll()
    }

    void: setErrorPos(me int64: errPos) <- {
        errAbsPos  <- errPos
        errLineNum <- 1
        errCharPos <- 1
        if(errPos < 0){return()}
        their strInnerBuf: bufWithChar <- text!.findInrBufWithPos(errPos)
        if(bufWithChar == NULL){return()}
        me int64: lastLinePos <- -1
        if(bufWithChar!.prev!=NULL){
            errLineNum <- bufWithChar!.prev!.endingLineNumber + 1
        }
        me int: bufSize <- bufWithChar!.buf.size()
        withEach idx in range 0 .. bufSize {
            if(bufWithChar!.myOffset + idx > errPos){
                break()
            }
            if(bufWithChar!.buf[idx] == "\n"){
                errLineNum <+- 1
                lastLinePos <- idx
            }
        }
        errCharPos <- errPos-(lastLinePos+bufWithChar!.myOffset)
    }
    me string: formattedError(me bool: includeStreamName <- true) <- {
        me string: msg <- "Parse error"
        if(errAbsPos >= 0){
            msg <- msg+" at "
            if(includeStreamName and text!=NULL and text!.streamName!=""){
                msg <- msg+text!.streamName+":"
            }
            msg <- msg+toString(errLineNum)+":"+toString(errCharPos)
        }
        if(errorMesg != ""){
            msg <- msg+": "+errorMesg
        }
        return(msg)
    }
    void: setError(me string: errMsg, me int64: errPos <- -1) <- {
        if(errorSuppressDepth > 0){return()}
        if(errorSet){return()}
        errorSet <- true
        errorMesg <- errMsg
        setErrorPos(errPos)
        if(CORE!=NULL){
            CORE!.handleSyntaxError(originID, formattedError(true))
        } else {
            print(formattedError(true)+"\n")
        }
    }
    void: clearError() <- {
        errorSet <- false
        errorMesg <- ""
        errAbsPos <- -1
        errLineNum <- 0
        errCharPos <- 0
    }
    me string: makeStr(me int64: startPos, me int64: endPos) <- {
        me string: S <- ""
        our strBufItr: txtItr <- text!.getItrAt(startPos)
        me int64: posCount <- startPos
        while(txtItr != NULL and txtItr!.status==bfOK and txtItr!.crntAbsPos()<endPos){
            me char: ch <- txtItr!.ch()
            S <- S+ch
            posCount <+- 1
            if(posCount==endPos){break()}
            txtItr!.goNext()
        }
        return(S)
    }
    me int64:  makeInt(me int64: startPos, me int64: endPos) <- {
        me string: S <- makeStr(startPos, endPos)
        me int64: N <- stol(S)
        return(N)
    }
    me BigInt: makeHexInt(me int64: startPos, me int64: endPos) <- {
        me string: S <- makeStr(startPos, endPos)
        me BigInt: N
        N.hexNumToBigInt(S)
        return(N)
    }
    me BigInt: makeBinInt(me int64: startPos, me int64: endPos) <- {
        me string: S <- makeStr(startPos, endPos)
        me BigInt: N
        N.binNumToBigInt(S)
        return(N)
    }

    me bool: chkPeek(their int64: pos, me char: peek, me string: str) <- {
        if(peek==str[0]){pos! <+- 1; return(true)}
        else{return(false)}
    }

///////////////////////////////////  Pre-parse checking

    me bool: waitingForBuffer(me int64: pos) <- {
        return(pos>=text!.crntStreamSize and !text!.bufferClosed)
    }
    me bool: posIsAtEOB_butNotClosed(their int64: pos) <- {
        me int64: cPos <- pos
        me ppStatus: status <- checkWSC(cPos)
        if(status==valid_done){pos! <- cPos}
        me bool: WFB <- waitingForBuffer(cPos)
        return(WFB)
    }
    me bool: statusOK(me ppStatus: statusIn, their ppStatus: statusOut) <- {
        statusOut! <- statusIn
        return(statusIn==valid_done or statusIn==valid_notDone or statusIn==valid_maybeDone)
    }
    me bool: statusNotDone(me ppStatus: statusIn, their ppStatus: statusOut) <- {
        statusOut! <- statusIn
        return(statusIn==valid_notDone or statusIn==valid_maybeDone or statusIn==other_error)
    }
    me ppStatus: preChkStr(their int64: pos, me string:str) <- {
        me int64: cPos <- pos
        me int64: len <- str.size()
        if(waitingForBuffer(cPos)){return(valid_notDone)}
        our strBufItr: txtItr <- text!.getItrAt(cPos)
        withEach i in range 0 .. len{
            if(txtItr == NULL or txtItr!.status!=bfOK){return(other_error)}
            if(txtItr!.ch() != str[i]){return(syntax_error)}
            cPos <+- 1
            if(i==len-1){break()}
            if(waitingForBuffer(cPos)){
                pos! <- cPos-1
                return(valid_notDone)
            }
            txtItr!.goNext()
        }
        pos! <- cPos
        return(valid_done)
    }
    me ppStatus: checkUntil(their int64: pos, me string:endStr) <- {
        me int64: cPos <- pos
        me char: ender <- endStr[0]
        if(waitingForBuffer(cPos)){return(valid_EOB)}
        our strBufItr: txtItr <- text!.getItrAt(cPos)
        while(txtItr != NULL and txtItr!.status==bfOK){
            me char: ch <- txtItr!.ch()
            if(ch==ender){
                me int64: endPos <- cPos
                me ppStatus: strChkStatus <- preChkStr(endPos, endStr)
                if(strChkStatus == valid_done){pos! <- endPos; return(valid_done)}
            }
            cPos <+- 1
            if(waitingForBuffer(cPos)){pos! <- cPos; return(valid_notDone)}
            txtItr!.goNext()
        }
        return(other_error)
    }
    me ppStatus: checkCComment(their int64: pos) <- {
        if(waitingForBuffer(pos!)){return(valid_EOB)}
        me char: ch <- text!.at(pos!)
        if(ch=="/"){
            if(waitingForBuffer(pos!+1)){return(valid_EOB)}
            me char: nextCh <- text!.at(pos!+1)
            if(nextCh=="/"){
                return(checkToEOL(pos))
            } else if(nextCh=="*"){
                pos! <+- 2
                return(checkUntil(pos, "*/"))
            }
        }
        return(syntax_error)
    }
    me ppStatus: checkWSC(their int64: pos) <- {
        me int64: cPos <- pos
        if(waitingForBuffer(cPos)){return(valid_EOB)}
        our strBufItr: txtItr <- text!.getItrAt(cPos)
        while(txtItr != NULL and txtItr!.status==bfOK){
            me int64: prevP <- cPos
            me char: ch <- txtItr!.ch()
            if(isspace(ch)){cPos <+- 1}
            else if(ch=="/"){
                me int64: endPos <- cPos
                me ppStatus: CCStatus <- checkCComment(endPos)
                if(CCStatus == valid_done){cPos <- endPos}
            }
            if(prevP == cPos){pos! <- cPos; return(valid_done)}
            if(waitingForBuffer(cPos)){pos! <- cPos; return(valid_notDone)}
            txtItr!.goNext()
        }
        return(other_error)
    }
    me ppStatus: checkWS(their int64: pos) <- {
        me int64: cPos <- pos
        if(waitingForBuffer(cPos)){return(valid_EOB)}
        our strBufItr: txtItr <- text!.getItrAt(cPos)
        while(txtItr != NULL and txtItr!.status==bfOK){
            me int64: prevP <- cPos
            me char: ch <- txtItr!.ch()
            if(isspace(ch)){cPos <+- 1}
            if(prevP == cPos){pos! <- cPos; return(valid_done)}
            if(waitingForBuffer(cPos)){pos! <- cPos; return(valid_notDone)}
            txtItr!.goNext()
        }
        return(other_error)
    }
    me ppStatus: escapedCheckUntil(their int64:pos, me string:endStr) <- {
        me int64: cPos <- pos
        me char: ender <- endStr[0]
        me string: escCharStr <- "\\ "
        me char: escChar <- escCharStr[0]
        me char: prevCh
        if(waitingForBuffer(cPos)){return(valid_notDone)}
        our strBufItr: txtItr <- text!.getItrAt(cPos)
        while(txtItr != NULL and txtItr!.status==bfOK){
            me char: ch <- txtItr!.ch()
            if(ch==ender and prevCh!=escChar){
                me int64: endPos <- cPos
                pos! <- endPos
                return(valid_done)
            }
            prevCh <- ch
            cPos <+- 1
            if(waitingForBuffer(cPos)){pos! <- cPos; return(valid_notDone)}
            txtItr!.goNext()
        }
        return(other_error)
    }
    me ppStatus: checkUTF8Char(their int64: pos, their int32: out) <- {
        if(waitingForBuffer(pos!)){return(valid_notDone)}
        our strBufItr: txtItr <- text!.getItrAt(pos!)
        me int: count <- 0
        me int: expectedBytes <- -1
        me string: bufr <- ""
        while(txtItr != NULL and txtItr!.status==bfOK){
            me char: ch <- txtItr!.ch()
            if(count==0){
                expectedBytes <- remainingOctets(ch) + 1
            }
            bufr  <+- ch
            count <+- 1
            if(count==expectedBytes){ break()}
            if(waitingForBuffer(pos!+count)){return(valid_notDone)}
            txtItr!.goNext()
        }
        if(count!=expectedBytes){return(other_error)}
        me int64: p<-0
        packUTF8Char(bufr, p, out)
        pos! <+- count
        return(valid_done)
    }
    me ppStatus: checkUintSeq(their int64: pos) <- {
        me int64: charsUsed <- 0
        if(waitingForBuffer(pos!)){return(valid_EOB)}
        our strBufItr: txtItr <- text!.getItrAt(pos!)
        while(txtItr != NULL and txtItr!.status==bfOK){
            me char: ch <- txtItr!.ch()
            if(!isdigit(ch)){
                if(charsUsed==0){return(syntax_error)}
                else{pos! <+- charsUsed; return(valid_done)}
            }
            charsUsed <+- 1
            if(waitingForBuffer(pos!+charsUsed)){return(valid_maybeDone)}
            txtItr!.goNext()
        }
        return(other_error)
    }
    me ppStatus: checkHexNum(their int64: pos) <- {
        me int64: charsUsed <- 0
        if(waitingForBuffer(pos!)){return(valid_notDone)}
        our strBufItr: txtItr <- text!.getItrAt(pos!)
        while(txtItr != NULL and txtItr!.status==bfOK){
            me char: ch <- txtItr!.ch()
            if(!isxdigit(ch)){
                if(charsUsed==0 or !isspace(ch)){return(syntax_error)}
                else{pos! <+- charsUsed; return(valid_done)}
            }
            charsUsed <+- 1
            if(waitingForBuffer(pos!+charsUsed)){return(valid_maybeDone)}
            txtItr!.goNext()
        }
        return(other_error)
    }
    me ppStatus: checkBinNum(their int64: pos) <- {
        me int64: charsUsed <- 0
        if(waitingForBuffer(pos!)){return(valid_notDone)}
        our strBufItr: txtItr <- text!.getItrAt(pos!)
        while(txtItr != NULL and txtItr!.status==bfOK){
            me char: ch <- txtItr!.ch()
            if(ch!="0" and ch!="1"){
                if(charsUsed==0 or !isspace(ch)){return(syntax_error)}
                else{pos! <+- charsUsed; return(valid_done)}
            }
            charsUsed <+- 1
            if(waitingForBuffer(pos!+charsUsed)){return(valid_maybeDone)}
            txtItr!.goNext()
        }
        return(other_error)
    }
    me ppStatus: checkUnicodeWordContinue(their int64: pos) <- {
        me int64: cPos <- pos
        me int64: charsUsed <- 0
        if(waitingForBuffer(cPos)){return(valid_notDone)}
        our strBufItr: txtItr <- text!.getItrAt(cPos)
        while(txtItr != NULL and txtItr!.status==bfOK){
            me int32: ch
            me ppStatus: status
            me int64: tempPos <- cPos
            if(!statusOK(checkUTF8Char(cPos, ch), status)){pos! <- cPos; return(status)}
            if (!(unicodeMgr.isUnicodeWordContinue(ch))){
                if(charsUsed==0){return(syntax_error)}
                else{pos! <- tempPos; return(valid_done)}
            }
            charsUsed <+- 1
            if(waitingForBuffer(cPos)){pos! <- cPos; return(valid_maybeDone)}
            txtItr!.goNext()
        }
        return(other_error)
    }
    me ppStatus: checkUniID(their int64: pos) <- {
        me int64: cPos <- pos
        me int32: ch
        me ppStatus: status
        if(!statusOK(checkUTF8Char(cPos, ch), status)){return(status)}
        if(unicodeMgr.isUnicodeWordStart(ch)){
            status <- checkUnicodeWordContinue(cPos)
            pos! <- cPos
            if(status==valid_notDone){return(valid_maybeDone)}
            return(status)
        }
        return(syntax_error)
    }
    me ppStatus: checkQuotedStr1(their int64: pos) <- {
        if(waitingForBuffer(pos!)){return(valid_notDone)}
        me char: peek <- text!.at(pos!)
        if(peek != "'"){return(syntax_error)}
        pos! <+- 1
        return(escapedCheckUntil(pos, "'"))
    }
    me ppStatus: checkQuotedStr2(their int64: pos) <- {
        if(waitingForBuffer(pos!)){return(valid_notDone)}
        me char: peek <- text!.at(pos!)
        if(peek != "\""){return(syntax_error)}
        pos! <+- 1
        return(escapedCheckUntil(pos, "\""))
    }
    me ppStatus: checkToEOL(their int64: pos) <- {
        return(checkUntil(pos, "\n"))
    }
    me ppStatus: preCheckWordDefn(their int64: pos) <- {
        me int64: cPos <- pos
        me ppStatus: status
        me char: peek; WCHK_PEEK(cPos,valid_notDone)
        if(statusOK(checkUniID(cPos), status)){
            me string: tag <- makeStr(pos!, cPos)
            WCHK_PEEK(cPos,valid_notDone)
            if(peek=="<"){
                cPos <+- 1
                WCHK_PEEK(cPos,valid_notDone)
                while(peek != ">"){
                    cPos <+- 1
                    WCHK_PEEK(cPos,valid_notDone)
                }
                cPos <+- 1
            }
            WCHK_PEEK(cPos,valid_notDone)
            if(peek!="="){return(syntax_error)}
            else{
                cPos <+- 1
                return(preCheckInfonView(cPos, true, pcDefn))
            }
        }
        return(valid_done)
    }
    me ppStatus: preCheckInfonState(their int64: pos, me parseContext: prsCtxt) <- {
        me int64: len
        me int64: cPos <- pos
        me char: peek; WCHK_PEEK(cPos,valid_notDone)
        if(chkPeek(cPos, peek, "_")){pos! <- cPos; return(valid_done)}
        if(chkPeek(cPos, peek, "$")){pos! <- cPos; return(valid_done)}
        me ppStatus: status
        if(isdigit(peek)){
            me bool: numNotLoaded <- true
            if(peek=="0"){
                if(waitingForBuffer(cPos+1)){
                    len <- cPos
                    return(valid_maybeDone)
                }
                me char: peek2 <- toUpper(text!.at(cPos+1))
                if(peek2=="X"){
                    cPos <+- 2
                    len  <+- 2
                    status <- checkHexNum(cPos)
                    if(status==-1){print("WARNING: status=-1 from checkHexNum\n")}
                    numNotLoaded <- false
                    return(status)
                }
                if(peek2=="B"){
                    cPos <+- 2
                    status <- checkBinNum(cPos)
                    if(status==-1){print("WARNING: status=-1 from checkBinNum\n")}
                    numNotLoaded <- false
                    return(status)
                }
            }
            if(numNotLoaded){
                status <- checkUintSeq(cPos)    // TODO chage to checkFlexNum
                if(status==valid_done){pos! <- cPos}
                return(status)
            }
        }else if(peek=="\'"){
            status <- checkQuotedStr1(cPos)
            return(status)
        }else if(peek=="\""){
            status <- checkQuotedStr2(cPos)
            return(status)
        } else if(peek=="{" or peek=="[" or peek=="("){
            // TODO:
            cPos <+- 1
        }
        return(valid_done)
    }
    me ppStatus: preCheckFileID(their int64: pos) <- {
        me int64: cPos <- pos
        me ppStatus: status
        me char: peek; WCHK_PEEK(cPos,valid_notDone)
        if(statusOK(checkToEOL(cPos), status)){
            me string: includeSpec <- makeStr(pos!, cPos)
            trimWS(includeSpec)
            // TODO: check for valid or likely valid resourseID
        }
        return(valid_done)
    }
    me ppStatus: preCheckListItem(their int64: cPos, me parseContext: prsCtxt) <- {
        // TODO: verify this works properly with ppStatus
        me ppStatus: status
        me char: peek;
        WCHK_PEEK(cPos!,valid_notDone)
        if(chkPeek(cPos, peek, "@"))                      {return(preCheckWordDefn(cPos))}
        else if(chkPeek(cPos, peek, "&"))                 {return(preCheckInfonView(cPos, true, prsCtxt))}
        else if(statusOK(preChkStr(cPos, "%INSERT"), status))           {return(status)}
        else if(statusOK(preChkStr(cPos, "%PROTEUS"), status))          {return(status)}
        else if(peek=="." and statusOK(preChkStr(cPos, "..."), status)) {
            if(text!.interactiveMode and prsCtxt==pcMainInfn){
                //setError("... not allowed in main infon in interactive mode")
                return(syntax_error)
            }
            return(status)
        }
        return(preCheckInfonView(cPos, true, prsCtxt))
    }
    me ppStatus: preCheckFuncParts(their int64: pos, me bool: allowIDs) <- {
        me int64: cPos <- pos
        me ppStatus: status
        me char: peek; WCHK_PEEK(cPos,valid_maybeDone)
        // WORK_LIST
        if(allowIDs){
            if(statusNotDone(preChkStr(cPos, "<<"), status)){U_RETURN(status)}
            CHK_PEEK(cPos,valid_notDone)
            while(peek == "="){
                cPos <+- 1
                CHK_PEEK(cPos,valid_notDone)
                if(chkPeek(cPos, peek, "=")){CHK_PEEK(cPos,valid_notDone)}
                if(chkPeek(cPos, peek, ":")){CHK_PEEK(cPos,valid_notDone)}
                if(statusNotDone(preCheckInfonView(cPos, false, pcRHS), status)){U_RETURN(status)}
                WCHK_PEEK(cPos,valid_maybeDone)
            }
        }
        // TODO: finish
        // FUNC_LIKE
        WCHK_PEEK(cPos,valid_maybeDone)
        if(peek=="<" or peek==":" or peek=="!"){
            me string: op <- ""+ peek
            CHK_PEEK(cPos,valid_notDone)
            op <+- peek
            if(op != "<:" and op != ":>" and op != "<!" and op != "!>" and op != "<~"){return(syntax_error)}
            WCHK_PEEK(cPos,valid_notDone)
            if(statusNotDone(preCheckInfonView(cPos, true, pcFuncLike), status)){U_RETURN(status)}
            WCHK_PEEK(cPos,valid_maybeDone)
        }

        // PART_PATHS
        while(peek=="." or peek=="^" or peek=="#"){
            CHK_PEEK(cPos,valid_notDone)
            if(peek == '.'){return(syntax_error)}

            if(statusNotDone(preCheckInfonView(cPos, true, pcPartPaths), status)){U_RETURN(status)}
            WCHK_PEEK(cPos,valid_maybeDone)
            if(chkPeek(cPos, peek, ";")){WCHK_PEEK(cPos,valid_maybeDone)}
            else {break()}
        }
        U_RETURN(valid_done)
    }
    me ppStatus: preCheckInnerInfonView(their int64: pos, me parseContext: prsCtxt) <- {
        me int64: cPos <- pos
        me ppStatus: status
        me char: peek; WCHK_PEEK(cPos,valid_notDone)
        if(chkPeek(cPos, peek, "?"))         {pos! <- cPos; return(valid_done)}
        else if(chkPeek(cPos, peek, "%"))    {
            CHK_PEEK(cPos,valid_notDone)
            if(cPos==pos!){return(valid_notDone)}
            me string: tag <- makeStr(pos!+1, cPos+1)
            me string: firstCH <- tag.subStr(0,1)
            switch(firstCH){
                case "s":{if(statusOK(preChkStr(cPos, "self"), status)) {pos! <- cPos; return(status)}}
                case "W":{if(statusOK(preChkStr(cPos, "W"), status))    {return(status)}}
                case "U":{if(statusOK(preChkStr(cPos, "U"), status))    {return(status)}}
                case "c":{if(statusOK(preChkStr(cPos, "ctx"), status))  {return(status)}}
                case "a":{if(statusOK(preChkStr(cPos, "args"), status)) {return(status)}}
                case "v":{if(statusOK(preChkStr(cPos, "vars"), status)) {return(status)}}
                default:{setError("Invalid %tag '%"+tag+"'", pos!); return(syntax_error)}
            }
        } else { //*_+...
            me bool: requirePlusMinusSign <- false
            if(peek=="*" or peek=="/"){
                cPos <+- 1
                WCHK_PEEK(cPos,valid_notDone)
                status <- preCheckInfonState(cPos, prsCtxt) // TODO: This should always be numeric
                if(status!=valid_done){
                    if(status==valid_maybeDone){status <- valid_notDone}
                    return(status)
                }
                requirePlusMinusSign <- true
                status <- valid_notDone
            }
            if(peek=="+" or peek=="-"){
                cPos <+- 1
                WCHK_PEEK(cPos,valid_notDone)
                status <- preCheckInfonState(cPos, prsCtxt)
                if(status==valid_done){pos! <- cPos}
                return(status)
            } else if(requirePlusMinusSign){
                WCHK_PEEK(cPos,valid_notDone)
                if(peek!="+" and peek!="-"){
                    return(syntax_error)
                }
                cPos <+- 1
                WCHK_PEEK(cPos,valid_notDone)
                status <- preCheckInfonState(cPos, prsCtxt)
                if(status==valid_done){pos! <- cPos}
                return(status)
            } else {
                WCHK_PEEK(cPos,valid_notDone)
                status <- preCheckInfonState(cPos, prsCtxt)
                if(status==valid_done){pos! <- cPos}
                return(status)
            }
        }
        return(valid_done)
    }
    me ppStatus: preCheckInfonView(their int64: pos, me bool: allowIDs, me parseContext: prsCtxt) <- {
        me int64: cPos <- pos
        me ppStatus: status
        me char:  peek; WCHK_PEEK(cPos,valid_notDone)
        me bool:  fetchInnerInfon <- true
        if(chkPeek(cPos, peek, "!")){WCHK_PEEK(cPos,valid_notDone)}
        if(statusOK(checkUniID(cPos), status)){
            WCHK_PEEK(cPos,valid_maybeDone)
            if(chkPeek(cPos, peek, ":")){WCHK_PEEK(cPos,valid_notDone)}
            else{fetchInnerInfon<-false}
        }
        if(fetchInnerInfon){
            status <- preCheckInnerInfonView(cPos, prsCtxt)//setError("Literal infon or %tag expected")}
        }
        pos! <- cPos
        if(status!=valid_done){return(status)}
        WCHK_PEEK(cPos,valid_done)
        pos! <- cPos
        // TODO:
        return(preCheckFuncParts(cPos, allowIDs))
    }

/////////////////////////////////// Parsers

    me char: peekWSC(their int64: cPos)<-{
        cPos! <+- text!.scrapeWSC(cPos!)
        return(text!.at(cPos!))
    }
    me bool: chk(me int64: rLen, their int64: pos, their int64: outLen) <- {
        if(rLen>0){pos! <+- rLen; outLen! <- rLen; return(true)}
        return(false)
    }
    me bool: chkStr(their int64: cPos, me string: str) <- {
        me int64: len <- text!.chkStr(cPos!, str)
        if(len>=0){
            cPos! <+- len
            return(true)
        }
        return(false)
    }
    me bool: chkStrWSC(their int64: cPos, me string: str)<-{
        cPos! <+- text!.scrapeWSC(cPos!)
        return(chkStr(cPos!, str))
    }

    me int64: scrapeWordChain(me int64: pos) <- {  // AlphaNum, underscore, hyphen, TODO: whitespace
        me int64: cPos <- pos
        me int32: ch
        cPos <+- text!.scrapeUTF8Char(cPos, ch)
        if(cPos==pos){return(-1)}
        if(unicodeMgr.isUnicodeWordStart(ch)){
            our strBufItr: txtItr <- text!.getItrAt(pos)
            while(txtItr != NULL and txtItr!.status==bfOK){
                me int64: len <- text!.scrapeUTF8Char(cPos, ch)
                if(len > 0){
                    if(unicodeMgr.isUnicodeWordContinue(ch)){cPos <+- len}
                    else{
                        if(!(ch=='_' or ch=='-')){// or isspace(ch))){
                            return(cPos-pos)
                        }
                    }
                }else{
                    return(cPos-pos)
                }
                txtItr!.goNext()
            }
            return(cPos-pos)
        }
        return(-1)
    }
    me int64: parseWordDefn(our infonView: infn, me int64: pos) <- {
        me int64: cPos <- pos
        me int64: len
        cPos <+- text!.scrapeWSC(cPos)
        if(chk(text!.scrapeUniID(cPos), cPos,len)){
            Allocate(infn!.definedWord)
            infn!.definedWord!.defWord <- makeStr(cPos-len, cPos)
            if(peekWSC(cPos)=="<"){
                cPos <+- 1
                while(peekWSC(cPos) != ">"){
                    if(chk(text!.scrapeUniID(cPos), cPos,len)){
                        me string: usageTag <- makeStr(cPos-len, cPos)
                        trimWS(usageTag)
                        infn!.definedWord!.UsageTags.append(usageTag)
                    } else{}
                }
                chkStr(cPos,">")
            }
            me int64: eqPos <- cPos
            eqPos <+- text!.scrapeWSC(eqPos)
            if(text!.at(eqPos)!="="){setError("Expected '=' in the definition of "+infn!.definedWord!.defWord, eqPos)}
            else{
                cPos <- eqPos + 1
                our infonView:: defMeaning
                defMeaning!.originID <- infn!.originID
                cPos <+- parseInfonView(defMeaning, cPos, true, true, pcDefn)
                infn!.funcArgs <- defMeaning
            }
        } else{setError("Expected a word name after '@'", cPos)}

        if(errorSet){return(-1)}
        return(cPos-pos)
    }

    me int64: parseListInfo(their infonState: pureInfn, their infonState: sizeSlot, me int64: pos, our infonView: parent, me bool: isFromDefn) <- {
        me int64: cPos <- pos
        me int64: len

        me bool: infonFound <- false
        if(chkStrWSC(cPos,"T")){pureInfn!.timelike<-true}
        // Read optional ~size
        if(chkStrWSC(cPos,"~")){
            // Read optional inner ~size.  It is syntactic sugar for the
            // size slot belonging to this pure infon; do not store a second copy.
            if(pureInfn!.sizeMode==fromGiven){
                setError("Infon size cannot be specified both outside and inside the list", cPos-1)
                return(-1)
            }
            if(sizeSlot==NULL){
                setError("Inner list size has no enclosing infon size slot", cPos-1)
                return(-1)
            }
            me int64: sizeLen <- parseInfonState(sizeSlot, cPos, parent, isFromDefn, pcListSpec)
            if(sizeLen <= 0){
                if(!errorSet){setError("Expected a list size after '~'", cPos)}
                return(-1)
            }
            cPos <+- sizeLen
            if(sizeSlot!.overlayType!=NUM){
                setError("Size of infons must be numeric")
                return(-1)
            }
            pureInfn!.sizeMode <- fromGiven
            pureInfn!.sizeWasInner <- true
        }

        me char: peek <- peekWSC(cPos)
        if(peek=="." or peek=="@" or peek=="&" or peek=="%"){return(-1)} // Skip checking if list item
        me uint64: prevPos <- cPos
        our infonView:: item
        item!.originID <- parent!.originID
        errorSuppressDepth <- errorSuppressDepth + 1
        me int64: itemLen <- parseInfonView(item, cPos, true, isFromDefn, pcListSpec)
        errorSuppressDepth <- errorSuppressDepth - 1
        if(chk(itemLen, cPos,len)){
            infonFound <- true
        }
        if(peekWSC(cPos)=="|"){
            cPos <+- 1
            if(infonFound){pureInfn!.listSpec <- item}
            else {pureInfn!.listSpec <- NULL}
        } else {
            cPos <- prevPos
        }

        if(errorSet){return(-1)}
        return(cPos-pos)
    }

    me int64: parseListItem(our infonView: infn, their infonState: pureInfn, our infonView: parent, me int64: pos, me bool: isFromDefn, me parseContext: prsCtxt) <- {
        me int64: cPos <- pos
        me int64: len

        me bool: itemWasAppended <- false
        me bool: intersectGetMarked <- false

        me char: peek <- peekWSC(cPos)
        me bool: isSubItm <- false
        if(chkPeek(cPos, peek, "@")){
            infn!.itmMode <- mWordDefn
            if(chk(parseWordDefn(infn, cPos), cPos,len)){}
            notifyStreamState(infn, parseDone)
        } else if(peek=="." and chkStr(cPos, "...")){
            // if(text!.interactiveMode and prsCtxt==pcMainInfn){
            //     setError("... not allowed in main infon in interactive mode")
            //     return(-1)
            // }
            isSubItm            <- true
            infn!.viewMode        <- vmOverlay
            infn!.infSize!.evalMode <- emUnknown
            infn!.value!.evalMode   <- emLiteral
            infn!.value!.overlayType    <- LST
            infn!.value!.tailUnfinished  <- true
            notifyStreamState(infn, parseDone)
        } else if(chkStr(cPos, "%INSERT")){
            infn!.itmMode <- mIncludeStream
            if(chk(text!.scrapeToEOL(cPos), cPos,len)){
                infn!.includeSpec <- makeStr(cPos-len, cPos)
                trimWS(infn!.includeSpec)
                notifyStreamState(infn, parseDone)
            } else{
                setError("Expected a resource name after %INSERT", cPos)
                return(-1)
            }
        } else if(chkStr(cPos, "%PROTEUS")){
            infn!.itmMode <- mIncludeParseStr
            our infonView:: item
            item!.originID <- infn!.originID
            cPos <+- parseInfonView(item, cPos, true, isFromDefn, prsCtxt)
            infn!.includeInfn <- item
            notifyStreamState(infn, parseDone)
        } else {
            if(parent!.value!.intersectPosParse == ipSquareBrackets){
                if(chkPeek(cPos, peek, "<")){
                    peek <- peekWSC(cPos)
                    if(intersectGetMarked == true){setError("Multiple <...> selectors in one [...] list are not supported", cPos-1)}
                    else{
                        parent!.intersectPos <- ipGetMarked
                        intersectGetMarked <- true
                    }
                }
            }
            if(chkPeek(cPos, peek, "&")){
                isSubItm <- true
                cPos <+- parseInfonView(infn, cPos, true, isFromDefn, prsCtxt)
            } else {
            log("1 Parsing pure infon as list item at pos " + toString(cPos) + "\n")
                infn!.itmMode <- mItem
                infn!.streamState <- parseStarted
                our POV: appendedPOV <- pureInfn!.items.append(infn, false, 301)
                if(intersectGetMarked){parent!.intersectMarkedRetPOV <- appendedPOV}
                itemWasAppended <- true
                if(parent!=NULL and pureInfn!.items.size()==1){notifyStreamState(parent, parseListReady)}
                cPos <+- parseInfonView(infn, cPos, true, isFromDefn, prsCtxt, false)
            log("2 Finished parsing pure infon as list item at pos " + toString(cPos) + "\n")
                if(chkStrWSC(cPos, "`")){
                    log("3 Marking infon item for reply in ParselistItem at pos " + toString(cPos) + "\n")
                    infn!.doReply<-true
                log("4 Infon item marked for reply at pos " + toString(cPos) + "\n")
                }
                    notifyStreamState(infn, parseDone)
            log("5 Notified "+infn!.mySymbol()+" at pos " + toString(cPos) + "\n")
    // BUG: IF there is no '`' then the infon remains in parseStarted state
            }

            if(intersectGetMarked){
                peek <- peekWSC(cPos)
                if(!chkPeek(cPos, peek, ">")){
                  setError("Expected '>' to close the marked selector", cPos)
                }
            }
        }
        if(!itemWasAppended){
            our POV: appendedPOV <- pureInfn!.items.append(infn, isSubItm, 303)
            if(intersectGetMarked){parent!.intersectMarkedRetPOV <- appendedPOV}
            if(parent!=NULL and pureInfn!.items.size()==1){notifyStreamState(parent, parseListReady)}
        }

        if(errorSet){return(-1)}
        return(cPos-pos)
    }

    me int64: parseInfonState(their infonState: pureInfn, me int64: pos, our infonView: parent, me bool: isFromDefn, me parseContext: prsCtxt, their infonState: sizeSlot <- NULL) <- {
        me int64: cPos      <- pos
        me int64: len
        pureInfn!.isFromDefn <- isFromDefn

        me char: peek <- peekWSC(cPos)
        if(isdigit(peek) or peek=="_"){
            pureInfn!.overlayType <- NUM
            if(chkPeek(cPos, peek, "_")){pureInfn!.evalMode <- emUnknown; pureInfn!.num<-0;}
            else{ // isDigit
                me bool: numNotLoaded <- true
                if(peek=="0"){
                    me char: peek2 <- toUpper(text!.at(cPos+1))
                    if(peek2=="X"){
                        cPos <+- 2
                        if(chk(text!.scrapeHexNum(cPos), cPos,len)){
                            pureInfn!.num <- makeHexInt(cPos-len, cPos)
                            pureInfn!.evalMode <- emLiteral
                            pureInfn!.numBase <- bHex
                            numNotLoaded <- false
                        }
                    }
                    if(peek2=="B"){
                        cPos <+- 2
                        if(chk(text!.scrapeBinNum(cPos), cPos,len)){
                            pureInfn!.num <- makeBinInt(cPos-len, cPos)
                            pureInfn!.evalMode <- emLiteral
                            pureInfn!.numBase <- bBin
                            numNotLoaded <- false
                        }
                    }
                }
                if(numNotLoaded){
                    if(chk(text!.scrapeFlexNum(cPos), cPos,len)){
                        pureInfn!.num <- makeStr(cPos-len, cPos)
                        pureInfn!.evalMode <- emLiteral
                        pureInfn!.numBase <- bDec
                    }
                }
            }
        } else if(peek=="\'" or peek=="\"" or peek=="$"){
            pureInfn!.overlayType <- STR
            if(chkPeek(cPos, peek, "$")){pureInfn!.evalMode <- emUnknown; pureInfn!.str<-""}
            else if(peek=="\'"){
                if(chk(text!.scrapeQuotedStr1(cPos), cPos,len)){
                    pureInfn!.str <- makeStr((cPos-len)+1, cPos-1)
                    pureInfn!.evalMode <- emLiteral
                    //pureInfn.quoteType <- qSingle
                }
            }
            else if(peek=="\""){
                if(chk(text!.scrapeQuotedStr2(cPos), cPos,len)){
                    pureInfn!.str <- makeStr((cPos-len)+1, cPos-1)
                    pureInfn!.evalMode <- emLiteral
                    //pureInfn.quoteType <- qDouble
                }
            }
        } else if(peek=="{" or peek=="[" or peek=="("){
            cPos <+- 1
            pureInfn!.overlayType <- LST
            me char: ender
            me string: tmp<-"}])"
            if     (peek=="{"){pureInfn!.evalMode <- emLiteral; pureInfn!.intersectPosParse<-ipDefault;        ender<-tmp[0]}
            else if(peek=="["){pureInfn!.evalMode <- emLiteral; pureInfn!.intersectPosParse<-ipSquareBrackets; ender<-tmp[1]}
            else if(peek=="("){pureInfn!.evalMode <- emConcat;  pureInfn!.intersectPosParse<-ipDefault;        ender<-tmp[2]}

            if(chk(parseListInfo(pureInfn, sizeSlot, cPos, parent, isFromDefn), cPos,len)){
            } else if(errorSet){
                return(-1)
            }

            me int64: count<-0
            while(peekWSC(cPos) != ender){
                text!.consumerStatus <- 0
                //~ while(text!.interactiveMode){
                    //~ text!.consumerStatus <- preCheckListItem(cPos)
                    //~ print("LOOP: cPos",cPos,"  status: ", text!.consumerStatus,"... \n")
                    //~ if(text!.consumerStatus!=valid_done or text.pre_parse_only){me MutexMngr: bufMtxMgr{text.bufMutex} text.bufLock.wait(bufMtxMgr)}
                    //~ else{text.pre_parse_only <- true; break()}
                //~ }
                our infonView:: item
                item!.originID <- parent!.originID
                item!.streamState <- parseStarted
                me int64: itemLen <- parseListItem(item, pureInfn, parent, cPos, isFromDefn, prsCtxt)
                if(chk(itemLen, cPos,len)){
                    //print("PARSED:",shortedStr(toString(item),100),"\n")
                    log("Back to parseInfonState after parsing list item at pos " + toString(cPos))
                    peek <- peekWSC(cPos)
                    log("Checking separator at pos " + toString(cPos) + ": " + peek)
                    if(chkPeek(cPos, peek, ",")){
                        log("Found ',' separator at pos " + toString(cPos) + "\n")
                        if(ender!="}"){setError("',' is only allowed in {...} lists", cPos-1)}
                        if(parent!.separator==seprNone){parent!.separator <- seprComma; parent!.orderMode <- uUnordered}
                        else if(parent!.separator!=seprComma){setError("List separators must stay consistent", cPos-1)}
                        // // The following is for [ 1 | 2 | 3 ] syntactic sugar.
                        //else if(chkPeek(cPos, peek, "|")){
                        //    if(ender!="]"){setError("'|' as a separator is only allowed in [...] lists.")}
                        //    if(count==0){parent!.separator <- seprBar}
                        //    else if(parent!.separator!=seprBar){setError("Separator must remain '|'")}
                        //}
                    }
                } else {
                    if(itemLen < 0){return(-1)}
                    if(waitingForBuffer(cPos)){break()}
                    setError("Expected a list item", cPos)
                    return(-1)
                }
                count <+- 1
            }
            cPos <+- 1

            // If the last item is ..., merge/remove it.
            if(pureInfn!.items.size() > 0){
                our POV: lastPOV    <- pureInfn!.items.back()
                our infonView: lastItem <- lastPOV!.pItem
                if(lastItem!.value!.tailUnfinished and lastPOV!.isSubItm and lastItem!.infSize!.evalMode == emUnknown and !(parent!.intersectPos==ipGetMarked and parent!.intersectMarkedRetPOV===lastPOV)){
                    pureInfn!.tailUnfinished <- true
                    pureInfn!.items.popLast()
                }
            }
        }

        else{
            setError("Expected a number, string, '$', '_', or list literal", cPos)
            return(-1)
        }

        if(errorSet){return(-1)}
        return(cPos-pos)
    }

    me int64: parseFuncParts(our infonView: infn, me int64: pos, me bool: allowIDs, me bool: isFromDefnn) <- {
        me int64: cPos <- pos
        // FUNC_LIKE
        me bool: isAFunc <- true
        me char: peek <- peekWSC(cPos)
        if(peek=="<" or peek==":" or peek=="!"){ // TODO: The '<' here slightly conflicts with the [ <...> ...] syntax.
            me char: peek2 <- text!.at(cPos+1)
            me string: opStr <- ""; opStr <+- peek; opStr <+- peek2
            if     (opStr=="<:"){infn!.isFunc <- true;  infn!.isFuncArg <- false; infn!.invertFunc <- false; cPos<+-2}
            else if(opStr==":>"){infn!.isFunc <- false; infn!.isFuncArg <- true;  infn!.invertFunc <- false; cPos<+-2}
            else if(opStr=="<!"){infn!.isFunc <- true;  infn!.isFuncArg <- false; infn!.invertFunc <- true;  cPos<+-2}
            else if(opStr=="!>"){infn!.isFunc <- false; infn!.isFuncArg <- true;  infn!.invertFunc <- true;  cPos<+-2}
            else if(opStr=="<~"){infn!.hasInnrOutr <- true;  cPos<+-2}
            else {isAFunc <- false}

            if(isAFunc){
                our infonView:: funcArg
                funcArg!.originID <- infn!.originID
                me bool: argAllowIDs <- true
                if(opStr=="<~"){argAllowIDs <- false}
                cPos <+- parseInfonView(funcArg, cPos, argAllowIDs, isFromDefn, pcFuncLike)
                infn!.funcArgs <- funcArg
                peek <- peekWSC(cPos)
            }
        }

        // Allow work-list operations to bind to function-like expressions such as
        // [selector] <~ source = value, instead of being swallowed by the <~ source.
        if(allowIDs){
            me bool: forceID <- false
            if(chkStrWSC(cPos,"<<")){forceID<-true}
            while(peekWSC(cPos) == "="){
                our POV:: pov{303}
                pov!.forceID <- forceID
                if(chkStr(cPos, "==")){pov!.looseMode <- true}
                else if(chkStr(cPos, "=")){pov!.looseMode <- false}
                if(chkPeek(cPos, text!.at(cPos), ":")){pov!.looseTop <- true}
                our infonView:: RHS
                RHS!.originID <- infn!.originID
                cPos <+- parseInfonView(RHS, cPos, false, isFromDefn, pcRHS)
                pov!.pItem <- RHS
                infn!.wrkList.append(pov)
            }
        }

        // PART_PATHS
        while(peek=="." or peek=="^" or peek=="#"){
            if(text!.at(cPos+1)=="."){break()}
            cPos<+-1
            our PartPath:: part
            if(peek=="."){      part!.pathMode <- dotField}
            else if(peek=="^"){ part!.pathMode <- upField}
            else if(peek=="#"){ part!.pathMode <- idxField}
            our infonView:: pathSeg
            pathSeg!.originID <- infn!.originID
            cPos <+- parseInfonView(pathSeg, cPos, allowIDs, isFromDefn, pcPartPaths)
            part!.path <- pathSeg
            peek <- peekWSC(cPos)

            if(part!.pathMode==idxField and peek==":"){
                cPos<+-1
                our infonView:: pathSpecSeg
                pathSpecSeg!.originID <- infn!.originID
                cPos <+- parseInfonView(pathSpecSeg, cPos, allowIDs, isFromDefn, pcPartPaths)
                part!.spec <- pathSpecSeg
            }

            if(chkPeek(cPos, peek, ";")){
                part!.hasSemiColon <- true
                infn!.parts.append(part)
                peek <- peekWSC(cPos)
            }else{
                infn!.partRef <- part
                break()
            }
        }

        if(errorSet){return(-1)}
        return(cPos-pos)
    }
    me int64: parseInnerInfonView(our infonView: infn, me int64: pos, me bool: isFromDefn, me parseContext: prsCtxt) <- {
        me int64: cPos <- pos
        me int64: len

        me char: peek <- text!.at(cPos)
        if(chkPeek(cPos, peek, "?")){
            infn!.viewMode        <- vmAny
            infn!.value!.evalMode   <- emUnknown
            infn!.infSize!.evalMode <- emUnknown
        } else if(chkPeek(cPos, peek, "%")){
            infn!.viewMode <- vmCursor
            if(chk(text!.scrapeCID(cPos), cPos,len)){
                me string: tag <- makeStr(cPos-len, cPos)
                switch(tag){
                    case "self":{infn!.cursorMode <- cThis}
                    case "W":   {infn!.cursorMode <- cWorld}
                    case "U":   {infn!.cursorMode <- cUser}
                    case "ctx": {infn!.cursorMode <- cContext}
                    case "args":{infn!.cursorMode <- cArgs}
                    case "vars":{infn!.cursorMode <- cVars}
                    case "prev":{infn!.cursorMode <- cPrev}
                    case "next":{infn!.cursorMode <- cNext}
                    default:{setError("Invalid %tag '%"+tag+"'", cPos-len-1)}
                }
            } else {infn!.cursorMode <- cThis}
        } else {
            me bool: requirePlusMinusSign <- false
            infn!.viewMode <- vmOverlay
            if(peek=="*" or peek=="/"){
                cPos <+- 1
                if(peek=="/"){infn!.infSize!.inverted <- true}
                infn!.value!.sizeMode <- fromGiven
                me int64: sizeLen <- parseInfonState(infn!.infSize, cPos, infn, isFromDefn, prsCtxt)
                if(sizeLen <= 0){
                    if(!errorSet){
                        me string: opStr <- ""
                        opStr <+- peek
                        setError("Expected a size expression after '"+opStr+"'", cPos)
                    }
                    return(-1)
                }
                cPos <+- sizeLen
                //TODO: add new if Conditions
                //if(infn!.infSize!.overlayType!=NUM){setError("Size of infons must be numeric")}
                requirePlusMinusSign <- true
                peek <- peekWSC(cPos)
            } else {
                infn!.infSize!.num    <- 0
                infn!.infSize!.overlayType  <- NUM
                infn!.infSize!.evalMode <- emUnknown
            }
            if(peek=="+" or peek=="-"){
                cPos <+- 1
                if(peek=="-"){infn!.value!.inverted <- true}
                if(!requirePlusMinusSign){infn!.value!.sizeMode <- fromContext}
                me int64: valueLen <- parseInfonState(infn!.value, cPos, infn, isFromDefn, prsCtxt, infn!.infSize)
                if(valueLen <= 0){
                    if(!errorSet){
                        me string: opStr <- ""
                        opStr <+- peek
                        setError("Expected a value after '"+opStr+"'", cPos)
                    }
                    return(-1)
                }
                cPos <+- valueLen
            } else if(requirePlusMinusSign){
                setError("Expected '+' or '-' after the size expression", cPos)
            } else {
                infn!.value!.sizeMode <- fromCount
                if(!chk(parseInfonState(infn!.value, cPos, infn, isFromDefn, prsCtxt, infn!.infSize), cPos,len)){
                    if(!errorSet){setError("Expected a value literal, '?', or %tag", cPos)}
                }
            }
            if(infn!.value!.tailUnfinished == false){infn!.countSize(false)}
        }

        if(errorSet){return(-1)}
        return(cPos-pos)
    }
    me int64: parseInfonView(our infonView: infn, me int64: pos, me bool: allowIDs, me bool: isFromDefn, me parseContext: prsCtxt <- pcMainInfn, me bool: doNotify <- true) <- {
        infn!.streamState  <- parseStarted // parsing has started
        infn!.isFromDefn   <- isFromDefn
        me int64: cPos    <- pos  // Current position
        me int64: len
        me bool: fetchInnerInfon <- true
        infn!.originID     <- originID
        infn!.infCharPos   <- pos

        // Check for '!' asNot
        if(chkStrWSC(cPos, "!")){
            infn!.asNot <- true
            cPos <+- text!.scrapeWSC(cPos)
        }

        // WordUse:type
//  change to scrapeWordType()
        me bool: wordsFound <- chk(text!.scrapeUniID(cPos), cPos,len)
        if(wordsFound){
            our WordUse:: type
            type!.setAsGiven(makeStr(cPos-len, cPos)) // Set word type
            infn!.type <- type
            if(chkStrWSC(cPos, ":")){
                wordsFound <- chk(text!.scrapeUniID(cPos), cPos,len)
                if(!wordsFound){
                   // cPos <+- parseInfonView(infn, cPos, allowIDs, isFromDefn, prsCtxt)
                    infn!.hasTypeAndValue <- true
                   // fetchInnerInfon<-false
                }
            } else {fetchInnerInfon<-false}
        }

        // InnerInfon
        if(fetchInnerInfon){
            if(!chk(parseInnerInfonView(infn, cPos, isFromDefn, prsCtxt), cPos,len)){
                if(!errorSet){setError("Expected an infon value", cPos)}
            }
        }
///if(chkStrWSC(cPos, "`")){
   // log("Infon marked for reply in doParse at pos " + toString(cPos) + "\n")
  //  infn!.doReply<-true
//}
        if(!infn!.doReply){

        // FuncParts
        cPos <+- parseFuncParts(infn, cPos, allowIDs, isFromDefn)
    } else{
        log("Infon marked for reply; skipping function parts parsing at pos " + toString(cPos))
        log(" Infon so far: " + toString(infn))
    }
      //*** PostParse   ############

        if(infn!.isFunc or infn!.isFuncArg){
            if(infn!.isFuncArg != 0){  // Swap func body with args
                our infonView:: CI_args
                CI_args! <- infn!
                infn! <- CI_args!.funcArgs!
                infn!.invertFunc <- CI_args!.invertFunc
                infn!.funcArgs <- CI_args
                infn!.funcArgs!.funcArgs <- NULL
                infn!.funcArgs!.isFunc <- false
                infn!.funcArgs!.isFuncArg <- false
                infn!.argsOnLeft <- true
            } else {infn!.argsOnLeft <- false}
            infn!.isFunc <- false
            infn!.isFuncArg <- false

            if(infn!.invertFunc){infn!.argPos <- apArgIsLastItem}
            else{infn!.argPos <- apArgIsFirstItem}
        }else{infn!.argPos <- apNoArgs}

        // Adjust arrangement of [...]
        if(infn!.value!.intersectPosParse == ipSquareBrackets and infn!.innr==NULL){
            infn!.moveThisToInnr()
            if(infn!.intersectPos==ipNoIntersect){
                if(infn!.invertFunc){infn!.intersectPos <- ipGetFirst}
                else {infn!.intersectPos <- ipGetLast}
            }
        }
        // if(true){
        //     log("Infon parse Notified at pos " + toString(cPos) + "\n")
        //     notifyStreamState(infn, parseDone)  // ParsingIsDone
        // }

        if(errorSet){return(-1)}
        // If this is the top level infon, Mark it done parsing.
        if(cPos>pos and doNotify){ //} prsCtxt != pcMainInfn){
            log("Top level infon parse completed at pos " + toString(cPos) + "\n")
            notifyStreamState(infn, parseDone)
        }

        return(cPos-pos)
    }

    void: doParse(our infonView: infn) <- {
        clearError()
        parseInfonView(infn, 0, true, false)
        if(streamingMode){
            notifyStreamState(infn, parseDone)
        }
    }

    me bool: doesParseHaveError() <- {return(errorSet)}

    void: initParseFromStream(their strBuf: streamBuffer) <- {
        text <- streamBuffer
    }
    void: initParseFromString(me string: streamName, me string: txt) <- {
        their strBuf:: bufToParse
        bufToParse!.init(streamName)
        bufToParse!.putStr(txt)
        bufToParse!.close()
        initParseFromStream(bufToParse)
    }
    void: setStreamingMode(me bool: streamMode) <- {streamingMode <- streamMode}

}

///////////////////////////////// Infon to string
struct GLOBAL{
    me InfonViewPrinter: infonViewPrinter

    me string: stringifyPreds(our POV: pov, me string: indent) <- {
        me string: S <- indent + pov!.mySymbol() +":"+pov!.stringify()+"\n"
        indent <+- "    "
        withEach pred in pov!.predecessors{
            S <+- indent +"PRED:"+ pred!.mySymbol() +":"+pred!.stringify()+"\n"
        }
        withEach last in pov!.candidatesForLastItem{
            S <+- indent +"LAST:"+ last!.mySymbol() +":"+last!.stringify()+"\n"
        }
        if(pov!.pItem!.value!.overlayType == LST){
            our POV: itm <- pov!.pItem!.value!.items.head
            while(itm != NULL){
                S <+- stringifyPreds(itm, indent+">>")
                itm <- itm!.next
            }
        }
        if(pov!.pItem!.innr != NULL){
            S <+- indent+"-------\n"
            our POV: srcItm <- pov!.pItem!.innr!.value!.items.head
            while(srcItm != NULL){
                S <+- stringifyPreds(srcItm, indent)
                srcItm <- srcItm!.next
            }
            S <+- indent+"-------\n"
        }
        return(S)
    }
    me string: bigStringify(our infonView: i, me string: indent) <- {
        me string: S <- indent + i!.mySymbol()+ ":" +toString(i)+"\n"
        withEach pov in i!.wrkList{
            S <+- indent + "        =" + pov!.mySymbol()+"\n"
            S <+- bigStringify(pov!.pItem, indent + "            =")
        }
        me int: count <- 0
        our POV: p <- i!.value!.items.head
        while(p != NULL){
            S <+- indent + "    |" + p!.mySymbol()+"\n"
            S <+- bigStringify(p!.pItem, indent + "      |")
            count <- count+1
            p <- p!.next
        }
        return(S)
    }
    me string: toStringColor(their infonView: i, me int: verbosity<-0, their infonView: special<-NULL) <- {
        return(infonViewPrinter.printInfonView(i, verbosity, special))
    }
    me string: toString(their infonView: i) <- {
        return(infonViewPrinter.printInfonView(i, 0, NULL))
    }
}
struct InfonViewPrinter{
    me Mutex: infPrintMtx
    me bool: debugSublistPrint <- true
    me bool: debugPrint <- false
    me bool: isListWithDots(their infonState: pure) <- {
        if(pure!.overlayType!=LST){ return(false)}
        if(pure!.evalMode==emLiteral){
            our POV: pov <- pure!.items.head
            while(pov != NULL){
                our infonView: item <- pov!.pItem
                if(item!.value!.tailUnfinished){
                    return(true)
                }
                pov <- pov!.next
            }
        }
        if(pure!.tailUnfinished){return(true)}
        return(false)
    }

    me string: addFuncArgs(me string: funcStr, me string: argStr, me int: argsOnLeft, me int: argPos, me string: tmpChar) <- {
        me string: S
        me string: invertChar <- ":"
        if(argPos==apArgIsLastItem){invertChar <- "!"}
        if(argsOnLeft){S <- argStr + invertChar + ">" + funcStr}
        else{S <- funcStr + "<" + tmpChar+ invertChar + argStr}
        return(S)
    }

    me bool: isNiceList(their infonState: pure, their infonView: parentInfon) <- {
        if(debugPrint){return(false)}
        return(parentInfon!.wasProcessed and pure!.evalMode==emLiteral and !pure!.tailUnfinished)
    }

    me string: printInfonState(their infonState: pure, their infonState: size, me bool: asInnr, me bool: isSpec, their infonView: parentInfon, our Map<me string,me int>: used, me int: verbosity, their infonView: special, me bool: suppressSizeOp <- false) <- {
        me string: S <- ""
        me bool: showSize <- size!=NULL and (
            ((((pure!.sizeMode==fromGiven) and (pure!.overlayType!=LST or pure!.evalMode!=emLiteral))
            or (pure!.overlayType!=NUM and size!.evalMode==emUnknown and pure!.evalMode==emLiteral))
            and !isListWithDots(pure)
            ) or (
            isSpec and size!.num>0
            )
        )
        if(debugPrint){showSize <- size!=NULL and size!.num>0}
        if(showSize){S <+- printInfonState(size, NULL, false, isSpec, parentInfon, used, verbosity, special)}
        if(pure!.inverted){
            if(size!=NULL or pure!.sizeMode==fromContext){S <+- "-"}
            else if(!suppressSizeOp){S <+- "/"}
        }else{
            if(showSize or pure!.sizeMode==fromContext){S <+- "+"}
            else if(size==NULL and !suppressSizeOp){S <+- "*"}
        }
        if(pure!.overlayType == NUM){
            if(pure!.evalMode == emUnknown){S <+- "_"}
            else{
                me FlexNum:N <- pure!.num
                S <+- N.stringify()
            }
        }else if(pure!.overlayType == STR){
            if(pure!.evalMode == emUnknown){S <+- "$"}
            else{
                me string: str <- pure!.str
                S <+- "'"+ str + "'"
            }
        }else if(pure!.overlayType == LST){
            me bool: showBar<-false
            me string: strtBrkt<-"{"
            me string: endBrkt <-"}"
            if(asInnr){strtBrkt<-"["; endBrkt<-"]"}
            else if(pure!.evalMode == emConcat) {strtBrkt<-"("; endBrkt<-")"}
            S <+- strtBrkt
            if(pure!.timelike){S <+- "T "}
            if(size!=NULL and pure!.sizeWasInner and pure!.evalMode==emLiteral){
                S <+- "~"+printInfonState(size, NULL, false, isSpec, parentInfon, used, verbosity, special, true)
                showBar<-true
            }
            if(pure!.listSpec!=NULL and !isNiceList(pure, parentInfon)){
                if(showBar){S <+- " "}
                S <+- printInfonViewActual(pure!.listSpec, used, false, isSpec, verbosity, special)
                showBar<-true
            }
            if(showBar){S <+- "| "}
            our POV: itemItr <- pure!.items.begin()
            me bool: firstTime <- true
            while(itemItr!=NULL){
                if(!firstTime){
                    if(parentInfon!.orderMode==uUnordered){S <+- ", "}
                    else{S <+- " "}
                } else {firstTime <- false}
                me string: itmStr
                itmStr <- printInfonViewActual(itemItr!.pItem, used, itemItr!.isSubItm, isSpec, verbosity, special)
                if(parentInfon!.intersectPos == ipGetMarked and parentInfon!.intersectMarkedRetPOV===itemItr){
                    itmStr <- "<"+itmStr+">"
                }
                S <+- itmStr
                itemItr <- itemItr!.next
            }
            if(pure!.tailUnfinished or parentInfon!.streamState==parseStarted){
                if(!firstTime and parentInfon!.orderMode==uUnordered){S <+- ","}
                S <+- " ... "
            }
            S <+- endBrkt
        }else if(pure!.overlayType == tUnknown){
        }else if(pure!.overlayType == tUnset){
            S <+- "tUnset"
        }else{logFatalError("Unknown overlayType in printInfonState(): "+ toString(pure!.overlayType))}
        return(S)
    }

    me string: printInfonViewActual(their infonView: i, our Map<me string, me int>: used, me bool: isSubItm, me bool: isSpec, me int: verbosity, their infonView: special) <- {
        me string: S <- ""
        if(i ==  NULL){return("NULL")}
        me bool: resetColor <- false
        if(i===special){resetColor <- true; S<+-tam.pushColor(4)}
        if(i!.isTentative){S <+- "t"}
        me string: iSymbol <- i!.mySymbol()
        if(used.containsKey(iSymbol)){
            S <+- iSymbol
            if(resetColor){S<+-tam.popColor();}
            return(S)
        }
        else{used![iSymbol]<-1}
        if(i!.value!.undefined){S <+- "UNDEFINED"; if(resetColor){S<+-tam.popColor();} return(S)}
        if(i!.asNot){S <+- "!"}
        if(i!.type!=NULL and i!.itmMode!=mWordDefn){
            me string: wordSysString <- i!.type!.asGiven
            if(wordSysString==""){wordSysString<-"ERROR: NULL-TAG"}
            S <+- wordSysString
            if(i!.viewMode == vmAny){
                if(i!.doReply){S <+- "~"}
            }else{S <+- ":"}
        }
        me bool: isMDots
        if(isSubItm){
            if((i!.value!.tailUnfinished and i!.infSize!.evalMode==emUnknown and i!.value!.items.size()==0) and i!.value!.listSpec==NULL){
                S<+-"..."
                isMDots <- true
            }
            else{
                if(debugSublistPrint){S<-"&"+S}
                else{
                    if(i!.value!.evalMode==emLiteral){
                        our POV: itemItr <- i!.value!.items.begin()
                        me bool: firstTime <- true
                        while(itemItr!=NULL){
                            if(!firstTime){S <+- " "} else {firstTime <- false}
                            S <+- printInfonViewActual(itemItr!.pItem, used, false, isSpec, verbosity, special)
                            itemItr <- itemItr!.next
                        }
                        if(i!.value!.tailUnfinished){S <+- " ... "}
                        isMDots <- true
                    }
                }
            }
        }
        else if(i!.itmMode==mWordDefn){
            S<+-"@"+i!.definedWord!.defWord +" "
            if(! i!.definedWord!.UsageTags.isEmpty()){S<+-"<"}
            withEach usageTag in i!.definedWord!.UsageTags{
                S <+- usageTag+" "
            }
            if(! i!.definedWord!.UsageTags.isEmpty()){S<+-">"}
            S<+-"= "+printInfonViewActual(i!.funcArgs, used, false, isSpec, verbosity, special)
            if(i!.doReply){S <+- "~"}
            if(resetColor){S<+-tam.popColor();}
            return(S)
        }
        else if(i!.itmMode==mIncludeStream){
            S<+-"%INSERT "+i!.includeSpec
        }
        if(!isMDots){
            if(i!.viewMode==vmAny){
                if(i!.type==NULL){ S <+-"?"}
            } else if(i!.viewMode==vmCursor){
                S <+- "%"
                switch(i!.cursorMode){
                    case cThis:   {} //{S <+- "self"}
                    case cWorld:  {S <+- "W"}
                    case cUser:   {S <+- "U"}
                    case cContext:{S <+- "ctx"}
                    case cArgs:   {S <+- "args"}
                    case cVars:   {S <+- "vars"}
                    case cPrev:   {S <+- "prev"}
                    case cNext:   {S <+- "next"}
                }
            } else if(i!.viewMode==vmOverlay){
                if(i!.intersectPos == ipNoIntersect){
                    S <+- printInfonState(i!.value, i!.infSize, false, isSpec, i, used, verbosity, special)
                } else {
                    S <+- printInfonState(i!.innr!.value, i!.innr!.infSize, true, isSpec, i, used, verbosity, special)
                    if (i!.innr!.argPos != apNoArgs){
                        S <- addFuncArgs(S, printInfonViewActual(i!.innr!.funcArgs, used, false, isSpec, verbosity, special), i!.innr!.argsOnLeft, i!.innr!.argPos, "")
                    }
                }
            } else {logFatalError("Invalid viewMode in printInfonViewActual()\n")}
        }
        if(i!.isNormed == false){
            withEach WorkItm in i!.wrkList{
                if(WorkItm!.forceID){S <+- " <<"}
                else{S <+- " "}
                if(!WorkItm!.looseMode and !WorkItm!.looseInhtd){ S <+- "="}
                else { S <+- "=="}
                if(WorkItm!.looseTop){ S <+- ":"}
                S <+- " "
                S <+- printInfonViewActual(WorkItm!.pItem, used, false, isSpec, verbosity, special)
            }

            if (i!.argPos != apNoArgs){
                S <- addFuncArgs(S, printInfonViewActual(i!.funcArgs, used, false, isSpec, verbosity, special), i!.argsOnLeft, i!.argPos, "")
            }
        }

        withEach part in i!.parts{
            if(! part!.wasTransfered){
                if(part!.pathMode == dotField){S <+- "."}
                else if(part!.pathMode == idxField){S <+- "#"}
                else if(part!.pathMode == colonField){S <+- ":"}
                S <+- printInfonViewActual(part!.path, used, false, isSpec, verbosity, special)
                if(part!.hasSemiColon){S <+- "; "}
            }
        }
        if(i!.partRef != NULL){
            if(i!.partRef!.pathMode == dotField){S <+- "."}
            else if(i!.partRef!.pathMode == idxField){S <+- "#"}
            else if(i!.partRef!.pathMode == colonField){S <+- ":"}
            S <+- printInfonViewActual(i!.partRef!.path, used, false, isSpec, verbosity, special)
            if(i!.partRef!.pathMode == idxField and i!.partRef!.spec != NULL){
                S <+- ":" + printInfonViewActual(i!.partRef!.spec, used, false, true, verbosity, special)
            }
        }
if(i!.doReply){S <+- "~"}
//S <- "("+S+")"
if(resetColor){
    S<+-"<"+i!.mySymbol()+">"
    S<+-tam.popColor();
}
        return(S)
    }
    me string: printInfonView(their infonView: i, me int: verbosity, their infonView: special) <- {
        me string: retVal
        our Map<me string, me int>:: used
        protect(infPrintMtx){
            retVal <- printInfonViewActual(i, used, false, false, verbosity, special)
        }
        return(retVal)
    }

}
