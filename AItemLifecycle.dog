// Explicit control result returned by an AItem processor.
struct AItemDispatchResult{
    me bool: fulfillSubscribers <- false
    me bool: resumeParent <- false
    // Work constructed during semantic dispatch but not yet placed on the
    // agenda. AgendaEngine owns the returned-work enqueue boundary after
    // lifecycle processing, so reasoning code never owns the queue.
    me List<our AItem>: requestedWork
}

// Common lifecycle operations surrounding one agenda-item dispatch.
struct AItemLifecycle{
    // Complete the lifecycle of a semantic wrkList obligation only after its
    // child merge has a terminal result. Unresolved obligations remain
    // printable on wrkList; terminal ones release their work-list POV.
    void: completeSourceWorkConstraint(our AItem: aItem,
            their AItemDispatchResult: result) <- {
        if(!result.fulfillSubscribers or aItem!.sourceWorkPOV==NULL){return()}
        if(aItem!.sourceWorkParent!=NULL and
                aItem!.sourceWorkParent!.inFlightWorkPOV===aItem!.sourceWorkPOV){
            aItem!.sourceWorkParent!.inFlightWorkPOV <- NULL
        }
        // Generated legacy handlers do not yet return an explicit disposition.
        // Preserve their former dequeue-to-history behavior at the shared
        // lifecycle boundary: a fulfilled non-rejection is discharged. Only
        // the new reasoner can explicitly retain an unresolved obligation.
        if(aItem!.constraintDisposition==cdInFlight){
            if(aItem!.mergeStatus==msReject){aItem!.constraintDisposition <- cdContradiction}
            else{aItem!.constraintDisposition <- cdDischarged}
        }
        if(aItem!.sourceWorkOwner!=NULL){
            // A changed source was not the source revision the child proved;
            // leave it ready so the resumed parent evaluates the new revision.
            if(aItem!.sourceWorkPOV!.workRevision!=aItem!.sourceWorkRevision){
                aItem!.sourceWorkOwner!.makeWrkListPOVReady(aItem!.sourceWorkPOV)
            }else if(aItem!.constraintDisposition==cdRetained){
                aItem!.sourceWorkOwner!.deferWrkListPOV(aItem!.sourceWorkPOV)
            }else{
                // A discharged constraint may have supplied context still
                // reached through raw pParent links in the result. Record that
                // ownership dependency separately from semantic work. A
                // redundant or contradictory constraint supplied no result.
                if(aItem!.constraintDisposition==cdDischarged){
                    aItem!.sourceWorkOwner!.addSourceGraphDependency(aItem!.sourceWorkPOV)
                }
                aItem!.sourceWorkOwner!.discardWrkListPOV(aItem!.sourceWorkPOV)
            }
        }
        aItem!.sourceWorkOwner <- NULL
        aItem!.sourceWorkPOV <- NULL
        aItem!.sourceWorkParent <- NULL
    }

    void: beginDispatch(our AItem: aItem) <- {
        aItem!.taskEnqueued <- false
        if(!aItem!.wokenEarly){aItem!.pendingTasks <-- 1}
    }

    // Allow one rsInfon subscriber to emit an early streaming reply while
    // retaining its dependency edge for the later real fulfillment.
    void: wakeSubscriptions(their Agenda: agenda, our AItem: aItem) <- {
        while(!aItem!.subscribers.isEmpty()){
            our AItem: sub <- aItem!.subscribers.first()
            if(sub!.ruleSet!=rsInfon or sub!.wokenEarly){break()}
            sub!.heldPendingTasks <+- 1
            sub!.wokenEarly <- true
            sub!.priority <- aItem!.priority
            sub!.LHS_item!.pItem!.isNormed <- false
            agenda!.addAItemToAgenda(sub)
            break()
        }
    }

    // Consume completed dependency edges and resume every waiting subscriber.
    void: fulfillSubscriptions(their Agenda: agenda, our AItem: aItem) <- {
        me string: S
        while(!aItem!.subscribers.isEmpty()){
            our AItem: sub <- aItem!.subscribers.first()
            if(sub!.ruleSet==rsInfon){
                sub!.step <+- 1
                S <- S + " +step:"+toString(sub!.step)+":"
                sub!.priority <- aItem!.priority
            }
            aItem!.subscribers.popFirst()
            sub!.LHS_item!.pItem!.isNormed <- false
            if(sub!.wokenEarly){
                if(sub!.heldPendingTasks>0){sub!.heldPendingTasks <-- 1}
                sub!.wokenEarly <- false
            }
            me bool: itmAdded <- agenda!.addAItemToAgenda(sub) // FFS
            if(itmAdded){S<+-":"+sub!.mySymbol()}
        }
        if(S != ""){
            //:l/PAI::logSeg(" FFS"+S)
        }
    }

    // Complete the dependency edge from a finished rsInfon child to its parent.
    void: resumeParent(their Agenda: agenda, our AItem: aItem) <- {
        our AItem: aParent <- aItem!.parent
        if(aParent != NULL){
          //  print("\naParent pendingTask:", toString(aParent!.pendingTasks))
            aParent!.pendingTasks <-- 1
            if(aParent!.pendingTasks == 0){ //:l/PAI::logSeg(" ADP:"+aParent!.mySymbol())
                // Resuming an infon parent after child work is a new agenda pass,
                // but merge/intersect parents already encode their own step state.
                if(aParent!.ruleSet==rsInfon){aParent!.step <+- 1}
                aParent!.pendingTasks <+- 1
                agenda!.addAItemToAgenda(aParent)  // Restart parent task
            } else {
                //:l/PAI/PT::logSeg(" --"+aParent!.mySymbol()+"_PT:f="+toString(aParent!.pendingTasks))
            }
        }else {
            //:l/PAI::logSeg(" NoAParent")
        }
    }

    void: completeDispatch(their Agenda: agenda, our AItem: aItem,
            their AItemDispatchResult: result) <- {
        completeSourceWorkConstraint(aItem, result)
        if(result.resumeParent){resumeParent(agenda, aItem)}
        if(result.fulfillSubscribers){fulfillSubscriptions(agenda, aItem)}
    }
}
