// An ordered lifecycle effect requested during semantic dispatch. The target
// may differ from the currently dispatched item when queued propagation work
// completes an older dependency.
struct AItemLifecycleRequest{
    our AItem: target
    me bool: wakeSubscribers <- false
    // These are independent lifecycle facts. Current propagation completion
    // requests both, but future semantic paths may request either one alone.
    me bool: completeSourceWork <- false
    me bool: fulfillSubscribers <- false
}

// Explicit control result returned by an AItem processor.
struct AItemDispatchResult{
    // Completing one wrkList attempt does not itself consume dependency edges.
    me bool: completeSourceWork <- false
    me bool: fulfillSubscribers <- false
    me bool: completeListChild <- false
    // Lifecycle effects discovered during semantic dispatch are applied at
    // the common completion boundary in their original request order.
    me List<our AItemLifecycleRequest>: lifecycleRequests
    // Work constructed during semantic dispatch but not yet placed on the
    // agenda. AgendaEngine owns the returned-work enqueue boundary after
    // lifecycle processing, so reasoning code never owns the queue.
    me List<our AItem>: requestedWork
}

// Common lifecycle operations surrounding one agenda-item dispatch.
struct AItemLifecycle{
    // Complete the lifecycle of a semantic wrkList obligation only after its
    // child merge has a terminal result. Unresolved obligations remain
    // printable on wrkList; terminal ones release their work-list POV.
    void: completeSourceWorkConstraint(our AItem: aItem) <- {
        if(aItem!.sourceWorkPOV==NULL){return()}
        if(aItem!.sourceWorkParent!=NULL and
                aItem!.sourceWorkParent!.inFlightWorkPOV===aItem!.sourceWorkPOV){
            aItem!.sourceWorkParent!.inFlightWorkPOV <- NULL
        }
        // Reasoning paths that do not yet return an explicit disposition keep
        // the former dequeue-to-history behavior: a non-rejection is discharged.
        if(aItem!.constraintDisposition==cdInFlight){
            if(aItem!.mergeStatus==msReject){aItem!.constraintDisposition <- cdContradiction}
            else{aItem!.constraintDisposition <- cdDischarged}
        }
        if(aItem!.sourceWorkOwner!=NULL){
            // A changed source was not the source revision the child proved;
            // leave it ready so the resumed parent evaluates the new revision.
            if(aItem!.sourceWorkPOV!.workRevision!=aItem!.sourceWorkRevision){
                aItem!.sourceWorkOwner!.makeWrkListPOVReady(aItem!.sourceWorkPOV)
            }else if(aItem!.constraintDisposition==cdRetained){
                aItem!.sourceWorkOwner!.deferWrkListPOV(aItem!.sourceWorkPOV)
            }else{
                // A discharged constraint may have supplied context still
                // reached through raw pParent links in the result. Record that
                // ownership dependency separately from semantic work. A
                // redundant or contradictory constraint supplied no result.
                if(aItem!.constraintDisposition==cdDischarged){
                    aItem!.sourceWorkOwner!.addSourceGraphDependency(aItem!.sourceWorkPOV)
                }
                aItem!.sourceWorkOwner!.discardWrkListPOV(aItem!.sourceWorkPOV)
            }
        }
        aItem!.sourceWorkOwner <- NULL
        aItem!.sourceWorkPOV <- NULL
        aItem!.sourceWorkParent <- NULL
    }

    // Register one child in the current list-completion batch. The normalizer
    // runs agenda dispatches serially, so all children discovered by the
    // current parent dispatch are registered before any can complete.
    void: registerListChild(our AItem: parent, our AItem: child) <- {
        if(parent==NULL or child==NULL){return()}
        child!.parent <- parent
        if(child!.countsTowardParentListCompletion){return()}
        child!.countsTowardParentListCompletion <- true
        parent!.pendingListChildren <+- 1
        parent!.waitingForListChildren <- true
    }

    // Attach execution ancestry independently from direct subscription. The
    // explicit role prevents pointer equality from deciding list semantics.
    void: attachParent(our AItem: parent, our AItem: child,
            me AItemParentRole: parentRole) <- {
        if(parentRole==aprNoParent){
            if(parent!=NULL){
                logFatalError("A parent was supplied with aprNoParent")
            }
            return()
        }
        if(parent==NULL or child==NULL){
            logFatalError("A parent role requires both parent and child")
        }
        if(parentRole==aprListCompletion){
            registerListChild(parent, child)
        }else{
            child!.parent <- parent
        }
    }

    // Allow one rsInfon subscriber to emit an early streaming reply while
    // retaining its dependency edge for the later real fulfillment.
    void: wakeSubscriptions(their Agenda: agenda, our AItem: aItem) <- {
        while(!aItem!.subscribers.isEmpty()){
            our AItem: sub <- aItem!.subscribers.first()
            if(sub!.ruleSet!=rsInfon or sub!.wokenEarly){break()}
            sub!.wokenEarly <- true
            sub!.priority <- aItem!.priority
            sub!.LHS_item!.pItem!.isNormed <- false
            agenda!.addAItemToAgenda(sub)
            break()
        }
    }

    // Consume completed dependency edges and resume every waiting subscriber.
    void: fulfillSubscriptions(their Agenda: agenda, our AItem: aItem) <- {
        me string: S
        while(!aItem!.subscribers.isEmpty()){
            our AItem: sub <- aItem!.subscribers.first()
            if(sub!.ruleSet==rsInfon){
                sub!.step <+- 1
                S <- S + " +step:"+toString(sub!.step)+":"
                sub!.priority <- aItem!.priority
            }
            aItem!.subscribers.popFirst()
            sub!.LHS_item!.pItem!.isNormed <- false
            if(sub!.wokenEarly){sub!.wokenEarly <- false}
            me bool: itmAdded <- agenda!.addAItemToAgenda(sub) // FFS
            if(itmAdded){S<+-":"+sub!.mySymbol()}
        }
        if(S != ""){
            //:l/PAI::logSeg(" FFS"+S)
        }
    }

    // Complete one member of a parent's list-child batch. The last child
    // restarts the parent exactly once.
    void: completeListChild(their Agenda: agenda, our AItem: aItem) <- {
        our AItem: parent <- aItem!.parent
        if(parent==NULL or
                !aItem!.countsTowardParentListCompletion){return()}
        aItem!.countsTowardParentListCompletion <- false
        if(parent!.pendingListChildren<=0){
            logFatalError("List child completed without a pending parent slot: "+
                    toString(aItem))
        }
        parent!.pendingListChildren <-- 1
        if(parent!.pendingListChildren==0 and
                parent!.waitingForListChildren){
            parent!.waitingForListChildren <- false
            // Resuming an infon parent after list-child work is a new agenda
            // pass; merge/intersect parents encode their own step state.
            if(parent!.ruleSet==rsInfon){parent!.step <+- 1}
            agenda!.addAItemToAgenda(parent)
        }
    }

    // Apply lifecycle effects whose target is carried by the request itself.
    // Queued propagation uses this after its originating AItem dispatch has
    // ended, so it must not require a current dispatch item.
    void: completeRequestedLifecycle(their Agenda: agenda,
            their AItemDispatchResult: result) <- {
        withEach request in result.lifecycleRequests{
            if(request!.wakeSubscribers){
                wakeSubscriptions(agenda, request!.target)
            }
            if(request!.completeSourceWork){
                completeSourceWorkConstraint(request!.target)
            }
            if(request!.fulfillSubscribers){
                fulfillSubscriptions(agenda, request!.target)
            }
        }
    }

    void: completeDispatch(their Agenda: agenda, our AItem: aItem,
            their AItemDispatchResult: result) <- {
        completeRequestedLifecycle(agenda, result)
        if(result.completeSourceWork){completeSourceWorkConstraint(aItem)}
        if(result.completeListChild){completeListChild(agenda, aItem)}
        if(result.fulfillSubscribers){fulfillSubscriptions(agenda, aItem)}
    }
}
