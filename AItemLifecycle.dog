// Common lifecycle operations surrounding one agenda-item dispatch.
struct AItemLifecycle{
    void: beginDispatch(our AItem: aItem) <- {
        aItem!.taskEnqueued <- false
        if(!aItem!.wokenEarly){aItem!.pendingTasks <-- 1}
    }

    void: completeDispatch(their WorldManager: worldManager, their Agenda: agenda, our AItem: aItem, me bool: doFulfillSubs) <- {
        if(doFulfillSubs){worldManager!.fulfillSubscriptions(agenda, aItem)}
    }
}
