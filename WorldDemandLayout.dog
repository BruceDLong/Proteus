// A value demand first acquires the containing list's semantic header through
// ordinary normalization. The suspended check owns no value materialization.
struct WorldDemand {
    our WorldRequest: layoutRequest
    our WorldPosition: layoutDestination
    me bool: layoutForward <- true
    me uint64: listLayoutHeaders <- 0

    void: retireLayoutRequest() <- {
        if(layoutRequest==NULL){return()}
        listLayoutHeaders <+- layoutRequest!.listLayoutHeaders
        navigationFrames <+- layoutRequest!.framesCreated
        framesCreated <+- layoutRequest!.framesCreated
        relationshipsRead <+- layoutRequest!.relationshipsRead
        queueSteps <+- layoutRequest!.queueSteps
        positionsVisited <+- layoutRequest!.correspondencePositions
        manager!.release(session, layoutRequest); layoutRequest <- NULL
    }

    // Header completion continues the saved movement, never a new seek or a
    // second normalization of a value already produced by this movement.
    me bool: settleLayoutRequest() <- {
        if(layoutRequest==NULL){return(false)}
        me WorldModelLock: lock{manager!.control!.mutex}
        movement <- layoutRequest!.status()
        if(movement.outcome==worldWaiting or movement.outcome==worldReady){return(false)}
        me WorldScalar: header <- layoutRequest!.acquiredHeader
        our WorldPosition: destination <- layoutDestination
        me bool: forward <- layoutForward
        layoutDestination <- NULL
        retireLayoutRequest()
        if(movement.outcome!=worldComplete){return(false)}
        return(fillAfterLayout(destination, forward, header.timelike))
    }

    me bool: requestDemandLayout(our WorldPosition: destination, me bool: forward) <- {
        our WorldPosition: scope <- logicalList(destination)
        if(scope==NULL){return(fillAfterLayout(destination, forward, false))}
        retireRequest()
        layoutDestination <- destination; layoutForward <- forward
        layoutRequest <- manager!.acquireHeader(session, scope, language, worldSource, identities)
        return(settleLayoutRequest())
    }

    // All value/cache/replay decisions follow the semantic context proof.
    // The ordinary solver still owns member acquisition and retained values.
    me bool: fillAfterLayout(our WorldPosition: destination, me bool: forward, me bool: temporalList) <- {
        // The common producer already acquired this occurrence under every
        // segment requirement. Its live evidence and checked value establish
        // the demand proof; replaying the recipe would apply those parents a
        // second time and can mistake a named history for its first member.
        if(destination!.generatedAddress!=NULL and manager!.graph.cursorValueReady(destination!.node) and
           generatedContextCurrent(destination)){rememberDemandContext(destination)}
        if(available(destination)){
            retireRequest(); return(prepareValue(destination, destination!.node))
        }
        our WorldPosition: input <- demandInput(destination)
        // An explicitly preserved produced state already received carry. Its
        // constraints and requested fields remain ordinary acquisition work.
        if(destination!.node!.cursorValue!=NULL and destination!.node!.cursorValue!.owner===destination!.node and
           destination!.node!.cursorValue!.permanent){
            startStep(destination); return(settle())
        }
        if(!temporalList or !manager!.needsRetainedInput(input!.node!.pItem)){
            startStep(destination); return(settle())
        }
        // Forward is asserted only by the normalizer's neighbour selection.
        if(hasValue and forward and (available(position) or workingAvailable(position))){
            previousValue <- snapshot(); startStep(destination); return(settle())
        }
        filling <- true; replayCursor <- destination; replayDestination <- destination; noteReplayPositions()
        return(continueFill())
    }
}
