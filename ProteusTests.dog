    GETFIRSTTIGHT(unit/GFirstT/t2,     "get first POV tight",      "{&{1 2 3 }}", "1", 0)
    GETFIRSTTIGHT(unit/GFirstT/t3,     "get first POV tight",      "{&{}1 2 3}", "1", 0)
    GETFIRSTTIGHT(unit/GFirstT/t4,     "get first POV tight",      "{&{} &{}1 2 3}", "1", 1)
    GETFIRSTTIGHT(unit/GFirstT/t5,     "get first POV tight",      "{&{&{1 2 3}}}", "1", 1)
    GETFIRSTTIGHT(unit/GFirstT/t6,     "get first POV tight",      "{&{&{}} 1 2 3}", "1", 1)

    GETNEXT(unit/GNext/t1,       "get next POV",      "{3 4 5}", "{3 4 5 }", 0)
    GETNEXT(unit/GNext/t2,       "get next POV",      "{3 4 5 ...}", "{3 4 5 }", 1)
    GETNEXT(unit/GNext/t3,       "get next POV",      "{3 4 5 ...}", "{3 4 5 t? t? t? t?  Infinite Loop}", 0)

    GETNEXTTIGHT(unit/GNextT/t1, "get next POV tight",      "{3 4 5}", "{3 4 5 }", 0)
    GETNEXTTIGHT(unit/GNextT/t2, "get next POV tight",      "{3 &{} 4 5}", "{3 4 5 }", 0)
    GETNEXTTIGHT(unit/GNextT/t3, "get next POV tight",      "{3 &{4 5} 6}", "{3 4 5 6 }", 0)
    GETNEXTTIGHT(unit/GNextT/t4, "get next POV tight",      "{3 4 &{&{5}}}", "{3 4 5 }", 0)
    WORDRULECOST(unit/wordRules/factoredCostEstimate, "estimate alternative search cost without materializing definition pairs")
    STREAMLOADERSPEC(unit/streamLoader/specParsing, "parse shared protocol and connection fields", 1)
    STREAMLOADERSPEC(unit/streamLoader/relativeResolution, "resolve an inserted stream from its source directory", 2)
    ENDRELRESOLVE(unit/endRelative/resolveOnClose, "register end-relative references and identify them while large sparse sources stay compressed")
    ENDRELQUERY(unit/endRelative/exactClosedWindow, "separate an exact closed extent from its available window", 1)
    ENDRELQUERY(unit/endRelative/exactPendingWindow, "retain an exact coordinate while requested positions are pending", 2)
    ENDRELQUERY(unit/endRelative/unknownOpenExtent, "leave an open list without an exact end unresolved", 3)
    ENDRELQUERY(unit/endRelative/incompatibleSource, "classify a non-list source as incompatible", 4)
    ENDRELQUERY(unit/endRelative/outOfRangeWindow, "reject a window outside an exact extent", 5)
    ENDRELQUERY(unit/endRelative/derivedBoundaryStable, "use a stable derived-view end instead of the ultimate source end", 6)
    SELECTIONREFERENCE(unit/referenceRegistry/partPathSelection, "retain the source occurrence and context of direct part selection", 1)
    SELECTIONREFERENCE(unit/referenceRegistry/intersectionPartPathSelection, "retain the source occurrence and context of ordered part selection", 2)
    EXTERNALASSOCIATION(unit/referenceRegistry/externalAssociation, "record a reversible external association without identifying its endpoints")
    SELECTIONRESOLUTION(unit/referenceRegistry/multipleEqualValuedOccurrences, "preserve equal-valued source occurrences as distinct selection results", 2)
    SELECTIONRESOLUTION(unit/referenceRegistry/reverseSourceMultiplicity, "report every query and result that selected one exact source occurrence", 3)
    SELECTIONRESOLUTION(unit/referenceRegistry/resolvedPartPathRequest, "retain the original part-path request result and provenance", 4)
    SELECTIONRESOLUTION(unit/referenceRegistry/singleSelectionInverse, "reverse only a unique one-item positional selection to its source occurrence", 5)
    POSITIONALSELECTION(unit/referenceRegistry/positiveIndexSelection, "select a positive index with its original source occurrence", 1)
    POSITIONALSELECTION(unit/referenceRegistry/firstSelection, "retain the original first-item occurrence", 2)
    POSITIONALSELECTION(unit/referenceRegistry/lastSelection, "retain the original last-item occurrence", 3)
    POSITIONALSELECTION(unit/referenceRegistry/positiveSpanSelection, "retain every original source position of a positive span", 4)
    INDEXLOWERING(unit/indexLowering/typedSugarMatchesIntersection, "give sugar and low-level typed selections equivalent values and source windows", 2)
    INDEXLOWERING(unit/indexLowering/equalValuedSources, "retain distinct equal-valued seconds after releasing typed selection progress", 3)
    IMPLICITITEM(unit/implicitItem/canonical, "reuse the canonical POV for one implicit source position", 1)
    IMPLICITITEM(unit/implicitItem/distinctPositions, "keep distinct implicit source positions distinct", 2)
    IMPLICITITEM(unit/implicitItem/nonMaterializing, "look up an implicit item without expanding the source list", 3)
    IMPLICITITEM(unit/implicitItem/retainedViewOrigin, "retain implicit item identity for a derived view origin", 4)
    IMPLICITITEM(unit/implicitItem/logicalTraversal, "traverse implicit positions and cross the compressed span boundary", 5)
    IMPLICITITEM(unit/implicitItem/nestedTraversalBoundary, "honor the selected context while traversing out of a nested sparse span", 7)
    IMPLICITITEM(unit/implicitItem/splitRemainderSizeFromGiven, "keep an explicitly sized sparse split remainder fromGiven", 8)
    IMPLICITITEM(unit/implicitItem/stableAcrossSplit, "preserve one occurrence token and POV across a sparse split", 9)
    IMPLICITITEM(unit/implicitItem/materializationIdentity, "identify a virtual repetition occurrence with its concrete materialization", 10)
    IMPLICITITEM(unit/implicitItem/billionItemRegistry, "retain only demanded occurrences from a billion-item repetition", 11)
    IMPLICITITEM(unit/identityRegistry/symmetricTransitive, "traverse registered identities in either direction and transitively", 12)
    IMPLICITITEM(unit/implicitItem/directExposureIdentity, "record identity when sparse exposure has no prior occurrence reference", 13)
    IMPLICITITEM(unit/implicitItem/unknownOrdinalOccurrence, "keep demanded repetition occurrences distinct before their ordinals are known", 14)
    LISTSPECAPPLICATION(unit/listSpec/perTemplateApplication, "apply each list template once while allowing a later template")

