    GRAPHRECORDVALUE(unit/graphRecordValue/alias, 16)
    GRAPHRECORDVALUE(unit/graphRecordValue/siblingsRemainDistinct, 17)
    GRAPHRECORDVALUE(unit/graphRecordValue/partialMeaning, 18)
    me bool: graphRecordValueCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer normalizer;normalizer.init();
        auto defs=graphParsed(testName,caseID==18 ? "{#record={X, Y} #alias=%ctx.record}" : "{#record={X, Y} #alias=record #other=record}");
        auto originalDefinition=toString(defs->pItem.get());
        auto declared=normalizer.normalize(defs);declared.waitForCompletion();
        std::vector<std::string> expressions{
            "?={X:*10+1, Y:*10+2}", "?=*2+{X:*10+1, Y:*10+2}",
            "?={Child:{X:*10+1, Y:*10+2}, Z:*10+3}", "{?}={record:{X:*10+1, Y:*10+2}}",
            "record=record:{X:*10+1, Z:*10+2}", "{X:*10+1, Y:*10+2}={Y:*10+2, X:*10+1}",
            "?={X:*10+_, Y:*10+2}", "?={X:*10+_, Y:*10+2}",
            "?={X:*10+1, Y:*10+2}", "?={X:*10+1, Y:*10+2, Z:*10+3}",
            "wheel=pedal:{X:*10+1, Y:*10+2}", "?={X:*10+1, Y:*10+2}",
            "?={X:*10+1, Y:*10+2}", "?={X:*10+1, Y:*10+2}",
            "?=*4+{X:*10+1, Y:*10+2}", "?={X:*10+1, Y:*10+2}",
            "alias=record:{X:*10+1, Y:*10+2}", "alias=other:{X:*10+1, Y:*10+2}", "alias=record:{X:*10+1, Y:*10+2}"};
        auto root=graphParsed(testName,expressions.at(caseID)),source=root->pItem->wrkList.front();
        if(caseID==9 || caseID==13) {
            SetModeBits(root->pItem->infSize->flags,infonState::evalMode,infonState::emLiteral);
            root->pItem->infSize->num.val=2;root->pItem->value->sizeMode=fromGiven;
        }
        auto before=toString(source->pItem.get());
        auto handle=caseID==11 ? normalizer.normalizeWithCost(root,0) : normalizer.normalize(root);
        handle.waitForCompletion();
        bool reject=caseID==9;
        bool passed=handle.status().failed==reject;
        auto target=caseID==3 ? root->pItem->value->items.head : root;
        auto data=caseID==3 ? source->pItem->value->items.head : source;
        auto first=target->pItem->value->items.head;
        if(caseID==11 || reject) {
            passed &= !first;
            if(caseID==11) passed &= handle.status().symbolicValues;
        } else if(caseID==5) {
            passed &= handle.status().symbolicValues && normalizer.access->hasDirectIdentity(first,data->pItem->value->items.tail) &&
                normalizer.access->hasDirectIdentity(first->next,data->pItem->value->items.head) && target->pItem->value->items.size()==2;
        } else if(!first) passed=false;
        else {
            passed &= target->pItem->orderMode==uUnordered && first && first!=data->pItem->value->items.head &&
                first->pItem!=data->pItem->value->items.head->pItem && first->pParent==target.get() &&
                normalizer.access->hasDirectIdentity(first,data->pItem->value->items.head) && target->pItem->value->items.size()==(caseID==4 ? 3 : 2);
            if(first && caseID!=6 && caseID!=7 && caseID!=2) passed &= first->pItem->value->num==1;
            if(caseID==1) passed &= getFlagBit(root->pItem->flags,infonView::isNormed) && !handle.status().symbolicValues;
            if(caseID==0 || caseID==4 || caseID==14) passed &= handle.status().symbolicValues && !getFlagBit(root->pItem->flags,infonView::isNormed);
            if(caseID==4) passed &= first && first->next->pItem->type->typeID()=="z" && target->pItem->type->typeID()=="record";
            if(caseID==2) passed &= first && first->pItem->value->items.size()==2 &&
                first->pItem->value->items.head!=data->pItem->value->items.head->pItem->value->items.head;
            if(caseID==6 || caseID==7) {
                passed &= handle.status().withSubscribers;
                if(caseID==7) handle.cancel();
                normalizer.addRHS(data->pItem->value->items.head,graphParsed(testName,"*10+1"));handle.waitForCompletion();
                passed &= first==target->pItem->value->items.head;
                if(caseID==7) passed &= handle.status().cancelled && getModeBits(first->pItem->value->flags,infonState::evalMode)==infonState::emUnknown;
                else passed &= first->pItem->value->num==1;
            }
            if(caseID==8 || caseID==13) {
                normalizer.runtime.update([&] {
                    auto added=graphParsed(testName,"Z:*10+3");data->pItem->value->items.appendPov(added);added->pParent=data.get();
                    ++data->workRevision;SetFlagBit(data->pItem->flags,infonView::isNormed,false);
                });
                // The bounded result completed; reconsider new source facts
                // on a fresh normalization, as for other completed queries.
                if(caseID==13) handle=normalizer.normalize(root);
                handle.waitForCompletion();
                if(caseID==13) passed &= handle.status().failed && target->pItem->value->items.size()==2;
                else passed &= !handle.status().failed && target->pItem->value->items.size()==3 && first==target->pItem->value->items.head &&
                    target->pItem->value->items.tail->pItem->value->num==3;
            }
            if(caseID==10) passed &= target->pItem->type->typeID()=="wheel" && data->pItem->type->typeID()=="pedal";
            if(caseID==17) {
                auto containing=graphParsed(testName,"{?}");containing->pItem->value->items.head->pItem=data->pItem;
                auto lookup=normalizer.findField(containing,graphParsed(testName,"alias"));lookup.waitForCompletion();
                auto result=lookup.result();
                passed &= result && result->pItem->isOrLike() && result->pItem->innr->value->items.isEmpty();
                lookup.cancel();
            }
            if(caseID==15) {
                auto lookup=normalizer.findField(target,graphParsed(testName,"Y"));lookup.waitForCompletion();
                auto result=lookup.result();
                passed &= result && result->pItem->isOrLike() && result->pItem->innr->value->items.size()==1;
                lookup.cancel();
            }
            // Lookup may publish result aliases and restart the still-open
            // normalization. Wait for that handle before reading its rendering
            // proof or taking a replay baseline.
            handle.waitForCompletion();
            if(caseID!=7 && caseID!=13) {
                auto count=target->pItem->value->items.size();auto identities=normalizer.access->registry->identities.size();
                auto text=toString(root->pItem.get());auto again=normalizer.normalize(root);again.waitForCompletion();
                passed &= !again.status().failed && first==target->pItem->value->items.head && count==target->pItem->value->items.size() &&
                    identities==normalizer.access->registry->identities.size() && text==toString(root->pItem.get());
                again.cancel();
            }
        }
        if(caseID!=6 && caseID!=7 && caseID!=8 && caseID!=13) passed &= before==toString(source->pItem.get());
        passed &= originalDefinition==toString(defs->pItem.get());
        if(!passed) {
            std::cout << "Record value " << caseID << ": " << toString(root->pItem.get()) << " symbolic=" << handle.status().symbolicValues << " " << handle.status().error << "\n";
            for(const auto& step:handle.steps()) std::cout << step.action << "\n";
        }
        handle.cancel();declared.cancel();normalizer.close();return passed;
    }%>
    void: unitTestGraphRecordValue(me string: testName, me int: caseID) <- {
        me bool: passed <- graphRecordValueCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHGRAMMARCHOICE(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphGrammarChoice(tname, CASE_ID)}%>
#define GRAPHWORDFORMS(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphWordForms(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHGRAMMARCHOICE(unit/graphGrammarChoice/contradiction, 13)
    GRAPHGRAMMARCHOICE(unit/graphGrammarChoice/directChoice, 11)
    GRAPHGRAMMARCHOICE(unit/graphGrammarChoice/nestedAlternatives, 12)
    GRAPHGRAMMARCHOICE(unit/graphGrammarChoice/repeated, 1)
    GRAPHGRAMMARCHOICE(unit/graphGrammarChoice/independentInstances, 2)
    GRAPHGRAMMARCHOICE(unit/graphGrammarChoice/mismatch, 3)
    GRAPHGRAMMARCHOICE(unit/graphGrammarChoice/wholeInput, 4)
    GRAPHGRAMMARCHOICE(unit/graphGrammarChoice/empty, 5)
    GRAPHGRAMMARCHOICE(unit/graphGrammarChoice/ambiguousFirst, 6)
    GRAPHGRAMMARCHOICE(unit/graphGrammarChoice/differentWidths, 7)
    GRAPHGRAMMARCHOICE(unit/graphGrammarChoice/lateDefinition, 8)
    GRAPHGRAMMARCHOICE(unit/graphGrammarChoice/cancel, 9)
    GRAPHGRAMMARCHOICE(unit/graphGrammarChoice/budget, 10)
    GRAPHWORDFORMS(unit/graphWordForms/plural, 1)
    GRAPHWORDFORMS(unit/graphWordForms/irregular, 2)
    GRAPHWORDFORMS(unit/graphWordForms/explicitType, 3)
    GRAPHWORDFORMS(unit/graphWordForms/pluralTemplate, 4)
    GRAPHWORDFORMS(unit/graphWordForms/lookup, 5)
    GRAPHWORDFORMS(unit/graphWordForms/emptyText, 6)
    GRAPHWORDFORMS(unit/graphWordForms/spaces, 7)
    GRAPHWORDFORMS(unit/graphWordForms/apostrophe, 8)
    GRAPHWORDFORMS(unit/graphWordForms/replay, 9)
    GRAPHWORDFORMS(unit/graphWordForms/literalOnly, 10)
    GRAPHWORDFORMS(unit/graphWordForms/declarationPrecedence, 11)

    me bool: graphGrammarChoiceCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer normalizer;normalizer.init();
        std::string declarations="{#A='A' #B='B' #token=*_+[A B] #language={token|...}}";
        std::string expression="language == 'ABBA'",expected="language:{A:'A' B:'B' B:'B' A:'A'}";
        if(caseID==2) {expression="{language == 'AB' language == 'BA'}";expected="{language:{A:'A' B:'B'} language:{B:'B' A:'A'}}";}
        if(caseID==3) expression="language == 'C'";
        if(caseID==4) expression="language == 'ABC'";
        if(caseID==5) {expression="language == ''";expected="language:{}";}
        if(caseID==6) {declarations="{#A='A' #B='A' #token=*_+[A B] #language={token|...}}";expression="language == 'A'";expected="language:{A:'A'}";}
        if(caseID==7) {declarations="{#A='A' #B='AB' #token=*_+[A B] #language={token|...}}";expression="language == 'ABA'";expected="language:{B:'AB' A:'A'}";}
        if(caseID==8 || caseID==9) {declarations="{#A='A' #token=*_+[A B] #language={token|...}}";expression="language == 'AB'";expected="language:{A:'A' B:'B'}";}
        if(caseID==11) {expression="{*_+[A B]|...} == 'AB'";expected="{A:'A' B:'B'}";}
        if(caseID==12) {declarations="{#token=*_+[{'A' 'B'} 'C'] #language={token|...}}";expression="language == 'ABCAB'";expected="language:{{'A' 'B'} 'C' {'A' 'B'}}";}
        if(caseID==13) {declarations="{#token=*_+[*10+1 *10+2]}";expression="token:*10+3";}
        auto defs=graphParsed(testName,declarations);
        auto registered=normalizer.normalize(defs);registered.waitForCompletion();
        auto before=normalizer.stringifyResult(defs);
        auto root=graphParsed(testName,expression);
        auto rhs=root->pItem->wrkList.empty() ? proteus4::POVNode{} : root->pItem->wrkList.front();
        auto sourceBefore=rhs ? toString(rhs->pItem.get()) : "";
        proteus4::CostPolicy policy;if(caseID==10) policy.maximumRoute=0;
        auto handle=normalizer.runtime.normalize({root,proteus4::sizeAndValue,0},policy);handle.waitForCompletion();
        bool passed=!handle.status().failed;
        if(caseID==13) {
            passed=handle.status().failed && handle.status().error.find("no compatible definition alternative")!=std::string::npos &&
                toString(root->pItem.get())=="token:*10+3" && before==normalizer.stringifyResult(defs);
            normalizer.close();return passed;
        }
        if(caseID==8 || caseID==9) {
            passed &= handle.status().symbolicValues && root->pItem->value->items.isEmpty();
            if(caseID==9) handle.cancel();
            auto more=graphParsed(testName,"{#B='B'}");
            auto publish=normalizer.normalize(more);publish.waitForCompletion();handle.waitForCompletion();
            passed &= !publish.status().failed;
        }
        bool pending=caseID==3 || caseID==4 || caseID==9 || caseID==10;
        if(pending) {
            passed &= handle.status().symbolicValues && root->pItem->value->items.isEmpty();
            if(caseID==9) passed &= handle.status().cancelled;
        } else {
            passed &= !handle.status().failed && !handle.status().symbolicValues &&
                getFlagBit(root->pItem->flags,infonView::isNormed) && toString(root->pItem.get())==expected;
            auto first=root->pItem->value->items.head;
            auto identities=normalizer.access->registry->identities.size();
            auto again=normalizer.normalize(root);again.waitForCompletion();
            passed &= !again.status().failed && toString(root->pItem.get())==expected &&
                root->pItem->value->items.head==first && identities==normalizer.access->registry->identities.size();
        }
        registered.waitForCompletion();
        passed &= before==normalizer.stringifyResult(defs) && (!rhs || sourceBefore==toString(rhs->pItem.get()));
        if(!passed) {
            std::cout << "Grammar choice " << caseID << ": " << handle.status().error << " symbolic=" << handle.status().symbolicValues << "\n" << normalizer.stringifyResult(root) << "\n";
            for(const auto& step:handle.steps()) std::cout << step.action << "\n";
        }
        handle.cancel();normalizer.close();return passed;
    }%>
    void: unitTestGraphGrammarChoice(me string: testName, me int: caseID) <- {
        me bool: passed <- graphGrammarChoiceCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }

    me bool: graphWordFormsCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer normalizer;normalizer.init();
        std::string expression="{bike|...}",expected="bikes:{bike|  ... }";
        if(caseID==2) {expression="{foot|...}";expected="feet:{foot|  ... }";}
        if(caseID==3) {expression="garage:{bike|...}";expected="garage:{bike|  ... }";}
        if(caseID==4) {expression="{bikes|...}";expected="{bikes|  ... }";}
        if(caseID==5) {expression="*3+{123, foot, {foot|foot1,foot2}}.feet";expected="feet:{foot| foot1, foot2}";}
        if(caseID==6) {expression="english-text:''";expected="english-phrase:{}";}
        if(caseID==7) {expression="english-text:'  One  two  '";expected="english-phrase:{One two}";}
        if(caseID==8 || caseID==9) {expression="english-text:\"Whoever says they can't is right\"";expected="english-phrase:{Whoever says they can't is right}";}
        if(caseID==10) {expression="english-text:$";expected="english-text:$";}
        if(caseID==11) {
            auto defs=graphParsed(testName,"{#feet=*10+_}");auto declaration=normalizer.normalize(defs);declaration.waitForCompletion();
            expression="{feet:*10+2}.feet";expected="feet:*10+2";
        }
        auto root=graphParsed(testName,expression);
        if(caseID==4) normalizer.runtime.update([&] {SetFlagBit(root->pItem->value->listSpec->type->flags,WordUse::plural,true);});
        auto spec=root->pItem->value->listSpec;
        auto before=spec ? toString(spec.get()) : "";
        auto handle=normalizer.normalize(root);handle.waitForCompletion();
        bool passed=!handle.status().failed && toString(root->pItem.get())==expected;
        if(caseID==5) passed &= root->pItem->orderMode==uUnordered;
        if(caseID==6 || caseID==7 || caseID==8 || caseID==9) {
            passed &= root->pItem->infSize->num==(caseID==6 ? 0 : caseID==7 ? 2 : 6);
            if(caseID!=6) passed &= handle.status().symbolicValues && !getFlagBit(root->pItem->flags,infonView::isNormed);
        }
        auto first=root->pItem->value->items.head;
        auto type=root->pItem->type;
        auto again=normalizer.normalize(root);again.waitForCompletion();
        passed &= !again.status().failed && toString(root->pItem.get())==expected &&
            first==root->pItem->value->items.head && type==root->pItem->type && (!spec || before==toString(spec.get()));
        if(!passed) {
            std::cout << "Word forms " << caseID << ": " << handle.status().error << " symbolic=" << handle.status().symbolicValues << "\n" << normalizer.stringifyResult(root) << "\n";
            for(const auto& step:handle.steps()) std::cout << step.action << "\n";
        }
        handle.cancel();normalizer.close();return passed;
    }%>
    void: unitTestGraphWordForms(me string: testName, me int: caseID) <- {
        me bool: passed <- graphWordFormsCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHBOUNDARY(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphBoundary(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHBOUNDARY(unit/graphBoundary/lateNull, 25)
    GRAPHBOUNDARY(unit/graphBoundary/nullRHS, 26)
    GRAPHBOUNDARY(unit/graphBoundary/namedQuerySource, 24)
    GRAPHBOUNDARY(unit/graphBoundary/aliases, 21)
    GRAPHBOUNDARY(unit/graphBoundary/chainedContext, 22)
    GRAPHBOUNDARY(unit/graphBoundary/streamedNulls, 23)
    GRAPHBOUNDARY(unit/graphBoundary/literal, 1)
    GRAPHBOUNDARY(unit/graphBoundary/named, 2)
    GRAPHBOUNDARY(unit/graphBoundary/invalidIDs, 3)
    GRAPHBOUNDARY(unit/graphBoundary/unknownOverlay, 4)
    GRAPHBOUNDARY(unit/graphBoundary/scalarBoundaries, 5)
    GRAPHBOUNDARY(unit/graphBoundary/finite, 6)
    GRAPHBOUNDARY(unit/graphBoundary/nested, 7)
    GRAPHBOUNDARY(unit/graphBoundary/nullSelf, 8)
    GRAPHBOUNDARY(unit/graphBoundary/empty, 9)
    GRAPHBOUNDARY(unit/graphBoundary/openClosure, 10)
    GRAPHBOUNDARY(unit/graphBoundary/sparse, 11)
    GRAPHBOUNDARY(unit/graphBoundary/identityScopes, 12)
    GRAPHBOUNDARY(unit/graphBoundary/copy, 13)
    GRAPHBOUNDARY(unit/graphBoundary/roundTrip, 14)
    GRAPHBOUNDARY(unit/graphBoundary/idExhaustion, 15)
    GRAPHBOUNDARY(unit/graphBoundary/budget, 16)
    GRAPHBOUNDARY(unit/graphBoundary/preflight, 17)
    GRAPHBOUNDARY(unit/graphBoundary/unordered, 18)
    GRAPHBOUNDARY(unit/graphBoundary/unknownBoundary, 19)
    GRAPHBOUNDARY(unit/graphBoundary/lateStructure, 20)

    me bool: graphBoundaryCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer n;n.init();auto reg=n.access->registry;
        auto parse=[&](std::string text) {auto p=graphParsed(testName,text);if(!p || !p->pItem) throw std::runtime_error("parse failed: "+text);return p;};
        auto norm=[&](const std::shared_ptr<POV>& p) {
            auto h=n.normalize(p);h.waitForCompletion();if(h.status().failed) throw std::runtime_error(h.status().error);return h;
        };
        auto boundary=[&](const std::shared_ptr<POV>& p,bool end) {
            auto h=n.findBoundary(p,end);h.waitForCompletion();
            if(h.status().failed || !h.result()) throw std::runtime_error("boundary unavailable: "+h.status().error);
            return h.result();
        };
        auto same=[&](auto a,auto b) {return reg->areIdentical(a,b);};
        bool ok=true;
        if(caseID==1) {
            auto p=parse("NULL:");auto h=norm(p);
            ok=p->pItem->isNull() && h.status().fullyNormed && toString(p->pItem.get())=="NULL:" &&
               !p->pItem->identityName && getModeBits(p->pItem->value->flags,infonState::overlayType)==infonState::tUnknown;
            ok &= toString(parse("NULL")->pItem.get())=="NULL" && !parse("NULL")->pItem->isNull();
            ok &= toString(parse("{NULL: 42}")->pItem.get())=="{NULL: 42}";
            ok &= toString(parse("tag:NULL:")->pItem.get())=="tag:NULL:";
        } else if(caseID==2) {
            auto p=parse("{NULL:647 NULL:647 NULL:648}");
            ok=toString(p->pItem.get())=="{NULL:647 NULL:647 NULL:648}";
            auto a=p->pItem->value->items.head,b=a->next,c=b->next;auto h=norm(p);
            ok &= same(a,b) && !same(a,c) && a!=b && p->pItem->infSize->num==3 && h.status().fullyNormed;
        } else if(caseID==3) {
            for(auto text:{"NULL:0","NULL:-1","NULL:9223372036854775808","NULL:18446744073709551616"}) {
                ProteusParser parser;parser.initParseFromString(testName,text);auto p=std::make_shared<infonView>();parser.doParse(p);
                ok &= parser.doesParseHaveError();
            }
        } else if(caseID==4) {
            auto p=parse("?");ok=!p->pItem->isNull() && getModeBits(p->pItem->value->flags,infonState::overlayType)==infonState::tUnknown;
            auto h=norm(p);ok &= h.status().symbolicValues && toString(p->pItem.get())=="?";
        } else if(caseID==5 || caseID==19) {
            for(auto text:caseID==5 ? std::vector<std::string>{"42.begin","'ab'.end","{1 2}.begin"} : std::vector<std::string>{"?.begin","?.end"}) {
                auto p=parse(text);auto h=norm(p);
                ok &= p->pItem->isNull() && p->pItem->identityName && p->pItem->identityName->id>0 && h.status().fullyNormed;
                auto result=p->pItem->pathSelection->result;norm(p);ok &= p->pItem->pathSelection->result==result;
            }
        } else if(caseID==6 || caseID==7) {
            auto p=parse(caseID==6 ? "{T 1 2}" : "{T {T 1 2} {T 3 4}}");auto h=norm(p);
            auto a=p->pItem->value->items.head,b=a->next;
            ok=same(boundary(p,false),boundary(a,false)) && same(boundary(a,true),boundary(b,false)) && same(boundary(p,true),boundary(b,true));
            ok &= !same(boundary(p,false),boundary(p,true)) && boundary(p,false)==boundary(p,false);
            if(caseID==7) ok &= same(boundary(a->pItem->value->items.tail,true),boundary(b->pItem->value->items.head,false));
            ok &= h.status().fullyNormed;
        } else if(caseID==8) {
            auto p=parse("NULL:");ok=boundary(p,false)==p && boundary(p,true)==p;
            auto list=parse("{T NULL: NULL:}");norm(list);boundary(list,false);
            auto a=list->pItem->value->items.head,b=a->next;
            ok &= a!=b && same(a,b) && list->pItem->infSize->num==2 && list->pItem->value->items.size()==2;
            auto q=parse("NULL:647.begin.end");norm(q);ok &= q->pItem->isNull();
        } else if(caseID==9) {
            auto p=parse("{T}");norm(p);ok=same(boundary(p,false),boundary(p,true));
        } else if(caseID==10) {
            for(auto text:{"{T 1 2 ...}","{T ...}"}) {
                auto p=parse(text);auto h=norm(p);auto first=boundary(p,false),last=boundary(p,true);
                auto tail=p->pItem->value->items.tail;
                ok &= h.status().withSubscribers && !same(first,last) && (!tail || !same(boundary(tail,true),last));
                n.runtime.update([&] {SetFlagBit(p->pItem->value->flags,infonState::tailUnfinished,false);});
                h.waitForCompletion();
                ok &= !h.status().failed && boundary(p,true)==last && same(tail ? boundary(tail,true) : first,last);
                h.cancel();
            }
        } else if(caseID==11) {
            auto p=parse("*1000000000+{T item| ...}");auto first=boundary(p,false),last=boundary(p,true);
            ok=!same(first,last) && p->pItem->value->items.size()==0 && reg->repetitionFamilies.empty() && reg->boundaries.size()==1;
        } else if(caseID==12 || caseID==14) {
            ProteusCore core;core.init("",false);
            auto a=core.parseAndExtractString("NULL:647",testName,false);
            auto b=core.parseAndExtractString("NULL:647",testName,false);
            auto imported=core.parseAndExtractString("{NULL:647 NULL:647}",testName,true);
            auto x=imported->value->items.head,y=x->next;
            ok=a && b && a->identityName==b->identityName && x->pItem->identityName==y->pItem->identityName && x->pItem->identityName!=a->identityName;
            if(caseID==14) {
                auto p=parse("42");auto result=boundary(p,true);
                ProteusParser parser;parser.CORE=&core;parser.initParseFromString(testName,toString(result->pItem.get()));
                auto copy=std::make_shared<infonView>();parser.doParse(copy);
                ok &= !parser.doesParseHaveError() && copy->isNull() && toString(copy.get())==toString(result->pItem.get());
            }
        } else if(caseID==13) {
            auto p=parse("NULL:647");auto copy=std::make_shared<infonView>();p->pItem->copyAsTypeTo(copy,true,true);
            ok=copy->isNull() && !copy->identityName;
        } else if(caseID==15) {
            InfonIdentityScope scope;auto token=scope.claim(INT64_MAX);bool threw=false;
            try {scope.allocate();} catch(const std::overflow_error&) {threw=true;}
            ok=threw && token->id==INT64_MAX && scope.claim(INT64_MAX)==token;
        } else if(caseID==16) {
            auto p=parse("42.begin");auto h=n.normalizeWithCost(p,1);h.waitForCompletion();
            ok=!h.status().failed && h.status().symbolicValues && reg->boundaries.empty();h.cancel();ok &= h.status().cancelled;
        } else if(caseID==17) {
            for(auto text:{"NULL:","NULL:647","{NULL: NULL:647}","?","NULL"}) {
                ProteusParser parser;parser.initParseFromString(testName,text);std::int64_t pos=0;
                auto status=parser.preCheckInfonView(&pos,true,pcMainInfn);
                if(status!=valid_done && status!=valid_maybeDone) std::cout << "Preflight " << text << " status=" << int(status) << " position=" << pos << "\n";
                ok &= status==valid_done || status==valid_maybeDone;
            }
        } else if(caseID==18) {
            auto p=parse("{1,2}");norm(p);auto a=p->pItem->value->items.head,b=a->next;
            ok=!same(boundary(a,true),boundary(b,false));
            auto q=parse("{1,2}.begin");norm(q);ok &= q->pItem->isNull() && !q->pItem->isOrLike();
        } else if(caseID==20) {
            auto p=parse("?");auto first=boundary(p,false),last=boundary(p,true);
            auto rhs=parse("{T 1 2}");n.addRHS(p,rhs);auto h=norm(p);
            ok=boundary(p,false)==first && boundary(p,true)==last && !h.status().failed;
            if(p->pItem->value->items.head) ok &= same(first,boundary(p->pItem->value->items.head,false));
            else ok=false;
        }
        if(caseID==21) {
            auto a=parse("42"),b=parse("42");n.recordIdentity(a,b);
            auto x=boundary(a,false),y=boundary(b,false);
            ok=same(x,y) && !same(x,boundary(b,true));
            auto unrelated=parse("42");ok &= !same(x,boundary(unrelated,false));
        } else if(caseID==22) {
            auto q=parse("{T 1 2}@[1].end");norm(q);
            auto step=q->pItem->pathSelection->source->pItem->pathSelection;
            ok=q->pItem->isNull() && step && !step->locations.empty();
            if(ok) {
                auto source=step->source;auto a=source->pItem->value->items.head,b=a->next;
                auto selected=q->pItem->pathSelection->result;
                proteus4::BoundaryGraph graph(n.access);
                auto bBegin=graph.lookup(b,false);
                ok &= bBegin && same(selected,bBegin) && a!=b;
            }
        } else if(caseID==23) {
            ProteusCore core;core.init("",false);
            auto& streamNorm=core.agent->graphNormalizer;
            auto source=std::make_shared<POV>(609);source->pItem=std::make_shared<infonView>();
            strBuf buffer;buffer.init(testName);
            ProteusParser parser;parser.CORE=&core;parser.streamingMode=true;parser.initParseFromStream(&buffer);
            streamNorm.prepareInput(source->pItem);
            std::thread reader([&] {parser.doParse(source->pItem);});
            buffer.putStr("{T NULL:6");
            auto handle=streamNorm.findBoundary(source,true);handle.waitForCompletion();auto end=handle.result();
            buffer.putStr("47 NULL:647}");buffer.close();reader.join();handle.waitForCompletion();
            auto a=source->pItem->value->items.head,b=a ? a->next : nullptr;
            auto scope=core.agent->identityRegistry;
            ok=!parser.doesParseHaveError() && !handle.status().failed && handle.result()==end &&
                a && b && a!=b && a->pItem->identityName==b->pItem->identityName &&
                a->pItem->identityName->id==647 && scope->areIdentical(end,b);
            if(!ok) std::cout << "Streamed nulls: parse=" << parser.doesParseHaveError() << " error=" << handle.status().error << " source=" << toString(source->pItem.get()) << "\n";
            handle.cancel();
        }
        if(caseID==24) {
            ProteusCore core;core.init("",false);
            auto item=core.parseAndExtractString("NULL:647.begin",testName,false);
            auto query=std::make_shared<POV>(609);query->pItem=item;
            auto handle=core.agent->graphNormalizer.normalize(query);handle.waitForCompletion();
            auto token=core.agent->identityRegistry->occurrenceScope.claim(647);
            auto source=core.agent->identityRegistry->namedOccurrences.at(token);
            ok=!handle.status().failed && query->pItem->isNull() && source!=query &&
                source->pItem->isNull() && !source->pItem->pathSelection && source->pItem->identityName==token;
        }
        if(caseID==25) {
            auto p=parse("?");auto first=boundary(p,false),last=boundary(p,true);
            n.runtime.update([&] {p->pItem->setToNull();});
            ok=boundary(p,false)==p && boundary(p,true)==p && same(first,p) && same(last,p);
        } else if(caseID==26) {
            auto p=parse("?=NULL:647");auto h=norm(p);
            ok=p->pItem->isNull() && h.status().fullyNormed;
        }
        if(!ok) std::cout << "Boundary case " << caseID << " failed\n";
        n.close();return ok;
    }%>
    void: unitTestGraphBoundary(me string: testName, me int: caseID) <- {
        me bool: passed <- graphBoundaryCase(testName,caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

// Temporal relations use the same graph lifecycle and list navigation as S-lists.
#define GRAPHPRESERVATION(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphPreservation(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHPRESERVATION(unit/graphPreservation/scalar, 0)
    GRAPHPRESERVATION(unit/graphPreservation/changed, 1)
    GRAPHPRESERVATION(unit/graphPreservation/blocked, 2)
    GRAPHPRESERVATION(unit/graphPreservation/record, 3)
    GRAPHPRESERVATION(unit/graphPreservation/nested, 4)
    GRAPHPRESERVATION(unit/graphPreservation/ordinaryUnknown, 5)
    GRAPHPRESERVATION(unit/graphPreservation/nestedBlock, 6)
    GRAPHPRESERVATION(unit/graphPreservation/ordered, 7)
    GRAPHPRESERVATION(unit/graphPreservation/parentBlock, 8)
    GRAPHPRESERVATION(unit/graphPreservation/rhsMarker, 9)
    GRAPHPRESERVATION(unit/graphPreservation/explicitRead, 10)
    GRAPHPRESERVATION(unit/graphPreservation/stateIsolation, 11)
    GRAPHPRESERVATION(unit/graphPreservation/threeStates, 12)
    GRAPHPRESERVATION(unit/graphPreservation/lateSource, 13)
    GRAPHPRESERVATION(unit/graphPreservation/pendingGuard, 14)
    GRAPHPRESERVATION(unit/graphPreservation/ambiguous, 15)
    GRAPHPRESERVATION(unit/graphPreservation/spatial, 16)
    GRAPHPRESERVATION(unit/graphPreservation/pendingParent, 17)
    GRAPHPRESERVATION(unit/graphPreservation/replay, 18)
    GRAPHPRESERVATION(unit/graphPreservation/sparseSafety, 19)
    GRAPHPRESERVATION(unit/graphPreservation/retainedPath, 20)
    GRAPHPRESERVATION(unit/graphPreservation/typedRetainedPath, 21)
    GRAPHPRESERVATION(unit/graphPreservation/selectedState, 22)
    GRAPHPRESERVATION(unit/graphPreservation/mappedChange, 23)
    GRAPHPRESERVATION(unit/graphPreservation/definitionMarker, 24)
    GRAPHPRESERVATION(unit/graphPreservation/cancel, 25)
    GRAPHPRESERVATION(unit/graphPreservation/cost, 26)
    GRAPHPRESERVATION(unit/graphPreservation/copyAndClear, 27)
    GRAPHPRESERVATION(unit/graphPreservation/memberSpecification, 28)
    GRAPHPRESERVATION(unit/graphPreservation/priorDeclaration, 29)
    GRAPHPRESERVATION(unit/graphPreservation/sharedValueObserver, 30)
    GRAPHPRESERVATION(unit/graphPreservation/impliedChange, 31)
    GRAPHPRESERVATION(unit/graphPreservation/wrappedOrderedPath, 32)
    GRAPHPRESERVATION(unit/graphPreservation/wrappedRepeatedPath, 33)
    GRAPHPRESERVATION(unit/graphPreservation/latePartAlias, 34)
    GRAPHPRESERVATION(unit/graphPreservation/latePartValue, 35)
    GRAPHPRESERVATION(unit/graphPreservation/cancelLatePart, 36)

    GRAPHPRESERVATION(unit/graphPreservation/contextualSibling, 37)
    GRAPHPRESERVATION(unit/graphPreservation/symbolicSibling, 38)
    GRAPHPRESERVATION(unit/graphPreservation/pendingCompositeGuard, 39)

    me bool: graphLateTemporalPartCase(me string: testName, me int: caseID) <- <%{
        using namespace proteus4;
        GraphNormalizer n;n.init();
        auto parse=[&](const std::string& text){return graphParsed(testName,text);};
        auto defs=parse("{#piece={a,b}}");auto dh=n.normalize(defs);dh.waitForCompletion();dh.cancel();
        auto root=parse("{T {anchor:5,solved} {piece.a=3;,}}");
        auto before=POVDescription(root).member(),after=POVDescription(root).member(true);
        auto part=POVDescription(after).member();
        auto h=n.normalize(root);h.waitForCompletion();
        bool ok=!h.status().failed && h.status().withSubscribers && after->pItem->value->items.size()==2 &&
            n.knownField(after,"anchor") && n.knownField(after,"anchor")->pItem->value->num==5 &&
            !part->pItem->temporalPredecessor;
        auto a=n.knownField(part,"a");ok &= a && a->pItem->value->num==3;
        if(caseID==36) h.cancel();
        auto meaning=parse(caseID==35 ? "{#solved=*10+7}" : "{#solved=piece:{a:0,b:7}}");
        auto arrived=n.normalize(meaning);arrived.waitForCompletion();h.waitForCompletion();
        if(caseID==36) {
            ok &= h.status().cancelled && !part->pItem->temporalPredecessor && after->pItem->value->items.size()==2;
        } else if(caseID==35) {
            auto inherited=n.knownField(after,"solved");
            ok &= !h.status().failed && inherited && inherited->pItem->value->num==7 && after->pItem->value->items.size()==3;
        } else {
            auto b=n.knownField(part,"b");auto prior=n.knownField(before,"solved");
            ok &= !h.status().failed && after->pItem->value->items.size()==2 && part->pItem->temporalPredecessor==prior &&
                b && b->pItem->value->num==7 && a->pItem->value->num==3 &&
                prior && n.knownField(prior,"a") && n.knownField(prior,"a")->pItem->value->num==0;
        }
        if(!ok) std::cout<<"Late temporal part "<<caseID<<": "<<toString(root->pItem.get())<<" error="<<h.status().error<<"\n";
        arrived.cancel();h.cancel();n.close();return ok;
    }%>

    me bool: graphWrappedTemporalPathCase(me string: testName, me bool: repeated) <- <%{
        GraphNormalizer n;n.init();
        auto parse=[&](const std::string& text){return graphParsed(testName,text);};
        auto world=parse(repeated ?
            "{#pose={a,b} #unit={pose,} #piece={*2+{unit|unit:{pose,} unit:{pose,}},} "
            "#solved=piece:{*2+{unit|unit:{pose:{a:0,b:7},} unit:{pose:{a:0,b:8},}},} "
            "#history={T {anchor,piece}|...} history:{T {anchor,piece}| "
            "{anchor:5,solved} {piece.units@[1].pose.a=3;;;;,}}}" :
            "{#pose={a,b} #piece={pose} #solved=piece:{pose:{a:0,b:7}} "
            "#history={T {anchor,piece}|...} history:{T {anchor,piece}| "
            "{anchor:5,solved} {piece.pose.a=3;;,}}}");
        n.setWorld(world->pItem);
        auto loaded=n.normalize(world);loaded.waitForCompletion();
        bool ok=!loaded.status().failed;
        std::string part=repeated ? ".piece.units@[1].pose" : ".piece.pose";
        std::vector<std::pair<std::string,std::string>> reads={
            {"%W.history@[2]"+part+".a","*_+[a:3 ... ]"},
            {"%W.history@[2]"+part+".b","*_+[b:7 ... ]"},
            {"%W.history@[1]"+part+".a","*_+[a:0 ... ]"},
            {"%W.history@[2].anchor","*_+[anchor:5 ... ]"}
        };
        if(repeated) reads.push_back({"%W.history@[2].piece.units@[2].pose.b","*_+[b:8 ... ]"});
        for(const auto& read:reads) {
            auto query=parse(read.first);auto h=n.normalize(query);h.waitForCompletion();
            auto actual=toString(query->pItem.get());
            bool correct=!h.status().failed && actual==read.second;
            if(!correct) std::cout<<read.first<<" => "<<actual<<" error="<<h.status().error<<"\n";
            ok &= correct;h.cancel();
        }
        loaded.cancel();n.close();return ok;
    }%>


    me bool: graphPartialTemporalPartsCase(me string: testName, me int: caseID) <- <%{
        using namespace proteus4;
        GraphNormalizer n;n.init();
        auto parse=[&](const std::string& text){return graphParsed(testName,text);};
        if(caseID==39) {
            auto root=parse("{T {a:0,b:7} {a:1,}}");
            auto after=POVDescription(root).member(true),source=parse("?");
            n.prepareInput(source->pItem);n.addRHS(after,source);
            auto h=n.normalize(root);h.waitForCompletion();
            bool ok=!h.status().failed && h.status().withSubscribers && !n.knownField(after,"b");
            auto declaration=parse("%?");
            n.runtime.update([&]{source->pItem=declaration->pItem;});h.waitForCompletion();
            ok &= !h.status().failed && POVDescription(after).independentTemporalValue() && !n.knownField(after,"b");
            if(!ok) std::cout<<"Pending composite: "<<toString(root->pItem.get())<<" error="<<h.status().error<<"\n";
            h.cancel();n.close();return ok;
        }
        std::string sibling=caseID==38 ? "%.missing" : "%.shade";
        auto world=parse("{#shade={hue:_} #red=shade:{hue:5} #pose={x:_} #side={shade} "
            "#item={pose,shade,*2+{side|{"+sibling+"}{red}}} "
            "#layout={*1+{item|item:{red}},marker:_} "
            "#initial=layout:{*1+{item|item:{pose:{x:7},}},marker:1} "
            "#history={T layout|...} history:{T initial layout:{marker:2,}}}");
        n.setWorld(world->pItem);auto loaded=n.normalize(world);loaded.waitForCompletion();
        bool ok=!loaded.status().failed;
        // An unresolved contextual sibling must not block existing correspondence.
        std::vector<std::pair<std::string,std::string>> reads={
            {"%W.history@[2].items@[1].pose.x","*_+[x:7 ... ]"},
            {"%W.history@[1].items@[1].pose.x","*_+[x:7 ... ]"},
            {"%W.history@[2].marker","*_+[marker:2 ... ]"},
            {"%W.history@[1].marker","*_+[marker:1 ... ]"}
        };
        if(caseID==37) reads.push_back({"%W.history@[2].items@[1].shade.hue","*_+[hue:5 ... ]"});
        for(const auto& read:reads) {
            auto query=parse(read.first);auto h=n.normalize(query);h.waitForCompletion();
            auto actual=toString(query->pItem.get());bool correct=!h.status().failed && actual==read.second;
            if(!correct) std::cout<<read.first<<" => "<<actual<<" error="<<h.status().error<<"\n";
            ok &= correct;h.cancel();
        }
        if(caseID==38) {
            // Loading the containing model can leave an undemanded side lazy.
            // Asking for that side must retain its missing contextual dependency.
            auto query=parse("%W.history@[2].items@[1].sides@[1].shade");
            auto requested=n.normalize(query);requested.waitForCompletion();
            ok &= loaded.status().symbolicValues && !requested.status().failed &&
                requested.status().withSubscribers;
            requested.cancel();
        }
        loaded.cancel();n.close();return ok;
    }%>

    me bool: graphPreservationCase(me string: testName, me int: caseID) <- <%{
        if(caseID>=37 && caseID<=39) return graphPartialTemporalPartsCase(testName,caseID);
        if(caseID==32 || caseID==33) return graphWrappedTemporalPathCase(testName,caseID==33);
        if(caseID>=34 && caseID<=36) return graphLateTemporalPartCase(testName,caseID);
        using namespace proteus4;
        GraphNormalizer n;n.init();
        auto parse=[&](const std::string& text){return graphParsed(testName,text);};
        auto field=[](const POVNode& node,const std::string& name) {
            for(auto p=POVDescription(node).member();p;p=p->next)
                if(p->pItem->type && p->pItem->type->typeID()==name) return p;
            return POVNode{};
        };
        auto value=[&](const POVNode& p,int v) {return p && (n.access->known(p)&valueOnly) && p->pItem->value->num==v;};
        std::vector<std::string> inputs={
            "{T *10+7 ?}","{T *10+7 *10+8}","{T *10+7 %?}",
            "{T {a:0,b:7} {a:1,}}",
            "{T {part:{a:0,b:7},c:3} {part:{a:1,},}}",
            "{T {a:0,b:7} {a:1,b:?}}",
            "{T {part:{a:0,b:7},c:3} {part:{a:1,b:%?},}}",
            "{T {0 7} {1 ?}}",
            "{T {part:{a:0,b:7},c:3} {part:%?,}}",
            "{T *10+7 ? = %?}","{T *10+7 %? = %tprev}",
            "{T {a:0,b:7} {a:1,}}", "{T *10+7 ? ?}",
            "{T ? ?}","{T *10+7 ?}",
            "{T {b:7,b:8} {b:?,}}", "{{a:0,b:7} {a:1,}}",
            "{T {a:0,b:7} {a:1,b:?}}", "{T {a:0,b:7} {a:1,}}",
            "{T *1000000+{_|...} ?}",
            "{T {a:0,b:7} {a:?,b:?}.a=1;}",
            "{T state:{a:0,b:7} state.a=1;}",
            "{T {a:0,b:7} {a:1,}}@[2].b",
            "{T {a:0,b:7} {a:1,b:%?}}",
            "{T *10+7 fresh}","{T ? ?}","{T *10+7 ?}","{T *10+7 ?}",
            "{T {n|1 7} {n|2 ?}}", "{T %? = *10+7 ?}", "{T *10+7 ?}",
            "{T {a:0,b:7} {a:?=1,b:?}}"
        };
        if(caseID==21 || caseID==24) {
            auto defs=parse(caseID==21 ? "{#state={a:_,b:_}}" : "{#fresh=%?}");
            auto dh=n.normalize(defs);dh.waitForCompletion();dh.cancel();
        }
        auto p=parse(inputs.at(caseID));auto before=POVDescription(p).member(),after=POVDescription(p).member(true);
        auto original=toString(before->pItem.get());auto source=POVNode{};
        if(caseID==14 || caseID==17) {
            source=parse("?");n.prepareInput(source->pItem);
            n.addRHS(after,source);
        }
        if(caseID==23) {
            source=parse("?");auto middle=parse("?");
            n.recordIdentity(field(after,"b"),middle);n.recordIdentity(middle,source);
        }
        if(caseID==31) {
            auto middle=parse("?");
            n.recordIdentity(field(after,"b"),middle);n.recordIdentity(middle,field(after,"a"));
        }
        std::optional<decltype(n.normalize(p))> observer;
        if(caseID==30) {
            auto alias=parse("?");
            // A selected shared-state view has its own overlay header.
            SetModeBits(alias->pItem->flags,infonView::viewMode,infonView::vmOverlay);
            alias->pItem->value=after->pItem->value;alias->pItem->infSize=after->pItem->infSize;
            observer=n.normalize(alias);observer->waitForCompletion();
        }
        auto h=caseID==26 ? n.normalizeWithCost(p,0) : n.normalize(p);h.waitForCompletion();bool ok=!h.status().failed;
        if(caseID==20 || caseID==21) ok &= value(field(after,"a"),1) && value(field(after,"b"),7);
        if(caseID==22) {
            auto state=p->pItem->pathSelection;ok &= state && !state->matches.empty() && value(state->matches.front(),7);
        }
        if(caseID==23) {
            ok &= !value(field(after,"b"),7) && h.status().withSubscribers;
            n.addRHS(source,parse("8"));h.waitForCompletion();
            ok &= !h.status().failed && value(field(after,"b"),8) && value(field(before,"b"),7);
        }
        if(caseID==24) ok &= POVDescription(after).independentTemporalValue() && !(n.access->known(after)&valueOnly);
        if(caseID==25) {
            h.cancel();n.addRHS(before,parse("*10+7"));
            ok &= h.status().cancelled && !(n.access->known(after)&valueOnly);
        }
        if(caseID==26) ok &= !POVDescription(after).temporalPredecessor() && !(n.access->known(after)&valueOnly) && h.status().withSubscribers;
        if(caseID==27) {
            auto copy=std::make_shared<infonView>();after->pItem->copyAsTypeTo(copy,true,true);
            ok &= after->pItem->temporalPredecessor && !copy->temporalPredecessor;
            n.runtime.update([&]{after->pItem->clear();});ok &= !after->pItem->temporalPredecessor;
        }
        if(caseID==28) ok &= value(POVDescription(after).member(),2) && value(POVDescription(after).member(true),7) &&
            value(POVDescription(before).member(),1) && value(POVDescription(before).member(true),7);
        if(caseID==29) ok &= value(after,7) && !POVDescription(after).independentTemporalValue();
        if(caseID==30) {
            observer->waitForCompletion();
            ok &= value(observer->result(),7) && !observer->status().symbolicValues;
            observer->cancel();
        }
        if(caseID==31) ok &= value(field(after,"a"),1) && value(field(after,"b"),1) && value(field(before,"b"),7);
        if(caseID==0 || caseID==12) ok &= value(after,7);
        if(caseID==1) ok &= value(after,8);
        if(caseID==2 || caseID==9) ok &= !(n.access->known(after)&valueOnly) && h.status().withSubscribers;
        if(caseID==10) ok &= value(after,7) && POVDescription(after).independentTemporalValue();
        if(caseID==3 || caseID==5 || caseID==11 || caseID==18) ok &= value(field(after,"a"),1) && value(field(after,"b"),7);
        if(caseID==4 || caseID==6) {
            auto part=field(after,"part"),b=part ? field(part,"b") : POVNode{};
            ok &= part && value(field(part,"a"),1) && value(field(after,"c"),3);
            ok &= caseID==4 ? value(b,7) : b && !(n.access->known(b)&valueOnly) && POVDescription(b).independentTemporalValue();
        }
        if(caseID==7) ok &= value(POVDescription(after).member(),1) && value(POVDescription(after).member(true),7);
        if(caseID==8) ok &= field(after,"part") && !(n.access->known(field(after,"part"))&valueOnly) && value(field(after,"c"),3);
        if(caseID==13) {
            ok &= !(n.access->known(after)&valueOnly) && h.status().withSubscribers;
            n.addRHS(before,parse("*10+7"));h.waitForCompletion();ok &= !h.status().failed && value(after,7);
        }
        if(caseID==14 || caseID==17) {
            auto target=caseID==14 ? after : field(after,"b");
            ok &= target && !(n.access->known(target)&valueOnly) && h.status().withSubscribers;
            auto declaration=parse(caseID==14 ? "%?" : "{a:1,b:%?}");
            n.runtime.update([&]{source->pItem=declaration->pItem;});h.waitForCompletion();
            ok &= !h.status().failed && !(n.access->known(target)&valueOnly) && POVDescription(target).independentTemporalValue();
        }
        if(caseID==15) ok &= field(after,"b") && !(n.access->known(field(after,"b"))&valueOnly);
        if(caseID==16) ok &= !field(after,"b");
        if(caseID==19) ok &= before->pItem->value->items.size()==0 && after->pItem->value->items.size()==0 && h.status().withSubscribers;
        ok &= toString(before->pItem.get())==original || caseID==13 || caseID==25 || caseID==22 || caseID==28;
        ok &= !n.access->registry->areIdentical(before,after) && before->pItem!=after->pItem;
        if(caseID==18) {
            auto child=field(after,"b");auto replay=n.normalize(p);replay.waitForCompletion();
            ok &= !replay.status().failed && child==field(after,"b");
            for(const auto& step:replay.steps()) ok &= step.action!="Set corresponding temporal parts" && step.action!="Set preserved scalar value";
            replay.cancel();
        }
        if(!ok) {
            std::cout<<"Preservation "<<caseID<<" result="<<toString(p->pItem.get())<<" error="<<h.status().error<<"\n";
            for(const auto& step:h.steps()) std::cout<<step.action<<" kind="<<step.query.kind<<" node="<<toString(step.query.node->pItem.get())<<"\n";
        }
        h.cancel();n.close();return ok;
    }%>
    void: unitTestGraphPreservation(me string: testName, me int: caseID) <- {
        me string: actual <- "false"; me string: expected <- "true"
        if(graphPreservationCase(testName,caseID)){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHTEMPORALINDEPENDENCE(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphTemporalIndependence(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHTEMPORALINDEPENDENCE(unit/graphTemporalIndependence/syntax, 0)
    GRAPHTEMPORALINDEPENDENCE(unit/graphTemporalIndependence/preflight, 1)
    GRAPHTEMPORALINDEPENDENCE(unit/graphTemporalIndependence/ordinaryUnknown, 2)
    GRAPHTEMPORALINDEPENDENCE(unit/graphTemporalIndependence/pending, 3)
    GRAPHTEMPORALINDEPENDENCE(unit/graphTemporalIndependence/sameValue, 4)
    GRAPHTEMPORALINDEPENDENCE(unit/graphTemporalIndependence/differentValue, 5)
    GRAPHTEMPORALINDEPENDENCE(unit/graphTemporalIndependence/conflict, 6)
    GRAPHTEMPORALINDEPENDENCE(unit/graphTemporalIndependence/rhs, 7)
    GRAPHTEMPORALINDEPENDENCE(unit/graphTemporalIndependence/lateValue, 8)
    GRAPHTEMPORALINDEPENDENCE(unit/graphTemporalIndependence/explicitRead, 9)
    GRAPHTEMPORALINDEPENDENCE(unit/graphTemporalIndependence/definition, 10)
    GRAPHTEMPORALINDEPENDENCE(unit/graphTemporalIndependence/copyAndClear, 11)
    GRAPHTEMPORALINDEPENDENCE(unit/graphTemporalIndependence/selectedField, 12)
    GRAPHTEMPORALINDEPENDENCE(unit/graphTemporalIndependence/streamFragments, 13)
    GRAPHTEMPORALINDEPENDENCE(unit/graphTemporalIndependence/embeddedRoundTrip, 14)

    me bool: graphTemporalIndependenceCase(me string: testName, me int: caseID) <- <%{
        using namespace proteus4;
        GraphNormalizer n;n.init();
        auto parse=[&](const std::string& text){return graphParsed(testName,text);};
        auto norm=[&](const POVNode& p){auto h=n.normalize(p);h.waitForCompletion();return h;};
        auto declared=[](const POVNode& p){return POVDescription(p).independentTemporalValue();};
        bool ok=true;
        if(caseID==0) {
            for(auto text:{"%?","b:%?","{T 7 %?}","{% ?}"}) {
                auto p=parse(text);ok &= p && toString(p->pItem.get())==text;
            }
            auto p=parse("{%? % ?}");auto a=p->pItem->value->items.head,b=a->next,c=b->next;
            ok &= p->pItem->value->items.size()==3 && declared(a) && !declared(b) && !declared(c) &&
                getModeBits(b->pItem->flags,infonView::cursorMode)==infonView::cmSelf;
        } else if(caseID==1) {
            for(auto text:{"%?","b:%?","{T 7 %?}","%? = *10+7","b:?","? = *10+7"}) {
                ProteusParser parser;parser.initParseFromString(testName,text);std::int64_t pos=0;
                auto status=parser.preCheckInfonView(&pos,true,pcMainInfn);
                bool valid=(status==valid_done || status==valid_maybeDone) && !parser.doesParseHaveError();
                if(!valid) std::cout<<"Marker preflight "<<text<<" status="<<int(status)<<" position="<<pos<<"\n";
                ok &= valid;
            }
            strBuf buffer;buffer.init(testName);buffer.putStr("%");
            ProteusParser parser;parser.initParseFromStream(&buffer);std::int64_t pos=0;
            auto partial=parser.preCheckInnerInfonView(&pos,pcMainInfn);
            ok &= partial==valid_notDone;
            buffer.putStr("?");buffer.close();pos=0;
            auto complete=parser.preCheckInnerInfonView(&pos,pcMainInfn);
            if(partial!=valid_notDone || complete!=valid_done || pos!=2)
                std::cout<<"Marker fragments "<<int(partial)<<"/"<<int(complete)<<" position="<<pos<<"\n";
            ok &= complete==valid_done && pos==2;
        } else if(caseID==2) {
            for(auto text:{"?","_","b:?"}) {
                auto p=parse(text);auto h=norm(p);ok &= !h.status().failed && !declared(p);h.cancel();
            }
        } else if(caseID==14) {
            for(auto text:{"{&%? = { ... }}","{&%? = {1 2}}"}) {
                auto p=parse(text);auto h=norm(p);auto member=p->pItem->value->items.head;
                ok &= !h.status().failed && declared(member) && toString(p->pItem.get())==text;
                auto copy=parse(toString(p->pItem.get()));auto again=norm(copy);
                ok &= !again.status().failed && declared(copy->pItem->value->items.head) && toString(copy->pItem.get())==text;
                again.cancel();h.cancel();
            }
        } else if(caseID==11) {
            auto p=parse("%?");auto copy=std::make_shared<POV>(609);copy->pItem=std::make_shared<infonView>();
            p->pItem->copyAsTypeTo(copy->pItem,true,true);
            ok=declared(copy) && toString(copy->pItem.get())=="%?";
            copy->pItem->clear();ok &= !declared(copy) && declared(p);
        } else if(caseID==13) {
            ProteusCore core;core.init("",false);auto& streamNorm=core.agent->graphNormalizer;
            auto source=std::make_shared<POV>(609);source->pItem=std::make_shared<infonView>();
            strBuf buffer;buffer.init(testName);
            ProteusParser parser;parser.CORE=&core;parser.streamingMode=true;parser.initParseFromStream(&buffer);
            streamNorm.prepareInput(source->pItem);
            std::thread reader([&] {parser.doParse(source->pItem);});
            buffer.putStr("{T *10+7 %");
            auto h=streamNorm.normalize(source);h.waitForCompletion();
            buffer.putStr("?}");buffer.close();reader.join();h.waitForCompletion();
            auto a=source->pItem->value->items.head,b=a ? a->next : nullptr;
            ok=!parser.doesParseHaveError() && !h.status().failed && source->pItem->value->items.size()==2 &&
                a && b && !declared(a) && declared(b) && streamNorm.access->known(b)==0;
            h.cancel();
        } else {
            std::string input="{T *10+7 %?}";
            if(caseID==4) input="{T *10+7 %? = *10+7}";
            if(caseID==5) input="{T *10+7 %? = *10+8}";
            if(caseID==6) input="%? = *10+7 = *10+8";
            if(caseID==7) input="*10+7 = %?";
            if(caseID==9) input="{T %? = *10+7 %tprev}";
            if(caseID==10) {
                auto definitions=parse("{#fresh=%?}");auto h=norm(definitions);h.cancel();
                input="fresh = *10+7";
            }
            if(caseID==12) input="{a:%?, b:8}.a=*10+7;";
            auto p=parse(input);auto h=norm(p);auto target=p;
            if(caseID==3 || caseID==4 || caseID==5 || caseID==8 || caseID==9) target=p->pItem->value->items.tail;
            if(caseID==12) target=p->pItem->value->items.head;
            if(caseID==8) {n.addRHS(target,parse("*10+7"));h.waitForCompletion();}
            if(caseID==6) ok=h.status().failed;
            else {
                ok=!h.status().failed && declared(target)==(caseID!=9);
                if(caseID==3) ok &= n.access->known(target)==0 && h.status().symbolicValues;
                else ok &= n.access->known(target)==3 && target->pItem->value->num==(caseID==5 ? 8 : 7);
                if(caseID==9) ok &= declared(p->pItem->value->items.head) && target->pItem->temporalValueSource &&
                    !n.access->registry->areIdentical(target,p->pItem->value->items.head);
                if(caseID==12) ok &= !declared(p) && !declared(target->next) && target->next->pItem->value->num==8;
                auto text=toString(p->pItem.get());auto roundTrip=parse(text);auto again=norm(roundTrip);
                ok &= !again.status().failed && text==toString(roundTrip->pItem.get());again.cancel();
                auto replay=norm(p);ok &= !replay.status().failed;
                for(const auto& step:replay.steps()) ok &= step.action!="Set temporal value independence";
                replay.cancel();
            }
            if(!ok) std::cout<<"Temporal independence "<<caseID<<": "<<toString(p->pItem.get())<<" error="<<h.status().error<<"\n";
            h.cancel();
        }
        n.close();return ok;
    }%>
    void: unitTestGraphTemporalIndependence(me string: testName, me int: caseID) <- {
        me string: actual <- "false"; me string: expected <- "true"
        if(graphTemporalIndependenceCase(testName,caseID)){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHTEMPORAL(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphTemporal(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHTEMPORAL(unit/graphTemporal/directPrev, 1)
    GRAPHTEMPORAL(unit/graphTemporal/directNext, 2)
