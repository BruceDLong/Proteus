    LOOSELISTUNKNOWN(unit/reasoner/looseListUnknownPolarityPending, "retain an unresolved inverted loose list constraint", 4)
    LISTSIZEPROMOTION(unit/reasoner/listSizePromotionCommit, "copy list size only when its consolidation plan commits", true)
    LISTSIZEPROMOTION(unit/reasoner/listSizePromotionNoCommit, "leave list size unchanged when its consolidation plan does not commit", false)
