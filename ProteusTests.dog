        normalizer.runtime.update([&] {normalizer.access->bind(root);});
        auto run=[&] {return caseID==8 ? normalizer.runtime.normalize({root,proteus4::sizeAndValue,proteus4::lazyParts}) : normalizer.normalize(root);};
        if(caseID==8) expected="spoke:{length:*10+7}";
        auto handle=run();handle.waitForCompletion();
        bool passed=!declared.status().failed;
        if(caseID==3) {
            passed &= !handle.status().failed && handle.status().symbolicValues && handle.status().withSubscribers &&
                root->pItem->value->items.size()==2;
            normalizer.addRHS(supplied,graphParsed(testName,"7"));handle.waitForCompletion();
        }
        if(caseID==4 || caseID==6) passed &= handle.status().failed;
        else if(caseID==5) passed &= !handle.status().failed && handle.status().symbolicValues && root->pItem->value->items.size()==2;
        else if(caseID==7) passed &= !handle.status().failed && handle.status().symbolicValues && root->pItem->value->items.size()==2;
        else {
            passed &= !handle.status().failed && handle.status().symbolicValues==(caseID!=8) && getFlagBit(root->pItem->flags,infonView::isNormed)==(caseID==8) &&
                toString(root->pItem.get())==expected && root->pItem->infSize->num==(caseID==8 ? 1 : 2);
            auto count=normalizer.access->registry->identities.size();
            auto again=run();again.waitForCompletion();
            passed &= !again.status().failed && again.status().symbolicValues==(caseID!=8) && toString(root->pItem.get())==expected &&
                normalizer.access->registry->identities.size()==count;
            again.cancel();
        }
        passed &= toString(defs->pItem.get())==original;
        if(!passed) std::cout << "Partial type " << caseID << ": " << handle.status().error << " symbolic=" << handle.status().symbolicValues << "\n" << toString(root->pItem.get()) << "\n";
        handle.cancel();normalizer.close();return passed;
    }%>
    void: unitTestGraphPartialType(me string: testName, me int: caseID) <- {
        me bool: passed <- graphPartialTypeCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
