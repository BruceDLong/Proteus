                original=toString(defs->pItem.get());
            } else {
                auto more=graphParsed(testName,"{#spoke={color:$ length:*1000+123}}");auto registration=normalizer.normalize(more);registration.waitForCompletion();
                passed &= !registration.status().failed;
            }
            handle.waitForCompletion();
        }
        bool pending=caseID==8 || caseID==11 || caseID==12 || caseID==14 || caseID==15 || caseID==20 || caseID==25;
        if(caseID==22) {
            bool rejected=false;for(const auto& step:handle.steps()) if(step.action.find("reject: ")==0) rejected=true;
            passed &= rejected && !handle.status().failed && handle.status().symbolicValues && handle.status().withSubscribers &&
                getModeBits(root->pItem->value->flags,infonState::evalMode)==infonState::emUnknown;
        }
        else if(pending) passed &= !handle.status().failed && handle.status().symbolicValues;
        else {
            passed &= !handle.status().failed && toString(root->pItem.get())==expected;
            if(caseID!=18 && caseID!=24) passed &= !handle.status().symbolicValues;
            auto ids=normalizer.access->registry->identities.size();auto again=normalizer.normalize(root);again.waitForCompletion();
            passed &= !again.status().failed && toString(root->pItem.get())==expected && normalizer.access->registry->identities.size()==ids;
            again.cancel();
        }
        if(caseID==8) passed &= handle.status().cancelled && !handle.status().withSubscribers;
        passed &= toString(defs->pItem.get())==original;
        if(!passed) std::cout << "Projection " << caseID << ": " << handle.status().error << " symbolic=" << handle.status().symbolicValues << "\n" << toString(root->pItem.get()) << "\n";
        handle.cancel();normalizer.close();return passed;
