    me Map<me string, me string>: dynamicTestDisplay
    me Map<me string, me string>: dynamicTestInput
    me Map<me string, me string>: dynamicTestExpected
    me Map<me string, me string>: dynamicTestMode
    me Map<me string, me string>: dynamicTestWorldFile
    me Map<me string, me string>: dynamicTestIncludedFiles

    me string: decodeTestFileEscapes(me string: txt) <- {
        me string: decoded <- ""
        me bool: isEscaped <- false
        withEach pos in range 0 .. txt.size(){
            me char: ch <- txt[pos]
            if(!isEscaped){
                if(ch=="\\"){isEscaped <- true}
                else{decoded <+- ch}
            } else {
                if(ch=="n"){decoded <+- "\n"}
                else if(ch=="t"){decoded <+- "\t"}
                else if(ch=="r"){decoded <+- "\r"}
                else if(ch=="\\"){decoded <+- "\\"}
                else{decoded <+- ch}
                isEscaped <- false
            }
        }
        if(isEscaped){decoded <+- "\\"}
        return(decoded)
    }
    me void: splitTestFileLine(me string: line, their List<me string>: columns) <- {
        columns.clear()
        me string: column <- ""
        withEach pos in range 0 .. line.size(){
            if(line[pos]=="," and (pos==0 or line[pos-1]!="\\")){
                columns.append(column)
                column <- ""
            } else {column <+- line[pos]}
        }
        columns.append(column)
    }
    me string: trimTestFileLeadingPadding(me string: txt) <- {
        me int: start <- 0
        while(start<txt.size() and (txt[start]==" " or txt[start]=="\t")){start <+- 1}
        if(start==0){return(txt)}
        return(txt.subStr(start, txt.size()-start))
    }
    me void: clearDynamicTests() <- {
        dynamicTestNames.clear()
        dynamicTestDisplay.clear()
        dynamicTestInput.clear()
        dynamicTestExpected.clear()
        dynamicTestMode.clear()
        dynamicTestWorldFile.clear()
        dynamicTestIncludedFiles.clear()
    }
    me bool: isDynamicTestIncludeLine(me string: trimmed) <- {
        if(trimmed.size()<8){return(false)}
        if(trimmed.subStr(0,8)!="@include"){return(false)}
        if(trimmed.size()==8){return(true)}
        return(trimmed[8]==" " or trimmed[8]=="\t")
    }
    me void: loadDynamicTestLine(me string: fileName, me int: lineNum, me string: lineIn) <- {
        me string: line <- lineIn
        if(line.size()>0 and line[line.size()-1]=="\r"){line <- line.subStr(0, line.size()-1)}
        me string: trimmed <- trimWS(line)
        if(trimmed==""){return()}
        if(trimmed[0]=="#"){return()}
        if(isDynamicTestIncludeLine(trimmed)){
            me string: includedFileName <- trimmed.subStr(8, trimmed.size()-8)
            includedFileName <- trimWS(includedFileName)
            if(includedFileName==""){
                print("Dynamic test parse error in ", fileName, ":", lineNum, " missing @include filename.\n")
            }else{
                loadDynamicTestFile(includedFileName)
            }
            return()
        }

        me List<me string>: columns
        splitTestFileLine(line, columns)
        if(columns.size()<4){
            print("Dynamic test parse error in ", fileName, ":", lineNum, " expected 4 comma-separated columns.\n")
            return()
        }

        me string: testName <- trimWS(columns[0])
        if(testName==""){
            print("Dynamic test parse error in ", fileName, ":", lineNum, " missing test name.\n")
            return()
        }
        if(dynamicTestInput.containsKey(testName)){
            print("Dynamic test parse error in ", fileName, ":", lineNum, " duplicate test name: ", testName, "\n")
            return()
        }

        me string: testMode <- "norm"
        if(columns.size()>=5){testMode <- trimWS(columns[4])}
        if(testMode==""){testMode <- "norm"}
        if(testMode!="norm" and testMode!="parse" and testMode!="multi" and testMode!="world" and testMode!="graph"){
            print("Dynamic test parse warning in ", fileName, ":", lineNum, " invalid mode '", testMode, "'. Using 'norm'.\n")
            testMode <- "norm"
        }

        dynamicTestNames.append(testName)
        dynamicTestDisplay[testName] <- decodeTestFileEscapes(trimTestFileLeadingPadding(columns[1]))
        dynamicTestInput[testName] <- decodeTestFileEscapes(trimTestFileLeadingPadding(columns[2]))
        dynamicTestExpected[testName] <- decodeTestFileEscapes(trimTestFileLeadingPadding(columns[3]))
        dynamicTestMode[testName] <- testMode
        if(columns.size()>=6){dynamicTestWorldFile[testName] <- decodeTestFileEscapes(trimWS(columns[5]))}
        else{dynamicTestWorldFile[testName] <- ""}
    }
    me int: loadDynamicTestFile(me string: filename) <- {
        me string: fileName <- trimWS(filename)
        if(fileName==""){
            print("Dynamic test filename is empty.\n")
            return(0)
        }
        me bool: hasTestExt <- false
        if(fileName.size()>=4 and fileName.subStr(fileName.size()-4,4)==".tst"){hasTestExt <- true}
        if(!hasTestExt){fileName <+- ".tst"}

        me string: fileText <- readFileAsString(fileName)
        if(fileText=="" and findString(fileName, "/")==-1 and findString(fileName, "\\")==-1){
            me string: parentFileName <- "../"+fileName
            me string: parentText <- readFileAsString(parentFileName)
            if(parentText!=""){
                fileName <- parentFileName
                fileText <- parentText
            }
        }
        if(dynamicTestIncludedFiles.containsKey(fileName)){return(0)}
        dynamicTestIncludedFiles[fileName] <- "1"

        if(fileText==""){
            print("Dynamic test file is empty or unreadable: ", fileName, "\n")
            return(0)
        }

        me string: line <- ""
        me int: lineNum <- 1
        withEach charPos in range 0 .. fileText.size(){
            if(fileText[charPos]=="\n"){
                loadDynamicTestLine(fileName, lineNum, line)
                line <- ""
                lineNum <+- 1
            }else{line <+- fileText[charPos]}
        }
        if(line!=""){loadDynamicTestLine(fileName, lineNum, line)}
        return(dynamicTestNames.size())
    }
    me int: loadTestSpec(me string: filename) <- {
        me string: fileName <- trimWS(filename)
        if(fileName==""){
            print("Dynamic test filename is empty.\n")
            return(0)
        }
        me bool: hasTestExt <- false
        if(fileName.size()>=4 and fileName.subStr(fileName.size()-4,4)==".tst"){hasTestExt <- true}
        if(!hasTestExt){fileName <+- ".tst"}

        if(dynamicTestsLoaded and dynamicTestsFile==fileName){return(dynamicTestNames.size())}

        clearDynamicTests()
        dynamicTestsLoaded <- true
        dynamicTestsFile <- fileName
        loadDynamicTestFile(fileName)
        return(dynamicTestNames.size())
    }
    me bool: matchesDynamicSelector(me string: testName, me string: selector) <- {
        if(selector==""){return(true)}
        me int: selSize <- selector.size()
        if(selSize<=0){return(true)}
        if(selector[selSize-1]=="/"){
            if(testName.size()<selSize){return(false)}
            return(testName.subStr(0, selSize)==selector)
        }
        if(testName==selector){return(true)}
        if(testName.size()<=selSize){return(false)}
        if(testName.subStr(0, selSize)!=selector){return(false)}
        return(testName[selSize]=="/")
    }
    me int: appendDynamicTestsMatching(me string: selector, their List<me string>: outList) <- {
        me int: numMatches <- 0
        withEach testName in dynamicTestNames{
            if(matchesDynamicSelector(testName, selector)){
                outList.append(testName)
                numMatches <+- 1
            }
        }
        return(numMatches)
    }
    me bool: hasDynamicTest(me string: testName) <- {
        return(dynamicTestInput.containsKey(testName))
    }
    me void: executeDynamicTest(me string: testName) <- {
        if(!hasDynamicTest(testName)){Tstat <- "?"; return()}
        me string: testMode <- "norm"
        if(dynamicTestMode.containsKey(testName)){testMode <- dynamicTestMode[testName]}
        me string: testInput <- dynamicTestInput[testName]
        me string: testExpected <- dynamicTestExpected[testName]
        if((testMode=="multi" or testMode=="world") and testExpected!="" and testExpected!="-" and findString(testInput, "//:")==-1){
            testInput <+- "//:"+testExpected
        }
        if(testMode=="graph"){
            testGraphLanguage(testName, testInput, testExpected)
            return()
        }
        if(testMode=="multi"){
            multiNorm(testName, testInput, "")
            return()
        }
        if(testMode=="world"){
            multiNorm(testName, testInput, dynamicTestWorldFile[testName])
            return()
        }
        me bool: doNorm <- true
        if(testMode=="parse"){doNorm <- false}
        initAndTest(testName, testInput, testExpected, doNorm)
    }

    our infonView: parseAndExtract(me string: testName, me string: data) <- {
        // InitParser -> parse -> extract
        me ProteusParser: parser{NULL, false, 0}
        parser.initParseFromString(testName, data)
        our infonView:: parsedInfon
        parser.doParse(parsedInfon)
        if(parser.doesParseHaveError()){return(NULL)}
        return(parsedInfon)
    }
    me void: testParseError(me string: testName, me string: in, me string: expectedMsg, me int64: expectedLine, me int64: expectedChar) <- {
        me ProteusParser: parser{NULL, false, 0}
        parser.initParseFromString(testName, in)
        our infonView:: parsedInfon
        parser.doParse(parsedInfon)
        me int: msgPos <- findString(parser.errorMesg, expectedMsg)
        me string: formatted <- parser.formattedError()
        me string: locSpec <- ":"+toString(expectedLine)+":"+toString(expectedChar)+":"
        me int: locPos <- findString(formatted, locSpec)
        if(!parser.doesParseHaveError()){FAIL("Expected parser to report an error")}
        if(msgPos == -1){FAIL("Expected parser error text to include the requested explanation")}
        if(parser.errLineNum != expectedLine){FAIL("Parser error line number did not match")}
        if(parser.errCharPos != expectedChar){FAIL("Parser error column number did not match")}
        if(locPos == -1){FAIL("Formatted parser error did not include the expected location")}
        return()
    }
    me void: testLine(me string: testName, our Agent: agent, me string: in, me string: expected, me bool: doNorm) <- {
        // ParseAndExtract -> maybe normalize() -> check REQUIREMENT
        our infonView: testInfon <- parseAndExtract(testName, in)
        if(testInfon == NULL){FAIL("Syntax Error in input: " + in)}
        our POV:: testPov{501}; testPov!.pItem <- testInfon
        // Rejection is an observable normalization result, not merely unchanged
        // printed text. Multi-line fixtures can then inspect the original source.
        if(doNorm and expected=="<REJECTED>"){
            me NormalizationHandle: handle <- agent!.normalize(testPov)
            handle.waitForCompletion()
            me bool: rejected <- handle.failed()
            if(!rejected){print("Expected rejection; got ", toString(testPov!.pItem), "\n")}
            handle.cancel()
            me string: actualStatus <- "accepted"
            me string: expectedStatus <- "rejected"
            if(rejected){actualStatus <- "rejected"}
            REQUIRE(actualStatus==expectedStatus)
            return()
        }
        if (doNorm){agent!.normalizeAndWait(testPov)}
        me string:result <- toString(testPov!.pItem)
        if(expected!=""){REQUIRE(result==expected)}
        return()
    }
    me void: initAndTest(me string: testName, me string: in, me string: expected, me bool: doNorm) <- {
        me ProteusCore: CORE
        CORE.init("", false)
        testLine(testName, CORE.agent, in, expected, doNorm)
        return()
    }
    me void: unitTestGETFIRST(me string: testName, me string: in, me string: expected, me int64: skipDots) <- {
        me string: result
        our infonView: testVector <- parseAndExtract(testName, in)
        our POV:: testPOV{502}
        testPOV!.pItem <- testVector
        our POV: resultPOV <- testPOV!.getFirst(skipDots, NULL)
        if(resultPOV == NULL){result <- "NULL"}
        else{result <- toString(resultPOV!.pItem)}
        REQUIRE(result==expected)
        return()
    }
    me void: unitTestGETFIRSTTIGHT(me string: testName, me string: in, me string: expected, me int64: skipDots) <- {
        me string: result
        our infonView: testVector <- parseAndExtract(testName, in)
        our POV:: testPOV{503}
        testPOV!.pItem <- testVector
        our infItr:: ii
        ii!.topPOV <- testPOV
        me int64: numLvlsUp
        our POV: resultPOV <- testPOV!.getFirstTight(ii, skipDots, numLvlsUp, NULL, NULL)
        if(resultPOV == NULL){result <- "NULL"}
        else{result <- toString(resultPOV!.pItem)}
        REQUIRE(result==expected)
        return()
    }
    me void: unitTestStreamInsert(me string: testName, me int64: caseID) <- {
        me string: actual <- "false"; me string: expected <- "true"
        if(streamInsertCase(caseID)){actual <- "true"}
        REQUIRE(actual==expected)
    }
    me bool: streamInsertCase(me int64: caseID) <- <%{
        if(caseID==10) {
            ProteusCore core;core.init("",false);
            auto target=std::make_shared<infonView>();
            bool correct=core.loadAssetInto(target,"TestFiles/insert/main.pr");
            core.streamLoader->waitForAllStreams();
            auto child=target->value->items.head;
            correct=correct && child && child->pItem->value->num==8 && child->pItem->infSize->num==10 &&
                core.streamLoader->numFilesLoaded==2 && core.getOriginIDString(child->pItem->originID)=="file:///TestFiles/insert/nested/value.pr";
            core.deInit();return correct;
        }
        InsertTestCore core;core.init("",false);
        bool correct=true;
        if(caseID==11) {
            core.scripts["memory:///bootstrap"]="{ %INSERT live\n *10+3 }";
            auto target=std::make_shared<infonView>();
            correct=core.loadAssetInto(target,"memory:///bootstrap");
            correct=correct && core.starts==2 && target->value->items.tail->pItem->value->num==3;
            core.deInit();return correct;
        }
        auto root=std::make_shared<POV>(950);
        std::string spec=caseID==6 ? "missing:///child" : caseID==12 ? "throw:///child" : "memory:///root/child";
        if(caseID==13) spec="memory:///parse-first";
        if(caseID==1 || caseID==3) core.scripts[spec]="*10+7";
        if(caseID==2) {
            core.scripts[spec]="{ %INSERT /nested/leaf\n }";
            core.scripts["memory:///root/nested/leaf"]="*10+9";
        }
        if(caseID==7) core.scripts[spec]="{ @broken }";
        root->pItem=core.parseAndExtractString("{ %INSERT "+spec+"\n }","insertion test",false);
        auto imported=root->pItem->value->items.head;
        auto handle=core.agent->normalize(root);handle.waitForCompletion();
        auto waitReplies=[&](int expected) {
            auto deadline=std::chrono::steady_clock::now()+std::chrono::seconds(3);
            while(std::chrono::steady_clock::now()<deadline) {
                {std::lock_guard<std::mutex> lock(core.observedMutex);if(core.replies>=expected) return true;}
                std::this_thread::sleep_for(std::chrono::milliseconds(1));
            }
            return false;
        };
        if(caseID<=3 || caseID==7) {
            core.streamLoader->waitForAllStreams();handle.waitForCompletion();
            if(caseID==7) correct=handle.status().failed && !handle.status().error.empty();
            else if(caseID==2) correct=!handle.status().failed && core.starts==2 && core.opened.count("memory:///root/nested/leaf") && root->stringify().find("9")!=std::string::npos;
            else correct=!handle.status().failed && imported->pItem->value->num==7 && imported->pItem->infSize->num==10 && core.starts==1;
            if(caseID==3) {
                auto again=core.agent->normalize(root);again.waitForCompletion();
                correct=correct && !again.status().failed && core.starts==1;
            }
        } else if(caseID==6 || caseID==12) correct=handle.status().failed && core.starts==0;
        else {
            std::shared_ptr<InsertTestConnector> source;
            {std::lock_guard<std::mutex> lock(core.observedMutex);source=core.opened.at(spec);}
            correct=handle.status().withSubscribers && handle.status().symbolicValues && !handle.status().failed;
            if(caseID==13) {
                source->inputBuf.putStr("{ *10+7>> ");
                bool prefixParsed=false;
                auto deadline=std::chrono::steady_clock::now()+std::chrono::seconds(3);
                while(std::chrono::steady_clock::now()<deadline) {
                    prefixParsed=core.agent->graphNormalizer.runtime.read([&] {
                        auto member=imported->pItem->value->items.head;
                        return member && getModeBits(member->pItem->flags,infonView::streamState)==infonView::parseDone;
                    });
                    if(prefixParsed) break;
                    std::this_thread::sleep_for(std::chrono::milliseconds(1));
                }
                {std::lock_guard<std::mutex> lock(core.observedMutex);correct=correct && prefixParsed && core.replies==0;}
                source->inputBuf.putStr("}");source->inputBuf.close();
                core.streamLoader->waitForAllStreams();
                correct=correct && core.replies==1;
            } else if(caseID==4 || caseID==8) {
                source->inputBuf.putStr("{| *10+7>> ");
                correct=waitReplies(1) && correct;
                handle.waitForCompletion();
                correct=correct && !handle.status().failed && handle.status().withSubscribers && handle.status().symbolicValues;
                if(caseID==8) {handle.cancel();correct=correct && handle.status().cancelled && !getFlagBit(source->flags,InfonConnector::inputEOF);}
                source->inputBuf.putStr("*10+8>> ");
                correct=waitReplies(2) && correct;
                source->inputBuf.putStr("}");source->inputBuf.close();
                core.streamLoader->waitForAllStreams();
                correct=correct && core.starts==1;
            } else if(caseID==5) {
                auto query=std::make_shared<POV>(951);
                query->pItem=core.parseAndExtractString("insertLateValue","late definition query",false);
                auto demand=core.agent->normalize(query);demand.waitForCompletion();
                source->inputBuf.putStr("{| #insertLateValue=*10+6\n 1>> ");
                correct=waitReplies(1) && correct;
                demand.waitForCompletion();
                correct=correct && !demand.status().failed && query->pItem->value->num==6 && query->pItem->infSize->num==10;
                source->inputBuf.putStr("}");source->inputBuf.close();
                core.streamLoader->waitForAllStreams();
            }
            // case 9 intentionally leaves the source open. Shutdown cancels
            // its subscription and closes/joins input; it never waits for EOF.
        }
        if(!correct) std::cout << "INSERT CASE " << caseID << ": " << root->stringify() << "; " << handle.status().error << "; replies=" << core.replies << "\n";
        core.deInit();
        if(caseID==9) correct=correct && !handle.active();
        return correct;
    }%>

    me void: unitTestStreamLoaderSpec(me string: testName, me int64: caseID) <- {
        me bool: correct <- false
        if(caseID==1){
            our InfonStreamSpec:: SP
            SP.setSpec("agnt://[::1]:2006/Things/Things.pr")
            correct <-
                    SP.protocolTag=="agnt" and
                    SP.connectArgs=="[::1]:2006" and
                    SP.contentArgs=="Things/Things.pr" and
                    SP.ipAddr=="::1" and
                    SP.portNum=="2006"
        } else if(caseID==2){
            me InfonStreamLoader: loader
            correct <-
                    loader.resolveStreamSpec("/Informatics/Informatics.pr", "file:///public/")==
                            "file:///public/Informatics/Informatics.pr" and
                    loader.resolveStreamSpec("EnglishWords.pr", "file:///public/Languages/English/")==
                            "file:///public/Languages/English/EnglishWords.pr" and
                    loader.resolveStreamSpec("file:///public/PublicKB.pr", "file:///ignored/")==
                            "file:///public/PublicKB.pr"
        }
        me string: actual <- "false"
        if(correct){actual <- "true"}
        me string: expected <- "true"
        REQUIRE(actual==expected)
        return()
    }
    me void: unitTestGETNEXT(me string: testName, me string: in, me string: expected, me int64: skipDots) <- {
        me string: result <- "{"
        our infonView: testVector <- parseAndExtract(testName, in)
        our POV:: testPOV{504}
        testPOV!.pItem <- testVector
        our POV: CP  <- testPOV!.getFirst(skipDots, NULL)
        me int: count <- 0
        while(CP != NULL ){
            if(count > 6){result <- result + " Infinite Loop"; break()}
            if(CP == NULL){result <+- "NULL "}
            else{result <+- toString(CP!.pItem)+ " "}
            CP <- CP!.getNext(skipDots, NULL)
            count <+- 1
        }
        result <+- "}"
        REQUIRE(result==expected)
        return()
    }
    me void: unitTestGETNEXTTIGHT(me string: testName, me string: in, me string: expected, me int64: skipDots) <- {
        me string: result <- "{"
        our infonView: testVector <- parseAndExtract(testName, in)
        our POV:: testPOV{505}
        testPOV!.pItem <- testVector
        our infItr:: ii
        ii!.topPOV <- testPOV
        me int64: numLvlsUp
        our POV: CP  <- testPOV!.getNextTight(ii, skipDots, numLvlsUp, false, true, NULL, NULL)
        me int: count <- 0
        while(CP != NULL ){
            if(count > 6){result <- result + " Infinite Loop"; break()}
            if(CP == NULL){result <+- "NULL "}
            else{result <+- toString(CP!.pItem)+ " "}
            CP <- CP!.getNextTight(ii, skipDots, numLvlsUp, false, false, NULL, NULL)
            count <+- 1
        }
        result <+- "}"
        REQUIRE(result==expected)
        return()
    }
    me void: unitTestEndRelativeResolveOnClose(me string: testName) <- {
        our infonView: source <- parseAndExtract(testName, "{'Cat' 'Hat' ...}")
        our IdentityRegistry:: identityRegistry
        our POV:: sourcePOV{povSrcEndRelativeReference}
        sourcePOV!.pItem <- source
        sourcePOV!.bindIdentityRegistry(identityRegistry)
        our POV: pendingLast <- sourcePOV!.getEndRelativePOV(-1)
        our POV: samePendingLast <- sourcePOV!.getEndRelativePOV(-1)
        our infonView: pendingValue <- parseAndExtract(testName, "'Dog'")
        pendingLast!.pItem <- pendingValue

        our infonView: finalItem <- parseAndExtract(testName, "'Dog'")
        our POV: finalPOV <- source!.value!.items.append(finalItem, false, povSrcEndRelativeReference)
        source!.value!.tailUnfinished <- false
        source!.countSize(false)

        our EndRelativeReference: reference <-
                sourcePOV!.findEndRelativeReferenceRecord(-1)
        me bool: referenceWasRegistered <- reference!=NULL and
                reference!.referencePOV===pendingLast and
                samePendingLast===pendingLast and
                identityRegistry!.endRelativeReferences.size()==1 and
                source!.retainedPOVs.isEmpty()
        me bool: sourceUsesPendingSlot <- finalPOV!.pItem===pendingLast!.pItem
        me bool: finalItemIsAConstraint <- pendingLast!.pItem!.workListContainsInfonView(finalItem)
        me bool: resolvedCorrectly <- pendingLast!.endRelativeResolved and
                referenceWasRegistered and sourceUsesPendingSlot and
                finalItemIsAConstraint and reference!.resolvedPOV===finalPOV and
                reference!.identityRelation!=NULL and
                reference!.identityRelation!.evidenceKind==
                        iekEndRelativeResolution and
                identityRegistry!.areIdentical(pendingLast, finalPOV) and
                identityRegistry!.areIdentical(finalPOV, pendingLast)

        our infonView: hugeSource <- parseAndExtract(testName,
                "*1000000000+{second| ...}")
        our IdentityRegistry:: hugeRegistry
        our POV:: hugeSourcePOV{povSrcEndRelativeReference}
        hugeSourcePOV!.pItem <- hugeSource
        hugeSourcePOV!.bindIdentityRegistry(hugeRegistry)
        our POV: hugeLast <- hugeSourcePOV!.getEndRelativePOV(-1)
        our EndRelativeReference: hugeReference <-
                hugeSourcePOV!.findEndRelativeReferenceRecord(-1)
        me bool: sparseReferenceStayedSparse <- hugeLast!=NULL and
                hugeReference!=NULL and hugeLast!.endRelativeResolved and
                hugeSource!.value!.items.isEmpty() and
                hugeRegistry!.endRelativeReferences.size()==1 and
                hugeRegistry!.repetitionFamilies.size()==1 and
                hugeRegistry!.repetitionFamilies.first()!.
                        occurrences.size()==1 and
                hugeReference!.resolvedPOV!=NULL and
                hugeReference!.resolvedPOV!.repetitionOccurrence!=NULL and
                hugeReference!.resolvedPOV!.repetitionOccurrence!.
                        ordinal==999999999 and
                hugeReference!.identityRelation!=NULL and
                hugeRegistry!.areIdentical(
                        hugeLast, hugeReference!.resolvedPOV)
        me string: result <- "false"
        me string: expected <- "true"
        if(resolvedCorrectly and sparseReferenceStayedSparse){
            result <- "true"
        }
        REQUIRE(result==expected)
        return()
    }
    me void: unitTestEndRelativeQuery(me string: testName, me int: caseID) <- {
        me bool: passed <- false
        if(caseID==1){
            our infonView: source <- parseAndExtract(testName, "{1 2 3 4}")
            our POV:: sourcePOV{povSrcEndRelativeView}
            sourcePOV!.pItem <- source
            me EndRelativeExtentResult: extent <- source!.endRelativeExtent()
            me EndRelativeWindowAvailability: window <-
                    sourcePOV!.endRelativeWindowAvailability(-2, 2)
            passed <- extent.status==eresExact and extent.exactExtent==4 and
                      window.status==erwcAvailable and
                      window.extent.status==eresExact and
                      window.startIndex==2 and window.itemCount==2 and
                      window.firstSourcePOV!=NULL and
                      window.firstSourcePOV!.pItem!.value!.num.convertToInt()==3 and
                      window.lastSourcePOV!=NULL and
                      window.lastSourcePOV!.pItem!.value!.num.convertToInt()==4
        }else if(caseID==2){
            our infonView: source <- parseAndExtract(testName, "*4+{...}")
            our POV:: sourcePOV{povSrcEndRelativeView}
            sourcePOV!.pItem <- source
            me EndRelativeWindowAvailability: window <-
                    sourcePOV!.endRelativeWindowAvailability(-1, 1)
            passed <- window.extent.status==eresExact and
                      window.extent.exactExtent==4 and
                      window.status==erwcPending and window.startIndex==3 and
                      window.firstSourcePOV==NULL
        }else if(caseID==3){
            our infonView: source <- parseAndExtract(testName, "{1 2 ...}")
            our POV:: sourcePOV{povSrcEndRelativeView}
            sourcePOV!.pItem <- source
            me EndRelativeExtentResult: extent <- source!.endRelativeExtent()
            me EndRelativeWindowAvailability: window <-
                    sourcePOV!.endRelativeWindowAvailability(-1, 1)
            passed <- extent.status==eresUnknownOrUnbounded and
                      window.extent.status==eresUnknownOrUnbounded and
                      window.status==erwcPending and window.startIndex==-1
        }else if(caseID==4){
            our infonView: source <- parseAndExtract(testName, "5")
            our POV:: sourcePOV{povSrcEndRelativeView}
            sourcePOV!.pItem <- source
            me EndRelativeExtentResult: extent <- source!.endRelativeExtent()
            me EndRelativeWindowAvailability: window <-
                    sourcePOV!.endRelativeWindowAvailability(-1, 1)
            passed <- extent.status==eresIncompatible and
                      window.extent.status==eresIncompatible and
                      window.status==erwcIncompatible
        }else if(caseID==5){
            our infonView: source <- parseAndExtract(testName, "{1 2 3}")
            our POV:: sourcePOV{povSrcEndRelativeView}
            sourcePOV!.pItem <- source
            me EndRelativeWindowAvailability: window <-
                    sourcePOV!.endRelativeWindowAvailability(-4, 4)
            passed <- window.extent.status==eresExact and
                      window.extent.exactExtent==3 and
                      window.status==erwcOutOfRange and window.startIndex==-1
        }else if(caseID==6){
            our infonView: source <- parseAndExtract(testName, "{1 2 3 4}")
            our POV:: sourcePOV{povSrcEndRelativeView}
            sourcePOV!.pItem <- source
            our POV: derivedPOV <- sourcePOV!.makeEndRelativeSpanView(
                    sourcePOV, -2, povSrcEndRelativeView)
            our infonView: fifth <- parseAndExtract(testName, "5")
            fifth!.itmMode <- mItem
            source!.value!.items.append(
                    fifth, false, povSrcEndRelativeView)
            source!.value!.sizeMode <- fromCount
            source!.infSize!.evalMode <- emUnknown
            source!.countSize(false)
            me EndRelativeWindowAvailability: derivedWindow
            me EndRelativeWindowAvailability: sourceWindow
            if(derivedPOV!=NULL){
                derivedWindow <- derivedPOV!.endRelativeWindowAvailability(-1, 1)
            }
            sourceWindow <- sourcePOV!.endRelativeWindowAvailability(-1, 1)
            passed <- derivedPOV!=NULL and
                      derivedWindow.extent.status==eresExact and
                      derivedWindow.extent.exactExtent==2 and
                      derivedWindow.status==erwcAvailable and
                      derivedWindow.firstSourcePOV!.pItem!.value!.num.convertToInt()==4 and
                      sourceWindow.extent.exactExtent==5 and
                      sourceWindow.firstSourcePOV!.pItem!.value!.num.convertToInt()==5
        }

        me string: result <- "false"
        me string: expected <- "true"
        if(passed){result <- "true"}
        REQUIRE(result==expected)
        return()
    }
    me void: unitTestExternalAssociation(me string: testName) <- {
        our IdentityRegistry:: registry
        our infonView: anchor <- parseAndExtract(
                testName, "human:{marker:1}")
        our infonView: predicate <- parseAndExtract(
                testName, "name={spelling='Morgan'}")
        our infonView: value <- parseAndExtract(
                testName, "name:{spelling:'Morgan'}")
        our POV:: anchorPOV{povSrcExternalAssociation}
        our POV:: predicatePOV{povSrcExternalAssociation}
        our POV:: valuePOV{povSrcExternalAssociation}
        anchorPOV!.pItem <- anchor
        predicatePOV!.pItem <- predicate
        valuePOV!.pItem <- value
        anchorPOV!.bindIdentityRegistry(registry)
        predicatePOV!.bindIdentityRegistry(registry)
        valuePOV!.bindIdentityRegistry(registry)

        our ExternalAssociationReference: reference <-
                registry!.recordExternalAssociation(
                        anchorPOV, predicatePOV, valuePOV,
                        NULL, "name", 71)
        our ExternalAssociationReference: duplicate <-
                registry!.recordExternalAssociation(
                        anchorPOV, predicatePOV, valuePOV,
                        NULL, "name", 71)
        me List<our ExternalAssociationReference>: anchorMatches
        me List<our ExternalAssociationReference>: relationMatches
        registry!.collectExternalAssociationsForAnchor(
                anchorPOV, "name", anchorMatches)
        registry!.collectExternalAssociationsForRelation(
                "name", relationMatches)

        // An equal-looking occurrence is not the same occurrence.  An
        // explicitly recorded alias is, and must support inverse lookup.
        our infonView: separateAnchor <- parseAndExtract(
                testName, "human:{marker:1}")
        our POV:: separateAnchorPOV{povSrcExternalAssociation}
        separateAnchorPOV!.pItem <- separateAnchor
        separateAnchorPOV!.bindIdentityRegistry(registry)
        me List<our ExternalAssociationReference>: separateMatches
        registry!.collectExternalAssociationsForAnchor(
                separateAnchorPOV, "name", separateMatches)
        registry!.recordIdentity(anchorPOV, separateAnchorPOV,
                iekContextReference, 72)
        me List<our ExternalAssociationReference>: aliasMatches
        registry!.collectExternalAssociationsForAnchor(
                separateAnchorPOV, "name", aliasMatches)

        me AgentContext: context
        context.init(registry)
        our POV: contextPOV <- context.addContextPOV(
                anchorPOV, registry)
        our POV: repeatedContextPOV <- context.addContextPOV(
                separateAnchorPOV, registry)

        me bool: passed <- reference!=NULL and
                duplicate===reference and
                reference!.anchorPOV===anchorPOV and
                reference!.predicatePOV===predicatePOV and
                reference!.valuePOV===valuePOV and
                reference!.relationTypeID=="name" and
                reference!.normalizationID==71 and
                anchorMatches.size()==1 and
                anchorMatches.first()===reference and
                relationMatches.size()==1 and
                relationMatches.first()===reference and
                separateMatches.isEmpty() and
                aliasMatches.size()==1 and
                aliasMatches.first()===reference and
                !registry!.areIdentical(anchorPOV, valuePOV) and
                contextPOV!=NULL and
                repeatedContextPOV===contextPOV and
                context.containsOccurrence(anchorPOV, registry) and
                context.containsOccurrence(
                        separateAnchorPOV, registry) and
                registry!.areIdentical(contextPOV, anchorPOV)
        me string: actual <- "false"
        me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
        modelMngr.clear()
        return()
    }
    me void: unitTestWordRuleCost(me string: testName) <- {
        me WordResolutionPlan: plan
        Allocate(plan.source)
        Allocate(plan.descriptor)
        plan.source!.estimatedDefinitionCount <- 2
        plan.descriptor!.estimatedDefinitionCount <- 3
        plan.estimate(5, 10, 4, true)

        me bool: passed <-
                plan.state==wrsEstimated and
                plan.cost.interpretationPairCount==6 and
                plan.cost.definitionExpansionCost==5 and
                plan.cost.directMemberCost==30 and
                plan.cost.sourceExternalCost==6 and
                plan.cost.typedPropertyCost==60 and
                plan.cost.anyPropertyCost==84 and
                plan.cost.lowerBound==41 and
                plan.cost.upperBoundKnown and
                plan.cost.upperBound==185 and
                plan.openedBranches.isEmpty() and
                plan.candidates.isEmpty()
        me string: actual <- "false"
        me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
        return()
    }

    me void: unitTestSelectionReference(
            me string: testName, me int: caseID) <- {
        me ProteusCore: CORE
        CORE.init("", false)
        me string: expression <- "{a:1, b:2}.b"
        me SelectionReferenceKind: expectedKind <- srkPartPathSelection
        if(caseID==2){
            expression <- "{a:1 b:2}.b"
            expectedKind <- srkIntersectionCorrespondence
        }
        our infonView: result <- parseAndExtract(
                testName, expression)
        our POV:: resultPOV{povSrcPartPathSelection}
        resultPOV!.pItem <- result
        CORE.agent!.normalizeAndWait(resultPOV)

        our SelectionReference: registeredReference
        me int: partPathReferenceCount <- 0
        withEach reference in
                CORE.agent!.identityRegistry!.selectionReferences{
            if(reference!.referenceKind==expectedKind){
                partPathReferenceCount <+- 1
                if(reference!.sourceStartPOV!=NULL and
                        reference!.sourceStartPOV!.pItem!=NULL and
                        reference!.sourceStartPOV!.pItem!.type!=NULL and
                        reference!.sourceStartPOV!.pItem!.
                                type!.typeID()=="b" and
                        reference!.sourceStartPOV!.pItem!.
                                value!.overlayType==NUM and
                        reference!.sourceStartPOV!.pItem!.
                                value!.num.convertToInt()==2 and
                        reference!.resultPOV!=NULL and
                        reference!.resultPOV!.pItem===resultPOV!.pItem){
                    registeredReference <- reference
                }
            }
        }
        me List<our SelectionReference>: queryReferences
        me List<our SelectionReference>: resultReferences
        me List<our SelectionReference>: sourceReferences
        if(registeredReference!=NULL){
            CORE.agent!.identityRegistry!.
                    collectSelectionReferencesForQuery(
                            registeredReference!.queryPOV,
                            queryReferences)
            CORE.agent!.identityRegistry!.
                    collectSelectionReferencesForResult(
                            registeredReference!.resultPOV,
                            resultReferences)
            CORE.agent!.identityRegistry!.
                    collectSelectionReferencesForSource(
                            registeredReference!.sourceContextPOV,
                            registeredReference!.sourceStartPOV,
                            sourceReferences)
        }
        me bool: sourceIncludesRegistered <- false
        withEach sourceReference in sourceReferences{
            if(sourceReference===registeredReference){
                sourceIncludesRegistered <- true
                break()
            }
        }

        me bool: passed <- registeredReference!=NULL and
                partPathReferenceCount>=1 and
                queryReferences.size()==1 and
                queryReferences.first()===registeredReference and
                resultReferences.size()==1 and
                resultReferences.first()===registeredReference and
                sourceIncludesRegistered and
                CORE.agent!.identityRegistry!.identities.isEmpty() and
                registeredReference!.queryPOV!=NULL and
                registeredReference!.queryPOV!.pItem!=NULL and
                registeredReference!.queryPOV!.pItem!.type!=NULL and
                registeredReference!.queryPOV!.pItem!.type!.typeID()=="b" and
                registeredReference!.resultPOV!=NULL and
                registeredReference!.resultPOV!.pItem===resultPOV!.pItem and
                registeredReference!.sourceContextPOV!=NULL and
                registeredReference!.sourceContextPOV!.pItem!=NULL and
                registeredReference!.sourceContextPOV!.pItem!.value!.
                        overlayType==LST and
                registeredReference!.sourceStartPOV!=NULL and
                registeredReference!.sourceStartPOV!.pItem!=NULL and
                registeredReference!.sourceStartPOV!.pItem!.type!=NULL and
                registeredReference!.sourceStartPOV!.pItem!.
                        type!.typeID()=="b" and
                registeredReference!.sourceStartPOV!.pItem!.
                        value!.num.convertToInt()==2 and
                resultPOV!.pItem!.type!=NULL and
                resultPOV!.pItem!.type!.typeID()=="b" and
                resultPOV!.pItem!.value!.num.convertToInt()==2
        if(caseID==1){
            passed <- passed and
                    registeredReference!.resultPOV===resultPOV and
                    registeredReference!.sourceStartPOV!.pItem===
                            resultPOV!.pItem
        }
        me string: actual <- "false"
        me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
        modelMngr.clear()
        return()
    }
    me void: unitTestSelectionResolution(
            me string: testName, me int: caseID) <- {
        me bool: passed <- false
        if(caseID==2){
            our IdentityRegistry:: registry
            our infonView: source <- parseAndExtract(
                    testName, "{7 7}")
            our POV:: sourcePOV{povSrcPartPathSelection}
            sourcePOV!.pItem <- source
            sourcePOV!.bindIdentityRegistry(registry)
            our POV: firstSource <- source!.value!.items.head
            our POV: secondSource <- source!.value!.items.tail
            our infonView: query <- parseAndExtract(testName, "_")
            our POV:: queryPOV{povSrcPartPathSelection}
            queryPOV!.pItem <- query
            queryPOV!.bindIdentityRegistry(registry)
            our infonView: result <- parseAndExtract(testName, "7")
            our POV:: resultPOV{povSrcPartPathSelection}
            resultPOV!.pItem <- result
            resultPOV!.bindIdentityRegistry(registry)
            our SelectionRequest: request <- registry!.
                    getOrCreateSelectionRequest(
                            queryPOV, resultPOV, sourcePOV,
                            srkIntersectionCorrespondence, 1)
            our SelectionReference: firstReference <- registry!.
                    recordSelectionReferenceForRequest(
                            request, resultPOV, firstSource)
            our SelectionReference: secondReference <- registry!.
                    recordSelectionReferenceForRequest(
                            request, resultPOV, secondSource)
            our SelectionResolution: requestResolution <-
                    registry!.resolveSelectionRequest(request!.requestID)
            our SelectionResolution: queryResolution <-
                    registry!.resolveSelectionForQuery(
                            queryPOV, srkIntersectionCorrespondence)
            our SelectionResolution: resultResolution <-
                    registry!.resolveSelectionForResult(resultPOV)
            our SelectionResolution: firstSourceResolution <-
                    registry!.resolveSelectionForSource(
                            sourcePOV, firstSource)
            passed <- firstSource!=NULL and secondSource!=NULL and
                    firstSource!.pItem!==secondSource!.pItem and
                    toString(firstSource!.pItem)==
                            toString(secondSource!.pItem) and
                    firstReference!=NULL and secondReference!=NULL and
                    firstReference!.occurrenceToken!=
                            secondReference!.occurrenceToken and
                    request!.resolutionState==srsMultiple and
                    requestResolution!.resolutionState==srsMultiple and
                    requestResolution!.references.size()==2 and
                    queryResolution!.resolutionState==srsMultiple and
                    resultResolution!.resolutionState==srsMultiple and
                    firstSourceResolution!.resolutionState==srsUnique and
                    firstSourceResolution!.references.size()==1
            modelMngr.clear()
        }else if(caseID==3){
            our IdentityRegistry:: registry
            our infonView: source <- parseAndExtract(testName, "{7}")
            our POV:: sourcePOV{povSrcPartPathSelection}
            sourcePOV!.pItem <- source
            sourcePOV!.bindIdentityRegistry(registry)
            our POV: sourceStart <- source!.value!.items.head
            our infonView: firstQuery <- parseAndExtract(testName, "_")
            our infonView: secondQuery <- parseAndExtract(testName, "_")
            our infonView: firstResult <- parseAndExtract(testName, "7")
            our infonView: secondResult <- parseAndExtract(testName, "7")
            our POV:: firstQueryPOV{povSrcPartPathSelection}
            our POV:: secondQueryPOV{povSrcPartPathSelection}
            our POV:: firstResultPOV{povSrcPartPathSelection}
            our POV:: secondResultPOV{povSrcPartPathSelection}
            firstQueryPOV!.pItem <- firstQuery
            secondQueryPOV!.pItem <- secondQuery
            firstResultPOV!.pItem <- firstResult
            secondResultPOV!.pItem <- secondResult
            registry!.recordSelectionReference(
                    firstQueryPOV, firstResultPOV,
                    sourcePOV, sourceStart,
                    srkIntersectionCorrespondence, 1)
            registry!.recordSelectionReference(
                    secondQueryPOV, secondResultPOV,
                    sourcePOV, sourceStart,
                    srkIntersectionCorrespondence, 1)
            our SelectionResolution: inverse <-
                    registry!.resolveSelectionForSource(
                            sourcePOV, sourceStart)
            passed <- inverse!.resolutionState==srsMultiple and
                    inverse!.references.size()==2 and
                    inverse!.references.first()!.queryPOV!==
                            inverse!.references.last()!.queryPOV and
                    inverse!.references.first()!.resultPOV!==
                            inverse!.references.last()!.resultPOV
            modelMngr.clear()
        }else if(caseID==4){
            me ProteusCore: CORE
            CORE.init("", false)
            our infonView: result <- parseAndExtract(
                    testName, "{a:1 b:2}.b")
            our POV:: resultPOV{povSrcPartPathSelection}
            resultPOV!.pItem <- result
            CORE.agent!.normalizeAndWait(resultPOV)
            our SelectionRequest: partRequest
            withEach request in
                    CORE.agent!.identityRegistry!.selectionRequests{
                if(request!.referenceKind==srkPartPathSelection and
                        request!.consumerResultPOV===resultPOV){
                    partRequest <- request
                    break()
                }
            }
            our SelectionResolution: resolution
            if(partRequest!=NULL){
                resolution <- CORE.agent!.identityRegistry!.
                        resolveSelectionRequest(partRequest!.requestID)
            }
            passed <- partRequest!=NULL and resolution!=NULL and
                    resolution!.resolutionState==srsUnique and
                    resolution!.references.size()==1 and
                    resolution!.references.first()!.queryPOV===
                            partRequest!.queryPOV and
                    resolution!.references.first()!.resultPOV===resultPOV and
                    resolution!.references.first()!.sourceStartPOV!=NULL and
                    resolution!.references.first()!.sourceStartPOV!.pItem!.
                            type!.typeID()=="b" and
                    resultPOV!.pItem!.value!.num.convertToInt()==2
            modelMngr.clear()
        }else{
            our IdentityRegistry:: registry
            our infonView: source <- parseAndExtract(
                    testName, "{{a:1} {a:2}}")
            our POV:: sourcePOV{povSrcPartPathSelection}
            sourcePOV!.pItem <- source
            sourcePOV!.bindIdentityRegistry(registry)
            our POV: firstSource <- source!.value!.items.head
            our POV: secondSource <- source!.value!.items.tail

            our infonView: singleQuery <- parseAndExtract(testName, "1")
            our infonView: singleResult <- parseAndExtract(testName, "{a:1}")
            our POV:: singleQueryPOV{povSrcPartPathSelection}
            our POV:: singleResultPOV{povSrcPartPathSelection}
            singleQueryPOV!.pItem <- singleQuery
            singleResultPOV!.pItem <- singleResult
            our SelectionRequest: singleRequest <- registry!.
                    getOrCreateSelectionRequest(
                            singleQueryPOV, singleResultPOV, sourcePOV,
                            srkPositionalSelection, 1)
            registry!.recordSelectionReferenceForRequest(
                    singleRequest, singleResultPOV, firstSource)
            our POV: singleOccurrence <- registry!.
                    resolveSingleSelectedOccurrence(
                            singleRequest!.requestID)

            our infonView: spanQuery <- parseAndExtract(testName, "1")
            our infonView: spanResult <- parseAndExtract(
                    testName, "{{a:1} {a:2}}")
            our POV:: spanQueryPOV{povSrcPartPathSelection}
            our POV:: spanResultPOV{povSrcPartPathSelection}
            spanQueryPOV!.pItem <- spanQuery
            spanResultPOV!.pItem <- spanResult
            our SelectionRequest: spanRequest <- registry!.
                    getOrCreateSelectionRequest(
                            spanQueryPOV, spanResultPOV, sourcePOV,
                            srkPositionalSelection, 2)
            spanRequest!.selectorSpec <- spanResult
            registry!.recordSelectionReferenceForRequest(
                    spanRequest, spanResultPOV, firstSource)
            our POV: spanOccurrence <- registry!.
                    resolveSingleSelectedOccurrence(
                            spanRequest!.requestID)

            our infonView: multipleQuery <- parseAndExtract(testName, "_")
            our infonView: multipleResult <- parseAndExtract(testName, "{a:_}")
            our POV:: multipleQueryPOV{povSrcPartPathSelection}
            our POV:: multipleResultPOV{povSrcPartPathSelection}
            multipleQueryPOV!.pItem <- multipleQuery
            multipleResultPOV!.pItem <- multipleResult
            our SelectionRequest: multipleRequest <- registry!.
                    getOrCreateSelectionRequest(
                            multipleQueryPOV, multipleResultPOV, sourcePOV,
                            srkPositionalSelection, 3)
            registry!.recordSelectionReferenceForRequest(
                    multipleRequest, multipleResultPOV, firstSource)
            registry!.recordSelectionReferenceForRequest(
                    multipleRequest, multipleResultPOV, secondSource)
            our POV: multipleOccurrence <- registry!.
                    resolveSingleSelectedOccurrence(
                            multipleRequest!.requestID)

            passed <- singleOccurrence===firstSource and
                    spanOccurrence==NULL and
                    multipleOccurrence==NULL
            modelMngr.clear()
        }

        me string: actual <- "false"
        me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
        return()
    }
    me void: unitTestPositionalSelectionReference(
            me string: testName, me int: caseID) <- {
        me ProteusCore: CORE
        CORE.init("", false)
        me string: expression <- "{10 20 30}@[2]"
        me int64: expectedValue <- 20
        if(caseID==2){
            expression <- "{10 20 30}.first"
            expectedValue <- 10
        }else if(caseID==3){
            expression <- "{10 20 30}.last"
            expectedValue <- 30
        }else if(caseID==4){
            expression <- "{10 20 30 40}@[1:*2+{ ... }]"
            expectedValue <- 20
        }
        our infonView: result <- parseAndExtract(testName, expression)
        our POV:: resultPOV{povSrcPartPathSelection}
        resultPOV!.pItem <- result
        CORE.agent!.normalizeAndWait(resultPOV)

        our SelectionReference: registeredReference
        me int: positionalReferenceCount <- 0
        withEach reference in
                CORE.agent!.identityRegistry!.selectionReferences{
            if(reference!.referenceKind==srkPositionalSelection){
                positionalReferenceCount <+- 1
                registeredReference <- reference
            }
        }
        me List<our SelectionReference>: sourceReferences
        if(registeredReference!=NULL){
            CORE.agent!.identityRegistry!.
                    collectSelectionReferencesForSource(
                            registeredReference!.sourceContextPOV,
                            registeredReference!.sourceStartPOV,
                            sourceReferences)
        }
        me bool: sourceIncludesRegistered <- false
        withEach sourceReference in sourceReferences{
            if(sourceReference===registeredReference){
                sourceIncludesRegistered <- true
                break()
            }
        }

        me bool: passed <- registeredReference!=NULL and
                positionalReferenceCount==1 and
                sourceIncludesRegistered and
                registeredReference!.queryPOV!=NULL and
                registeredReference!.resultPOV!=NULL and
                registeredReference!.resultPOV!.pItem===resultPOV!.pItem and
                registeredReference!.sourceContextPOV!=NULL and
                registeredReference!.sourceContextPOV!.pItem!=NULL and
                registeredReference!.sourceContextPOV!.pItem!.value!.
                        overlayType==LST and
                registeredReference!.sourceStartPOV!=NULL and
                registeredReference!.sourceStartPOV!.pItem!=NULL and
                registeredReference!.sourceStartPOV!.pItem!.
                        value!.num.convertToInt()==expectedValue
        if(caseID==4){
            our POV: firstResultPOV <-
                    resultPOV!.pItem!.value!.items.head
            our POV: secondResultPOV <-
                    resultPOV!.pItem!.value!.items.tail
            // The positive range's compressed prefix is a repetition. When
            // its demanded occurrence is exposed, that occurrence and the
            // concrete head are genuinely identical; this is independent of
            // the non-identity selection provenance checked above.
            our IdentityRelation: exposureIdentity
            if(CORE.agent!.identityRegistry!.identities.size()==1){
                exposureIdentity <-
                        CORE.agent!.identityRegistry!.identities.first()
            }
            passed <- passed and firstResultPOV!=NULL and
                    secondResultPOV!=NULL and
                    exposureIdentity!=NULL and
                    exposureIdentity!.evidenceKind==
                            iekRepetitionMaterialization and
                    firstResultPOV!.pItem!.value!.
                            num.convertToInt()==20 and
                    secondResultPOV!.pItem!.value!.
                            num.convertToInt()==30
        }else{
            passed <- passed and
                    CORE.agent!.identityRegistry!.identities.isEmpty() and
                    resultPOV!.pItem!.value!.
                            num.convertToInt()==expectedValue
        }
        me string: actual <- "false"
        me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
        modelMngr.clear()
        return()
    }
    me void: unitTestIndexLowering(me string: testName, me int: caseID) <- {
        me bool: passed <- false

        me ProteusCore: CORE
        CORE.init("TestFiles/timeTestCases.pr", false)
        our infonView: sugar <- parseAndExtract(testName,
                "hour:{second| 1 2 3 4 5 6}@[-1]")
        our infonView: lowLevel <- parseAndExtract(testName,
                "*(-1)+[<minute>] <~ hour:{second| 1 2 3 4 5 6}")
        our POV:: sugarPOV{povSrcEndRelativeView}
        sugarPOV!.pItem <- sugar
        our POV:: lowLevelPOV{povSrcEndRelativeView}
        lowLevelPOV!.pItem <- lowLevel
        CORE.agent!.normalizeAndWait(sugarPOV)
        CORE.agent!.normalizeAndWait(lowLevelPOV)
        our POV: sugarFirst <- sugarPOV!.pItem!.value!.items.head
        our POV: lowLevelFirst <- lowLevelPOV!.pItem!.value!.items.head
        passed <- sugarPOV!.pItem!.type!=NULL and
                lowLevelPOV!.pItem!.type!=NULL and
                sugarPOV!.pItem!.type!.typeID()=="minute" and
                lowLevelPOV!.pItem!.type!.typeID()=="minute" and
                sugarPOV!.viewMap.sourcePov!=NULL and
                sugarPOV!.viewMap.startPov!=NULL and
                lowLevelPOV!.viewMap.sourcePov!=NULL and
                lowLevelPOV!.viewMap.startPov!=NULL and
                sugarPOV!.viewMap.startPov!.pItem!.value!.num.
                        convertToInt()==4 and
                lowLevelPOV!.viewMap.startPov!.pItem!.value!.num.
                        convertToInt()==4 and
                sugarFirst!=NULL and lowLevelFirst!=NULL and
                sugarFirst!.viewMap.startPov!=NULL and
                lowLevelFirst!.viewMap.startPov!=NULL and
                sugarFirst!.viewMap.startPov!.pItem!.value!.num.
                        convertToInt()==4 and
                lowLevelFirst!.viewMap.startPov!.pItem!.value!.num.
                        convertToInt()==4
        modelMngr.clear()

        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
    me void: unitTestImplicitItem(me string: testName, me int: caseID) <- {
        our infonView: source <- parseAndExtract(testName, "*4+{item| ...}")
        our POV:: sourcePOV{povSrcImplicitItem}
        sourcePOV!.pItem <- source
        sourcePOV!.isSubItm <- true
        our IdentityRegistry:: identityRegistry
        sourcePOV!.bindIdentityRegistry(identityRegistry)

        me bool: passed <- false
        if(caseID==1){
            our POV: firstLookup <- sourcePOV!.getOrCreateImplicitItemPOV(2)
            our POV: secondLookup <- sourcePOV!.getOrCreateImplicitItemPOV(2)
            passed <- firstLookup!=NULL and firstLookup===secondLookup and
                      firstLookup!.pItem!=NULL and firstLookup!.pItem!.type===source!.value!.listSpec!.type and
                      firstLookup!.isImplicitItemPOV() and firstLookup!.implicitItem.sourcePov===sourcePOV and
                      firstLookup!.implicitItem.sourceIndex==2 and firstLookup!.viewMap.sourcePov==NULL and
                      source!.retainedPOVs.isEmpty() and
                      sourcePOV!.repetitionSpan.family!=NULL and
                      sourcePOV!.repetitionSpan.family!.occurrences.size()==1 and
                      firstLookup!.repetitionOccurrence!=NULL and
                      firstLookup!.repetitionOccurrence!.ordinalKnown and
                      firstLookup!.repetitionOccurrence!.ordinal==2 and
                      firstLookup!.repetitionOccurrence!.occurrenceToken>0 and
                      sourcePOV!.getOrCreateImplicitItemPOV(-1)==NULL and
                      sourcePOV!.getOrCreateImplicitItemPOV(4)==NULL
        }else if(caseID==2){
            our POV: firstPosition <- sourcePOV!.getOrCreateImplicitItemPOV(1)
            our POV: secondPosition <- sourcePOV!.getOrCreateImplicitItemPOV(2)
            passed <- firstPosition!=NULL and secondPosition!=NULL and
                      !(firstPosition===secondPosition) and
                      !(firstPosition!.pItem===secondPosition!.pItem) and
                      firstPosition!.implicitItem.sourceIndex==1 and
                      secondPosition!.implicitItem.sourceIndex==2 and
                      firstPosition!.repetitionOccurrence!.occurrenceToken!=
                            secondPosition!.repetitionOccurrence!.occurrenceToken and
                      source!.retainedPOVs.isEmpty() and
                      sourcePOV!.repetitionSpan.family!.occurrences.size()==2
        }else if(caseID==3){
            our POV: implicitPOV <- sourcePOV!.getOrCreateImplicitItemPOV(2)
            passed <- implicitPOV!=NULL and source!.value!.items.size()==0 and
                      sourcePOV!.sparseSpanCount()==4 and source!.value!.tailUnfinished and
                      implicitPOV!.pParent==NULL and implicitPOV!.prev==NULL and implicitPOV!.next==NULL
        }else if(caseID==4){
            our POV: temporaryLookup <- sourcePOV!.getOrCreateImplicitItemPOV(2)
            temporaryLookup <- NULL
            our POV: retainedOrigin <- sourcePOV!.findImplicitItemPOV(2)
            our POV:: viewPOV{povSrcImplicitItem}
            if(retainedOrigin!=NULL){
                viewPOV!.pItem <- retainedOrigin!.pItem
                viewPOV!.viewMap.sourcePov <- sourcePOV
                viewPOV!.viewMap.startPov <- retainedOrigin
            }
            passed <- retainedOrigin!=NULL and viewPOV!.viewMap.sourcePov===sourcePOV and
                      viewPOV!.viewMap.startPov===retainedOrigin and
                      viewPOV!.viewMap.startPov!.implicitItem.sourcePov===sourcePOV
        }else if(caseID==5){
            our infonView: parent <- parseAndExtract(testName, "{*4+{item| ...} 99}")
            our POV:: parentPOV{povSrcImplicitItem}
            parentPOV!.pItem <- parent
            our POV: sparsePOV <- parent!.value!.items.head
            our POV: thirdItem
            our POV: fourthItem
            our POV: followingConcrete
            me int64: levelsUp <- 0
            our infItr:: ii
            ii!.topPOV <- parentPOV
            our POV: tightFollowing
            if(sparsePOV!=NULL){
                sparsePOV!.pParent <- parentPOV
                sparsePOV!.isSubItm <- true
                sparsePOV!.bindIdentityRegistry(identityRegistry)
                thirdItem <- sparsePOV!.getOrCreateImplicitItemPOV(2)
            }
            if(thirdItem!=NULL){fourthItem <- thirdItem!.logicalNextItemPOV()}
            if(fourthItem!=NULL){
                followingConcrete <- fourthItem!.logicalNextItemPOV()
                tightFollowing <- fourthItem!.getNextTight(
                        ii, 0, levelsUp, false, false, NULL, NULL)
            }
            passed <- sparsePOV!=NULL and sparsePOV!.isSparseOrderedSpan() and
                      thirdItem!=NULL and fourthItem!=NULL and
                      thirdItem!.implicitItem.sourceIndex==2 and
                      fourthItem!.implicitItem.sourceIndex==3 and
                      followingConcrete!=NULL and followingConcrete===sparsePOV!.next and
                      followingConcrete!.pItem!.value!.num.convertToInt()==99 and
                      tightFollowing===followingConcrete and
                      sparsePOV!.pItem!.value!.items.isEmpty()
        }else if(caseID==7){
            our infonView: outer <- parseAndExtract(
                    testName, "{&{*4+{item| ...}} 99}")
            our POV:: outerPOV{povSrcImplicitItem}
            outerPOV!.pItem <- outer
            our POV: innerPOV <- outer!.value!.items.head
            our POV: sparsePOV
            if(innerPOV!=NULL){
                innerPOV!.pParent <- outerPOV
                innerPOV!.isSubItm <- true
                sparsePOV <- innerPOV!.pItem!.value!.items.head
            }
            our POV: lastImplicit
            if(sparsePOV!=NULL){
                sparsePOV!.pParent <- innerPOV
                sparsePOV!.isSubItm <- true
                sparsePOV!.bindIdentityRegistry(identityRegistry)
                lastImplicit <- sparsePOV!.getOrCreateImplicitItemPOV(3)
            }
            me int64: outerLevelsUp <- 0
            our infItr:: outerItr
            outerItr!.topPOV <- outerPOV
            our POV: crossedToOuterSibling
            if(lastImplicit!=NULL){
                crossedToOuterSibling <- lastImplicit!.getNextTight(
                        outerItr, 0, outerLevelsUp, false, false, NULL, NULL)
            }
            me int64: innerLevelsUp <- 0
            our infItr:: innerItr
            innerItr!.topPOV <- innerPOV
            our POV: stoppedAtInnerBoundary
            if(lastImplicit!=NULL){
                stoppedAtInnerBoundary <- lastImplicit!.getNextTight(
                        innerItr, 0, innerLevelsUp, false, false, NULL, NULL)
            }
            passed <- innerPOV!=NULL and sparsePOV!=NULL and lastImplicit!=NULL and
                      lastImplicit!.logicalNextItemPOV()==NULL and
                      crossedToOuterSibling!=NULL and
                      crossedToOuterSibling===innerPOV!.next and
                      crossedToOuterSibling!.pItem!.value!.num.convertToInt()==99 and
                      stoppedAtInnerBoundary==NULL and
                      sparsePOV!.pItem!.value!.items.isEmpty()
        }else if(caseID==8){
            our infonView: parent <- parseAndExtract(
                    testName, "{&*4+{item| ...} 99}")
            our POV:: parentPOV{povSrcImplicitItem}
            parentPOV!.pItem <- parent
            our POV: sparsePOV <- parent!.value!.items.head
            our POV: remainderPOV
            if(sparsePOV!=NULL){
                sparsePOV!.pParent <- parentPOV
                sparsePOV!.isSubItm <- true
                sparsePOV!.bindIdentityRegistry(identityRegistry)
                remainderPOV <- sparsePOV!.splitSparseSpanPrefix(2)
            }
            passed <- sparsePOV!=NULL and remainderPOV!=NULL and
                      sparsePOV!.pItem!.value!.sizeMode==fromGiven and
                      remainderPOV!.pItem!.value!.sizeMode==fromGiven and
                      sparsePOV!.sparseSpanCount()==2 and
                      remainderPOV!.sparseSpanCount()==2 and
                      remainderPOV!.isSubItm and
                      remainderPOV!.pParent===parentPOV
        }else if(caseID==9){
            our infonView: parent <- parseAndExtract(
                    testName, "{&*6+{item| ...} 99}")
            our POV:: parentPOV{povSrcImplicitItem}
            parentPOV!.pItem <- parent
            parentPOV!.bindIdentityRegistry(identityRegistry)
            our POV: sparsePOV <- parent!.value!.items.head
            our POV: beforeSplit
            our POV: remainderPOV
            our POV: afterSplit
            me uint64: occurrenceToken <- 0
            if(sparsePOV!=NULL){
                sparsePOV!.pParent <- parentPOV
                sparsePOV!.isSubItm <- true
                beforeSplit <- sparsePOV!.getOrCreateImplicitItemPOV(4)
            }
            if(beforeSplit!=NULL){
                occurrenceToken <- beforeSplit!.repetitionOccurrence!.
                        occurrenceToken
                remainderPOV <- sparsePOV!.splitSparseSpanPrefix(3)
            }
            if(remainderPOV!=NULL){
                afterSplit <- remainderPOV!.getOrCreateImplicitItemPOV(1)
            }
            passed <- beforeSplit!=NULL and remainderPOV!=NULL and
                      afterSplit!=NULL and beforeSplit===afterSplit and
                      afterSplit!.repetitionOccurrence!.occurrenceToken==
                            occurrenceToken and
                      afterSplit!.repetitionOccurrence!.ordinal==4 and
                      afterSplit!.implicitItem.sourcePov===remainderPOV and
                      afterSplit!.implicitItem.sourceIndex==1 and
                      sparsePOV!.repetitionSpan.family===
                            remainderPOV!.repetitionSpan.family and
                      sparsePOV!.sparseSpanCount()==3 and
                      remainderPOV!.sparseSpanCount()==3 and
                      parent!.value!.items.size()==3
        }else if(caseID==10){
            our infonView: parent <- parseAndExtract(
                    testName, "{&*3+{item| ...} 99}")
            our POV:: parentPOV{povSrcImplicitItem}
            parentPOV!.pItem <- parent
            parentPOV!.bindIdentityRegistry(identityRegistry)
            our POV: sparsePOV <- parent!.value!.items.head
            our POV: occurrenceReference
            our POV: concretePOV
            our POV: nextOccurrence
            if(sparsePOV!=NULL){
                sparsePOV!.pParent <- parentPOV
                sparsePOV!.isSubItm <- true
                occurrenceReference <-
                        sparsePOV!.getOrCreateImplicitItemPOV(0)
            }
            if(occurrenceReference!=NULL){
                concretePOV <- sparsePOV!.exposeSparseHeadWithItem(
                        occurrenceReference!.pItem)
                nextOccurrence <- sparsePOV!.getOrCreateImplicitItemPOV(0)
            }
            passed <- occurrenceReference!=NULL and concretePOV!=NULL and
                      nextOccurrence!=NULL and
                      !(occurrenceReference===concretePOV) and
                      !(occurrenceReference===nextOccurrence) and
                      identityRegistry!.areIdentical(
                            occurrenceReference, concretePOV) and
                      identityRegistry!.areIdentical(
                            concretePOV, occurrenceReference) and
                      identityRegistry!.identities.size()==1 and
                      occurrenceReference!.repetitionOccurrence!.
                            materializedPOV===concretePOV and
                      concretePOV!.repetitionOccurrence===
                            occurrenceReference!.repetitionOccurrence and
                      !occurrenceReference!.isImplicitItemPOV() and
                      sparsePOV!.repetitionSpan.startOrdinal==1 and
                      nextOccurrence!.repetitionOccurrence!.ordinal==1 and
                      sparsePOV!.sparseSpanCount()==2 and
                      parent!.value!.items.size()==3
        }else if(caseID==11){
            our infonView: hugeSource <- parseAndExtract(
                    testName, "*1000000000+{item| ...}")
            our POV:: hugeSourcePOV{povSrcImplicitItem}
            hugeSourcePOV!.pItem <- hugeSource
            hugeSourcePOV!.isSubItm <- true
            hugeSourcePOV!.bindIdentityRegistry(identityRegistry)
            our POV: lastOccurrence <- hugeSourcePOV!.
                    getOrCreateImplicitItemPOV(999999999)
            passed <- lastOccurrence!=NULL and
                      lastOccurrence!.repetitionOccurrence!=NULL and
                      lastOccurrence!.repetitionOccurrence!.ordinal==999999999 and
                      hugeSource!.value!.items.isEmpty() and
                      hugeSourcePOV!.sparseSpanCount()==1000000000 and
                      hugeSourcePOV!.repetitionSpan.family!=NULL and
                      hugeSourcePOV!.repetitionSpan.family!.occurrences.size()==1 and
                      identityRegistry!.repetitionFamilies.size()==1
        }else if(caseID==12){
            our POV:: firstPOV{povSrcImplicitItem}
            our POV:: secondPOV{povSrcImplicitItem}
            our POV:: thirdPOV{povSrcImplicitItem}
            our infonView:: first
            our infonView:: second
            our infonView:: third
            firstPOV!.pItem <- first
            secondPOV!.pItem <- second
            thirdPOV!.pItem <- third
            our IdentityRelation: firstIdentity <- identityRegistry!.
                    recordIdentity(firstPOV, secondPOV,
                            iekAssertion, 1)
            our IdentityRelation: secondIdentity <- identityRegistry!.
                    recordIdentity(secondPOV, thirdPOV,
                            iekAssertion, 1)
            our IdentityRelation: duplicateIdentity <- identityRegistry!.
                    recordIdentity(secondPOV, firstPOV,
                            iekAssertion, 1)
            passed <- firstIdentity!=NULL and secondIdentity!=NULL and
                      duplicateIdentity===firstIdentity and
                      identityRegistry!.identities.size()==2 and
                      identityRegistry!.areIdentical(firstPOV, thirdPOV) and
                      identityRegistry!.areIdentical(thirdPOV, firstPOV)
        }else if(caseID==13){
            our infonView: parent <- parseAndExtract(
                    testName, "{&*2+{item| ...} 99}")
            our POV:: parentPOV{povSrcImplicitItem}
            parentPOV!.pItem <- parent
            parentPOV!.bindIdentityRegistry(identityRegistry)
            our POV: sparsePOV <- parent!.value!.items.head
            our POV: concretePOV
            their RepetitionOccurrence: occurrence
            if(sparsePOV!=NULL){
                sparsePOV!.pParent <- parentPOV
                sparsePOV!.isSubItm <- true
                concretePOV <- sparsePOV!.exposeSparseHead(false)
            }
            if(concretePOV!=NULL){
                occurrence <- concretePOV!.repetitionOccurrence
            }
            passed <- concretePOV!=NULL and occurrence!=NULL and
                      occurrence!.referencePOV!=NULL and
                      occurrence!.materializedPOV===concretePOV and
                      identityRegistry!.areIdentical(
                            occurrence!.referencePOV, concretePOV) and
                      identityRegistry!.areIdentical(
                            concretePOV, occurrence!.referencePOV) and
                      identityRegistry!.identities.size()==1 and
                      sparsePOV!.repetitionSpan.startOrdinal==1 and
                      sparsePOV!.sparseSpanCount()==1 and
                      parent!.value!.items.size()==3
        }else{
            source!.infSize!.evalMode <- emUnknown
            our RepetitionOccurrence: firstOccurrence <- identityRegistry!.
                    createUnknownOrdinalRepetitionOccurrence(sourcePOV)
            our RepetitionOccurrence: secondOccurrence <- identityRegistry!.
                    createUnknownOrdinalRepetitionOccurrence(sourcePOV)
            me uint64: firstToken <- 0
            our POV: firstReferencePOV
            if(firstOccurrence!=NULL){
                firstToken <- firstOccurrence!.occurrenceToken
                firstReferencePOV <- firstOccurrence!.referencePOV
            }
            our infonView: occurrenceQuery <- parseAndExtract(
                    testName, "_")
            our POV:: occurrenceQueryPOV{povSrcPartPathSelection}
            occurrenceQueryPOV!.pItem <- occurrenceQuery
            our infonView: occurrenceResult <- parseAndExtract(
                    testName, "item")
            our POV:: occurrenceResultPOV{povSrcPartPathSelection}
            occurrenceResultPOV!.pItem <- occurrenceResult
            our SelectionRequest: occurrenceRequest <- identityRegistry!.
                    getOrCreateSelectionRequest(
                            occurrenceQueryPOV, occurrenceResultPOV,
                            sourcePOV, srkIntersectionCorrespondence, 1)
            our SelectionReference: firstSelection
            our SelectionReference: secondSelection
            our SelectionResolution: occurrenceResolution
            if(firstOccurrence!=NULL and secondOccurrence!=NULL and
                    occurrenceRequest!=NULL){
                firstSelection <- identityRegistry!.
                        recordSelectionReferenceForRequest(
                                occurrenceRequest, occurrenceResultPOV,
                                firstOccurrence!.referencePOV)
                secondSelection <- identityRegistry!.
                        recordSelectionReferenceForRequest(
                                occurrenceRequest, occurrenceResultPOV,
                                secondOccurrence!.referencePOV)
                occurrenceResolution <- identityRegistry!.
                        resolveSelectionRequest(
                                occurrenceRequest!.requestID)
            }
            me bool: firstBound <- identityRegistry!.
                    bindRepetitionOccurrenceOrdinal(firstOccurrence, 2)
            me bool: sameBinding <- identityRegistry!.
                    bindRepetitionOccurrenceOrdinal(firstOccurrence, 2)
            me bool: conflictingRebind <- identityRegistry!.
                    bindRepetitionOccurrenceOrdinal(firstOccurrence, 1)
            me bool: ordinalCollision <- identityRegistry!.
                    bindRepetitionOccurrenceOrdinal(secondOccurrence, 2)
            me bool: secondBound <- identityRegistry!.
                    bindRepetitionOccurrenceOrdinal(secondOccurrence, 3)
            our RepetitionOccurrence: foundFirst <- identityRegistry!.
                    findOrdinalOccurrence(
                            sourcePOV!.repetitionSpan.family, 2)
            our RepetitionOccurrence: foundSecond <- identityRegistry!.
                    findOrdinalOccurrence(
                            sourcePOV!.repetitionSpan.family, 3)
            passed <- firstOccurrence!=NULL and secondOccurrence!=NULL and
                      firstOccurrence!==secondOccurrence and
                      firstToken!=secondOccurrence!.occurrenceToken and
                      firstReferencePOV===firstOccurrence!.referencePOV and
                      firstReferencePOV!.repetitionOccurrence===
                            firstOccurrence and
                      firstSelection!=NULL and secondSelection!=NULL and
                      firstSelection!.repetitionOccurrence===firstOccurrence and
                      secondSelection!.repetitionOccurrence===secondOccurrence and
                      occurrenceResolution!=NULL and
                      occurrenceResolution!.resolutionState==srsMultiple and
                      occurrenceResolution!.references.size()==2 and
                      firstBound and sameBinding and !conflictingRebind and
                      !ordinalCollision and secondBound and
                      firstOccurrence!.ordinalKnown and
                      firstOccurrence!.ordinal==2 and
                      secondOccurrence!.ordinalKnown and
                      secondOccurrence!.ordinal==3 and
                      foundFirst===firstOccurrence and
                      foundSecond===secondOccurrence and
                      source!.infSize!.evalMode==emUnknown and
                      source!.value!.items.isEmpty() and
                      sourcePOV!.repetitionSpan.family!.occurrences.size()==2
        }

        me string: result <- "false"
        me string: expected <- "true"
        if(passed){result <- "true"}
        REQUIRE(result==expected)
        return()
    }
    me void: unitTestListSpecApplication(me string: testName) <- {
        our infonView:: firstListSpec
        firstListSpec!.viewMode <- vmAny
        firstListSpec!.value!.overlayType <- NUM
        firstListSpec!.value!.evalMode <- emUnknown

        our infonView:: secondListSpec
        secondListSpec!.viewMode <- vmAny
        secondListSpec!.value!.overlayType <- STR
        secondListSpec!.value!.evalMode <- emUnknown

        our infonView:: list
        list!.viewMode <- vmOverlay
        list!.value!.overlayType <- LST
        list!.value!.evalMode <- emLiteral
        list!.value!.listSpec <- firstListSpec
        our POV:: listPOV{627}
        listPOV!.pItem <- list

        our infonView:: member
        member!.viewMode <- vmOverlay
        member!.value!.overlayType <- NUM
        member!.value!.evalMode <- emLiteral

        me bool: firstApplied <- listPOV!.seedTypeSpecs(member, false)
        me bool: duplicateSkipped <-
                !listPOV!.seedNewlyVisibleTypeSpecs(member, false)
        me bool: firstStateCorrect <-
                member!.appliedListSpecs.size()==1 and
                member!.appliedListSpecs[0]===firstListSpec and
                member!.wrkList.size()==1

        list!.value!.listSpec <- secondListSpec
        me bool: ordinaryRepeatPreserved <-
                listPOV!.seedTypeSpecs(member, false) and
                member!.appliedListSpecs.size()==1 and
                member!.wrkList.size()==1
        me bool: secondApplied <-
                listPOV!.seedNewlyVisibleTypeSpecs(member, false)
        me bool: secondStateCorrect <-
                member!.appliedListSpecs.size()==2 and
                member!.appliedListSpecs[1]===secondListSpec and
                member!.wrkList.size()==2

        me string: actual <- "false"
        me string: expected <- "true"
        if(firstApplied and duplicateSkipped and firstStateCorrect and
                ordinaryRepeatPreserved and secondApplied and
                secondStateCorrect){actual <- "true"}
        REQUIRE(actual==expected)
        return()
    }
    me void: processTestLine(me string: testName, our Agent: agent, me string: line) <- {
        me int: pos           <- findString(line, "//:")
        me string: testInput
        me string: expected
        if(pos==-1){
            testInput  <- line
            expected <- ""
        }else{
            testInput  <- line.subStr(0,pos)
            expected <- line.subStr(pos+3,line.size())
        }
        log("IN:<"+testInput+">  EXPECTED:<"+expected+">")
        testLine(testName, agent, testInput, expected, true)
    }
    me void: multiNorm(me string: testName, me string: in, me string: worldFileName) <- {
        infonViewPrinter.debugSublistPrint <- true
        me TestProteusCore: CORE
        me bool: loaded <- CORE.initForWorldTest(worldFileName)
        me string: loadedState <- "false"
        if(loaded){loadedState <- "true"}
        me string: expectedLoadState <- "true"
        REQUIRE(loadedState==expectedLoadState)
        if(!loaded){modelMngr.clear(); return()}
        me string: line <- ""
        withEach charPos in range 0 .. in.size(){
            if(in[charPos]=="\n"){
                processTestLine(testName, CORE.agent, line)
                line <- ""
            }else{line <+- in[charPos]}
        }
        if(line!=""){processTestLine(testName, CORE.agent, line)}
        modelMngr.clear()
    }
}

// These exercise the real POV adapter and asynchronous public CodeDog API.
// The generic scheduler's independent concurrency/cost tests live in graph/.
#define GRAPHFOUNDATION(NAME, MSG, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphFoundation(tname, CASE_ID)}%>

struct GLOBAL {
    GRAPHFOUNDATION(unit/graphFoundation/oneRHS, "one RHS supplies size and value", 1)
    GRAPHFOUNDATION(unit/graphFoundation/twoRHSs, "separate constraints supply separate fields", 2)
    GRAPHFOUNDATION(unit/graphFoundation/throughRHS, "retain findings through unresolved scalar RHSs", 3)
    GRAPHFOUNDATION(unit/graphFoundation/noRoute, "quiescent symbolic result retains a subscription", 4)
    GRAPHFOUNDATION(unit/graphFoundation/subscription, "publish information after symbolic completion", 5)
    GRAPHFOUNDATION(unit/graphFoundation/cancel, "cancel only one of two subscribers", 6)
    GRAPHFOUNDATION(unit/graphFoundation/conflict, "do not treat conjunctive work as alternatives", 7)
    GRAPHFOUNDATION(unit/graphFoundation/registry, "traverse registered identities bidirectionally", 8)
    GRAPHFOUNDATION(unit/graphFoundation/sparse, "select a billionth occurrence without expanding its list", 9)
    GRAPHFOUNDATION(unit/graphFoundation/refinement, "a size subgoal exposes a sparse edge", 10)
    GRAPHFOUNDATION(unit/graphFoundation/cost, "route threshold leaves expensive work symbolic", 11)
    GRAPHFOUNDATION(unit/graphFoundation/physical, "select a loaded physical item", 12)
    GRAPHFOUNDATION(unit/graphFoundation/unsupported, "retain unsupported semantic constraints", 13)
    GRAPHFOUNDATION(unit/graphFoundation/intermediateConflict, "validate every constraint on the path", 14)
    GRAPHFOUNDATION(unit/graphFoundation/string, "reuse scalar Set for string values", 15)

    GRAPHFOUNDATION(unit/graphFoundation/parsedNumeric, "use parser-created numeric work-list constraints", 16)
    GRAPHFOUNDATION(unit/graphFoundation/sizeMismatch, "reject conflicting exact scalar sizes", 17)

    GRAPHFOUNDATION(unit/graphFoundation/pendingPath, "do not use an unresolved path result as scalar evidence", 18)

    GRAPHFOUNDATION(unit/graphFoundation/stringConflict, "detect conflicting scalar strings without an agenda", 19)
    GRAPHFOUNDATION(unit/graphFoundation/copyPrefix, "state-copy primitive preserves prefix and metadata behavior", 20)

    GRAPHFOUNDATION(unit/graphFoundation/completionInvalidation, "invalidate completed targets after later transitive information", 21)
    GRAPHFOUNDATION(unit/graphFoundation/knownButDeferred, "known fields do not hide cost-excluded constraints", 22)
    GRAPHFOUNDATION(unit/graphFoundation/listNotComplete, "known list extent does not imply normalized members", 23)
    GRAPHFOUNDATION(unit/graphFoundation/knownConflict, "known conflicting scalar is not marked normalized", 24)

    GRAPHFOUNDATION(unit/graphFoundation/closedList, "physical list normalization scenario", 25)

    GRAPHFOUNDATION(unit/graphFoundation/nestedAndEmbedded, "physical list normalization scenario", 26)

    GRAPHFOUNDATION(unit/graphFoundation/countedNested, "physical list normalization scenario", 27)

    GRAPHFOUNDATION(unit/graphFoundation/countedEmbedded, "physical list normalization scenario", 28)

    GRAPHFOUNDATION(unit/graphFoundation/givenUnknownSize, "physical list normalization scenario", 29)

    GRAPHFOUNDATION(unit/graphFoundation/givenSizeMismatch, "physical list normalization scenario", 30)

    GRAPHFOUNDATION(unit/graphFoundation/innerOuterSize, "physical list normalization scenario", 31)

    GRAPHFOUNDATION(unit/graphFoundation/openListChild, "physical list normalization scenario", 32)

    GRAPHFOUNDATION(unit/graphFoundation/sparseStillLazy, "physical list normalization scenario", 33)

    GRAPHFOUNDATION(unit/graphFoundation/listCost, "physical list normalization scenario", 34)

    GRAPHFOUNDATION(unit/graphFoundation/listSubscription, "physical list normalization scenario", 35)

    GRAPHFOUNDATION(unit/graphFoundation/listCancellation, "physical list normalization scenario", 36)

    GRAPHFOUNDATION(unit/graphFoundation/childConflict, "physical list normalization scenario", 37)

    GRAPHFOUNDATION(unit/graphFoundation/listTemplate, "physical list normalization scenario", 38)

    GRAPHFOUNDATION(unit/graphFoundation/emptyList, "physical list normalization scenario", 39)

    GRAPHFOUNDATION(unit/graphFoundation/fractionalSpanExtent, "embedded span count evidence", 40)

    GRAPHFOUNDATION(unit/graphFoundation/invertedSpanExtent, "embedded span count evidence", 41)

    GRAPHFOUNDATION(unit/graphFoundation/embeddedStrings, "embedded span count evidence", 42)

    our POV: graphScalar(me int64: value, me int64: size) <- {
        our POV:: result{900}
        Allocate(result!.pItem)
        result!.pItem!.viewMode <- vmOverlay
        result!.pItem!.value!.overlayType <- NUM
        result!.pItem!.value!.evalMode <- emUnknown
        result!.pItem!.infSize!.overlayType <- NUM
        result!.pItem!.infSize!.evalMode <- emUnknown
        if(value>=0){
            result!.pItem!.value!.evalMode <- emLiteral
            result!.pItem!.value!.num <- value
        }
        if(size>=0){
            result!.pItem!.infSize!.evalMode <- emLiteral
            result!.pItem!.infSize!.num <- size
        }
        return(result)
    }
    our POV: graphParsed(me string: testName, me string: text) <- {
        our POV:: result{901}
        result!.pItem <- parseAndExtract(testName, text)
        return(result)
    }
    // Run unchanged language fixtures through the graph API only. Keep the
    // normal printer and expected text: rendering gaps must remain visible.
    me void: testGraphLanguage(me string: testName, me string: input, me string: expected) <- {
        our POV: target <- graphParsed(testName, input)
        if(target!.pItem==NULL){FAIL("Syntax Error in input: "+input)}
        me ProteusCore: core
        core.init("", false)
        me NormalizationHandle: handle <- core.agent!.normalize(target)
        handle.waitForCompletion()
        me bool: failed <- handle.failed()
        me bool: symbolic <- handle.symbolicValues()
        me bool: settled <- handle.fullyNormed()
        me string: error <- handle.error()
        core.deInit()
        // Use exactly the ordinary language-test printer after stopping writes.
        // POV.stringify() adds a diagnostic symbol prefix that those tests omit.
        me string: actual <- toString(target!.pItem)
        print("GRAPH_CASE ", testName, "\n")
        print("  actual: ", actual, "\n  expected: ", expected, "\n")
        print("  settled=", settled, " symbolic=", symbolic, " failed=", failed,
              " size=", target!.pItem!.infSize!.num.stringify(),
              " sizeState=", toString(target!.pItem!.infSize!.evalMode), "\n")
        if(failed){print("  error: ", error, "\n")}
        if(failed or !settled){FAIL("Graph normalization did not settle successfully")}
        REQUIRE(actual==expected)
    }
    me void: unitTestGraphFoundation(me string: testName, me int: caseID) <- {
        me GraphNormalizer: normalizer
        normalizer.init()
        our POV: target <- graphScalar(-1, -1)
        our POV: source <- graphScalar(7, 10)
        me bool: passed <- false
        me NormalizationHandle: handle
        if(caseID==1){
            normalizer.addRHS(target, source)
            handle <- normalizer.normalize(target)
            handle.waitForCompletion()
            passed <- handle.fullyNormed() and !handle.failed() and
                    !handle.symbolicValues() and !handle.withSubscribers() and
                    target!.pItem!.value!.num==7 and target!.pItem!.infSize!.num==10 and
                    target!.pItem!.wrkList.isEmpty() and target!.pItem!.hasRHS(source!.pItem) and handle.stepCount()>0
            me int: pairSets <- 0
            withEach step in range 0 .. handle.stepCount(){
                if(handle.stepDescription(step)=="Set requested size/value/type"){pairSets <+- 1}
            }
            passed <- passed and pairSets==1 and target!.pItem!.isNormed
        }else if(caseID==2){
            our POV: valueSource <- graphScalar(7, -1)
            our POV: sizeSource <- graphScalar(-1, 10)
            normalizer.addRHS(target, valueSource)
            normalizer.addRHS(target, sizeSource)
            handle <- normalizer.normalize(target)
            handle.waitForCompletion()
            passed <- handle.fullyNormed() and !handle.symbolicValues() and
                    !handle.failed() and target!.pItem!.value!.num==7 and
                    target!.pItem!.infSize!.num==10 and target!.pItem!.wrkList.size()==2
        }else if(caseID==3){
            our POV: middle <- graphScalar(-1, -1)
            normalizer.addRHS(target, middle)
            normalizer.addRHS(middle, source)
            normalizer.addRHS(middle, target)
            handle <- normalizer.normalize(target)
            handle.waitForCompletion()
            passed <- handle.fullyNormed() and !handle.failed() and
                    target!.pItem!.value!.num==7 and
                    middle!.pItem!.value!.evalMode==emLiteral and middle!.pItem!.value!.num==7 and
                    middle!.pItem!.infSize!.num==10 and middle!.pItem!.wrkList.size()==1 and
                    middle!.pItem!.hasRHS(source!.pItem) and middle!.pItem!.hasRHS(target!.pItem)
        }else if(caseID==4){
            handle <- normalizer.normalize(target)
            handle.waitForCompletion()
            passed <- handle.fullyNormed() and handle.symbolicValues() and
                    handle.withSubscribers() and !handle.failed() and
                    target!.pItem!.value!.evalMode==emUnknown
            handle.cancel()
        }else if(caseID==5){
            our POV: missing <- graphScalar(-1, -1)
            normalizer.addRHS(target, missing)
            handle <- normalizer.normalize(target)
            handle.waitForCompletion()
            passed <- handle.withSubscribers() and handle.symbolicValues()
            normalizer.addRHS(missing, source)
            handle.waitForCompletion()
            passed <- passed and handle.fullyNormed() and !handle.withSubscribers() and
                    !handle.failed() and target!.pItem!.value!.num==7
        }else if(caseID==6){
            our POV: other <- graphScalar(-1, -1)
            our POV: missing <- graphScalar(-1, -1)
            normalizer.addRHS(target, missing)
            normalizer.addRHS(other, missing)
            me NormalizationHandle: first <- normalizer.normalize(target)
            me NormalizationHandle: second <- normalizer.normalize(other)
            first.waitForCompletion(); second.waitForCompletion()
            first.cancel()
            normalizer.addRHS(missing, source)
            first.waitForCompletion(); second.waitForCompletion()
            passed <- first.cancelled() and !first.withSubscribers() and
                    !first.fullyNormed() and target!.pItem!.value!.evalMode==emUnknown and
                    other!.pItem!.value!.num==7 and second.fullyNormed() and !second.failed()
        }else if(caseID==7){
            our POV: conflict <- graphScalar(8, 10)
            normalizer.addRHS(target, source)
            normalizer.addRHS(target, conflict)
            handle <- normalizer.normalize(target)
            handle.waitForCompletion()
            passed <- handle.failed() and !handle.fullyNormed() and
                    target!.pItem!.wrkList.size()==2 and target!.pItem!.value!.num==7 and
                    !target!.pItem!.isNormed
        }else if(caseID==8){
            our POV: middle <- graphScalar(-1, -1)
            normalizer.recordIdentity(middle, target)
            normalizer.recordIdentity(source, middle)
            handle <- normalizer.normalize(target)
            handle.waitForCompletion()
            passed <- handle.fullyNormed() and !handle.failed() and
                    target!.pItem!.value!.num==7 and normalizer.access!.registry!.identities.size()==2
        }else if(caseID==9){
            target <- graphParsed(testName, "*1000000000+{item| ...}")
            handle <- normalizer.findItem(target, 999999999)
            handle.waitForCompletion()
            our POV: selected <- handle.result()
            passed <- selected!=NULL and handle.fullyNormed() and !handle.failed() and
                    !handle.symbolicValues() and selected!.implicitItem.sourceIndex==999999999 and
                    target!.pItem!.value!.items.isEmpty() and
                    target!.repetitionSpan.family!.occurrences.size()==1
        }else if(caseID==10){
            target <- graphParsed(testName, "*_+{item| ...}")
            source <- graphParsed(testName, "*1000000000+{item| ...}")
            normalizer.addRHS(target, source)
            handle <- normalizer.findItem(target, 999999999)
            handle.waitForCompletion()
            our POV: selected <- handle.result()
            passed <- selected!=NULL and handle.fullyNormed() and !handle.failed() and
                    target!.pItem!.infSize!.num==1000000000 and
                    selected!.implicitItem.sourceIndex==999999999 and
                    target!.pItem!.value!.items.isEmpty() and target!.pItem!.wrkList.size()==1 and
                    !target!.pItem!.isNormed
        }else if(caseID==11){
            normalizer.addRHS(target, source)
            handle <- normalizer.normalizeWithCost(target, 0)
            handle.waitForCompletion()
            passed <- handle.fullyNormed() and handle.symbolicValues() and
                    handle.withSubscribers() and !handle.failed() and
                    target!.pItem!.value!.evalMode==emUnknown
            handle.cancel()
        }else if(caseID==12){
            target <- graphParsed(testName, "{4 8 12}")
            handle <- normalizer.findItem(target, 1)
            handle.waitForCompletion()
            our POV: selected <- handle.result()
            passed <- selected!=NULL and handle.fullyNormed() and !handle.failed() and
                    selected===target!.pItem!.value!.items.head!.next and
                    selected!.pItem!.value!.num==8
        }else if(caseID==13){
            our POV: symbolic <- graphParsed(testName, "*_+[1 2]")
            normalizer.addRHS(target, source)
            normalizer.addRHS(target, symbolic)
            handle <- normalizer.normalize(target)
            handle.waitForCompletion()
            passed <- handle.fullyNormed() and handle.symbolicValues() and
                    handle.withSubscribers() and !handle.failed() and
                    target!.pItem!.value!.num==7 and target!.pItem!.wrkList.size()==1 and
                    target!.pItem!.hasRHS(source!.pItem) and !target!.pItem!.isNormed
            handle.cancel()
        }else if(caseID==14){
            our POV: middle <- graphScalar(6, 10)
            normalizer.addRHS(target, middle)
            normalizer.addRHS(middle, source)
            handle <- normalizer.normalize(target)
            handle.waitForCompletion()
            passed <- handle.failed() and !handle.fullyNormed() and target!.pItem!.value!.num==6
        }else if(caseID==15){
            target <- graphParsed(testName, "*_+$")
            source <- graphParsed(testName, "'hello'")
            normalizer.addRHS(target, source)
            handle <- normalizer.normalize(target)
            handle.waitForCompletion()
            passed <- handle.fullyNormed() and !handle.failed() and !handle.symbolicValues() and
                    target!.pItem!.value!.str=="hello" and target!.pItem!.infSize!.num==5
        }else if(caseID==16){
            target <- graphParsed(testName, "*_+_ = *10+7")
            source <- target!.pItem!.wrkList[0]
            handle <- normalizer.normalize(target)
            handle.waitForCompletion()
            passed <- handle.fullyNormed() and !handle.failed() and !handle.symbolicValues() and
                    target!.pItem!.value!.num==7 and target!.pItem!.infSize!.num==10 and
                    target!.pItem!.wrkList.isEmpty() and target!.pItem!.hasRHS(source!.pItem)
        }else if(caseID==17){
            our POV: differentSize <- graphScalar(7, 12)
            normalizer.addRHS(target, source)
            normalizer.addRHS(target, differentSize)
            handle <- normalizer.normalize(target)
            handle.waitForCompletion()
            passed <- handle.failed() and !handle.fullyNormed() and
                    target!.pItem!.value!.num==7 and target!.pItem!.infSize!.num==10 and
                    target!.pItem!.wrkList.size()==2
        }else if(caseID==18){
            our PartPath:: pending
            source!.pItem!.parts.append(pending)
            normalizer.addRHS(target, source)
            handle <- normalizer.normalize(target)
            handle.waitForCompletion()
            passed <- handle.fullyNormed() and !handle.failed() and handle.symbolicValues() and
                    handle.withSubscribers() and target!.pItem!.value!.evalMode==emUnknown and
                    target!.pItem!.wrkList.size()==1
        }else if(caseID==19){
            target <- graphParsed(testName, "*_+$")
            source <- graphParsed(testName, "'hello'")
            our POV: differentValue <- graphParsed(testName, "'jello'")
            normalizer.addRHS(target, source)
            normalizer.addRHS(target, differentValue)
            handle <- normalizer.normalize(target)
            handle.waitForCompletion()
            passed <- handle.failed() and !handle.fullyNormed() and
                    target!.pItem!.value!.str=="hello" and target!.pItem!.wrkList.size()==2
        }else if(caseID==20){
            target <- graphParsed(testName, "*_+$")
            source <- graphParsed(testName, "'hello'")
            source!.pItem!.value!.sizeMode <- fromGiven
            target!.pItem!.value!.inverted <- true
            me int64: prefixLength <- 2
            me FlexNum: prefix <- prefixLength
            target!.pItem!.value!.copyOverlayFrom(source!.pItem!.value, prefix)
            passed <- target!.pItem!.value!.str=="he" and
                    target!.pItem!.value!.evalMode==emLiteral and
                    target!.pItem!.value!.sizeMode==fromGiven and
                    target!.pItem!.value!.inverted and source!.pItem!.value!.str=="hello"
        }else if(caseID==21){
            normalizer.addRHS(target, source)
            handle <- normalizer.normalize(target)
            handle.waitForCompletion()
            passed <- target!.pItem!.isNormed
            // Completion metadata must survive releasing the process handle.
            me NormalizationHandle: emptyHandle
            handle <- emptyHandle
            our POV: conflict <- graphScalar(8, 10)
            normalizer.addRHS(source, conflict)
            passed <- passed and !target!.pItem!.isNormed
            handle <- normalizer.normalize(target)
            handle.waitForCompletion()
            passed <- passed and handle.failed() and !target!.pItem!.isNormed and
                    target!.pItem!.wrkList.isEmpty() and target!.pItem!.hasRHS(source!.pItem)
        }else if(caseID==22){
            target <- graphScalar(7, 10)
            normalizer.addRHS(target, source)
            target!.pItem!.isNormed <- true
            handle <- normalizer.normalizeWithCost(target, 0)
            handle.waitForCompletion()
            passed <- handle.fullyNormed() and handle.symbolicValues() and
                    !handle.failed() and !target!.pItem!.isNormed and
                    target!.pItem!.wrkList.size()==1
        }else if(caseID==23){
            target <- graphParsed(testName, "{*10+7 _=2}")
            target!.pItem!.isNormed <- true
            handle <- normalizer.normalize(target)
            handle.waitForCompletion()
            passed <- handle.fullyNormed() and handle.symbolicValues() and
                    !handle.failed() and !target!.pItem!.isNormed and
                    target!.pItem!.infSize!.num==2 and
                    target!.pItem!.value!.items.head!.next!.pItem!.value!.evalMode==emLiteral and
                    target!.pItem!.value!.items.head!.next!.pItem!.value!.num==2 and
                    target!.pItem!.value!.items.head!.pItem!.isNormed and
                    !target!.pItem!.value!.items.head!.next!.pItem!.isNormed
        }else if(caseID==24){
            target <- graphScalar(8, 10)
            normalizer.addRHS(target, source)
            target!.pItem!.isNormed <- true
            handle <- normalizer.normalize(target)
            handle.waitForCompletion()
            passed <- handle.failed() and !target!.pItem!.isNormed and
                    target!.pItem!.value!.num==8 and target!.pItem!.wrkList.size()==1
        }else if(caseID==25){
            target <- graphParsed(testName, "{*_+_=*10+7 'ok'}")
            handle <- normalizer.normalize(target)
            handle.waitForCompletion()
            passed <- !handle.failed() and !handle.symbolicValues() and
                    target!.pItem!.isNormed and target!.pItem!.infSize!.num==2 and
                    target!.pItem!.value!.items.head!.pItem!.isNormed and
                    target!.pItem!.value!.items.head!.pItem!.value!.num==7 and
                    target!.pItem!.value!.items.head!.next!.pItem!.isNormed and
                    toString(target!.pItem)=="{*10+7 'ok'}"
        }else if(caseID==26 or caseID==27 or caseID==28){
            target <- graphParsed(testName, "{{'a' 'b'} &{'c' 'd'} 'e'}")
            our POV: nested <- target!.pItem!.value!.items.head
            our POV: embedded <- nested!.next
            // Remove parser-supplied count evidence to exercise the graph's
            // own count Set, including a child size that exposes the parent.
            if(caseID!=26){target!.pItem!.infSize!.evalMode <- emUnknown}
            if(caseID==27){nested!.pItem!.infSize!.evalMode <- emUnknown}
            if(caseID==28){embedded!.pItem!.infSize!.evalMode <- emUnknown}
            handle <- normalizer.normalize(target)
            handle.waitForCompletion()
            passed <- !handle.failed() and !handle.symbolicValues() and
                    target!.pItem!.isNormed and target!.pItem!.infSize!.num==4 and
                    nested!.pItem!.isNormed and nested!.pItem!.infSize!.num==2 and
                    embedded!.pItem!.isNormed and embedded!.pItem!.infSize!.num==2 and
                    !nested!.isSubItm and embedded!.isSubItm
            if(caseID!=26){
                me bool: sawCount <- false
                withEach step in range 0 .. handle.stepCount(){
                    if(handle.stepDescription(step)=="Set counted list size"){sawCount <- true}
                }
                passed <- passed and sawCount
            }
        }else if(caseID==29 or caseID==30){
            me string: input <- "*_+{'a'}"
            if(caseID==30){input <- "*2+{'a'}"}
            target <- graphParsed(testName, input)
            handle <- normalizer.normalize(target)
            handle.waitForCompletion()
            passed <- !handle.failed() and handle.symbolicValues() and
                    !target!.pItem!.isNormed and
                    target!.pItem!.value!.items.head!.pItem!.isNormed and
                    target!.pItem!.value!.sizeMode==fromGiven
            if(caseID==29){passed <- passed and target!.pItem!.infSize!.evalMode==emUnknown}
            else{passed <- passed and target!.pItem!.infSize!.num==2}
        }else if(caseID==31){
            target <- graphParsed(testName, "{~2| 'a' 'b'}")
            source <- graphParsed(testName, "*2+{'a' 'b'}")
            handle <- normalizer.normalize(target)
            handle.waitForCompletion()
            passed <- !handle.failed() and !handle.symbolicValues() and target!.pItem!.isNormed and
                    target!.pItem!.infSize!.num==2 and target!.pItem!.value!.sizeWasInner
            // Starting another session conservatively invalidates completion
            // metadata in this context. Inspect each result before that update.
            me NormalizationHandle: other <- normalizer.normalize(source)
            other.waitForCompletion()
            passed <- passed and !other.failed() and !other.symbolicValues() and
                    source!.pItem!.isNormed and source!.pItem!.infSize!.num==2 and
                    !source!.pItem!.value!.sizeWasInner
        }else if(caseID==32){
            target <- graphParsed(testName, "{*_+_=*10+7 ...}")
            handle <- normalizer.normalize(target)
            handle.waitForCompletion()
            passed <- !handle.failed() and handle.symbolicValues() and handle.withSubscribers() and
                    !target!.pItem!.isNormed and target!.pItem!.value!.tailUnfinished and
                    target!.pItem!.infSize!.evalMode==emUnknown and
                    target!.pItem!.value!.items.head!.pItem!.isNormed and
                    target!.pItem!.value!.items.head!.pItem!.value!.num==7
        }else if(caseID==33){
            target <- graphParsed(testName, "*1000000000+{*10+7| ...}")
            handle <- normalizer.normalize(target)
            handle.waitForCompletion()
            passed <- !handle.failed() and handle.symbolicValues() and
                    !target!.pItem!.isNormed and target!.pItem!.value!.items.isEmpty() and
                    target!.pItem!.infSize!.num==1000000000 and handle.stepCount()<20
        }else if(caseID==34){
            target <- graphParsed(testName, "{'a' 'b'}")
            handle <- normalizer.normalizeWithCost(target, 1)
            handle.waitForCompletion()
            passed <- !handle.failed() and handle.symbolicValues() and
                    !target!.pItem!.isNormed and
                    target!.pItem!.value!.items.head!.pItem!.isNormed and
                    !target!.pItem!.value!.items.head!.next!.pItem!.isNormed
        }else if(caseID==35 or caseID==36){
            target <- graphParsed(testName, "{*_+_}")
            our POV: child <- target!.pItem!.value!.items.head
            handle <- normalizer.normalize(target)
            handle.waitForCompletion()
            passed <- handle.withSubscribers() and !target!.pItem!.isNormed
            if(caseID==36){handle.cancel()}
            normalizer.addRHS(child, source)
            handle.waitForCompletion()
            if(caseID==35){
                passed <- passed and !handle.failed() and !handle.symbolicValues() and
                        target!.pItem!.isNormed and child!.pItem!.isNormed and
                        child!.pItem!.value!.num==7 and child!.pItem!.infSize!.num==10
            }else{
                passed <- passed and handle.cancelled() and !target!.pItem!.isNormed and
                        child!.pItem!.value!.evalMode==emUnknown
            }
        }else if(caseID==37){
            target <- graphParsed(testName, "{*10+7=*10+8}")
            handle <- normalizer.normalize(target)
            handle.waitForCompletion()
            passed <- handle.failed() and !target!.pItem!.isNormed and
                    !target!.pItem!.value!.items.head!.pItem!.isNormed and
                    target!.pItem!.value!.items.head!.pItem!.wrkList.size()==1
        }else if(caseID==38){
            target <- graphParsed(testName, "{*10+_| *10+7}")
            handle <- normalizer.normalize(target)
            handle.waitForCompletion()
            passed <- !handle.failed() and !handle.symbolicValues() and target!.pItem!.isNormed and
                target!.pItem!.infSize!.num==1 and target!.pItem!.value!.items.head!.pItem!.isNormed
        }else if(caseID==39){
            target <- graphParsed(testName, "{}")
            handle <- normalizer.normalize(target)
            handle.waitForCompletion()
            passed <- !handle.failed() and !handle.symbolicValues() and
                    target!.pItem!.isNormed and target!.pItem!.infSize!.num==0
        }else if(caseID==40 or caseID==41){
            target <- graphParsed(testName, "{&{'a'}}")
            target!.pItem!.infSize!.evalMode <- emUnknown
            our POV: span <- target!.pItem!.value!.items.head
            if(caseID==40){span!.pItem!.infSize!.num.fromString("0.5")}
            else{span!.pItem!.infSize!.inverted <- true}
            handle <- normalizer.normalize(target)
            handle.waitForCompletion()
            passed <- !handle.failed() and handle.symbolicValues() and !target!.pItem!.isNormed and
                    target!.pItem!.infSize!.evalMode==emUnknown
        }else if(caseID==42){
            target <- graphParsed(testName, "{'ab' &'cd'}")
            target!.pItem!.infSize!.evalMode <- emUnknown
            handle <- normalizer.normalize(target)
            handle.waitForCompletion()
            passed <- !handle.failed() and !handle.symbolicValues() and target!.pItem!.isNormed and
                    target!.pItem!.infSize!.num==3 and
                    target!.pItem!.value!.items.head!.pItem!.isNormed and
                    target!.pItem!.value!.items.head!.next!.pItem!.isNormed
        }
        if(!passed){
            print("Graph scenario "+toString(caseID)+": "+handle.error()+"\n")
            withEach step in range 0 .. handle.stepCount(){
                print("  "+handle.stepDescription(step)+" cost="+toString(handle.stepCost(step))+"\n")
            }
        }
        normalizer.close()
        me string: actual <- "false"
        me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHCORRESPONDENCE(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphCorrespondence(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHCORRESPONDENCE(unit/graphFoundation/listRHS/scalars, 1)
    GRAPHCORRESPONDENCE(unit/graphFoundation/listRHS/multipleSources, 2)
    GRAPHCORRESPONDENCE(unit/graphFoundation/listRHS/nested, 3)
    GRAPHCORRESPONDENCE(unit/graphFoundation/listRHS/transitive, 4)
    GRAPHCORRESPONDENCE(unit/graphFoundation/listRHS/conflict, 5)
    GRAPHCORRESPONDENCE(unit/graphFoundation/listRHS/declaredSizeMismatch, 6)
    GRAPHCORRESPONDENCE(unit/graphFoundation/listRHS/unequalLengths, 7)
    GRAPHCORRESPONDENCE(unit/graphFoundation/listRHS/embedded, 8)
    GRAPHCORRESPONDENCE(unit/graphFoundation/listRHS/givenSize, 9)
    GRAPHCORRESPONDENCE(unit/graphFoundation/listRHS/empty, 10)
    GRAPHCORRESPONDENCE(unit/graphFoundation/listRHS/subscription, 11)
    GRAPHCORRESPONDENCE(unit/graphFoundation/listRHS/cancel, 12)
    GRAPHCORRESPONDENCE(unit/graphFoundation/listRHS/cost, 13)
    GRAPHCORRESPONDENCE(unit/graphFoundation/listRHS/parentRegistry, 14)
    GRAPHCORRESPONDENCE(unit/graphFoundation/listRHS/unordered, 15)
    GRAPHCORRESPONDENCE(unit/graphFoundation/listRHS/templateSourceWork, 16)
    GRAPHCORRESPONDENCE(unit/graphFoundation/listRHS/bareNumbers, 17)
    GRAPHCORRESPONDENCE(unit/graphFoundation/listRHS/idempotent, 18)
    GRAPHCORRESPONDENCE(unit/graphFoundation/listRHS/laterConflict, 19)
    GRAPHCORRESPONDENCE(unit/graphFoundation/listRHS/separateFields, 20)

    void: unitTestGraphCorrespondence(me string: testName, me int: caseID) <- {
        me GraphNormalizer: normalizer
        normalizer.init()
        me string: input <- "{*_+_ *_+_} = {*10+7 *10+8}"
        if(caseID==2){input <- "{*_+_ *_+_} = {*10+7 *_+_} = {*_+_ *10+8}"}
        else if(caseID==3){input <- "{{*_+_} {}} = {{*10+7} {}}"}
        else if(caseID==4 or caseID==11 or caseID==12 or caseID==14){input <- "{*_+_}"}
        else if(caseID==5){input <- "{*10+7} = {*10+8}"}
        else if(caseID==6){input <- "*2+{*10+_} = *1+{*10+7}"}
        else if(caseID==7){input <- "{*10+_ *10+_} = {*10+7}"}
        else if(caseID==8){input <- "{*10+_ &{*10+_}} = {*10+7 *10+8}"}
        else if(caseID==9){input <- "*_+{*_+_} = {*10+7}"}
        else if(caseID==10){input <- "{} = {}"}
        else if(caseID==15){input <- "{*10+_, *10+_} = {*10+7 *10+8}"}
        else if(caseID==16 or caseID==19){input <- "{*_+_} = {*10+7}"}
        else if(caseID==17){input <- "{_ _ _} = {2 3 4}"}
        else if(caseID==20){input <- "{*_+_} = {*10+_} = {*_+7}"}
        our POV: target <- graphParsed(testName, input)
        if(target!.pItem==NULL){FAIL("Syntax error in graph correspondence fixture: "+input)}
        our POV: source
        if(!target!.pItem!.wrkList.isEmpty()){source <- target!.pItem!.wrkList[0]}
        if(caseID==4 or caseID==11 or caseID==12 or caseID==14){
            source <- graphParsed(testName, "{*_+_}")
            if(caseID==14){
                source <- graphParsed(testName, "{*10+7}")
                normalizer.recordIdentity(target, source)
            }else{normalizer.addRHS(target, source)}
        }
        if(caseID==4){normalizer.addRHS(source, graphParsed(testName, "{*10+7}"))}
        if(caseID==16){normalizer.addRHS(source, graphParsed(testName, "{*10+_| ...}"))}
        our POV: first <- target!.pItem!.value!.items.head
        our POV: second
        if(first!=NULL){second <- first!.next}
        me NormalizationHandle: handle
        if(caseID==13){handle <- normalizer.normalizeWithCost(target, 3)}
        else{handle <- normalizer.normalize(target)}
        handle.waitForCompletion()
        me bool: passed <- false
        if(caseID==1 or caseID==2 or caseID==18){
            passed <- !handle.failed() and !handle.symbolicValues() and target!.pItem!.isNormed and
                    first!.pItem!.value!.num==7 and second!.pItem!.value!.num==8 and
                    first!.pItem!.infSize!.num==10 and second!.pItem!.infSize!.num==10 and
                    first!.next===second and second!.prev===first and
                    first!.pItem!.wrkList.isEmpty() and second!.pItem!.wrkList.isEmpty() and
                    toString(target!.pItem)=="{*10+7 *10+8}"
            if(caseID==1){
                passed <- passed and target!.pItem!.wrkList.isEmpty() and target!.pItem!.hasRHS(source!.pItem) and
                        normalizer.access!.registry!.identities.size()==3
                withEach identity in normalizer.access!.registry!.identities{
                    if(identity!.leftPOV===target or identity!.rightPOV===target){
                        passed <- passed and identity!.evidenceKind==iekAssertion
                    }else{passed <- passed and identity!.evidenceKind==iekListCorrespondence}
                }
            }
            if(caseID==2){passed <- passed and target!.pItem!.wrkList.isEmpty() and target!.pItem!.hasRHS(source!.pItem)}
            if(caseID==18){
                me int: before <- normalizer.access!.registry!.identities.size()
                handle <- normalizer.normalize(target)
                handle.waitForCompletion()
                passed <- passed and !handle.failed() and !handle.symbolicValues() and
                        target!.pItem!.isNormed and normalizer.access!.registry!.identities.size()==before
            }
        }else if(caseID==3){
            passed <- !handle.failed() and !handle.symbolicValues() and target!.pItem!.isNormed and
                    first!.pItem!.isNormed and second!.pItem!.isNormed and
                    toString(target!.pItem)=="{{*10+7} {}}"
        }else if(caseID==4 or caseID==9 or caseID==14 or caseID==20){
            passed <- !handle.failed() and !handle.symbolicValues() and target!.pItem!.isNormed and
                    target!.pItem!.infSize!.num==1 and first!.pItem!.isNormed and
                    first!.pItem!.value!.num==7 and first!.pItem!.infSize!.num==10
            if(caseID==9){passed <- passed and target!.pItem!.value!.sizeMode==fromGiven}
            if(caseID==14){passed <- passed and normalizer.access!.registry!.identities.size()==2}
            if(caseID==20){
                me int: fieldSets <- 0
                withEach step in range 0 .. handle.stepCount(){
                    if(handle.stepDescription(step)=="Set requested size/value/type"){fieldSets <+- 1}
                }
                passed <- passed and fieldSets>=2
            }
        }else if(caseID==5){
            passed <- handle.failed() and !target!.pItem!.isNormed and !first!.pItem!.isNormed and
                    target!.pItem!.wrkList.size()==1
        }else if(caseID==8){
            passed <- !handle.failed() and !handle.symbolicValues() and target!.pItem!.isNormed and
                    first!.pItem!.value!.num==7 and second!.pItem!.value!.items.head!.pItem!.value!.num==8
        }else if(caseID==6 or caseID==7 or caseID==13 or caseID==15){
            passed <- !handle.failed() and handle.symbolicValues() and !target!.pItem!.isNormed and
                    first!.pItem!.value!.evalMode==emUnknown and
                    normalizer.access!.registry!.identities.isEmpty() and
                    target!.pItem!.wrkList.size()==1
        }else if(caseID==10){
            passed <- !handle.failed() and !handle.symbolicValues() and target!.pItem!.isNormed and
                    toString(target!.pItem)=="{}" and target!.pItem!.wrkList.isEmpty() and target!.pItem!.hasRHS(source!.pItem)
        }else if(caseID==11 or caseID==12){
            passed <- !handle.failed() and handle.withSubscribers() and !target!.pItem!.isNormed and
                    normalizer.access!.registry!.identities.size()==1
            if(caseID==12){handle.cancel()}
            normalizer.addRHS(source!.pItem!.value!.items.head, graphScalar(7, 10))
            handle.waitForCompletion()
            if(caseID==11){
                passed <- passed and !handle.failed() and !handle.symbolicValues() and
                        target!.pItem!.isNormed and first!.pItem!.value!.num==7 and first!.pItem!.infSize!.num==10
            }else{
                passed <- passed and handle.cancelled() and first!.pItem!.value!.evalMode==emUnknown
            }
        }else if(caseID==16){
            passed <- !handle.failed() and !handle.symbolicValues() and target!.pItem!.isNormed and
                    first!.pItem!.value!.num==7 and first!.pItem!.isNormed and
                    target!.pItem!.wrkList.size()==1 and source!.pItem!.wrkList.size()==1 and
                    source!.pItem!.wrkList[0]!.pItem!.value!.items.size()==1 and
                    !source!.pItem!.wrkList[0]!.pItem!.value!.tailUnfinished
        }else if(caseID==17){
            passed <- !handle.failed() and handle.symbolicValues() and !target!.pItem!.isNormed and
                    first!.pItem!.value!.num==2 and second!.pItem!.value!.num==3 and
                    second!.next!.pItem!.value!.num==4 and first!.pItem!.infSize!.evalMode==emUnknown and
                    target!.pItem!.wrkList.size()==1
        }else if(caseID==19){
            passed <- !handle.failed() and !handle.symbolicValues() and target!.pItem!.isNormed
            normalizer.addRHS(source!.pItem!.value!.items.head, graphScalar(8, 10))
            passed <- passed and !target!.pItem!.isNormed
            handle <- normalizer.normalize(target)
            handle.waitForCompletion()
            passed <- passed and handle.failed() and !target!.pItem!.isNormed and
                    !first!.pItem!.isNormed and normalizer.access!.registry!.identities.size()==2 and target!.pItem!.hasRHS(source!.pItem)
        }
        if(!passed){
            print("Graph correspondence "+toString(caseID)+": "+handle.error()+"\n")
            print("  result: "+toString(target!.pItem)+"\n")
            withEach step in range 0 .. handle.stepCount(){
                print("  "+handle.stepDescription(step)+" cost="+toString(handle.stepCost(step))+"\n")
            }
        }
        normalizer.close()
        me string: actual <- "false"
        me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHSPANS(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphSpans(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHSPANS(unit/graphFoundation/spans/embeddedLeft, 1)
    GRAPHSPANS(unit/graphFoundation/spans/embeddedRight, 2)
    GRAPHSPANS(unit/graphFoundation/spans/emptyEmbedded, 3)
    GRAPHSPANS(unit/graphFoundation/spans/nestedIsOne, 4)
    GRAPHSPANS(unit/graphFoundation/spans/closeTail, 5)
    GRAPHSPANS(unit/graphFoundation/spans/middleGap, 6)
    GRAPHSPANS(unit/graphFoundation/spans/givenTail, 7)
    GRAPHSPANS(unit/graphFoundation/spans/reverseTail, 8)
    GRAPHSPANS(unit/graphFoundation/spans/openPrefix, 9)
    GRAPHSPANS(unit/graphFoundation/spans/ambiguousGaps, 10)
    GRAPHSPANS(unit/graphFoundation/spans/zeroGaps, 11)
    GRAPHSPANS(unit/graphFoundation/spans/sizeConflict, 12)
    GRAPHSPANS(unit/graphFoundation/spans/embeddedSizeConflict, 13)
    GRAPHSPANS(unit/graphFoundation/spans/billionSymbolic, 14)
    GRAPHSPANS(unit/graphFoundation/spans/billionPrefix, 15)
    GRAPHSPANS(unit/graphFoundation/spans/subscription, 16)
    GRAPHSPANS(unit/graphFoundation/spans/cancel, 17)
    GRAPHSPANS(unit/graphFoundation/spans/newNestedView, 18)
    GRAPHSPANS(unit/graphFoundation/spans/pricedCreation, 19)
    GRAPHSPANS(unit/graphFoundation/spans/laterConflict, 20)
    GRAPHSPANS(unit/graphFoundation/spans/stringSpanDeferred, 21)
    GRAPHSPANS(unit/graphFoundation/spans/boundedSymbolic, 22)
    GRAPHSPANS(unit/graphFoundation/spans/embeddedCycle, 23)
    GRAPHSPANS(unit/graphFoundation/spans/sharedEmbeddedContext, 24)

    GRAPHSPANS(unit/graphFoundation/spans/exactLargeExtent, 25)

    GRAPHSPANS(unit/graphFoundation/spans/unsupportedLargeExtent, 26)

    GRAPHSPANS(unit/graphFoundation/spans/zeroTail, 27)

    GRAPHSPANS(unit/graphFoundation/spans/nestedOpenSpan, 28)

    void: unitTestGraphSpans(me string: testName, me int: caseID) <- {
        me string: input <- "{*10+_ &{*10+_ *10+_} *10+_} = {*10+1 *10+2 *10+3 *10+4}"
        if(caseID==2){input <- "{*10+_ *10+_ *10+_} = {&{*10+1 &{*10+2}} *10+3}"}
        else if(caseID==3){input <- "{&{} *10+_ &{&{}}} = {*10+7}"}
        else if(caseID==4){input <- "{{*10+_}} = {*10+7}"}
        else if(caseID==5){input <- "{*10+1 ...} = {*10+1 *10+2 *10+3}"}
        else if(caseID==6){input <- "{*10+1 ... *10+4} = {*10+1 *10+2 *10+3 *10+4}"}
        else if(caseID==7){input <- "*3+{...} = {*10+1 *10+2 *10+3}"}
        else if(caseID==8){input <- "{*10+1 *10+2} = {...}"}
        else if(caseID==9){input <- "{...} = {*10+1 *10+2 ...}"}
        else if(caseID==10){input <- "{*10+_ ... ... *10+_} = {*10+1 *10+2 *10+3 *10+4}"}
        else if(caseID==11){input <- "{*10+_ ... ... *10+_} = {*10+1 *10+4}"}
        else if(caseID==12){input <- "*2+{*10+1 ... *10+4} = {*10+1 *10+2 *10+4}"}
        else if(caseID==13){input <- "{&*2+{*10+_}} = {*10+7}"}
        else if(caseID==14){input <- "*1000000000+{...} = *1000000000+{...}"}
        else if(caseID==15){input <- "*1000000000+{...} = {*10+7 ...}"}
        else if(caseID==16 or caseID==17){input <- "{...} = {*10+1 ...}"}
        else if(caseID==18){input <- "{...} = {{*10+7} *10+8}"}
        else if(caseID==19){input <- "{...} = {*10+1 *10+2 *10+3 *10+4 *10+5}"}
        else if(caseID==20){input <- "{...} = {*10+7}"}
        else if(caseID==21){input <- "{*10+_ &'ab'} = {*10+1 *10+2 *10+3}"}
        else if(caseID==22){input <- "*4+{*10+_ ... *10+_} = {*10+1 ... *10+4}"}
        else if(caseID==23){input <- "{&{}} = {}"}
        else if(caseID==24){input <- "{&{*10+_} &{*10+_}} = {*10+7 *10+8}"}
        else if(caseID==25){input <- "*9007199254740993+{...} = *9007199254740992+{*10+7 ...}"}
        else if(caseID==26){input <- "*9223372036854775808+{...} = {*10+7 ...}"}
        else if(caseID==27){input <- "{*10+7 ...} = {*10+7}"}
        else if(caseID==28){input <- "{&{*10+1 &{...} *10+4} *10+5} = {*10+1 *10+2 *10+3 *10+4 *10+5}"}
        our POV: target <- graphParsed(testName, input)
        if(target!.pItem==NULL){FAIL("Syntax error in graph span fixture: "+input)}
        our POV: source <- target!.pItem!.wrkList[0]
        our infonView: saved
        if(caseID==23){
            saved <- target!.pItem!.value!.items.head!.pItem
            target!.pItem!.value!.items.head!.pItem <- target!.pItem
        }
        if(caseID==24){target!.pItem!.value!.items.head!.next!.pItem <- target!.pItem!.value!.items.head!.pItem}
        me GraphNormalizer: normalizer
        normalizer.init()
        me NormalizationHandle: handle
        if(caseID==19){handle <- normalizer.normalizeWithCost(target, 25)}
        else{handle <- normalizer.normalize(target)}
        handle.waitForCompletion()
        our POV: first <- target!.pItem!.value!.items.head
        me bool: passed <- false
        if(caseID==1){
            passed <- !handle.failed() and !handle.symbolicValues() and target!.pItem!.isNormed and
                    target!.pItem!.infSize!.num==4 and first!.pItem!.value!.num==1 and
                    first!.next!.isSubItm and first!.next!.pItem!.value!.items.head!.pItem!.value!.num==2 and
                    first!.next!.pItem!.value!.items.head!.next!.pItem!.value!.num==3 and
                    first!.next!.next!.pItem!.value!.num==4
        }else if(caseID==2){
            passed <- !handle.failed() and !handle.symbolicValues() and target!.pItem!.isNormed and
                    first!.pItem!.value!.num==1 and first!.next!.pItem!.value!.num==2 and
                    first!.next!.next!.pItem!.value!.num==3 and target!.pItem!.infSize!.num==3
        }else if(caseID==3){
            passed <- !handle.failed() and !handle.symbolicValues() and target!.pItem!.isNormed and
                    target!.pItem!.infSize!.num==1 and first!.next!.pItem!.value!.num==7
        }else if(caseID==4){
            passed <- handle.failed() and !target!.pItem!.isNormed and
                    first!.pItem!.value!.items.head!.pItem!.value!.evalMode==emUnknown and
                    source!.pItem!.value!.items.head!.pItem!.value!.num==7 and
                    !normalizer.access!.hasDirectIdentity(first, source!.pItem!.value!.items.head)
        }else if(caseID==5 or caseID==7){
            passed <- !handle.failed() and !handle.symbolicValues() and target!.pItem!.isNormed and
                    !target!.pItem!.value!.tailUnfinished and target!.pItem!.infSize!.num==3 and
                    first!.pItem!.value!.num==1 and first!.next!.pItem!.value!.num==2 and
                    first!.next!.next!.pItem!.value!.num==3 and target!.pItem!.value!.items.size()==3
        }else if(caseID==6){
            our POV: gap <- first!.next
            passed <- !handle.failed() and !handle.symbolicValues() and target!.pItem!.isNormed and
                    target!.pItem!.infSize!.num==4 and gap!.isSubItm and gap!.pItem!.infSize!.num==2 and
                    !gap!.pItem!.value!.tailUnfinished and gap!.pItem!.value!.items.size()==2 and
                    gap!.pItem!.value!.items.head!.pItem!.value!.num==2 and
                    gap!.pItem!.value!.items.head!.next!.pItem!.value!.num==3 and gap!.next!.pItem!.value!.num==4
        }else if(caseID==8){
            passed <- !handle.failed() and !handle.symbolicValues() and target!.pItem!.isNormed and
                    !source!.pItem!.value!.tailUnfinished and source!.pItem!.value!.items.size()==2 and
                    source!.pItem!.value!.items.head!.pItem!.value!.num==1
        }else if(caseID==9){
            passed <- !handle.failed() and handle.withSubscribers() and !target!.pItem!.isNormed and
                    target!.pItem!.value!.tailUnfinished and target!.pItem!.value!.items.size()==2 and
                    target!.pItem!.infSize!.evalMode==emUnknown and first!.pItem!.value!.num==1 and
                    first!.next!.pItem!.value!.num==2 and first!.pItem!.isNormed
        }else if(caseID==10 or caseID==11){
            our POV: gap1 <- first!.next
            our POV: gap2 <- gap1!.next
            passed <- !handle.failed() and gap1!.pItem!.value!.items.isEmpty() and
                    gap2!.pItem!.value!.items.isEmpty() and first!.pItem!.value!.num==1 and
                    gap2!.next!.pItem!.value!.num==4
            if(caseID==10){passed <- passed and handle.symbolicValues() and !target!.pItem!.isNormed and
                    gap1!.pItem!.value!.tailUnfinished and gap2!.pItem!.value!.tailUnfinished}
            else{passed <- passed and !handle.symbolicValues() and target!.pItem!.isNormed and
                    !gap1!.pItem!.value!.tailUnfinished and !gap2!.pItem!.value!.tailUnfinished}
        }else if(caseID==12 or caseID==13 or caseID==21){
            passed <- !handle.failed() and handle.symbolicValues() and !target!.pItem!.isNormed and
                    normalizer.access!.registry!.identities.isEmpty()
            if(caseID==12){passed <- passed and first!.next!.pItem!.value!.tailUnfinished}
        }else if(caseID==14 or caseID==15){
            passed <- !handle.failed() and handle.symbolicValues() and !target!.pItem!.isNormed and
                    target!.pItem!.value!.tailUnfinished and target!.pItem!.infSize!.num==1000000000 and
                    handle.stepCount()<300
            if(caseID==14){passed <- passed and target!.pItem!.value!.items.isEmpty()}
            else{passed <- passed and target!.pItem!.value!.items.size()==1 and first!.pItem!.value!.num==7}
        }else if(caseID==16 or caseID==17){
            passed <- !handle.failed() and handle.withSubscribers() and target!.pItem!.value!.items.size()==1
            if(caseID==17){handle.cancel()}
            normalizer.addRHS(source, graphParsed(testName, "{*10+1 *10+2}"))
            handle.waitForCompletion()
            if(caseID==16){passed <- passed and !handle.failed() and !handle.symbolicValues() and
                    target!.pItem!.isNormed and target!.pItem!.value!.items.size()==2 and
                    first!.next!.pItem!.value!.num==2 and !target!.pItem!.value!.tailUnfinished}
            else{passed <- passed and handle.cancelled() and target!.pItem!.value!.items.size()==1 and
                    target!.pItem!.value!.tailUnfinished}
        }else if(caseID==18){
            passed <- !handle.failed() and !handle.symbolicValues() and target!.pItem!.isNormed and
                    first!.pItem!.value!.items.head!.pItem!.value!.num==7 and
                    first!.next!.pItem!.value!.num==8 and
                    !(first===source!.pItem!.value!.items.head) and
                    !(first!.pItem===source!.pItem!.value!.items.head!.pItem)
        }else if(caseID==19){
            passed <- !handle.failed() and handle.symbolicValues() and target!.pItem!.value!.items.isEmpty()
            me bool: excluded <- false
            withEach step in range 0 .. handle.stepCount(){
                if(handle.stepDescription(step)=="exclude: Set span alignment"){excluded <- true}
            }
            passed <- passed and excluded
        }else if(caseID==20){
            passed <- !handle.failed() and !handle.symbolicValues() and target!.pItem!.isNormed
            normalizer.addRHS(source!.pItem!.value!.items.head, graphScalar(8, 10))
            handle <- normalizer.normalize(target)
            handle.waitForCompletion()
            passed <- passed and handle.failed() and !target!.pItem!.isNormed and
                    target!.pItem!.value!.items.size()==1
        }else if(caseID==22){
            passed <- !handle.failed() and handle.symbolicValues() and !target!.pItem!.isNormed and
                    first!.pItem!.value!.num==1 and first!.next!.next!.pItem!.value!.num==4 and
                    first!.next!.pItem!.value!.items.isEmpty() and first!.next!.pItem!.value!.tailUnfinished
        }else if(caseID==23){
            passed <- !handle.failed() and handle.symbolicValues() and handle.stepCount()<100
            handle.cancel(); normalizer.close()
            target!.pItem!.value!.items.head!.pItem <- saved
        }else if(caseID==24){passed <- handle.failed() and !target!.pItem!.isNormed}
        else if(caseID==25 or caseID==26){
            passed <- !handle.failed() and handle.symbolicValues() and target!.pItem!.value!.items.isEmpty() and
                    normalizer.access!.registry!.identities.isEmpty() and handle.stepCount()<100
            if(caseID==25){passed <- passed and normalizer.access!.listExtent(target)==9007199254740993}
        }else if(caseID==27){
            passed <- !handle.failed() and !handle.symbolicValues() and target!.pItem!.isNormed and
                    !target!.pItem!.value!.tailUnfinished and target!.pItem!.value!.items.size()==1 and
                    target!.pItem!.infSize!.num==1
        }else if(caseID==28){
            our POV: innerGap <- first!.pItem!.value!.items.head!.next
            passed <- !handle.failed() and !handle.symbolicValues() and target!.pItem!.isNormed and
                    innerGap!.pItem!.value!.items.size()==2 and innerGap!.pItem!.infSize!.num==2 and
                    innerGap!.pItem!.value!.items.head!.pItem!.value!.num==2 and
                    target!.pItem!.infSize!.num==5
        }
        if(!passed){
            print("Graph spans "+toString(caseID)+": "+handle.error()+"\n")
            print("  result: "+toString(target!.pItem)+"\n")
            withEach step in range 0 .. handle.stepCount(){
                print("  "+handle.stepDescription(step)+" cost="+toString(handle.stepCost(step))+"\n")
            }
        }
        normalizer.close()
        me string: actual <- "false"
        me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

// Overlay interpretation is acquired by the same scalar Set as size/value.
#define GRAPHOVERLAY(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphOverlay(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHOVERLAY(unit/graphFoundation/overlay/number, 1)
    GRAPHOVERLAY(unit/graphFoundation/overlay/string, 2)
    GRAPHOVERLAY(unit/graphFoundation/overlay/parsedAny, 3)
    GRAPHOVERLAY(unit/graphFoundation/overlay/numericTypeOnly, 4)
    GRAPHOVERLAY(unit/graphFoundation/overlay/stringTypeOnly, 5)
    GRAPHOVERLAY(unit/graphFoundation/overlay/sizeWithoutType, 6)
    GRAPHOVERLAY(unit/graphFoundation/overlay/throughUnknown, 7)
    GRAPHOVERLAY(unit/graphFoundation/overlay/registry, 8)
    GRAPHOVERLAY(unit/graphFoundation/overlay/knownTypeRetained, 9)
    GRAPHOVERLAY(unit/graphFoundation/overlay/noRoute, 10)
    GRAPHOVERLAY(unit/graphFoundation/overlay/cost, 11)
    GRAPHOVERLAY(unit/graphFoundation/overlay/cancel, 12)
    GRAPHOVERLAY(unit/graphFoundation/overlay/listMember, 13)
    GRAPHOVERLAY(unit/graphFoundation/overlay/openTailMember, 14)
    GRAPHOVERLAY(unit/graphFoundation/overlay/unsetOverlay, 15)

    void: unitTestGraphOverlay(me string: testName, me int: caseID) <- {
        our POV: target <- graphScalar(-1, -1)
        target!.pItem!.value!.overlayType <- tUnknown
        our POV: source <- graphScalar(7, 10)
        if(caseID==2 or caseID==8){source <- graphParsed(testName, "'Hello'")}
        else if(caseID==3){target <- graphParsed(testName, "? = 'Hello'")}
        else if(caseID==4){
            source <- graphScalar(-1, 10)
            target!.pItem!.value!.sizeMode <- fromGiven
            target!.pItem!.value!.numBase <- bHex
        }else if(caseID==5){source <- graphParsed(testName, "*_+$")}
        else if(caseID==6){
            source <- graphScalar(-1, 10)
            source!.pItem!.value!.overlayType <- tUnknown
        }else if(caseID==7 or caseID==12){
            source <- graphScalar(-1, -1)
            source!.pItem!.value!.overlayType <- tUnset
        }else if(caseID==9){
            target <- graphScalar(7, 5)
            source <- graphParsed(testName, "'Hello'")
        }else if(caseID==13){target <- graphParsed(testName, "{?} = {*10+7}")}
        else if(caseID==14){target <- graphParsed(testName, "{...} = {?}")}
        else if(caseID==15){target!.pItem!.value!.overlayType <- tUnset}
        me GraphNormalizer: normalizer
        normalizer.init()
        if(caseID==8){normalizer.recordIdentity(source, target)}
        else if(caseID!=3 and caseID!=10 and caseID!=13 and caseID!=14){normalizer.addRHS(target, source)}
        if(caseID==7){normalizer.addRHS(source, graphScalar(7, 10))}
        me NormalizationHandle: handle
        if(caseID==11){handle <- normalizer.normalizeWithCost(target, 0)}
        else{handle <- normalizer.normalize(target)}
        handle.waitForCompletion()
        me bool: passed <- false
        if(caseID==1 or caseID==2 or caseID==3 or caseID==8 or caseID==15){
            passed <- !handle.failed() and !handle.symbolicValues() and target!.pItem!.isNormed and
                    target!.pItem!.viewMode==vmOverlay and target!.pItem!.value!.evalMode==emLiteral
            if(caseID==1 or caseID==15){
                passed <- passed and target!.pItem!.value!.overlayType==NUM and
                        target!.pItem!.value!.num==7 and target!.pItem!.infSize!.num==10
            }else{
                passed <- passed and target!.pItem!.value!.overlayType==STR and
                        target!.pItem!.value!.str=="Hello" and target!.pItem!.infSize!.num==5
            }
            me int: sets <- 0
            withEach step in range 0 .. handle.stepCount(){
                if(handle.stepDescription(step)=="Set requested size/value/type"){sets <+- 1}
            }
            passed <- passed and sets==1
        }else if(caseID==4){
            passed <- !handle.failed() and handle.symbolicValues() and handle.withSubscribers() and
                    !target!.pItem!.isNormed and target!.pItem!.value!.overlayType==NUM and
                    target!.pItem!.value!.evalMode==emUnknown and target!.pItem!.infSize!.num==10 and
                    target!.pItem!.value!.sizeMode==fromGiven and target!.pItem!.value!.numBase==bHex
            normalizer.addRHS(source, graphScalar(7, 10))
            handle.waitForCompletion()
            passed <- passed and !handle.failed() and !handle.symbolicValues() and
                    target!.pItem!.isNormed and target!.pItem!.value!.num==7
        }else if(caseID==5){
            passed <- !handle.failed() and handle.symbolicValues() and handle.withSubscribers() and
                    !target!.pItem!.isNormed and target!.pItem!.value!.overlayType==STR and
                    target!.pItem!.value!.evalMode==emUnknown and target!.pItem!.infSize!.evalMode==emUnknown
        }else if(caseID==6){
            passed <- !handle.failed() and handle.symbolicValues() and !target!.pItem!.isNormed and
                    target!.pItem!.infSize!.evalMode==emLiteral and target!.pItem!.infSize!.num==10 and
                    target!.pItem!.value!.overlayType==tUnknown and target!.pItem!.value!.evalMode==emUnknown
        }else if(caseID==7){
            passed <- !handle.failed() and !handle.symbolicValues() and target!.pItem!.isNormed and
                    target!.pItem!.value!.overlayType==NUM and target!.pItem!.value!.num==7 and
                    source!.pItem!.value!.overlayType==NUM and source!.pItem!.value!.evalMode==emLiteral and
                    source!.pItem!.value!.num==7 and source!.pItem!.infSize!.num==10
        }else if(caseID==9){
            passed <- handle.failed() and !target!.pItem!.isNormed and
                    target!.pItem!.value!.overlayType==NUM and target!.pItem!.value!.num==7 and
                    target!.pItem!.wrkList.size()==1 and !normalizer.access!.hasDirectIdentity(target, source)
        }else if(caseID==10 or caseID==11 or caseID==12){
            passed <- !handle.failed() and handle.symbolicValues() and handle.withSubscribers() and
                    !target!.pItem!.isNormed and target!.pItem!.value!.overlayType==tUnknown and
                    target!.pItem!.value!.evalMode==emUnknown
            if(caseID==12){
                handle.cancel()
                normalizer.addRHS(source, graphScalar(7, 10))
                handle.waitForCompletion()
                passed <- passed and handle.cancelled() and target!.pItem!.value!.overlayType==tUnknown
            }
        }else if(caseID==13 or caseID==14){
            our POV: member <- target!.pItem!.value!.items.head
            passed <- member!=NULL
            if(caseID==14){
                our POV: origin <- target!.pItem!.wrkList[0]!.pItem!.value!.items.head
                passed <- passed and handle.symbolicValues() and !target!.pItem!.isNormed and
                        member!.pItem!==origin!.pItem and member!.pItem!.value!.overlayType==tUnknown
                normalizer.addRHS(origin, graphScalar(7, 10))
                handle.waitForCompletion()
            }
            passed <- passed and !handle.failed() and !handle.symbolicValues() and target!.pItem!.isNormed and
                    member!.pItem!.isNormed and member!.pItem!.value!.overlayType==NUM and
                    member!.pItem!.value!.num==7 and member!.pItem!.infSize!.num==10
        }
        if(!passed){
            print("Graph overlay "+toString(caseID)+": "+handle.error()+"\n")
            print("  result: "+toString(target!.pItem)+"\n")
        }
        normalizer.close()
        me string: actual <- "false"
        me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHEXPR(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphExpression(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHEXPR(unit/graphFoundation/expressions/computedSize, 1)
    GRAPHEXPR(unit/graphFoundation/expressions/computedListSize, 2)
    GRAPHEXPR(unit/graphFoundation/expressions/strings, 3)
    GRAPHEXPR(unit/graphFoundation/expressions/numeric, 4)
    GRAPHEXPR(unit/graphFoundation/expressions/nestedNumeric, 5)
    GRAPHEXPR(unit/graphFoundation/expressions/lists, 6)
    GRAPHEXPR(unit/graphFoundation/expressions/nestedLists, 7)
    GRAPHEXPR(unit/graphFoundation/expressions/rhs, 8)
    GRAPHEXPR(unit/graphFoundation/expressions/subscription, 9)
    GRAPHEXPR(unit/graphFoundation/expressions/computedSubscription, 10)
    GRAPHEXPR(unit/graphFoundation/expressions/openPrefix, 11)
    GRAPHEXPR(unit/graphFoundation/expressions/cost, 12)
    GRAPHEXPR(unit/graphFoundation/expressions/sizeConflict, 13)
    GRAPHEXPR(unit/graphFoundation/expressions/negativeSize, 14)
    GRAPHEXPR(unit/graphFoundation/expressions/mixed, 15)
    GRAPHEXPR(unit/graphFoundation/expressions/laterConflict, 16)
    GRAPHEXPR(unit/graphFoundation/expressions/sparseSize, 17)

    void: unitTestGraphExpression(me string: testName, me int: caseID) <- {
        me string: input
        if(caseID==1){input <- "*(10)+5"}
        else if(caseID==2){input <- "*(3)+{...} = {*10+1 *10+2 *10+3}"}
        else if(caseID==3){input <- "('Hello' ' world')"}
        else if(caseID==4){input <- "(*8+4 *4+3)"}
        else if(caseID==5){input <- "((*5+2 *6+3 (*7+4 *8+5 (*9+6 *10+7) *1+8)))"}
        else if(caseID==6){input <- "({*10+1 *10+2} {} {*10+3})"}
        else if(caseID==7){input <- "(({*10+1} ({} {*10+2})))"}
        else if(caseID==8){input <- "*_+$ = ('Hello' ' world')"}
        else if(caseID==9){input <- "(*10+_ *10+2)"}
        else if(caseID==10){input <- "*(_)+5"}
        else if(caseID==11){input <- "({*10+1} {*10+2 ...})"}
        else if(caseID==12){input <- "({*10+1 *10+2 *10+3 *10+4})"}
        else if(caseID==13){input <- "*4+(*8+4 *4+3)"}
        else if(caseID==14){input <- "*(-1)+5"}
        else if(caseID==15){input <- "('Hello' *10+7)"}
        else if(caseID==16){input <- "(*10+1 *10+2)"}
        else if(caseID==17){input <- "*(1000000000)+{item| ...}"}

        our POV: target <- graphParsed(testName, input)
        if(target!.pItem==NULL){FAIL("Expression fixture syntax: "+input)}
        our POV: original
        if(caseID==9 or caseID==16){original <- target!.pItem!.value!.items.head}
        if(caseID==10){original <- target!.pItem!.infSize!.items.head}
        me GraphNormalizer: normalizer
        normalizer.init()
        me NormalizationHandle: handle
        if(caseID==12){handle <- normalizer.normalizeWithCost(target, 8)}
        else if(caseID==17){handle <- normalizer.findItem(target, 999999999)}
        else{handle <- normalizer.normalize(target)}
        handle.waitForCompletion()
        me bool: passed <- !handle.failed()
        if(caseID==1){
            passed <- passed and !handle.symbolicValues() and target!.pItem!.isNormed and
                    target!.pItem!.infSize!.num==10 and target!.pItem!.infSize!.evalMode==emLiteral and
                    target!.pItem!.sizeExpression!=NULL and toString(target!.pItem)=="*10+5"
        }else if(caseID==2 or caseID==6 or caseID==7){
            me int: expectedCount <- 3
            if(caseID==7){expectedCount <- 2}
            passed <- passed and !handle.symbolicValues() and target!.pItem!.isNormed and
                    target!.pItem!.value!.items.size()==expectedCount and target!.pItem!.infSize!.num==expectedCount and
                    target!.pItem!.value!.items.head!.pItem!.value!.num==1
            if(caseID!=2){passed <- passed and target!.pItem!.valueExpression!=NULL}
        }else if(caseID==3 or caseID==8){
            passed <- passed and !handle.symbolicValues() and target!.pItem!.isNormed and
                    target!.pItem!.value!.str=="Hello world" and target!.pItem!.infSize!.num==11
        }else if(caseID==4 or caseID==5){
            me int: number <- 19; me int: size <- 32
            if(caseID==5){number <- 79005; size <- 151200}
            passed <- passed and !handle.symbolicValues() and target!.pItem!.isNormed and
                    target!.pItem!.value!.num==number and target!.pItem!.infSize!.num==size and
                    target!.pItem!.value!.sizeMode==fromGiven
        }else if(caseID==9 or caseID==10){
            passed <- passed and handle.symbolicValues() and handle.withSubscribers() and !target!.pItem!.isNormed
            if(caseID==9){normalizer.addRHS(original, graphScalar(1, 10))}
            else{normalizer.addRHS(original, graphScalar(10, -1))}
            handle.waitForCompletion()
            passed <- passed and !handle.failed() and !handle.symbolicValues() and target!.pItem!.isNormed
            if(caseID==9){passed <- passed and target!.pItem!.value!.num==12 and target!.pItem!.infSize!.num==100}
            else{passed <- passed and target!.pItem!.infSize!.num==10}
        }else if(caseID==11){
            passed <- passed and handle.symbolicValues() and !target!.pItem!.isNormed and
                    target!.pItem!.value!.evalMode==emLiteral and target!.pItem!.value!.tailUnfinished and
                    target!.pItem!.value!.items.size()==2 and target!.pItem!.value!.items.head!.pItem!.value!.num==1
            our POV: tail <- target!.pItem!.valueExpression!.items.tail
            normalizer.addRHS(tail, graphParsed(testName, "{*10+2 *10+3}"))
            handle.waitForCompletion()
            passed <- passed and !handle.failed() and !handle.symbolicValues() and target!.pItem!.isNormed and
                    target!.pItem!.value!.items.size()==3 and target!.pItem!.value!.items.tail!.pItem!.value!.num==3
        }else if(caseID==12 or caseID==13 or caseID==14 or caseID==15){
            passed <- passed and handle.symbolicValues() and !target!.pItem!.isNormed
            if(caseID==14){passed <- passed and target!.pItem!.infSize!.evalMode==emConcat}
            else{passed <- passed and target!.pItem!.value!.evalMode==emConcat and target!.pItem!.valueExpression==NULL}
        }else if(caseID==16){
            passed <- passed and !handle.symbolicValues() and target!.pItem!.isNormed and
                    original!.pItem!.value!.num==1 and target!.pItem!.value!.num==12
            normalizer.addRHS(original, graphScalar(8, 10))
            handle <- normalizer.normalize(target); handle.waitForCompletion()
            passed <- passed and handle.failed() and !target!.pItem!.isNormed and target!.pItem!.valueExpression!=NULL
        }else if(caseID==17){
            passed <- passed and !handle.symbolicValues() and handle.result()!=NULL and
                    handle.result()!.implicitItem.sourceIndex==999999999 and target!.pItem!.value!.items.isEmpty() and
                    target!.repetitionSpan.family!.occurrences.size()==1 and target!.pItem!.infSize!.num==1000000000
        }
        if(!passed){print("Expression "+toString(caseID)+": "+handle.error()+"\n  "+toString(target!.pItem)+"\n")}
        normalizer.close()
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHADOPT(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphAdoption(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHADOPT(unit/graphFoundation/adoption/closed, 1)
    GRAPHADOPT(unit/graphFoundation/adoption/empty, 2)
    GRAPHADOPT(unit/graphFoundation/adoption/open, 3)
    GRAPHADOPT(unit/graphFoundation/adoption/nested, 4)
    GRAPHADOPT(unit/graphFoundation/adoption/transitive, 5)
    GRAPHADOPT(unit/graphFoundation/adoption/registry, 6)
    GRAPHADOPT(unit/graphFoundation/adoption/subscription, 7)
    GRAPHADOPT(unit/graphFoundation/adoption/billion, 8)
    GRAPHADOPT(unit/graphFoundation/adoption/cost, 9)
    GRAPHADOPT(unit/graphFoundation/adoption/knownTargetThroughUnknown, 10)
    GRAPHADOPT(unit/graphFoundation/adoption/concat, 11)

    void: unitTestGraphAdoption(me string: testName, me int: caseID) <- {
        me string: input
        if(caseID==1){input <- "? = {*10+1 *10+2}"}
        else if(caseID==2){input <- "? = {}"}
        else if(caseID==3){input <- "? = {*10+1 ...}"}
        else if(caseID==4){input <- "? = {{*10+7} *10+8}"}
        else if(caseID==5){input <- "?"}
        else if(caseID==6){input <- "?"}
        else if(caseID==7){input <- "? = {...}"}
        else if(caseID==8){input <- "? = *1000000000+{...}"}
        else if(caseID==9){input <- "? = {*10+1 *10+2 *10+3 *10+4}"}
        else if(caseID==10){input <- "{*10+_ *10+_}"}
        else if(caseID==11){input <- "? = ({*10+1} {*10+2})"}

        our POV: target <- graphParsed(testName, input)
        our POV: source
        our POV: middle
        me GraphNormalizer: normalizer
        normalizer.init()
        if(caseID==5 or caseID==10){
            middle <- graphParsed(testName, "?")
            source <- graphParsed(testName, "{*10+1 *10+2}")
            normalizer.addRHS(target, middle); normalizer.addRHS(middle, source)
        }else if(caseID==6){
            source <- graphParsed(testName, "{*10+1 *10+2}")
            normalizer.recordIdentity(source, target)
        }else{source <- target!.pItem!.wrkList[0]}
        me NormalizationHandle: handle
        if(caseID==9){handle <- normalizer.normalizeWithCost(target, 5)}
        else{handle <- normalizer.normalize(target)}
        handle.waitForCompletion()
        me bool: passed <- !handle.failed() and target!.pItem!.value!.overlayType==LST
        if(caseID==3 or caseID==7 or caseID==8 or caseID==9){
            passed <- passed and handle.symbolicValues() and !target!.pItem!.isNormed and
                    target!.pItem!.value!.tailUnfinished
            if(caseID==3){passed <- passed and target!.pItem!.value!.items.size()==1}
            else{passed <- passed and target!.pItem!.value!.items.isEmpty()}
            if(caseID==8){passed <- passed and target!.pItem!.infSize!.num==1000000000 and handle.stepCount()<100}
            if(caseID==7){
                normalizer.addRHS(source, graphParsed(testName, "{*10+1 *10+2}"))
                handle.waitForCompletion()
                passed <- passed and !handle.failed() and !handle.symbolicValues() and
                        target!.pItem!.isNormed and target!.pItem!.value!.items.size()==2
            }
        }else{
            passed <- passed and !handle.symbolicValues() and target!.pItem!.isNormed and
                    !target!.pItem!.value!.tailUnfinished
            if(caseID==2){passed <- passed and target!.pItem!.value!.items.isEmpty() and target!.pItem!.infSize!.num==0}
            else{
                passed <- passed and target!.pItem!.value!.items.size()==2 and target!.pItem!.infSize!.num==2 and
                        target!.pItem!.value!.items.head!.pItem!==source!.pItem!.value!.items.head!.pItem
                if(caseID==4){passed <- passed and target!.pItem!.value!.items.head!.pItem!.value!.items.head!.pItem!.value!.num==7}
                else{passed <- passed and target!.pItem!.value!.items.head!.pItem!.value!.num==1}
            }
            if(middle!=NULL){passed <- passed and middle!.pItem!.value!.evalMode==emUnknown}
        }
        if(!passed){print("Adoption "+toString(caseID)+": "+handle.error()+"\n  "+toString(target!.pItem)+"\n")}
        normalizer.close()
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHSELECT(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphSelection(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHSELECT(unit/graphFoundation/selection/last, 1)
    GRAPHSELECT(unit/graphFoundation/selection/marked, 2)
    GRAPHSELECT(unit/graphFoundation/selection/markedOpen, 3)
    GRAPHSELECT(unit/graphFoundation/selection/embeddedLast, 4)
    GRAPHSELECT(unit/graphFoundation/selection/first, 5)
    GRAPHSELECT(unit/graphFoundation/selection/listResult, 6)
    GRAPHSELECT(unit/graphFoundation/selection/markedList, 7)
    GRAPHSELECT(unit/graphFoundation/selection/rhs, 8)
    GRAPHSELECT(unit/graphFoundation/selection/outerConstraint, 9)
    GRAPHSELECT(unit/graphFoundation/selection/subscription, 10)
    GRAPHSELECT(unit/graphFoundation/selection/cancel, 11)
    GRAPHSELECT(unit/graphFoundation/selection/openEnd, 12)
    GRAPHSELECT(unit/graphFoundation/selection/firstOpenSpan, 13)
    GRAPHSELECT(unit/graphFoundation/selection/lastOpenSpan, 14)
    GRAPHSELECT(unit/graphFoundation/selection/cost, 15)
    GRAPHSELECT(unit/graphFoundation/selection/empty, 16)
    GRAPHSELECT(unit/graphFoundation/selection/alternatives, 17)
    GRAPHSELECT(unit/graphFoundation/selection/laterConflict, 18)
    GRAPHSELECT(unit/graphFoundation/selection/outerSizeConstraint, 19)
    GRAPHSELECT(unit/graphFoundation/selection/embeddedCycle, 20)
    GRAPHSELECT(unit/graphFoundation/selection/knownEnd, 21)
    GRAPHSELECT(unit/graphFoundation/selection/extentConflict, 22)

    void: unitTestGraphSelection(me string: testName, me int: caseID) <- {
        me string: input
        if(caseID==1){input <- "[? *10+7]"}
        else if(caseID==2){input <- "[? <*10+7> ?]"}
        else if(caseID==3){input <- "[? <*10+7> ...]"}
        else if(caseID==4){input <- "[*10+1 &{*10+2 &{*10+7}} &{}]"}
        else if(caseID==5){input <- "[&{} &{*10+7 *10+2} ?]"}
        else if(caseID==6){input <- "[? {*10+7 *10+8}]"}
        else if(caseID==7){input <- "[<{*10+7 *10+8}> ?]"}
        else if(caseID==8){input <- "*_+_ = [? *10+7]"}
        else if(caseID==9){input <- "[? *_+_] = *10+7"}
        else if(caseID==10){input <- "[? *_+_]"}
        else if(caseID==11){input <- "[? *_+_]"}
        else if(caseID==12){input <- "[*10+1 ...]"}
        else if(caseID==13){input <- "[&{...} *10+9]"}
        else if(caseID==14){input <- "[*10+1 &*3+{*10+2 ...}]"}
        else if(caseID==15){input <- "[? *10+7]"}
        else if(caseID==16){input <- "[]"}
        else if(caseID==17){input <- "*_+[*10+1 *10+2]"}
        else if(caseID==18){input <- "[? *10+7]"}
        else if(caseID==19){input <- "[? *10+7]"}
        else if(caseID==20){input <- "[&{}]"}
        else if(caseID==21){input <- "*1+[*10+7 ...]"}
        else if(caseID==22){input <- "*3+[*10+1 *10+7]"}

        our POV: target <- graphParsed(testName, input)
        if(target!.pItem==NULL){FAIL("Selection fixture syntax: "+input)}
        our infonView: inner <- target!.pItem!.innr
        if(caseID==8){inner <- target!.pItem!.wrkList[0]!.pItem!.innr}
        our POV: first <- inner!.value!.items.head
        our POV: last <- inner!.value!.items.tail
        if(caseID==5 or caseID==13){target!.pItem!.intersectPos <- ipGetFirst}
        if(caseID==19){
            // FlexNum's native int constructor controls formatting; an int64
            // assignment supplies a numeric value for this independent constraint.
            me int64: constrainedSize <- 11
            target!.pItem!.infSize!.evalMode <- emLiteral
            target!.pItem!.infSize!.num <- constrainedSize
        }
        our infonView: saved
        if(caseID==20){saved <- first!.pItem; first!.pItem <- target!.pItem}
        me GraphNormalizer: normalizer
        normalizer.init()
        me NormalizationHandle: handle
        if(caseID==15){handle <- normalizer.normalizeWithCost(target, 1)}
        else{handle <- normalizer.normalize(target)}
        handle.waitForCompletion()
        me bool: passed <- !handle.failed()
        if(caseID<=9 or caseID==18 or caseID==21){
            passed <- passed and !handle.symbolicValues() and target!.pItem!.isNormed
            if(caseID==6 or caseID==7){
                passed <- passed and target!.pItem!.value!.overlayType==LST and
                        target!.pItem!.value!.items.size()==2 and target!.pItem!.value!.items.head!.pItem!.value!.num==7 and
                        target!.pItem!.value!.items.head!.pItem!==target!.pItem!.selectedResult!.pItem!.value!.items.head!.pItem
            }else{passed <- passed and target!.pItem!.value!.num==7 and target!.pItem!.infSize!.num==10}
            if(caseID==1 or caseID==2 or caseID==3){
                passed <- passed and first!.pItem!.value!.evalMode==emUnknown and !first!.pItem!.isNormed and
                        target!.pItem!.selectionExpression===inner and target!.pItem!.innr==NULL
            }
            if(caseID==18){
                normalizer.addRHS(last, graphScalar(8, 10))
                handle <- normalizer.normalize(target); handle.waitForCompletion()
                passed <- passed and handle.failed() and !target!.pItem!.isNormed and target!.pItem!.selectionExpression!=NULL
            }
        }else if(caseID==10 or caseID==11){
            passed <- passed and handle.symbolicValues() and handle.withSubscribers() and !target!.pItem!.isNormed
            if(caseID==11){handle.cancel()}
            normalizer.addRHS(last, graphScalar(7, 10)); handle.waitForCompletion()
            if(caseID==11){passed <- passed and handle.cancelled() and target!.pItem!.value!.evalMode==emUnknown}
            else{passed <- passed and !handle.failed() and !handle.symbolicValues() and
                    target!.pItem!.isNormed and target!.pItem!.value!.num==7}
        }else if(caseID==13 or caseID==14){
            passed <- passed and handle.symbolicValues() and target!.pItem!.selectedResult==NULL and
                    target!.pItem!.value!.evalMode==emIntersection
            if(caseID==13){normalizer.addRHS(first, graphParsed(testName, "{*10+7}"))}
            else{normalizer.addRHS(last, graphParsed(testName, "{*10+2 *10+3 *10+7}"))}
            handle.waitForCompletion()
            passed <- passed and !handle.failed() and !handle.symbolicValues() and target!.pItem!.isNormed and
                    target!.pItem!.value!.num==7
        }else if(caseID==19){
            passed <- handle.failed() and !target!.pItem!.isNormed and target!.pItem!.infSize!.num==11 and
                    last!.pItem!.infSize!.num==10 and last!.pItem!.value!.num==7
        }else{
            passed <- passed and handle.symbolicValues() and !target!.pItem!.isNormed and
                    target!.pItem!.selectedResult==NULL and target!.pItem!.value!.evalMode==emIntersection and
                    handle.stepCount()<100
        }
        if(!passed){
            print("Selection "+toString(caseID)+": "+handle.error()+"\n  "+toString(target!.pItem)+"\n")
            print("size="+target!.pItem!.infSize!.num.stringify()+" symbolic="+toString(handle.symbolicValues())+
                  " normed="+toString(target!.pItem!.isNormed)+"\n")
            withEach step in range 0 .. handle.stepCount(){print(handle.stepDescription(step)+"\n")}
        }
        handle.cancel(); normalizer.close()
        if(caseID==20){first!.pItem <- saved}
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}


struct GraphLifecycleCore: inherits=ProteusCore {
    me Mutex: repliesMutex
    me List<string>: replies
    me uint64: replyOriginID
    me uint64: replyOffset
    void: submitProteusResult(me uint64: originID, me uint64: pos, me string: mesg) <- {
        protect(repliesMutex){replies.append(mesg); replyOriginID <- originID; replyOffset <- pos}
    }
    me int: replyCount() <- {protect(repliesMutex){return(replies.size())}}
    me string: replyAt(me int: itemIndex) <- {protect(repliesMutex){return(replies[itemIndex])}}
    me bool: waitForReplies(me int: count) <- {
        withEach attempt in range 0 .. 200{
            if(replyCount()>=count){return(true)}
            sleep(5)
        }
        return(false)
    }
}
struct GraphMemoryConnector: inherits=InfonConnector {
    void: pumpInputBuff() <- {
        inputBuf.putStr("{'loader'>>}")
        inputEOF <- true; inputBuf.close()
    }
    bool: pumpOutputBuf(me string: mesg) <- {return(true)}
}
struct GraphInputTestThread: inherits=Threads {
    our ProteusParser: parser
    our infonView: target
    void: run() <- {parser!.doParse(target)}
}
#define GRAPHENTRY(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphEntry(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHENTRY(unit/graphEntry/handle, 1)
    GRAPHENTRY(unit/graphEntry/query, 2)
    GRAPHENTRY(unit/graphEntry/registry, 3)
    GRAPHENTRY(unit/graphEntry/subscription, 4)
    GRAPHENTRY(unit/graphEntry/shutdown, 5)
    GRAPHENTRY(unit/graphEntry/failure, 6)
    GRAPHENTRY(unit/graphEntry/reply, 7)
    GRAPHENTRY(unit/graphEntry/stream, 8)
    GRAPHENTRY(unit/graphEntry/nestedStream, 9)
    GRAPHENTRY(unit/graphEntry/cancelStream, 10)
    GRAPHENTRY(unit/graphEntry/splitReply, 11)
    GRAPHENTRY(unit/graphEntry/parseFailure, 12)
    GRAPHENTRY(unit/graphEntry/nestedReplies, 13)
    GRAPHENTRY(unit/graphEntry/streamLoader, 14)
    GRAPHENTRY(unit/graphEntry/bufferedLoader, 15)
    GRAPHENTRY(unit/graphEntry/streamIndex, 16)
    GRAPHENTRY(unit/graphEntry/closedStreamReplies, 17)

    void: unitTestGraphEntry(me string: testName, me int: caseID) <- {
        me GraphLifecycleCore: core
        core.init("", false)
        me bool: passed <- true
        me NormalizationHandle: handle
        our POV: target <- graphParsed(testName, "? = *10+7")
        if(caseID==1){
            handle <- core.agent!.normalize(target); handle.waitForCompletion()
            passed <- !handle.failed() and !handle.symbolicValues() and target!.pItem!.isNormed and
                    target!.pItem!.value!.num==7 and target!.identityRegistry===core.agent!.identityRegistry
            me bool: sawSet <- false
            withEach step in range 0 .. handle.stepCount(){
                if(handle.stepDescription(step)=="Set requested size/value/type"){sawSet <- true}
            }
            passed <- passed and sawSet
        }else if(caseID==2){
            our infonView: result <- core.query("[? ('hel' 'lo')]", false)
            passed <- result!=NULL and result!.value!.str=="hello" and result!.isNormed
        }else if(caseID==3){
            our POV: source <- graphScalar(7, 10)
            target <- graphParsed(testName, "?")
            core.agent!.graphNormalizer.recordIdentity(target, source)
            handle <- core.agent!.normalize(source); handle.waitForCompletion()
            handle <- core.agent!.normalize(target); handle.waitForCompletion()
            passed <- !handle.symbolicValues() and target!.pItem!.value!.num==7 and
                    source!.identityRegistry===target!.identityRegistry
        }else if(caseID==4 or caseID==5){
            target <- graphParsed(testName, "?")
            core.agent!.normalizeAndWait(target)
            passed <- core.agent!.retainedNormalizations.size()==1
            handle <- core.agent!.retainedNormalizations[0]
            if(caseID==4){
                core.agent!.graphNormalizer.addRHS(target, graphScalar(7, 10))
                handle.waitForCompletion()
                passed <- passed and !handle.symbolicValues() and target!.pItem!.value!.num==7
            }else{
                core.deInit(); handle.waitForCompletion()
                passed <- passed and handle.cancelled() and !handle.withSubscribers()
            }
        }else if(caseID==6){
            target <- graphParsed(testName, "*10+7 = *10+8")
            core.agent!.normalizeAndWait(target)
            passed <- core.agent!.errorStatus!=0 and core.agent!.errorMesg!="" and !target!.pItem!.isNormed
        }else if(caseID==17){
            // Start a subscribed normalizer before parsing a fully buffered
            // document. Batched publication must deliver every reply once.
            Allocate(target!.pItem)
            target!.pItem!.streamState <- parseStarted
            handle <- core.agent!.normalize(target); handle.waitForCompletion()
            passed <- handle.withSubscribers()
            me ProteusParser: bufferedParser{core, true, 17}
            bufferedParser.initParseFromString(testName, "{'a'>> 'ok'>>}")
            bufferedParser.doParse(target!.pItem)
            handle.waitForCompletion()
            core.agent!.normalizeAndWait(target)
            passed <- passed and !bufferedParser.doesParseHaveError() and !handle.failed() and
                    target!.pItem!.isNormed and core.replyCount()==2 and
                    core.replyAt(0)=="'a'" and core.replyAt(1)=="'ok'" and core.replyOriginID==17
        }else if(caseID==7 or caseID==13){
            me string: replyInput <- "{7>> 'ok'>>}"
            if(caseID==13){replyInput <- "{{7>> 'ok'>>}>>}"}
            me ProteusParser: replyParser{core, false, 17}
            replyParser.initParseFromString(testName, replyInput)
            Allocate(target!.pItem)
            replyParser.doParse(target!.pItem)
            core.agent!.normalizeAndWait(target)
            core.agent!.normalizeAndWait(target)
            me int: expectedReplies <- 2
            if(caseID==13){expectedReplies <- 3}
            passed <- core.replyCount()==expectedReplies and core.replyAt(0)=="7" and core.replyAt(1)=="'ok'"
            if(caseID==13){passed <- passed and core.replyAt(2)=="{7 'ok'}"}
        }else if(caseID==14 or caseID==15){
            our GraphMemoryConnector:: connector
            Allocate(connector!.streamSpec)
            connector!.streamSpec!.setSpec("memory:///graph-entry")
            connector!.allowStreamingNormalize <- caseID==14
            our infonView:: top
            our ProteusParser:: parser{core, true, 23}
            me InfonStream: stream
            stream.init(connector, core.agent, parser, top, 23)
            stream.start("graph-loader")
            stream.waitForCompletion(); stream.waitForCompletion()
            passed <- !stream.normerThread.handle.failed() and top!.isNormed and
                    top!.value!.items.head!.pItem!.value!.str=="loader" and
                    core.replyCount()==1 and core.replyAt(0)=="'loader'" and core.replyOriginID==23
            stream.requestFinish()
        }else{
            me strBuf: input
            input.init(testName)
            our infonView:: top
            top!.originID <- 17
            me ThreadedNormalizer: normalizer
            normalizer.init(core.agent, top)
            our ProteusParser:: parser{core, true, 17}
            parser!.initParseFromStream(input)
            me GraphInputTestThread: parsing
            parsing.parser <- parser; parsing.target <- top
            normalizer.start("graph-entry-normalize")
            parsing.start("graph-entry-parse")
            if(caseID==9){input.putStr("{| { 'a'>> ")}
            else if(caseID==11){input.putStr("{| 'a'>")}
            else if(caseID==12){input.putStr("{| @bad ")}
            else{input.putStr("{| 'a'>> ")}
            if(caseID==11){
                sleep(30)
                passed <- core.replyCount()==0
                input.putStr("> ")
            }
            if(caseID!=12){passed <- core.waitForReplies(1) and passed}
            me NormalizationHandle: indexed
            if(caseID==16){
                indexed <- core.agent!.graphNormalizer.findItem(normalizer.pov, 0)
                indexed.waitForCompletion()
                passed <- passed and indexed.symbolicValues() and indexed.result()==NULL
            }
            if(caseID==10){normalizer.cancel()}
            if(caseID!=12){input.putStr("'b'>> ")}
            if(caseID!=10 and caseID!=12){passed <- core.waitForReplies(2) and passed}
            if(caseID==9){
                input.putStr("}>> ")
                passed <- core.waitForReplies(3) and passed
            }
            input.putStr("}"); input.close()
            parsing.waitForExit(); normalizer.waitForExit()
            handle <- normalizer.handle
            if(caseID==16){
                indexed.waitForCompletion()
                passed <- passed and !indexed.failed() and indexed.result()!=NULL and
                        indexed.result()!.pItem!.value!.str=="a"
            }
            if(caseID==12){passed <- parser!.doesParseHaveError() and handle.failed()}
            else if(caseID==10){passed <- passed and handle.cancelled() and core.replyCount()==1}
            else{
                me int: expectedReplies <- 2
                if(caseID==9){expectedReplies <- 3}
                passed <- passed and !handle.failed() and core.replyCount()==expectedReplies and
                        core.replyOriginID==17 and core.replyAt(0)=="'a'" and core.replyAt(1)=="'b'"
                if(caseID==9){passed <- passed and core.replyAt(2)=="{'a' 'b'}"}
            }
        }
        if(!passed){
            print("Graph entry "+toString(caseID)+": "+handle.error()+" replies="+toString(core.replyCount())+"\n")
            withEach itemIndex in range 0 .. core.replyCount(){print(core.replyAt(itemIndex)+"\n")}
        }
        handle.cancel()
        if(caseID!=5){core.deInit()}
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

// Deterministic producer milestones exercise the same publication boundary as
// the parser. The streaming harness separately drives real character input.
struct GraphPrefixFixture {
    our POV: source
    our POV: target
    our POV: unfinished
    me int: caseID
    void: finishInput() <- {
            source!.pItem!.streamState <- parseDone
            unfinished!.pItem!.streamState <- parseDone
            if(caseID==10){source!.pItem!.orderMode <- uUnordered}
            if(caseID==11){Allocate(source!.pItem!.funcArgs)}
            if(caseID==14){source!.pItem!.graphParseError <- "incomplete stream fixture"}
            if(caseID==15){
                our POV: extra <- graphParsed("late stream constraint", "{*10+9 *10+2 *10+3}")
                source!.pItem!.addPOVToWrkList(extra)
            }
    }
    void: publish(their GraphNormalizer: normalizer) <- <%{
        normalizer->runtime.update([&] { finishInput(); });
    }%>
}
#define GRAPHSTREAM(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphStream(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHSTREAM(unit/graphStream/transitive, 16)
    GRAPHSTREAM(unit/graphStream/registry, 17)
    GRAPHSTREAM(unit/graphStream/memberSubscription, 18)
    GRAPHSTREAM(unit/graphStream/freshHandle, 19)
    GRAPHSTREAM(unit/graphStream/typedUnknown, 1)
    GRAPHSTREAM(unit/graphStream/unknownOverlay, 2)
    GRAPHSTREAM(unit/graphStream/existingPrefix, 3)
    GRAPHSTREAM(unit/graphStream/readOnlySource, 4)
    GRAPHSTREAM(unit/graphStream/cancel, 5)
    GRAPHSTREAM(unit/graphStream/cost, 6)
    GRAPHSTREAM(unit/graphStream/embedded, 7)
    GRAPHSTREAM(unit/graphStream/nested, 8)
    GRAPHSTREAM(unit/graphStream/billionTail, 9)
    GRAPHSTREAM(unit/graphStream/reinterpretation, 10)
    GRAPHSTREAM(unit/graphStream/postfix, 11)
    GRAPHSTREAM(unit/graphStream/conflict, 12)
    GRAPHSTREAM(unit/graphStream/looseUntilClosed, 13)
    GRAPHSTREAM(unit/graphStream/parseFailure, 14)
    GRAPHSTREAM(unit/graphStream/lateConstraint, 15)

    void: unitTestGraphStream(me string: testName, me int: caseID) <- {
        me GraphPrefixFixture: fixture
        fixture.caseID <- caseID
        me string: sourceText <- "{*10+1 *10+2 *10+3}"
        me string: targetText <- "?"
        if(caseID==3){targetText <- "{*_+_ ...}"}
        if(caseID==4){targetText <- "{*10+1 *10+2 *10+3 *10+4}"}
        if(caseID==7){sourceText <- "{&{*10+1 *10+2} *10+3}"}
        if(caseID==8){sourceText <- "{{*10+1 *10+2} *10+3}"}
        if(caseID==9){sourceText <- "*1000000000+{*10+1 *10+2 ...}"}
        if(caseID==18){sourceText <- "{*_+_ *10+2 *10+3}"}
        if(caseID==12){targetText <- "{*10+9 ...}"}
        fixture.source <- graphParsed(testName, sourceText)
        fixture.target <- graphParsed(testName, targetText)
        if(caseID==1){fixture.target!.pItem!.value!.overlayType <- LST; fixture.target!.pItem!.viewMode <- vmOverlay}
        fixture.source!.pItem!.streamState <- parseListReady
        fixture.unfinished <- fixture.source!.pItem!.value!.items.head!.next
        fixture.unfinished!.pItem!.streamState <- parseStarted
        if(caseID==13){fixture.source!.looseMode <- true}
        me int: originalCount <- fixture.source!.pItem!.value!.items.size()
        me GraphNormalizer: normalizer
        normalizer.init()
        if(caseID==16){
            our POV: middle <- graphParsed(testName, "?")
            normalizer.addRHS(fixture.target, middle)
            normalizer.addRHS(middle, fixture.source)
        }else if(caseID==17){normalizer.recordIdentity(fixture.target, fixture.source)}
        else{normalizer.addRHS(fixture.target, fixture.source)}
        me NormalizationHandle: handle
        if(caseID==6){handle <- normalizer.normalizeWithCost(fixture.target, 1)}
        else{handle <- normalizer.normalize(fixture.target)}
        handle.waitForCompletion()
        me bool: passed <- !handle.failed() and handle.symbolicValues() and handle.withSubscribers() and
                !fixture.target!.pItem!.isNormed and fixture.source!.pItem!.value!.items.size()==originalCount and
                fixture.unfinished!.pItem!.streamState==parseStarted and
                !fixture.source!.pItem!.value!.tailUnfinished
        if(caseID==9){passed <- !handle.failed() and handle.symbolicValues() and handle.withSubscribers()}
        if(caseID==12){passed <- handle.failed() and !fixture.target!.pItem!.isNormed}
        else if(caseID==6 or caseID==13){
            passed <- passed and fixture.target!.pItem!.value!.items.size()==0
        }else{
            me int: expectedCount <- 1
            if(caseID==4){expectedCount <- 4}
            if(caseID==7){expectedCount <- 2}
            passed <- passed and fixture.target!.pItem!.value!.evalMode==emLiteral and
                    fixture.target!.pItem!.value!.items.size()==expectedCount
            if(caseID!=4){passed <- passed and fixture.target!.pItem!.value!.tailUnfinished and
                    fixture.target!.pItem!.infSize!.evalMode==emUnknown}
            our POV: first <- fixture.target!.pItem!.value!.items.head
            passed <- passed and first!=NULL and first!.pItem!==fixture.source!.pItem!.value!.items.head!.pItem
            if(first!=NULL and caseID!=8 and caseID!=18){passed <- passed and first!.pItem!.value!.num==1}
            if(first!=NULL and caseID==18){passed <- passed and first!.pItem!.value!.evalMode==emUnknown}
            if(first!=NULL and caseID==8){passed <- passed and first!.pItem!.value!.items.size()==2 and
                    first!.pItem!.value!.items.head!.pItem!.value!.num==1}
        }
        if(caseID==18){
            normalizer.addRHS(fixture.source!.pItem!.value!.items.head, graphScalar(1, 10))
            handle.waitForCompletion()
            passed <- passed and !handle.failed() and handle.symbolicValues() and
                    fixture.target!.pItem!.value!.items.head!.pItem!.value!.num==1
        }
        if(caseID==5 or caseID==19){handle.cancel()}
        fixture.publish(normalizer)
        if(caseID==19){handle <- normalizer.normalize(fixture.target)}
        handle.waitForCompletion()
        if(caseID==5){passed <- passed and handle.cancelled() and fixture.target!.pItem!.value!.items.size()==1}
        else if(caseID==10 or caseID==11 or caseID==12 or caseID==14 or caseID==15){
            passed <- passed and handle.failed() and !fixture.target!.pItem!.isNormed
        }else if(caseID==4 or caseID==6 or caseID==9){
            passed <- passed and !handle.failed() and handle.symbolicValues() and !fixture.target!.pItem!.isNormed
            if(caseID==9){passed <- passed and fixture.target!.pItem!.value!.items.size()==2 and
                    fixture.target!.pItem!.value!.tailUnfinished and fixture.target!.pItem!.infSize!.num==1000000000}
        }else{
            me int: finalCount <- 3
            if(caseID==8){finalCount <- 2}
            passed <- passed and !handle.failed() and !handle.symbolicValues() and fixture.target!.pItem!.isNormed and
                    !fixture.target!.pItem!.value!.tailUnfinished and fixture.target!.pItem!.value!.items.size()==finalCount and
                    fixture.target!.pItem!.infSize!.num==finalCount
        }
        if(caseID==13){passed <- passed and fixture.source!.looseMode and
                fixture.target!.pItem!.workListContainsPOV(fixture.source) and
                !normalizer.access!.hasDirectIdentity(fixture.target, fixture.source)}
        if(!passed){
            print("Graph stream "+toString(caseID)+": "+handle.error()+"\n"+normalizer.stringifyResult(fixture.target)+"\n")
            withEach step in range 0 .. handle.stepCount(){print(handle.stepDescription(step)+"\n")}
        }
        handle.cancel(); normalizer.close()
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

struct GraphDefinitionProbe {
    void: publishSize(their GraphNormalizer: normalizer, our POV: target, me int64: extent) <- <%{
        normalizer->runtime.update([&] {
            GraphTypeFacts facts; facts.valid = true; facts.hasSize = true; facts.size = extent;
            normalizer->access->applyTypeFacts(target, facts);
        });
    }%>
    me NormalizationHandle: sizeOnly(their GraphNormalizer: normalizer, our POV: target) <- <%{
        return normalizer->runtime.normalize({target, proteus4::sizeOnly, 0});
    }%>
}
#define GRAPHDEFINITION(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphDefinitions(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHDEFINITION(unit/graphDefinitions/literal, 1)
    GRAPHDEFINITION(unit/graphDefinitions/scalarConstraint, 2)
    GRAPHDEFINITION(unit/graphDefinitions/string, 3)
    GRAPHDEFINITION(unit/graphDefinitions/aliases, 4)
    GRAPHDEFINITION(unit/graphDefinitions/forward, 5)
    GRAPHDEFINITION(unit/graphDefinitions/independent, 6)
    GRAPHDEFINITION(unit/graphDefinitions/repeat, 7)
    GRAPHDEFINITION(unit/graphDefinitions/copyEvidence, 8)
    GRAPHDEFINITION(unit/graphDefinitions/conflict, 9)
    GRAPHDEFINITION(unit/graphDefinitions/sizeConflict, 10)
    GRAPHDEFINITION(unit/graphDefinitions/overlayConflict, 11)
    GRAPHDEFINITION(unit/graphDefinitions/cycle, 12)
    GRAPHDEFINITION(unit/graphDefinitions/constrainedCycle, 13)
    GRAPHDEFINITION(unit/graphDefinitions/subscription, 14)
    GRAPHDEFINITION(unit/graphDefinitions/cancel, 15)
    GRAPHDEFINITION(unit/graphDefinitions/ambiguous, 16)
    GRAPHDEFINITION(unit/graphDefinitions/openListDeferred, 17)
    GRAPHDEFINITION(unit/graphDefinitions/contextDeferred, 18)
    GRAPHDEFINITION(unit/graphDefinitions/bodyRHS, 19)
    GRAPHDEFINITION(unit/graphDefinitions/lateConstraint, 20)
    GRAPHDEFINITION(unit/graphDefinitions/unrelatedRevision, 21)
    GRAPHDEFINITION(unit/graphDefinitions/lateAmbiguity, 22)
    GRAPHDEFINITION(unit/graphDefinitions/changedDefinition, 23)
    GRAPHDEFINITION(unit/graphDefinitions/addedType, 24)
    GRAPHDEFINITION(unit/graphDefinitions/isolatedCatalogues, 25)
    GRAPHDEFINITION(unit/graphDefinitions/cost, 26)
    GRAPHDEFINITION(unit/graphDefinitions/publicEntry, 27)
    GRAPHDEFINITION(unit/graphDefinitions/stream, 28)
    GRAPHDEFINITION(unit/graphDefinitions/knownTargetEvidence, 29)
    GRAPHDEFINITION(unit/graphDefinitions/partialCopy, 30)
    GRAPHDEFINITION(unit/graphDefinitions/sharedInfon, 31)
    GRAPHDEFINITION(unit/graphDefinitions/repeatRegistration, 32)
    GRAPHDEFINITION(unit/graphDefinitions/zeroSizeConflict, 33)
    GRAPHDEFINITION(unit/graphDefinitions/renderRoundTrip, 34)
    GRAPHDEFINITION(unit/graphDefinitions/renderCombined, 35)
    GRAPHDEFINITION(unit/graphDefinitions/contextSizeDeferred, 36)

    me int: graphTypeSetCount(me NormalizationHandle: handle) <- {
        me int: count <- 0
        withEach step in range 0 .. handle.stepCount(){
            if(handle.stepDescription(step)=="Apply scalar type requirements"){count <+- 1}
        }
        return(count)
    }
    void: unitTestGraphDefinitions(me string: testName, me int: caseID) <- {
        me string: declarations <- "{#seven=*10+7}"
        me string: expression <- "seven"
        if(caseID==2 or caseID==8 or caseID==29){declarations <- "{#digit=*10+_}"; expression <- "digit:7"}
        if(caseID==3){declarations <- "{#hello='hi'}"; expression <- "hello"}
        if(caseID==4){declarations <- "{#seven=middle #middle=base #base=*10+7}"}
        if(caseID==5){declarations <- "{}"; expression <- "{seven #seven=*10+7}"}
        if(caseID==6){expression <- "{seven seven}"}
        if(caseID==9){expression <- "seven:8"}
        if(caseID==10){expression <- "seven:*11+7"}
        if(caseID==11){expression <- "seven:'bad'"}
        if(caseID==33){expression <- "seven:*0+7"}
        if(caseID==12){declarations <- "{#seven=loop #loop=seven}"}
        if(caseID==13){declarations <- "{#seven=loop:*10+_ #loop=seven}"; expression <- "seven:7"}
        if(caseID==14 or caseID==15){declarations <- "{}"}
        if(caseID==16){declarations <- "{#seven=*10+7 #seven=*10+8}"}
        if(caseID==17){declarations <- "{#seven={*10+7 ...}}"}
        if(caseID==18){declarations <- "{#seven=%prev}"}
        if(caseID==19){declarations <- "{#seven=*_+7 = *10+_}"}
        if(caseID==34){declarations <- "{#seven=*16+10}"}
        if(caseID==35){declarations <- "{#seven=*_+10 = *16+_}"}
        if(caseID==36){declarations <- "{#seven=+7}"}
        if(caseID==24){declarations <- "{#sized=*10+_ #seven=*10+7}"; expression <- "sized:7"}
        me GraphNormalizer: normalizer
        normalizer.init()
        our POV: defs <- graphParsed(testName, declarations)
        me NormalizationHandle: declared <- normalizer.normalize(defs)
        declared.waitForCompletion()
        me bool: passed <- !declared.failed() and !declared.symbolicValues() and defs!.pItem!.isNormed
        me string: originalDefinitions <- toString(defs!.pItem)
        our POV: target <- graphParsed(testName, expression)
        our POV: source
        if(caseID==8 or caseID==29 or caseID==30){
            source <- graphParsed(testName, expression)
            me NormalizationHandle: checked <- normalizer.normalize(source)
            checked.waitForCompletion()
            passed <- passed and !checked.failed() and !checked.symbolicValues()
            if(caseID==8){target <- graphParsed(testName, "digit")}
            if(caseID==30){target <- graphParsed(testName, "*_+_")}
            normalizer.addRHS(target, source)
        }
        me NormalizationHandle: handle
        if(caseID==26){handle <- normalizer.normalizeWithCost(target, 1)}
        else if(caseID==30){me GraphDefinitionProbe: probe; handle <- probe.sizeOnly(normalizer, target)}
        else{handle <- normalizer.normalize(target)}
        handle.waitForCompletion()
        if((caseID>=9 and caseID<=11) or caseID==33){passed <- passed and handle.failed() and !target!.pItem!.isNormed}
        else if((caseID>=12 and caseID<=18) or caseID==26 or caseID==36){
            passed <- passed and !handle.failed() and handle.symbolicValues() and handle.withSubscribers() and
                    !target!.pItem!.isNormed and target!.pItem!.wrkList.isEmpty() and handle.stepCount()<250
        }else if(caseID==5 or caseID==6){
            passed <- passed and !handle.failed() and !handle.symbolicValues() and target!.pItem!.isNormed and
                    target!.pItem!.infSize!.num==2 and target!.pItem!.value!.items.head!.pItem!.value!.num==7
            if(caseID==6){passed <- passed and target!.pItem!.value!.items.head!.pItem!==target!.pItem!.value!.items.tail!.pItem and
                    target!.pItem!.value!.items.tail!.pItem!.value!.num==7}
        }else if(caseID==30){
            passed <- passed and !handle.failed() and target!.pItem!.infSize!.num==10 and
                    target!.pItem!.value!.evalMode==emUnknown and !target!.pItem!.isNormed
        }else{
            passed <- passed and !handle.failed() and !handle.symbolicValues() and target!.pItem!.isNormed
            if(caseID==3){passed <- passed and target!.pItem!.value!.str=="hi" and target!.pItem!.infSize!.num==2}
            else if(caseID==34 or caseID==35){passed <- passed and target!.pItem!.value!.num==10 and target!.pItem!.infSize!.num==16}
            else{passed <- passed and target!.pItem!.value!.num==7 and target!.pItem!.infSize!.num==10}
            if(caseID==8 or caseID==29){passed <- passed and graphTypeSetCount(handle)==0 and target!.pItem!.wrkList.size()==1}
            else{passed <- passed and target!.pItem!.wrkList.isEmpty()}
        }
        passed <- passed and toString(defs!.pItem)==originalDefinitions
        if(caseID==34 or caseID==35){
            me string: rendered <- toString(target!.pItem)
            our POV: reparsed <- graphParsed(testName, rendered)
            handle <- normalizer.normalize(reparsed); handle.waitForCompletion()
            passed <- passed and rendered=="seven:*16+10" and !handle.failed() and !handle.symbolicValues() and
                    reparsed!.pItem!.infSize!.num==16 and reparsed!.pItem!.value!.num==10
        }
        if(caseID==31){
            our POV:: another{912}
            another!.pItem <- target!.pItem
            handle <- normalizer.normalize(another); handle.waitForCompletion()
            passed <- passed and !handle.failed() and !handle.symbolicValues() and
                    graphTypeSetCount(handle)==0 and another!.pItem!.wrkList.isEmpty()
        }
        if(caseID==32){
            withEach repetition in range 0 .. 5{
                declared <- normalizer.normalize(defs); declared.waitForCompletion()
                handle <- normalizer.normalize(target); handle.waitForCompletion()
                passed <- passed and !declared.failed() and !declared.symbolicValues() and
                        !handle.failed() and !handle.symbolicValues() and graphTypeSetCount(handle)==0
            }
        }
        if(caseID==7 or caseID==21){
            if(caseID==21){
                me NormalizationHandle: extra <- normalizer.normalize(graphParsed(testName, "{#other=*20+2}"))
                extra.waitForCompletion()
            }
            withEach repetition in range 0 .. 5{
                handle <- normalizer.normalize(target); handle.waitForCompletion()
                passed <- passed and !handle.failed() and !handle.symbolicValues() and
                        graphTypeSetCount(handle)==0 and target!.pItem!.wrkList.isEmpty()
            }
        }
        if(caseID==14 or caseID==15){
            if(caseID==15){handle.cancel()}
            declared <- normalizer.normalize(graphParsed(testName, "{#seven=*10+7}")); declared.waitForCompletion()
            handle.waitForCompletion()
            if(caseID==15){passed <- passed and handle.cancelled() and target!.pItem!.value!.evalMode==emUnknown}
            else{passed <- passed and !handle.failed() and !handle.symbolicValues() and target!.pItem!.value!.num==7}
        }
        if(caseID==20){
            normalizer.addRHS(target, graphScalar(8, 10))
            handle <- normalizer.normalize(target); handle.waitForCompletion()
            passed <- passed and handle.failed() and !target!.pItem!.isNormed
        }
        if(caseID==22){
            declared <- normalizer.normalize(graphParsed(testName, "{#seven=*10+8}")); declared.waitForCompletion()
            handle <- normalizer.normalize(target); handle.waitForCompletion()
            passed <- passed and !handle.failed() and handle.symbolicValues() and !target!.pItem!.isNormed
        }
        if(caseID==23){
            our POV:: body{911}
            body!.pItem <- defs!.pItem!.value!.items.head!.pItem!.funcArgs
            normalizer.addRHS(body, graphScalar(8, 10))
            handle <- normalizer.normalize(target); handle.waitForCompletion()
            passed <- passed and handle.failed() and !target!.pItem!.isNormed
        }
        if(caseID==24){
            // No publisher is active after the completed wait. normalize()
            // publishes this additional requirement before the worker reads it.
            our POV: typed <- graphParsed(testName, "seven")
            target!.pItem!.addedTypes.append(typed!.pItem!.type)
            handle <- normalizer.normalize(target); handle.waitForCompletion()
            passed <- passed and !handle.failed() and !handle.symbolicValues() and graphTypeSetCount(handle)==1 and
                    target!.pItem!.type!.typeID()=="sized" and target!.pItem!.wrkList.isEmpty()
        }
        if(caseID==25){
            me GraphNormalizer: separate
            separate.init()
            me NormalizationHandle: unresolved <- separate.normalize(graphParsed(testName, "seven"))
            unresolved.waitForCompletion()
            passed <- passed and !unresolved.failed() and unresolved.symbolicValues()
            separate.close()
        }
        if(caseID==27){
            me GraphLifecycleCore: core
            core.init("", false)
            core.query("{#seven=*10+7}", false)
            our infonView: answer <- core.query("seven", false)
            passed <- passed and answer!=NULL and answer!.isNormed and answer!.value!.num==7 and answer!.infSize!.num==10
            core.deInit()
        }
        if(caseID==28){
            me GraphLifecycleCore: core
            core.init("", false)
            me strBuf: input
            input.init(testName)
            our infonView:: top
            top!.originID <- 17
            me ThreadedNormalizer: normer
            normer.init(core.agent, top)
            our ProteusParser:: parser{core, true, 17}
            parser!.initParseFromStream(input)
            me GraphInputTestThread: parsing
            parsing.parser <- parser; parsing.target <- top
            normer.start("definition-normalize"); parsing.start("definition-parse")
            input.putStr("{| #seven=*10+7 seven>> ")
            passed <- core.waitForReplies(1) and passed
            input.putStr("}"); input.close()
            parsing.waitForExit(); normer.waitForExit()
            passed <- passed and !normer.handle.failed() and top!.isNormed and core.replyCount()==1 and
                    top!.value!.items.tail!.pItem!.value!.num==7
            core.deInit()
        }
        if(caseID==30){
            // A partial copy is not a certificate for the missing value.
            // Remove its source constraint before asking for the type itself.
            target!.pItem!.wrkList.clear()
            target!.pItem!.type <- source!.pItem!.type
            handle <- normalizer.normalize(target); handle.waitForCompletion()
            passed <- passed and !handle.failed() and !handle.symbolicValues() and graphTypeSetCount(handle)==1 and
                    target!.pItem!.value!.num==7
        }
        if(!passed){
            print("Definition case "+toString(caseID)+": "+handle.error()+"\n"+normalizer.stringifyResult(target)+"\n")
            print("declared="+declared.error()+" symbolic="+toString(handle.symbolicValues())+"\n")
            withEach step in range 0 .. handle.stepCount(){print(handle.stepDescription(step)+"\n")}
        }
        handle.cancel(); normalizer.close()
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHLISTDEFINITION(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphListDefinitions(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHLISTDEFINITION(unit/graphListDefinitions/literal, 1)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/empty, 2)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/existing, 3)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/openTarget, 4)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/prefixTarget, 5)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/embeddedBody, 6)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/nestedBody, 7)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/namedMembers, 8)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/aliases, 9)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/combinedBodies, 10)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/repeat, 11)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/independent, 12)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/valueConflictAtomic, 13)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/lengthConflict, 14)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/overlayConflict, 15)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/declaredExtentConflict, 16)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/memberSubscription, 17)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/lateDefinition, 18)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/recursive, 19)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/openBodyPrefix, 20)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/templateLazy, 21)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/contextDeferred, 22)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/lateMemberType, 23)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/cost, 24)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/cancel, 25)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/copyEvidence, 26)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/copyUnknown, 27)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/addedType, 28)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/lateConflict, 29)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/changedBody, 30)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/unrelatedRevision, 31)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/sharedInfon, 32)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/embeddedTarget, 33)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/ambiguousTarget, 34)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/nestedEmpty, 35)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/publicEntry, 36)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/stream, 37)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/unsupportedTargetAtomic, 38)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/partialCopy, 39)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/registryBodyDeferred, 40)
    GRAPHLISTDEFINITION(unit/graphListDefinitions/replacedMembers, 41)

    me int: graphListTypeSetCount(me NormalizationHandle: handle) <- {
        me int: count <- 0
        withEach step in range 0 .. handle.stepCount(){
            if(handle.stepDescription(step)=="Apply finite list type requirements"){count <+- 1}
        }
        return(count)
    }
    void: unitTestGraphListDefinitions(me string: testName, me int: caseID) <- {
        me string: declarations <- "{#pair={*10+1 *10+2}}"
        me string: expression <- "pair"
        if(caseID==2){declarations <- "{#pair={}}"}
        if(caseID==3){expression <- "pair:{*10+_ *10+_}"}
        if(caseID==4){expression <- "pair:{...}"}
        if(caseID==5){expression <- "pair:{*10+1 ...}"}
        if(caseID==6){declarations <- "{#pair={*10+1 &{*10+2 *10+3}}}"}
        if(caseID==7){declarations <- "{#pair={*10+1 {*10+2 *10+3}}}"}
        if(caseID==8){declarations <- "{#digit=*10+7 #pair={digit digit}}"}
        if(caseID==9){declarations <- "{#pair=middle #middle=base #base={*10+1 *10+2}}"}
        if(caseID==10){declarations <- "{#pair={*10+_ *10+2} = {*10+1 *10+_}}"}
        if(caseID==12){declarations <- "{#pair={*10+_ *10+_}}"; expression <- "{pair:{1 2} pair:{3 4}}"}
        if(caseID==13){expression <- "pair:{*10+_ *10+9}"}
        if(caseID==14){expression <- "pair:{*10+1}"}
        if(caseID==15){expression <- "pair:7"}
        if(caseID==16){declarations <- "{#pair=*3+{*10+1 *10+2}}"}
        if(caseID==17){declarations <- "{#pair={*10+_ *10+2}}"}
        if(caseID==18 or caseID==25){declarations <- "{}"}
        if(caseID==19){declarations <- "{#pair={pair}}"}
        if(caseID==20){declarations <- "{#pair={*10+1 ...}}"}
        if(caseID==21){declarations <- "{#pair=*1000000000+{*10+7| ...}}"}
        if(caseID==22){declarations <- "{#pair={%prev *10+2}}"}
        if(caseID==23){declarations <- "{#pair={missing *10+2}}"}
        if(caseID==26){expression <- "pair:{*10+1 *10+2}"}
        if(caseID==33){expression <- "pair:{&{*10+_ *10+_}}"}
        if(caseID==34){expression <- "pair:{&{...} &{...}}"}
        if(caseID==35){declarations <- "{#pair={{} {}}}"}
        if(caseID==38){expression <- "pair:{*10+_ %tprev}"}
        me GraphNormalizer: normalizer
        normalizer.init()
        our POV: defs <- graphParsed(testName, declarations)
        me NormalizationHandle: declared <- normalizer.normalize(defs)
        declared.waitForCompletion()
        me bool: passed <- !declared.failed() and !declared.symbolicValues()
        me string: originalDefinitions <- toString(defs!.pItem)
        our POV: target <- graphParsed(testName, expression)
        our POV: source
        if(caseID==26 or caseID==27 or caseID==39){
            source <- graphParsed(testName, "pair")
            me NormalizationHandle: checked <- normalizer.normalize(source)
            checked.waitForCompletion()
            passed <- passed and !checked.failed() and !checked.symbolicValues()
            if(caseID==39){target <- graphParsed(testName, "?")}
            normalizer.addRHS(target, source)
        }
        if(caseID==40){
            our POV: member <- defs!.pItem!.value!.items.head!.pItem!.funcArgs!.value!.items.head
            normalizer.recordIdentity(member, graphScalar(1, 10))
        }
        me NormalizationHandle: handle
        if(caseID==24){handle <- normalizer.normalizeWithCost(target, 1)}
        else if(caseID==39){me GraphDefinitionProbe: probe; handle <- probe.sizeOnly(normalizer, target)}
        else{handle <- normalizer.normalize(target)}
        handle.waitForCompletion()
        our POV: first <- target!.pItem!.value!.items.head
        me bool: deferred <- (caseID>=18 and caseID<=25) or caseID==34 or caseID==38 or caseID==40
        if(caseID>=13 and caseID<=16){
            passed <- passed and handle.failed() and !target!.pItem!.isNormed
            if(caseID==13){passed <- passed and first!.pItem!.value!.evalMode==emUnknown}
        }else if(caseID==20){
            passed <- passed and !handle.failed() and handle.symbolicValues() and handle.withSubscribers() and
                !target!.pItem!.isNormed and target!.pItem!.value!.tailUnfinished and
                target!.pItem!.value!.items.size()==1 and first!.pItem!.value!.num==1 and
                first!.pItem!.infSize!.num==10 and graphListTypeSetCount(handle)==1
        }else if(caseID==21){
            passed <- passed and !handle.failed() and handle.symbolicValues() and !target!.pItem!.isNormed and
                target!.pItem!.infSize!.num==1000000000 and target!.pItem!.value!.items.isEmpty() and
                target!.pItem!.value!.listSpec!=NULL
        }else if(deferred){
            passed <- passed and !handle.failed() and handle.symbolicValues() and handle.withSubscribers() and
                    !target!.pItem!.isNormed and graphListTypeSetCount(handle)<=1 and handle.stepCount()<500
            if(caseID!=23){passed <- passed and graphListTypeSetCount(handle)==0}
            else{passed <- passed and graphListTypeSetCount(handle)==1 and target!.pItem!.value!.items.size()==2 and first!.pItem!.value!.evalMode==emUnknown}
            if(caseID==38){passed <- passed and first!.pItem!.value!.evalMode==emUnknown}
        }else if(caseID==39){
            passed <- passed and !handle.failed() and target!.pItem!.infSize!.num==2 and
                    target!.pItem!.value!.evalMode==emUnknown and !target!.pItem!.isNormed
        }else{
            passed <- passed and !handle.failed() and target!.pItem!.value!.overlayType==LST
            if(caseID==17){passed <- passed and handle.symbolicValues() and !target!.pItem!.isNormed}
            else{passed <- passed and !handle.symbolicValues() and target!.pItem!.isNormed}
            if(caseID==2){passed <- passed and first==NULL and target!.pItem!.infSize!.num==0}
            else if(caseID==12){
                our POV: second <- first!.next
                passed <- passed and first!.pItem!.value!.items.head!.pItem!.value!.num==1 and
                    second!.pItem!.value!.items.head!.pItem!.value!.num==3 and
                    first!.pItem!.value!.items.head!.pItem!==second!.pItem!.value!.items.head!.pItem
            }else if(caseID==33){
                passed <- passed and target!.pItem!.value!.items.size()==1 and first!.isSubItm and
                    target!.pItem!.infSize!.num==2 and first!.pItem!.value!.items.head!.pItem!.value!.num==1 and
                    first!.pItem!.value!.items.tail!.pItem!.value!.num==2
            }else if(caseID==35){
                passed <- passed and target!.pItem!.infSize!.num==2 and first!.pItem!.infSize!.num==0 and
                    first!.next!.pItem!.infSize!.num==0 and first!.pItem!==first!.next!.pItem
            }else{
                if(caseID==6){passed <- passed and target!.pItem!.infSize!.num==3 and first!.next!.next!.pItem!.value!.num==3}
                else{passed <- passed and target!.pItem!.infSize!.num==2}
                if(caseID==7){passed <- passed and first!.next!.pItem!.value!.overlayType==LST and
                    first!.next!.pItem!.infSize!.num==2 and first!.next!.pItem!.value!.items.tail!.pItem!.value!.num==3}
                else if(caseID==8){passed <- passed and first!.pItem!.type!=NULL and first!.pItem!.type!.typeID()=="digit" and
                    first!.pItem!.value!.num==7 and first!.next!.pItem!.value!.num==7 and graphTypeSetCount(handle)==0}
                else{passed <- passed and first!.next!.pItem!.value!.num==2}
                if(caseID!=8 and caseID!=17){passed <- passed and first!.pItem!.value!.num==1}
            }
            if(caseID==26 or caseID==27){passed <- passed and graphListTypeSetCount(handle)==0}
            if(caseID==26 or caseID==27){passed <- passed and target!.pItem!.wrkList.size()==1 and first!.pItem!==source!.pItem!.value!.items.head!.pItem}
            else{passed <- passed and target!.pItem!.wrkList.isEmpty()}
        }
        passed <- passed and toString(defs!.pItem)==originalDefinitions
        if(caseID==11 or caseID==31 or caseID==32){
            if(caseID==31){declared <- normalizer.normalize(graphParsed(testName, "{#other=*10+7}")); declared.waitForCompletion()}
            if(caseID==32){our POV:: another{914}; another!.pItem <- target!.pItem; target <- another}
            withEach repetition in range 0 .. 5{
                handle <- normalizer.normalize(target); handle.waitForCompletion()
                passed <- passed and !handle.failed() and !handle.symbolicValues() and graphListTypeSetCount(handle)==0 and
                    target!.pItem!.value!.items.head===first and target!.pItem!.value!.items.size()==2 and target!.pItem!.wrkList.isEmpty()
            }
        }
        if(caseID==17){
            normalizer.addRHS(first, graphScalar(1, 10)); handle.waitForCompletion()
            passed <- passed and !handle.failed() and !handle.symbolicValues() and target!.pItem!.isNormed and
                first!.pItem!.value!.num==1 and toString(defs!.pItem)==originalDefinitions and graphListTypeSetCount(handle)==1
        }
        if(caseID==18 or caseID==23 or caseID==25){
            if(caseID==25){handle.cancel()}
            me string: later <- "{#pair={*10+1 *10+2}}"
            if(caseID==23){later <- "{#missing=*10+1}"}
            declared <- normalizer.normalize(graphParsed(testName, later)); declared.waitForCompletion(); handle.waitForCompletion()
            if(caseID==25){passed <- passed and handle.cancelled() and target!.pItem!.value!.items.isEmpty()}
            else{passed <- passed and !handle.failed() and !handle.symbolicValues() and target!.pItem!.infSize!.num==2 and
                target!.pItem!.value!.items.head!.pItem!.value!.num==1}
        }
        if(caseID==28){
            declared <- normalizer.normalize(graphParsed(testName, "{#other={*10+_ *10+2}}")); declared.waitForCompletion()
            target!.pItem!.addedTypes.append(graphParsed(testName, "other")!.pItem!.type)
            handle <- normalizer.normalize(target); handle.waitForCompletion()
            passed <- passed and !handle.failed() and !handle.symbolicValues() and target!.pItem!.value!.items.head===first and
                graphListTypeSetCount(handle)==1 and target!.pItem!.wrkList.isEmpty()
        }
        if(caseID==29 or caseID==30){
            our POV: changed <- first
            if(caseID==30){changed <- defs!.pItem!.value!.items.head!.pItem!.funcArgs!.value!.items.head}
            normalizer.addRHS(changed, graphScalar(9, 10))
            handle <- normalizer.normalize(target); handle.waitForCompletion()
            passed <- passed and handle.failed() and !target!.pItem!.isNormed
        }
        if(caseID==41){
            // Same extent and root facts, but a new set of member POVs. A
            // certificate must witness the shape as well as scalar fields.
            our POV: replacement <- graphParsed(testName, "{*10+9 *10+2}")
            defs!.pItem!.value!.items.head!.pItem!.funcArgs!.value!.items <- replacement!.pItem!.value!.items
            handle <- normalizer.normalize(target); handle.waitForCompletion()
            passed <- passed and handle.failed() and !target!.pItem!.isNormed
        }
        if(caseID==36){
            me GraphLifecycleCore: core
            core.init("", false); core.query(declarations, false)
            our infonView: answer <- core.query("pair", false)
            passed <- passed and answer!=NULL and answer!.isNormed and toString(answer)=="pair:{*10+1 *10+2}"
            core.deInit()
        }
        if(caseID==37){
            me GraphLifecycleCore: core
            core.init("", false)
            me strBuf: input; input.init(testName)
            our infonView:: top; top!.originID <- 19
            me ThreadedNormalizer: normer; normer.init(core.agent, top)
            our ProteusParser:: parser{core, true, 19}; parser!.initParseFromStream(input)
            me GraphInputTestThread: parsing; parsing.parser <- parser; parsing.target <- top
            normer.start("list-definition-normalize"); parsing.start("list-definition-parse")
            input.putStr("{| #pair={*10+1 *10+2} pair>> ")
            passed <- core.waitForReplies(1) and passed
            input.putStr("}"); input.close(); parsing.waitForExit(); normer.waitForExit()
            passed <- passed and !normer.handle.failed() and top!.isNormed and core.replyCount()==1 and
                top!.value!.items.tail!.pItem!.value!.items.size()==2
            core.deInit()
        }
        if(caseID==39){
            target!.pItem!.wrkList.clear(); target!.pItem!.type <- source!.pItem!.type
            handle <- normalizer.normalize(target); handle.waitForCompletion()
            passed <- passed and !handle.failed() and !handle.symbolicValues() and graphListTypeSetCount(handle)==1 and
                target!.pItem!.value!.items.size()==2
        }
        if(!passed){
            print("List definition case "+toString(caseID)+": "+handle.error()+"\n"+normalizer.stringifyResult(target)+"\n")
            print("declared="+declared.error()+" symbolic="+toString(handle.symbolicValues())+"\n")
            withEach step in range 0 .. handle.stepCount(){print(handle.stepDescription(step)+"\n")}
        }
        handle.cancel(); normalizer.close()
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

// Tests exercise the public graph path, including demand-only sparse
    // identities; no legacy normalizer or materialization helper is called.
#define GRAPHTEMPLATE(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphTemplate(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHTEMPLATE(unit/graphTemplates/detachedOccurrence, 27)
    GRAPHTEMPLATE(unit/graphTemplates/unorderedDeferred, 35)
    GRAPHTEMPLATE(unit/graphTemplates/referencedSpanDeferred, 36)
    GRAPHTEMPLATE(unit/graphTemplates/copyUnknown, 34)
    GRAPHTEMPLATE(unit/graphTemplates/copyEvidence, 28)
    GRAPHTEMPLATE(unit/graphTemplates/embeddedAliasDeferred, 33)
    GRAPHTEMPLATE(unit/graphTemplates/embeddedDeferred, 29)
    GRAPHTEMPLATE(unit/graphTemplates/recursiveDeferred, 30)
    GRAPHTEMPLATE(unit/graphTemplates/bodyPrefix, 31)
    GRAPHTEMPLATE(unit/graphTemplates/parentConflict, 32)
    GRAPHTEMPLATE(unit/graphTemplates/sparse, 1)
    GRAPHTEMPLATE(unit/graphTemplates/direct, 2)
    GRAPHTEMPLATE(unit/graphTemplates/finiteTarget, 3)
    GRAPHTEMPLATE(unit/graphTemplates/independentValues, 4)
    GRAPHTEMPLATE(unit/graphTemplates/nestedMember, 5)
    GRAPHTEMPLATE(unit/graphTemplates/alias, 6)
    GRAPHTEMPLATE(unit/graphTemplates/namedMember, 7)
    GRAPHTEMPLATE(unit/graphTemplates/sameIndex, 8)
    GRAPHTEMPLATE(unit/graphTemplates/separateInstances, 9)
    GRAPHTEMPLATE(unit/graphTemplates/atomicConflict, 10)
    GRAPHTEMPLATE(unit/graphTemplates/extentConflict, 11)
    GRAPHTEMPLATE(unit/graphTemplates/lateMeaning, 12)
    GRAPHTEMPLATE(unit/graphTemplates/cancel, 13)
    GRAPHTEMPLATE(unit/graphTemplates/cost, 14)
    GRAPHTEMPLATE(unit/graphTemplates/indexBeforeNormalize, 15)
    GRAPHTEMPLATE(unit/graphTemplates/memberSubscription, 16)
    GRAPHTEMPLATE(unit/graphTemplates/changedTemplate, 17)
    GRAPHTEMPLATE(unit/graphTemplates/replacedTemplate, 18)
    GRAPHTEMPLATE(unit/graphTemplates/repeat, 19)
    GRAPHTEMPLATE(unit/graphTemplates/prefixInstance, 20)
    GRAPHTEMPLATE(unit/graphTemplates/contextDeferred, 21)
    GRAPHTEMPLATE(unit/graphTemplates/unknownExtent, 22)
    GRAPHTEMPLATE(unit/graphTemplates/closedLiteral, 23)
    GRAPHTEMPLATE(unit/graphTemplates/combinedTemplates, 24)
    GRAPHTEMPLATE(unit/graphTemplates/finiteConjunction, 25)
    GRAPHTEMPLATE(unit/graphTemplates/zeroExtent, 26)

    our POV: graphDetachedOccurrence(their GraphNormalizer: normalizer, me string: testName) <- {
        our POV: owner <- graphParsed(testName, "many")
        me NormalizationHandle: selection <- normalizer!.findItem(owner, 999999999)
        selection.waitForCompletion()
        return(selection.result())
    }
    me int: graphRepeatSetCount(me NormalizationHandle: handle) <- {
        me int: count <- 0
        withEach step in range 0 .. handle.stepCount(){
            if(handle.stepDescription(step)=="Apply repeated member requirements"){count <+- 1}
        }
        return(count)
    }
    void: unitTestGraphTemplate(me string: testName, me int: caseID) <- {
        me string: declarations <- "{#many=*1000000000+{*10+7| ...}}"
        me string: expression <- "many"
        if(caseID==2){declarations <- "{}"; expression <- "*1000000000+{*10+7| ...}"}
        if(caseID==3 or caseID==10 or caseID==11 or caseID==28 or caseID==34){declarations <- "{#many=*2+{*10+7| ...}}"; expression <- "many:{*10+_ *10+_}"}
        if(caseID==4 or caseID==16){declarations <- "{#many=*1000000000+{*10+_| ...}}"}
        if(caseID==5){declarations <- "{#many=*1000000000+{{*10+1 *10+2}| ...}}"}
        if(caseID==6){declarations <- "{#many=base #base=*1000000000+{*10+7| ...}}"}
        if(caseID==7){declarations <- "{#digit=*10+7 #many=*1000000000+{digit| ...}}"}
        if(caseID==10){expression <- "many:{*10+_ *10+9}"}
        if(caseID==11){expression <- "many:{*10+_}"}
        if(caseID==12 or caseID==13){declarations <- "{#many=*1000000000+{digit| ...}}"}
        if(caseID==20){expression <- "many:{*10+7 ...}"}
        if(caseID==21){declarations <- "{#context=%prev #many=*1000000000+{context| ...}}"}
        if(caseID==22){declarations <- "{#many={*10+7| ...}}"}
        if(caseID==23){declarations <- "{}"; expression <- "{*10+7| *10+_ *10+_}"}
        if(caseID==24){declarations <- "{#many=*1000000000+{*10+_| ...} = *1000000000+{*10+7| ...}}"}
        if(caseID==25){declarations <- "{#many={*10+_ *10+7} = *2+{*10+7| ...}}"}
        if(caseID==26){declarations <- "{#many=*0+{*10+7| ...}}"}
        if(caseID==29){declarations <- "{#many={&*1000000000+{*10+7| ...}}}"}
        if(caseID==30){declarations <- "{#many=*1000000000+{many| ...}}"}
        if(caseID==31){declarations <- "{#many=*1000000000+{*10+7| *10+7 ...}}"}
        if(caseID==33){declarations <- "{#base=*1000000000+{*10+7| ...} #many={&base}}"}
        if(caseID==35){declarations <- "{#many=*2+{*10+7| ...}}"; expression <- "many:{*10+_, *10+_}"}
        if(caseID==36){declarations <- "{#many=*2+{*10+7| ...}}"}
        me GraphNormalizer: normalizer; normalizer.init()
        our POV: defs <- graphParsed(testName, declarations)
        me NormalizationHandle: declared <- normalizer.normalize(defs); declared.waitForCompletion()
        me string: original <- toString(defs!.pItem)
        our POV: target <- graphParsed(testName, expression)
        me NormalizationHandle: handle
        if(caseID==14){handle <- normalizer.normalizeWithCost(target, 1)}
        else if(caseID==15){handle <- normalizer.findItem(target, 999999999)}
        else{handle <- normalizer.normalize(target)}
        handle.waitForCompletion()
        me bool: passed <- !declared.failed() and !handle.failed()
        if(caseID==10 or caseID==11){
            passed <- handle.failed() and !target!.pItem!.isNormed and
                target!.pItem!.value!.items.head!.pItem!.value!.evalMode==emUnknown
        }else if(caseID==20 or caseID==31){
            passed <- passed and handle.symbolicValues() and handle.withSubscribers() and !target!.pItem!.isNormed and
                target!.pItem!.value!.tailUnfinished and target!.pItem!.value!.listSpec!=NULL and
                target!.pItem!.value!.items.size()==1 and target!.pItem!.infSize!.num==1000000000 and
                target!.pItem!.value!.items.head!.pItem!.isNormed and graphRepeatSetCount(handle)==1
        }else if(caseID==12 or caseID==13 or caseID==14 or caseID==21 or (caseID>=29 and caseID<=30) or caseID==33 or caseID==35){
            passed <- passed and handle.symbolicValues() and handle.withSubscribers() and !target!.pItem!.isNormed and
                graphRepeatSetCount(handle)<=1
            if(caseID!=12 and caseID!=13){passed <- passed and graphRepeatSetCount(handle)==0}
            else{passed <- passed and graphRepeatSetCount(handle)==1 and target!.pItem!.value!.listSpec!=NULL and target!.pItem!.value!.items.isEmpty()}
            if(caseID==35){passed <- passed and target!.pItem!.value!.items.head!.pItem!.value!.evalMode==emUnknown}
            if(caseID==12 or caseID==13){
                if(caseID==13){handle.cancel()}
                declared <- normalizer.normalize(graphParsed(testName, "{#digit=*10+7}")); declared.waitForCompletion()
                handle.waitForCompletion()
                if(caseID==13){passed <- passed and handle.cancelled() and target!.pItem!.value!.listSpec!=NULL and target!.pItem!.value!.items.isEmpty()}
                else{passed <- passed and !handle.failed() and target!.pItem!.value!.listSpec!=NULL}
            }
        }else if(caseID==3 or caseID==23 or caseID==25 or caseID==28 or caseID==34){
            passed <- passed and !handle.symbolicValues() and target!.pItem!.isNormed and
                target!.pItem!.infSize!.num==2 and target!.pItem!.value!.items.size()==2 and
                target!.pItem!.value!.items.head!.pItem!.value!.num==7 and target!.pItem!.value!.items.tail!.pItem!.value!.num==7
            if(caseID==28 or caseID==34){
                me string: copyText <- "many:{*10+7 *10+7}"
                if(caseID==34){copyText <- "many"}
                our POV: copied <- graphParsed(testName, copyText)
                normalizer.addRHS(copied, target)
                me NormalizationHandle: copy <- normalizer.normalize(copied); copy.waitForCompletion()
                passed <- passed and !copy.failed() and !copy.symbolicValues() and copied!.pItem!.isNormed and
                    (caseID==34 or graphRepeatSetCount(copy)==0) and copied!.pItem!.value!.items.size()==2 and
                    copied!.pItem!.value!.items.head!.pItem!==target!.pItem!.value!.items.head!.pItem and
                    copied!.pItem!.wrkList.size()==1
                copy <- normalizer.normalize(copied); copy.waitForCompletion()
                passed <- passed and !copy.failed() and !copy.symbolicValues() and graphRepeatSetCount(copy)==0 and
                    copied!.pItem!.value!.items.head!.pItem!.wrkList.isEmpty()
            }
        }else{
            passed <- passed and target!.pItem!.value!.listSpec!=NULL and target!.pItem!.value!.items.isEmpty() and
                (caseID==26 or !target!.pItem!.isNormed) and handle.stepCount()<500
            if(caseID==22){
                passed <- passed and target!.pItem!.infSize!.evalMode==emUnknown
                me GraphDefinitionProbe: probe; probe.publishSize(normalizer, target, 1000000000)
                handle.waitForCompletion()
                passed <- passed and !handle.failed() and target!.pItem!.infSize!.num==1000000000
            }
            me int64: index <- 999999999
            if(caseID==26){index <- 0}
            if(caseID==36){index <- 1}
            if(caseID==26){passed <- passed and target!.pItem!.isNormed and !handle.symbolicValues()}
            me NormalizationHandle: selected <- normalizer.findItem(target, index); selected.waitForCompletion()
            our POV: item <- selected.result()
            if(caseID==26){
                passed <- passed and item==NULL and target!.repetitionSpan.family==NULL
            }else{
                passed <- passed and !selected.failed() and item!=NULL
                if(item!=NULL){
                    me NormalizationHandle: checked <- normalizer.normalize(item); checked.waitForCompletion()
                    passed <- passed and !checked.failed() and item!.pItem!.wrkList.isEmpty() and
                        target!.pItem!.value!.items.isEmpty() and target!.repetitionSpan.family!.occurrences.size()==1
                    if(caseID==5){passed <- passed and item!.pItem!.infSize!.num==2 and item!.pItem!.isNormed and
                        item!.pItem!.value!.items.tail!.pItem!.value!.num==2}
                    else if(caseID==4 or caseID==16){
                        passed <- passed and item!.pItem!.infSize!.num==10 and checked.symbolicValues()
                        normalizer.addRHS(item, graphScalar(3, 10)); checked.waitForCompletion()
                        passed <- passed and !checked.failed() and !checked.symbolicValues() and item!.pItem!.value!.num==3
                        selected <- normalizer.findItem(target, 0); selected.waitForCompletion()
                        our POV: other <- selected.result()
                        me NormalizationHandle: otherCheck <- normalizer.normalize(other); otherCheck.waitForCompletion()
                        passed <- passed and other!==item and other!.pItem!==item!.pItem and
                            other!.pItem!.value!.evalMode==emUnknown and other!.pItem!.wrkList.isEmpty()
                    }else{passed <- passed and item!.pItem!.value!.num==7 and item!.pItem!.infSize!.num==10 and item!.pItem!.isNormed}
                    if(caseID==36){
                        our POV:: alias{917}; alias!.pItem <- target!.pItem
                        normalizer.addRHS(alias, graphParsed(testName, "{*10+7 *10+7}"))
                        me NormalizationHandle: aliasCheck <- normalizer.normalize(alias); aliasCheck.waitForCompletion()
                        handle.waitForCompletion()
                        passed <- passed and !aliasCheck.failed() and aliasCheck.symbolicValues() and !handle.failed() and handle.symbolicValues() and target!.pItem!.value!.items.isEmpty() and
                            target!.repetitionSpan.family!.occurrences.size()==1
                        selected <- normalizer.findItem(target, index); selected.waitForCompletion()
                        passed <- passed and selected.result()===item
                    }
                    if(caseID==27){
                        our POV: detached <- graphDetachedOccurrence(normalizer, testName)
                        me NormalizationHandle: detachedCheck <- normalizer.normalize(detached); detachedCheck.waitForCompletion()
                        passed <- passed and !detachedCheck.failed() and !detachedCheck.symbolicValues() and
                            detached!.pItem!.isNormed and detached!.pItem!.value!.num==7
                    }
                    if(caseID==32){
                        normalizer.addRHS(item, graphScalar(9, 10)); handle.waitForCompletion()
                        passed <- passed and handle.failed() and !target!.pItem!.isNormed and !item!.pItem!.isNormed
                    }
                    if(caseID==8){
                        selected <- normalizer.findItem(target, index); selected.waitForCompletion()
                        passed <- passed and selected.result()===item and target!.repetitionSpan.family!.occurrences.size()==1
                    }
                    if(caseID==9){
                        our POV: otherList <- graphParsed(testName, "many")
                        selected <- normalizer.findItem(otherList, index); selected.waitForCompletion()
                        our POV: other <- selected.result()
                        passed <- passed and other!=NULL and other!==item and other!.pItem!==item!.pItem
                    }
                    if(caseID==17 or caseID==18){
                        our infonView: body <- defs!.pItem!.value!.items.head!.pItem!.funcArgs
                        if(caseID==17){
                            our POV:: changed{916}; changed!.pItem <- body!.value!.listSpec
                            normalizer.addRHS(changed, graphScalar(9, 10))
                        }else{body!.value!.listSpec <- graphScalar(9, 10)!.pItem}
                        checked <- normalizer.normalize(item); checked.waitForCompletion()
                        passed <- passed and checked.failed() and !item!.pItem!.isNormed
                        original <- toString(defs!.pItem)
                    }
                    if(caseID==19){
                        withEach repeat in range 0 .. 3{
                            handle <- normalizer.normalize(target); handle.waitForCompletion()
                            checked <- normalizer.normalize(item); checked.waitForCompletion()
                            passed <- passed and !handle.failed() and !checked.failed() and graphRepeatSetCount(handle)==0 and
                                graphTypeSetCount(checked)==0 and target!.repetitionSpan.family!.occurrences.size()==1
                        }
                    }
                    checked.cancel()
                }
            }
            selected.cancel()
        }
        passed <- passed and toString(defs!.pItem)==original and (caseID==36 or target!.pItem!.wrkList.isEmpty())
        if(!passed){
            print("Template case "+toString(caseID)+": "+handle.error()+"\n"+normalizer.stringifyResult(target)+"\n")
            withEach step in range 0 .. handle.stepCount(){print(handle.stepDescription(step)+"\n")}
        }
        handle.cancel(); normalizer.close()
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }

}

#define GRAPHREPRESENTATION(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphRepresentation(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHREPRESENTATION(unit/graphRepresentation/scalar, 1)
    GRAPHREPRESENTATION(unit/graphRepresentation/list, 2)
    GRAPHREPRESENTATION(unit/graphRepresentation/embedded, 3)
    GRAPHREPRESENTATION(unit/graphRepresentation/nested, 4)
    GRAPHREPRESENTATION(unit/graphRepresentation/unknown, 5)
    GRAPHREPRESENTATION(unit/graphRepresentation/conflict, 6)
    GRAPHREPRESENTATION(unit/graphRepresentation/loose, 7)
    GRAPHREPRESENTATION(unit/graphRepresentation/openTail, 8)
    GRAPHREPRESENTATION(unit/graphRepresentation/cost, 9)
    GRAPHREPRESENTATION(unit/graphRepresentation/lateSize, 10)
    GRAPHREPRESENTATION(unit/graphRepresentation/lateConflict, 11)
    GRAPHREPRESENTATION(unit/graphRepresentation/cancel, 12)
    GRAPHREPRESENTATION(unit/graphRepresentation/sharedInfon, 13)
    GRAPHREPRESENTATION(unit/graphRepresentation/unknownType, 14)
    GRAPHREPRESENTATION(unit/graphRepresentation/extentMismatch, 15)
    GRAPHREPRESENTATION(unit/graphRepresentation/contextual, 16)
    GRAPHREPRESENTATION(unit/graphRepresentation/repeat, 17)
    GRAPHREPRESENTATION(unit/graphRepresentation/lateMemberConflict, 18)
    void: unitTestGraphRepresentation(me string: testName, me int: caseID) <- {
        me GraphNormalizer: normalizer; normalizer.init()
        me string: input <- "_=2"
        me string: expectedText <- "2"
        if(caseID==2 or caseID==18){input <- "{_ _}={2 3}"; expectedText <- "{2 3}"}
        if(caseID==3){input <- "{1 ... 4}={1 2 3 4}"; expectedText <- "{1 &{2 3} 4}"}
        if(caseID==4){input <- "{{1 ... 4} 5}={{1 2 3 4} 5}"; expectedText <- "{{1 &{2 3} 4} 5}"}
        if(caseID==5){input <- "_=_"; expectedText <- "_"}
        if(caseID==6){input <- "2=3"}
        if(caseID==7){input <- "2==2"}
        if(caseID==8){input <- "{_ ...}={2 ...}"; expectedText <- "{2 ... }"}
        if(caseID==9){input <- "2=2"}
        if(caseID==14){input <- "2=missing:2"}
        if(caseID==15){input <- "*2+{1}=*2+{1}"}
        if(caseID==16){input <- "2=%prev"}
        our POV: target <- graphParsed(testName, input)
        our POV: source <- target!.pItem!.wrkList[0]
        me NormalizationHandle: handle
        if(caseID==9){handle <- normalizer.normalizeWithCost(target, 0)}
        else{handle <- normalizer.normalize(target)}
        handle.waitForCompletion()
        me bool: passed <- target!.pItem!.wrkList.size()==1 and !target!.pItem!.isNormed
        if((caseID>=6 and caseID<=7) or caseID==9 or (caseID>=14 and caseID<=16)){
            passed <- passed and !target!.pItem!.workIsRepresented(source)
            if(caseID==6){passed <- passed and handle.failed()}
            else{passed <- passed and !handle.failed() and handle.symbolicValues()}
        }else{
            passed <- passed and !handle.failed() and handle.symbolicValues() and handle.withSubscribers() and
                target!.pItem!.workIsRepresented(source) and toString(target!.pItem)==expectedText
            if(caseID!=2 and caseID!=3 and caseID!=4 and caseID!=18){
                passed <- passed and target!.pItem!.infSize!.evalMode==emUnknown
            }
        }
        if(caseID==10 or caseID==11){
            our POV: more <- graphParsed(testName, "*10+2")
            if(caseID==11){more <- graphParsed(testName, "3")}
            normalizer.addRHS(source, more)
            handle.waitForCompletion()
            if(caseID==10){
                passed <- passed and !handle.failed() and !handle.symbolicValues() and target!.pItem!.isNormed and
                    target!.pItem!.infSize!.num==10 and target!.pItem!.value!.num==2
            }else{passed <- passed and handle.failed() and !target!.pItem!.workIsRepresented(source)}
        }
        if(caseID==12 or caseID==13){
            // Invalidation must not rely on the original process handle or POV
            // staying alive. A second POV can share the same infon storage.
            handle.cancel()
            me NormalizationHandle: released; handle <- released
            our POV:: alias{918}; alias!.pItem <- target!.pItem
            if(caseID==13){target <- NULL}
            normalizer.addRHS(source, graphParsed(testName, "*10+2"))
            passed <- passed and !alias!.pItem!.workIsRepresented(source) and
                alias!.pItem!.infSize!.evalMode==emUnknown
            if(caseID==13){
                handle <- normalizer.normalize(alias); handle.waitForCompletion()
                passed <- passed and !handle.failed() and alias!.pItem!.infSize!.num==10
            }
            target <- alias
        }
        if(caseID==18){
            normalizer.addRHS(source!.pItem!.value!.items.head, graphParsed(testName, "9"))
            handle.waitForCompletion()
            passed <- passed and handle.failed() and !target!.pItem!.workIsRepresented(source)
        }
        if(caseID==17){
            handle <- normalizer.normalize(target); handle.waitForCompletion()
            passed <- passed and !handle.failed() and target!.pItem!.representedWork.size()==1 and
                target!.pItem!.wrkList[0]===source and toString(target!.pItem)==expectedText
        }
        if(!passed){print("Representation case "+toString(caseID)+": "+handle.error()+"\n"+normalizer.stringifyResult(target)+"\n")}
        handle.cancel(); normalizer.close()
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

struct GraphGroupingProbe {
    void: closeSource(their GraphNormalizer: normalizer, our POV: source, me int64: count) <- <%{
        normalizer->runtime.update([&] { normalizer->access->finishTail(source, true, count); });
    }%>
}
#define GRAPHGROUP(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphGrouping(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHGROUP(unit/graphGrouping/pairs, 1)
    GRAPHGROUP(unit/graphGrouping/prefix, 2)
    GRAPHGROUP(unit/graphGrouping/embeddedSource, 3)
    GRAPHGROUP(unit/graphGrouping/triples, 4)
    GRAPHGROUP(unit/graphGrouping/empty, 5)
    GRAPHGROUP(unit/graphGrouping/incompleteGroup, 6)
    GRAPHGROUP(unit/graphGrouping/extentConflict, 7)
    GRAPHGROUP(unit/graphGrouping/templateConflict, 8)
    GRAPHGROUP(unit/graphGrouping/prefixConflictAtomic, 9)
    GRAPHGROUP(unit/graphGrouping/cost, 10)
    GRAPHGROUP(unit/graphGrouping/demandedOccurrence, 11)
    GRAPHGROUP(unit/graphGrouping/normalizedOccurrence, 12)
    GRAPHGROUP(unit/graphGrouping/lateValue, 13)
    GRAPHGROUP(unit/graphGrouping/cancel, 14)
    GRAPHGROUP(unit/graphGrouping/repeat, 15)
    GRAPHGROUP(unit/graphGrouping/lateConflict, 16)
    GRAPHGROUP(unit/graphGrouping/unorderedDeferred, 17)
    GRAPHGROUP(unit/graphGrouping/contextDeferred, 18)
    GRAPHGROUP(unit/graphGrouping/lateClosure, 19)
    GRAPHGROUP(unit/graphGrouping/namedDefinition, 20)
    GRAPHGROUP(unit/graphGrouping/prefixMatchDeferred, 21)
    GRAPHGROUP(unit/graphGrouping/nestedGroupDeferred, 22)
    GRAPHGROUP(unit/graphGrouping/aliasOccurrence, 23)
    GRAPHGROUP(unit/graphGrouping/duplicateOccurrenceDeferred, 24)
    GRAPHGROUP(unit/graphGrouping/templateChange, 25)
    GRAPHGROUP(unit/graphGrouping/fullyKnown, 26)
    GRAPHGROUP(unit/graphGrouping/prefixExtentConflict, 27)
    void: unitTestGraphGrouping(me string: testName, me int: caseID) <- {
        me string: expression <- "{{_ _}|...} == {1 2 3 4}"
        me string: expectedText <- "{{1 2} {3 4}}"
        if(caseID==2){expression <- "{{_ _}|{_ _} ...} == {1 2 3 4}"}
        if(caseID==3){expression <- "{{_ _}|...} == {1 &{2 3} 4}"}
        if(caseID==4){expression <- "{{_ _ _}|...} == {1 2 3 4 5 6}"; expectedText <- "{{1 2 3} {4 5 6}}"}
        if(caseID==5){expression <- "{{_ _}|...} == {}"; expectedText <- "{}"}
        if(caseID==6){expression <- "{{_ _}|...} == {1 2 3}"}
        if(caseID==7){expression <- "*3+{{_ _}|...} == {1 2 3 4}"}
        if(caseID==8){expression <- "{{1 _}|...} == {1 2 3 4}"}
        if(caseID==9){expression <- "{{_ _}|{_ _} {_ 9} ...} == {1 2 3 4}"}
        if(caseID==11 or caseID==12 or caseID==23 or caseID==24){expression <- "*2+{{_ _}|...}"}
        if(caseID==13 or caseID==14){expression <- "{{_ _}|...} == {1 _ 3 4}"}
        if(caseID==17){expression <- "{{_ _}|...} == {1, 2, 3, 4}"}
        if(caseID==18){expression <- "{{%prev _}|...} == {1 2 3 4}"}
        if(caseID==19){expression <- "{{_ _}|...} == {1 2 3 4 ...}"}
        if(caseID==20){expression <- "pairs == {1 2 3 4}"}
        if(caseID==21){expression <- "{{_ _}|...} ==: {1 2 3 4}"}
        if(caseID==22){expression <- "{{{_ _} {_ _}}|...} == {1 2 3 4}"}
        if(caseID==26){expression <- "{{*10+_ *10+_}|...} == {*10+1 *10+2 *10+3 *10+4}"; expectedText <- "{{*10+1 *10+2} {*10+3 *10+4}}"}
        me GraphNormalizer: normalizer; normalizer.init()
        me string: declarations <- "{#pair={_ _} #pairs={pair|...}}"
        if(caseID==27){declarations <- "{#pair={_ _} #pairs=*0+{pair|...}}"; expression <- "pairs:{{_ _} ...} == {}"}
        our POV: defs <- graphParsed(testName, declarations)
        me NormalizationHandle: declared <- normalizer.normalize(defs); declared.waitForCompletion()
        me string: originalDefinitions <- toString(defs!.pItem)
        our POV: target <- graphParsed(testName, expression)
        our POV: originalPrefix <- target!.pItem!.value!.items.head
        our POV: source
        our POV: occurrence
        our POV: secondOccurrence
        me bool: passed <- !declared.failed()
        if(caseID==11 or caseID==12 or caseID==23 or caseID==24){
            our POV:: alias{919}; alias!.pItem <- target!.pItem
            our POV: owner <- target
            if(caseID==23 or caseID==24){owner <- alias}
            me NormalizationHandle: indexed <- normalizer.findItem(owner, 1); indexed.waitForCompletion()
            occurrence <- indexed.result()
            passed <- passed and occurrence!=NULL and !indexed.failed()
            if(caseID==12){
                me NormalizationHandle: child <- normalizer.normalize(occurrence); child.waitForCompletion()
                passed <- passed and !child.failed() and occurrence!.pItem!.value!.items.size()==2
            }
            if(caseID==24){
                indexed <- normalizer.findItem(target, 1); indexed.waitForCompletion()
                secondOccurrence <- indexed.result()
                passed <- passed and secondOccurrence!=NULL and secondOccurrence!==occurrence
            }
            source <- graphParsed(testName, "{1 2 3 4}"); source!.looseMode <- true
            normalizer.addRHS(target, source)
        }else{source <- target!.pItem!.wrkList[0]}
        me string: originalSource <- toString(source!.pItem)
        me NormalizationHandle: handle
        if(caseID==10){handle <- normalizer.normalizeWithCost(target, 1)}
        else{handle <- normalizer.normalize(target)}
        handle.waitForCompletion()
        passed <- passed and toString(source!.pItem)==originalSource
        if((caseID>=6 and caseID<=9) or caseID==27){
            passed <- passed and handle.failed()
            if(caseID==27){passed <- passed and target!.pItem!.value!.tailUnfinished and
                target!.pItem!.value!.listSpec==NULL and target!.pItem!.infSize!.evalMode==emUnknown and
                target!.pItem!.value!.items.head===originalPrefix}
            else if(caseID==9){passed <- passed and target!.pItem!.value!.items.head===originalPrefix and
                originalPrefix!.pItem!.value!.items.head!.pItem!.value!.evalMode==emUnknown}
            else{passed <- passed and target!.pItem!.value!.items.isEmpty()}
        }else if(caseID==10 or caseID==17 or caseID==18 or caseID==19 or caseID==21 or caseID==22 or caseID==24){
            passed <- passed and !handle.failed() and handle.symbolicValues() and handle.withSubscribers() and
                target!.pItem!.value!.items.isEmpty() and !target!.pItem!.workIsRepresented(source)
            if(caseID==24){passed <- passed and occurrence!==secondOccurrence}
        }else{
            passed <- passed and !handle.failed() and !target!.pItem!.value!.tailUnfinished and
                target!.pItem!.infSize!.num==target!.pItem!.value!.items.size() and
                target!.pItem!.wrkList.size()==1
            if(caseID==5 or caseID==26){passed <- passed and !handle.symbolicValues() and target!.pItem!.isNormed}
            else{passed <- passed and handle.symbolicValues() and !target!.pItem!.isNormed and
                (target!.pItem!.value!.items.head!.pItem!.infSize!.num==2 or (caseID==4 and target!.pItem!.value!.items.head!.pItem!.infSize!.num==3)) and target!.pItem!.value!.items.size()==2}
            if(caseID!=13 and caseID!=14 and caseID!=20){passed <- passed and toString(target!.pItem)==expectedText}
            if(caseID==2){passed <- passed and target!.pItem!.value!.items.head===originalPrefix}
            if(caseID==11 or caseID==12 or caseID==23){
                passed <- passed and target!.pItem!.value!.items.tail===occurrence
                me NormalizationHandle: indexed <- normalizer.findItem(target, 1); indexed.waitForCompletion()
                passed <- passed and indexed.result()===occurrence
            }
        }
        if(caseID==13 or caseID==14){
            if(caseID==14){handle.cancel()}
            normalizer.addRHS(source!.pItem!.value!.items.head!.next, graphParsed(testName, "2"))
            handle.waitForCompletion()
            if(caseID==13){passed <- passed and !handle.failed() and toString(target!.pItem)==expectedText}
            else{passed <- passed and target!.pItem!.value!.items.head!.pItem!.value!.items.tail!.pItem!.value!.evalMode==emUnknown}
        }
        if(caseID==15){
            our POV: first <- target!.pItem!.value!.items.head
            me int: identities <- normalizer.access!.registry!.identities.size()
            handle <- normalizer.normalize(target); handle.waitForCompletion()
            passed <- passed and !handle.failed() and target!.pItem!.value!.items.head===first and
                normalizer.access!.registry!.identities.size()==identities and toString(target!.pItem)==expectedText
        }
        if(caseID==16){
            normalizer.addRHS(source!.pItem!.value!.items.head, graphParsed(testName, "9"))
            handle.waitForCompletion()
            passed <- passed and handle.failed() and !target!.pItem!.workIsRepresented(source)
        }
        if(caseID==19){
            me GraphGroupingProbe: probe; probe.closeSource(normalizer, source, 4)
            handle.waitForCompletion()
            passed <- passed and !handle.failed() and toString(target!.pItem)==expectedText
        }
        if(caseID==20){passed <- passed and target!.pItem!.value!.items.head!.pItem!.type!.typeID()=="pair"}
        if(caseID==25){
            our POV: templateMember <- target!.pItem!.value!.listSpec!.value!.items.head
            normalizer.addRHS(templateMember, graphParsed(testName, "9")); handle.waitForCompletion()
            passed <- passed and handle.failed() and !target!.pItem!.representedTemplate!.valid and
                !target!.pItem!.workIsRepresented(source)
        }
        if(caseID==1){passed <- passed and normalizer.access!.registry!.identities.size()==4 and
            !normalizer.access!.hasDirectIdentity(target, source)}
        passed <- passed and toString(defs!.pItem)==originalDefinitions
        if(!passed){
            print("Grouping case "+toString(caseID)+": "+handle.error()+"\n"+normalizer.stringifyResult(target)+"\n")
            withEach step in range 0 .. handle.stepCount(){print(handle.stepDescription(step)+"\n")}
        }
        handle.cancel(); normalizer.close()
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

// The adapter describes stored relationships independently of search goals.
#define GRAPHVIEW(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphPOVDescription(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHVIEW(unit/graphAdapter/structure, 1)
    GRAPHVIEW(unit/graphAdapter/unresolvedWork, 2)
    GRAPHVIEW(unit/graphAdapter/registryDirections, 3)
    GRAPHVIEW(unit/graphAdapter/distinctRelationships, 4)
    GRAPHVIEW(unit/graphAdapter/liveWorkAndStorage, 5)
    GRAPHVIEW(unit/graphAdapter/viewContext, 6)
    GRAPHVIEW(unit/graphAdapter/lateIdentity, 7)
    GRAPHVIEW(unit/graphAdapter/sharedGoals, 8)
    GRAPHVIEW(unit/graphAdapter/virtualMembers, 9)
    GRAPHVIEW(unit/graphAdapter/newVirtualRoute, 10)
    me bool: graphPOVDescriptionCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer normalizer; normalizer.init();
        auto access = normalizer.access;
        auto target = graphParsed(testName, caseID == 1 ? "{1 2}" : "_");
        auto source = graphParsed(testName, "*10+7");
        auto other = graphParsed(testName, "*10+8");
        using proteus4::POVDescription;
        POVDescription view(target, access->registry.get());
        bool passed = false;
        if (caseID == 1) {
            auto first = view.member(), last = view.member(true);
            normalizer.runtime.update([&] { first->pParent = target.get(); first->altPOV = source; first->outerPOV = other; });
            POVDescription item(first);
            passed = first != last && item.adjacent() == last && POVDescription(last).adjacent(true) == first &&
                item.parent() == target.get() && item.alternative() == source && item.outer() == other &&
                view.size() == target->pItem->infSize && view.value() == target->pItem->value;
        } else if (caseID == 2) {
            target = graphParsed(testName, "_ == {1 2}");
            POVDescription described(target, access->registry.get());
            auto rhs = described.work()[0];
            normalizer.prepareInput(rhs->pItem);
            auto relations = described.relationships();
            passed = relations.size() == 1 && relations[0].isWork() && relations[0].target == rhs &&
                access->wholeLooseRHS(relations[0].target) && access->inputPending(relations[0].target);
        } else if (caseID == 3) {
            normalizer.recordIdentity(target, source); normalizer.recordIdentity(source, target);
            auto forward = view.relationships(false);
            auto inverse = POVDescription(source, access->registry.get()).relationships(false);
            passed = forward.size() == 1 && inverse.size() == 1 && forward[0].target == source &&
                inverse[0].target == target && forward[0].identity == inverse[0].identity &&
                forward[0].identity == access->registry->identities[0] &&
                forward[0].identity->evidenceKind == iekAssertion;
        } else if (caseID == 4) {
            normalizer.addRHS(target, source); normalizer.recordIdentity(target, source);
            passed = true;
            for (int i=0; i<5; ++i) {
                auto relations = view.relationships();
                passed &= relations.size() == 2 && relations[0].isWork() && !relations[1].isWork() &&
                    relations[0].target == source && relations[1].target == source;
            }
            passed &= access->registry->identities.size() == 1 && target->pItem->wrkList.size() == 1;
        } else if (caseID == 5) {
            passed = view.work().empty();
            normalizer.addRHS(target, source);
            passed &= view.work().size() == 1 && view.work()[0] == source;
            normalizer.addRHS(other, source);
            normalizer.runtime.update([&] { target->pItem = other->pItem; });
            passed &= view.value() == other->pItem->value && &view.work() == &other->pItem->wrkList &&
                view.relationships()[0].owner == target;
        } else if (caseID == 6) {
            auto alias = std::make_shared<POV>(); alias->pItem = target->pItem;
            normalizer.runtime.update([&] { target->next = source; alias->next = other; });
            normalizer.addRHS(target, source); normalizer.recordIdentity(target, other);
            POVDescription aliasView(alias, access->registry.get());
            passed = view.adjacent() == source && aliasView.adjacent() == other &&
                view.relationships().size() == 2 && aliasView.relationships().size() == 1 &&
                aliasView.relationships()[0].owner == alias && aliasView.work()[0] == source;
        } else if (caseID == 7) {
            auto handle = normalizer.normalize(target); handle.waitForCompletion();
            passed = handle.status().symbolicValues && view.relationships().empty();
            normalizer.recordIdentity(target, source); handle.waitForCompletion();
            passed &= !handle.status().failed && !handle.status().symbolicValues && target->pItem->value->num == 7 &&
                view.relationships(false).size() == 1;
            handle.cancel();
        } else if (caseID == 8) {
            normalizer.recordIdentity(target, source);
            auto size = normalizer.runtime.normalize({target, proteus4::sizeOnly, 0});
            auto value = normalizer.runtime.normalize({target, proteus4::valueOnly, 0});
            size.waitForCompletion(); value.waitForCompletion();
            passed = !size.status().failed && !value.status().failed && access->known(target) == 3 &&
                view.relationships(false).size() == 1 && access->registry->identities.size() == 1;
            size.cancel(); value.cancel();
        } else if (caseID == 9) {
            target = graphParsed(testName, "*1000000000+{*10+_|...}");
            POVDescription sparse(target, access->registry.get());
            passed = sparse.hasVirtualMembers() && sparse.virtualExtent() == 1000000000 &&
                sparse.memberSpecification() && !sparse.member() && !sparse.existingOccurrence(999999999) &&
                access->registry->repetitionFamilies.empty();
            auto selected = normalizer.findItem(target, 999999999); selected.waitForCompletion();
            passed &= !selected.status().failed && selected.result() &&
                sparse.existingOccurrence(999999999) == selected.result() && !sparse.member() &&
                target->repetitionSpan.family->occurrences.size() == 1;
            selected.cancel();
        } else if (caseID == 10) {
            target = graphParsed(testName, "{*10+_|...}");
            other = graphParsed(testName, "*1000000000+_");
            POVDescription sparse(target, access->registry.get());
            passed = sparse.memberSpecification() && !sparse.hasVirtualMembers();
            normalizer.runtime.update([&] { target->pItem->infSize = other->pItem->infSize; });
            passed &= sparse.hasVirtualMembers() && sparse.virtualExtent() == 1000000000 &&
                !sparse.member() && access->registry->repetitionFamilies.empty();
        }
        normalizer.close();
        return passed;
    }%>
    void: unitTestGraphPOVDescription(me string: testName, me int: caseID) <- {
        me bool: passed <- graphPOVDescriptionCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

// Size facts constrain virtual positions without constructing their members.
#define GRAPHVIRTUAL(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphVirtualShape(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHVIRTUAL(unit/graphVirtualShape/pairs, 1)
    GRAPHVIRTUAL(unit/graphVirtualShape/triples, 2)
    GRAPHVIRTUAL(unit/graphVirtualShape/emptySource, 3)
    GRAPHVIRTUAL(unit/graphVirtualShape/incompleteGroup, 4)
    GRAPHVIRTUAL(unit/graphVirtualShape/groupExtentConflict, 5)
    GRAPHVIRTUAL(unit/graphVirtualShape/billionLazy, 6)
    GRAPHVIRTUAL(unit/graphVirtualShape/namedShape, 7)
    GRAPHVIRTUAL(unit/graphVirtualShape/existingMembers, 8)
    GRAPHVIRTUAL(unit/graphVirtualShape/instanceExtentConflict, 9)
    GRAPHVIRTUAL(unit/graphVirtualShape/conjunction, 10)
    GRAPHVIRTUAL(unit/graphVirtualShape/reverseConjunction, 11)
    GRAPHVIRTUAL(unit/graphVirtualShape/repeatedConjunction, 12)
    GRAPHVIRTUAL(unit/graphVirtualShape/namedGroups, 13)
    GRAPHVIRTUAL(unit/graphVirtualShape/lateExtent, 14)
    GRAPHVIRTUAL(unit/graphVirtualShape/cancelExtent, 15)
    GRAPHVIRTUAL(unit/graphVirtualShape/cost, 16)
    GRAPHVIRTUAL(unit/graphVirtualShape/repeat, 17)
    GRAPHVIRTUAL(unit/graphVirtualShape/changedExtent, 18)
    GRAPHVIRTUAL(unit/graphVirtualShape/zeroWidth, 19)
    GRAPHVIRTUAL(unit/graphVirtualShape/zeroShape, 20)
    GRAPHVIRTUAL(unit/graphVirtualShape/fractionalDeferred, 21)
    GRAPHVIRTUAL(unit/graphVirtualShape/hugeExtentDeferred, 22)

    GRAPHVIRTUAL(unit/graphVirtualShape/scalarRHSConflict, 23)
    GRAPHVIRTUAL(unit/graphVirtualShape/demandedGroup, 24)
    GRAPHVIRTUAL(unit/graphVirtualShape/strictCorrespondence, 25)
    GRAPHVIRTUAL(unit/graphVirtualShape/typedGroups, 26)
    GRAPHVIRTUAL(unit/graphVirtualShape/closedBodyConflict, 27)
    GRAPHVIRTUAL(unit/graphVirtualShape/typedDemandedMemberDeferred, 28)
    GRAPHVIRTUAL(unit/graphVirtualShape/billionGroupMismatch, 29)
    GRAPHVIRTUAL(unit/graphVirtualShape/billionGroupEmpty, 30)
    me bool: graphVirtualShapeCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer normalizer; normalizer.init();
        std::string declarations = "{#row=*2+{...}}";
        std::string expression = "{*2+{...}|...} == {1 2 3 4}";
        std::string expected = "{{1 2} {3 4}}";
        if (caseID == 2) { expression = "{*3+{...}|...} == {1 2 3 4 5 6}"; expected = "{{1 2 3} {4 5 6}}"; }
        if (caseID == 3) { expression = "{*2+{...}|...} == {}"; expected = "{}"; }
        if (caseID == 4) expression = "{*2+{...}|...} == {1 2 3}";
        if (caseID == 5) expression = "*3+{*2+{...}|...} == {1 2 3 4}";
        if (caseID == 6) { declarations = "{#row=*1000000000+{...}}"; expression = "row"; }
        if (caseID == 7) expression = "row";
        if (caseID == 8) expression = "row:{*10+1 *10+2}";
        if (caseID == 9) expression = "row:{*10+1}";
        if (caseID == 10) { declarations = "{#row=*2+{...} = {*10+1 *10+2}}"; expression = "row"; }
        if (caseID == 11) { declarations = "{#row={*10+1 *10+2} = *2+{...}}"; expression = "row"; }
        if (caseID == 12) { declarations = "{#row=*2+{...} = {*10+_|...}}"; expression = "row"; }
        if (caseID == 13) { declarations = "{#row=*2+{...} #rows={row|...}}"; expression = "rows == {1 2 3 4}"; }
        if (caseID == 14 || caseID == 15 || caseID == 23) { declarations = "{#row={...}}"; expression = "{row|...} == {1 2 3 4}"; }
        if (caseID == 18) expression = "{row|...} == {1 2 3 4 5 6}";
        if (caseID == 19) expression = "{*0+{...}|...} == {}";
        if (caseID == 20) { declarations = "{#row=*0+{...}}"; expression = "row"; }
        if (caseID == 21) expression = "{*1.5+{...}|...} == {1 2 3}";
        if (caseID == 22) expression = "{*9223372036854775808+{...}|...} == {1 2 3}";
        if (caseID == 24) expression = "*2+{*2+{...}|...}";
        if (caseID == 25) expression = "row = {*10+1 *10+2}";
        if (caseID == 26) { expression = "{*2+{*10+_|...}|...} == {*10+1 *10+2 *10+3 *10+4}"; expected = "{{*10+1 *10+2} {*10+3 *10+4}}"; }
        if (caseID == 27) expression = "row";
        if (caseID == 28) expression = "*2+{*2+{*10+_|...}|...}";
        if (caseID == 29) expression = "{*1000000000+{...}|...} == {1 2}";
        if (caseID == 30) { expression = "{*1000000000+{...}|...} == {}"; expected = "{}"; }
        auto defs = graphParsed(testName, declarations);
        auto declared = normalizer.normalize(defs); declared.waitForCompletion();
        auto body = normalizer.access->definitionBody(defs->pItem->value->items.head);
        auto before = normalizer.stringifyResult(defs);
        auto target = graphParsed(testName, expression);
        auto first = target->pItem->value->items.head;
        auto source = target->pItem->wrkList.empty() ? std::shared_ptr<POV>{} : target->pItem->wrkList[0];
        std::shared_ptr<POV> occurrence, demandedMember;
        if (caseID == 24 || caseID == 28) {
            auto lookup = normalizer.findItem(target, 1); lookup.waitForCompletion(); occurrence = lookup.result();
            if (!occurrence || lookup.status().failed) { normalizer.close(); return false; }
            auto child = normalizer.normalize(occurrence); child.waitForCompletion();
            if (child.status().failed || !occurrence->pItem->value->items.isEmpty()) { normalizer.close(); return false; }
            if (caseID == 28) {
                auto inner = normalizer.findItem(occurrence, 1); inner.waitForCompletion(); demandedMember = inner.result();
                if (!demandedMember || inner.status().failed) { normalizer.close(); return false; }
                inner.cancel();
            }
            source = graphParsed(testName, "{1 2 3 4}");
            SetFlagBit(source->flags, POV::looseMode, true);
            normalizer.addRHS(target, source);
            child.cancel(); lookup.cancel();
        }
        auto sourceBefore = source ? normalizer.stringifyResult(source) : "";
        auto handle = caseID == 16 ? normalizer.normalizeWithCost(target, 1) : normalizer.normalize(target);
        handle.waitForCompletion();
        bool passed = !declared.status().failed;
        if (caseID == 4 || caseID == 5 || caseID == 9 || caseID == 29) {
            passed &= handle.status().failed && target->pItem->value->items.head == first;
        } else if (caseID == 6 || caseID == 7 || caseID == 12 || caseID == 27) {
            passed &= !handle.status().failed && handle.status().symbolicValues &&
                target->pItem->infSize->num == (caseID == 6 ? 1000000000 : 2) &&
                target->pItem->value->items.isEmpty() && normalizer.access->registry->repetitionFamilies.empty();
            if (caseID == 12) passed &= bool(target->pItem->value->listSpec);
            else passed &= !target->pItem->value->listSpec;
        } else if (caseID == 8 || caseID == 10 || caseID == 11 || caseID == 20 || caseID == 25) {
            passed &= !handle.status().failed && !handle.status().symbolicValues &&
                target->pItem->value->items.size() == (caseID == 20 ? 0 : 2) &&
                target->pItem->infSize->num == (caseID == 20 ? 0 : 2);
            if (caseID == 8) passed &= target->pItem->value->items.head == first;
        } else if (caseID == 14 || caseID == 15 || caseID == 23) {
            passed &= !handle.status().failed && handle.status().symbolicValues &&
                target->pItem->value->items.isEmpty();
            if (caseID == 15) handle.cancel();
            auto sizeRHS = graphParsed(testName, caseID == 23 ? "*2+_" : "*2+{...}");
            normalizer.addRHS(body, sizeRHS); handle.waitForCompletion();
            if (caseID == 14) passed &= !handle.status().failed && target->pItem->value->items.size() == 2 &&
                target->pItem->value->items.head->pItem->value->items.size() == 2;
            else passed &= target->pItem->value->items.isEmpty();
            if (caseID == 23) passed &= handle.status().failed;
            // The definition itself is still symbolic; only its constraints were read.
            passed &= body->pItem->value->items.isEmpty() && normalizer.access->listExtent(body) == -1;
        } else if (caseID == 16 || caseID == 19 || caseID == 21 || caseID == 22 || caseID == 28) {
            passed &= !handle.status().failed && handle.status().symbolicValues &&
                target->pItem->value->items.isEmpty() && normalizer.access->registry->identities.empty();
        } else {
            passed &= !handle.status().failed && target->pItem->value->items.size() == (caseID == 3 || caseID == 30 ? 0 : caseID == 18 ? 3 : 2);
            if (caseID != 13 && caseID != 18) passed &= toString(target->pItem.get()) == expected;
            if (caseID == 13) passed &= target->pItem->value->items.head->pItem->type->typeID() == "row";
        }
        if (caseID == 28) passed &= occurrence->pItem->value->items.isEmpty() &&
            normalizer.access->existingSparseItem(occurrence, 1) == demandedMember &&
            !(normalizer.access->known(demandedMember) & proteus4::valueOnly);
        if (caseID == 24) passed &= target->pItem->value->items.tail == occurrence &&
            occurrence->pItem->value->items.size() == 2;
        if (caseID == 27) {
            normalizer.runtime.update([&] { normalizer.access->finishTail(body, true, 2); });
            handle.waitForCompletion(); passed &= handle.status().failed;
        }
        if (caseID == 17) {
            auto prior = target->pItem->value->items.head;
            auto identities = normalizer.access->registry->identities.size();
            handle.cancel(); handle = normalizer.normalize(target); handle.waitForCompletion();
            passed &= !handle.status().failed && target->pItem->value->items.head == prior &&
                normalizer.access->registry->identities.size() == identities;
        }
        if (caseID == 18) {
            auto extent = graphParsed(testName, "*3+_");
            normalizer.runtime.update([&] { body->pItem->infSize = extent->pItem->infSize; });
            handle.waitForCompletion();
            passed &= handle.status().failed;
        }
        if (source) passed &= normalizer.stringifyResult(source) == sourceBefore;
        if (caseID != 14 && caseID != 15 && caseID != 18 && caseID != 23 && caseID != 27) passed &= normalizer.stringifyResult(defs) == before;
        if (!passed) std::cout << "Virtual shape case " << caseID << ": " << handle.status().error << "\n" << normalizer.stringifyResult(target) << "\n";
        handle.cancel(); normalizer.close();
        return passed;
    }%>
    void: unitTestGraphVirtualShape(me string: testName, me int: caseID) <- {
        me bool: passed <- graphVirtualShapeCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

// Relative references bind occurrences; scalar/list resolution stays shared.
#define GRAPHRELATIVE(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphRelative(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHRELATIVE(unit/graphRelative/sparseLazyPrev, 25)
    GRAPHRELATIVE(unit/graphRelative/sparseLazyNext, 26)
    GRAPHRELATIVE(unit/graphRelative/lateSize, 27)
    GRAPHRELATIVE(unit/graphRelative/independentMember, 28)
    GRAPHRELATIVE(unit/graphRelative/sharedPOV, 30)
    GRAPHRELATIVE(unit/graphRelative/nextBoundary, 31)
    GRAPHRELATIVE(unit/graphRelative/namedConflict, 32)
    GRAPHRELATIVE(unit/graphRelative/namedConsistent, 33)
    GRAPHRELATIVE(unit/graphRelative/prev, 1)
    GRAPHRELATIVE(unit/graphRelative/next, 2)
    GRAPHRELATIVE(unit/graphRelative/chain, 3)
    GRAPHRELATIVE(unit/graphRelative/rhsPrev, 4)
    GRAPHRELATIVE(unit/graphRelative/rhsNext, 5)
    GRAPHRELATIVE(unit/graphRelative/nested, 7)
    GRAPHRELATIVE(unit/graphRelative/listNeighbor, 8)
    GRAPHRELATIVE(unit/graphRelative/lateValue, 9)
    GRAPHRELATIVE(unit/graphRelative/cancel, 10)
    GRAPHRELATIVE(unit/graphRelative/lateNeighbor, 11)
    GRAPHRELATIVE(unit/graphRelative/cycle, 12)
    GRAPHRELATIVE(unit/graphRelative/boundary, 13)
    GRAPHRELATIVE(unit/graphRelative/temporalDeferred, 14)
    GRAPHRELATIVE(unit/graphRelative/partsDeferred, 15)
    GRAPHRELATIVE(unit/graphRelative/sparsePrev, 16)
    GRAPHRELATIVE(unit/graphRelative/sparseNext, 17)
    GRAPHRELATIVE(unit/graphRelative/sparseBoundary, 18)
    GRAPHRELATIVE(unit/graphRelative/sparseCost, 19)
    GRAPHRELATIVE(unit/graphRelative/repeat, 20)
    GRAPHRELATIVE(unit/graphRelative/conflict, 21)
    GRAPHRELATIVE(unit/graphRelative/sharedContext, 22)
    GRAPHRELATIVE(unit/graphRelative/changedNeighbor, 23)
    GRAPHRELATIVE(unit/graphRelative/embeddedDeferred, 24)

    me bool: graphRelativeCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer normalizer; normalizer.init();
        using proteus4::POVDescription;
        std::string expression = "{*10+1 %prev}", expected = "{*10+1 *10+1}";
        switch (caseID) {
        case 2: expression="{%next *10+2}"; expected="{*10+2 *10+2}"; break;
        case 3: expression="{%next %next *10+3}"; expected="{*10+3 *10+3 *10+3}"; break;
        case 4: expression="{*10+1 _ = %prev}"; expected="{*10+1 *10+1}"; break;
        case 5: expression="{_ = %next *10+2}"; expected="{*10+2 *10+2}"; break;
        case 7: expression="{*10+9 {*10+2 %prev}}"; expected="{*10+9 {*10+2 *10+2}}"; break;
        case 8: expression="{{*10+1 *10+2} %prev}"; expected="{{*10+1 *10+2} {*10+1 *10+2}}"; break;
        case 9: case 10: expression="{_ %prev}"; expected="{*10+7 *10+7}"; break;
        case 11: expression="{%next ...}"; expected="{*10+7 *10+7}"; break;
        case 12: expression="{%next %prev}"; break;
        case 13: expression="{%prev}"; break;
        case 14: expression="{1 %tprev}"; break;
        case 15: expression="{1 %prev.foo}"; break;
        case 27: expression="{*_+7 %prev}"; expected="{*10+7 *10+7}"; break;
        case 31: expression="{%next}"; break;
        case 32: case 33: expression="pair:{*10+_ %prev}"; expected="pair:{*10+1 *10+1}"; break;
        case 24: expression="{&{1 2 ...} %prev}"; break;
        }
        auto owner = graphParsed(testName, expression);
        auto first = POVDescription(owner).member(), last = POVDescription(owner).member(true);
        auto target = owner;
        proteus4::POVNode source;
        if ((caseID >= 16 && caseID <= 19) || caseID==25 || caseID==26) {
            owner = graphParsed(testName, "*1000000000+{*10+_|...}");
            auto indexed = normalizer.findItem(owner, caseID==18 ? 0 : 999999998);
            indexed.waitForCompletion(); target = indexed.result();
            if (!target) { normalizer.close(); return false; }
            auto cursor = graphParsed(testName, (caseID==17 || caseID==26) ? "%next" : "%prev");
            normalizer.addRHS(target, cursor);
            if (caseID != 18 && caseID!=25 && caseID!=26) {
                auto neighbor = normalizer.findItem(owner, caseID==17 ? 999999999 : 999999997);
                neighbor.waitForCompletion(); source = neighbor.result();
                normalizer.addRHS(source, graphParsed(testName, "*10+7"));
            }
        }
        if (caseID == 22) {
            auto cursor = graphParsed(testName, "%prev");
            owner = graphParsed(testName, "{1 _ 2 _}"); target = owner;
            first = POVDescription(owner).member(); last = POVDescription(owner).member(true);
            normalizer.addRHS(first->next, cursor); normalizer.addRHS(last, cursor);
        }
        proteus4::POVNode definitions;
        std::string originalDefinitions;
        if (caseID==32 || caseID==33) {
            definitions = graphParsed(testName, caseID==32 ? "{#pair={*10+1 *10+2}}" : "{#pair={*10+1 *10+1}}");
            originalDefinitions = toString(definitions->pItem.get());
            auto declared = normalizer.normalize(definitions); declared.waitForCompletion();
        }
        if (caseID==28) { target=last; expected="*10+1"; }
        auto handle = caseID==19 ? normalizer.normalizeWithCost(target, 1) : normalizer.normalize(target);
        handle.waitForCompletion();
        bool passed = !handle.status().failed;
        auto unknown = [](const proteus4::POVNode& node) { return getModeBits(node->pItem->value->flags, infonState::evalMode) == infonState::emUnknown; };
        if (caseID==9 || caseID==10) {
            passed &= handle.status().symbolicValues && handle.status().withSubscribers && unknown(last);
            if (caseID==10) handle.cancel();
            normalizer.addRHS(first, graphParsed(testName, "*10+7")); handle.waitForCompletion();
            if (caseID==10) passed &= handle.status().cancelled && unknown(last);
            else passed &= !handle.status().failed && toString(target->pItem.get())==expected;
        } else if (caseID==11) {
            passed &= handle.status().symbolicValues && handle.status().withSubscribers;
            auto neighbor = graphParsed(testName, "*10+7");
            normalizer.runtime.update([&] {
                SetModeBits(neighbor->pItem->flags, infonView::itmMode, infonView::mItem);
                owner->pItem->value->items.appendPov(neighbor);
                SetFlagBit(owner->pItem->value->flags, infonState::tailUnfinished, false);
                owner->pItem->value->sizeMode = fromCount;
            });
            handle.waitForCompletion();
            passed &= !handle.status().failed && toString(target->pItem.get())==expected;
        } else if ((caseID>=12 && caseID<=15) || caseID==18 || caseID==19 || caseID==24 || caseID==31) {
            passed &= handle.status().symbolicValues && handle.status().withSubscribers && !getFlagBit(target->pItem->flags, infonView::isNormed);
        } else if (caseID==16 || caseID==17) {
            passed &= target->pItem->value->num==7 && target->pItem->infSize->num==10 &&
                owner->pItem->value->items.size()==0 && owner->repetitionSpan.family->occurrences.size()==2;
        } else if (caseID==25 || caseID==26) {
            auto neighbor = normalizer.access->existingSparseItem(owner, caseID==26 ? 999999999 : 999999997);
            passed &= handle.status().symbolicValues && neighbor &&
                owner->pItem->value->items.size()==0 && owner->repetitionSpan.family->occurrences.size()==2;
            normalizer.addRHS(neighbor, graphParsed(testName, "*10+7")); handle.waitForCompletion();
            passed &= !handle.status().failed && target->pItem->value->num==7;
        } else if (caseID==27) {
            passed &= handle.status().symbolicValues && normalizer.access->known(last)==2;
            normalizer.addRHS(first, graphParsed(testName, "*10+_")); handle.waitForCompletion();
            passed &= !handle.status().failed && !handle.status().symbolicValues &&
                normalizer.access->known(last)==3 && toString(target->pItem.get())==expected;

        } else if (caseID==32) {
            passed = handle.status().failed && !getFlagBit(target->pItem->flags, infonView::isNormed) &&
                handle.status().error.find("incompatible scalar constraints")!=std::string::npos;
        } else if (caseID==22) {
            passed = handle.status().failed && handle.status().error.find("different occurrence contexts")!=std::string::npos;
        } else {
            passed &= !handle.status().symbolicValues && getFlagBit(target->pItem->flags, infonView::isNormed) && toString(target->pItem.get())==expected;
        }
        if (definitions) passed &= toString(definitions->pItem.get())==originalDefinitions && target->pItem->wrkList.empty();
        if (caseID==20) {
            auto count = normalizer.access->registry->identities.size();
            auto again = normalizer.normalize(target); again.waitForCompletion();
            passed &= !again.status().failed && !again.status().symbolicValues &&
                normalizer.access->registry->identities.size()==count;
        }
        if (caseID==21) {
            normalizer.addRHS(first, graphParsed(testName, "*10+2"));
            auto again = normalizer.normalize(target); again.waitForCompletion();
            passed &= again.status().failed && !getFlagBit(target->pItem->flags, infonView::isNormed);
        }
        if (caseID==30) {
            auto alias = std::make_shared<POV>(921); alias->pItem = last->pItem;
            alias->prev = graphParsed(testName, "*10+2");
            auto again = normalizer.normalize(alias); again.waitForCompletion();
            passed &= again.status().failed && again.status().error.find("different occurrence contexts")!=std::string::npos;
        }
        if (caseID==23) {
            auto other = graphParsed(testName, "*10+2");
            normalizer.runtime.update([&] { last->prev = other; });
            auto again = normalizer.normalize(target); again.waitForCompletion();
            passed &= again.status().failed && again.status().error.find("position changed")!=std::string::npos;
        }
        if (!passed) {
            std::cout << "Relative case " << caseID << ": " << handle.status().error << " symbolic=" << handle.status().symbolicValues << "\n"
                      << normalizer.stringifyResult(target) << "\n";
            for (const auto& step : handle.steps()) std::cout << step.action << "\n";
        }
        normalizer.close(); return passed;
    }%>
    void: unitTestGraphRelative(me string: testName, me int: caseID) <- {
        me bool: passed <- graphRelativeCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

// One logical-position interpretation serves neighbors and indexed access.
#define GRAPHNAVIGATION(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphNavigation(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHNAVIGATION(unit/graphNavigation/nthLanguage, 27)
    GRAPHNAVIGATION(unit/graphNavigation/nthEmbedded, 28)
    GRAPHNAVIGATION(unit/graphNavigation/nthNested, 29)
    GRAPHNAVIGATION(unit/graphNavigation/nthOpenPrefix, 30)
    GRAPHNAVIGATION(unit/graphNavigation/nthUnavailable, 31)
    GRAPHNAVIGATION(unit/graphNavigation/streamBoundary, 32)
    GRAPHNAVIGATION(unit/graphNavigation/changedStreamBoundary, 33)
    GRAPHNAVIGATION(unit/graphNavigation/unorderedBoundary, 34)
    GRAPHNAVIGATION(unit/graphNavigation/prevAcrossSpan, 1)
    GRAPHNAVIGATION(unit/graphNavigation/nextIntoSpan, 2)
    GRAPHNAVIGATION(unit/graphNavigation/prevOutOfSpan, 3)
    GRAPHNAVIGATION(unit/graphNavigation/nextOutOfSpan, 4)
    GRAPHNAVIGATION(unit/graphNavigation/emptySpans, 5)
    GRAPHNAVIGATION(unit/graphNavigation/nestedSpans, 6)
    GRAPHNAVIGATION(unit/graphNavigation/ordinaryBoundary, 7)
    GRAPHNAVIGATION(unit/graphNavigation/openZero, 8)
    GRAPHNAVIGATION(unit/graphNavigation/openLoadedEnd, 9)
    GRAPHNAVIGATION(unit/graphNavigation/nextPastProvenEnd, 10)
    GRAPHNAVIGATION(unit/graphNavigation/unknownEnd, 11)
    GRAPHNAVIGATION(unit/graphNavigation/lateEnd, 12)
    GRAPHNAVIGATION(unit/graphNavigation/cancelEnd, 13)
    GRAPHNAVIGATION(unit/graphNavigation/sparseEnd, 14)
    GRAPHNAVIGATION(unit/graphNavigation/sparseStart, 15)
    GRAPHNAVIGATION(unit/graphNavigation/indexWithin, 16)
    GRAPHNAVIGATION(unit/graphNavigation/indexAfter, 17)
    GRAPHNAVIGATION(unit/graphNavigation/indexNested, 18)
    GRAPHNAVIGATION(unit/graphNavigation/indexEmpty, 19)
    GRAPHNAVIGATION(unit/graphNavigation/indexSparseSkip, 20)
    GRAPHNAVIGATION(unit/graphNavigation/indexSparseWithin, 21)
    GRAPHNAVIGATION(unit/graphNavigation/indexUnknownPrefix, 22)
    GRAPHNAVIGATION(unit/graphNavigation/lateExtent, 23)
    GRAPHNAVIGATION(unit/graphNavigation/indexCost, 24)
    GRAPHNAVIGATION(unit/graphNavigation/cycle, 25)
    GRAPHNAVIGATION(unit/graphNavigation/repeat, 26)

    me bool: graphNavigationCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer normalizer; normalizer.init();
        using proteus4::POVDescription;
        std::string expression="{*10+1 &{*10+2 *10+3} %prev}";
        std::int64_t wanted=3, index=-1;
        switch (caseID) {
        case 2: expression="{%next &{*10+2 *10+3}}"; wanted=2; break;
        case 3: expression="{*10+1 &{%prev *10+3}}"; wanted=1; break;
        case 4: expression="{&{*10+1 %next} *10+3}"; break;
        case 5: expression="{*10+1 &{} &{&{}} %prev}"; wanted=1; break;
        case 6: expression="{&{*10+1 &{*10+2 *10+3}} %prev}"; break;
        case 7: expression="{*10+1 {%prev *10+3}}"; break;
        case 8: expression="{*10+1 &*0+{...} %prev}"; wanted=1; break;
        case 9: expression="{&*1+{*10+2 ...} %prev}"; wanted=2; break;
        case 10: expression="{&*1+{%next ...} *10+3}"; break;
        case 11: case 12: case 13: expression="{&{*10+1 ...} %prev}"; break;
        case 14: expression="{&*1000000000+{*10+7|...} %prev}"; wanted=7; break;
        case 15: expression="{%next &*1000000000+{*10+7|...}}"; wanted=7; break;
        case 16: expression="{*10+1 &{*10+2 *10+3} *10+4}"; index=2; break;
        case 17: expression="{*10+1 &{*10+2 *10+3} *10+4}"; index=3; wanted=4; break;
        case 18: expression="{*10+1 {*10+2 *10+3} *10+4}"; index=1; break;
        case 19: expression="{&{} &{&{}} *10+3}"; index=0; break;
        case 20: expression="{*10+1 &*1000000000+{*10+7|...} *10+3}"; index=1000000001; break;
        case 21: expression="{*10+1 &*1000000000+{*10+7|...} *10+3}"; index=900000000; break;
        case 22: expression="{&{*10+3 ...} *10+4}"; index=0; break;
        case 23: expression="{&{*10+1 ...} *10+3}"; index=1; break;
        case 24: expression="{*10+1 &*1000000000+{*10+7|...} *10+3}"; index=900000000; break;
        case 25: expression="{&{}}"; break;
        case 27: expression="*3+['Cat' 'Hat' 'Bat' 'Dog']"; break;
        case 28: expression="*3+['Cat' &{'Hat' 'Bat'} 'Dog']"; break;
        case 29: expression="*2+['Cat' {'Hat' 'Bat'} 'Dog']"; break;
        case 30: expression="*1+['Cat' ...]"; break;
        case 31: expression="*4+['Cat' 'Hat' ...]"; break;
        }
        auto root=graphParsed(testName,expression);
        auto first=POVDescription(root).member(), last=POVDescription(root).member(true);
        auto span=first;
        auto cursor=last;
        if (caseID==2 || caseID==15) { cursor=first; span=last; }
        if (caseID==3 || caseID==7) { span=last; cursor=POVDescription(span).member(); }
        if (caseID==4 || caseID==10) cursor=POVDescription(span).member(true);
        if (caseID==8 || caseID==16 || caseID==17 || caseID==18 || (caseID>=20 && caseID<=21) || caseID==24)
            span=first->next;
        if (caseID==25) normalizer.runtime.update([&] { first->pItem=root->pItem; });
        if (caseID>=32) normalizer.runtime.update([&] {
            if (caseID==34) root->pItem->orderMode=uUnordered;
            else {
                SetModeBits(root->pItem->flags, infonView::streamState, infonView::parseListReady);
                SetFlagBit(root->pItem->value->flags, infonState::tailUnfinished, true);
            }
        });
        proteus4::CostPolicy policy; if (caseID==24) policy.maximumRoute=3;
        auto handle=index>=0 ? normalizer.runtime.normalize({root,proteus4::itemAt,index},policy) : normalizer.normalize(root);
        handle.waitForCompletion();
        bool passed=!handle.status().failed;
        if (caseID==7 || (caseID>=11 && caseID<=13) || caseID==23 || caseID==24 || caseID==25 || caseID==31)
            passed &= handle.status().symbolicValues && handle.status().withSubscribers;
        else if (caseID>=32) {
            passed &= handle.status().symbolicValues && handle.status().withSubscribers;
            if (caseID==34) passed &= normalizer.access->known(cursor)!=3;
            else {
                passed &= normalizer.access->known(cursor)==3 && cursor->pItem->value->num==3;
                normalizer.runtime.update([&] {
                    SetModeBits(root->pItem->flags, infonView::streamState, infonView::parseDone);
                    SetFlagBit(root->pItem->value->flags, infonState::tailUnfinished, false);
                    if (caseID==33) root->pItem->orderMode=uUnordered;
                });
                handle.waitForCompletion();
                if (caseID==33) passed &= handle.status().failed;
                else passed &= !handle.status().failed && !handle.status().symbolicValues;
            }
        } else if (caseID>=27) {
            auto expected=caseID==29 ? "{'Hat' 'Bat'}" : caseID==30 ? "'Cat'" : "'Bat'";
            passed &= !handle.status().symbolicValues && toString(root->pItem.get())==expected;
        } else if (index>=0) {
            auto result=handle.result();
            passed &= result && !handle.status().symbolicValues;
            if (result) {
                if (caseID==18) passed &= result==span && normalizer.access->literalList(result);
                else if (caseID==21) passed &= result->implicitItem.sourceIndex==index-1 &&
                    span->pItem->value->items.size()==0 && span->repetitionSpan.family->occurrences.size()==1;
                else passed &= result->pItem->value->num==wanted;
            }
            if (caseID==20) passed &= !span->repetitionSpan.family && span->pItem->value->items.size()==0;
        } else {
            passed &= cursor->pItem->value->num==wanted && normalizer.access->known(cursor)==3;
            if (caseID<=6 || caseID==26) passed &= !handle.status().symbolicValues;
            if (caseID==14 || caseID==15) passed &= span->pItem->value->items.size()==0 &&
                span->repetitionSpan.family->occurrences.size()==1;
        }
        if (caseID==12 || caseID==13 || caseID==23) {
            if (caseID==13) handle.cancel();
            auto source=graphParsed(testName,caseID==23 ? "{*10+1}" : "{*10+1 *10+2 *10+3}");
            normalizer.addRHS(span, source); handle.waitForCompletion();
            if (caseID==13) passed &= handle.status().cancelled && normalizer.access->known(cursor)!=3;
            else if (caseID==23) passed &= !handle.status().failed && handle.result()==last;
            else passed &= !handle.status().failed && normalizer.access->known(cursor)==3 && cursor->pItem->value->num==3;
        }
        if (caseID==24) passed &= !span->repetitionSpan.family && span->pItem->value->items.size()==0;
        if (caseID==26) {
            passed &= getFlagBit(root->pItem->flags,infonView::isNormed);
            auto identities=normalizer.access->registry->identities.size();
            auto again=normalizer.normalize(root); again.waitForCompletion();
            passed &= !again.status().failed && !again.status().symbolicValues &&
                identities==normalizer.access->registry->identities.size();
        }
        if (!passed) {
            std::cout << "Navigation case " << caseID << ": " << handle.status().error
                      << " symbolic=" << handle.status().symbolicValues << "\n" << normalizer.stringifyResult(root) << "\n";
            for (const auto& step:handle.steps()) std::cout << step.action << "\n";
        }
        handle.cancel(); normalizer.close(); return passed;
    }%>
    void: unitTestGraphNavigation(me string: testName, me int: caseID) <- {
        me bool: passed <- graphNavigationCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

// Accepted continuation edges must never publish a losing parse candidate.
#define GRAPHTEXT(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphText(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHTEXT(unit/graphText/identityInSource, 31)
    GRAPHTEXT(unit/graphText/concatScalarSource, 32)
    GRAPHTEXT(unit/graphText/concatListSource, 33)
    GRAPHTEXT(unit/graphText/concatPrefixSource, 34)
    GRAPHTEXT(unit/graphText/lateConcatSource, 35)
    GRAPHTEXT(unit/graphText/cancelConcatSource, 36)
    GRAPHTEXT(unit/graphText/unknownString, 25)
    GRAPHTEXT(unit/graphText/sizedString, 26)
    GRAPHTEXT(unit/graphText/literalString, 27)
    GRAPHTEXT(unit/graphText/anyString, 28)
    GRAPHTEXT(unit/graphText/rejectedString, 29)
    GRAPHTEXT(unit/graphText/shortWholeString, 30)
    GRAPHTEXT(unit/graphText/firstAmbiguousMatch, 23)
    GRAPHTEXT(unit/graphText/openPrefixDeferred, 24)
    GRAPHTEXT(unit/graphText/fixedWidths, 1)
    GRAPHTEXT(unit/graphText/repeatedWidths, 2)
    GRAPHTEXT(unit/graphText/prefixCount, 3)
    GRAPHTEXT(unit/graphText/mismatchEndsRepeat, 4)
    GRAPHTEXT(unit/graphText/overlappingSuffix, 5)
    GRAPHTEXT(unit/graphText/embeddedRepeat, 6)
    GRAPHTEXT(unit/graphText/nullableRepeat, 7)
    GRAPHTEXT(unit/graphText/nestedPairs, 8)
    GRAPHTEXT(unit/graphText/emptyInput, 9)
    GRAPHTEXT(unit/graphText/nullableTemplate, 10)
    GRAPHTEXT(unit/graphText/embeddedEmpty, 11)
    GRAPHTEXT(unit/graphText/wholeSourceRequired, 12)
    GRAPHTEXT(unit/graphText/rejectedSuffixAtomic, 13)
    GRAPHTEXT(unit/graphText/shortInputAtomic, 14)
    GRAPHTEXT(unit/graphText/cost, 15)
    GRAPHTEXT(unit/graphText/lateText, 16)
    GRAPHTEXT(unit/graphText/cancel, 17)
    GRAPHTEXT(unit/graphText/templateUnchanged, 18)
    GRAPHTEXT(unit/graphText/finiteNullableTemplate, 19)
    GRAPHTEXT(unit/graphText/nestedSuffix, 20)
    GRAPHTEXT(unit/graphText/memberRefinement, 21)
    GRAPHTEXT(unit/graphText/lateMemberSize, 22)
    me bool: graphTextCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer normalizer; normalizer.init();
        using proteus4::POVDescription;
        std::string expression="{*3+$ *4+$} == 'CatDogs'", expected="{'Cat' 'Dogs'}";
        switch (caseID) {
        case 2: expression="{*3+$|...} == 'CatHatBatDog'"; expected="{'Cat' 'Hat' 'Bat' 'Dog'}"; break;
        case 3: expression="*4+{*3+$|...} ==: 'catHatDogPigMORE'"; expected="{'cat' 'Hat' 'Dog' 'Pig'}"; break;
        case 4: expression="{{'A'|...} 'R'} ==: 'AARON'"; expected="{{'A' 'A'} 'R'}"; break;
        case 5: expression="{{'A'|...} 'AARON'} == 'AAAARON'"; expected="{{'A' 'A'} 'AARON'}"; break;
        case 6: expression="{&{'A'|...} 'B'} == 'AAAAB'"; expected="{&{'A' 'A' 'A' 'A'} 'B'}"; break;
        case 7: expression="{{'A'|...} 'B'} == 'B'"; expected="{{} 'B'}"; break;
        case 8: expression="{{*1+$ *1+$}|...} == 'ABCD'"; expected="{{'A' 'B'} {'C' 'D'}}"; break;
        case 9: expression="{'A'|...} == ''"; expected="{}"; break;
        case 10: expression="{''|...} == ''"; expected="{}"; break;
        case 11: expression="{&{'A'|...} 'B'} == 'B'"; expected="{&{} 'B'}"; break;
        case 12: expression="{'A' 'B'} == 'ABC'"; break;
        case 13: expression="{*1+$ 'B'} == 'AC'"; break;
        case 14: expression="{*3+$ *4+$} == 'CatDog'"; break;
        case 15: expression="{'A'|...} == 'AAAAAAAA'"; break;
        case 16: case 17: expression="{*3+$ *4+$} == $"; break;
        case 18: expression="{*1+$|...} == 'ABCD'"; expected="{'A' 'B' 'C' 'D'}"; break;
        case 19: expression="*3+{''|...} == ''"; expected="{'' '' ''}"; break;
        case 20: expression="{{{'A'|...} 'B'}|...} == 'AABAAB'"; expected="{{{'A' 'A'} 'B'} {{'A' 'A'} 'B'}}"; break;
        case 21: expression="{*1+$= 'A' 'B'} == 'AB'"; expected="{'A' 'B'}"; break;
        case 22: expression="{$ 'B'} == 'AB'"; expected="{'A' 'B'}"; break;
        }
        if (caseID>=25) {
            expected="'Hello'";
            expression=caseID==25 ? "$ == 'Hello'" : caseID==26 ? "*5+$ == 'Hello'" :
                caseID==27 ? "'Hello' == 'Hello'" : caseID==28 ? "? == 'Hello'" :
                caseID==29 ? "'Hello' == 'World'" : "*4+$ == 'Hello'";
        }
        if (caseID>=31) {
            expected="{'Cat' 'Dogs'}";
            expression=caseID==31 ? "{*3+$ *4+$} == ($ = 'CatDogs')" :
                caseID==32 ? "$ == ('Cat' 'Dogs')" :
                caseID==33 ? "{*3+$ *4+$} == ('Cat' +'Dogs')" :
                caseID==34 ? "*1+{*3+$|...} ==: ('Cat' 'Dogs')" : "{*3+$ *4+$} == ('Cat' $)";
            if (caseID==32) expected="'CatDogs'";
            if (caseID==34) expected="{'Cat'}";
        }
        if (caseID==23) { expression="{{'A'|...} {'A'|...}} == 'AAA'"; expected="{{} {'A' 'A' 'A'}}"; }
        if (caseID==24) expression="{'A'|...} ==: 'AAA'";
        auto root=graphParsed(testName, expression);
        auto first=POVDescription(root).member(), source=root->pItem->wrkList[0];
        auto original=normalizer.stringifyResult(root);
        auto sourceBefore=normalizer.stringifyResult(source);
        auto templateBody=root->pItem->value->listSpec;
        auto templateBefore=templateBody ? toString(templateBody.get()) : "";
        auto handle=caseID==15 ? normalizer.normalizeWithCost(root, 4) : normalizer.normalize(root);
        handle.waitForCompletion();
        bool passed=!handle.status().failed;
        if (caseID==16 || caseID==17 || caseID==22 || caseID>=35) {
            passed &= handle.status().symbolicValues && handle.status().withSubscribers;
            if (caseID==17 || caseID==36) handle.cancel();
            if (caseID>=35) {
                normalizer.addRHS(POVDescription(source).member(true), graphParsed(testName, "'Dogs'"));
            } else if (caseID==22) {
                normalizer.addRHS(first, graphParsed(testName, "*1+$"));
            } else normalizer.runtime.update([&] {
                source->pItem->value->str="CatDogs";
                SetModeBits(source->pItem->value->flags, infonState::evalMode, infonState::emLiteral);
                source->pItem->infSize->num=7;
                SetModeBits(source->pItem->infSize->flags, infonState::evalMode, infonState::emLiteral);
            });
            handle.waitForCompletion();
        }
        if ((caseID>=12 && caseID<=15) || caseID==17 || caseID==24 || caseID==29 || caseID==30 || caseID==36) {
            passed &= handle.status().symbolicValues && !handle.status().failed;
            passed &= !getFlagBit(root->pItem->flags, infonView::isNormed);
            passed &= first==POVDescription(root).member();
            if (caseID==13 || caseID==14 || caseID==17 || caseID==36)
                passed &= getModeBits(first->pItem->value->flags, infonState::evalMode)==infonState::emUnknown;
            if (caseID==15 || caseID==24) passed &= root->pItem->value->items.isEmpty();
            if (caseID==17 || caseID==36) passed &= handle.status().cancelled;
            if (caseID==29) passed &= root->pItem->value->str=="Hello";
            if (caseID==30) passed &= root->pItem->infSize->num==4 &&
                getModeBits(root->pItem->value->flags, infonState::evalMode)==infonState::emUnknown;
        } else {
            passed &= !handle.status().symbolicValues && !handle.status().withSubscribers &&
                getFlagBit(root->pItem->flags, infonView::isNormed) && toString(root->pItem.get())==expected;
            if (first) passed &= first==POVDescription(root).member();
            auto repeat=normalizer.normalize(root); repeat.waitForCompletion();
            passed &= !repeat.status().failed && !repeat.status().symbolicValues && toString(root->pItem.get())==expected;
        }
        if (caseID!=16 && caseID!=17 && caseID<31) passed &= sourceBefore==normalizer.stringifyResult(source);
        if (templateBody) passed &= templateBefore==toString(templateBody.get());
        if (!passed) {
            std::cout << "Text case " << caseID << ": " << handle.status().error
                      << " symbolic=" << handle.status().symbolicValues << "\n" << normalizer.stringifyResult(root) << "\n";
            for (const auto& step:handle.steps()) std::cout << step.action << "\n";
        }
        handle.cancel(); normalizer.close(); return passed;
    }%>
    void: unitTestGraphText(me string: testName, me int: caseID) <- {
        me bool: passed <- graphTextCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHINNER(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphInner(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHINNER(unit/graphInner/directText, 1)
    GRAPHINNER(unit/graphInner/concatText, 2)
    GRAPHINNER(unit/graphInner/rejectedInner, 3)
    GRAPHINNER(unit/graphInner/lateText, 4)
    GRAPHINNER(unit/graphInner/cancel, 5)
    GRAPHINNER(unit/graphInner/textRepeat, 6)
    GRAPHINNER(unit/graphInner/directList, 7)
    GRAPHINNER(unit/graphInner/repeatedList, 8)
    GRAPHINNER(unit/graphInner/virtualRepeatedList, 9)
    GRAPHINNER(unit/graphInner/repeatedText, 10)

    GRAPHINNER(unit/graphInner/emptyRepeat, 11)
    GRAPHINNER(unit/graphInner/incompleteRepeat, 12)
    GRAPHINNER(unit/graphInner/rejectedRepeat, 13)
    GRAPHINNER(unit/graphInner/markedRepeat, 14)
    GRAPHINNER(unit/graphInner/lookahead, 15)
    GRAPHINNER(unit/graphInner/variableRepeat, 16)
    GRAPHINNER(unit/graphInner/embeddedInput, 17)
    GRAPHINNER(unit/graphInner/finiteRepeat, 18)
    GRAPHINNER(unit/graphInner/finiteWrongCount, 19)
    GRAPHINNER(unit/graphInner/lateList, 20)
    GRAPHINNER(unit/graphInner/cancelList, 21)
    GRAPHINNER(unit/graphInner/constrainedRepeatDeferred, 22)
    GRAPHINNER(unit/graphInner/markedTextRepeat, 23)
    GRAPHINNER(unit/graphInner/stringListRepeat, 24)
    me bool: graphInnerCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer normalizer; normalizer.init();
        using proteus4::POVDescription;
        std::string expression="[*4+$ *10+$] <~ 'DOgsTintinabulation'", expected="'Tintinabul'";
        if(caseID==2) expression="[*4+$ *10+$] <~ ('DO' 'gsTin' 'tinabulation')";
        if(caseID==3) expression="[*1+$ 'B'] <~ 'AC'";
        if(caseID==4 || caseID==5) expression="[*4+$ *10+$] <~ $";
        if(caseID==6) {expression="[{'A'|...} 'B'] <~ 'AAABtail'"; expected="'B'";}
        if(caseID==7) {expression="[_ _] <~ {1 2 3}"; expected="2";}
        if(caseID==8) {expression="{[_ _]|...} <~ {1 2 3 4 5 6 7 8}"; expected="{2 4 6 8}";}
        if(caseID==9) {expression="{*2+[...]|...} <~ {1 2 3 4 5 6 7 8}"; expected="{2 4 6 8}";}
        if(caseID==10) {expression="{[*1+$ *1+$]|...} <~ 'ABCDEFGH'"; expected="{'B' 'D' 'F' 'H'}";}
        if(caseID==11) {expression="{[_ _]|...} <~ {}"; expected="{}";}
        if(caseID==12) {expression="{[_ _]|...} <~ {1 2 3}";}
        if(caseID==13) {expression="{[1 _]|...} <~ {1 2 3 4}";}
        if(caseID==14) {expression="{[<_> _]|...} <~ {1 2 3 4}"; expected="{1 3}";}
        if(caseID==15) {expression="[&{_|...} <_> $] <~ {33 22 11 'hi' 'bye' 66 55}"; expected="11";}
        if(caseID==16) {expression="{[{'A'|...} 'B']|...} <~ 'AABAB'"; expected="{'B' 'B'}";}
        if(caseID==17) {expression="{[_ _]|...} <~ {1 &{2 3} 4}"; expected="{2 4}";}
        if(caseID==18) {expression="*2+{[_ _]|...} <~ {1 2 3 4}"; expected="{2 4}";}
        if(caseID==19) {expression="*2+{[_ _]|...} <~ {1 2 3 4 5 6}";}
        if(caseID==20) {expression="{[_ _]|...} <~ {1 _}"; expected="{2}";}
        if(caseID==21) {expression="{[_ _]|...} <~ {1 _}";}
        if(caseID==22) {expression="{[<{'A'|...}> {'A'|...}]|...} <~ 'AAA' = {{'A'}}";}
        if(caseID==23) {expression="{[<*1+$> *1+$]|...} <~ 'ABCD'"; expected="{'A' 'C'}";}
        if(caseID==24) {expression="{[$ $]|...} <~ {'A' 'B' 'C' 'D'}"; expected="{'B' 'D'}";}
        auto root=graphParsed(testName,expression);
        auto body=root->pItem->innr;
        auto source=body ? body->funcArgs : root->pItem->funcArgs;
        auto spec=root->pItem->value->listSpec;
        auto specBefore=spec ? toString(spec.get()) : "";
        auto sourceBefore=toString(source.get());
        auto handle=normalizer.normalize(root); handle.waitForCompletion();
        bool passed=!handle.status().failed;
        if(caseID==4 || caseID==5) {
            passed &= handle.status().symbolicValues && handle.status().withSubscribers;
            if(caseID==5) handle.cancel();
            normalizer.runtime.update([&] {
                source->value->str="DOgsTintinabulation";
                SetModeBits(source->value->flags,infonState::evalMode,infonState::emLiteral);
                source->infSize->num=18;
                SetModeBits(source->infSize->flags,infonState::evalMode,infonState::emLiteral);
            });
            handle.waitForCompletion();
        }
        if(caseID==20 || caseID==21) {
            passed &= handle.status().symbolicValues && handle.status().withSubscribers && root->pItem->value->items.isEmpty();
            if(caseID==21) handle.cancel();
            normalizer.addRHS(source->value->items.tail,graphParsed(testName,"2")); handle.waitForCompletion();
        }
        if(caseID==3 || caseID==5 || caseID==12 || caseID==13 || caseID==19 || caseID==21 || caseID==22) {
            passed &= handle.status().symbolicValues && !getFlagBit(root->pItem->flags,infonView::isNormed);
            if(caseID==3) passed &= getModeBits(body->value->items.head->pItem->value->flags,infonState::evalMode)==infonState::emUnknown;
            if(caseID==5 || caseID==21) passed &= handle.status().cancelled;
            if(caseID==21) passed &= root->pItem->value->items.isEmpty();
            if(caseID==12 || caseID==13 || caseID==19) {
                auto first=root->pItem->value->items.head;
                passed &= first && first->pItem->value->num==2 && handle.status().withSubscribers &&
                    !root->pItem->wrkList.empty() && !root->pItem->workIsRepresented(root->pItem->wrkList.front());
                if(caseID==19) passed &= first && first->next && first->next->pItem->value->num==4 &&
                    !first->next->next && root->pItem->infSize->num==2;
                else passed &= first && !first->next && normalizer.access->openTail(root) &&
                    getModeBits(root->pItem->infSize->flags,infonState::evalMode)==infonState::emUnknown;
            }
            if(caseID==22) {
                // This case intentionally waits for further information. A
                // wake-up without new facts must not choose a partition.
                passed &= handle.active() && handle.status().withSubscribers;
                auto waitingResult=normalizer.stringifyResult(root);
                normalizer.runtime.update([] {}); handle.waitForCompletion();
                passed &= !handle.status().failed && handle.active() &&
                    handle.status().symbolicValues && handle.status().withSubscribers &&
                    !getFlagBit(root->pItem->flags,infonView::isNormed) &&
                    normalizer.stringifyResult(root)==waitingResult;
            }
        } else {
            bool symbolic=caseID==7 || caseID==8 || caseID==9 || caseID==14 || caseID==15 || caseID==17 || caseID==18 || caseID==20;
            passed &= handle.status().symbolicValues==symbolic && handle.status().withSubscribers==symbolic &&
                getFlagBit(root->pItem->flags,infonView::isNormed)!=symbolic && toString(root->pItem.get())==expected;
            auto firstResult=root->pItem->value->items.head;
            auto identities=normalizer.access->registry->identities.size();
            auto repeat=normalizer.normalize(root); repeat.waitForCompletion();
            passed &= !repeat.status().failed && repeat.status().symbolicValues==symbolic && toString(root->pItem.get())==expected;
            passed &= firstResult==root->pItem->value->items.head && identities==normalizer.access->registry->identities.size();
            if(body) passed &= body->wrkList.size()==1;
        }
        if(spec) passed &= specBefore==toString(spec.get());
        if(caseID!=2 && caseID!=4 && caseID!=5 && caseID<20) passed &= sourceBefore==toString(source.get());
        if(!passed) {
            std::cout << "Inner case " << caseID << ": " << handle.status().error << " symbolic=" << handle.status().symbolicValues << "\n" << normalizer.stringifyResult(root) << "\n";
            for(const auto& step:handle.steps()) std::cout << step.action << "\n";
        }
        handle.cancel(); normalizer.close(); return passed;
    }%>
    void: unitTestGraphInner(me string: testName, me int: caseID) <- {
        me bool: passed <- graphInnerCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

// Negation belongs to the read-only matching predicate, before a successful
// path offers Sets. Missing facts are not evidence that a predicate is false.
#define GRAPHPREDICATE(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphPredicate(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHPREDICATE(unit/graphPredicate/numericWildcard, 1)
    GRAPHPREDICATE(unit/graphPredicate/sizeOrValueMismatch, 2)
    GRAPHPREDICATE(unit/graphPredicate/equalRejected, 3)
    GRAPHPREDICATE(unit/graphPredicate/valueMismatchUnknownSize, 4)
    GRAPHPREDICATE(unit/graphPredicate/lateValue, 5)
    GRAPHPREDICATE(unit/graphPredicate/lateSize, 6)
    GRAPHPREDICATE(unit/graphPredicate/cancel, 7)
    GRAPHPREDICATE(unit/graphPredicate/unknownOverlay, 8)
    GRAPHPREDICATE(unit/graphPredicate/textPredicate, 9)
    GRAPHPREDICATE(unit/graphPredicate/lateRejected, 10)
    GRAPHPREDICATE(unit/graphPredicate/listIdentity, 11)
    GRAPHPREDICATE(unit/graphPredicate/firstCandidate, 12)
    GRAPHPREDICATE(unit/graphPredicate/partialRejected, 13)
    GRAPHPREDICATE(unit/graphPredicate/unknownStringValue, 14)
    GRAPHPREDICATE(unit/graphPredicate/compoundWait, 15)

    GRAPHPREDICATE(unit/graphPredicate/atomicListWildcard, 16)
    GRAPHPREDICATE(unit/graphPredicate/compositeDeferred, 17)
    GRAPHPREDICATE(unit/graphPredicate/equalTextRejected, 18)
    me bool: graphPredicateCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer normalizer; normalizer.init();
        std::string expression="[&{!_|...} _]<~{'A' {1 2} 3 4}", expected="3";
        if(caseID==2) {expression="[&{!*12+5|...} *12+5]<~{*10+5 *12+4 *12+5}"; expected="*12+5";}
        if(caseID==3) expression="{[!*12+5]|...}<~{*12+5}";
        if(caseID==4) {expression="{[!*12+5]|...}<~{*_+4}"; expected="{*_+4}";}
        if(caseID==5 || caseID==7 || caseID==10) {expression="{[!*_+5]|...}<~{_}"; expected="{6}";}
        if(caseID==6 || caseID==15) {expression="{[!*12+5]|...}<~{*_+5}"; expected="{*10+5}";}
        if(caseID==8) expression="{[!_]|...}<~{?}";
        if(caseID==9) {expression="{[!'A']|...}<~'BC'"; expected="{'B' 'C'}";}
        if(caseID==11) {expression="{[!_]|...}<~{{*10+1 *10+2}}"; expected="{{*10+1 *10+2}}";}
        if(caseID==12) {expression="[&{!*12+5|...} *12+5]<~{*12+5 *10+4}"; expected="*12+5";}
        if(caseID==13) expression="{[!*12+5]|...}<~{*10+4 *12+5}";
        if(caseID==14) expression="{[!_]|...}<~{$}";
        if(caseID==16) {expression="{[?]|...}<~{{*10+1 *10+2}}"; expected="{{*10+1 *10+2}}";}
        if(caseID==17) expression="{[!{_ _}]|...}<~{{1 2 3}}";
        if(caseID==18) expression="{[!'A']|...}<~'A'";
        auto root=graphParsed(testName,expression);
        auto inner=root->pItem->innr;
        auto source=inner ? inner->funcArgs : root->pItem->funcArgs;
        auto first=source->value->items.head;
        auto spec=root->pItem->value->listSpec;
        auto before=spec ? toString(spec.get()) : "";
        auto handle=normalizer.normalize(root); handle.waitForCompletion();
        bool passed=!handle.status().failed;
        if(caseID==5 || caseID==6 || caseID==7 || caseID==10) {
            passed &= handle.active() && handle.status().withSubscribers && handle.status().symbolicValues && root->pItem->value->items.isEmpty();
            if(caseID==7) handle.cancel();
            normalizer.addRHS(first,graphParsed(testName,caseID==6 ? "*10+_" : caseID==10 ? "5" : "6"));
            handle.waitForCompletion();
        }
        if(caseID==3 || caseID==7 || caseID==8 || caseID==10 || caseID==13 || caseID==15 || caseID==17 || caseID==18) {
            passed &= !handle.status().failed && handle.status().symbolicValues;
            if(caseID==13) {
                auto first=root->pItem->value->items.head;
                passed &= first && !first->next && first->pItem->infSize->num==10 && first->pItem->value->num==4 &&
                    normalizer.access->openTail(root) && !getFlagBit(root->pItem->flags,infonView::isNormed);
            } else passed &= root->pItem->value->items.isEmpty();
            if(caseID==7) passed &= handle.status().cancelled;
            else passed &= handle.active() && handle.status().withSubscribers;
        } else {
            passed &= !handle.status().failed;
            if(caseID!=14) passed &= toString(root->pItem.get())==expected;
            auto result=root->pItem->value->items.head;
            if(inner) passed &= !inner->wrkList.empty() && inner->workIsRepresented(inner->wrkList[0]);
            else passed &= result && !root->pItem->wrkList.empty() && root->pItem->workIsRepresented(root->pItem->wrkList[0]);
            if(caseID==11 || caseID==14) passed &= normalizer.access->hasDirectIdentity(result,first);
            if(caseID==14) {
                passed &= handle.status().symbolicValues && handle.status().withSubscribers;
                normalizer.addRHS(first,graphParsed(testName,"'hello'")); handle.waitForCompletion();
                passed &= !handle.status().failed && toString(root->pItem.get())=="{'hello'}";
            }
            bool complete=caseID==2 || caseID==6 || caseID==9 || caseID==11 || caseID==12 || caseID==14 || caseID==16;
            passed &= handle.status().symbolicValues!=complete && getFlagBit(root->pItem->flags,infonView::isNormed)==complete;
            auto identities=normalizer.access->registry->identities.size();
            auto again=normalizer.normalize(root); again.waitForCompletion();
            passed &= !again.status().failed && root->pItem->value->items.head==result && normalizer.access->registry->identities.size()==identities;
        }
        if(spec) passed &= toString(spec.get())==before;
        if(!passed) {
            std::cout << "Predicate case " << caseID << ": " << handle.status().error << " symbolic=" << handle.status().symbolicValues << "\n" << normalizer.stringifyResult(root) << "\n";
            for(const auto& step:handle.steps()) std::cout << step.action << "\n";
        }
        handle.cancel(); normalizer.close(); return passed;
    }%>
    void: unitTestGraphPredicate(me string: testName, me int: caseID) <- {
        me bool: passed <- graphPredicateCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

// Matching preserves nominal type distinctions while reading explicit type
// aliases and constraints without applying them to speculative candidates.
#define GRAPHTYPEDMATCH(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphTypedMatch(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHTYPEDMATCH(unit/graphTypedMatch/differentLabels, 1)
    GRAPHTYPEDMATCH(unit/graphTypedMatch/meaningMismatch, 2)
    GRAPHTYPEDMATCH(unit/graphTypedMatch/negativeMeaning, 3)
    GRAPHTYPEDMATCH(unit/graphTypedMatch/latePatternMeaning, 4)
    GRAPHTYPEDMATCH(unit/graphTypedMatch/lateCandidateMeaning, 5)
    GRAPHTYPEDMATCH(unit/graphTypedMatch/cancel, 6)
    GRAPHTYPEDMATCH(unit/graphTypedMatch/aliasMeaning, 7)
    GRAPHTYPEDMATCH(unit/graphTypedMatch/ambiguousMeaning, 8)
    GRAPHTYPEDMATCH(unit/graphTypedMatch/candidateConflict, 9)
    GRAPHTYPEDMATCH(unit/graphTypedMatch/patternConflict, 10)
    GRAPHTYPEDMATCH(unit/graphTypedMatch/textWidthMeaning, 11)
    GRAPHTYPEDMATCH(unit/graphTypedMatch/literalMeaning, 12)
    GRAPHTYPEDMATCH(unit/graphTypedMatch/contextualDeferred, 13)
    GRAPHTYPEDMATCH(unit/graphTypedMatch/readOnlyCompilation, 14)

    me bool: graphTypedMatchCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer normalizer; normalizer.init();
        std::string declarations="{#left=*10+_ #right=left}";
        std::string expression="{[left]|...}<~{right:7}", expected="{left:*10+7}";
        if(caseID==2 || caseID==3) {
            declarations="{#left=*10+5 #right=*10+7}";
            expression=caseID==2 ? "{[left]|...}<~{right}" : "{[!left]|...}<~{right}";
            expected="{right:*10+7}";
        }
        if(caseID==4) declarations="{#right=left}";
        if(caseID==6) declarations="{#left=*10+_}";
        if(caseID==5) declarations="{#left=*10+_}";
        if(caseID==7) declarations="{#left=metre #metre=*10+_ #right=left}";
        if(caseID==8) declarations="{#left=*10+_ #left=*12+_ #right=left}";
        if(caseID==9) declarations="{#left=*10+_ #right=*10+5}";
        if(caseID==10) { declarations="{#left=*10+5 #right=*10+_}"; expression="{[left:7]|...}<~{right:7}"; }
        if(caseID==11) { declarations="{#left=*2+$}"; expression="{[left]|...}<~'ABCD'"; expected="{left:'AB' left:'CD'}"; }
        if(caseID==12) { declarations="{#left='AB' #right=left}"; expression="{[left]|...}<~{right}"; expected="{left:'AB'}"; }
        if(caseID==13) declarations="{#left=%prev #right=left}";
        auto defs=graphParsed(testName,declarations);
        auto declaration=normalizer.normalize(defs); declaration.waitForCompletion();
        auto definitionBefore=normalizer.stringifyResult(defs);
        if(caseID==14) {
            auto value=graphParsed(testName,"left:7");
            auto before=normalizer.stringifyResult(value);
            auto compiled=normalizer.runtime.normalize({value,proteus4::compileTypeRequirements,0}); compiled.waitForCompletion();
            bool passed=!compiled.status().failed && !compiled.status().symbolicValues && before==normalizer.stringifyResult(value) &&
                !getFlagBit(value->pItem->flags,infonView::isNormed) && value->pItem->wrkList.empty();
            auto applied=normalizer.normalize(value); applied.waitForCompletion();
            passed &= !applied.status().failed && !applied.status().symbolicValues && value->pItem->infSize->num==10;
            for(const auto& step:applied.steps()) if(step.action=="inspect type definitions") passed=false;
            passed &= definitionBefore==normalizer.stringifyResult(defs) && value->pItem->wrkList.empty();
            normalizer.close(); return passed;
        }
        auto root=graphParsed(testName,expression);
        auto spec=root->pItem->value->listSpec;
        auto source=root->pItem->funcArgs;
        auto patternBefore=toString(spec.get()), sourceBefore=toString(source.get());
        auto handle=normalizer.normalize(root); handle.waitForCompletion();
        bool passed=!declaration.status().failed && !handle.status().failed;
        if(caseID==4 || caseID==5 || caseID==6) {
            if(caseID==4) passed &= handle.status().symbolicValues && handle.status().withSubscribers;
            else passed &= handle.status().symbolicValues && handle.status().withSubscribers && root->pItem->value->items.isEmpty();
            if(caseID==6) handle.cancel();
            auto more=graphParsed(testName,(caseID==5 || caseID==6) ? "{#right=left}" : "{#left=*10+_}");
            auto published=normalizer.normalize(more); published.waitForCompletion(); handle.waitForCompletion();
            passed &= !published.status().failed;
        }
        bool deferred=caseID==2 || caseID==6 || caseID==8 || caseID==9 || caseID==10 || caseID==13;
        if(deferred) {
            passed &= !handle.status().failed && handle.status().symbolicValues && root->pItem->value->items.isEmpty() &&
                sourceBefore==toString(source.get()) && !getFlagBit(root->pItem->flags,infonView::isNormed);
            if(caseID==6) passed &= handle.status().cancelled;
            else passed &= handle.status().withSubscribers;
        } else {
            passed &= !handle.status().failed && !handle.status().symbolicValues && getFlagBit(root->pItem->flags,infonView::isNormed) &&
                toString(root->pItem.get())==expected && root->pItem->workIsRepresented(root->pItem->wrkList[0]);
            auto first=root->pItem->value->items.head;
            auto identities=normalizer.access->registry->identities.size();
            auto again=normalizer.normalize(root); again.waitForCompletion();
            passed &= !again.status().failed && !again.status().symbolicValues && first==root->pItem->value->items.head &&
                identities==normalizer.access->registry->identities.size();
            if(first) passed &= first->pItem->wrkList.empty();
            unsigned applications=0;
            for(const auto& step:handle.steps()) if(step.action=="Apply scalar type requirements")
                for(auto member=first; member; member=member->next) if(step.query.node==member) ++applications;
            // Case 4 acquired new meaning after producing its partial output.
            passed &= applications<=(caseID==4 ? 1u : 0u);
        }
        passed &= definitionBefore==normalizer.stringifyResult(defs) && patternBefore==toString(spec.get());
        if(!passed) {
            std::cout << "Typed match " << caseID << ": " << handle.status().error << " symbolic=" << handle.status().symbolicValues << "\n" << normalizer.stringifyResult(root) << "\n";
            for(const auto& step:handle.steps()) std::cout << step.action << "\n";
        }
        handle.cancel(); normalizer.close(); return passed;
    }%>
    void: unitTestGraphTypedMatch(me string: testName, me int: caseID) <- {
        me bool: passed <- graphTypedMatchCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHFIELD(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphField(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHFIELD(unit/graphField/mixedOrderDeferred, 19)
    GRAPHFIELD(unit/graphField/zeroSpan, 20)
    GRAPHFIELD(unit/graphField/unorderedLate, 21)
    GRAPHFIELD(unit/graphField/relativeInSpan, 22)
    GRAPHFIELD(unit/graphField/orderedFirst, 1)
    GRAPHFIELD(unit/graphField/unorderedAlternatives, 2)
    GRAPHFIELD(unit/graphField/differentLabels, 3)
    GRAPHFIELD(unit/graphField/skipMismatch, 4)
    GRAPHFIELD(unit/graphField/embedded, 5)
    GRAPHFIELD(unit/graphField/lateEarlierMismatch, 6)
    GRAPHFIELD(unit/graphField/lateEarlierMatch, 7)
    GRAPHFIELD(unit/graphField/cancel, 8)
    GRAPHFIELD(unit/graphField/latePredicate, 9)
    GRAPHFIELD(unit/graphField/lateCandidate, 10)
    GRAPHFIELD(unit/graphField/ambiguousDefinition, 11)
    GRAPHFIELD(unit/graphField/negative, 12)
    GRAPHFIELD(unit/graphField/openOrderedPrefix, 13)
    GRAPHFIELD(unit/graphField/openUnorderedPartial, 14)
    GRAPHFIELD(unit/graphField/unknownSpan, 15)
    GRAPHFIELD(unit/graphField/sparseDeferred, 16)
    GRAPHFIELD(unit/graphField/cost, 17)
    GRAPHFIELD(unit/graphField/replay, 18)
    me bool: graphFieldCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer normalizer;normalizer.init();
        std::string declarations="{#want=*10+_ #left=want #right=want}";
        std::string expression="{left:*10+1 right:*10+2}", pattern="want";
        if(caseID==2) expression="{left:*10+1, right:*10+2}";
        if(caseID==18) expression="{left:1, right:2}";
        if(caseID==3) expression="{right:*10+7}";
        if(caseID==4) expression="{'skip' *10+2}";
        if(caseID==5) expression="{&{'skip' *10+1} *10+2}";
        if(caseID==6 || caseID==7 || caseID==8) expression="{? *10+2}";
        if(caseID==9) {declarations="{}";expression="{want:*10+1 right:*10+2}";}
        if(caseID==10) declarations="{#want=*10+_ #right=want}";
        if(caseID==11) declarations="{#want=*10+_ #want=*12+_ #left=want #right=want}";
        if(caseID==12) {pattern="!want";expression="{'skip' *10+2}";}
        if(caseID==13) expression="{*10+1 ...}";
        if(caseID==14) expression="{*10+1, ...}";
        if(caseID==15) expression="{&{...} *10+2}";
        if(caseID==16) expression="{&*1000000000+{_|...} *10+2}";
        if(caseID==19) expression="{&{*10+1, *10+2} *10+3}";
        if(caseID==20) expression="{&*0+{_|...} *10+2}";
        if(caseID==21) expression="{?, *10+2}";
        if(caseID==22) expression="{'skip' &{%prev} *10+2}";
        if((caseID>=4 && caseID<=8) || (caseID>=13 && caseID<=17) || caseID>=19) pattern="*10+_";
        auto defs=graphParsed(testName,declarations);
        auto declared=normalizer.normalize(defs);declared.waitForCompletion();
        auto source=graphParsed(testName,expression),predicate=graphParsed(testName,pattern);
        auto first=source->pItem->value->items.head;
        auto sourceBefore=toString(source->pItem.get()),predicateBefore=toString(predicate->pItem.get());
        auto defsBefore=toString(defs->pItem.get());
        proteus4::CostPolicy policy;
        if(caseID==17) policy.maximumRoute=1;
        auto handle=normalizer.runtime.normalize({source,proteus4::selectField,0,predicate},policy);
        handle.waitForCompletion();
        bool passed=!declared.status().failed && !handle.status().failed;
        if(caseID==6 || caseID==7 || caseID==8 || caseID==9 || caseID==10) {
            // Explicit candidate data no longer waits for an absent declaration.
            if(caseID==9 || caseID==10) passed &= handle.result()==(caseID==9 ? first : first->next) && !handle.status().symbolicValues;
            else passed &= !handle.result() && handle.status().symbolicValues && handle.status().withSubscribers;
            if(caseID==8) handle.cancel();
            if(caseID<=8) normalizer.addRHS(first,graphParsed(testName,caseID==7 ? "*10+1" : "'skip'"));
            else {
                auto more=graphParsed(testName,caseID==9 ? "{#want=*10+_}" : "{#left=want}");
                auto added=normalizer.normalize(more);added.waitForCompletion();passed &= !added.status().failed;
                if(caseID==10) handle=normalizer.findField(source,predicate);
            }
            handle.waitForCompletion();
        }
        if(caseID==21) {
            auto partial=handle.result();
            passed &= partial && toString(partial->pItem.get())=="*_+[*10+2 ... ]" && handle.status().symbolicValues && handle.status().withSubscribers;
            auto alias=partial ? partial->pItem->innr->value->items.head : std::shared_ptr<POV>{};
            normalizer.addRHS(first,graphParsed(testName,"*10+1"));handle.waitForCompletion();
            passed &= handle.result()==partial && alias && partial->pItem->innr->value->items.tail==alias;
        }
        bool deferred=caseID==8 || caseID==15 || caseID==16 || caseID==17 || caseID==19;
        auto result=handle.result();
        if(deferred) {
            passed &= !result && handle.status().symbolicValues;
            if(caseID==8) passed &= handle.status().cancelled;
            else passed &= handle.status().withSubscribers;
            if(caseID==16) passed &= !first->repetitionSpan.family && first->pItem->value->items.isEmpty();
        } else if(caseID==14) {
            passed &= result && toString(result->pItem.get())=="*_+[*10+1 ... ]" && handle.status().symbolicValues && handle.status().withSubscribers;
        } else if(caseID==2 || caseID==18 || caseID==21) {
            passed &= result && result->pItem->isOrLike() && handle.status().symbolicValues;
            if(result) {
                auto a=result->pItem->innr->value->items.head;
                passed &= a && a->next && !a->next->next && a->pItem==first->pItem && a->next->pItem==first->next->pItem &&
                    normalizer.access->hasDirectIdentity(a,first) && normalizer.access->hasDirectIdentity(a->next,first->next);
                passed &= toString(result->pItem.get())==(caseID==21 ? "*_+[*10+1 *10+2 ... ]" : caseID==18 ? "*_+[left:1 right:2 ... ]" : "*_+[left:*10+1 right:*10+2 ... ]");
                if(caseID==18) {
                    auto count=normalizer.access->registry->identities.size();
                    auto stepsBefore=handle.steps().size();
                    normalizer.runtime.update([]{});handle.waitForCompletion();
                    passed &= handle.result()==result && count==normalizer.access->registry->identities.size();
                    auto steps=handle.steps();
                    for(auto i=stepsBefore;i<steps.size();++i) passed &= steps[i].action!="unresolved field candidate";
                }
            }
        } else {
            auto wanted=caseID==4 || caseID==6 || caseID==20 ? first->next :
                        caseID==5 ? first->pItem->value->items.head->next : caseID==22 ? first->next->next : first;
            passed &= result==wanted && !handle.status().symbolicValues;
        }
        if(caseID!=6 && caseID!=7 && caseID!=8 && caseID!=21 && caseID!=22) passed &= sourceBefore==toString(source->pItem.get());
        passed &= predicateBefore==toString(predicate->pItem.get()) && defsBefore==toString(defs->pItem.get());
        if(!passed) {
            std::cout << "Field case " << caseID << ": " << handle.status().error << " symbolic=" << handle.status().symbolicValues << "\n";
            if(result) std::cout << toString(result->pItem.get()) << "\n";
            for(const auto& step:handle.steps()) std::cout << step.action << "\n";
        }
        handle.cancel();normalizer.close();return passed;
    }%>
    void: unitTestGraphField(me string: testName, me int: caseID) <- {
        me bool: passed <- graphFieldCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHFIELDPATH(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphFieldPath(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHFIELDPATH(unit/graphFieldPath/replyMetadata, 12)
    GRAPHFIELDPATH(unit/graphFieldPath/pendingReply, 13)
    GRAPHFIELDPATH(unit/graphFieldPath/ordered, 1)
    GRAPHFIELDPATH(unit/graphFieldPath/unordered, 2)
    GRAPHFIELDPATH(unit/graphFieldPath/latePredicate, 3)
    GRAPHFIELDPATH(unit/graphFieldPath/lateEarlier, 4)
    GRAPHFIELDPATH(unit/graphFieldPath/cancel, 5)
    GRAPHFIELDPATH(unit/graphFieldPath/chainDeferred, 6)
    GRAPHFIELDPATH(unit/graphFieldPath/writeConflict, 7)
    GRAPHFIELDPATH(unit/graphFieldPath/skipMismatch, 8)
    GRAPHFIELDPATH(unit/graphFieldPath/compoundNoMatch, 9)
    GRAPHFIELDPATH(unit/graphFieldPath/replay, 10)
    GRAPHFIELDPATH(unit/graphFieldPath/rhs, 11)
    me bool: graphFieldPathCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer normalizer;normalizer.init();
        std::string declarations="{#want=*10+_ #left=want #right=want}";
        std::string expression="{left:*10+1 right:*10+2}.want",expected="left:*10+1";
        if(caseID==2) {expression="{left:*10+1, right:*10+2}.want";expected="*_+[left:*10+1 right:*10+2 ... ]";}
        if(caseID==3) {declarations="{}";expression="{want:*10+1 right:*10+2}.want";expected="want:*10+1";}
        if(caseID==5 || caseID==13) {expression="{? right:*10+2}.want";expected="right:*10+2";}
        if(caseID==4 || caseID==8) {expression=caseID==4 ? "{? right:*10+2}.want" : "{'skip' right:*10+2}.want";expected="right:*10+2";}
        if(caseID==6) expression+=".next";
        if(caseID==7) expression+=" = *10+7";
        if(caseID==9) {declarations="{#want={*10+_} #left=*10+_ #right=*10+_}";expected="*_+[]";}
        if(caseID==11) {expression="_ = {left:*10+1 right:*10+2}.want";expected="*10+1";}
        if(caseID==12 || caseID==13) expression+=" >>";
        auto defs=graphParsed(testName,declarations);
        auto declared=normalizer.normalize(defs);declared.waitForCompletion();
        auto container=graphParsed(testName,(caseID==12 || caseID==13) ? "{"+expression+"}" : expression);
        auto root=(caseID==12 || caseID==13) ? container->pItem->value->items.head : container;
        auto first=root->pItem->value->items.head;
        auto original=toString(root->pItem.get());
        auto replyPosition=root->pItem->replyCharPos;
        auto handle=normalizer.normalize(root);handle.waitForCompletion();
        bool passed=!declared.status().failed && !handle.status().failed;
        if(caseID==12 || caseID==13) {
            passed &= getFlagBit(root->pItem->flags,infonView::doReply) && root->pItem->replyCharPos==replyPosition && replyPosition>0;
            // Reply claiming is completion metadata, not a graph publication.
            normalizer.access->claimReply(root);
            if(caseID==13) {
                original=original.substr(0,original.size()-2);
                passed &= toString(root->pItem.get())==original;
            }
        }
        if(caseID==4 || caseID==5 || caseID==13) {
            passed &= handle.status().symbolicValues && handle.status().withSubscribers && toString(root->pItem.get())==original;
            if(caseID==5) handle.cancel();
            normalizer.addRHS(first,graphParsed(testName,"'skip'"));
            handle.waitForCompletion();
        }
        bool deferred=caseID==5 || caseID==6;
        if(caseID==7) {
            passed=!declared.status().failed && handle.status().failed && first->pItem->value->num==1 && first->next->pItem->value->num==2;
        } else if(deferred) {
            passed &= handle.status().symbolicValues;
            if(caseID==5) passed &= handle.status().cancelled && !root->pItem->pathSelection->result;
            else passed &= toString(root->pItem.get())==original;
            if(caseID==6) passed &= root->pItem->pathSelection && !root->pItem->pathSelection->result;
        } else {
            passed &= !handle.status().failed && toString(root->pItem.get())==expected;
            if(caseID==2 || caseID==9) passed &= handle.status().symbolicValues && root->pItem->isOrLike() && root->pItem->pathSelection->pending==(caseID==2);
            else passed &= !handle.status().symbolicValues && getFlagBit(root->pItem->flags,infonView::isNormed);
            if(caseID==10) {
                auto count=normalizer.access->registry->identities.size();
                auto selected=root->pItem->selectedResult;
                auto again=normalizer.normalize(root);again.waitForCompletion();
                passed &= !again.status().failed && !again.status().symbolicValues &&
                    count==normalizer.access->registry->identities.size() && selected==root->pItem->selectedResult;
            }
        }
        if(!passed) {
            std::cout << "Field path " << caseID << ": " << handle.status().error << " symbolic=" << handle.status().symbolicValues << "\n" << toString(root->pItem.get()) << "\n";
            for(const auto& step:handle.steps()) std::cout << step.action << "\n";
        }
        handle.cancel();normalizer.close();return passed;
    }%>
    void: unitTestGraphFieldPath(me string: testName, me int: caseID) <- {
        me bool: passed <- graphFieldPathCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

