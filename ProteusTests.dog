        if(caseID==6) expression="*4+{*10+1 ... *10+6} = {... &{*10+4 *10+5 *10+6}}";
        if(caseID==7) expression="*1000000000+{1 ... 6} = {... &{4 5 6}}";
        if(caseID==9 || caseID==12) expression="{_ ... 6} = {... &{4 5 6}}";
        if(caseID==10) expression="{4 ... 6} = {... &{4 5 6}}";
        if(caseID==11) expression="{start:*10+1 ... 6} = {... &{end:*10+4 5 6}}";
        auto root=graphParsed(testName,expression),rhs=root->pItem->wrkList.front();
        auto left=caseID==1 ? rhs : root, right=caseID==1 ? root : rhs;
        auto gapA=left->pItem->value->items.head->next,gapB=right->pItem->value->items.head;
        auto handle=caseID==8 ? normalizer.normalizeWithCost(root,1) : normalizer.normalize(root);handle.waitForCompletion();
        bool passed=!handle.status().failed;
        if(caseID==12) {
            passed &= gapA->pItem->value->items.isEmpty();
            normalizer.addRHS(left->pItem->value->items.head,graphParsed(testName,"1"));handle.waitForCompletion();
        }
