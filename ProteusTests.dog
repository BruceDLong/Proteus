    me bool: graphPathWriteCase(me string: testName, me int: caseID) <- <%{
        if(caseID==28) {
            std::weak_ptr<POV> observed,effect;bool passed=false;
            {
                GraphNormalizer lifetime;lifetime.init();
                auto root=graphParsed(testName,"{wheel:{spoke:{length:_}}}.wheel.spoke.length=*10+7;");
                observed=root;
                passed=proteus4::PathExpression::prepare(*lifetime.access,root);
                if(passed && !root->pItem->pathSelection->effects.empty()) effect=root->pItem->pathSelection->effects.front();
                else passed=false;
                auto handle=lifetime.normalize(root);handle.waitForCompletion();
                passed &= !handle.status().failed && !handle.status().symbolicValues && toString(root->pItem.get())=="spoke:{length:*10+7}";
                handle.cancel();lifetime.close();
            }
            return passed && observed.expired() && effect.expired();
        }
        GraphNormalizer normalizer;normalizer.init();
        std::string expression="{*10+1 $ 'Hat'}.$='Cat';",expected="{*10+1 'Cat' 'Hat'}";
        switch(caseID) {
        case 1: expression="{'Cat' 'Hat' $ 'Dog'}@[3]='Bat';";expected="{'Cat' 'Hat' 'Bat' 'Dog'}";break;
        case 2: expression="{*10+1 _}@[-1]=*10+7;";expected="{*10+1 *10+7}";break;
        case 3: expression="{*10+1 &{_ *10+3}}@[2]=*10+7;";expected="{*10+1 &{*10+7 *10+3}}";break;
        case 4: expression="{wheel:{spoke:{length:_} other:*10+8}}.wheel.spoke.length=*10+7";expected="length:*10+7";break;
        case 5: expression="{wheel:{spoke:{length:_} other:*10+8}}.wheel.spoke.length=*10+7;";expected="spoke:{length:*10+7}";break;
        case 6: expression="{wheel:{spoke:{length:_} other:*10+8}}.wheel.spoke.length=*10+7;;";expected="wheel:{spoke:{length:*10+7} other:*10+8}";break;
        case 7: expression="{wheel:{spoke:{length:_} other:*10+8}}.wheel.spoke.length=*10+7;;;";expected="{wheel:{spoke:{length:*10+7} other:*10+8}}";break;
        case 8: expression="{a:_ b:_}.a=*10+7;.b=*10+8;";expected="{a:*10+7 b:*10+8}";break;
        case 9: expression="{wheel:{spoke:{length:*10+7} other:*10+8}}.wheel.spoke;";expected="wheel:{spoke:{length:*10+7} other:*10+8}";break;
        case 10: expression="{*10+1 *10+2}@[2]=*10+7;";break;
        case 11:case 12:case 13: expression="{*10+1 _ ...}@[-1]=*10+7;";expected="{*10+1 *10+7}";break;
        case 14: expression="*2+{wheel:_, wheel:_}.wheel=*10+7;";break;
        case 15: expression="{wheel:_}.pedal=*10+7;";break;
        case 16: expression="{{_ _}}@[1]={*10+7 *10+8};";expected="{{*10+7 *10+8}}";break;
        case 17: expression="{{*10+1 _}}@[1]@[2]=*10+7;";expected="{*10+1 *10+7}";break;
        case 18: expression="{*10+1 _ _}@[1:*2+{...}]={*10+7 *10+8};";expected="{*10+1 *10+7 *10+8}";break;
        case 19:case 20: expression="{? $}.$='Cat';";expected="{*10+1 'Cat'}";break;
        case 21: expression="{part:{_ _}}.part={*10+7 *10+8};";break;
        case 22: expression="*1000000000+{_|...}@[100]=*10+7";expected="*10+7";break;
        case 23: expression="{*10+1 _}@[2]=%prev;";expected="{*10+1 *10+1}";break;
        case 24: expression="{_ *10+2}@[1]=%next;";expected="{*10+2 *10+2}";break;
        case 25: expression="{*10+1 &{_}}@[2]=%prev;";expected="{*10+1 &{*10+1}}";break;
        case 26: expression="{&{_} *10+2}@[1]=%next;";expected="{&{*10+2} *10+2}";break;
        case 27: expression="*2+{other:*10+1,first:_}.first=*10+7;";expected="*2+{other:*10+1, first:*10+7}";break;
        }
        auto root=graphParsed(testName,expression);auto source=root->pItem->value;
        auto first=source->items.head;auto last=source->items.tail;
        auto beforeFirst=first ? first->pItem : nullptr;
        auto handle=normalizer.normalize(root);handle.waitForCompletion();
        bool passed=!handle.status().failed;
        if(caseID==11 || caseID==12 || caseID==13) {
            passed &= handle.status().symbolicValues && handle.status().withSubscribers && last->pItem->wrkList.empty();
            if(caseID==13) handle.cancel();
            if(caseID!=11) normalizer.runtime.update([&] {SetFlagBit(source->flags,infonState::tailUnfinished,false);});
            handle.waitForCompletion();
        }
        if(caseID==19 || caseID==20) {
            passed &= handle.status().symbolicValues && last->pItem->wrkList.empty();
            if(caseID==20) {normalizer.addRHS(first,graphParsed(testName,"*10+1"));handle.waitForCompletion();}
        }
        bool pending=caseID==11 || caseID==13 || caseID==14 || caseID==15 || caseID==19 || caseID==21;
        if(caseID==10) passed=handle.status().failed && last->pItem->value->num==2;
        else if(pending) {
            passed &= handle.status().symbolicValues;
            if(caseID==14 || caseID==15) passed &= first->pItem->wrkList.empty();
            if(caseID==11 || caseID==13) passed &= last->pItem->wrkList.empty();
            if(caseID==13) passed &= handle.status().cancelled && !handle.status().withSubscribers;
        } else {
            passed &= !handle.status().symbolicValues && toString(root->pItem.get())==expected;
            auto relations=normalizer.access->registry->identities.size();
            auto again=normalizer.normalize(root);again.waitForCompletion();
            passed &= !again.status().failed && !again.status().symbolicValues && toString(root->pItem.get())==expected &&
                normalizer.access->registry->identities.size()==relations;
            for(const auto& step:again.steps()) passed &= step.action!="Set selected source constraints";
            again.cancel();
        }
        if(caseID==22) {
            auto span=root->pItem->pathSelection->source;
            auto selected=normalizer.findItem(span,99);selected.waitForCompletion();
            auto untouched=normalizer.findItem(span,100);untouched.waitForCompletion();
            passed &= selected.result()==root->pItem->selectedResult && untouched.result()->pItem->wrkList.empty() &&
