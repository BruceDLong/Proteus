    }
}

#define GRAPHCROSSING(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphCrossing(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHCROSSING(unit/graphCrossing/crossing, 0)
