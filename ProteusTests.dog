                    auto reparsed=graphParsed(testName,printed);auto roundtrip=normalizer.normalize(reparsed);roundtrip.waitForCompletion();
                    passed &= !roundtrip.status().failed && normalizer.access->listExtent(reparsed)==1000000000;
                    roundtrip.cancel();
                }
