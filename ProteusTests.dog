                if(caseID==3 || caseID==4 || caseID==5) {
                    if(caseID==5) handle.cancel();
                    normalizer.addRHS(gapA,graphParsed(testName,"{*10+2 *10+3 *10+4 *10+5}"));handle.waitForCompletion();
                    if(caseID==5) passed &= handle.status().cancelled && !handle.status().withSubscribers && middle->pItem->value->items.isEmpty();
                    else {
                        passed &= !handle.status().failed && normalizer.access->listExtent(root)==6 && normalizer.access->listExtent(gapB)==3;
                        passed &= middle->pItem->value->items.size()==2 && other->pItem->value->items.size()==2;
                        passed &= caseID==3 ? !handle.status().symbolicValues : handle.status().withSubscribers;
                        if(caseID==4) {normalizer.addRHS(gapB,graphParsed(testName,"{1 9 3}"));handle.waitForCompletion();passed &= handle.status().failed;}
                    }
                }
            }
        }
        if(caseID!=4 && caseID!=5 && caseID!=8) {
            auto before=toString(root->pItem.get());auto count=normalizer.access->registry->identities.size();
            auto again=normalizer.normalize(root);again.waitForCompletion();
            passed &= !again.status().failed && toString(root->pItem.get())==before && normalizer.access->registry->identities.size()==count;again.cancel();
        }
        if(!passed) std::cout << "Crossing " << caseID << ": " << handle.status().error << " symbolic=" << handle.status().symbolicValues << "\n" << toString(root->pItem.get()) << "\n";
        handle.cancel();normalizer.close();return passed;
    }%>
    void: unitTestGraphCrossing(me string: testName, me int: caseID) <- {
        me bool: passed <- graphCrossingCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHNUMERICRANGE(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphNumericRange(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHNUMERICRANGE(unit/graphNumericRange/direct, 0)
    GRAPHNUMERICRANGE(unit/graphNumericRange/upperEndpoint, 1)
    GRAPHNUMERICRANGE(unit/graphNumericRange/intersection, 2)
    GRAPHNUMERICRANGE(unit/graphNumericRange/touching, 3)
    GRAPHNUMERICRANGE(unit/graphNumericRange/outerSizeConflict, 4)
    GRAPHNUMERICRANGE(unit/graphNumericRange/lateRHS, 5)
    GRAPHNUMERICRANGE(unit/graphNumericRange/cancel, 6)
    GRAPHNUMERICRANGE(unit/graphNumericRange/furtherIntersection, 7)
    GRAPHNUMERICRANGE(unit/graphNumericRange/replay, 8)
    GRAPHNUMERICRANGE(unit/graphNumericRange/lateOffset, 9)
    GRAPHNUMERICRANGE(unit/graphNumericRange/earlierCandidate, 10)
    GRAPHNUMERICRANGE(unit/graphNumericRange/cost, 11)
    GRAPHNUMERICRANGE(unit/graphNumericRange/filterReadOnly, 12)
    GRAPHNUMERICRANGE(unit/graphNumericRange/trailingPartial, 13)
    GRAPHNUMERICRANGE(unit/graphNumericRange/partialOverlap, 14)
    GRAPHNUMERICRANGE(unit/graphNumericRange/endModes, 15)
    GRAPHNUMERICRANGE(unit/graphNumericRange/latePartial, 16)
    GRAPHNUMERICRANGE(unit/graphNumericRange/symbolicRefinement, 17)
    GRAPHNUMERICRANGE(unit/graphNumericRange/emptyRange, 18)
    me bool: graphNumericRangeCase(me string: testName, me int: caseID) <- <%{
        if(caseID==15) {
            bool passed=true;
            for(const std::string op:{"=","==","=:","==:"}) for(bool reverse:{false,true}) for(bool known:{false,true}) {
                GraphNormalizer normalizer;normalizer.init();
                auto left=reverse ? "4" : "3",right=reverse ? "3" : "4";
                auto root=graphParsed(testName,std::string("*")+left+"+_ "+op+" *"+right+"+"+(known ? "2" : "_"));
                auto rhs=root->pItem->wrkList.front();auto original=root->pItem->value;
                auto before=toString(root->pItem.get()),rhsText=toString(rhs->pItem.get());
                bool partial=op.back()==':';
                bool flags=rhs->looseSize()==partial && getFlagBit(rhs->flags,POV::looseMode)==(op.substr(0,2)=="==");
                auto handle=normalizer.normalize(root);handle.waitForCompletion();
                bool ok=flags && root->pItem->infSize->num==(reverse ? 4 : 3) && toString(rhs->pItem.get())==rhsText;
                if(partial) {
                    ok &= !handle.status().failed && toString(root->pItem.get())==std::string("*")+left+"+"+(known ? "2" : "_");
                    ok &= handle.status().symbolicValues==!known;
                    ok &= !normalizer.access->hasDirectIdentity(root,rhs);
                } else {
                    ok &= root->pItem->value==original && toString(root->pItem.get())==before;
                    ok &= op=="=" ? handle.status().failed : handle.status().symbolicValues;
                }
                if(!ok) std::cout << "Endpoint case " << before << ": " << toString(root->pItem.get()) << " error=" << handle.status().error << "\n";
                passed &= ok;handle.cancel();normalizer.close();
            }
            return passed;
        }
        GraphNormalizer normalizer;normalizer.init();
        std::string expression="*4+_ ==3",expected="3";
        switch(caseID) {
        case 1: expression="*4+_ ==4";break;
        case 2:case 7:case 8:case 11: expression="*10+(*5+_ +2) = *10+(*4+_ +5)";expected="*10+(*2+_ +5)";break;
        case 3: expression="*10+(*3+_ +2) = *10+(*4+_ +5)";break;
        case 4: expression="*10+(*5+_ +2) = *11+(*4+_ +5)";break;
        case 5:case 6: expression="*4+_ ==*4+_";expected="*4+3";break;
        case 9: expression="(*2+_ +_) ==3";break;
        case 10: expression="{_ 3}.*10+(*3+_ +2)";break;
        case 12: expression="{[&{!*4+_|...} *4+_]|...}<~{1 2 0 3 444 555 666 777 2}";expected="{1 2 0 3 2}";break;
        case 13: expression="{[&{!(*4+_ +2)|...} (*4+_ +2)]|...}<~{1 2 0 3 4 5 6 7}";expected="{2 3 4 5}";break;
        case 14: expression="{(*4+_ +3) 4}.*10+(*3+_ +2)";break;
        case 16: expression="*4+_ ==:*10+_";expected="*4+3";break;
        case 17: expression="{[&{!*4+_|...} *4+_]|...}<~{1 *3+_ 5 *4+(*2+_ +1) *4+_}";expected="{1 *4+_ *4+(*2+_ +1) *4+_}";break;
        case 18: expression="*4+_ ==:*0+_";break;
        }
        auto root=graphParsed(testName,expression);
        auto feed=caseID==17 ? root->pItem->funcArgs : std::shared_ptr<infonView>{};
        auto feedText=feed ? toString(feed.get()) : std::string{};
        auto original=root->pItem->value;
        auto rhs=root->pItem->wrkList.empty() ? std::shared_ptr<POV>{} : root->pItem->wrkList.front();
        auto rhsText=rhs ? toString(rhs->pItem.get()) : std::string{};
        auto pattern=root->pItem->value->listSpec;
        auto patternText=pattern ? toString(pattern.get()) : std::string{};
        auto offset=caseID==9 ? original->items.tail : std::shared_ptr<POV>{};
        auto earlier=caseID==10 ? original->items.head : std::shared_ptr<POV>{};
        auto before=toString(root->pItem.get());
        auto handle=caseID==11 ? normalizer.normalizeWithCost(root,1) : normalizer.normalize(root);handle.waitForCompletion();
        bool passed=!handle.status().failed;
        if(caseID==3 || caseID==4) {
            passed=handle.status().failed && root->pItem->value==original && !root->pItem->wrkList.empty();
        } else if(caseID==1 || caseID==13 || caseID==14 || caseID==18) {
            passed &= handle.status().symbolicValues && handle.status().withSubscribers && !getFlagBit(root->pItem->flags,infonView::isNormed);
            if(caseID==1 || caseID==13 || caseID==18) passed &= root->pItem->value==original && root->pItem->wrkList.size()==1;
            if(caseID==13) {
                auto member=root->pItem->value->items.head;
                for(int value:{2,3,4,5}) {
                    passed &= member && member->pItem->value->num==value;
                    if(member) member=member->next;
                }
                passed &= !member && normalizer.access->openTail(root) &&
                    getModeBits(root->pItem->infSize->flags,infonState::evalMode)==infonState::emUnknown &&
                    !root->pItem->workIsRepresented(root->pItem->wrkList.front());
            }
            if(pattern) passed &= toString(pattern.get())==patternText;
        } else if(caseID==11) {
            passed &= handle.status().symbolicValues && toString(root->pItem.get())==before;
        } else {
            if(caseID==5 || caseID==6 || caseID==9 || caseID==10 || caseID==16) {
                passed &= handle.status().symbolicValues && handle.status().withSubscribers;
                if(caseID==6) handle.cancel();
                normalizer.runtime.update([&] {
                    auto item=caseID==9 ? offset->pItem : caseID==10 ? earlier->pItem : rhs->pItem;
                    SetModeBits(item->value->flags,infonState::overlayType,infonState::NUM);
                    SetModeBits(item->value->flags,infonState::evalMode,infonState::emLiteral);
                    SetModeBits(item->flags,infonView::viewMode,infonView::vmOverlay);
                    item->value->num.val=caseID==9 ? 2 : caseID==10 ? 1 : 3;
                });
                handle.waitForCompletion();
            }
            if(caseID==6) passed &= handle.status().cancelled && !handle.status().withSubscribers && root->pItem->value==original;
            else {
                passed &= !handle.status().failed && toString(root->pItem.get())==expected;
                if(caseID==16) passed &= root->pItem->infSize->num==4 && rhs->pItem->infSize->num==10 && !normalizer.access->hasDirectIdentity(root,rhs);
                if(caseID==0) passed &= root->pItem->infSize->num==4 && getFlagBit(root->pItem->flags,infonView::isNormed);
                if(caseID==2 || caseID==7 || caseID==8) passed &= handle.status().symbolicValues && root->pItem->valueExpression==original && toString(rhs->pItem.get())==rhsText;
                if(caseID==7) {
                    normalizer.addRHS(root,graphParsed(testName,"*10+(*1+_ +6)"));handle.waitForCompletion();
                    passed &= !handle.status().failed && toString(root->pItem.get())=="*10+(*1+_ +6)";
                }
                if(pattern) passed &= root->pItem->value->listSpec==pattern && toString(pattern.get())==patternText;
                auto text=toString(root->pItem.get());auto body=root->pItem->value;auto identities=normalizer.access->registry->identities.size();
                auto again=normalizer.normalize(root);again.waitForCompletion();
                passed &= !again.status().failed && toString(root->pItem.get())==text && root->pItem->value==body && normalizer.access->registry->identities.size()==identities;
                again.cancel();
                if(caseID==17) {
                    passed &= toString(feed.get())==feedText;
                    auto input=feed->value->items.head->next;
                    auto output=root->pItem->value->items.head->next;
                    passed &= input->pItem->infSize->num==3 && output->pItem->infSize->num==4 && !normalizer.access->hasDirectIdentity(output,input);
                    normalizer.runtime.update([&] {
                        SetModeBits(input->pItem->value->flags,infonState::evalMode,infonState::emLiteral);
                        input->pItem->value->num.val=2;
                    });
                    handle.waitForCompletion();
                    passed &= !handle.status().failed && root->pItem->value->items.head->next==output &&
                        toString(root->pItem.get())=="{1 *4+2 *4+(*2+_ +1) *4+_}" && toString(pattern.get())==patternText && input->pItem->infSize->num==3;
                }
            }
        }
        if(!passed) {
            std::cout << "Numeric range " << caseID << ": " << handle.status().error << " symbolic=" << handle.status().symbolicValues << "\n" << toString(root->pItem.get()) << "\n";
            for(const auto& step:handle.steps()) std::cout << step.action << "\n";
        }
        handle.cancel();normalizer.close();return passed;
    }%>
    void: unitTestGraphNumericRange(me string: testName, me int: caseID) <- {
        me bool: passed <- graphNumericRangeCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

// Completed <~ repetitions are useful before the source correspondence ends.
#define GRAPHREPEATPREFIX(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphRepeatPrefix(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHREPEATPREFIX(unit/graphRepeatPrefix/appendList, 1)
    GRAPHREPEATPREFIX(unit/graphRepeatPrefix/cancel, 2)
    GRAPHREPEATPREFIX(unit/graphRepeatPrefix/lateValue, 3)
    GRAPHREPEATPREFIX(unit/graphRepeatPrefix/appendText, 4)
    GRAPHREPEATPREFIX(unit/graphRepeatPrefix/appendRange, 5)
    GRAPHREPEATPREFIX(unit/graphRepeatPrefix/cost, 6)
    GRAPHREPEATPREFIX(unit/graphRepeatPrefix/openInputDeferred, 7)
    GRAPHREPEATPREFIX(unit/graphRepeatPrefix/enclosingConflict, 8)
    GRAPHREPEATPREFIX(unit/graphRepeatPrefix/competingPrefixes, 9)
    GRAPHREPEATPREFIX(unit/graphRepeatPrefix/commonPrefix, 10)
    GRAPHREPEATPREFIX(unit/graphRepeatPrefix/enclosingCompatible, 11)

    me bool: graphRepeatPrefixCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer normalizer;normalizer.init();
        std::string expression="{[_ _]|...}<~{1 2 3}", completed="{2 4}";
        if(caseID==3) expression="{[_ _]|...}<~{1 2 3 _}";
        if(caseID==4) {expression="{[*1+$ *1+$]|...}<~'ABC'";completed="{'B' 'D'}";}
        if(caseID==5) {expression="{[&{!(*4+_ +2)|...} (*4+_ +2)]|...}<~{1 2 0 3 4 5 6 7}";completed="{2 3 4 5 2}";}
        if(caseID==7) expression="{[_ _]|...}<~{1 2 3 ...}";
        if(caseID==8) expression="{[_ _]|...}<~{1 2 3} = {9 ...}";
        if(caseID==11) expression="{[_ _]|...}<~{1 2 3} = {2 ...}";
        if(caseID==9) expression="{[{'A'|...} *2+$ 'Z']|...}<~'AAZZQ'";
        if(caseID==10) expression="{[{'A'|...} *2+$ 'Z']|...}<~'XXZAAZZQ'";
        auto root=graphParsed(testName,expression);
        auto source=root->pItem->funcArgs;
        auto spec=root->pItem->value->listSpec;
        auto specText=toString(spec.get()),sourceText=toString(source.get());
        auto handle=caseID==6 ? normalizer.normalizeWithCost(root,4) : normalizer.normalize(root);
        handle.waitForCompletion();
        bool passed=caseID==8 ? handle.status().failed : !handle.status().failed;
        bool empty=caseID==6 || caseID==7 || caseID==9;
        auto first=root->pItem->value->items.head;
        if(caseID!=8) {
            passed &= handle.status().symbolicValues && handle.status().withSubscribers && handle.active() &&
                !getFlagBit(root->pItem->flags,infonView::isNormed) && normalizer.access->openTail(root) &&
                getModeBits(root->pItem->infSize->flags,infonState::evalMode)==infonState::emUnknown;
            if(empty) passed &= !first;
            else if(caseID==10) passed &= first && !first->next && first->pItem->value->str=="Z";
            else passed &= first && (caseID==4 ? first->pItem->value->str=="B" : first->pItem->value->num==2);
        }
        passed &= sourceText==toString(source.get()) && specText==toString(spec.get());
        if(caseID==8) passed &= root->pItem->wrkList.size()==2 && !getFlagBit(root->pItem->flags,infonView::isNormed);
        auto before=toString(root->pItem.get());
        auto identities=normalizer.access->registry->identities.size();
        normalizer.runtime.update([]{});handle.waitForCompletion();
        passed &= before==toString(root->pItem.get()) && first==root->pItem->value->items.head &&
            identities==normalizer.access->registry->identities.size();
        if(caseID<=5) {
            passed &= !root->pItem->wrkList.empty() && !root->pItem->workIsRepresented(root->pItem->wrkList.front());
            if(caseID==2) handle.cancel();
            if(caseID==3) normalizer.addRHS(source->value->items.tail,graphParsed(testName,"4"));
            else if(caseID==4) normalizer.runtime.update([&]{
                source->value->str="ABCD";source->infSize->num.val=4;
            });
            else {
                auto added=graphParsed(testName,caseID==5 ? "2" : "4");
                normalizer.runtime.update([&]{
                    auto owner=root->pItem->wrkList.front();
                    source->value->items.appendPov(added);added->pParent=owner.get();
                    source->infSize->num.val=caseID==5 ? 9 : 4;
                    SetModeBits(source->infSize->flags,infonState::evalMode,infonState::emLiteral);
                    normalizer.access->bind(added);++owner->workRevision;
                });
            }
            handle.waitForCompletion();
            passed &= !handle.status().failed && first==root->pItem->value->items.head && specText==toString(spec.get());
            if(caseID==2) passed &= handle.status().cancelled && !handle.status().withSubscribers &&
                toString(root->pItem.get()).find("2 ...")!=std::string::npos && !first->next;
            else {
                passed &= toString(root->pItem.get())==completed && !normalizer.access->openTail(root) &&
                    root->pItem->infSize->num==(caseID==5 ? 5 : 2) &&
                    root->pItem->workIsRepresented(root->pItem->wrkList.front());
                if(caseID==4) passed &= getFlagBit(root->pItem->flags,infonView::isNormed) && !handle.status().symbolicValues;
                auto count=normalizer.access->registry->identities.size();
                auto replay=normalizer.normalize(root);replay.waitForCompletion();
                passed &= !replay.status().failed && toString(root->pItem.get())==completed &&
                    first==root->pItem->value->items.head && count==normalizer.access->registry->identities.size();
                replay.cancel();
            }
        }
        if(!passed) {
            std::cout << "Repeat prefix " << caseID << ": " << toString(root->pItem.get()) << " error=" << handle.status().error
                      << " symbolic=" << handle.status().symbolicValues << "\n";
            if(!passed) for(const auto& step:handle.steps()) std::cout << step.action << "\n";
        }
        handle.cancel();normalizer.close();return passed;
    }%>
    void: unitTestGraphRepeatPrefix(me string: testName, me int: caseID) <- {
        me bool: passed <- graphRepeatPrefixCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHCONSOLIDATION(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphConsolidation(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHCONSOLIDATION(unit/graphConsolidation/scalar, 1)
    GRAPHCONSOLIDATION(unit/graphConsolidation/text, 2)
    GRAPHCONSOLIDATION(unit/graphConsolidation/finiteList, 3)
    GRAPHCONSOLIDATION(unit/graphConsolidation/lateConflict, 4)
    GRAPHCONSOLIDATION(unit/graphConsolidation/subscribedConflict, 5)
    GRAPHCONSOLIDATION(unit/graphConsolidation/cancel, 6)
    GRAPHCONSOLIDATION(unit/graphConsolidation/sharedView, 7)
    GRAPHCONSOLIDATION(unit/graphConsolidation/lateContext, 8)
    GRAPHCONSOLIDATION(unit/graphConsolidation/cost, 9)
    GRAPHCONSOLIDATION(unit/graphConsolidation/lateSize, 10)
    GRAPHCONSOLIDATION(unit/graphConsolidation/partial, 11)
    GRAPHCONSOLIDATION(unit/graphConsolidation/qualified, 12)
    GRAPHCONSOLIDATION(unit/graphConsolidation/openList, 13)
    GRAPHCONSOLIDATION(unit/graphConsolidation/replay, 14)
    GRAPHCONSOLIDATION(unit/graphConsolidation/existingIdentity, 15)
    GRAPHCONSOLIDATION(unit/graphConsolidation/nestedList, 16)
    GRAPHCONSOLIDATION(unit/graphConsolidation/replacedView, 17)
    GRAPHCONSOLIDATION(unit/graphConsolidation/reusedOwner, 18)

    me bool: graphConsolidationCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer normalizer;normalizer.init();
        std::string expression="_ = *10+2";
        if(caseID==2) expression="$ = 'cat'";
        if(caseID==3) expression="{_ _}={*10+2 *10+3}";
        if(caseID==5 || caseID==6) expression="{_ = *10+2 _}";
        if(caseID==8) expression="{*10+3 _ = *10+2}";
        if(caseID==10 || caseID==11) expression="_ = 2";
        if(caseID==12) expression="*4+_ ==:*10+2";
        if(caseID==13) expression="{_ ...}={*10+2 ...}";
        if(caseID==16) expression="{{_ _}}={{*10+2 *10+3}}";
        auto root=graphParsed(testName,expression),target=root;
        if(caseID==5 || caseID==6) target=root->pItem->value->items.head;
        if(caseID==8) target=root->pItem->value->items.tail;
        auto source=target->pItem->wrkList.front();auto sourceText=toString(source->pItem.get());
        if(caseID==15) normalizer.recordIdentity(source,target);
        auto handle=caseID==9 ? normalizer.normalizeWithCost(root,0) : normalizer.normalize(root);
        handle.waitForCompletion();
        bool passed=!handle.status().failed && target->pItem->hasRHS(source->pItem);
        bool retain=caseID>=9 && caseID<=13;
        passed &= target->pItem->wrkList.empty()!=retain && sourceText==toString(source->pItem.get());
        if(!retain) {
            passed &= normalizer.access->hasDirectIdentity(target,source) && getFlagBit(target->pItem->flags,infonView::isNormed);
            auto edges=proteus4::POVDescription(target,normalizer.access->registry.get()).relationships();
            passed &= std::count_if(edges.begin(),edges.end(),[&](const auto& edge) {
                return edge.target==source && edge.consolidated && edge.isWork();
            })==1;
        }
        if(caseID==4 || caseID==5 || caseID==6 || caseID==7 || caseID==8 || caseID==10 || caseID==17 || caseID==18) {
            bool subscribed=caseID==5 || caseID==6 || caseID==10;
            passed &= handle.status().withSubscribers==subscribed;
            if(caseID==6 || caseID==7 || caseID==17 || caseID==18) handle.cancel();
            if(caseID==7 || caseID==17 || caseID==18) {
                auto alias=std::make_shared<POV>(938);alias->pItem=target->pItem;
                if(caseID==17 || caseID==18) {
                    auto replacement=graphParsed(testName,"?");
                    normalizer.runtime.update([&]{target->pItem=replacement->pItem;});
                    if(caseID==18) {
                        normalizer.addRHS(target,source);
                        auto reused=normalizer.normalize(target);reused.waitForCompletion();
                        passed &= !reused.status().failed && target->pItem->workListContainsPOV(source);
                        reused.cancel();
                    }
                }
                root=target=alias;
                passed &= target->pItem->hasRHS(source->pItem);
            }
            normalizer.addRHS(source,graphParsed(testName,caseID==8 ? "%prev" : caseID==10 ? "*10+2" : "*10+3"));
            handle.waitForCompletion();
            if(caseID==10) {
                // The later size finding is now retained at the source too,
                // so both equalities can consolidate in the original search.
                passed &= !target->pItem->workListContainsPOV(source) &&
                    target->pItem->hasRHS(source->pItem) && source->pItem->infSize->num==10;
                auto supplied=normalizer.normalize(source);supplied.waitForCompletion();
                passed &= !supplied.status().failed;supplied.cancel();
            }
            if(caseID==6) passed &= handle.status().cancelled && !handle.status().failed;
            else if(caseID==5) passed &= handle.status().failed;
            else {
                auto again=normalizer.normalize(root);again.waitForCompletion();
                passed &= caseID==10 ? !again.status().failed && target->pItem->wrkList.empty() &&
                    target->pItem->infSize->num==10 : again.status().failed;
                again.cancel();
            }
            passed &= !getFlagBit(target->pItem->flags,infonView::isNormed) || caseID==10;
        } else if(!retain) {
            auto count=normalizer.access->registry->identities.size();
            auto text=toString(root->pItem.get());
            if(caseID==14) normalizer.addRHS(target,source);
            auto again=normalizer.normalize(root);again.waitForCompletion();
            passed &= !again.status().failed && !again.status().symbolicValues && target->pItem->wrkList.empty() &&
                toString(root->pItem.get())==text && count==normalizer.access->registry->identities.size();
            again.cancel();
        }
        if(!passed) {
            std::cout << "Consolidation " << caseID << ": " << toString(root->pItem.get()) << " work=" << target->pItem->wrkList.size()
                      << " failed=" << handle.status().failed << " error=" << handle.status().error << "\n";
            for(const auto& step:handle.steps()) std::cout << step.action << "\n";
        }
        handle.cancel();normalizer.close();return passed;
    }%>
    void: unitTestGraphConsolidation(me string: testName, me int: caseID) <- {
        me bool: passed <- graphConsolidationCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHREJECTION(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphRejection(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHREJECTION(unit/graphRejection/scalarReuse, 0)
    GRAPHREJECTION(unit/graphRejection/textReuse, 1)
    GRAPHREJECTION(unit/graphRejection/sizeReuse, 2)
    GRAPHREJECTION(unit/graphRejection/rangeReuse, 3)
    GRAPHREJECTION(unit/graphRejection/retryAfterChange, 4)
    GRAPHREJECTION(unit/graphRejection/projectionAlternative, 5)
    GRAPHREJECTION(unit/graphRejection/grammarReuse, 6)

    GRAPHREJECTION(unit/graphRejection/retainedTextFixture, 7)
    GRAPHREJECTION(unit/graphRejection/retainedNumberFixture, 8)
    GRAPHREJECTION(unit/graphRejection/retainedRangeFixture, 9)
    me bool: graphRejectionCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer normalizer;normalizer.init();
        bool passed=true;
        if(caseID>=7) {
            std::vector<std::string> expressions{"'Hello' == 'World'","*_+8 = *16+9","*4+_ == 4"};
            auto root=graphParsed(testName,expressions.at(caseID-7)),source=root->pItem->wrkList.front();
            auto before=toString(root->pItem.get()),original=toString(source->pItem.get());
            auto handle=normalizer.normalize(root);handle.waitForCompletion();
            passed &= handle.status().failed==(caseID==8) && !getFlagBit(root->pItem->flags,infonView::isNormed) &&
                root->pItem->workListContainsPOV(source) && !normalizer.access->hasDirectIdentity(root,source) &&
                toString(root->pItem.get())==before && toString(source->pItem.get())==original;
            if(!passed) std::cout << "Retained rejection " << caseID << ": " << toString(root->pItem.get()) << " error=" << handle.status().error << "\n";
            handle.cancel();normalizer.close();return passed;
        }
        if(caseID==5) {
            auto defs=graphParsed(testName,"{#spoke={length:*1000+123=*1000+456}}");
            auto declared=normalizer.normalize(defs);declared.waitForCompletion();
            auto original=toString(defs->pItem.get());
            auto root=graphParsed(testName,"spoke:{length:_}"),cursor=root->pItem->value->items.head;
            for(int i=0;i<12;++i) {
                auto next=graphParsed(testName,"_");normalizer.addRHS(cursor,next);cursor=next;
            }
            normalizer.addRHS(cursor,graphParsed(testName,"*1000+123"));
            normalizer.runtime.update([&] {normalizer.access->bind(root);});
            auto result=normalizer.runtime.normalize({root,proteus4::sizeAndValue,proteus4::lazyParts});result.waitForCompletion();
            bool rejected=false;for(const auto& step:result.steps()) if(step.action.find("reject: ")==0) rejected=true;
            passed &= !declared.status().failed && rejected && !result.status().failed && !result.status().symbolicValues &&
                toString(root->pItem.get())=="spoke:{length:*1000+123}" && toString(defs->pItem.get())==original;
            if(!passed) std::cout << "Projection rejection: " << result.status().error << "\n" << toString(root->pItem.get()) << "\n";
            result.cancel();
        } else {
            std::string left="*10+8",right="*10+9",unknown="_";
            if(caseID==1) {left="'A'";right="'B'";unknown="$";}
            if(caseID==2) {left="*3+_";right="*4+_";}
            if(caseID==3) {left="(*3+_ +2)";right="7";}
            if(caseID==6) {left="{'A'} == 'B'";unknown="{'B'}";}
            auto rejected=graphParsed(testName,left);
            auto source=caseID==6 ? rejected->pItem->wrkList.front() : graphParsed(testName,right);
            if(caseID!=6) normalizer.addRHS(rejected,source);
            auto original=toString(source->pItem.get());
            auto failure=normalizer.normalize(rejected);failure.waitForCompletion();
            passed &= (caseID==6 ? !failure.status().failed && failure.status().symbolicValues : failure.status().failed) &&
                rejected->pItem->workListContainsPOV(source) && !normalizer.access->hasDirectIdentity(rejected,source) &&
                !getFlagBit(rejected->pItem->flags,infonView::isNormed) && toString(source->pItem.get())==original;
            failure.cancel();
            auto next=graphParsed(testName,unknown);normalizer.addRHS(next,source);
            auto success=normalizer.normalize(next);success.waitForCompletion();
            passed &= !success.status().failed && toString(source->pItem.get())==original;
            if(caseID==6) passed &= toString(next->pItem.get())=="{'B'}" && !success.status().symbolicValues;
            else passed &= normalizer.access->typeFacts(source).accepts(normalizer.access->typeFacts(next));
            success.cancel();
            if(caseID==4) {
                normalizer.runtime.update([&]{rejected->pItem->value->num.val=9;});
                auto retry=normalizer.normalize(rejected);retry.waitForCompletion();
                passed &= !retry.status().failed && !retry.status().symbolicValues && rejected->pItem->wrkList.empty();
                if(!passed) {
                    std::cout << "Retry: " << retry.status().error << " symbolic=" << retry.status().symbolicValues
                              << " work=" << rejected->pItem->wrkList.size() << " value=" << toString(rejected->pItem.get()) << "\n";
                    for(const auto& step:retry.steps()) std::cout << step.action << "\n";
                }
                retry.cancel();
            } else {
                auto retry=normalizer.normalize(rejected);retry.waitForCompletion();
                passed &= (caseID==6 ? !retry.status().failed && retry.status().symbolicValues : retry.status().failed) &&
                    toString(source->pItem.get())==original;
                retry.cancel();
            }
            if(!passed) std::cout << "Rejection " << caseID << ": " << failure.status().error << "\n" << toString(next->pItem.get()) << "\n";
        }
        normalizer.close();return passed;
    }%>
    void: unitTestGraphRejection(me string: testName, me int: caseID) <- {
        me bool: passed <- graphRejectionCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

// Scalar prefix evidence must preserve size uncertainty and source ownership.
#define GRAPHQUALIFIEDTEXT(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphQualifiedText(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHQUALIFIEDTEXT(unit/graphQualifiedText/endModes, 0)
    GRAPHQUALIFIEDTEXT(unit/graphQualifiedText/unknownSize, 1)
    GRAPHQUALIFIEDTEXT(unit/graphQualifiedText/lateText, 2)
    GRAPHQUALIFIEDTEXT(unit/graphQualifiedText/cancel, 3)
    GRAPHQUALIFIEDTEXT(unit/graphQualifiedText/lateSize, 4)
    GRAPHQUALIFIEDTEXT(unit/graphQualifiedText/cost, 5)
    GRAPHQUALIFIEDTEXT(unit/graphQualifiedText/mismatchReuse, 6)
    GRAPHQUALIFIEDTEXT(unit/graphQualifiedText/shortInput, 7)
    GRAPHQUALIFIEDTEXT(unit/graphQualifiedText/invalidWidth, 8)

    me bool: graphQualifiedTextCase(me string: testName, me int: caseID) <- <%{
        bool passed=true;
        if(caseID==0) {
            for(const std::string right:{"'Hello'","*_+'Hello'"})
            for(const std::string op:{"=:","==:","=="}) for(const std::string left:{"$","?","*3+$","*5+$","'Hel'","'Hello'","'HelloWorld'","''"}) {
                GraphNormalizer normalizer;normalizer.init();
                auto root=graphParsed(testName,left+" "+op+" "+right);auto source=root->pItem->wrkList.front();
                auto sourceText=toString(source->pItem.get()),before=toString(root->pItem.get());
                bool partial=op.back()==':',unknown=(partial || right.front()=='*') && (left=="$" || left=="?");
                bool accepted=partial || left=="$" || left=="?" || left=="*5+$" || left=="'Hello'";
                std::string expected=left=="*3+$" ? "'Hel'" : left=="*5+$" || left=="$" || left=="?" ? "'Hello'" : left;
                if(unknown) expected="*_+'Hello'";
                auto handle=normalizer.normalize(root);handle.waitForCompletion();
                bool ok=!handle.status().failed && toString(source->pItem.get())==sourceText &&
                    !normalizer.access->hasDirectIdentity(root,source) && root->pItem->workListContainsPOV(source);
                ok &= toString(root->pItem.get())==(accepted ? expected : before);
                ok &= handle.status().symbolicValues==(!accepted || unknown) &&
                    getFlagBit(root->pItem->flags,infonView::isNormed)==(accepted && !unknown);
                auto body=root->pItem->value;auto count=normalizer.access->registry->identities.size();
                auto repeat=normalizer.normalize(root);repeat.waitForCompletion();
                ok &= !repeat.status().failed && root->pItem->value==body && normalizer.access->registry->identities.size()==count;
                if(!ok) std::cout << "Text endpoints: " << before << " -> " << toString(root->pItem.get()) << " error=" << handle.status().error << "\n";
                passed &= ok;repeat.cancel();handle.cancel();normalizer.close();
            }
            return passed;
        }
        GraphNormalizer normalizer;normalizer.init();
        std::string expression="$ =: 'Hello'";
        if(caseID==2 || caseID==3) expression="*3+$ =: $";
        if(caseID==5) expression="*3+$ =: 'Hello'";
        if(caseID==6) expression="'Bye' =: 'Hello'";
        if(caseID==7) expression="*8+$ =: 'Hello'";
        if(caseID==8) expression="*1.5+$ =: 'Hello'";
        auto root=graphParsed(testName,expression),source=root->pItem->wrkList.front();
        auto sourceText=toString(source->pItem.get()),before=toString(root->pItem.get());
        auto handle=caseID==5 ? normalizer.normalizeWithCost(root,1) : normalizer.normalize(root);
        handle.waitForCompletion();
        passed &= !handle.status().failed && handle.status().symbolicValues && handle.status().withSubscribers &&
            !getFlagBit(root->pItem->flags,infonView::isNormed) && toString(source->pItem.get())==sourceText;
        if(caseID==1 || caseID==4) {
            passed &= root->pItem->value->str=="Hello" && toString(root->pItem.get())=="*_+'Hello'" &&
                getModeBits(root->pItem->infSize->flags,infonState::evalMode)==infonState::emUnknown;
            if(caseID==4) {
                normalizer.addRHS(root,graphParsed(testName,"*5+$"));handle.waitForCompletion();
                passed &= !handle.status().failed && !handle.status().symbolicValues &&
                    getFlagBit(root->pItem->flags,infonView::isNormed) && root->pItem->infSize->num==5;
            }
        } else {
            passed &= toString(root->pItem.get())==before;
            if(caseID==2 || caseID==3) {
                if(caseID==3) handle.cancel();
                normalizer.runtime.update([&] {
                    source->pItem->value->str="Hello";
                    SetModeBits(source->pItem->value->flags,infonState::evalMode,infonState::emLiteral);
                    source->pItem->infSize->num.val=5;
                    SetModeBits(source->pItem->infSize->flags,infonState::evalMode,infonState::emLiteral);
                });
                handle.waitForCompletion();
                if(caseID==3) passed &= handle.status().cancelled && !handle.status().withSubscribers &&
                    getModeBits(root->pItem->value->flags,infonState::evalMode)==infonState::emUnknown && root->pItem->infSize->num==3;
                else passed &= !handle.status().failed && !handle.status().symbolicValues && toString(root->pItem.get())=="'Hel'";
            }
            if(caseID==6) {
                auto alternate=graphParsed(testName,"*3+$");normalizer.addRHS(alternate,source);
                auto success=normalizer.normalize(alternate);success.waitForCompletion();
                passed &= !success.status().failed && !success.status().symbolicValues && toString(alternate->pItem.get())=="'Hel'" &&
                    toString(source->pItem.get())==sourceText && !normalizer.access->hasDirectIdentity(root,source);
                success.cancel();
            }
        }
        if(!passed) {
            std::cout << "Qualified text " << caseID << ": " << toString(root->pItem.get()) << " error=" << handle.status().error << " symbolic=" << handle.status().symbolicValues << "\n";
            for(const auto& step:handle.steps()) std::cout << step.action << "\n";
        }
        handle.cancel();normalizer.close();return passed;
    }%>
    void: unitTestGraphQualifiedText(me string: testName, me int: caseID) <- {
        me bool: passed <- graphQualifiedTextCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHINPUTS(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphInputs(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHINPUTS(unit/graphInputs/argumentFirst, 0)
    GRAPHINPUTS(unit/graphInputs/argumentLast, 1)
    GRAPHINPUTS(unit/graphInputs/argumentLeft, 2)
    GRAPHINPUTS(unit/graphInputs/argumentInverse, 3)
    GRAPHINPUTS(unit/graphInputs/argumentResult, 4)
    GRAPHINPUTS(unit/graphInputs/resultText, 5)
    GRAPHINPUTS(unit/graphInputs/resultList, 6)
    GRAPHINPUTS(unit/graphInputs/prefixRHSWork, 7)
    GRAPHINPUTS(unit/graphInputs/wholeRHSWork, 8)
    GRAPHINPUTS(unit/graphInputs/lastArgumentWait, 9)
    GRAPHINPUTS(unit/graphInputs/symbolicLastWait, 10)
    GRAPHINPUTS(unit/graphInputs/cancel, 11)
    GRAPHINPUTS(unit/graphInputs/cost, 12)
    GRAPHINPUTS(unit/graphInputs/replay, 13)
    GRAPHINPUTS(unit/graphInputs/lateRHS, 14)
    GRAPHINPUTS(unit/graphInputs/rejectedRHS, 15)
    GRAPHINPUTS(unit/graphInputs/sparseArgument, 16)
    GRAPHINPUTS(unit/graphInputs/embeddedArgument, 17)
    GRAPHINPUTS(unit/graphInputs/wholeListResult, 18)
    GRAPHINPUTS(unit/graphInputs/prefixListResult, 19)
    me bool: graphInputsCase(me string: testName, me int: caseID) <- <%{
        std::vector<std::string> inputs{"{_ 6 _}<:5","{_ 6 _}<!7","5:>{_ 6 _}","7!>{_ 6 _}","[_ 456 789]<:+123","[...] = 'Hello'","[...] = {1 2 3}","$ =: ($ = 'Hello')","$ == ($ = 'Hello')","{1 ...}<!7","[...] = 'Hello'"};
        std::vector<std::string> expected{"{5 6 _}","{_ 6 7}","{5 6 _}","{_ 6 7}","789","'Hello'","{1 2 3}","*_+'Hello'","'Hello'","{1 ...}<!7","'Hello'"};

        inputs.insert(inputs.end(),{"{1 ...}<!7","{_ 6 _}<:5","5:>{_ 6 _}","$ =: ($ = $)","$ =: ('A' = 'B')","*100000+{_| ...}<!7","{&{_ 6} 8}<:5"});
        expected.insert(expected.end(),{"","","{5 6 _}","","","",""});
        inputs.insert(inputs.end(),{"[...] == {1 2 3}","[...] ==: {1 2 3}"});
        expected.insert(expected.end(),{"{1 2 3}","*_+{1 2 3}"});
        GraphNormalizer normalizer;normalizer.init();auto root=graphParsed(testName,inputs.at(caseID));
        auto before=toString(root->pItem.get());
        if(caseID==9 || caseID==11 || caseID==12 || caseID==14 || caseID==15 || (caseID>=16 && caseID<18)) expected[caseID]=before;
        auto inner=root->pItem->innr;auto body=root->pItem->value;
        auto handle=caseID==12 ? normalizer.normalizeWithCost(root,1) : normalizer.normalize(root);handle.waitForCompletion();
        bool passed=caseID>=15 && caseID<18 ? true : !handle.status().failed && toString(root->pItem.get())==expected.at(caseID);
        if(caseID==9 || caseID==11) {
            passed &= handle.status().symbolicValues && handle.status().withSubscribers && root->pItem->funcArgs;
            if(caseID==11) handle.cancel();
            normalizer.runtime.update([&] {
                auto last=graphParsed(testName,"_");SetModeBits(last->pItem->flags,infonView::itmMode,infonView::mItem);
                body->items.append(last->pItem,false,918);
                SetFlagBit(body->flags,infonState::tailUnfinished,false);
                body->sizeMode=fromCount;
            });handle.waitForCompletion();
            if(caseID==11) passed &= handle.status().cancelled && root->pItem->funcArgs && body->items.tail->pItem->wrkList.empty();
            else passed &= !handle.status().failed && toString(root->pItem.get())=="{1 7}";
        }
        if(caseID==10) {
            passed &= inner && inner->value->items.isEmpty() && root->pItem->selectedResult &&
                getFlagBit(root->pItem->selectedResult->flags,POV::endRelativeReference) && handle.status().withSubscribers;
            normalizer.runtime.update([&] {
                auto last=graphParsed(testName,"$");SetModeBits(last->pItem->flags,infonView::itmMode,infonView::mItem);
                inner->value->items.append(last->pItem,false,918);
                SetFlagBit(inner->value->flags,infonState::tailUnfinished,false);
            });handle.waitForCompletion();
            passed &= !handle.status().failed && inner->value->items.tail->pItem->value->str=="Hello" &&
                getFlagBit(root->pItem->selectedResult->flags,POV::endRelativeResolved);
        }
        if(caseID==12) passed &= root->pItem->funcArgs && handle.status().withSubscribers;
        if(caseID==13) {
            auto count=normalizer.access->registry->identities.size();auto work=body->items.head->pItem->wrkList.size();
            auto again=normalizer.normalize(root);again.waitForCompletion();
            passed &= !again.status().failed && toString(root->pItem.get())==expected[caseID] &&
                normalizer.access->registry->identities.size()==count && body->items.head->pItem->wrkList.size()==work;
            again.cancel();
        }
        if(caseID==14) {
            auto source=root->pItem->wrkList.front()->pItem->value->items.head;
            normalizer.addRHS(source,graphParsed(testName,"'Hello'"));handle.waitForCompletion();
            passed &= !handle.status().failed && toString(root->pItem.get())=="*_+'Hello'" && handle.status().withSubscribers;
        }
        if(caseID==15) passed &= handle.status().failed && root->pItem->value->str.empty() && root->pItem->wrkList.size()==1;
        if(caseID==16) {
            auto selected=root->findImplicitItemPOV(99999);
            passed &= !handle.status().failed && body->items.isEmpty() && selected && selected->pItem->value->num==7 &&
                normalizer.access->demandedOccurrences(root).size()==1;
        }
        if(caseID==17) passed &= !handle.status().failed && body->items.head->pItem->value->items.head->pItem->value->num==5;
        if(!passed) {
            std::cout << "Input " << caseID << ": " << toString(root->pItem.get()) << " error=" << handle.status().error << "\n";
            for(const auto& step:handle.steps()) std::cout << step.action << "\n";
        }
        handle.cancel();normalizer.close();return passed;
    }%>
    void: unitTestGraphInputs(me string: testName, me int: caseID) <- {
        me bool: passed <- graphInputsCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHRESOLUTION(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphResolution(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHRESOLUTION(unit/graphResolution/direct, 0)
    GRAPHRESOLUTION(unit/graphResolution/external, 1)
    GRAPHRESOLUTION(unit/graphResolution/precedence, 2)
    GRAPHRESOLUTION(unit/graphResolution/replay, 3)
    GRAPHRESOLUTION(unit/graphResolution/multiple, 4)
    GRAPHRESOLUTION(unit/graphResolution/pendingDirect, 5)
    GRAPHRESOLUTION(unit/graphResolution/lateDirect, 6)
    GRAPHRESOLUTION(unit/graphResolution/cost, 7)
    GRAPHRESOLUTION(unit/graphResolution/orderedFirst, 8)

    me bool: graphResolutionCase(me string: testName, me int: caseID) <- <%{
        std::vector<std::string> expressions{"{a:1 b:2}~b","{a:1}^badge=7;~badge","{name:'local'}^name='external';~name","{a:1}^badge=7;~badge","{a:1}^badge","{_ b:2}^b=9;~b","{_ b:2}^b=9;~b","{a:1}^badge=7;~badge","{b:1 b:2}~b"};
        std::vector<std::string> expected{"b:2","badge:7","name:'local'","badge:7","","","","","b:1"};
        GraphNormalizer normalizer;normalizer.init();auto root=graphParsed(testName,expressions.at(caseID));
        auto original=root->pItem;auto before=toString(original.get());
        auto handle=caseID==7 ? normalizer.normalizeWithCost(root,1) : normalizer.normalize(root);handle.waitForCompletion();
        bool passed=!handle.status().failed;
        if(caseID==4) {
            auto state=root->pItem->pathSelection;
            normalizer.runtime.update([&] {
                for(const auto& value:{"badge:7","badge:8"}) {
                    auto member=graphParsed(testName,value);
                    normalizer.access->registry->recordExternalAssociation(state->source,state->predicate,member,{},"badge",0);
                }
            });handle.waitForCompletion();
            passed &= !handle.status().failed && root->pItem->isOrLike() && root->pItem->innr->value->items.size()==2;
        } else if(caseID==5 || caseID==6) {
            passed &= handle.status().withSubscribers && root->pItem->pathSelection && !root->pItem->pathSelection->result;
            if(caseID==6) {
                normalizer.runtime.update([&] {original->value->items.head->pItem=graphParsed(testName,"b:1")->pItem;});
                handle.waitForCompletion();passed &= !handle.status().failed && toString(root->pItem.get())=="b:1";
            }
        } else if(caseID==7) passed &= before==toString(root->pItem.get()) && normalizer.access->registry->externalAssociationReferences.empty();
        else passed &= toString(root->pItem.get())==expected[caseID];
        if(caseID==3) {
            auto count=normalizer.access->registry->externalAssociationReferences.size();
            auto again=normalizer.normalize(root);again.waitForCompletion();
            passed &= count==1 && normalizer.access->registry->externalAssociationReferences.size()==count && !again.status().failed;
            again.cancel();
        }
        if(!passed) {
            std::cout << "Resolution " << caseID << ": " << toString(root->pItem.get()) << " error=" << handle.status().error << "\n";
            for(const auto& step:handle.steps()) std::cout << step.action << "\n";
        }
        handle.cancel();normalizer.close();return passed;
    }%>
    void: unitTestGraphResolution(me string: testName, me int: caseID) <- {
        me bool: passed <- graphResolutionCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHCOMPATIBILITY(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphCompatibility(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHCOMPATIBILITY(unit/graphCompatibility/equalRejected, 0)
    GRAPHCOMPATIBILITY(unit/graphCompatibility/unequalAccepted, 1)
    GRAPHCOMPATIBILITY(unit/graphCompatibility/numericWildcard, 2)
    GRAPHCOMPATIBILITY(unit/graphCompatibility/stringWildcard, 3)
    GRAPHCOMPATIBILITY(unit/graphCompatibility/unknownPending, 4)
    GRAPHCOMPATIBILITY(unit/graphCompatibility/twoExclusions, 5)
    GRAPHCOMPATIBILITY(unit/graphCompatibility/sameExclusion, 6)
    GRAPHCOMPATIBILITY(unit/graphCompatibility/rhsExclusion, 7)
    GRAPHCOMPATIBILITY(unit/graphCompatibility/rhsRejected, 8)
    GRAPHCOMPATIBILITY(unit/graphCompatibility/numericString, 9)
    GRAPHCOMPATIBILITY(unit/graphCompatibility/stringNumeric, 10)
    GRAPHCOMPATIBILITY(unit/graphCompatibility/listNumeric, 11)
    GRAPHCOMPATIBILITY(unit/graphCompatibility/unknownOverlay, 12)
    GRAPHCOMPATIBILITY(unit/graphCompatibility/delayedAccepted, 13)
    GRAPHCOMPATIBILITY(unit/graphCompatibility/delayedRejected, 14)
    GRAPHCOMPATIBILITY(unit/graphCompatibility/cancelPending, 15)
    GRAPHCOMPATIBILITY(unit/graphCompatibility/qualifiedPending, 16)
    GRAPHCOMPATIBILITY(unit/graphCompatibility/nominalReject, 17)
    GRAPHCOMPATIBILITY(unit/graphCompatibility/nominalAccept, 18)
    GRAPHCOMPATIBILITY(unit/graphCompatibility/nominalUnknown, 19)
    me bool: graphCompatibilityCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer normalizer;normalizer.init();
        std::vector<std::string> expressions{
            "!*_+8 = *16+8", "!*_+8 = *16+9", "!*_+_ = *16+9", "!*_+$ = *5+'Hello'",
            "!*_+5 = *_+_", "!*_+5 = !*_+6", "!*_+5 = !*_+5", "*_+9 = !*_+8", "*_+8 = !*_+8",
            "_ = 'Hello'", "$ = 10", "{1} = 1", "!*_+8 = ?", "!*_+8 = *_+_", "!*_+8 = *_+_",
            "!*_+8 = *_+_", "!*_+8 == 9", "!wheel = wheel:9", "!wheel = pedal:9", "!wheel = 9"};
        auto root=graphParsed(testName,expressions.at(caseID)),source=root->pItem->wrkList.front();
        auto original=toString(source->pItem.get());
        auto left=normalizer.access->predicateFacts(root,false),right=normalizer.access->predicateFacts(source,true);
        auto handle=normalizer.normalize(root);handle.waitForCompletion();
        bool reject=caseID==17 || caseID==0 || caseID==2 || caseID==3 || caseID==8 || (caseID>=9 && caseID<=11);
        bool accepted=caseID==18 || caseID==1 || caseID==6 || caseID==7;
        // A decision does not copy fields, equate nodes, or destroy reusable RHSs.
        bool passed=handle.status().failed==reject && root->pItem->workListContainsPOV(source) &&
            !normalizer.access->hasDirectIdentity(root,source) && toString(source->pItem.get())==original;
        if(caseID!=16) passed &= left.same(normalizer.access->predicateFacts(root,false)) && right.same(normalizer.access->predicateFacts(source,true)) &&
            root->pItem->workIsRepresented(source)==accepted;
        if(caseID==16) passed &= handle.status().withSubscribers && !root->pItem->workIsRepresented(source);
        if(caseID>=13 && caseID<=15) {
            passed &= handle.status().withSubscribers;
            if(caseID==15) handle.cancel();
            normalizer.addRHS(source,graphParsed(testName,caseID==14 ? "*_+8" : "*_+9"));
            handle.waitForCompletion();
            if(caseID==15) passed &= handle.status().cancelled && !root->pItem->workIsRepresented(source);
            else passed &= handle.status().failed==(caseID==14) &&
                root->pItem->workIsRepresented(source)==(caseID==13) && left.same(normalizer.access->predicateFacts(root,false));
        }
        if(!passed) {
            std::cout << "Compatibility " << caseID << ": " << toString(root->pItem.get()) << " error=" << handle.status().error << "\n";
            for(const auto& step:handle.steps()) std::cout << step.action << "\n";
        }
        handle.cancel();normalizer.close();return passed;
    }%>
    void: unitTestGraphCompatibility(me string: testName, me int: caseID) <- {
        me bool: passed <- graphCompatibilityCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHCONTEXT(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphContext(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHCONTEXT(unit/graphContext/explicit, 0)
    GRAPHCONTEXT(unit/graphContext/implicit, 1)
    GRAPHCONTEXT(unit/graphContext/whole, 2)
    GRAPHCONTEXT(unit/graphContext/lateSource, 3)
    GRAPHCONTEXT(unit/graphContext/replaceSource, 4)
    GRAPHCONTEXT(unit/graphContext/pendingEarlier, 5)
    GRAPHCONTEXT(unit/graphContext/cancel, 6)
    GRAPHCONTEXT(unit/graphContext/cost, 7)
    GRAPHCONTEXT(unit/graphContext/agent, 8)
    GRAPHCONTEXT(unit/graphContext/empty, 9)
    me bool: graphContextCase(me string: testName, me int: caseID) <- <%{
        auto root=graphParsed(testName,caseID==0 ? "%ctx~b" : caseID==2 ? "%ctx" : "~b");
        if(caseID==8) {
            Agent agent;agent.init(nullptr);
            auto item=graphParsed(testName,"b:*10+2");
            agent.context.addContextPOV(item,agent.identityRegistry.get());
            auto handle=agent.normalize(root);handle.waitForCompletion();
            bool passed=!handle.status().failed && toString(root->pItem.get())=="b:*10+2";
            if(!passed) std::cout << "Agent context: " << toString(root->pItem.get()) << " " << handle.status().error << "\n";
            handle.cancel();
            auto whole=graphParsed(testName,"%ctx");
            auto first=agent.normalize(whole);first.waitForCompletion();
            passed &= first.status().fullyNormed && agent.graphNormalizer.access->listExtent(whole)==1;
            first.cancel();
            agent.graphNormalizer.runtime.update([&] {
                agent.context.addContextPOV(graphParsed(testName,"b:*10+3"),agent.identityRegistry.get());
            });
            auto next=agent.normalize(whole);next.waitForCompletion();
            passed &= next.status().fullyNormed && agent.graphNormalizer.access->listExtent(whole)==2;
            if(!passed) std::cout << "Context count after addition: " << toString(whole->pItem.get()) << " size=" << agent.graphNormalizer.access->listExtent(whole) << " error=" << next.status().error << "\n";
            next.cancel();
            agent.graphNormalizer.runtime.update([&] {agent.context.cull(1);});
            auto culled=agent.normalize(whole);culled.waitForCompletion();
            passed &= culled.status().fullyNormed && agent.graphNormalizer.access->listExtent(whole)==1;
            culled.cancel();agent.close();return passed;
        }
        GraphNormalizer normalizer;normalizer.init();
        auto source=graphParsed(testName,caseID==5 ? "{_ b:2}" : caseID==9 ? "{}" : caseID==4 ? "{b:*10+2}" : "{a:1 b:2}");
        auto original=toString(source->pItem.get());
        if(caseID!=3 && caseID!=6) normalizer.setContext(source);
        auto handle=caseID==7 ? normalizer.normalizeWithCost(root,1) : normalizer.normalize(root);handle.waitForCompletion();
        bool passed=!handle.status().failed;
        if(caseID==3 || caseID==6) {
            passed &= handle.status().withSubscribers;
            if(caseID==6) handle.cancel();
            normalizer.setContext(source);handle.waitForCompletion();
            passed &= caseID==6 ? handle.status().cancelled : toString(root->pItem.get())=="b:2";
        } else if(caseID==4) {
            passed &= toString(root->pItem.get())=="b:*10+2" && !handle.active();
            normalizer.setContext(graphParsed(testName,"{b:*10+3}"));
            passed &= toString(root->pItem.get())=="b:*10+2";
            auto again=normalizer.normalize(root);again.waitForCompletion();
            passed &= !again.status().failed && toString(root->pItem.get())=="b:*10+3";
            again.cancel();
        } else if(caseID==5) {
            passed &= handle.status().withSubscribers && !root->pItem->pathSelection->result;
            normalizer.runtime.update([&] {source->pItem->value->items.head->pItem=graphParsed(testName,"a:1")->pItem;});
            handle.waitForCompletion();passed &= toString(root->pItem.get())=="b:2";
        } else if(caseID==7) passed &= !root->pItem->pathSelection && toString(source->pItem.get())==original;
        else if(caseID==9) passed &= root->pItem->isOrLike() && root->pItem->innr->value->items.isEmpty();
        else passed &= toString(root->pItem.get())==(caseID==2 ? "{a:1 b:2}" : "b:2");
        if(!passed) {
            std::cout << "Context " << caseID << ": " << toString(root->pItem.get()) << " error=" << handle.status().error << "\n";
            for(const auto& step:handle.steps()) std::cout << step.action << "\n";
        }
        handle.cancel();normalizer.close();return passed;
    }%>
    void: unitTestGraphContext(me string: testName, me int: caseID) <- {
        me bool: passed <- graphContextCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHWORLD(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphWorld(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHWORLD(unit/graphWorld/field, 0)
    GRAPHWORLD(unit/graphWorld/whole, 1)
    GRAPHWORLD(unit/graphWorld/lateSource, 2)
    GRAPHWORLD(unit/graphWorld/cancel, 3)
    GRAPHWORLD(unit/graphWorld/replaceSource, 4)
    GRAPHWORLD(unit/graphWorld/agent, 5)
    GRAPHWORLD(unit/graphWorld/write, 6)
    GRAPHWORLD(unit/graphWorld/cost, 7)
    GRAPHWORLD(unit/graphWorld/anonymousPrefixPending, 8)
    GRAPHWORLD(unit/graphWorld/definitionPrefix, 9)

    me bool: graphWorldCase(me string: testName, me int: caseID) <- <%{
        auto source=graphParsed(testName,caseID==8 ? "{76543 b:*10+2}" : caseID==9 ? "{#b=*10+_ b:2}" : caseID==6 ? "{b:*10+_}" : "{b:*10+2}");
        auto root=graphParsed(testName,caseID==1 ? "%W" : caseID==6 ? "%W.b = *10+2" : "%W.b");
        if(caseID==5) {
            Agent agent;agent.init(nullptr);agent.world=source->pItem;
            auto handle=agent.normalize(root);handle.waitForCompletion();
            bool passed=!handle.status().failed && root->pItem->value->num==2;
            agent.world=graphParsed(testName,"{b:*10+3}")->pItem;
            auto again=agent.normalize(root);again.waitForCompletion();
            passed &= !again.status().failed && root->pItem->value->num==3;
            again.cancel();handle.cancel();agent.close();return passed;
        }
        GraphNormalizer normalizer;normalizer.init();
        if(caseID!=2 && caseID!=3) normalizer.setWorld(source->pItem);
        auto handle=caseID==7 ? normalizer.normalizeWithCost(root,1) : normalizer.normalize(root);
        handle.waitForCompletion();bool passed=!handle.status().failed;
        if(caseID==2 || caseID==3) {
            passed &= handle.status().withSubscribers;
            if(caseID==3) handle.cancel();
            normalizer.setWorld(source->pItem);handle.waitForCompletion();
        }
        if(caseID==4) {
            passed &= handle.status().fullyNormed && !handle.active();
            auto previous=root->pItem->pathSelection->result;
            normalizer.setWorld(graphParsed(testName,"{b:*10+3}")->pItem);
            passed &= root->pItem->value->num==2;
            auto again=normalizer.normalize(root);again.waitForCompletion();
            passed &= !again.status().failed && root->pItem->value->num==3 &&
                root->pItem->pathSelection->result!=previous && previous->pItem->value->num==2;
            again.cancel();
        } else if(caseID==3) passed &= handle.status().cancelled && !root->pItem->pathSelection->result;
        else if(caseID==7) passed &= !root->pItem->pathSelection;
        else if(caseID==8) passed &= handle.status().withSubscribers && !root->pItem->pathSelection->result;
        else passed &= toString(root->pItem.get())==(caseID==1 ? "{b:*10+2}" : "b:*10+2");
        if(caseID==6) passed &= source->pItem->value->items.head->pItem->value->num==2;
        if(!passed) {
            std::cout << "World " << caseID << ": " << toString(root->pItem.get()) << " " << handle.status().error << "\n";
            for(const auto& step:handle.steps()) std::cout << step.action << "\n";
        }
        handle.cancel();normalizer.close();return passed;
    }%>
    void: unitTestGraphWorld(me string: testName, me int: caseID) <- {
        me bool: passed <- graphWorldCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHTYPECOPY(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphTypeCopy(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHTYPECOPY(unit/graphTypeCopy/unknown, 0)
    GRAPHTYPECOPY(unit/graphTypeCopy/numericKeepsInterpretation, 1)
    GRAPHTYPECOPY(unit/graphTypeCopy/listMemberKeepsInterpretation, 2)
    GRAPHTYPECOPY(unit/graphTypeCopy/namedTarget, 3)
    GRAPHTYPECOPY(unit/graphTypeCopy/intersection, 4)
    GRAPHTYPECOPY(unit/graphTypeCopy/definitionEvidence, 5)

    me bool: graphTypeCopyCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer normalizer;normalizer.init();
        std::string input=caseID==0 ? "?=a:*10+7" : caseID==1 ? "_=a:*10+7" :
            caseID==2 ? "{_}={a:*10+7}" : caseID==3 ? "b:*10+7=a:*10+7" : caseID==4 ? "[a:*10+7]" : "?=a";
        auto declarations=graphParsed(testName,"{#a=*10+7}");
        auto declared=normalizer.normalize(declarations);declared.waitForCompletion();
        auto root=graphParsed(testName,input);
        auto source=root->pItem->wrkList.empty() ? nullptr : root->pItem->wrkList.front();
        auto sourceBefore=source ? toString(source->pItem.get()) : "";
        auto handle=normalizer.normalize(root);handle.waitForCompletion();
        std::string expected=caseID==1 ? "*10+7" : caseID==2 ? "{*10+7}" : caseID==3 ? "b:*10+7" : "a:*10+7";
        bool passed=!handle.status().failed && toString(root->pItem.get())==expected;
        if(source && caseID!=5) passed &= toString(source->pItem.get())==sourceBefore;
        auto work=root->pItem->wrkList.size();auto repeated=normalizer.normalize(root);repeated.waitForCompletion();
        passed &= !repeated.status().failed && root->pItem->wrkList.size()<=work && toString(root->pItem.get())==expected;
        if(!passed) std::cout << "Type copy " << caseID << ": " << toString(root->pItem.get()) << " " << handle.status().error << "\n";
        repeated.cancel();handle.cancel();declared.cancel();normalizer.close();return passed;
    }%>
    void: unitTestGraphTypeCopy(me string: testName, me int: caseID) <- {
        me bool: passed <- graphTypeCopyCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHTEMPORALHEADER(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphTemporalHeader(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHTEMPORALHEADER(unit/graphTemporalHeader/literal, 0)
    GRAPHTEMPORALHEADER(unit/graphTemporalHeader/memberConstraint, 1)
    GRAPHTEMPORALHEADER(unit/graphTemporalHeader/identityMarker, 2)
