    }
}

#define GRAPHCHOICE(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphChoice(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHCHOICE(unit/graphChoice/number, 0)
    GRAPHCHOICE(unit/graphChoice/string, 1)
    GRAPHCHOICE(unit/graphChoice/reverse, 2)
