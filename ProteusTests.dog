        if(caseID==24) {expression="spoke:{length:_, color:$}.length";expected="*_+[length:*1000+123 ... ]";}
        if(caseID==25) {expression="spoke:{other:{length:_}}.other.length";}
        auto defs=graphParsed(testName,declarations);auto declared=normalizer.normalize(defs);declared.waitForCompletion();
        auto original=toString(defs->pItem.get());
        auto root=graphParsed(testName,expression);auto handle=caseID==15 ? normalizer.normalizeWithCost(root,1) : normalizer.normalize(root);handle.waitForCompletion();
        bool passed=!declared.status().failed;
