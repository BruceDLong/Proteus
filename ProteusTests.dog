    GRAPHUNORDERED(unit/graphUnordered/orderedNoMatch, 29)
    GRAPHUNORDERED(unit/graphUnordered/partialBoundNoMatch, 30)
    me bool: graphUnorderedCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer normalizer;normalizer.init();
        std::string expression="{wheel:*10+1, pedal:*10+2}";
        bool chain=(caseID>=13 && caseID<=21) || caseID==23 || caseID==26 || caseID==28;
        if(caseID==2 || caseID==8) expression="*2+"+expression;
        if(caseID==3) expression="*3+"+expression;
        if(caseID==4) expression="*1000000000+"+expression;
        if(caseID==5) expression="*2+{wheel:*10+1, wheel:*10+2}";
        if(caseID==6) expression="{pedal:*10+1, pedal:*10+2}";
        if(caseID==7) expression="*2+{wheel:*10+1, wheel:*10+2, wheel:*10+3}";
        if(chain) expression="{wheel:{position:*10+1}, wheel:{color:'red'}}.wheel.position";
        if(caseID==15) expression="*2+"+expression;
        if(caseID==16) expression="*2+{wheel:{position:*10+1}, wheel:{position:*10+2}}.wheel.position";
        if(caseID==17) expression="{wheel:{position:*10+1, color:'red'}, wheel:{position:*10+2}}.wheel.position";
        if(caseID==18) expression="{wheel:{? position:*10+1}, wheel:{position:*10+2}}.wheel.position";
        if(caseID==19) expression="{wheel:{&{...} position:*10+1}, wheel:{position:*10+2}}.wheel.position";
        if(caseID==20) expression="{wheel:{color:'red'}, wheel:{position:*10+2}}.wheel.position";
        if(caseID==21) expression="{wheel:{spoke:{length:*10+1}}, wheel:{spoke:{length:*10+2}}}.wheel.spoke.length";
        if(caseID==23) expression="*2+{wheel:{position:*10+1}, wheel:{position:*10+2}}.wheel.position";
        if(caseID==24 || caseID==25) expression="*_+[wheel:{position:*10+1} wheel:{position:*10+2}]";
        if(caseID==26) expression="{wheel:{position:?}, wheel:{position:*10+2}}.wheel.position";
        if(caseID==27 || caseID==28) expression="*2+{pedal:*10+1, pedal:*10+2}";
        if(caseID==28) expression+=".wheel.position";
        if(caseID==29) expression="{pedal:*10+1 pedal:*10+2}";
        if(caseID==30) expression="*3+{pedal:*10+1, pedal:*10+2}";
        auto source=graphParsed(testName,expression),predicate=graphParsed(testName,caseID==24 || caseID==25 ? "position" : "wheel");
        if(caseID==23) source->pItem->value->items.tail->pItem=source->pItem->value->items.head->pItem;
        if(caseID==24) source->pItem->addPOVToWrkList(graphParsed(testName,"?"));
        auto original=source->pItem;auto first=original->value->items.head;
        auto before=toString(original.get());
        auto handle=(chain || caseID==8 || caseID==9) ? normalizer.normalize(source) : normalizer.findField(source,predicate);
        handle.waitForCompletion();
        auto result=chain ? source->pItem->selectedResult : handle.result();
        bool passed=!handle.status().failed;
        bool implicit=!(caseID==2 || caseID==3 || caseID==4 || caseID==5 || caseID==7 || caseID==8 || caseID==15 || caseID==16 || caseID==23 || caseID>=27);
        auto description=std::make_shared<POV>(916);description->pItem=original;
        if(implicit && caseID!=24 && caseID!=25) passed &= normalizer.access->listExtent(description)==-1;
        if(caseID==8 || caseID==9) {
            passed &= getFlagBit(source->pItem->flags,infonView::isNormed)==(caseID==8) &&
                handle.status().symbolicValues==(caseID==9);
        } else if(caseID==7 || caseID==24) passed &= !result && handle.status().symbolicValues;
        else if(caseID==2 || caseID==23) passed &= result==(caseID==23 ? first->pItem->value->items.head : first) && !handle.status().symbolicValues && !handle.status().withSubscribers;
        else {
            std::string expected="*_+[wheel:*10+1 ... ]";
            if(caseID==5) expected="*_+[wheel:*10+1 wheel:*10+2]";
            if(caseID==6 || caseID==30) expected="*_+[ ... ]";
            if(chain) expected="*_+[position:*10+1 ... ]";
            if(caseID==16 || caseID==25) expected="*_+[position:*10+1 position:*10+2]";
            if(caseID==17) expected="*_+[position:*10+1 position:*10+2 ... ]";
            if(caseID==18 || caseID==19 || caseID==20) expected="*_+[position:*10+2 ... ]";
            if(caseID==21) expected="*_+[length:*10+1 length:*10+2 ... ]";
            if(caseID==26) expected="*_+[position position:*10+2 ... ]";
            if(caseID>=27 && caseID<=29) expected="*_+[]";
            passed &= result && result->pItem->isOrLike() && toString(result->pItem.get())==expected &&
                handle.status().symbolicValues && handle.status().withSubscribers;
            if(chain) passed &= source->pItem->pathSelection->pending==(caseID!=16 && caseID!=28);
            if(result) {
                if(caseID>=27) passed &= result->pItem->innr->value->items.isEmpty() &&
                    getFlagBit(result->pItem->innr->value->flags,infonState::tailUnfinished)==(caseID==30);
                auto alias=result->pItem->innr->value->items.head;
                auto count=normalizer.access->registry->identities.size();
                normalizer.runtime.update([]{});handle.waitForCompletion();
                passed &= count==normalizer.access->registry->identities.size() &&
                    alias==result->pItem->innr->value->items.head;
                if(caseID==10 || caseID==12 || caseID==14) {
                    if(caseID==12) handle.cancel();
                    auto target=caseID==14 ? first->next : source;
                    auto added=graphParsed(testName,caseID==14 ? "position:*10+2" : "wheel:*10+3");
                    normalizer.runtime.update([&]{
                        target->pItem->value->items.appendPov(added);added->pParent=target.get();
                        normalizer.access->bind(added);++target->workRevision;
                    });handle.waitForCompletion();
                    auto current=chain ? source->pItem->selectedResult : handle.result();
                    passed &= current==result && alias==result->pItem->innr->value->items.head;
                    passed &= toString(result->pItem.get())==(caseID==12 ? expected : caseID==14 ?
                        "*_+[position:*10+1 position:*10+2 ... ]" : "*_+[wheel:*10+1 wheel:*10+3 ... ]");
                    if(caseID==12) passed &= handle.status().cancelled;
                }
                if(caseID==11) {
                    auto bound=graphParsed(testName,"*2+_");
                    normalizer.runtime.update([&]{
                        source->pItem->infSize=bound->pItem->infSize;
                        source->pItem->value->sizeMode=fromGiven;++source->workRevision;
                    });handle.waitForCompletion();
                    passed &= handle.result()==first && !handle.status().symbolicValues && !handle.status().withSubscribers;
                    passed &= toString(first->pItem.get())=="wheel:*10+1" && toString(first->next->pItem.get())=="pedal:*10+2";
                }
                if(caseID==26) {
                    normalizer.addRHS(first->pItem->value->items.head,graphParsed(testName,"*10+7"));handle.waitForCompletion();
                    passed &= source->pItem->selectedResult==result && alias==result->pItem->innr->value->items.head &&
                        toString(result->pItem.get())=="*_+[position:*10+7 position:*10+2 ... ]";
                }
                if(caseID==22) {
                    auto roundTrip=graphParsed(testName,toString(result->pItem.get()));
                    passed &= roundTrip->pItem->isOrLike() && getFlagBit(roundTrip->pItem->innr->value->flags,infonState::tailUnfinished);
                    auto bounded=graphParsed(testName,"*2+{wheel:*10+1, pedal:*10+2}");
                    auto copy=graphParsed(testName,toString(bounded->pItem.get()));
                    passed &= normalizer.access->listExtent(copy)==2 && normalizer.access->closedPhysicalList(copy);
                }
            }
        }
        if(caseID==4) passed &= !first->repetitionSpan.family && first->next && !first->next->next && handle.steps().size()<80;
        if(caseID!=10 && caseID!=11 && caseID!=12 && caseID!=14 && caseID!=26) passed &= toString(original.get())==before;
        if(!passed) {
            std::cout << "Unordered " << caseID << ": " << handle.status().error << " symbolic=" << handle.status().symbolicValues << "\n";
            if(result) std::cout << toString(result->pItem.get()) << "\n";
            for(const auto& step:handle.steps()) std::cout << step.action << "\n";
        }
        handle.cancel();normalizer.close();return passed;
    }%>
    void: unitTestGraphUnordered(me string: testName, me int: caseID) <- {
        me bool: passed <- graphUnorderedCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHPATHINDEX(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphPathIndex(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHPATHINDEX(unit/graphPathIndex/unknownTypedOrder, 31)
    GRAPHPATHINDEX(unit/graphPathIndex/pastEnd, 32)
    GRAPHPATHINDEX(unit/graphPathIndex/beforeStart, 33)
    GRAPHPATHINDEX(unit/graphPathIndex/unavailableOpenPosition, 34)
    GRAPHPATHINDEX(unit/graphPathIndex/typedNegative, 35)
    GRAPHPATHINDEX(unit/graphPathIndex/identityResolvesPosition, 36)
    GRAPHPATHINDEX(unit/graphPathIndex/positive, 1)
    GRAPHPATHINDEX(unit/graphPathIndex/negativeLast, 2)
    GRAPHPATHINDEX(unit/graphPathIndex/negativeSecond, 3)
    GRAPHPATHINDEX(unit/graphPathIndex/embedded, 4)
    GRAPHPATHINDEX(unit/graphPathIndex/nested, 5)
    GRAPHPATHINDEX(unit/graphPathIndex/indexThenField, 6)
    GRAPHPATHINDEX(unit/graphPathIndex/fieldThenIndex, 7)
    GRAPHPATHINDEX(unit/graphPathIndex/mixed, 8)
    GRAPHPATHINDEX(unit/graphPathIndex/openPrefix, 9)
    GRAPHPATHINDEX(unit/graphPathIndex/unknownEnd, 10)
    GRAPHPATHINDEX(unit/graphPathIndex/lateEnd, 11)
    GRAPHPATHINDEX(unit/graphPathIndex/cancel, 12)
    GRAPHPATHINDEX(unit/graphPathIndex/sparse, 13)
    GRAPHPATHINDEX(unit/graphPathIndex/skipSparse, 14)
    GRAPHPATHINDEX(unit/graphPathIndex/lateIndex, 15)
    GRAPHPATHINDEX(unit/graphPathIndex/zero, 16)
    GRAPHPATHINDEX(unit/graphPathIndex/fraction, 17)
    GRAPHPATHINDEX(unit/graphPathIndex/overflow, 18)
    GRAPHPATHINDEX(unit/graphPathIndex/singleSlice, 19)
    GRAPHPATHINDEX(unit/graphPathIndex/writeConflict, 20)
    GRAPHPATHINDEX(unit/graphPathIndex/choice, 21)
    GRAPHPATHINDEX(unit/graphPathIndex/partialChoice, 22)
    GRAPHPATHINDEX(unit/graphPathIndex/choiceThenField, 23)
    GRAPHPATHINDEX(unit/graphPathIndex/indexExpression, 24)
    GRAPHPATHINDEX(unit/graphPathIndex/lateSelectedValue, 25)
    GRAPHPATHINDEX(unit/graphPathIndex/identityRoutes, 26)
    GRAPHPATHINDEX(unit/graphPathIndex/negativeSparse, 27)
    GRAPHPATHINDEX(unit/graphPathIndex/embeddedEnd, 28)
    GRAPHPATHINDEX(unit/graphPathIndex/replyMetadata, 29)
    GRAPHPATHINDEX(unit/graphPathIndex/indexContinuationRHS, 30)

    me bool: graphPathIndexCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer normalizer;normalizer.init();
        std::string expression="{*10+1 *10+2 *10+3}@[2]",expected="*10+2";
        switch(caseID) {
        case 2:expression="{*10+1 *10+2 *10+3}@[-1]";expected="*10+3";break;
        case 3:expression="{*10+1 *10+2 *10+3}@[-2]";break;
        case 4:expression="{*10+1 &{*10+2 *10+3} *10+4}@[3]";expected="*10+3";break;
        case 5:expression="{{*10+1 *10+2} {*10+3 *10+4}}@[2]@[1]";expected="*10+3";break;
        case 6:expression="{{a:*10+1} {a:*10+2}}@[2].a";expected="a:*10+2";break;
        case 7:expression="{items:{*10+1 *10+2}}.items@[2]";break;
        case 8:expression="{items:{{wheel:{position:*10+1}} {wheel:{position:*10+2}}}}.items@[2].wheel.position";expected="position:*10+2";break;
        case 9:expression="{*10+1 *10+2 ...}@[2]";break;
        case 10:case 11:case 12:expression="{*10+1 *10+2 ...}@[-1]";break;
        case 13:expression="*1000000000+{*10+7|...}@[900000001]";expected="*10+7";break;
        case 14:expression="{&*1000000000+{*10+7|...} *10+2}@[1000000001]";break;
        case 15:expression="{*10+1 *10+2}@[?]";break;
        case 16:expression="{*10+1 *10+2}@[0]";break;
        case 17:expression="{*10+1 *10+2}@[1/2]";break;
        case 18:expression="{*10+1 *10+2}@[9223372036854775808]";break;
        case 19:expression="{*10+1 *10+2}@[0:*1+{...}]";expected="{*10+1}";break;
        case 20:expression="{*10+1 *10+2}@[2]=3;";break;
        case 21:expression="*_+[{*10+1 *10+2} {*10+3 *10+4}]@[2]";expected="*_+[*10+2 *10+4]";break;
        case 22:expression="*_+[{*10+1 ...} {*10+3 *10+4}]@[2]";expected="*_+[*10+4 ... ]";break;
        case 23:expression="*_+[{{a:*10+1} {a:*10+2}} {{a:*10+3} {a:*10+4}}]@[2].a";expected="*_+[a:*10+2 a:*10+4]";break;
        case 24:expression="{*10+1 *10+2}@[{n:*10+2}.n]";break;
        case 25:expression="{*10+1 ?}@[2]";break;
        case 26:expression="*_+[{*10+1 *10+2} {*10+3 *10+4}]@[2]";expected="*_+[*10+2 *10+4]";break;
        case 27:expression="*1000000000+{*10+7|...}@[-1]";expected="*10+7";break;
        case 28:expression="{*10+1 &{*10+2 *10+3} *10+4}@[-2]";expected="*10+3";break;
        case 29:expected="*10+2>>";break;
        case 31:expression="{items:{*10+1 *10+2}}.items@[2]";break;
        case 32:expression="{*10+1 *10+2}@[3]";expected="*_+[]";break;
        case 33:expression="{*10+1 *10+2}@[-3]";expected="*_+[]";break;
        case 34:expression="{*10+1 ...}@[2]";break;
        case 35:expression="{items:{*10+1 *10+2}}.items@[-1]";break;
        case 36:expression="*_+[*2+{&{...} *10+2 ...} {*10+3 *10+4}]@[2]";expected="*_+[*10+2 *10+4]";break;
        case 30:expression="{*10+1 *10+2}@[2]=*10+2";break;
        }
        if(caseID==7 || caseID==8 || caseID==35) {
            auto declarations=normalizer.normalize(graphParsed(testName,"{#items={...}}"));declarations.waitForCompletion();
        }
        auto root=graphParsed(testName,expression);auto original=root->pItem;
        auto before=toString(original.get());auto first=original->value->items.head;
        if(caseID==29) {
            root->pItem->originID=717;root->pItem->infCharPos=19;root->pItem->replyCharPos=23;
            SetFlagBit(root->pItem->flags,infonView::doReply,true);
        }
        if(caseID==26 || caseID==36) {
            std::string alternate="*2+{";
            if(caseID==36) for(int i=0;i<30;++i) alternate+="&{} ";
            alternate+="*10+1 *10+2}";
            normalizer.recordIdentity(original->innr->value->items.head,graphParsed(testName,alternate));
        }
        before=toString(original.get());
        auto handle=normalizer.normalize(root);handle.waitForCompletion();
        bool passed=!handle.status().failed;
        if(caseID==10 || caseID==11 || caseID==12 || caseID==15 || caseID==25) {
            passed &= handle.status().symbolicValues && handle.status().withSubscribers;
            if(caseID==12) handle.cancel();
            if(caseID==11 || caseID==12) normalizer.runtime.update([&] {
                auto source=root->pItem->pathSelection->source;
                SetFlagBit(source->pItem->value->flags,infonState::tailUnfinished,false);++source->workRevision;
            });
            if(caseID==15) normalizer.addRHS(root->pItem->pathSelection->predicate,graphParsed(testName,"*10+2"));
            if(caseID==25) normalizer.addRHS(first->next,graphParsed(testName,"*10+2"));
            handle.waitForCompletion();
        }
        bool deferred=caseID==10 || caseID==12 || (caseID>=16 && caseID<=18) || caseID==31 || caseID==34;
        if(caseID==20) {
            passed=handle.status().failed && first->next->pItem->value->num==2;
        } else if(deferred) {
            passed &= handle.status().symbolicValues && !root->pItem->selectedResult;
            if(caseID==12) passed &= handle.status().cancelled;
        } else {
            passed &= !handle.status().failed && toString(root->pItem.get())==expected;
            if((caseID<21 || caseID>23) && caseID!=26 && caseID!=32 && caseID!=33 && caseID!=36) passed &= !handle.status().symbolicValues;
            if(caseID==26 || caseID==32 || caseID==33 || caseID==36) passed &= root->pItem->pathSelection && !root->pItem->pathSelection->pending;
            auto selected=root->pItem->selectedResult;auto identities=normalizer.access->registry->identities.size();
            auto replay=normalizer.normalize(root);replay.waitForCompletion();
            passed &= !replay.status().failed && selected==root->pItem->selectedResult && identities==normalizer.access->registry->identities.size();
            replay.cancel();
        }
        if(caseID==13 || caseID==27) {
            auto source=root->pItem->pathSelection->source;
            passed &= source->pItem->value->items.size()==0 && source->repetitionSpan.family && source->repetitionSpan.family->occurrences.size()==1;
        }
        if(caseID==14) passed &= !first->repetitionSpan.family && first->pItem->value->items.size()==0;
        if(caseID==29) passed &= root->pItem->originID==717 && root->pItem->infCharPos==19 && root->pItem->replyCharPos==23 && getFlagBit(root->pItem->flags,infonView::doReply);
        if(caseID==30) passed &= root->pItem->selectedResult==first->next && first->next->pItem->wrkList.empty() &&
            root->pItem->pathSelection->updates.size()==1 &&
            first->next->pItem->hasRHS(root->pItem->pathSelection->updates.front()->pItem) &&
            root->pItem->pathSelection->predicate->pItem->wrkList.empty();
        if(caseID!=11 && caseID!=12 && caseID!=15 && caseID!=20 && caseID!=25 && caseID!=30 && caseID!=36) passed &= before==toString(original.get());
        if(!passed) {
            std::cout << "Path index " << caseID << ": " << handle.status().error << " symbolic=" << handle.status().symbolicValues << "\n" << toString(root->pItem.get()) << "\n";
            for(const auto& step:handle.steps()) std::cout << step.action << "\n";
        }
        handle.cancel();normalizer.close();return passed;
    }%>
    void: unitTestGraphPathIndex(me string: testName, me int: caseID) <- {
        me bool: passed <- graphPathIndexCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }

}

#define GRAPHSLICE(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphSlice(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHSLICE(unit/graphSlice/span, 0)
    GRAPHSLICE(unit/graphSlice/zeroBoundary, 1)
