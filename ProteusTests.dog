    GRAPHSLICE(unit/graphSlice/insufficient, 9)
    GRAPHSLICE(unit/graphSlice/openPrefix, 10)
    GRAPHSLICE(unit/graphSlice/unknownEnd, 11)
    GRAPHSLICE(unit/graphSlice/lateEnd, 12)
