    GRAPHTEMPORAL(unit/graphTemporal/spatialValue, 7)
    GRAPHTEMPORAL(unit/graphTemporal/spatialBarrier, 8)
    GRAPHTEMPORAL(unit/graphTemporal/emptyNested, 9)
    GRAPHTEMPORAL(unit/graphTemporal/sparsePrev, 10)
    GRAPHTEMPORAL(unit/graphTemporal/sparseNext, 11)
    GRAPHTEMPORAL(unit/graphTemporal/lateEnd, 12)
    GRAPHTEMPORAL(unit/graphTemporal/cancel, 13)
    GRAPHTEMPORAL(unit/graphTemporal/boundaryIdentity, 14)
    GRAPHTEMPORAL(unit/graphTemporal/support, 15)
    GRAPHTEMPORAL(unit/graphTemporal/sameSides, 16)
    GRAPHTEMPORAL(unit/graphTemporal/differentCuts, 17)
    GRAPHTEMPORAL(unit/graphTemporal/pathReplay, 18)
    GRAPHTEMPORAL(unit/graphTemporal/unknownSides, 19)
    GRAPHTEMPORAL(unit/graphTemporal/changingCut, 20)
    GRAPHTEMPORAL(unit/graphTemporal/emptyCut, 21)
    GRAPHTEMPORAL(unit/graphTemporal/supportIdentity, 22)
    GRAPHTEMPORAL(unit/graphTemporal/lateTemporal, 23)
    GRAPHTEMPORAL(unit/graphTemporal/budget, 24)
    GRAPHTEMPORAL(unit/graphTemporal/streamMembers, 25)
    GRAPHTEMPORAL(unit/graphTemporal/nestedContext, 26)

    GRAPHTEMPORAL(unit/graphTemporal/supportAliases, 27)
    GRAPHTEMPORAL(unit/graphTemporal/lateNull, 28)
    GRAPHTEMPORAL(unit/graphTemporal/cursorCycle, 29)
    GRAPHTEMPORAL(unit/graphTemporal/repeatedValues, 30)
    GRAPHTEMPORAL(unit/graphTemporal/conflictingRead, 31)
    GRAPHTEMPORAL(unit/graphTemporal/latePrevious, 32)
    GRAPHTEMPORAL(unit/graphTemporal/selectedContext, 33)

    GRAPHTEMPORAL(unit/graphTemporal/changedStreamContext, 34)

    GRAPHTEMPORAL(unit/graphTemporal/sparseLocatedCut, 48)
    GRAPHTEMPORAL(unit/graphTemporal/lateSideValue, 46)
    GRAPHTEMPORAL(unit/graphTemporal/cubeOrientationMapping, 47)
    GRAPHTEMPORAL(unit/graphTemporal/mappedChain, 49)
    GRAPHTEMPORAL(unit/graphTemporal/lateMappedChain, 50)
    GRAPHTEMPORAL(unit/graphTemporal/alignedIndependentHistories, 51)
    GRAPHTEMPORAL(unit/graphTemporal/locatedCut, 37)
    GRAPHTEMPORAL(unit/graphTemporal/lateCutIdentity, 38)
    GRAPHTEMPORAL(unit/graphTemporal/nestedLocatedCut, 39)
    GRAPHTEMPORAL(unit/graphTemporal/mappedHistory, 40)
    GRAPHTEMPORAL(unit/graphTemporal/unmappedState, 41)
    GRAPHTEMPORAL(unit/graphTemporal/cutEndpoint, 42)
    GRAPHTEMPORAL(unit/graphTemporal/cutCancellation, 43)
    GRAPHTEMPORAL(unit/graphTemporal/sparseUnlocatedCut, 44)
    GRAPHTEMPORAL(unit/graphTemporal/contradictoryCut, 45)

    GRAPHTEMPORAL(unit/graphTemporal/structuralBoundary, 35)
    GRAPHTEMPORAL(unit/graphTemporal/embeddedContext, 36)

    me bool: graphTemporalCase(me string: testName, me int: caseID) <- <%{
        using namespace proteus4;
        GraphNormalizer n;n.init();auto reg=n.access->registry;
        auto parse=[&](std::string s){return graphParsed(testName,s);};
        auto norm=[&](const POVNode& p){auto h=n.normalize(p);h.waitForCompletion();return h;};
        auto bound=[&](const POVNode& p,bool end){auto h=n.findBoundary(p,end);h.waitForCompletion();return h.result();};
        auto support=[&](const POVNode& p){auto h=n.findTemporalSupport(p);h.waitForCompletion();return h.result();};
        auto cut=[&](const POVNode& p){auto h=n.findTemporalCut(p);h.waitForCompletion();return h;};
        bool ok=true;
        if(caseID<=14 || caseID==25 || caseID==26) {
            std::string input="{T *10+1 %tprev}",expected="{T *10+1 *10+1}";
            switch(caseID) {
            case 2: input="{T %tnext *10+2}";expected="{T *10+2 *10+2}";break;
            case 3: input="{T {T *10+1 *10+2} {T %tprev *10+4}}";expected="{T {T *10+1 *10+2} {T *10+2 *10+4}}";break;
            case 4: input="{T {T *10+1 %tnext} {T *10+3 *10+4}}";expected="{T {T *10+1 *10+3} {T *10+3 *10+4}}";break;
            case 5: input="{T *10+1 _ = %tprev}";break;
            case 6: input="{T _ = %tnext *10+2}";expected="{T *10+2 *10+2}";break;
            case 7: input="{T {*10+1 *10+2} %tprev}";expected="{T {*10+1 *10+2} {*10+1 *10+2}}";break;
            case 8: input="{T *10+1 {*10+2 %tprev}}";break;
            case 9: input="{T *10+1 {T} {T {T}} %tprev}";expected="{T *10+1 {T } {T {T }} *10+1}";break;
            case 10: input="{T *1000000000+{T *10+7|...} %tprev}";break;
            case 11: input="{T %tnext *1000000000+{T *10+7|...}}";break;
            case 12: case 13: input="{T {T *10+1 ...} %tprev}";break;
            case 26: input="{{T *10+1 %tprev} *10+9}";expected="{{T *10+1 *10+1} *10+9}";break;
            }
            auto p=parse(input);auto a=POVDescription(p).member(),b=POVDescription(p).member(true);
            if(caseID==25) n.runtime.update([&]{SetModeBits(p->pItem->flags,infonView::streamState,infonView::parseListReady);SetFlagBit(p->pItem->value->flags,infonState::tailUnfinished,true);});
            auto h=norm(p);ok=!h.status().failed;
            if(caseID==8 || caseID==12 || caseID==13) {
                ok &= h.status().symbolicValues && h.status().withSubscribers;
                if(caseID==12 || caseID==13) {
                    if(caseID==13) h.cancel();
                    n.addRHS(a,parse("{T *10+1 *10+2}"));h.waitForCompletion();
                    ok &= caseID==13 ? h.status().cancelled && !b->pItem->temporalValueSource :
                        !h.status().failed && b->pItem->value->num==2 && n.access->known(b)==3;
                }
            } else if(caseID==10 || caseID==11) {
                auto span=caseID==10 ? a : b, cursor=caseID==10 ? b : a;
                ok &= n.access->known(cursor)==3 && cursor->pItem->value->num==7 &&
                    span->pItem->value->items.size()==0 && span->repetitionSpan.family && span->repetitionSpan.family->occurrences.size()==1;
            } else if(caseID==25) {
                ok &= h.status().withSubscribers && n.access->known(b)==3 && b->pItem->value->num==1;
                n.runtime.update([&]{SetModeBits(p->pItem->flags,infonView::streamState,infonView::parseDone);SetFlagBit(p->pItem->value->flags,infonState::tailUnfinished,false);});
                h.waitForCompletion();ok &= !h.status().failed && h.status().fullyNormed;
            } else ok &= toString(p->pItem.get())==expected && h.status().fullyNormed;
            if(caseID==14) {
                auto startA=bound(a,false),startB=bound(b,false),endA=bound(a,true);bound(p,false);
                ok &= !reg->areIdentical(a,b) && !reg->areIdentical(startA,startB) && reg->areIdentical(endA,startB);
                ok &= b->pItem->temporalValueSource==a;
            }
            if(!ok) std::cout<<"Temporal "<<caseID<<" actual="<<toString(p->pItem.get())<<" expected="<<expected<<" error="<<h.status().error<<" symbolic="<<h.status().symbolicValues<<"\n";
        } else if(caseID==15 || caseID==22) {
            auto p=parse(caseID==15 ? "{*10+1 *10+2}" : "{T *10+1 *10+2}");
            auto span=support(p);ok=span && support(p)==span && support(span)==span;
            if(caseID==15) ok &= span!=p && !reg->areIdentical(p,span) && span->pItem->value->items.size()==0 &&
                getModeBits(span->pItem->infSize->flags,infonState::evalMode)==infonState::emUnknown &&
                reg->areIdentical(bound(p,false),bound(span,false)) && reg->areIdentical(bound(p,true),bound(span,true));
            else ok &= span==p;
        } else if(caseID==16 || caseID==17 || caseID==19 || caseID==20 || caseID==23) {
            auto p=parse(caseID==19 || caseID==23 ? "?" : caseID==20 ? "{T *10+1 *10+2}" : "{*10+1 *10+2}");
            auto h=cut(p);auto c=h.result();ok=!h.status().failed && c && c->pItem->isNull();
            auto left=n.findTemporalSide(c,false),right=n.findTemporalSide(c,true);left.waitForCompletion();right.waitForCompletion();
            if(caseID==19 || caseID==20 || caseID==23) {
                ok &= left.status().withSubscribers && right.status().withSubscribers && !left.result() && !right.result();
                if(caseID!=20) {
                    n.addRHS(p,parse(caseID==19 ? "{*10+1 *10+2}" : "{T *10+1 *10+2}"));norm(p);
                    left.waitForCompletion();right.waitForCompletion();
                    if(caseID==19) ok &= left.result()==p && right.result()==p;
                    else ok &= !left.result() && !right.result();
                }
            } else {
                ok &= left.result()==p && right.result()==p && !left.status().symbolicValues && !right.status().symbolicValues;
                auto ref=c->temporalSplit.reference;
                ok &= ref && ref->prefixSpan!=ref->suffixSpan && !reg->areIdentical(ref->prefixSpan,ref->suffixSpan) &&
                    reg->areIdentical(bound(ref->prefixSpan,true),bound(ref->suffixSpan,false)) &&
                    reg->areIdentical(bound(ref->sourceSpan,false),bound(ref->prefixSpan,false)) &&
                    reg->areIdentical(bound(ref->sourceSpan,true),bound(ref->suffixSpan,true));
                if(caseID==17) {auto other=cut(p).result();ok &= other && other!=c && !reg->areIdentical(c,other);}
            }
        } else if(caseID==18) {
            auto p=parse("{*10+1 *10+2}.asTList.cut");auto h=norm(p);
            ok=!h.status().failed && p->pItem->isNull() && p->pItem->pathSelection;
            if(ok) {
                auto c=p->pItem->pathSelection->result;auto count=reg->temporalSplitReferences.size();
                auto again=norm(p);ok &= !again.status().failed && p->pItem->pathSelection->result==c && reg->temporalSplitReferences.size()==count && count==1;
            }
        } else if(caseID==21) {
            for(auto text:{"NULL:","{T}"}) {
                auto p=parse(text);auto h=cut(p);ok &= h.status().failed && reg->temporalSplitReferences.empty();
            }
        } else if(caseID==24) {
            auto p=parse("{*10+1 *10+2}");CostPolicy policy;policy.maximumRoute=1;
            auto h=n.runtime.normalize({p,temporalCut,0},policy);h.waitForCompletion();
            ok=!h.status().failed && h.status().symbolicValues && !h.result() && reg->temporalSplitReferences.empty() && reg->temporalProjectionReferences.empty();
            h.cancel();ok &= h.status().cancelled;
        }
        if(caseID==27) {
            auto a=parse("{*10+1}"),b=parse("{*10+1}");n.recordIdentity(a,b);
            auto sa=support(a),sb=support(b);
            ok=sa && sb && reg->areIdentical(sa,sb) && !reg->areIdentical(a,sa);
        } else if(caseID==28) {
            auto p=parse("?");auto h=cut(p);auto c=h.result();
            auto side=n.findTemporalSide(c,false);side.waitForCompletion();
            n.runtime.update([&]{p->pItem->setToNull();});
            h.waitForCompletion();side.waitForCompletion();ok=h.status().failed && side.status().failed;
        } else if(caseID==29) {
            auto p=parse("{T %tnext %tprev}");auto h=norm(p);
            ok=!h.status().failed && h.status().withSubscribers && h.status().symbolicValues;
        } else if(caseID==30) {
            auto p=parse("{T 'parked' 'riding' 'parked'}");norm(p);bound(p,false);
            auto a=p->pItem->value->items.head,b=p->pItem->value->items.tail;
            ok=!reg->areIdentical(a,b) && !reg->areIdentical(bound(a,false),bound(b,false)) && support(a)!=support(b);
        } else if(caseID==31) {
            auto p=parse("{T *10+1 *10+2 = %tprev}");auto h=norm(p);
            ok=h.status().failed && p->pItem->value->items.head->pItem->value->num==1;
        } else if(caseID==32) {
            auto p=parse("{T _ %tprev}");auto h=norm(p);auto a=p->pItem->value->items.head,b=a->next;
            ok=h.status().withSubscribers && n.access->known(b)!=3;
            n.addRHS(a,parse("*10+7"));h.waitForCompletion();
            ok &= !h.status().failed && n.access->known(b)==3 && b->pItem->value->num==7 && !reg->areIdentical(a,b);
        } else if(caseID==33) {
            auto p=parse("{T *10+1 %tprev}@[2]");auto h=norm(p);
            ok=!h.status().failed && n.access->known(p)==3 && p->pItem->value->num==1;
        }
        if(caseID==34) {
            auto p=parse("{T *10+1 %tprev}");
            n.runtime.update([&]{SetModeBits(p->pItem->flags,infonView::streamState,infonView::parseListReady);SetFlagBit(p->pItem->value->flags,infonState::tailUnfinished,true);});
            auto h=norm(p);ok=!h.status().failed && h.status().withSubscribers;
            n.runtime.update([&]{p->pItem->orderMode=uUnordered;SetModeBits(p->pItem->flags,infonView::streamState,infonView::parseDone);});
            h.waitForCompletion();ok &= h.status().failed;
        }
        if(caseID==35 || caseID==36) {
            auto p=parse(caseID==35 ? "{T *10+9 {T %prev *10+3}}" : "{&{{T *10+1 %tprev}}}");
            auto h=norm(p);
            if(caseID==35) ok=!h.status().failed && h.status().withSubscribers && h.status().symbolicValues;
            else ok=!h.status().failed && h.status().fullyNormed && toString(p->pItem.get())=="{&{{T *10+1 *10+1}}}";
        }
        if(caseID>=37 && caseID<=45) {
            auto p=parse(caseID==39 ? "{T {T *10+1 *10+2} {T *10+3 *10+4}}" :
                         caseID==44 ? "*1000000000+{T *10+7|...}" : "{T *10+1 *10+2 *10+3}");
            auto original=toString(p->pItem.get());
            auto c=cut(p).result();
            auto a=POVDescription(p).member(),b=a ? a->next : nullptr;
            auto before=caseID==39 ? POVDescription(a).member(true) : a;
            auto after=caseID==39 ? POVDescription(b).member() : b;
            if(caseID==37) n.recordIdentity(c,bound(a,true));
            auto left=n.findTemporalSide(c,false),right=n.findTemporalSide(c,true);
            left.waitForCompletion();right.waitForCompletion();
            ok=caseID==37 ? left.result()==before && right.result()==after :
                !left.result() && !right.result() && left.status().withSubscribers && right.status().withSubscribers;
            if(caseID==44) {
                ok &= p->pItem->value->items.size()==0 &&
                    (!p->repetitionSpan.family || p->repetitionSpan.family->occurrences.empty());
            } else {
                if(caseID==43) {left.cancel();right.cancel();}
                // No state copying: boundary identity locates an existing cut.
                n.recordIdentity(c,bound(a,true));
                left.waitForCompletion();right.waitForCompletion();
                if(caseID==43) ok &= left.status().cancelled && right.status().cancelled && !left.result() && !right.result();
                else ok &= !left.status().failed && !right.status().failed && left.result()==before && right.result()==after;
                if(caseID==37) {
                    auto again=n.findTemporalSide(c,true);again.waitForCompletion();
                    ok &= again.result()==after && !reg->areIdentical(before,after);
                }
                if(caseID==40) {
                    auto mapped=parse("?");n.recordIdentity(mapped,p);
                    auto mappedCut=cut(mapped).result();n.recordIdentity(mappedCut,c);
                    auto mappedLeft=n.findTemporalSide(mappedCut,false),mappedRight=n.findTemporalSide(mappedCut,true);
                    mappedLeft.waitForCompletion();mappedRight.waitForCompletion();
                    ok &= mappedLeft.result()==before && mappedRight.result()==after;
                }
                if(caseID==41) {
                    auto unchanged=parse("{orientation:*10+7 location:*10+8}");
                    auto unchangedCut=cut(unchanged).result();n.recordIdentity(unchangedCut,c);
                    auto unchangedLeft=n.findTemporalSide(unchangedCut,false),unchangedRight=n.findTemporalSide(unchangedCut,true);
                    unchangedLeft.waitForCompletion();unchangedRight.waitForCompletion();
                    ok &= unchangedLeft.result()==unchanged && unchangedRight.result()==unchanged &&
                          !reg->areIdentical(unchanged,p) && unchanged->pItem->value->items.size()==2;
                }
                if(caseID==42 || caseID==45) {
                    // A later contradictory placement must fail when normalized again.
                    n.recordIdentity(c,bound(caseID==42 ? p : b,caseID==45));
                    auto invalid=n.findTemporalSide(c,false);invalid.waitForCompletion();
                    ok &= invalid.status().failed;
                }
            }
            ok &= toString(p->pItem.get())==original;
            if(!ok) std::cout<<"Located cut "<<caseID<<" left="<<bool(left.result())<<" right="<<bool(right.result())
                <<" left error="<<left.status().error<<" right error="<<right.status().error<<"\n";
        }
        if(caseID==46) {
            auto p=parse("{T *10+1 ?}");auto a=POVDescription(p).member(),b=a->next;
            auto c=cut(p).result();n.recordIdentity(c,bound(a,true));
            auto left=n.findTemporalSide(c,false),right=n.findTemporalSide(c,true);
            left.waitForCompletion();right.waitForCompletion();
            ok=left.result()==a && !right.result() && right.status().withSubscribers;
            n.addRHS(b,parse("*10+2"));right.waitForCompletion();
            ok &= !right.status().failed && right.result()==b && b->pItem->value->num==2 && a->pItem->value->num==1;
        }
        if(caseID==48) {
            auto p=parse("*1000000000+{T *10+7|...}");
            auto a=n.findItem(p,4000000),b=n.findItem(p,4000001);
            a.waitForCompletion();b.waitForCompletion();
            auto first=a.result(),second=b.result();
            if(!first || !second) return false;
            auto c=cut(p).result();
            n.recordIdentity(c,bound(first,true));n.recordIdentity(c,bound(second,false));
            auto left=n.findTemporalSide(c,false),right=n.findTemporalSide(c,true);
            left.waitForCompletion();right.waitForCompletion();
            ok=!left.status().failed && !right.status().failed && left.result()==first && right.result()==second &&
                p->pItem->value->items.size()==0 && p->repetitionSpan.family->occurrences.size()==2;
        }
        if(caseID==49 || caseID==50) {
            // Mappings relate histories, not just equal-valued initial states.
            // Multiple hops and a cycle must still use the ordinary graph walk.
            auto history=parse(caseID==50 ? "{T *10+0 ?}" : "{T *10+0 *10+5}");
            auto first=POVDescription(history).member(),second=first->next;
            auto middle=parse("?"),last=parse("?");
            n.recordIdentity(middle,history);n.recordIdentity(last,middle);
            auto sourceCut=cut(history).result();n.recordIdentity(sourceCut,bound(first,true));
            auto mappedCut=cut(last).result();n.recordIdentity(mappedCut,sourceCut);
            auto before=n.findTemporalSide(mappedCut,false),after=n.findTemporalSide(mappedCut,true);
            before.waitForCompletion();after.waitForCompletion();
            ok=!before.status().failed && before.result()==first && !after.status().failed;
            if(caseID==50) {
                ok &= !after.result() && after.status().withSubscribers && first->pItem->value->num==0;
                n.addRHS(second,parse("*10+5"));after.waitForCompletion();
            }
            ok &= !after.status().failed && after.result()==second && second->pItem->value->num==5 &&
                first->pItem->value->num==0 && !reg->areIdentical(first,second);
            // First prove the two-hop route, then add a redundant cycle.
            if(caseID==49) n.recordIdentity(history,last);
            auto identities=reg->identities.size();
            auto again=n.findTemporalSide(mappedCut,true);again.waitForCompletion();
            ok &= !again.status().failed && again.result()==second && reg->identities.size()==identities;
            if(!ok) std::cout<<"Mapped chain "<<caseID<<" before="<<before.status().error<<" after="<<after.status().error<<"\n";
        }
        if(caseID==51) {
            // Equal initial values and a shared cut do not equate histories.
            auto a=parse("{T *10+0 *10+5}"),b=parse("{T *10+0 *10+2}");
            auto aFirst=POVDescription(a).member(),bFirst=POVDescription(b).member();
            auto aCut=cut(a).result(),bCut=cut(b).result();
            n.recordIdentity(aCut,bound(aFirst,true));n.recordIdentity(bCut,bound(bFirst,true));
            n.recordIdentity(aCut,bCut);
            auto aAfter=n.findTemporalSide(aCut,true),bAfter=n.findTemporalSide(bCut,true);
            aAfter.waitForCompletion();bAfter.waitForCompletion();
            ok=!aAfter.status().failed && !bAfter.status().failed && aAfter.result()==aFirst->next &&
                bAfter.result()==bFirst->next && aAfter.result()->pItem->value->num==5 &&
                bAfter.result()->pItem->value->num==2 && !reg->areIdentical(a,b) && !reg->areIdentical(aFirst,bFirst);
        }
        if(caseID==47) {
            // Exercise stored cube data independently of full-model querying.
            // Parsing a second occurrence keeps the shared declaration intact.
            auto text=readAssetAsString("public/Things/rubixCube.pr");
            if(text.empty()) {std::cout<<"Cube model asset is required\n";return false;}
            auto model=parse(text);norm(model);POVNode declaration;
            for(auto at=POVDescription(model).member();at;at=at->next)
                if(n.access->isDefinition(at) && n.access->definitionName(at)==parse("solved-rubix-state")->pItem->type->typeID()) declaration=at;
            if(!declaration) {std::cout<<"solved-rubix-state declaration not found\n";return false;}
            auto written=toString(declaration->pItem->funcArgs.get());
            auto cube=parse(written);
            // Fixture preparation reads only explicitly stored model data.
            // Full definition/positional application has separate world tests;
            // it is not a premise of these temporal graph checks.
            auto field=[&](const POVNode& source,const char* type) -> POVNode {
                if(!source) return {};
                auto word=parse(type)->pItem->type->typeID();
                for(auto at=POVDescription(source).member();at;at=at->next)
                    if(at->pItem->type && at->pItem->type->typeID()==word) return at;
                return {};
            };
            auto edges=field(field(cube,"parts"),"edge-cubes");if(!edges) return false;
            auto described=[&](const char* front,const char* top) -> POVNode {
                auto hasColor=[&](const POVNode& owner,const char* role,const char* word) {
                    auto color=field(owner,role);if(!color) return false;
                    auto type=parse(word)->pItem->type->typeID();
                    for(const auto& rhs:color->pItem->wrkList)
                        if(rhs->pItem->type && rhs->pItem->type->typeID()==type) return true;
                    return false;
                };
                for(auto member=POVDescription(edges).member();member;member=member->next)
                    if(hasColor(member,"front-color",front) && hasColor(member,"top-color",top)) return member;
                return {};
            };
            auto cubie=described("red","white"),neighbor=described("red","blue");
            auto orientation=field(field(cubie,"thing"),"orientation");
            auto x=field(orientation,"xRot"),y=field(orientation,"yRot"),z=field(orientation,"zRot");
            auto neighborOrientation=field(field(neighbor,"thing"),"orientation");
            auto location=field(field(cubie,"thing"),"location");
            if(!x || !y || !z || !neighborOrientation || !location) {
                std::cout<<"Stored cube fields not reachable\n";return false;
            }
            auto oldOrientation=toString(orientation->pItem.get()),oldNeighbor=toString(neighborOrientation->pItem.get());
            auto history=parse("{T ? xRot:0.5}");
            auto initial=POVDescription(history).member(),changed=initial->next;
            n.recordIdentity(initial,x);
            auto change=cut(history).result();n.recordIdentity(change,bound(initial,true));
            // A second cube's x-rotation history is explicitly mapped to this
            // one. No identity is asserted for their other parts or supports.
            auto mappedHistory=parse("?");n.recordIdentity(mappedHistory,history);
            auto mappedCut=cut(mappedHistory).result();n.recordIdentity(mappedCut,change);
            auto before=n.findTemporalSide(mappedCut,false),after=n.findTemporalSide(mappedCut,true);
            before.waitForCompletion();after.waitForCompletion();
            // Side lookup returns an occurrence, not a normalized copy of its
            // payload. Compare the parsed 5/10 numerically without changing it.
            mpq_class afterValue=after.result() ? after.result()->pItem->value->num.val : mpq_class(-1);
            afterValue.canonicalize();
            ok=!before.status().failed && !after.status().failed && before.result() && after.result() &&
                before.result()->pItem->value->num==0 && afterValue==mpq_class(1,2) &&
                !reg->areIdentical(initial,changed);
            // These S-values span the change. Aligning an interior cut does
            // not manufacture a transition in any of them.
            for(auto unchanged:{y,z,location,neighborOrientation}) {
                auto c=cut(unchanged).result();n.recordIdentity(c,change);
                auto a=n.findTemporalSide(c,false),b=n.findTemporalSide(c,true);
                a.waitForCompletion();b.waitForCompletion();
                bool same=!a.status().failed && !b.status().failed && a.result()==unchanged && b.result()==unchanged;
                if(!same) std::cout<<"Unchanged cut failed: "<<toString(unchanged->pItem.get())<<" before="<<a.status().error<<" after="<<b.status().error<<"\n";
                ok &= same;
            }
            bool untouched=toString(orientation->pItem.get())==oldOrientation && toString(neighborOrientation->pItem.get())==oldNeighbor &&
                toString(declaration->pItem->funcArgs.get())==written && x->pItem->value->num==0;
            if(!untouched) std::cout<<"Cube source comparison: orientation="<<(toString(orientation->pItem.get())==oldOrientation)
                <<" neighbor="<<(toString(neighborOrientation->pItem.get())==oldNeighbor)<<" declaration="<<(toString(declaration->pItem->funcArgs.get())==written)<<"\n";
            ok &= untouched;
            std::cout<<"Cube xRot at mapped cut: "<<(before.result() ? toString(before.result()->pItem.get()) : "unresolved")
                <<" -> "<<(after.result() ? toString(after.result()->pItem.get()) : "unresolved")<<"\n";
        }
        if(!ok) std::cout<<"Temporal case "<<caseID<<" failed\n";
        n.close();return ok;
    }%>
    void: unitTestGraphTemporal(me string: testName, me int: caseID) <- {
        me bool: passed <- graphTemporalCase(testName,caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHDEFINITIONLANGUAGE(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphDefinitionLanguage(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHDEFINITIONLANGUAGE(unit/graphDefinitionLanguage/baseLanguage, 0)
    GRAPHDEFINITIONLANGUAGE(unit/graphDefinitionLanguage/regionalLanguage, 1)
    GRAPHDEFINITIONLANGUAGE(unit/graphDefinitionLanguage/foreignLanguage, 2)
    GRAPHDEFINITIONLANGUAGE(unit/graphDefinitionLanguage/regionalMismatch, 3)
    GRAPHDEFINITIONLANGUAGE(unit/graphDefinitionLanguage/separateLanguages, 4)
    GRAPHDEFINITIONLANGUAGE(unit/graphDefinitionLanguage/sameLanguageAmbiguous, 5)
    GRAPHDEFINITIONLANGUAGE(unit/graphDefinitionLanguage/qualifiedPending, 6)
    GRAPHDEFINITIONLANGUAGE(unit/graphDefinitionLanguage/qualifiedAlternativePending, 7)
    GRAPHDEFINITIONLANGUAGE(unit/graphDefinitionLanguage/untaggedAmbiguous, 8)
    GRAPHDEFINITIONLANGUAGE(unit/graphDefinitionLanguage/replay, 9)
    GRAPHDEFINITIONLANGUAGE(unit/graphDefinitionLanguage/lateDefinition, 10)
    GRAPHDEFINITIONLANGUAGE(unit/graphDefinitionLanguage/cancel, 11)
    GRAPHDEFINITIONLANGUAGE(unit/graphDefinitionLanguage/cost, 12)
    GRAPHDEFINITIONLANGUAGE(unit/graphDefinitionLanguage/isolatedLanguages, 13)
    GRAPHDEFINITIONLANGUAGE(unit/graphDefinitionLanguage/publicEntry, 14)

    me bool: graphDefinitionLanguageCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer normalizer;normalizer.initForLanguage("en_US");
        std::string declaration="{#digit <en>=*10+7}";
        if(caseID==1) declaration="{#digit <en_US>=*10+7}";
        if(caseID==2) declaration="{#digit <fr>=*10+9}";
        if(caseID==3) declaration="{#digit <en_GB>=*10+9}";
        if(caseID==4 || caseID==13) declaration="{#digit <fr>=*10+9 #digit <en>=*10+7}";
        if(caseID==5) declaration="{#digit <en>=*10+7 #digit <en>=*10+8}";
        if(caseID==6) declaration="{#digit <en name>=*10+7}";
        if(caseID==7) declaration="{#digit <en>=*10+7 #digit <en name>=*10+8}";
        if(caseID==8) declaration="{#digit=*10+8 #digit <en>=*10+7}";
        if(caseID==10 || caseID==11) declaration="{}";
        auto defs=graphParsed(testName,declaration);
        auto original=toString(defs->pItem.get());
        auto registered=normalizer.normalize(defs);registered.waitForCompletion();
        auto target=graphParsed(testName,"digit");
        auto handle=caseID==12 ? normalizer.normalizeWithCost(target,0) : normalizer.normalize(target);
        handle.waitForCompletion();
        bool known=caseID==0 || caseID==1 || caseID==4 || caseID==9 || caseID==13 || caseID==14;
        bool passed=!registered.status().failed && !registered.status().symbolicValues && !handle.status().failed;
        if(known) passed &= target->pItem->value->num==7 && target->pItem->infSize->num==10 && !handle.status().symbolicValues;
        else passed &= getModeBits(target->pItem->value->flags,infonState::evalMode)==infonState::emUnknown &&
            handle.status().symbolicValues && handle.status().withSubscribers;
        if(caseID==9) {
            auto repeated=normalizer.normalize(target);repeated.waitForCompletion();
            passed &= !repeated.status().failed && !repeated.status().symbolicValues && graphTypeSetCount(repeated)==0 && target->pItem->wrkList.empty();
        }
        if(caseID==10 || caseID==11) {
            if(caseID==11) handle.cancel();
            auto later=normalizer.normalize(graphParsed(testName,"{#digit <en>=*10+7}"));later.waitForCompletion();handle.waitForCompletion();
            if(caseID==10) passed &= !handle.status().symbolicValues && target->pItem->value->num==7;
            else passed &= handle.status().cancelled && getModeBits(target->pItem->value->flags,infonState::evalMode)==infonState::emUnknown;
        }
        if(caseID==13) {
            GraphNormalizer french;french.initForLanguage("fr_FR");
            auto otherDefs=french.normalize(graphParsed(testName,declaration));otherDefs.waitForCompletion();
            auto other=graphParsed(testName,"digit");auto otherHandle=french.normalize(other);otherHandle.waitForCompletion();
            passed &= !otherHandle.status().failed && !otherHandle.status().symbolicValues && other->pItem->value->num==9 && target->pItem->value->num==7;
            french.close();
        }
        if(caseID==14) {
            GraphLifecycleCore core;core.init("",false);
            auto language=core.agent->getLocaleBaseName();
            core.query("{#digit <"+language+">=*10+7}",false);
            auto answer=core.query("digit",false);
            passed &= answer && answer->value->num==7 && getFlagBit(answer->flags,infonView::isNormed);
            core.deInit();
        }
        passed &= original==toString(defs->pItem.get());
        if(!passed) std::cout << "Definition language " << caseID << ": " << toString(target->pItem.get()) << " " << handle.status().error << "\n";
        handle.cancel();registered.cancel();normalizer.close();return passed;
    }%>
    void: unitTestGraphDefinitionLanguage(me string: testName, me int: caseID) <- {
        me bool: passed <- graphDefinitionLanguageCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHDEFINITIONSHAPE(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphDefinitionShape(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHDEFINITIONSHAPE(unit/graphDefinitionShape/sparseHeader, 0)
    GRAPHDEFINITIONSHAPE(unit/graphDefinitionShape/unboundedHeader, 1)
    GRAPHDEFINITIONSHAPE(unit/graphDefinitionShape/alias, 2)
    GRAPHDEFINITIONSHAPE(unit/graphDefinitionShape/existingPrefix, 3)
    GRAPHDEFINITIONSHAPE(unit/graphDefinitionShape/sizeConflict, 4)
    GRAPHDEFINITIONSHAPE(unit/graphDefinitionShape/overlayConflict, 5)
    GRAPHDEFINITIONSHAPE(unit/graphDefinitionShape/jointHeaderConflict, 6)
    GRAPHDEFINITIONSHAPE(unit/graphDefinitionShape/distinctTemplatesPending, 7)
    GRAPHDEFINITIONSHAPE(unit/graphDefinitionShape/cost, 8)
    GRAPHDEFINITIONSHAPE(unit/graphDefinitionShape/replay, 9)
    GRAPHDEFINITIONSHAPE(unit/graphDefinitionShape/indexedAccess, 10)
    GRAPHDEFINITIONSHAPE(unit/graphDefinitionShape/lateDefinition, 11)
    GRAPHDEFINITIONSHAPE(unit/graphDefinitionShape/cancel, 12)
    GRAPHDEFINITIONSHAPE(unit/graphDefinitionShape/lateMemberMeaning, 13)

    me bool: graphDefinitionShapeCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer normalizer;normalizer.init();
        std::string declarations="{#part={...} #history=*1000000000+{T {&part}|...}}";
        if(caseID==1) declarations="{#part={...} #history={T {&part}|...}}";
        if(caseID==2) declarations="{#part={...} #history=alias #alias=*1000000000+{T {&part}|...}}";
        if(caseID==6 || caseID==7) declarations="{#part={...} #history=*1000000000+{T {&part}|...} #other=*"+
            std::string(caseID==6 ? "4" : "1000000000")+"+{T {&part}|...}}";
        if(caseID==11 || caseID==12) declarations="{}";
        auto defs=graphParsed(testName,declarations);
        auto original=toString(defs->pItem.get());
        auto registered=normalizer.normalize(defs);registered.waitForCompletion();
        auto target=graphParsed(testName,caseID==3 ? "history:{{*10+1} ...}" : caseID==4 ? "history:*2+{...}" : caseID==5 ? "history:7" : "history");
        auto originalTarget=toString(target->pItem.get());
        auto first=target->pItem->value->items.head;
        if(caseID==6 || caseID==7) target->pItem->addedTypes.push_back(graphParsed(testName,"other")->pItem->type);
        auto handle=caseID==8 ? normalizer.normalizeWithCost(target,0) : normalizer.normalize(target);
        handle.waitForCompletion();
        bool conflict=caseID>=4 && caseID<=6;
        bool deferred=caseID==7 || caseID==8 || caseID==11 || caseID==12;
        bool passed=!registered.status().failed && handle.status().failed==conflict;
        auto shaped=[&] {
            return getModeBits(target->pItem->value->flags,infonState::overlayType)==infonState::LST &&
                getFlagBit(target->pItem->value->flags,infonState::timelike) && target->pItem->value->listSpec &&
                target->pItem->value->items.head==first && !getFlagBit(target->pItem->flags,infonView::isNormed);
        };
        if(conflict) passed &= originalTarget==toString(target->pItem.get());
        else if(deferred) passed &= !target->pItem->value->listSpec && target->pItem->value->items.isEmpty() && handle.status().symbolicValues;
        else {
            passed &= shaped() && handle.status().symbolicValues && handle.status().withSubscribers;
            if(caseID==1) passed &= getModeBits(target->pItem->infSize->flags,infonState::evalMode)==infonState::emUnknown;
            else passed &= target->pItem->infSize->num==1000000000;
        }
        if(caseID==9) {
            auto spec=target->pItem->value->listSpec;auto count=target->pItem->wrkList.size();
            auto again=normalizer.normalize(target);again.waitForCompletion();
            passed &= !again.status().failed && shaped() && target->pItem->value->listSpec==spec && target->pItem->wrkList.size()==count;
            for(const auto& step:again.steps()) passed &= step.action!="Expose definition list shape";
            again.cancel();
        }
        if(caseID==10) {
            auto lookup=normalizer.findItem(target,999999999);lookup.waitForCompletion();
            auto item=lookup.result();
            passed &= !lookup.status().failed && item && item!=target && target->pItem->value->items.isEmpty() &&
                item->implicitItem.sourcePov && item->implicitItem.sourceIndex==999999999 && lookup.steps().size()<100;
            lookup.cancel();
        }
        if(caseID==11 || caseID==12) {
            if(caseID==12) handle.cancel();
            auto later=normalizer.normalize(graphParsed(testName,"{#part={...} #history=*1000000000+{T {&part}|...}}"));
            later.waitForCompletion();handle.waitForCompletion();
            if(caseID==11) passed &= !handle.status().failed && shaped();
            else passed &= handle.status().cancelled && !target->pItem->value->listSpec;
            later.cancel();
        }
        if(caseID==13) {
            auto replacement=graphParsed(testName,"{*10+1}");
            normalizer.runtime.update([&] {defs->pItem->value->items.head->pItem->funcArgs=replacement->pItem;});
            registered=normalizer.normalize(defs);registered.waitForCompletion();handle.waitForCompletion();
            auto lookup=normalizer.findItem(target,7);lookup.waitForCompletion();
            auto item=lookup.result();
            if(item && item!=target) {
                auto member=normalizer.normalize(item);member.waitForCompletion();
                passed &= !member.status().failed && item->pItem->value->items.head &&
                    item->pItem->value->items.head->pItem->value->num==1 && target->pItem->value->items.isEmpty();
                member.cancel();
            } else passed=false;
            lookup.cancel();
        } else passed &= original==toString(defs->pItem.get());
        if(!passed) {
            std::cout << "Definition shape " << caseID << ": " << toString(target->pItem.get()) << " " << handle.status().error << "\n";
            for(const auto& step:handle.steps()) std::cout << step.action << "\n";
        }
        handle.cancel();registered.cancel();normalizer.close();return passed;
    }%>
    void: unitTestGraphDefinitionShape(me string: testName, me int: caseID) <- {
        me bool: passed <- graphDefinitionShapeCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHRECORDDEFINITIONS(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphRecordDefinitions(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHRECORDDEFINITIONS(unit/graphRecordDefinitions/bare, 0)
    GRAPHRECORDDEFINITIONS(unit/graphRecordDefinitions/bounded, 1)
    GRAPHRECORDDEFINITIONS(unit/graphRecordDefinitions/partialAlias, 2)
    GRAPHRECORDDEFINITIONS(unit/graphRecordDefinitions/permutedConjunction, 3)
    GRAPHRECORDDEFINITIONS(unit/graphRecordDefinitions/additionalParts, 4)
    GRAPHRECORDDEFINITIONS(unit/graphRecordDefinitions/contradictoryDefinition, 5)
    GRAPHRECORDDEFINITIONS(unit/graphRecordDefinitions/nested, 6)
    GRAPHRECORDDEFINITIONS(unit/graphRecordDefinitions/cost, 7)
    GRAPHRECORDDEFINITIONS(unit/graphRecordDefinitions/distinctSameTypeParts, 8)
    GRAPHRECORDDEFINITIONS(unit/graphRecordDefinitions/lateFieldMeaning, 9)
    GRAPHRECORDDEFINITIONS(unit/graphRecordDefinitions/cancel, 10)
    GRAPHRECORDDEFINITIONS(unit/graphRecordDefinitions/definitionExtent, 11)
    GRAPHRECORDDEFINITIONS(unit/graphRecordDefinitions/permutedFields, 12)
    GRAPHRECORDDEFINITIONS(unit/graphRecordDefinitions/partialRHS, 13)
    GRAPHRECORDDEFINITIONS(unit/graphRecordDefinitions/newField, 14)
    GRAPHRECORDDEFINITIONS(unit/graphRecordDefinitions/atomicConflict, 15)
    GRAPHRECORDDEFINITIONS(unit/graphRecordDefinitions/ambiguousFields, 16)
    GRAPHRECORDDEFINITIONS(unit/graphRecordDefinitions/nominalAliases, 17)
    GRAPHRECORDDEFINITIONS(unit/graphRecordDefinitions/boundedUnion, 18)
    GRAPHRECORDDEFINITIONS(unit/graphRecordDefinitions/replay, 19)

    me bool: graphRecordDefinitionsCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer normalizer;normalizer.init();
        std::string declarations="{#record={X:*10+1, Y:*10+2}}",expression="record",expected="record:{X:*10+1, Y:*10+2}";
        if(caseID==1) {declarations="{#record=*2+{X:*10+1, Y:*10+2}}";expected="record:*2+{X:*10+1, Y:*10+2}";}
        if(caseID==2) {declarations="{#record={X:*10+1, Y:*10+2} #alias=record:{X:*10+1}}";expression="alias";expected="alias:{X:*10+1, Y:*10+2}";}
        if(caseID==3) declarations="{#record={X:*10+_, Y:*10+2}={Y:*10+2, X:*10+1}}";
        if(caseID==4) {declarations="{#record={X:*10+1, Y:*10+2}={Z:*10+3, W:*10+4}}";expected="record:{X:*10+1, Y:*10+2, Z:*10+3, W:*10+4}";}
        if(caseID==5) declarations="{#record={X:*10+_, Y:*10+2}={X:*10+1, Y:*10+3}}";
        if(caseID==6) {declarations="{#part={X:*10+1, Y:*10+2} #Child=part #record={Child, Z:*10+3}}";expected="record:{Child:{X:*10+1, Y:*10+2}, Z:*10+3}";}
        if(caseID==8) {declarations="{#record={X:*10+1, X:*10+2}}";expected="record:{X:*10+1, X:*10+2}";}
        if(caseID==9 || caseID==10) declarations="{#record={X, Y:*10+2}}";
        if(caseID==11) declarations="{#record=*1+{X:*10+1, Y:*10+2}}";
        if(caseID>=12) declarations="{}";
        if(caseID==12 || caseID==19) {expression="{X:*10+_, Y:*10+2}={Y:*10+2, X:*10+1}";expected="{X:*10+1, Y:*10+2}";}
        if(caseID==13) {expression="{X:*10+_, Y:*10+2}={X:*10+1, ...}";expected="{X:*10+1, Y:*10+2}";}
        if(caseID==14) {expression="{X:*10+1, Y:*10+2}={Y:*10+2, Z:*10+3}";expected="{X:*10+1, Y:*10+2, Z:*10+3}";}
        if(caseID==15) expression="{X:*10+_, Y:*10+2}={X:*10+1, Y:*10+3}";
        if(caseID==16) expression="{X:*10+_, X:*10+_}={X:*10+1, X:*10+2}";
        if(caseID==17) {declarations="{#alias=X}";expression="{X:*10+_, Y:*10+2}={Y:*10+2, alias:*10+1}";expected="{X:*10+1, Y:*10+2}";}
        if(caseID==18) expression="*2+{X:*10+1, Y:*10+2}={Y:*10+2, Z:*10+3}";
        auto defs=graphParsed(testName,declarations);
        auto registered=normalizer.normalize(defs);registered.waitForCompletion();
        auto definitionBefore=toString(defs->pItem.get());
        auto root=graphParsed(testName,expression);
        auto source=root->pItem->wrkList.empty() ? proteus4::POVNode{} : root->pItem->wrkList.front();
        auto sourceBefore=source ? toString(source->pItem.get()) : "";
        auto original=toString(root->pItem.get());
        auto identities=normalizer.access->registry->identities.size();
        auto handle=caseID==7 ? normalizer.normalizeWithCost(root,0) : normalizer.normalize(root);
        handle.waitForCompletion();
        bool rejected=caseID==5 || caseID==11 || caseID==15 || caseID==18;
        bool pending=caseID==7 || caseID==16;
        bool passed=handle.status().failed==rejected;
        auto first=root->pItem->value->items.head;
        if(rejected || pending) {
            passed &= toString(root->pItem.get())==original && identities==normalizer.access->registry->identities.size();
            if(pending) passed &= handle.status().symbolicValues;
        } else if(caseID==9 || caseID==10) {
            passed &= first && root->pItem->value->items.size()==2 && handle.status().withSubscribers;
            if(caseID==10) handle.cancel();
            auto more=graphParsed(testName,"{#X=*10+1}");
            auto publish=normalizer.normalize(more);publish.waitForCompletion();handle.waitForCompletion();
            if(caseID==9) passed &= first && first->pItem->value->num==1;
            else passed &= handle.status().cancelled && first && getModeBits(first->pItem->value->flags,infonState::evalMode)==infonState::emUnknown;
            publish.cancel();
        } else {
            passed &= toString(root->pItem.get())==expected;
            if(caseID==1) passed &= getFlagBit(root->pItem->flags,infonView::isNormed) && !handle.status().symbolicValues;
            if(caseID!=1 && caseID!=2) passed &= getModeBits(root->pItem->infSize->flags,infonState::evalMode)==infonState::emUnknown;
            auto count=root->pItem->value->items.size();auto text=toString(root->pItem.get());
            auto before=normalizer.access->registry->identities.size();
            auto again=normalizer.normalize(root);again.waitForCompletion();
            passed &= !again.status().failed && first==root->pItem->value->items.head && count==root->pItem->value->items.size() &&
                text==toString(root->pItem.get()) && before==normalizer.access->registry->identities.size();
            again.cancel();
        }
        passed &= definitionBefore==toString(defs->pItem.get());
        if(source) passed &= sourceBefore==toString(source->pItem.get());
        if(!passed) {
            std::cout << "Record definition " << caseID << ": " << toString(root->pItem.get()) << " expected=" << expected <<
                " symbolic=" << handle.status().symbolicValues << " subscribers=" << handle.status().withSubscribers << " error=" << handle.status().error << "\n";
            for(const auto& step:handle.steps()) if(step.action!="visit") std::cout << step.action << "\n";
        }
        handle.cancel();registered.cancel();normalizer.close();return passed;
    }%>
    void: unitTestGraphRecordDefinitions(me string: testName, me int: caseID) <- {
        me bool: passed <- graphRecordDefinitionsCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHDEFINITIONORDER(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphDefinitionOrder(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHDEFINITIONORDER(unit/graphDefinitionOrder/partial, 0)
    GRAPHDEFINITIONORDER(unit/graphDefinitionOrder/alias, 1)
    GRAPHDEFINITIONORDER(unit/graphDefinitionOrder/aliasChain, 2)
    GRAPHDEFINITIONORDER(unit/graphDefinitionOrder/replay, 3)
    GRAPHDEFINITIONORDER(unit/graphDefinitionOrder/bounded, 4)
    GRAPHDEFINITIONORDER(unit/graphDefinitionOrder/partialExtent, 5)
    GRAPHDEFINITIONORDER(unit/graphDefinitionOrder/cost, 6)
    GRAPHDEFINITIONORDER(unit/graphDefinitionOrder/lateDeclaration, 7)
    GRAPHDEFINITIONORDER(unit/graphDefinitionOrder/ambiguousMeaning, 8)
    GRAPHDEFINITIONORDER(unit/graphDefinitionOrder/explicitOrder, 9)
    GRAPHDEFINITIONORDER(unit/graphDefinitionOrder/orderedType, 10)
    GRAPHDEFINITIONORDER(unit/graphDefinitionOrder/omittedContext, 11)
    GRAPHDEFINITIONORDER(unit/graphDefinitionOrder/headerRevision, 12)
    GRAPHDEFINITIONORDER(unit/graphDefinitionOrder/fieldAlternatives, 13)
    GRAPHDEFINITIONORDER(unit/graphDefinitionOrder/empty, 14)
    GRAPHDEFINITIONORDER(unit/graphDefinitionOrder/explicitComma, 15)

    me bool: graphDefinitionOrderCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer normalizer;normalizer.init();
        std::string declarations="{#record={X:*10+1, Y:*10+2}}",expression="record:{X:*10+1}";
        if(caseID==1 || caseID==12) {declarations="{#record={X:*10+1, Y:*10+2} #alias=record:{X:*10+1}}";expression="alias";}
        if(caseID==2) {declarations="{#record={X:*10+1, Y:*10+2} #alias=record #other=alias}";expression="other:{X:*10+1}";}
        if(caseID==4) expression="record:*1+{X:*10+1}";
        if(caseID==5) expression="record:*4+{X:*10+1}";
        if(caseID==7) declarations="{}";
        if(caseID==8) declarations="{#record={X, Y} #record={Z, W}}";
        if(caseID==10) declarations="{#record={X:*10+1 Y:*10+2}}";
        if(caseID==11) declarations="{#record={X:*10+1, Y=%ctx.missing}}";
        if(caseID==13) expression="record:{X:*10+1 X:*10+2}";
        if(caseID==14) expression="record:{}";
        if(caseID==15) {declarations="{#record={X:*10+1 Y:*10+2}}";expression="record:{X:*10+1, Y:*10+2}";}
        auto defs=graphParsed(testName,declarations);
        auto registered=normalizer.normalize(defs);registered.waitForCompletion();
        auto before=toString(defs->pItem.get());
        auto root=graphParsed(testName,expression);
        if(caseID==9) root->pItem->orderMode=uOrdered;
        auto original=toString(root->pItem.get());auto first=root->pItem->value->items.head;
        if(caseID==12) {
            auto meaning=normalizer.runtime.normalize({root,proteus4::compileTypeRequirements,0});meaning.waitForCompletion();
            normalizer.runtime.update([&] {defs->pItem->value->items.head->pItem->funcArgs->orderMode=uOrdered;});
            meaning.cancel();before=toString(defs->pItem.get());
        }
        if(caseID==13) {
            auto selected=normalizer.findField(root,graphParsed(testName,"X"));selected.waitForCompletion();
            auto result=selected.result();
            bool passed=result && result->pItem->isOrLike() && result->pItem->innr->value->items.size()==2 &&
                root->pItem->orderMode==uUnordered && root->pItem->value->items.head==first && before==toString(defs->pItem.get());
            if(!passed) std::cout << "Order selection: " << toString(root->pItem.get()) << " " << selected.status().error << "\n";
            selected.cancel();registered.cancel();normalizer.close();return passed;
        }
        normalizer.runtime.update([&] {normalizer.access->bind(root);});
        auto lazy=[&] {return normalizer.runtime.normalize({root,proteus4::sizeAndValue,proteus4::lazyParts});};
        auto handle=caseID==6 ? normalizer.normalizeWithCost(root,0) : lazy();
        handle.waitForCompletion();
        bool deferred=caseID==6 || caseID==8;
        bool unordered=caseID!=7 && caseID!=9 && caseID!=10 && caseID!=12 && !deferred;
        bool passed=!handle.status().failed;
        if(deferred) passed &= handle.status().symbolicValues && root->pItem->orderMode==uUnknown && toString(root->pItem.get())==original;
        else passed &= (root->pItem->orderMode==uUnordered)==unordered;
        if(caseID==14) passed &= root->pItem->value->items.isEmpty();
        else if(caseID!=15) passed &= root->pItem->value->items.size()==1 && root->pItem->value->items.head->pItem->value->num==1;
        if(first) passed &= root->pItem->value->items.head==first;
        if(unordered && caseID!=4 && caseID!=5) passed &= getModeBits(root->pItem->infSize->flags,infonState::evalMode)==infonState::emUnknown;
        if(caseID==4 || caseID==5) passed &= root->pItem->infSize->num==(caseID==4 ? 1 : 4) && root->pItem->value->sizeMode==fromGiven;
        if(caseID==4) passed &= !handle.status().symbolicValues && getFlagBit(root->pItem->flags,infonView::isNormed);
        if(caseID==7) {
            auto more=graphParsed(testName,"{#record={X:*10+1, Y:*10+2}}");
            auto publish=normalizer.normalize(more);publish.waitForCompletion();
            passed &= root->pItem->orderMode==uUnknown;
            handle=lazy();handle.waitForCompletion();
            passed &= root->pItem->orderMode==uUnordered && root->pItem->value->items.size()==1 &&
                getModeBits(root->pItem->infSize->flags,infonState::evalMode)==infonState::emUnknown;
            publish.cancel();
        }
        if(caseID==3) {
            auto count=normalizer.access->registry->identities.size();auto next=lazy();next.waitForCompletion();
            passed &= !next.status().failed && normalizer.access->registry->identities.size()==count;
            for(const auto& step:next.steps()) passed &= step.action!="Set list order from type header";
            next.cancel();
        }
        passed &= before==toString(defs->pItem.get());
        if(!passed) {
            std::cout << "Definition order " << caseID << ": " << toString(root->pItem.get()) << " order=" << root->pItem->orderMode <<
                " symbolic=" << handle.status().symbolicValues << " error=" << handle.status().error << "\n";
            for(const auto& step:handle.steps()) if(step.action!="visit") std::cout << step.action << "\n";
        }
        handle.cancel();registered.cancel();normalizer.close();return passed;
    }%>
    void: unitTestGraphDefinitionOrder(me string: testName, me int: caseID) <- {
        me bool: passed <- graphDefinitionOrderCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }

}

#define GRAPHNORMALIZEPARTS(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphNormalizeParts(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHNORMALIZEPARTS(unit/graphNormalizeParts/ordered, 0)
    GRAPHNORMALIZEPARTS(unit/graphNormalizeParts/unordered, 1)
    GRAPHNORMALIZEPARTS(unit/graphNormalizeParts/beforeAndAfter, 2)
    GRAPHNORMALIZEPARTS(unit/graphNormalizeParts/lazyLookup, 3)
    GRAPHNORMALIZEPARTS(unit/graphNormalizeParts/lazyNested, 4)
    GRAPHNORMALIZEPARTS(unit/graphNormalizeParts/explicitBound, 5)
    GRAPHNORMALIZEPARTS(unit/graphNormalizeParts/replay, 6)
    GRAPHNORMALIZEPARTS(unit/graphNormalizeParts/rhs, 7)
    GRAPHNORMALIZEPARTS(unit/graphNormalizeParts/selected, 8)
    GRAPHNORMALIZEPARTS(unit/graphNormalizeParts/conflict, 9)
    GRAPHNORMALIZEPARTS(unit/graphNormalizeParts/reverse, 10)
    GRAPHNORMALIZEPARTS(unit/graphNormalizeParts/empty, 11)
    GRAPHNORMALIZEPARTS(unit/graphNormalizeParts/normalizeChild, 12)
    GRAPHNORMALIZEPARTS(unit/graphNormalizeParts/lateDefinition, 13)

    me bool: graphNormalizePartsCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer normalizer;normalizer.init();
        std::string declarations="{#record={X:*10+1 Y:*10+2 Z:*10+3}}",expression="record:{Y:*10+2}";
        if(caseID==1 || caseID==7) declarations="{#record={X:*10+1, Y:*10+2, Z:*10+3}}";
        if(caseID==2) expression="record:{X:*10+1 Z:*10+3}";
        if(caseID==4 || caseID==12) {declarations="{#Child={A:*10+1 B:*10+2} #record={Child:{B:*10+2} Z:*10+3}}";expression="record:{Child:{B:*10+2}}";}
        if(caseID==5) expression="record:*1+{Y:*10+2}";
        if(caseID==7) expression="record=record:{Y:*10+2}";
        if(caseID==8) expression="{record:{Y:*10+2}}.record";
        if(caseID==9) expression="record:{Y:*10+8}";
        if(caseID==10) expression="record:{Z:*10+3 X:*10+1}";
        if(caseID==11) expression="record:{}";
        auto defs=graphParsed(testName,caseID==13 ? "{}" : declarations);auto registered=normalizer.normalize(defs);registered.waitForCompletion();
        auto saved=toString(defs->pItem.get());auto root=graphParsed(testName,expression);
        auto first=caseID==8 ? proteus4::POVNode{} : root->pItem->value->items.head;
        auto handle=caseID==3 ? normalizer.findField(root,graphParsed(testName,"Y")) : normalizer.normalize(root);
        handle.waitForCompletion();
        bool lateStable=true;
        if(caseID==13) {
            auto later=graphParsed(testName,declarations);auto publish=normalizer.normalize(later);publish.waitForCompletion();
            lateStable=root->pItem->value->items.size()==1;
            handle=normalizer.normalize(root);handle.waitForCompletion();publish.cancel();
        }
        bool rejected=caseID==5 || caseID==9 || caseID==10;
        bool passed=lateStable && handle.status().failed==rejected && saved==toString(defs->pItem.get());
        if(rejected || caseID==3) passed &= root->pItem->value->items.size()==(caseID==10 ? 2 : 1) && root->pItem->value->items.head==first;
        else {
            passed &= root->pItem->value->items.size()==((caseID==4 || caseID==12) ? 2 : 3);
            if(first) {
                bool kept=false;for(auto member=root->pItem->value->items.head;member;member=member->next) kept |= member==first;
                passed &= kept;
            }
            if(caseID==4 || caseID==12) passed &= root->pItem->value->items.head->pItem->value->items.size()==1;
            else {
                auto member=root->pItem->value->items.head;
                std::set<int> values;for(;member;member=member->next) values.insert(member->pItem->value->num.getNumerator().get_si());
                passed &= values==std::set<int>{1,2,3};
            }
        }
        if(caseID==12) {
            auto child=root->pItem->value->items.head;auto supplied=child->pItem->value->items.head;
            auto complete=normalizer.normalize(child);complete.waitForCompletion();
            passed &= !complete.status().failed && child->pItem->value->items.size()==2 &&
                child->pItem->value->items.tail==supplied && supplied->pItem->value->num==2;
            complete.cancel();
        }
        if(caseID==6) {
            auto text=toString(root->pItem.get());auto identities=normalizer.access->registry->identities.size();
            auto again=normalizer.normalize(root);again.waitForCompletion();
            passed &= !again.status().failed && text==toString(root->pItem.get()) && identities==normalizer.access->registry->identities.size();again.cancel();
        }
        if(!passed) std::cout << "Normalize parts " << caseID << ": " << toString(root->pItem.get()) << " error=" << handle.status().error << "\n";
        handle.cancel();registered.cancel();normalizer.close();return passed;
    }%>
    void: unitTestGraphNormalizeParts(me string: testName, me int: caseID) <- {
        me bool: passed <- graphNormalizePartsCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHDEFINITIONPREFIX(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphDefinitionPrefix(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHDEFINITIONPREFIX(unit/graphDefinitionPrefix/knownExtent, 0)
    GRAPHDEFINITIONPREFIX(unit/graphDefinitionPrefix/unknownExtent, 1)
    GRAPHDEFINITIONPREFIX(unit/graphDefinitionPrefix/withoutTemplate, 2)
    GRAPHDEFINITIONPREFIX(unit/graphDefinitionPrefix/conjunction, 3)
    GRAPHDEFINITIONPREFIX(unit/graphDefinitionPrefix/closedConjunction, 4)
    GRAPHDEFINITIONPREFIX(unit/graphDefinitionPrefix/conflictingPrefix, 5)
    GRAPHDEFINITIONPREFIX(unit/graphDefinitionPrefix/instanceBound, 6)
    GRAPHDEFINITIONPREFIX(unit/graphDefinitionPrefix/virtualTail, 7)
    GRAPHDEFINITIONPREFIX(unit/graphDefinitionPrefix/latePrefix, 8)
    GRAPHDEFINITIONPREFIX(unit/graphDefinitionPrefix/replay, 9)
    GRAPHDEFINITIONPREFIX(unit/graphDefinitionPrefix/closedInstance, 10)
    GRAPHDEFINITIONPREFIX(unit/graphDefinitionPrefix/cost, 11)
    GRAPHDEFINITIONPREFIX(unit/graphDefinitionPrefix/compileOnly, 12)
    GRAPHDEFINITIONPREFIX(unit/graphDefinitionPrefix/collectionRecord, 13)
    GRAPHDEFINITIONPREFIX(unit/graphDefinitionPrefix/nestedCollection, 14)
    GRAPHDEFINITIONPREFIX(unit/graphDefinitionPrefix/sparseCollection, 15)
    GRAPHDEFINITIONPREFIX(unit/graphDefinitionPrefix/partialSelf, 16)
    GRAPHDEFINITIONPREFIX(unit/graphDefinitionPrefix/explicitCollectionType, 17)

    me bool: graphDefinitionPrefixCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer normalizer;normalizer.init();
        std::string declarations="{#digit=*10+_ #series=*1000000000+{digit|1 2 ...}}",expression="series";
        if(caseID==1) declarations="{#digit=*10+_ #series={digit|1 2 ...}}";
        if(caseID==2) declarations="{#series=*1000000000+{*10+1 *10+2 ...}}";
        if(caseID==3) declarations="{#digit=*10+_ #base=*1000000000+{digit|1 ...} #series=base:*1000000000+{digit|1 2 ...}}";
        if(caseID==4) declarations="{#digit=*10+_ #base=*3+{digit|1 2 ...} #series=base:{1 2 3}}";
        if(caseID==5) declarations="{#digit=*10+_ #base=*1000000000+{digit|1 ...} #series=base:*1000000000+{digit|8 2 ...}}";
        if(caseID==6) {declarations="{#digit=*10+_ #series={digit|1 2 ...}}";expression="series:*1+{...}";}
        if(caseID==8) declarations="{#digit=*10+_ #series=*1000000000+{digit|...}}";
        if(caseID==10) {declarations="{#digit=*10+_ #series={digit|1 2 ...}}";expression="series:{1}";}
        if(caseID>=13) {declarations="{#tag=*10+7 #leaf={_} #branch={tag, *2+{leaf|{1}{2}}}}";expression="branch";}
        if(caseID==14) declarations="{#tag=*10+7 #leaf={_} #branch={tag, *2+{leaf|{1}{2}}} #grove={*2+{branch|branch:{tag:7,} branch:{tag:7,}}}}",expression="grove";
        if(caseID==15) declarations="{#tag=*10+7 #leaf={_} #branch={tag, *1000000000+{leaf|...}}}";
        if(caseID==16) declarations="{#tag=*10+7 #leaf={_} #branch=branch:{tag, *2+{leaf|{1}{2}}}}";
        if(caseID==17) declarations="{#tag=*10+7 #leaf={_} #branch={tag, inventory:*2+{leaf|{1}{2}}}}";
        auto defs=graphParsed(testName,declarations);auto declared=normalizer.normalize(defs);declared.waitForCompletion();
        auto saved=toString(defs->pItem.get());auto root=graphParsed(testName,expression);
        auto original=toString(root->pItem.get());
        auto handle=caseID==11 ? normalizer.normalizeWithCost(root,0) :
            caseID==12 ? normalizer.runtime.normalize({root,proteus4::compileTypeRequirements,0}) : normalizer.normalize(root);
        handle.waitForCompletion();
        bool passed=!declared.status().failed;
        if(caseID==5 || caseID==6 || caseID==10) passed &= handle.status().failed && root->pItem->value->items.size()==(caseID==10 ? 1 : 0);
        else if(caseID==11 || caseID==12) passed &= !handle.status().failed && toString(root->pItem.get())==original;
        else if(caseID>=13) {
            auto branch=caseID==14 ? root->pItem->value->items.head : root;
            if(caseID==14) {
                passed &= branch && branch->pItem->type && branch->pItem->type->typeID()=="branches" && branch->pItem->value->items.size()==2;
                branch=branch ? branch->pItem->value->items.head : proteus4::POVNode{};
            }
            auto collection=branch && branch->pItem->value->items.head ? branch->pItem->value->items.head->next : proteus4::POVNode{};
            passed &= !handle.status().failed && collection && collection->pItem->type &&
                collection->pItem->type->typeID()==(caseID==17 ? "inventory" : "leaves") &&
                collection->pItem->value->items.size()==(caseID==15 ? 0 : 2);
            if(caseID==15 && collection) passed &= collection->pItem->infSize->num==1000000000 && getFlagBit(collection->pItem->value->flags,infonState::tailUnfinished);
            if(caseID!=15 && collection && collection->pItem->value->items.head)
                passed &= collection->pItem->value->items.head->pItem->value->items.head->pItem->value->num==1;
        } else {
            if(caseID==8) {
                auto alias=graphParsed(testName,"?");alias->pItem=root->pItem;
                auto selected=normalizer.findItem(alias,0);selected.waitForCompletion();auto occurrence=selected.result();
                auto body=defs->pItem->value->items.tail->pItem->funcArgs;
                auto one=graphParsed(testName,"1"),two=graphParsed(testName,"2");
                normalizer.runtime.update([&] {body->value->items.appendPov(one);body->value->items.appendPov(two);});
                auto renewed=normalizer.normalize(root);renewed.waitForCompletion();
                passed &= !renewed.status().failed && root->pItem->value->items.head==occurrence;
                saved=toString(defs->pItem.get());renewed.cancel();selected.cancel();
            }
            passed &= !handle.status().failed && root->pItem->value->items.size()==(caseID==4 ? 3 : 2);
            auto first=root->pItem->value->items.head;
            passed &= first && first->next && first->pItem->value->num==1 && first->next->pItem->value->num==2 && first->pItem->infSize->num==10;
            if(caseID!=1) passed &= root->pItem->infSize->num==(caseID==4 ? 3 : 1000000000);
            if(caseID==7) {
                auto selected=normalizer.findItem(root,999999999);selected.waitForCompletion();auto occurrence=selected.result();
                passed &= occurrence && occurrence->implicitItem.sourceIndex==999999999 && root->pItem->value->items.size()==2;
                if(occurrence) {
                    auto normalized=normalizer.normalize(occurrence);normalized.waitForCompletion();
                    passed &= !normalized.status().failed && occurrence->pItem->infSize->num==10;
                    normalized.cancel();
                }
                auto again=normalizer.findItem(root,999999999);again.waitForCompletion();passed &= again.result()==occurrence;
                again.cancel();selected.cancel();
            }
            if(caseID==9) {
                auto before=toString(root->pItem.get());auto size=normalizer.access->registry->identities.size();
                auto again=normalizer.normalize(root);again.waitForCompletion();
                passed &= !again.status().failed && first==root->pItem->value->items.head && before==toString(root->pItem.get()) && size==normalizer.access->registry->identities.size();again.cancel();
            }
        }
        passed &= saved==toString(defs->pItem.get());
        if(!passed) std::cout << "Definition prefix " << caseID << ": " << toString(root->pItem.get()) << " error=" << handle.status().error << "\n";
        handle.cancel();declared.cancel();normalizer.close();return passed;
    }%>
    void: unitTestGraphDefinitionPrefix(me string: testName, me int: caseID) <- {
        me bool: passed <- graphDefinitionPrefixCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }

    GRAPHORDEREDUNITS(unit/graphOrderedUnits/billionUnitSkip, 16)
    GRAPHORDEREDUNITS(unit/graphOrderedUnits/sparseUnitDemand, 17)
    GRAPHORDEREDUNITS(unit/graphOrderedUnits/sparseUnitWrite, 18)
    GRAPHORDEREDUNITS(unit/graphOrderedUnits/sparseTemporalUnitDemand, 19)
    GRAPHORDEREDUNITS(unit/graphOrderedUnits/unitIntersectionAcrossGroups, 20)
    GRAPHORDEREDUNITS(unit/graphOrderedUnits/emptyUnitSlice, 21)
    GRAPHORDEREDUNITS(unit/graphOrderedUnits/compositeSparseUnknown, 22)
    GRAPHORDEREDUNITS(unit/graphOrderedUnits/compositeSparseNumericMismatch, 23)
    GRAPHORDEREDUNITS(unit/graphOrderedUnits/unitWriteUnknown, 24)
    GRAPHORDEREDUNITS(unit/graphOrderedUnits/temporalUnitWriteUnknown, 25)
    GRAPHORDEREDUNITS(unit/graphOrderedUnits/embeddedTemplateConflict, 26)
    GRAPHORDEREDUNITS(unit/graphOrderedUnits/unitSkipMismatch, 27)
    GRAPHORDEREDUNITS(unit/graphOrderedUnits/ordinaryUnits, 0)
    GRAPHORDEREDUNITS(unit/graphOrderedUnits/temporalStorageUnits, 1)
    GRAPHORDEREDUNITS(unit/graphOrderedUnits/temporalDefinitionUnits, 2)
    GRAPHORDEREDUNITS(unit/graphOrderedUnits/nestedUnits, 3)
    GRAPHORDEREDUNITS(unit/graphOrderedUnits/unitSlice, 4)
    GRAPHORDEREDUNITS(unit/graphOrderedUnits/endRelativeUnit, 5)
    GRAPHORDEREDUNITS(unit/graphOrderedUnits/unitIdentity, 6)
    GRAPHORDEREDUNITS(unit/graphOrderedUnits/unitCost, 7)
    GRAPHORDEREDUNITS(unit/graphOrderedUnits/unitCycle, 8)
    GRAPHORDEREDUNITS(unit/graphOrderedUnits/unrelatedNominal, 9)
    GRAPHORDEREDUNITS(unit/graphOrderedUnits/billionSparseRead, 10)
    GRAPHORDEREDUNITS(unit/graphOrderedUnits/sparseWritePublication, 11)
    GRAPHORDEREDUNITS(unit/graphOrderedUnits/sparseWriteReplay, 12)
    GRAPHORDEREDUNITS(unit/graphOrderedUnits/sparseConflictAtomic, 13)
    GRAPHORDEREDUNITS(unit/graphOrderedUnits/spanAcrossGaps, 14)
    GRAPHORDEREDUNITS(unit/graphOrderedUnits/definitionReadOnly, 15)

    me bool: graphOrderedUnitsCase(me string: testName, me int: caseID) <- <%{
        using namespace proteus4;
        GraphNormalizer normalizer;normalizer.init();
        std::string declarations="{#cell=_ #pair=*2+{cell|...} #block=*2+{pair|...}}";
        if(caseID==2) declarations="{#cell=_ #pair=*2+{T cell|...} #block=*2+{T pair|...}}";
        if(caseID==26) declarations="{#cell=*10+_ #pair=*2+{cell|...} #block=*2+{pair|...}}";
        if(caseID==8) declarations="{#cell=_ #pair=*2+{pair|...} #block=*2+{pair|...}}";
        auto defs=graphParsed(testName,declarations);auto declared=normalizer.normalize(defs);declared.waitForCompletion();
        auto before=toString(defs->pItem.get());
        std::string expression="block:{cell|1 2 3 4}@[2]";
        if(caseID==1) expression="block:{T cell|1 2 3 4}@[2]";
        if(caseID==3) expression="block:{pair|pair:{cell|1 2} pair:{cell|3 4}}.pair";
        if(caseID==4) expression="block:{cell|1 2 3 4}@[0:*2+{pair|...}]";
        if(caseID==5) expression="*(-1)+[<pair>] <~ block:{cell|1 2 3 4}";
        if(caseID==9) expression="{other:{1 2},}.pair";
        if(caseID==10) expression="[&*1000000000+{cell|...} <_>] <~ {cell|&*1000000000+{cell|...} 7}";
        if(caseID==14) expression="[&*8+{cell|...} <_>] <~ {cell|&*3+{cell|...} &*5+{cell|...} 7}";
        if(caseID==16) expression="[&*1000000000+{pair|...} <_>] <~ {cell|&*2000000000+{cell|...} 7}";
        if(caseID==20) expression="*(-3)+[<&*2+{pair|...}> *1+{pair|...}] <~ {pair|pair:{cell|1 2} pair:{cell|3 4} pair:{cell|5 6} pair:{cell|7 8}}";
        if(caseID==21) expression="block:{cell|1 2 3 4}@[0:*0+{pair|...}]";
        if(caseID==22 || caseID==23) expression=caseID==22 ? "[&*999999999+{pair|...} <?>] <~ *1000000000+{pair|...}" : "[&*999999999+{pair|...} <_>] <~ *1000000000+{pair|...}";
        if(caseID==26) expression="{cell|&*3+{*12+_|...}}";
        if(caseID==27) expression="[&*1000000000+{pair|...} 8 <_>] <~ {cell|&*2000000000+{cell|...} 9 1}";
        POVNode world;
        if(caseID==24 || caseID==25) {
            world=graphParsed(testName,caseID==24 ? "{block:{cell|_ _ _ _}}" : "{block:{T cell|_ _ _ _}}");
            normalizer.setWorld(world->pItem);auto w=normalizer.normalize(world);w.waitForCompletion();w.cancel();
            expression="%W.block@[2]=pair:{3 4}";
        }
        if(caseID>=17 && caseID<=19) {
            world=graphParsed(testName,caseID==19 ? "{run:{T cell|&*2000000000+{cell|...} 9}}" : "{run:{cell|&*2000000000+{cell|...} 9}}");
            normalizer.setWorld(world->pItem);auto w=normalizer.normalize(world);w.waitForCompletion();w.cancel();
            expression="[<&*1000000000+{pair|...}> _] <~ %W.run";
        }
        if(caseID==11 || caseID==12 || caseID==13) {
            world=graphParsed(testName,"{run:{cell|&*1000000000+{cell|...}}}");
            normalizer.setWorld(world->pItem);auto w=normalizer.normalize(world);w.waitForCompletion();w.cancel();
            expression="[&*999999999+{cell|...} <_>] <~ %W.run = 7";
            if(caseID==13) expression="[&*999999999+{cell|...} 8 <_>] <~ {cell|&*999999999+{cell|...} 9 1}";
        }
        auto root=graphParsed(testName,expression);
        auto handle=caseID==7 ? normalizer.normalizeWithCost(root,0) : normalizer.normalize(root);
        handle.waitForCompletion();bool passed=!declared.status().failed;
        auto actual=toString(root->pItem.get());
        if(caseID==7) passed &= !handle.status().failed && handle.status().symbolicValues && normalizer.access->registry->identities.empty();
        else if(caseID==8) passed &= !handle.status().failed && handle.status().symbolicValues;
        else if(caseID==9) passed &= !handle.status().failed && root->pItem->isOrLike() && root->pItem->innr->value->items.isEmpty();
        else if(caseID==10 || caseID==14 || caseID==16) passed &= !handle.status().failed && root->pItem->value->num==7 && handle.steps().size()<5000;
        else if(caseID==22) passed &= !handle.status().failed && normalizer.access->literalList(root) && normalizer.access->listExtent(root)==2 && handle.steps().size()<5000;
        else if(caseID==23 || caseID==27) passed &= !handle.status().failed && getModeBits(root->pItem->value->flags,infonState::overlayType)==infonState::NUM && getModeBits(root->pItem->value->flags,infonState::evalMode)==infonState::emUnknown;
        else if(caseID==24 || caseID==25) {
            auto source=world->pItem->value->items.head;auto updated=normalizer.normalize(source);updated.waitForCompletion();
            auto a=source->pItem->value->items.head;auto b=source->pItem->value->items.tail;
            passed &= !handle.status().failed && !updated.status().failed && normalizer.access->listExtent(source)==4 &&
                b && b->prev && b->pItem->value->num==4 && b->prev->pItem->value->num==3 &&
                getModeBits(a->pItem->value->flags,infonState::evalMode)==infonState::emUnknown;
            updated.cancel();
        }
        else if(caseID==26) passed &= handle.status().failed;
        else if(caseID>=17 && caseID<=19) {
            auto selected=normalizer.findItem(root,999999999);selected.waitForCompletion();
            auto pair=selected.result();passed &= pair && !selected.status().failed;
            if(pair) {
                auto value=normalizer.normalize(pair);value.waitForCompletion();
                auto last=normalizer.findItem(pair,1);last.waitForCompletion();auto cell=last.result();
                passed &= cell && !last.status().failed && normalizer.access->listExtent(pair)==2;
                if(cell && caseID==18) {
                    normalizer.addRHS(cell,graphParsed(testName,"7"));
                    auto written=normalizer.normalize(cell);written.waitForCompletion();
                    auto run=world->pItem->value->items.head;
                    passed &= !written.status().failed && run->pItem->value->items.size()==3 && run->pItem->value->items.tail->prev->pItem->value->num==7;
                    written.cancel();
                }
                last.cancel();value.cancel();
            }
            passed &= handle.steps().size()<5000 && world->pItem->value->items.head->pItem->value->items.size()<=3;
            selected.cancel();
        }
        else if(caseID==20) passed &= !handle.status().failed && actual=="pairs:{pair:{3 4} pair:{5 6}}";
        else if(caseID==21) passed &= !handle.status().failed && actual=="{}";
        else if(caseID==13) passed &= !handle.status().failed && getModeBits(root->pItem->value->flags,infonState::evalMode)==infonState::emUnknown;
        else if(caseID==11 || caseID==12) {
            auto run=world->pItem->value->items.head;
            passed &= !handle.status().failed && run->pItem->value->items.size()==2 && run->pItem->value->items.tail->pItem->value->num==7;
            if(caseID==12) {
                auto tail=run->pItem->value->items.tail;auto identities=normalizer.access->registry->identities.size();
                auto again=normalizer.normalize(root);again.waitForCompletion();
                passed &= !again.status().failed && tail==run->pItem->value->items.tail && identities==normalizer.access->registry->identities.size();again.cancel();
            }
        } else if(caseID==4) passed &= !handle.status().failed && actual=="{pair:{1 2} pair:{3 4}}";
        else passed &= !handle.status().failed && actual==(caseID==3 ? "pair:{1 2}" : caseID==2 ? "pair:{T 3 4}" : "pair:{3 4}");
        if(caseID==6 && !handle.status().failed) {
            auto state=root->pItem->pathSelection;auto result=state ? state->result : POVNode{};
            auto source=state ? state->source : POVNode{};
            auto leaf=result ? result->pItem->value->items.head : POVNode{};
            auto third=source && source->pItem->value->items.head ? source->pItem->value->items.head->next->next : POVNode{};
            passed &= leaf && third && normalizer.access->registry->areIdentical(leaf,third);
        }
        passed &= before==toString(defs->pItem.get());
        if(!passed) {std::cout<<"Ordered unit "<<caseID<<": "<<actual<<" error="<<handle.status().error<<"\n";for(const auto& step:handle.steps()) std::cout<<step.action<<"\n";}
        handle.cancel();declared.cancel();normalizer.close();return passed;
    }%>
    void: unitTestGraphOrderedUnits(me string: testName, me int: caseID) <- {
        me bool: passed <- graphOrderedUnitsCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }

}

#define GRAPHSIGNED(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphSignedNumber(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHSIGNED(unit/graphSignedNumber/parser, 0)
    GRAPHSIGNED(unit/graphSignedNumber/replayAndCopy, 1)
    GRAPHSIGNED(unit/graphSignedNumber/lateSize, 2)
    GRAPHSIGNED(unit/graphSignedNumber/sizeModes, 3)
    GRAPHSIGNED(unit/graphSignedNumber/definitionReadOnly, 4)
    me bool: graphSignedNumberCase(me string: testName, me int: caseID) <- <%{
        bool passed=true;
        if(caseID==0) {
            for(const std::string text:{"-1.1","-11/10","*10-1","/64-34","+2"}) {
                auto root=graphParsed(testName,text);auto value=root->pItem->value;
                mpq_class expected(text=="*10-1" ? "-1" : text=="/64-34" ? "-34" : text=="+2" ? "2" : "-11/10");
                passed &= value->num.val==expected && !getFlagBit(value->flags,infonState::inverted);
                passed &= getFlagBit(root->pItem->infSize->flags,infonState::inverted)==(text=="/64-34");
                auto again=graphParsed(testName,toString(root->pItem.get()));
                passed &= again->pItem->value->num.val==expected && again->pItem->value->sizeMode==value->sizeMode;
            }
            return passed;
        }
        GraphNormalizer normalizer;normalizer.init();
        if(caseID==1 || caseID==3) {
            std::vector<std::tuple<std::string,std::string,int>> cases=caseID==1 ?
                std::vector<std::tuple<std::string,std::string,int>>{{"*10-1","9",10},{"*10-11","-1",10},{"*0-1","-1",0},{"*10+11","11",10},{"*10-1/2","19/2",10}} :
                std::vector<std::tuple<std::string,std::string,int>>{{"(*10+9 +2)","11",10},{"(*10+1 -2)","-1",10},{"(*10+1 *10+2)","12",100}};
            for(const auto& [text,expected,size]:cases) {
                auto root=graphParsed(testName,text);auto handle=normalizer.normalize(root);handle.waitForCompletion();
                bool ok=!handle.status().failed && root->pItem->value->num.val==mpq_class(expected) && root->pItem->infSize->num==size;
                auto revision=root->workRevision;
                auto replay=normalizer.normalize(root);replay.waitForCompletion();
                ok &= !replay.status().failed && root->pItem->value->num.val==mpq_class(expected) && root->workRevision==revision;
                if(caseID==1) {
                    auto copy=graphParsed(testName,"_");normalizer.addRHS(copy,root);
                    auto copied=normalizer.normalize(copy);copied.waitForCompletion();
                    ok &= !copied.status().failed && copy->pItem->value->num.val==mpq_class(expected) && copy->pItem->infSize->num==size;
                    copied.cancel();
                }
                if(!ok) std::cout << "Signed numeric " << text << " -> " << toString(root->pItem.get()) << " error=" << handle.status().error << " replay=" << replay.status().error << "\n";
                passed &= ok;handle.cancel();replay.cancel();
            }
        } else if(caseID==2) {
            auto root=graphParsed(testName,"-1");auto handle=normalizer.normalize(root);handle.waitForCompletion();
            passed &= !handle.status().failed && handle.status().symbolicValues && root->pItem->value->num==-1;
            normalizer.addRHS(root,graphParsed(testName,"*10+_"));handle.waitForCompletion();
            passed &= !handle.status().failed && root->pItem->value->num==9 && root->pItem->infSize->num==10;
            auto contradiction=graphParsed(testName,"*10+8");normalizer.addRHS(root,contradiction);
            // Completed handles are reconsidered by an explicit normalization.
            handle=normalizer.normalize(root);handle.waitForCompletion();
            passed &= handle.status().failed && root->pItem->value->num==9 && contradiction->pItem->value->num==8;
            if(!passed) std::cout << "Late signed size: " << toString(root->pItem.get()) << " error=" << handle.status().error << "\n";
            handle.cancel();
        } else if(caseID==4) {
            auto root=graphParsed(testName,"{#pose={xRot:0 xLoc:-1.1} pose.xLoc}");
            auto definition=root->pItem->value->items.head->pItem;
            auto before=toString(definition.get());auto handle=normalizer.normalize(root);handle.waitForCompletion();
            passed &= !handle.status().failed && root->pItem->value->items.tail->pItem->value->num.val==mpq_class("-11/10") && toString(definition.get())==before;
            if(!passed) std::cout << "Signed definition: " << toString(root->pItem.get()) << " error=" << handle.status().error << "\n";
            handle.cancel();
        }
        normalizer.close();return passed;
    }%>
    void: unitTestGraphSignedNumber(me string: testName, me int: caseID) <- {
        me bool: passed <- graphSignedNumberCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}


#define GRAPHCONTEXTUAL(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestContextualDefinition(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHCONTEXTUAL(unit/graphContextual/writtenStructure, 1)
    GRAPHCONTEXTUAL(unit/graphContextual/selfValue, 2)
    GRAPHCONTEXTUAL(unit/graphContextual/independentInstances, 3)
    GRAPHCONTEXTUAL(unit/graphContextual/lateValue, 4)
    GRAPHCONTEXTUAL(unit/graphContextual/sparseSibling, 5)
    GRAPHCONTEXTUAL(unit/graphContextual/knownField, 6)
    GRAPHCONTEXTUAL(unit/graphContextual/partialInstance, 7)
    GRAPHCONTEXTUAL(unit/graphContextual/nestedScope, 8)
    GRAPHCONTEXTUAL(unit/graphContextual/recursiveMeaning, 9)
    GRAPHCONTEXTUAL(unit/graphContextual/predicateStaysPending, 11)
    GRAPHCONTEXTUAL(unit/graphContextual/nominalDisplayField, 12)
    GRAPHCONTEXTUAL(unit/graphContextual/inheritedContextualParts, 13)
    GRAPHCONTEXTUAL(unit/graphContextual/unorderedWrittenParts, 15)
    GRAPHCONTEXTUAL(unit/graphContextual/lateInheritedParts, 14)
    me bool: contextualDefinitionCase(me string: testName, me int: caseID) <- <%{
        using namespace proteus4;
        GraphNormalizer n;n.init();
        auto parse=[&](const std::string& text){return graphParsed(testName,text);};
        auto norm=[&](const POVNode& p){auto h=n.normalize(p);h.waitForCompletion();return h;};
        if(caseID==13 || caseID==14 || caseID==15) {
            const std::string separator=caseID==15 ? ", " : " ";
            const std::string layout="#layout={*1+{center|center:{shade}}"+separator+"*1+{edge|edge:{thing, *2+{side|{shade}{shade}}}}}";
            auto declarations=parse("{#color={hue:_} #shade=color:{hue:30} #side={color} #thing={location} "
                "#center={thing, color, *2+{side|{%.color}{shade}}} #edge={thing, *2+{side|...}} "
                "#placed=layout:{*1+{center|center:{thing:{location:1},}}"+separator+"*1+{edge|edge:{thing:{location:2},}}} " +
                (caseID!=14 ? layout : "") + "}");
            norm(declarations);auto unchanged=toString(declarations->pItem.get());
            auto target=parse("placed");auto handle=norm(target);bool ok=!handle.status().failed;
            if(caseID==15) ok &= target->pItem->orderMode==uUnordered && handle.status().symbolicValues &&
                getModeBits(target->pItem->infSize->flags,infonState::evalMode)==infonState::emUnknown;
            if(caseID==14) {norm(parse("{"+layout+"}"));handle=norm(target);ok &= !handle.status().failed;}
            auto groups=target->pItem->value->items.head;
            auto edge=groups && groups->next ? groups->next->pItem->value->items.head : POVNode{};
            if(edge) norm(edge);
            auto sides=edge ? n.runtime.read([&] {return n.knownField(edge,"sides");}) : POVNode{};
            if(sides) norm(sides);
            auto side=sides ? sides->pItem->value->items.head : POVNode{};
            if(side) norm(side);
            auto color=side ? n.runtime.read([&] {return n.knownField(side,"color");}) : POVNode{};
            if(color) norm(color);
            auto hue=color ? color->pItem->fetchField("hue") : POVNode{};
            auto facts=hue ? n.access->typeFacts(hue) : GraphTypeFacts{};
            ok &= facts.valid && facts.hasValue && facts.number==30;
            // Path lowering can move an installed RHS into a choice predicate.
            // Replay must retain it, not append the same contextual expression.
            auto retainedWork=[&] {
                std::vector<std::shared_ptr<infonView>> pending{target->pItem};
                std::set<std::shared_ptr<infonView>> seen;std::size_t count=0;
                while(!pending.empty()) {
                    auto value=pending.back();pending.pop_back();if(!value || !seen.insert(value).second) continue;
                    count+=value->wrkList.size();
                    for(const auto& rhs:value->wrkList) pending.push_back(rhs->pItem);
                    for(auto member=value->value->items.head;member;member=member->next) pending.push_back(member->pItem);
                    if(auto path=value->pathSelection) {
                        pending.push_back(path->expression);
                        if(path->predicate) pending.push_back(path->predicate->pItem);
                    }
                }
                return count;
            };
            handle.cancel();norm(target); // Finish requested child updates before measuring replay.
            auto count=retainedWork();auto before=toString(target->pItem.get());norm(target);
            ok &= count==retainedWork() && before==toString(target->pItem.get()) && unchanged==toString(declarations->pItem.get());
            if(!ok) std::cout<<"Contextual demand "<<caseID<<": "<<handle.status().error<<"\n"<<toString(target->pItem.get())<<"\n";
            n.close();return ok;
        }
        auto defs=parse(caseID==12 ? "{#shade=color:{hue:30} #sample={shade}}" : caseID==8 ? "{#inner={x:*10+1 y=%.x} #child=inner #sample={x:*10+2 child}}" :
                        caseID==9 ? "{#sample={x:*10+1 next=sample y=%.x}}" : caseID==5 ? "{#sample={x:*10+1 values:*1000000000+{_ | ...} y=%.x}}" :
                        caseID==3 || caseID==4 ? "{#sample={x:*10+_ y=%.x}}" : "{#sample={x:*10+1 y=%.x}}");
        norm(defs);auto original=toString(defs->pItem.get());
        auto a=parse(caseID==6 ? "sample.x" : caseID==7 ? "sample:{x:1}" : "sample");
        auto h=norm(a);bool ok=!h.status().failed;
        auto x=a->pItem->fetchField("x"),y=a->pItem->fetchField("y");
        auto hasNumber=[&](const POVNode& p,int value) {
            if(!p) return false;
            auto facts=n.access->typeFacts(p);
            return facts.valid && facts.hasValue && facts.number==value;
        };
        if(caseID==12) {
            auto field=n.runtime.read([&] {return n.knownField(a,"color");});
            ok &= field && hasNumber(field->pItem->fetchField("hue"),30);
            ok &= n.runtime.read([&] {return n.knownType(field,"color") && !n.knownType(field,"unrelated");});
        } else if(caseID==11) {
            Work work;ProteusDefinitions meanings(n.access);
            meanings.publish(defs->pItem->value->items.head);
            auto meaning=meanings.describe(meanings.lookup("sample"),work);
            ok &= !meaning;
        } else if(caseID==6) ok &= hasNumber(a,1);
        else if(caseID==8) {
            auto child=a->pItem->fetchField("child");
            if(child) norm(child);
            ok &= child && hasNumber(child->pItem->fetchField("y"),1) && hasNumber(x,2);
        } else {
            ok &= bool(x) && bool(y);
            if(caseID==1) ok &= a->pItem->value->items.size()==2;
            if(caseID==2 || caseID==5 || caseID==7 || caseID==9) ok &= hasNumber(y,1);
            if(caseID==9) {
                auto next=a->pItem->fetchField("next");
                ok &= next && next->pItem->value->items.size()==0;
            }
            if(caseID==3 || caseID==4) {
                ok &= h.status().withSubscribers && !getFlagBit(a->pItem->flags,infonView::isNormed) && !hasNumber(y,1);
                auto b=parse("sample");norm(b);auto bx=b->pItem->fetchField("x"),by=b->pItem->fetchField("y");
                if(!x || !bx) {n.close();return false;}
                n.addRHS(x,parse("*10+1"));n.addRHS(bx,parse("*10+2"));
                h.waitForCompletion();norm(b);norm(a);
                ok &= hasNumber(y,1) && hasNumber(by,2) && x->pItem!=bx->pItem && y->pItem!=by->pItem;
            }
            if(caseID==5) {
                auto values=a->pItem->fetchField("values");
                ok &= values && values->pItem->value->items.size()==0 && !values->repetitionSpan.family;
            }
            auto oldValue=a->pItem->value;auto oldX=x;auto before=toString(a->pItem.get());
            auto workCount=y ? y->pItem->wrkList.size() : 0;
            norm(a);ok &= a->pItem->value==oldValue && a->pItem->fetchField("x")==oldX && before==toString(a->pItem.get());
            ok &= !y || (y->pItem->wrkList.size()==workCount && workCount<=1);
        }
        ok &= original==toString(defs->pItem.get());
        if(!ok) {
            std::cout<<"Contextual case "<<caseID<<": "<<h.status().error<<"\n"<<toString(a->pItem.get())<<"\n";
            for(const auto& step:h.steps()) if(step.action.find("Set")!=std::string::npos || step.action.find("Expose")!=std::string::npos) std::cout<<step.action<<"\n";
        }
        n.close();return ok;
    }%>
    void: unitTestContextualDefinition(me string: testName, me int: caseID) <- {
        me bool: passed <- contextualDefinitionCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHPUBLICATION(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphPublication(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHPUBLICATION(unit/graphPublication/querySubmission, 1)
    GRAPHPUBLICATION(unit/graphPublication/completionPreserved, 2)
    GRAPHPUBLICATION(unit/graphPublication/unchangedEnvironment, 3)
    GRAPHPUBLICATION(unit/graphPublication/namedOccurrence, 4)
    GRAPHPUBLICATION(unit/graphPublication/proofScaling, 5)
    GRAPHPUBLICATION(unit/graphPublication/catalogueIsolation, 6)
    GRAPHPUBLICATION(unit/graphPublication/lateCatalogue, 7)
    GRAPHPUBLICATION(unit/graphPublication/retiredCompletion, 8)
    GRAPHPUBLICATION(unit/graphPublication/aliasCatalogue, 9)
    GRAPHPUBLICATION(unit/graphPublication/pathIsolation, 10)
    GRAPHPUBLICATION(unit/graphPublication/pathIsolationEight, 11)
    GRAPHPUBLICATION(unit/graphPublication/pathIsolationThirtyTwo, 12)
    GRAPHPUBLICATION(unit/graphPublication/pathChoiceIsolation, 13)
    GRAPHPUBLICATION(unit/graphPublication/sharedChoiceState, 14)
    me bool: graphPublicationCase(me int: caseID) <- <%{
        GraphNormalizer n;n.init();
        if(caseID==14) {
            using namespace proteus4;
            auto root=graphParsed("shared choice state","*3+{wheel:*10+7, wheel:*10+3, wheel:*10+1}");
            auto predicate=graphParsed("shared choice predicate","wheel");
            auto first=root->pItem->value->items.head,second=first->next,third=second->next;
            auto definitions=std::make_shared<ProteusDefinitions>(n.access);
            ProteusPathGoal goal({root,selectField,0,predicate},n.access,definitions);
            bool ok=true;
            n.runtime.update([&] {
                auto publish=[&](bool includeThird) {
                    goal.beginPass();
                    for(const auto& item:std::vector<POVNode>{first,second})
                        ok &= goal.found({{item,pathMatched,0,{}, {root}}, {},0}).empty();
                    if(includeThird) goal.found({{third,pathMatched,0,{}, {root}}, {},0});
                    auto commands=goal.found({{root,pathEnd,0,{}, {root}}, {},0});
                    if(commands.size()!=1) {ok=false;return SetResult{false};}
                    return commands.front().apply();
                };
                auto initial=publish(false);ok &= initial.changed && initial.changes && !initial.changes->all;
                // A separate view shares the mutable state, not its inner-view
                // address. Rebuilding that state must retain the broad fallback.
                auto alias=std::make_shared<infonView>(*goal.result()->pItem->innr);
                auto changed=publish(true);
                ok &= changed.changed && changed.changes && changed.changes->all && alias->value->items.size()==3;
            });
            n.close();return ok;
        }
        if(caseID>=10) {
            const int count=caseID==10 ? 1 : caseID==11 ? 8 : 32;
            std::vector<proteus4::POVNode> waiting;
            std::vector<Proteus4Handle> handles;
            std::vector<std::size_t> steps;
            bool ok=true;
            for(int i=0;i<count;++i) {
                waiting.push_back(graphScalar(-1,10));
                handles.push_back(n.normalize(waiting.back()));handles.back().waitForCompletion();
                steps.push_back(handles.back().steps().size());
                ok &= handles.back().status().withSubscribers;
            }
            auto done=graphScalar(3,10);
            {auto h=n.normalize(done);h.waitForCompletion();ok &= !h.status().symbolicValues;}
            for(int i=0;i<8;++i) {
                auto path=graphParsed("path publication",caseID==13 ? "*2+{wheel:*10+7, wheel:*10+3}.wheel" : "*1+{wheel:*10+7}.wheel");
                auto h=n.normalize(path);h.waitForCompletion();
                ok &= !h.status().failed;
                if(caseID==13) ok &= path->pItem->isOrLike() && path->pItem->innr->value->items.size()==2;
                else ok &= !h.status().symbolicValues && path->pItem->value->num==7;
                ok &= getFlagBit(done->pItem->flags,infonView::isNormed);
                for(int j=0;j<count;++j) {
                    handles[j].waitForCompletion();
                    ok &= handles[j].status().withSubscribers && handles[j].steps().size()==steps[j];
                }
            }
            // A real incoming constraint still activates its subscriber.
            n.addRHS(waiting.front(),graphScalar(4,10));handles.front().waitForCompletion();
            ok &= !handles.front().status().failed && !handles.front().status().symbolicValues &&
                waiting.front()->pItem->value->num==4;
            if(!ok) std::cout<<"Path isolation failed with "<<count<<" unrelated subscribers\n";
            n.close();return ok;
        }
        if(caseID>=6) {
            auto parse=[](const std::string& text) {return graphParsed("catalogue publication",text);};
            auto norm=[&](const auto& node) {auto h=n.normalize(node);h.waitForCompletion();return h;};
            std::vector<proteus4::POVNode> declarations;
            auto declare=[&](const std::string& text) {
                auto source=parse("{"+text+"}");declarations.push_back(source);
                // Normalize the declaration itself, excluding independent list
                // size writes from this catalogue-publication measurement.
                return norm(source->pItem->value->items.head);
            };
            auto normed=[](const auto& node) {return getFlagBit(node->pItem->flags,infonView::isNormed);};
            bool ok=true;
            if(caseID<=7) {
                auto target=parse("wheel:*10+_");auto h=norm(target);
                auto before=h.steps().size();ok &= h.status().withSubscribers;
                for(int i=0;i<32;++i) {
                    auto definition=declare("#other"+std::to_string(i)+"=*10+7");
                    h.waitForCompletion();ok &= !definition.status().failed && h.steps().size()==before;
                }
                if(caseID==7) {
                    auto definition=declare("#wheel=*10+7");h.waitForCompletion();
                    ok &= !definition.status().failed && !h.status().failed && !h.status().symbolicValues &&
                        target->pItem->value->num==7 && normed(target);
                }
            } else {
                if(caseID==9) ok &= !declare("#vehicle=wheel").status().failed;
                auto root=parse(caseID==9 ? "*1+{vehicle:*10+7}" : "*1+{wheel:*10+7}");
                auto unrelated=parse("*10+3");
                {auto h=norm(root);ok &= !h.status().failed && !h.status().symbolicValues;}
                {auto h=norm(unrelated);ok &= !h.status().failed;}
                auto member=root->pItem->value->items.head;
                ok &= normed(root) && normed(member) && normed(unrelated);
                ok &= !declare("#pedal=*10+2").status().failed;
                ok &= normed(root) && normed(member) && normed(unrelated);
                // The handles are gone; both the child and containing list's
                // completion evidence must still respond to a relevant name.
                ok &= !declare("#wheel=*10+8").status().failed;
                ok &= !normed(root) && !normed(member) && normed(unrelated);
                auto reconsidered=norm(root);ok &= reconsidered.status().failed;
            }
            if(!ok) std::cout<<"Catalogue publication case "<<caseID<<" failed\n";
            n.close();return ok;
        }
        if(caseID==5) {
            auto defs=graphParsed("proof scaling","{#seven=*10+7}");
            auto defined=n.normalize(defs);defined.waitForCompletion();
            bool ok=!defined.status().failed;
            // Recording each already-satisfied member's type proof must not
            // replay the list or earlier members. Count work, not wall time.
            for(int count:{16,64,128}) {
                std::string text="*"+std::to_string(count)+"+{";
                for(int i=0;i<count;++i) text+="seven:*10+7 ";
                auto target=graphParsed("proof scaling",text+"}");
                auto h=n.normalize(target);h.waitForCompletion();
                int passes=0,proofs=0,members=0;auto steps=h.steps();
                for(const auto& step:steps) {
                    passes+=step.action=="search";
                    proofs+=step.action=="Apply scalar type requirements";
                }
                for(auto item=target->pItem->value->items.front();item;item=item->next) {
                    ++members;
                    ok &= item->pItem->value->num==7 && item->pItem->infSize->num==10 &&
                        getFlagBit(item->pItem->flags,infonView::isNormed);
                }
                ok &= !h.status().failed && !h.status().symbolicValues &&
                    getFlagBit(target->pItem->flags,infonView::isNormed) &&
                    members==count && proofs==count && passes==1 && steps.size()<=20*count+20;
                if(!ok) std::cout<<"Proof scaling: "<<count<<" members, "<<steps.size()<<" steps, "
                    <<passes<<" root passes, "<<proofs<<" proofs: "<<h.status().error<<"\n";
            }
            n.close();return ok;
        }
        auto root=graphScalar(caseID==2 ? 7 : -1,caseID==2 ? 10 : -1);
        auto other=graphScalar(-1,-1);
        if(caseID==4) root->pItem->identityName=n.access->registry->occurrenceScope.allocate();
        auto h=n.normalize(root);h.waitForCompletion();
        auto before=h.steps().size();auto revision=n.runtime.revision();bool ok=!h.status().failed;
        if(caseID<=2) {
            auto unrelated=n.normalize(other);unrelated.waitForCompletion();h.waitForCompletion();
            ok &= n.runtime.revision()==revision && h.steps().size()==before && !unrelated.status().failed;
            if(caseID==2) ok &= getFlagBit(root->pItem->flags,infonView::isNormed);
            else ok &= h.status().withSubscribers;
        } else if(caseID==3) {
            n.setContext(root);n.setWorld(other->pItem);h.waitForCompletion();
            revision=n.runtime.revision();before=h.steps().size();
            n.setContext(root);n.setWorld(other->pItem);h.waitForCompletion();
            ok &= n.runtime.revision()==revision && h.steps().size()==before;
            n.setContext(other);h.waitForCompletion();ok &= n.runtime.revision()>revision;
        } else {
            // Binding a newly named occurrence really does add an identity.
            // Idempotent query submission must not suppress that publication.
            other=graphScalar(7,10);other->pItem->identityName=root->pItem->identityName;
            auto alias=n.normalize(other);alias.waitForCompletion();h.waitForCompletion();
            ok &= n.runtime.revision()>revision && !h.status().symbolicValues && !h.status().failed && root->pItem->value->num==7;
            revision=n.runtime.revision();
            auto again=n.normalize(other);again.waitForCompletion();
            ok &= !again.status().failed && n.runtime.revision()==revision;
        }
        if(!ok) std::cout<<"Publication case "<<caseID<<": "<<h.status().error<<" revision "<<revision<<" -> "<<n.runtime.revision()<<"\n";
        n.close();return ok;
    }%>
    void: unitTestGraphPublication(me string: testName, me int: caseID) <- {
        me bool: passed <- graphPublicationCase(caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}



// A reused type check must keep its readers subscribed to the data it checked.
#define GRAPHINSTANCECHECKS(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphInstanceChecks(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHINSTANCECHECKS(unit/graphInstanceChecks/unrelatedWrites, 1)
    GRAPHINSTANCECHECKS(unit/graphInstanceChecks/sharedDescendantValue, 2)
    GRAPHINSTANCECHECKS(unit/graphInstanceChecks/sharedSize, 3)
    GRAPHINSTANCECHECKS(unit/graphInstanceChecks/listLink, 4)
    GRAPHINSTANCECHECKS(unit/graphInstanceChecks/broadReset, 5)
    GRAPHINSTANCECHECKS(unit/graphInstanceChecks/pendingCheck, 6)
    GRAPHINSTANCECHECKS(unit/graphInstanceChecks/untrackedReads, 7)
    GRAPHINSTANCECHECKS(unit/graphInstanceChecks/explicitRenormalization, 8)
    me bool: graphInstanceChecksCase(me string: testName, me int: caseID) <- <%{
        using namespace proteus4;
        GraphNormalizer n;n.init();
        auto parse=[&](const std::string& text){return graphParsed(testName,text);};
        if(caseID==8) {
            auto declarations=parse("{#pair={*10+1 *10+2}}");
            auto h=n.normalize(declarations);h.waitForCompletion();
            auto target=parse("pair");h=n.normalize(target);h.waitForCompletion();
            bool ok=!h.status().failed && !h.status().symbolicValues;
            // A caller can edit a quiescent model and then explicitly ask for
            // normalization. Old cached acceptance must not hide that edit.
            target->pItem->value->items.tail->pItem->value->num=static_cast<std::int64_t>(3);
            h=n.normalize(target);h.waitForCompletion();ok &= h.status().failed;
            n.close();return ok;
        }
        ProteusDefinitions definitions(n.access);
        auto target=parse("*2+{*10+1 *10+2}");n.access->setDefinitionOrder(target);
        auto proof=std::make_shared<ProteusDefinitions::Proof>();
        proof->requirement=std::make_shared<DefinitionRequirement>();
        auto requirement=proof->requirement;
        requirement->list=true;requirement->facts=n.access->typeFacts(target);
        for(auto member=target->pItem->value->items.head;member;member=member->next) {
            auto part=std::make_shared<DefinitionRequirement>();part->facts=n.access->typeFacts(member);
            requirement->members.push_back(part);
        }
        auto first=target->pItem->value->items.head;
        bool ok=true;
        if(caseID==7) {
            // No object registry means no complete read footprint. Such a
            // check must retain the previous publication-scoped lifetime.
            ok &= definitions.accepts(proof,target);
            first->pItem->value->num=static_cast<std::int64_t>(3);
            definitions.prune(true);
            ok &= !definitions.accepts(proof,target);
            n.close();return ok;
        }
        ObjectDependencies objects;ReadScope tracked({},&objects);
        if(caseID==6) {
            target=graphScalar(-1,10);requirement->list=false;requirement->members.clear();
            requirement->facts=n.access->typeFacts(graphScalar(7,10));
            ok &= !definitions.accepts(proof,target);
            n.access->applyTypeFacts(target,requirement->facts);
            auto changes=ReadScope::changedObjects({target->pItem->value.get()});
            definitions.prune(true);for(const auto& key:changes.keys) key->publish();
            ok &= definitions.accepts(proof,target);
        } else {
            auto checked=[&] {
                std::set<DependencyKey> reads;
                {ReadScope capture([&](const DependencyKey& key){reads.insert(key);});ok &= definitions.accepts(proof,target);}
                return reads;
            };
            auto initial=checked();
            auto cached=checked();
            // Both fresh and cached readers receive the same proof. A hit
            // cannot hide the member reads from a later consumer.
            ok &= initial.size()==1 && initial==cached;
            auto consumer=DependencyProof::make(cached);
            if(caseID==1) {
                auto unrelated=graphScalar(7,10);
                for(int i=0;i<32;++i) {
                    auto changes=ReadScope::changedObjects({unrelated.get(),unrelated->pItem.get(),unrelated->pItem->value.get()});
                    definitions.prune(true);for(const auto& key:changes.keys) key->publish();
                    ok &= consumer->valid() && checked()==initial;
                }
            } else if(caseID==5) {
                first->pItem->value->num=static_cast<std::int64_t>(3);
                definitions.prune();ok &= !definitions.accepts(proof,target);
            } else {
                Changes changes;
                if(caseID==2) {
                    auto alias=graphScalar(1,10);alias->pItem->value=first->pItem->value;
                    alias->pItem->value->num=static_cast<std::int64_t>(3);
                    changes=ReadScope::changedObjects({alias->pItem->value.get()});
                } else if(caseID==3) {
                    auto alias=graphScalar(1,10);alias->pItem->infSize=first->pItem->infSize;
                    alias->pItem->infSize->num=static_cast<std::int64_t>(11);
                    changes=ReadScope::changedObjects({alias->pItem->infSize.get()});
                } else {
                    auto tail=target->pItem->value->items.tail;
                    n.access->appendDefinitionMember(target,"");
                    changes=ReadScope::changedObjects({POVDescription::positionKey(tail)});
                }
                definitions.prune(true);for(const auto& key:changes.keys) key->publish();
                ok &= !consumer->valid() && !definitions.accepts(proof,target);
            }
        }
        if(!ok) std::cout<<"Instance check case "<<caseID<<" failed\n";
        n.close();return ok;
    }%>
    void: unitTestGraphInstanceChecks(me string: testName, me int: caseID) <- {
        me bool: passed <- graphInstanceChecksCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

// Definition writes wake readers of their destinations, including shared state
// and list links, without replaying independent normalization requests.
#define GRAPHDEFINITIONPUBLICATION(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphDefinitionPublication(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHDEFINITIONPUBLICATION(unit/graphDefinitionPublication/isolatedSubscriber, 1)
    GRAPHDEFINITIONPUBLICATION(unit/graphDefinitionPublication/eightSubscribers, 2)
    GRAPHDEFINITIONPUBLICATION(unit/graphDefinitionPublication/thirtyTwoSubscribers, 3)
    GRAPHDEFINITIONPUBLICATION(unit/graphDefinitionPublication/sharedValue, 4)
    GRAPHDEFINITIONPUBLICATION(unit/graphDefinitionPublication/appendedPosition, 5)
    GRAPHDEFINITIONPUBLICATION(unit/graphDefinitionPublication/insertedPosition, 6)
    me bool: graphDefinitionPublicationCase(me int: caseID) <- <%{
        using namespace proteus4;
        GraphNormalizer n;n.init();
        auto parse=[](const std::string& text) {return graphParsed("definition publication",text);};
        auto norm=[&](const POVNode& node) {auto h=n.normalize(node);h.waitForCompletion();return h;};
        bool ok=true;
        if(caseID>=5) {
            const bool insert=caseID==6;
            auto root=parse(insert ? "triple:{x:*10+1 z:*10+3}" : "{*10+1 ...}");
            auto first=root->pItem->value->items.head;
            auto last=root->pItem->value->items.tail;
            auto requirement=std::make_shared<DefinitionRequirement>();
            requirement->list=true;requirement->facts.valid=true;
            requirement->facts.hasSize=true;requirement->facts.size=static_cast<std::int64_t>(insert ? 3 : 2);
            requirement->captureLabel(root);
            for(int i=1;i<=(insert ? 3 : 2);++i) {
                auto member=std::make_shared<DefinitionRequirement>();
                auto value=parse((insert ? std::string(1,"xyz"[i-1])+":" : "")+"*10+"+std::to_string(i));
                member->facts=n.access->typeFacts(value);member->captureLabel(value);
                requirement->members.push_back(member);
            }
            // These readers depend only on the existing adjacency slots, not
            // on the owner's contents or the values of its members.
            ObjectDependencies objects;ReadScope tracked({},&objects);
            std::set<DependencyKey> reads;
            {
                ReadScope capture([&](const DependencyKey& key){reads.insert(key);});
                POVDescription(first).adjacent();
                if(insert) POVDescription(last).adjacent(true);
            }
            auto proof=DependencyProof::make(reads);
            ProteusDefinitionPlan plan(n.access,root,requirement,{},true,insert);
            auto applied=plan.applyChanges();
            ok &= applied.changed && applied.changes && !applied.changes->all && proof->valid();
            if(applied.changes) for(const auto& key:applied.changes->keys) key->publish();
            ok &= !proof->valid() && first->next && first->next->pItem->value->num==2;
            if(insert) ok &= first->next->next==last && last->prev==first->next;
            else ok &= first->next==root->pItem->value->items.tail;
        } else {
            auto defs=parse("{#seven=*10+7 #pair={seven seven}}");
            ok &= !norm(defs).status().failed;
            const int count=caseID==2 ? 8 : caseID==3 ? 32 : 1;
            std::vector<POVNode> waiting;
            std::vector<Proteus4Handle> handles;
            std::vector<std::size_t> steps;
            for(int i=0;i<count;++i) {
                waiting.push_back(graphScalar(-1,10));handles.push_back(norm(waiting.back()));
                steps.push_back(handles.back().steps().size());
                ok &= handles.back().status().withSubscribers;
            }
            if(caseID==4) {
                auto target=parse("seven:*10+_");auto alias=graphScalar(-1,10);
                alias->pItem->value=target->pItem->value;
                auto h=norm(alias);ok &= h.status().withSubscribers;
                ok &= !norm(target).status().failed;h.waitForCompletion();
                ok &= !h.status().failed && !h.status().symbolicValues && alias->pItem->value->num==7;
            } else {
                for(int i=0;i<4;++i) {
                    auto target=parse(i%2 ? "pair" : "seven");auto h=norm(target);
                    ok &= !h.status().failed && !h.status().symbolicValues;
                    if(i%2) ok &= target->pItem->value->items.size()==2 &&
                        target->pItem->value->items.head->pItem->value->num==7 &&
                        target->pItem->value->items.tail->pItem->value->num==7;
                    else ok &= target->pItem->value->num==7;
                }
            }
            for(int i=0;i<count;++i) {
                handles[i].waitForCompletion();
                auto extra=handles[i].steps().size()-steps[i];
                ok &= handles[i].status().withSubscribers && extra==0;
                if(extra) std::cout<<"Unrelated definition wake: "<<extra<<" extra steps\n";
            }
            n.addRHS(waiting.front(),graphScalar(4,10));handles.front().waitForCompletion();
            ok &= !handles.front().status().failed && !handles.front().status().symbolicValues &&
                waiting.front()->pItem->value->num==4;
        }
        if(!ok) std::cout<<"Definition publication case "<<caseID<<" failed\n";
        n.close();return ok;
    }%>
    void: unitTestGraphDefinitionPublication(me string: testName, me int: caseID) <- {
        me bool: passed <- graphDefinitionPublicationCase(caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

// Requirement helpers must preserve sharing without hiding real differences.
#define GRAPHDEFINITIONHELPERS(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphDefinitionHelpers(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHDEFINITIONHELPERS(unit/graphDefinitionHelpers/sharedBranches, 1)
    GRAPHDEFINITIONHELPERS(unit/graphDefinitionHelpers/expressionRoutes, 2)
    GRAPHDEFINITIONHELPERS(unit/graphDefinitionHelpers/distinctPairs, 3)
    me bool: graphDefinitionHelpersCase(me int: caseID) <- <%{
        using namespace proteus4;
        auto leaf=std::make_shared<DefinitionRequirement>();
        if(caseID==1) {
            auto shared=[](DefinitionSpec node) {
                for(int depth=0;depth<32;++depth) {
                    auto parent=std::make_shared<DefinitionRequirement>();
                    parent->list=true;parent->members={node};parent->repeated=node;
                    parent->choices.push_back({{}, {node,node}});node=parent;
                }
                return node;
            };
            auto other=std::make_shared<DefinitionRequirement>();
            auto a=shared(leaf),b=shared(other);
            bool ok=!a->hasExpressions() && sameDefinition(a,b);
            // A second call must see changes even in a deeply shared leaf.
            other->independentTemporalValue=true;
            ok &= !sameDefinition(a,b);
            other->independentTemporalValue=false;
            leaf->expressions.push_back({{}, {}});
            ok &= a->hasExpressions() && !b->hasExpressions() && !sameDefinition(a,b);
            leaf->expressions.clear();
            return ok && !a->hasExpressions() && sameDefinition(a,b);
        }
        if(caseID==2) {
            auto parent=std::make_shared<DefinitionRequirement>();
            leaf->expressions.push_back({{}, {}});
            parent->repeated=leaf;bool ok=parent->hasExpressions();parent->repeated.reset();
            parent->members={leaf};ok &= parent->hasExpressions();parent->members.clear();
            parent->choices.push_back({{}, {leaf}});ok &= parent->hasExpressions();
            parent->choices.clear();ok &= !parent->hasExpressions();
            parent->expressions=leaf->expressions;
            return ok && parent->hasExpressions();
        }
        auto a=std::make_shared<DefinitionRequirement>(),b=std::make_shared<DefinitionRequirement>();
        auto one=std::make_shared<DefinitionRequirement>(),two=std::make_shared<DefinitionRequirement>();
        a->members={leaf,leaf};b->members={one,two};
        bool ok=sameDefinition(a,b) && sameDefinition(b,a);
        one->facts.hasSize=true;one->facts.size=3;
        ok &= !sameDefinition(a,b) && !sameDefinition(b,a);
        one->facts.hasSize=false;two->independentTemporalValue=true;
        ok &= !sameDefinition(a,b) && !sameDefinition(b,a);
        two->independentTemporalValue=false;
        auto expression=std::make_shared<POV>(),scope=std::make_shared<POV>();
        leaf->expressions={{expression,scope}};one->expressions=leaf->expressions;two->expressions=leaf->expressions;
        ok &= sameDefinition(a,b);
        one->expressions.front().scope.reset();ok &= !sameDefinition(a,b);
        one->expressions=leaf->expressions;two->expressions.front().source.reset();ok &= !sameDefinition(a,b);
        two->expressions=leaf->expressions;
        a->choices={{expression,{leaf,leaf}}};b->choices={{expression,{one,two}}};
        ok &= sameDefinition(a,b);
        b->choices.front().source=scope;ok &= !sameDefinition(a,b);
        b->choices.front().source=expression;
        return ok && sameDefinition(a,b) && sameDefinition({}, {}) && !sameDefinition(a, {}) && !sameDefinition({}, b);
    }%>
    void: unitTestGraphDefinitionHelpers(me string: testName, me int: caseID) <- {
        me bool: passed <- graphDefinitionHelpersCase(caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}





// A pending definition keeps the proofs of its already-satisfied parts.
#define GRAPHPARTIALVALIDATION(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphPartialValidation(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHPARTIALVALIDATION(unit/graphPartialValidation/pendingSibling, 1)
    GRAPHPARTIALVALIDATION(unit/graphPartialValidation/sharedValue, 2)
    GRAPHPARTIALVALIDATION(unit/graphPartialValidation/listLink, 3)
    GRAPHPARTIALVALIDATION(unit/graphPartialValidation/siblingResolved, 4)
    GRAPHPARTIALVALIDATION(unit/graphPartialValidation/stagedWrites, 5)
    GRAPHPARTIALVALIDATION(unit/graphPartialValidation/explicitParts, 6)
    GRAPHPARTIALVALIDATION(unit/graphPartialValidation/writableBindings, 7)

    me bool: graphPartialValidationCase(me string: testName, me int: caseID) <- <%{
        using namespace proteus4;
        GraphNormalizer n;n.init();bool ok=true;
        for(int count:std::vector<int>{16,64,128}) {
            std::string text="*2+{*"+std::to_string(count)+"+{";
            for(int i=0;i<count;++i) text+="*10+7 ";
            auto target=graphParsed(testName,text+"} *10+_}");
            auto known=target->pItem->value->items.head,pending=known->next;
            n.access->setDefinitionOrder(target);n.access->setDefinitionOrder(known);
            auto requirement=std::make_shared<DefinitionRequirement>();requirement->list=true;
            requirement->facts=n.access->typeFacts(target);
            auto part=std::make_shared<DefinitionRequirement>();part->list=true;part->facts=n.access->typeFacts(known);
            for(auto member=known->pItem->value->items.head;member;member=member->next) {
                auto scalar=std::make_shared<DefinitionRequirement>();scalar->facts=n.access->typeFacts(member);
                part->members.push_back(scalar);
            }
            auto missing=std::make_shared<DefinitionRequirement>();missing->facts=n.access->typeFacts(graphScalar(8,10));
            requirement->members={part,missing};
            ObjectDependencies objects;ReadScope tracked({},&objects);
            std::map<std::pair<POVNode,DefinitionSpec>,DependencyProof::Ptr> cache;
            std::size_t lookups=0,stores=0;
            ProteusDefinitionPlan::ValidationChecks checks;
            checks.lookup=[&](const POVNode& node,const DefinitionSpec& spec) {
                ++lookups;auto found=cache.find({node,spec});return found==cache.end() ? DependencyProof::Ptr{} : found->second;
            };
            checks.remember=[&](const POVNode& node,const DefinitionSpec& spec,const DependencyProof::Ptr& proof) {
                ++stores;cache[{node,spec}]=proof;
            };
            auto validate=[&](bool fill=false) {return ProteusDefinitionPlan::validates(n.access,target,requirement,fill,checks);};
            ok &= !validate() && cache.count({known,part});
            auto saved=cache[{known,part}];auto initialStores=stores;lookups=0;
            if(caseID==1) {
                for(int i=0;i<32;++i) ok &= !validate();
                ok &= stores==initialStores && lookups==64 && saved->valid();
                ok &= !getFlagBit(target->pItem->flags,infonView::isNormed);
            } else if(caseID==2 || caseID==3) {
                Changes changes;
                if(caseID==2) {
                    auto alias=graphScalar(7,10);alias->pItem->value=known->pItem->value->items.head->pItem->value;
                    alias->pItem->value->num=static_cast<std::int64_t>(6);
                    changes=ReadScope::changedObjects({alias->pItem->value.get()});
                } else {
                    auto tail=known->pItem->value->items.tail;n.access->appendDefinitionMember(known,"");
                    changes=ReadScope::changedObjects({POVDescription::positionKey(tail)});
                }
                for(const auto& key:changes.keys) key->publish();
                bool rejected=false;try {validate();} catch(const DefinitionConflict&) {rejected=true;}
                ok &= !saved->valid() && rejected;
            } else if(caseID==4 || caseID==6) {
                n.access->applyTypeFacts(pending,missing->facts);
                auto changes=ReadScope::changedObjects({pending->pItem->value.get()});
                for(const auto& key:changes.keys) key->publish();
                ok &= validate(caseID==6) && saved->valid();
                ok &= caseID==6 ? lookups==0 : lookups==2;
            } else if(caseID==5) {
                // An earlier staged write can affect later proposed facts.
                // Validation must retain the joint-plan walk in this case.
                auto reversed=graphParsed(testName,"*2+{*10+_ ?}");
                reversed->pItem->value->items.tail->pItem=known->pItem;n.access->setDefinitionOrder(reversed);
                auto spec=std::make_shared<DefinitionRequirement>(*requirement);spec->members={missing,part};
                ok &= !ProteusDefinitionPlan::validates(n.access,reversed,spec,false,checks) && lookups==1;
            } else {
                ProteusDefinitionPlan plan(n.access,target,requirement);
                ok &= plan.supported && !plan.satisfied() && plan.bindings.size()==static_cast<std::size_t>(count+3);
                ok &= plan.applyChanges().changed && pending->pItem->value->num==8;
            }
        }
        if(!ok) std::cout<<"Partial validation case "<<caseID<<" failed\n";
        n.close();return ok;
    }%>
    void: unitTestGraphPartialValidation(me string: testName, me int: caseID) <- {
        me bool: passed <- graphPartialValidationCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

// A source certificate keeps its readers and freshness across unrelated edits.
#define GRAPHDEFINITIONVALIDITY(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphDefinitionValidity(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHDEFINITIONVALIDITY(unit/graphDefinitionValidity/unrelatedWrites, 1)
    GRAPHDEFINITIONVALIDITY(unit/graphDefinitionValidity/sharedValue, 2)
    GRAPHDEFINITIONVALIDITY(unit/graphDefinitionValidity/listLink, 3)
    GRAPHDEFINITIONVALIDITY(unit/graphDefinitionValidity/explicitReset, 4)
    GRAPHDEFINITIONVALIDITY(unit/graphDefinitionValidity/untrackedReads, 5)
    GRAPHDEFINITIONVALIDITY(unit/graphDefinitionValidity/trackingUpgrade, 6)
    GRAPHDEFINITIONVALIDITY(unit/graphDefinitionValidity/lateDeclaration, 7)
    GRAPHDEFINITIONVALIDITY(unit/graphDefinitionValidity/unpublishedDefinitionEdit, 8)
    GRAPHDEFINITIONVALIDITY(unit/graphDefinitionValidity/unpublishedBindingEdit, 9)
    me bool: graphDefinitionValidityCase(me string: testName, me int: caseID) <- <%{
        using namespace proteus4;
        GraphNormalizer n;n.init();ProteusDefinitions definitions(n.access);
        auto parse=[&](const std::string& text){return graphParsed(testName,text);};
        auto source=parse("*2+{*10+1 *10+2}");Work work{0,0};
        auto proof=definitions.describe(source,work);if(!proof){n.close();return false;}
        auto first=source->pItem->value->items.head;bool ok=true;
        ProteusDefinitions::Certificate untrackedProof;
        if(caseID==5 || caseID==6) {
            ok &= definitions.current(proof);
            if(caseID==5) {
                first->pItem->value->num=static_cast<std::int64_t>(3);
                definitions.prune(true);ok &= !definitions.current(proof);
                n.close();return ok;
            }
            // Another certificate can share witnesses first checked without
            // object tracking in this same epoch. Upgrade those witnesses too.
            untrackedProof=proof;
            auto other=std::make_shared<ProteusDefinitions::Proof>();other->requirement=proof->requirement;
            other->evidence->witnesses=proof->evidence->witnesses;other->evidence->bindings=proof->evidence->bindings;
            proof=other;
        }
        if(caseID==7) proof->evidence->bindings.push_back({"later",{}});
        POVNode declaration;
        if(caseID==9) {
            declaration=parse("{#later=*10+7}")->pItem->value->items.head;
            ok &= definitions.publish(declaration);
            proof->evidence->bindings.push_back({"later",definitions.lookup("later")});
        }
        {
            ObjectDependencies objects;ReadScope tracked({},&objects);
            auto checked=[&] {
                std::set<DependencyKey> reads;
                {ReadScope capture([&](const DependencyKey& key){reads.insert(key);});ok &= definitions.current(proof);}
                return reads;
            };
            auto reads=checked();auto consumer=DependencyProof::make(reads);
            DependencyProof::Ptr upgradedConsumer;
            if(untrackedProof) {
                std::set<DependencyKey> upgradedReads;
                {ReadScope capture([&](const DependencyKey& key){upgradedReads.insert(key);});
                 ok &= definitions.current(untrackedProof);}
                upgradedConsumer=DependencyProof::make(upgradedReads);
            }
            ok &= consumer->valid();auto initialEpoch=proof->evidence->checkedEpoch;
            if(caseID==1) {
                auto unrelated=graphScalar(7,10);
                for(int i=0;i<32;++i) {
                    auto changes=ReadScope::changedObjects({unrelated->pItem->value.get()});
                    definitions.prune(true);for(const auto& key:changes.keys) key->publish();
                    ok &= consumer->valid() && checked()==reads && proof->evidence->checkedEpoch==initialEpoch;
                }
                // Explicit normalization still reads the witnesses afresh.
                definitions.prune();ok &= definitions.current(proof) && proof->evidence->checkedEpoch!=initialEpoch;
            } else if(caseID==9) {
                auto known=parse("*2+{*10+1 *10+2}");n.access->setDefinitionOrder(known);
                definitions.remember(known,proof);definitions.prune(true);
                ok &= definitions.current(proof,true); // populate the binding cache
                declaration->pItem->funcArgs=parse("*10+8")->pItem; // not yet published
                auto target=parse("*2+{*10+1 *10+2}");n.access->setDefinitionOrder(target);
                ok &= !definitions.inheritChanges(target,known).changed && !definitions.saved(target);
            } else if(caseID==8) {
                auto known=parse("*2+{*10+1 *10+2}");n.access->setDefinitionOrder(known);
                auto target=parse("*2+{*10+_ *10+_}");n.access->setDefinitionOrder(target);
                auto plan=definitions.plan(target,proof);ok &= plan && plan->supported;
                definitions.remember(known,proof);
                definitions.prune(true); // an unrelated preceding publication
                first->pItem->value->num=static_cast<std::int64_t>(3); // not yet published
                if(plan) ok &= !definitions.applyChanges(target,proof,plan).changed;
                ok &= !n.access->typeFacts(target->pItem->value->items.head).hasValue;
                auto destination=parse("*2+{*10+1 *10+2}");n.access->setDefinitionOrder(destination);
                ok &= !definitions.inheritChanges(destination,known).changed && !definitions.saved(destination);
            } else if(caseID==4) {
                first->pItem->value->num=static_cast<std::int64_t>(3);
                definitions.prune();ok &= !definitions.current(proof);
            } else if(caseID==7) {
                auto declaration=parse("{#later=*10+7}")->pItem->value->items.head;
                auto result=definitions.publishChanges(declaration);ok &= result.changed && bool(result.changes);
                if(result.changes) for(const auto& key:result.changes->keys) key->publish();
                ok &= !consumer->valid() && !definitions.current(proof);
            } else {
                Changes changes;
                if(caseID==3) {
                    auto tail=source->pItem->value->items.tail;n.access->appendDefinitionMember(source,"");
                    changes=ReadScope::changedObjects({POVDescription::positionKey(tail)});
                } else {
                    auto alias=graphScalar(1,10);alias->pItem->value=first->pItem->value;
                    alias->pItem->value->num=static_cast<std::int64_t>(3);
                    changes=ReadScope::changedObjects({alias->pItem->value.get()});
                }
                definitions.prune(true);for(const auto& key:changes.keys) key->publish();
                ok &= !consumer->valid() && !definitions.current(proof);
                if(upgradedConsumer) ok &= !upgradedConsumer->valid();
            }
        }
        if(!ok)std::cout<<"Definition validity case "<<caseID<<" failed\n";
        n.close();return ok;
    }%>
    void: unitTestGraphDefinitionValidity(me string: testName, me int: caseID) <- {
        me bool: passed <- graphDefinitionValidityCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

// Published definition analysis belongs to its version, not future builders.
#define GRAPHEXPRESSIONANALYSIS(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphExpressionAnalysis(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHEXPRESSIONANALYSIS(unit/graphExpressionAnalysis/copiedBuilder, 1)
    GRAPHEXPRESSIONANALYSIS(unit/graphExpressionAnalysis/composedMeaning, 2)
    GRAPHEXPRESSIONANALYSIS(unit/graphExpressionAnalysis/compiledChange, 3)
    me bool: graphExpressionAnalysisCase(me string: testName, me int: caseID) <- <%{
        using namespace proteus4;
        auto scalar=[] {auto p=std::make_shared<DefinitionRequirement>();p->facts.valid=true;return p;};
        auto leaf=scalar();leaf->analyzeExpressions();
        auto root=scalar();root->members={leaf,leaf};root->analyzeExpressions();
        bool ok=!root->hasExpressions();
        if(caseID==1) {
            auto copy=std::make_shared<DefinitionRequirement>(*root);
            copy->expressions.push_back({{}, {}});ok &= copy->hasExpressions() && !root->hasExpressions();
            copy->expressions.clear();ok &= !copy->hasExpressions();
            auto expr=scalar();expr->expressions.push_back({{}, {}});expr->analyzeExpressions();
            copy->choices={{{},{expr}}};ok &= copy->hasExpressions();copy->analyzeExpressions();
            *copy=*root;copy->repeated=expr;ok &= copy->hasExpressions();
            copy->repeated.reset();ok &= !copy->hasExpressions();
        } else if(caseID==2) {
            auto expr=scalar();expr->expressions.push_back({{}, {}});expr->analyzeExpressions();
            Work work{0,0};auto plain=scalar();plain->analyzeExpressions();
            auto conjunction=combineDefinitions(plain,expr,work);
            ok &= conjunction->hasExpressions() && !plain->hasExpressions();conjunction->analyzeExpressions();
            auto scope=graphScalar(1,10);auto bound=scopeDefinition(conjunction,scope,work);
            ok &= bound->hasExpressions() && bound->expressions.front().scope==scope && !conjunction->expressions.front().scope;
            // Unit conversion replaces a repeated subtree, so it must not
            // preserve the original container's context-free summary.
            auto unit=scalar();unit->list=true;unit->open=true;unit->facts.hasSize=true;unit->facts.size=static_cast<std::int64_t>(2);
            unit->repeated=scalar();unit->repeated->label="part";unit->analyzeExpressions();
            auto declared=scalar();declared->list=true;declared->repeated=unit;declared->analyzeExpressions();
            auto supplied=scalar();supplied->list=true;supplied->repeated=std::make_shared<DefinitionRequirement>(*unit->repeated);
            supplied->repeated->expressions=expr->expressions;
            auto converted=definitionInUnits(declared,supplied);
            ok &= converted!=declared && converted->hasExpressions() && !declared->hasExpressions();
        } else {
            GraphNormalizer n;n.init();ProteusDefinitions definitions(n.access);
            auto declarations=graphParsed(testName,"{#sample={x:*10+1 y:*10+1}}");
            auto declaration=declarations->pItem->value->items.head;ok &= definitions.publish(declaration);
            Work work{0,0};auto body=definitions.lookup("sample");auto proof=definitions.describe(body,work);
            ok &= proof && !proof->requirement->hasExpressions() && definitions.current(proof);
            auto original=proof ? proof->requirement : DefinitionSpec{};
            // Editing the declaration creates a new compiled meaning; it
            // cannot reuse analysis attached to the previous requirement.
            auto y=body->pItem->value->items.tail;auto expression=graphParsed(testName,"%.x");
            y->pItem=expression->pItem;definitions.prune();
            ok &= proof && !definitions.current(proof) && !definitions.describe(body,work) && original && !original->hasExpressions();
            n.close();
        }
        if(!ok)std::cout<<"Expression analysis case "<<caseID<<" failed\n";
        return ok;
    }%>
    void: unitTestGraphExpressionAnalysis(me string: testName, me int: caseID) <- {
        me bool: passed <- graphExpressionAnalysisCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

// Aliases share evidence, but that never certifies unknown or changed data.
#define GRAPHVIEWTRANSFER(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphViewTransfer(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHVIEWTRANSFER(unit/graphViewTransfer/sharedViewBound, 1)
    GRAPHVIEWTRANSFER(unit/graphViewTransfer/sharedValueHeader, 2)
    GRAPHVIEWTRANSFER(unit/graphViewTransfer/partialCopy, 3)
    GRAPHVIEWTRANSFER(unit/graphViewTransfer/atomicEdit, 4)
    GRAPHVIEWTRANSFER(unit/graphViewTransfer/childEvidence, 5)
    GRAPHVIEWTRANSFER(unit/graphViewTransfer/invalidSharedView, 6)
    GRAPHVIEWTRANSFER(unit/graphViewTransfer/contextualAliases, 7)
    GRAPHVIEWTRANSFER(unit/graphViewTransfer/sparseAliases, 8)
    me bool: graphViewTransferCase(me string: testName, me int: caseID) <- <%{
        using namespace proteus4;
        GraphNormalizer n;n.init();
        auto parse=[&](const std::string& text){return graphParsed(testName,text);};
        auto aliasOf=[&](const POVNode& source){auto p=std::make_shared<POV>(923);p->pItem=source->pItem;return p;};
        auto norm=[&](const POVNode& p){auto h=n.normalize(p);h.waitForCompletion();return h;};
        bool ok=true;
        if(caseID==7) {
            auto declarations=parse("{#sample={x:*10+_ y=%.x}}");ok &= !norm(declarations).status().failed;
            auto a=parse("sample"),b=parse("sample");auto ha=norm(a);norm(b);
            auto alias=aliasOf(a);auto h=norm(alias);
            auto x=a->pItem->fetchField("x"),y=a->pItem->fetchField("y");
            auto bx=b->pItem->fetchField("x"),by=b->pItem->fetchField("y");
            ok &= h.status().symbolicValues && x && y && bx && by;
            if(x && y && bx && by) {
                auto before=y->pItem->wrkList.size();
                n.addRHS(x,parse("*10+1"));n.addRHS(bx,parse("*10+2"));
                ha.waitForCompletion();h.waitForCompletion();norm(b);h=norm(alias);
                auto left=n.access->typeFacts(y),right=n.access->typeFacts(by);
                ok &= !h.status().failed && left.hasValue && left.number==1 && right.hasValue && right.number==2 &&
                    alias->pItem==a->pItem && a->pItem!=b->pItem && y->pItem->wrkList.size()<=before;
            }
        } else if(caseID==8) {
            ok &= !norm(parse("{#many=*1000000000+{*10+7| ...}}")).status().failed;
            auto source=parse("many");ok &= !norm(source).status().failed;
            auto alias=aliasOf(source);auto selection=n.findItem(alias,999999999);selection.waitForCompletion();
            auto member=selection.result();
            ok &= !selection.status().failed && member && n.access->demandedOccurrences(source).size()==1 &&
                source->pItem->value->items.isEmpty();
            if(member) {
                ok &= member->pItem->value->num==7;
                // The alias cannot hide a contradictory demanded virtual item.
                n.addRHS(member,parse("*10+8"));auto h=norm(alias);
                ok &= h.status().failed && !getFlagBit(source->pItem->flags,infonView::isNormed) && source->pItem->value->items.isEmpty();
            }
        } else {
            ProteusDefinitions definitions(n.access);
            auto proofFor=[&](const POVNode& source) {
                auto proof=std::make_shared<ProteusDefinitions::Proof>();
                proof->requirement=std::make_shared<DefinitionRequirement>();
                auto requirement=proof->requirement;requirement->list=true;requirement->facts=n.access->typeFacts(source);
                for(auto member=source->pItem->value->items.head;member;member=member->next) {
                    auto part=std::make_shared<DefinitionRequirement>();part->facts=n.access->typeFacts(member);
                    requirement->members.push_back(part);
                }
                return proof;
            };
            auto source=parse("*2+{*10+1 *10+2}");n.access->setDefinitionOrder(source);
            auto proof=proofFor(source);ok &= definitions.remember(source,proof);
            if(caseID==1) {
                ObjectDependencies objects;ReadScope tracked({},&objects);
                for(int count:{2,64,256}) {
                    std::string text="*"+std::to_string(count)+"+{";
                    for(int i=0;i<count;++i) text+="*10+1 ";
                    auto root=parse(text+"}");n.access->setDefinitionOrder(root);
                    auto meaning=proofFor(root);definitions.remember(root,meaning);auto alias=aliasOf(root);
                    std::set<DependencyKey> reads;
                    {
                        ReadScope capture([&](const DependencyKey& key){reads.insert(key);});
                        ok &= !definitions.canInherit(alias,root);
                        auto result=definitions.inheritChanges(alias,root);
                        ok &= !result.changed && !result.retainEvidence;
                    }
                    // Shared evidence access is independent of descendant count.
                    ok &= reads.size()<=12 && definitions.saved(alias)==meaning;
                    auto consumer=DependencyProof::make(reads);ok &= consumer->valid();
                    alias->pItem=parse("_")->pItem;
                    for(const auto& key:ReadScope::changedObjects({alias.get()}).keys) key->publish();
                    ok &= !consumer->valid();
                }
            } else if(caseID==2) {
                auto target=parse("*3+{}");target->pItem->value=source->pItem->value;n.access->setDefinitionOrder(target);
                ok &= !definitions.canInherit(target,source) && !definitions.inheritChanges(target,source).changed;
                target->pItem->infSize=source->pItem->infSize;
                ok &= definitions.canInherit(target,source) && definitions.inheritChanges(target,source).changed &&
                    definitions.saved(target) && target->pItem!=source->pItem;
            } else if(caseID==3) {
                auto target=parse("*2+{*10+1 *10+_}");n.access->setDefinitionOrder(target);
                ok &= !definitions.canInherit(target,source) && !definitions.inheritChanges(target,source).changed &&
                    !definitions.saved(target) && !n.access->typeFacts(target->pItem->value->items.tail).hasValue;
            } else if(caseID==4) {
                auto target=parse("*2+{*10+1 *10+2}");n.access->setDefinitionOrder(target);
                ok &= definitions.accepts(proof,source) && definitions.accepts(proof,target);
                // Simulate earlier writes in one Set, before publication. Cached
                // acceptance cannot authorize transfer from/to the changed data.
                source->pItem->value->items.tail->pItem->value->num=static_cast<std::int64_t>(3);
                ok &= !definitions.canInherit(target,source) && !definitions.inheritChanges(target,source).changed;
                source->pItem->value->items.tail->pItem->value->num=static_cast<std::int64_t>(2);
                target->pItem->value->items.tail->pItem->value->num=static_cast<std::int64_t>(3);
                ok &= !definitions.canInherit(target,source) && !definitions.inheritChanges(target,source).changed && !definitions.saved(target);
            } else if(caseID==5) {
                auto target=parse("*2+{*10+1 *10+2}");n.access->setDefinitionOrder(target);
                auto result=definitions.inheritChanges(target,source);
                ok &= result.changed && bool(result.retainEvidence);
                if(result.retainEvidence) result.retainEvidence();
                auto child=target->pItem->value->items.tail;auto saved=definitions.saved(child);
                ok &= saved && saved->requirement==proof->requirement->members[1] &&
                    saved->evidence==proof->evidence && definitions.accepts(saved,child);
            } else {
                auto alias=aliasOf(source);
                source->pItem->value->items.tail->pItem->value->num=static_cast<std::int64_t>(3);
                auto result=definitions.inheritChanges(alias,source);
                ok &= !result.changed && !result.retainEvidence && !definitions.accepts(proof,alias);
                // Root meaning recorded by compilation does not require a
                // transfer through an alias to publish the child certificates.
                source->pItem->value->items.tail->pItem->value->num=static_cast<std::int64_t>(2);
                auto plan=definitions.plan(alias,proof);ok &= plan && plan->dataSatisfied();
                if(plan) {
                    ok &= definitions.applyChanges(alias,proof,plan).changed;
                    ok &= bool(definitions.saved(source->pItem->value->items.tail));
                }
            }
        }
        if(!ok) std::cout<<"View transfer case "<<caseID<<" failed\n";
        n.close();return ok;
    }%>
    void: unitTestGraphViewTransfer(me string: testName, me int: caseID) <- {
        me bool: passed <- graphViewTransferCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

// Shared provenance can skip equality work, never requirement/dependency checks.
#define GRAPHPROOFIDENTITY(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphProofIdentity(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHPROOFIDENTITY(unit/graphProofIdentity/sharedEvidence, 1)
    GRAPHPROOFIDENTITY(unit/graphProofIdentity/differentRequirement, 2)
    GRAPHPROOFIDENTITY(unit/graphProofIdentity/equivalentEvidence, 3)
    GRAPHPROOFIDENTITY(unit/graphProofIdentity/differentDependencies, 4)

    me bool: graphProofIdentityCase(me int: caseID) <- <%{
        using namespace proteus4;
        GraphNormalizer n;n.init();ProteusDefinitions definitions(n.access);
        auto target=graphScalar(3,10);
        auto first=std::make_shared<ProteusDefinitions::Proof>();
        first->requirement=std::make_shared<DefinitionRequirement>();
        first->requirement->facts=n.access->typeFacts(target);
        // A missing catalogue name is still an observed dependency.
        first->evidence->bindings.push_back({"futurea",{}});
        auto second=std::make_shared<ProteusDefinitions::Proof>(*first);
        if(caseID==2) {
            second->requirement=std::make_shared<DefinitionRequirement>(*first->requirement);
            second->requirement->facts.number=static_cast<std::int64_t>(4);
        }
        if(caseID>=3) {
            second->requirement=std::make_shared<DefinitionRequirement>(*first->requirement);
            second->evidence=std::make_shared<ProteusDefinitions::Evidence>();
            second->evidence->bindings.push_back({caseID==4 ? "futureb" : "futurea",{}});
        }
        bool ok=definitions.current(first) && definitions.current(second) && definitions.remember(target,first);
        ok &= definitions.remember(target,second)==(caseID==2 || caseID==4);
        ok &= !definitions.remember(target,second);
        if(caseID==2) {
            ok &= definitions.accepts(first,target) && !definitions.accepts(second,target);
        } else if(caseID==4) {
            auto declarations=graphParsed("proof dependencies","{#futurea=*10+3}");
            ok &= definitions.publish(declarations->pItem->value->items.head);
            ok &= !definitions.current(first) && definitions.current(second) && definitions.saved(target)==second;
        } else {
            ok &= definitions.saved(target)==first && definitions.accepts(second,target);
            // Sharing/equivalence never makes a changed source meaning current.
            auto declarations=graphParsed("proof shared dependencies","{#futurea=*10+3}");
            ok &= definitions.publish(declarations->pItem->value->items.head);
            ok &= !definitions.current(first) && !definitions.current(second) && !definitions.saved(target);
        }
        if(!ok)std::cout<<"Proof identity case "<<caseID<<" failed\n";
        n.close();return ok;
    }%>
    void: unitTestGraphProofIdentity(me string: testName, me int: caseID) <- {
        me bool: passed <- graphProofIdentityCase(caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

// Definition facts prune nominal candidates; instance ambiguity remains live.
#define GRAPHRECORDINDEX(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphRecordIndex(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHRECORDINDEX(unit/graphRecordIndex/nominalRules, 1)
    GRAPHRECORDINDEX(unit/graphRecordIndex/matchingEquivalence, 2)
    GRAPHRECORDINDEX(unit/graphRecordIndex/sharedAnalysis, 3)
    GRAPHRECORDINDEX(unit/graphRecordIndex/changedLayout, 4)
    GRAPHRECORDINDEX(unit/graphRecordIndex/valueChecks, 5)
    GRAPHRECORDINDEX(unit/graphRecordIndex/unknownAndDuplicate, 6)
    GRAPHRECORDINDEX(unit/graphRecordIndex/linearMatching, 7)

    me bool: graphRecordIndexCase(me int: caseID) <- <%{
        using namespace proteus4;
        if(caseID<=2) {
            std::vector<NominalDescription> descriptions={
                {"wheel",{"part"}}, {"pedal",{"part"}}, {"part",{}},
                {"wheel",{"round"}}, {"round",{}}, {"",{}},
                {"wheel",{"wheel","wheel"}}, {"wheel",{"pedal"}}
            };
            if(caseID==1) {
                Work work{0,0};NominalMemberIndex index({descriptions[0],descriptions[1]},work);
                auto match=[&](NominalDescription value) {return index.candidates(value,work);};
                return index.distinguishable && match(descriptions[0])==std::vector<std::size_t>{0} &&
                    match(descriptions[1])==std::vector<std::size_t>{1} &&
                    match(descriptions[2])==std::vector<std::size_t>{0,1} &&
                    match(descriptions[7])==std::vector<std::size_t>{0,1};
            }
            // Compare against the original nominal correspondence contract,
            // including omissions, aliases, duplicate matches, and unknowns.
            std::vector<std::vector<NominalDescription>> layouts{{}};
            for(const auto& a:descriptions) {
                layouts.push_back({a});
                for(const auto& b:descriptions) layouts.push_back({a,b});
            }
            for(const auto& required:layouts) for(const auto& actual:layouts) {
                Work oldWork{0,0},work{0,0};bool distinct=true;
                for(std::size_t i=0;i<required.size();++i) {
                    distinct &= !required[i].primary.empty();
                    for(std::size_t j=0;j<i;++j)
                        distinct &= compareNominal(required[i].primary,required[i].types,required[j].primary,required[j].types)!=ScalarMatch::yes;
                }
                MemberCorrespondence old(actual.size(),required.size(),[](auto,auto){return false;},[&](auto a,auto b) {
                    return compareNominal(required[b].primary,required[b].types,actual[a].primary,actual[a].types);
                },oldWork);
                NominalMemberIndex index(required,work);
                auto result=MemberCorrespondence::nominal(index,actual.size(),[&](auto i){return actual[i];},work);
                bool expected=distinct && old.unambiguous;
                if(result.unambiguous!=expected || (expected && (result.pairs!=old.pairs || result.missing!=old.missing))) {
                    std::cout<<"Nominal index changed correspondence\n";return false;
                }
            }
            return true;
        }
        auto member=[](std::string type) {
            auto result=std::make_shared<DefinitionRequirement>();result->facts.valid=true;
            result->label=type;result->types={type};return result;
        };
        auto requirement=std::make_shared<DefinitionRequirement>();requirement->facts.valid=true;
        requirement->list=true;requirement->order=uUnordered;requirement->open=true;
        requirement->members={member("wheel"),member("pedal")};
        if(caseID==3) {
            Work work{0,0};auto empty=std::make_shared<DefinitionRequirement>();empty->facts.valid=true;
            auto first=combineDefinitions(empty,requirement,work),second=combineDefinitions(empty,requirement,work);
            auto analysis=requirement->recordMembers(work);
            bool ok=first->recordMembers(work)==analysis && second->recordMembers(work)==analysis;
            // Copies can acquire different layouts without altering a shared
            // immutable analysis or the other definitions using it.
            first->members.push_back(member("chain"));auto expanded=first->recordMembers(work);
            return ok && expanded!=analysis && expanded->descriptions.size()==3 &&
                second->recordMembers(work)==analysis && analysis->descriptions.size()==2;
        }
        if(caseID==4) {
            Work work{0,0};auto before=requirement->recordMembers(work);
            std::swap(requirement->members[0],requirement->members[1]);auto reordered=requirement->recordMembers(work);
            bool ok=reordered!=before && reordered->descriptions.front().primary=="pedal";
            requirement->members[0]->types.push_back("wheel");auto aliased=requirement->recordMembers(work);
            ok &= aliased!=reordered && !aliased->distinguishable && reordered->distinguishable;
            requirement->members[0]->types={"pedal"};auto restored=requirement->recordMembers(work);
            requirement->members[0]->label.clear();auto unknown=requirement->recordMembers(work);
            return ok && restored->distinguishable && !unknown->distinguishable;
        }
        GraphNormalizer n;n.init();bool ok=true;
        auto parse=[](const std::string& text){return graphParsed("record index",text);};
        if(caseID==5) {
            auto target=parse("{wheel:*10+7, pedal:*10+2}");
            auto at=target->pItem->value->items.head;
            for(auto& part:requirement->members) {part->facts=n.access->typeFacts(at);at=at->next;}
            ProteusDefinitionPlan accepted(n.access,target,requirement);ok &= accepted.satisfied();
            Work work{0,0};auto analysis=requirement->recordMembers(work);
            requirement->members[0]->facts.number=static_cast<std::int64_t>(8);bool rejected=false;
            auto before=toString(target->pItem.get());
            try {ProteusDefinitionPlan conflict(n.access,target,requirement);}catch(const DefinitionConflict&){rejected=true;}
            ok &= rejected && before==toString(target->pItem.get()) && requirement->recordMembers(work)==analysis;
        } else if(caseID==6) {
            requirement->members[0]->facts=n.access->typeFacts(graphScalar(7,10));
            for(const auto& input:{"{wheel:*10+_, ?}","{wheel:*10+_, wheel:*10+_, pedal:*10+2}"}) {
                auto target=parse(input);auto before=toString(target->pItem.get());
                ProteusDefinitionPlan pending(n.access,target,requirement);
                ok &= !pending.supported && !pending.apply() && before==toString(target->pItem.get());
            }
            // A known unrelated part does not make correspondence ambiguous.
            auto target=parse("{wheel:*10+_, pedal:*10+2, chain:*10+3}");
            ProteusDefinitionPlan fill(n.access,target,requirement);
            ok &= fill.supported && fill.apply() && target->pItem->value->items.head->pItem->value->num==7;
        } else {
            requirement->members.clear();std::string text="{";const int count=64;
            for(int i=0;i<count;++i) {
                if(i)text+=", ";auto type="field"+std::to_string(i);text+=type+":*10+7";
                auto part=member(type);part->facts=n.access->typeFacts(graphScalar(7,10));requirement->members.push_back(part);
            }
            text+="}";Work work{0,0};auto analysis=requirement->recordMembers(work);
            for(int instance=0;instance<16;++instance) {
                auto target=parse(text);ProteusDefinitionPlan check(n.access,target,requirement);
                ok &= check.satisfied() && check.work.visits<24*count && requirement->recordIndex==analysis;
            }
        }
        if(!ok)std::cout<<"Record index case "<<caseID<<" failed\n";
        n.close();return ok;
    }%>
    void: unitTestGraphRecordIndex(me string: testName, me int: caseID) <- {
        me bool: passed <- graphRecordIndexCase(caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

// Repeated definition paths share proofs, preserving distinct instance data.
#define GRAPHDEFINITIONSHARING(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphDefinitionSharing(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHDEFINITIONSHARING(unit/graphDefinitionSharing/scopeSharing, 1)
    GRAPHDEFINITIONSHARING(unit/graphDefinitionSharing/scopeBindings, 2)
    GRAPHDEFINITIONSHARING(unit/graphDefinitionSharing/conjunctionSharing, 3)
    GRAPHDEFINITIONSHARING(unit/graphDefinitionSharing/distinctConjunctions, 4)
    GRAPHDEFINITIONSHARING(unit/graphDefinitionSharing/pendingAlternatives, 5)
    GRAPHDEFINITIONSHARING(unit/graphDefinitionSharing/distinctTargets, 6)
    GRAPHDEFINITIONSHARING(unit/graphDefinitionSharing/parsedSharing, 7)
    GRAPHDEFINITIONSHARING(unit/graphDefinitionSharing/parsedAlternatives, 8)

    me bool: graphDefinitionSharingCase(me int: caseID) <- <%{
        using namespace proteus4;
        auto scalar=[] {
            auto result=std::make_shared<DefinitionRequirement>();result->facts.valid=true;return result;
        };
        auto nest=[&](DefinitionSpec leaf,int depth) {
            for(int i=0;i<depth;++i) {
                auto parent=scalar();parent->list=true;parent->members={leaf,leaf};leaf=parent;
            }
            return leaf;
        };
        auto count=[](DefinitionSpec root) {
            std::vector<DefinitionSpec> pending{root};std::set<DefinitionSpec> seen;
            while(!pending.empty()) {
                auto at=pending.back();pending.pop_back();if(!at || !seen.insert(at).second) continue;
                pending.insert(pending.end(),at->members.begin(),at->members.end());
                if(at->repeated) pending.push_back(at->repeated);
                for(const auto& choice:at->choices)
                    pending.insert(pending.end(),choice.alternatives.begin(),choice.alternatives.end());
            }
            return seen.size();
        };
        if(caseID==1 || caseID==2) {
            auto leaf=scalar(),source=nest(leaf,24);Work work{0,0};
            auto scope=std::make_shared<POV>(),otherScope=std::make_shared<POV>();
            if(caseID==1) return scopeDefinition(source,scope,work)==source && work.visits<100;
            auto expression=std::make_shared<POV>();leaf->expressions={{expression,{}}};
            auto bound=scopeDefinition(source,scope,work);
            bool ok=bound!=source && count(bound)==25 && work.visits<100 && !leaf->expressions.front().scope;
            auto bottom=bound;
            for(int i=0;i<24;++i) {
                ok &= bottom->members[0]==bottom->members[1];bottom=bottom->members[0];
            }
            ok &= bottom->expressions.front().scope==scope;
            // An already bound nested meaning must not be rebound. An unbound
            // occurrence of the original declaration gets its own context.
            auto wrapper=scalar();wrapper->list=true;wrapper->members={bound,source};
            auto next=scopeDefinition(wrapper,otherScope,work);
            ok &= next->members[0]==bound && next->members[1]!=bound;
            bottom=next->members[1];while(!bottom->members.empty())bottom=bottom->members[0];
            ok &= bottom->expressions.front().scope==otherScope;
            leaf->expressions.clear();Work fresh{0,0};
            return ok && scopeDefinition(source,scope,fresh)==source;
        }
        if(caseID==3) {
            auto leaf=scalar(),other=scalar();auto a=nest(leaf,20),b=nest(other,20);Work work{0,0};
            auto result=combineDefinitions(a,b,work);
            bool ok=count(result)==21 && work.visits<100 && result!=a && result!=b && sameDefinition(result,a);
            // New facts on a shared leaf are observed by a fresh conjunction;
            // changing a result must not change either source declaration.
            other->facts.hasSize=true;other->facts.size=static_cast<std::int64_t>(7);
            auto changed=combineDefinitions(a,b,work);auto bottom=changed;
            while(!bottom->members.empty())bottom=bottom->members[0];
            ok &= bottom->facts.hasSize && bottom->facts.size==7 && !leaf->facts.hasSize && !sameDefinition(changed,result);
            leaf->facts.hasSize=true;leaf->facts.size=static_cast<std::int64_t>(8);bool rejected=false;
            try {combineDefinitions(a,b,work);}catch(const DefinitionConflict&){rejected=true;}
            return ok && rejected;
        }
        if(caseID==4) {
            auto shared=scalar(),one=scalar(),two=scalar(),a=scalar(),b=scalar();
            a->list=b->list=true;a->members={shared,shared};b->members={one,two};
            one->facts.hasSize=two->facts.hasSize=true;one->facts.size=static_cast<std::int64_t>(3);two->facts.size=static_cast<std::int64_t>(4);
            one->label="first";two->label="second";Work work{0,0};auto result=combineDefinitions(a,b,work);
            bool ok=result->members[0]!=result->members[1] && result->members[0]->facts.size==3 &&
                result->members[1]->facts.size==4 && result->members[0]->label=="first" && result->members[1]->label=="second";
            // Preserve shared repetition and finite prefixes under conjunction.
            a->open=b->open=true;a->repeated=shared;b->repeated=scalar();
            b->repeated->facts.hasSize=true;b->repeated->facts.size=static_cast<std::int64_t>(3);
            bool rejected=false;try {combineDefinitions(a,b,work);}catch(const DefinitionConflict&){rejected=true;}
            return ok && rejected && !shared->facts.hasSize;
        }
        GraphNormalizer n;n.init();bool ok=true;
        auto literal=[&](int value) {auto result=scalar();result->facts=n.access->typeFacts(graphScalar(value,10));return result;};
        if(caseID==5) {
            auto required=literal(7);auto leaf=required;
            for(int depth=0;depth<20;++depth) {auto choice=scalar();choice->choices={{ {},{required,required} }};required=choice;}
            auto target=graphScalar(-1,10);
            ProteusDefinitionPlan pending(n.access,target,required);
            ok &= !pending.supported && pending.writes.empty() && pending.work.visits<100;
            target->pItem=graphScalar(7,10)->pItem;
            ProteusDefinitionPlan accepted(n.access,target,required);ok &= accepted.dataSatisfied();
            target->pItem=graphScalar(8,10)->pItem;bool rejected=false;
            try {ProteusDefinitionPlan wrong(n.access,target,required);}catch(const DefinitionConflict&){rejected=true;}
            ok &= rejected && leaf->facts.number==7;
        } else if(caseID==6) {
            auto seven=literal(7),eight=literal(8);auto choice=scalar();choice->choices={{{},{seven,seven}}};
            auto required=scalar();required->list=true;required->members={choice,choice};
            auto target=graphParsed("shared definition targets","{*10+7 *10+8}");n.access->setDefinitionOrder(target);
            auto before=toString(target->pItem.get());bool rejected=false;
            try {ProteusDefinitionPlan check(n.access,target,required);}catch(const DefinitionConflict&){rejected=true;}
            ok &= rejected && before==toString(target->pItem.get());
            choice->choices.front().alternatives={seven,eight};
            ProteusDefinitionPlan check(n.access,target,required);ok &= check.dataSatisfied();
            // Planning a shared requirement still creates distinct instance
            // slots and commands; only the read-only branch checks are shared.
            auto unknown=graphParsed("shared definition writes","{*10+_ *10+_}");n.access->setDefinitionOrder(unknown);
            required->members={seven,seven};ProteusDefinitionPlan fill(n.access,unknown,required);
            ok &= fill.supported && fill.apply() && unknown->pItem->value->items.head!=unknown->pItem->value->items.tail &&
                unknown->pItem->value->items.head->pItem!=unknown->pItem->value->items.tail->pItem &&
                unknown->pItem->value->items.head->pItem->value->num==7 && unknown->pItem->value->items.tail->pItem->value->num==7;
        } else {
            const bool choice=caseID==8;const int depth=16;
            std::string text=choice ? "{#p0=*10+7" : "{#p0=*10+_";
            for(int i=1;i<=depth;++i) {
                auto child="p"+std::to_string(i-1);
                text+=" #p"+std::to_string(i)+(choice ? "=*_+[" : "={")+child+" "+child+(choice ? "]" : "}");
            }
            auto declarations=graphParsed("shared definition declarations",text+"}");ProteusDefinitions definitions(n.access);
            for(auto at=declarations->pItem->value->items.head;at;at=at->next)ok &= definitions.publish(at);
            Work work{0,0};auto target=graphParsed("shared definition query",choice ? "p16" : "p16=p16");
            auto proof=definitions.describe(target,work);
            ok &= bool(proof) && work.visits<5000;
            if(proof) {
                ok &= count(proof->requirement)<70;
                if(choice) {
                    auto value=graphScalar(-1,10);ProteusDefinitionPlan pending(n.access,value,proof->requirement);
                    ok &= !pending.supported && pending.writes.empty() && pending.work.visits<200;
                    value->pItem=graphScalar(7,10)->pItem;ProteusDefinitionPlan accepted(n.access,value,proof->requirement);
                    ok &= accepted.dataSatisfied();
                }
            }
        }
        if(!ok)std::cout<<"Definition sharing case "<<caseID<<" failed\n";
        n.close();return ok;
    }%>
    void: unitTestGraphDefinitionSharing(me string: testName, me int: caseID) <- {
        me bool: passed <- graphDefinitionSharingCase(caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

// Shared recognition must bound work without discarding distinct derivations.
#define GRAPHSEQUENCECHART(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphSequenceChart(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHSEQUENCECHART(unit/graphSequenceChart/nestedRepetitionScaling, 1)
    GRAPHSEQUENCECHART(unit/graphSequenceChart/acceptedList, 2)
    GRAPHSEQUENCECHART(unit/graphSequenceChart/lateInput, 3)
    GRAPHSEQUENCECHART(unit/graphSequenceChart/cancel, 4)
    GRAPHSEQUENCECHART(unit/graphSequenceChart/cost, 5)
    GRAPHSEQUENCECHART(unit/graphSequenceChart/packedAlternatives, 6)
    GRAPHSEQUENCECHART(unit/graphSequenceChart/nestedChoiceScaling, 7)
    me bool: graphSequenceChartCase(me string: testName, me int: caseID) <- <%{
        using namespace proteus4;
        if(caseID==1 || caseID==7) {
            std::size_t previous=0;
            // Depth 20 also exercises helpers over shared compiled meanings;
            // the chart can stay small while a tree walk repeats exponentially.
            for(int count:(caseID==7 ? std::vector<int>{4,8,16,40} : std::vector<int>{4,8,16})) {
                GraphNormalizer normalizer;normalizer.init();
                std::string pattern="'A'",rhs="{";
                if(caseID==7) {
                    // Shared definitions make the grammar grow linearly while
                    // its derivations double at every level.
                    std::string definitions="{#p0='A'";
                    int depth=count/2;
                    for(int d=1;d<=depth;++d) {
                        auto child="p"+std::to_string(d-1);
                        definitions+=" #p"+std::to_string(d)+"=*_+[{"+child+"} "+child+"]";
                    }
                    definitions+="}";
                    auto declared=normalizer.normalize(graphParsed(testName,definitions));declared.waitForCompletion();
                    if(declared.status().failed) {normalizer.close();return false;}
                    pattern="p"+std::to_string(depth);rhs+="'A' ";
                } else {
                    for(int depth=0;depth<3;++depth) pattern="{"+pattern+"|...}";
                    for(int i=0;i<count;++i) rhs+="'A' ";
                }
                rhs+="'Y'}";
                auto root=graphParsed(testName,"{"+pattern+" 'X'} == "+rhs);
                auto source=root->pItem->wrkList.front();
                auto before=toString(root->pItem.get()),sourceBefore=toString(source->pItem.get());
                auto handle=normalizer.normalize(root);handle.waitForCompletion();
                auto steps=handle.steps().size();
                std::size_t matches=0;for(const auto& step:handle.steps()) matches+=step.action=="matched input member";
                // Doubling input may require cubic chart work, but not the
                // exponential enumeration of nested parses. Count work, not
                // wall time, so this gate is independent of machine speed.
                bool passed=!handle.status().failed && handle.status().symbolicValues &&
                    before==toString(root->pItem.get()) && sourceBefore==toString(source->pItem.get()) &&
                    (!previous || steps<previous*8) && steps<100*count*count;
                if(caseID==7) passed &= matches<=count+1;
                std::cout<<"Sequence chart "<<caseID<<" scale="<<count<<" steps="<<steps<<" matches="<<matches<<"\n";
                previous=steps;handle.cancel();normalizer.close();if(!passed) return false;
            }
            return true;
        }
        GraphNormalizer normalizer;normalizer.init();
        auto root=graphParsed(testName,"{&{*_+['A' {'A'}]|...} 'X'} == "+
            std::string(caseID==3 || caseID==4 ? "{'A' $ 'X'}" : "{'A' 'A' 'X'}"));
        auto source=root->pItem->wrkList.front();
        auto sourceBefore=toString(source->pItem.get());
        auto span=root->pItem->value->items.head;
        auto body=span->pItem->value->listSpec;
        auto bodyBefore=toString(body.get());
        bool passed=true;
        if(caseID==6) {
            // Inspect the recognition forest before choosing a result. Two
            // independent occurrences, each with two derivations, must retain
            // all four proofs even though their continuation is shared.
            SequenceChart chart(normalizer.access,std::make_shared<ProteusDefinitions>(normalizer.access),
                                {root,sequenceCorrespondence,0,source});
            std::vector<Query<POVNode>> pending{{root,sequenceCorrespondence,0,source}};
            std::set<Query<POVNode>> visited;
            for(std::size_t i=0;i<pending.size();++i) {
                if(!visited.insert(pending[i]).second) continue;
                auto next=chart.expand({pending[i],{},0});
                for(auto& edge:next.edges) pending.push_back(edge.follow().query);
            }
            std::set<std::vector<Query<POVNode>>> paths;
            chart.proofs([&](Visit<POVNode> visit) {paths.insert(std::move(visit.path));return false;});
            passed=paths.size()==4 && span->pItem->value->items.isEmpty();
            if(!passed) std::cout<<"Packed derivations: "<<paths.size()<<"\n";
        } else {
            auto handle=caseID==5 ? normalizer.normalizeWithCost(root,0) : normalizer.normalize(root);
            handle.waitForCompletion();passed=!handle.status().failed;
            if(caseID==3 || caseID==4) {
                passed &= handle.status().symbolicValues && handle.status().withSubscribers && span->pItem->value->items.isEmpty();
                if(caseID==4) handle.cancel();
                normalizer.addRHS(source->pItem->value->items.head->next,graphParsed(testName,"'A'"));
                handle.waitForCompletion();
            }
            if(caseID==4 || caseID==5) {
                passed &= handle.status().symbolicValues && span->pItem->value->items.isEmpty();
                if(caseID==4) passed &= handle.status().cancelled;
            } else {
                passed &= !handle.status().failed && !handle.status().symbolicValues &&
                    toString(root->pItem.get())=="{&{'A' 'A'} 'X'}";
                auto first=span->pItem->value->items.head;
                auto identities=normalizer.access->registry->identities.size();
                auto again=normalizer.normalize(root);again.waitForCompletion();
                passed &= !again.status().symbolicValues && first==span->pItem->value->items.head &&
                    identities==normalizer.access->registry->identities.size();
            }
            handle.cancel();
        }
        passed &= bodyBefore==toString(body.get());
        if(caseID!=3 && caseID!=4) passed &= sourceBefore==toString(source->pItem.get());
        if(!passed) std::cout<<"Chart case "<<caseID<<": "<<toString(root->pItem.get())<<"\n";
        normalizer.close();return passed;
    }%>
    void: unitTestGraphSequenceChart(me string: testName, me int: caseID) <- {
        me bool: passed <- graphSequenceChartCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}


#define GRAPHDEFINITIONREUSE(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphDefinitionReuse(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHDEFINITIONREUSE(unit/graphDefinitionReuse/sharedSourceChange, 1)
    GRAPHDEFINITIONREUSE(unit/graphDefinitionReuse/instanceIsolation, 2)
    GRAPHDEFINITIONREUSE(unit/graphDefinitionReuse/lateSharedMeaning, 3)
    GRAPHDEFINITIONREUSE(unit/graphDefinitionReuse/distinctSnapshots, 4)
    GRAPHDEFINITIONREUSE(unit/graphDefinitionReuse/cachedReadSubscription, 5)
    GRAPHDEFINITIONREUSE(unit/graphDefinitionReuse/catalogueAmbiguity, 6)
    GRAPHDEFINITIONREUSE(unit/graphDefinitionReuse/changedCopiedDefinition, 10)
    GRAPHDEFINITIONREUSE(unit/graphDefinitionReuse/additionalRequirement, 9)
    GRAPHDEFINITIONREUSE(unit/graphDefinitionReuse/copiedList, 8)
    GRAPHDEFINITIONREUSE(unit/graphDefinitionReuse/copiedScalar, 7)
    me bool: graphDefinitionReuseCase(me string: testName, me int: caseID) <- <%{
        using namespace proteus4;
        GraphNormalizer n;n.init();
        auto parse=[&](const std::string& text){return graphParsed(testName,text);};
        auto norm=[&](const POVNode& node){auto h=n.normalize(node);h.waitForCompletion();return h;};
        bool ok=true;
        if(caseID>=7) {
            bool list=caseID==8;
            auto declarations=parse(list ? "{#checked={x:*10+1 y:*10+2}}" : "{#checked=*10+3 #extra=*10+4}");
            ok &= !norm(declarations).status().failed;
            auto b=parse("checked");auto hb=norm(b);
            ok &= !hb.status().failed && !hb.status().symbolicValues;
            auto a=parse(caseID==9 ? "extra" : "?");n.addRHS(a,b);
            auto ha=norm(a);
            if(caseID==9) ok &= ha.status().failed;
            else {
                ok &= !ha.status().failed && !ha.status().symbolicValues;
                if(list) {
                    auto ax=a->pItem->fetchField("x"),bx=b->pItem->fetchField("x");
                    ok &= ax && bx && ax->pItem->value->num==1 && bx->pItem->value->num==1;
                } else ok &= a->pItem->infSize->num==10 && a->pItem->value->num==3;
                auto again=norm(a);ok &= !again.status().failed && !again.status().symbolicValues;
                if(caseID==10) {
                    auto body=std::make_shared<POV>(956);body->pItem=declarations->pItem->value->items.head->pItem->funcArgs;
                    n.addRHS(body,parse("*10+4"));
                    ok &= norm(a).status().failed && norm(b).status().failed;
                }
            }
        } else if(caseID<=3) {
            auto declarations=parse(caseID==3 ? "{#left=base #right=base}" :
                "{#base={x:*10+1, y:*10+2} #left=base #right=base}");
            ok &= !norm(declarations).status().failed;
            auto a=parse(caseID==3 ? "left:*10+1" : "left");
            auto b=parse(caseID==3 ? "right:*10+1" : "right");
            auto ha=norm(a),hb=norm(b);ha.waitForCompletion();
            ok &= !ha.status().failed && !hb.status().failed;
            if(caseID==3) {
                // Both cached alias proofs must retain the initially absent
                // base name even after the searches that proved them retire.
                ha={};hb={};
                ok &= getFlagBit(a->pItem->flags,infonView::isNormed) && getFlagBit(b->pItem->flags,infonView::isNormed);
                ok &= !norm(parse("{#base=*10+2}")).status().failed;
                ok &= !getFlagBit(a->pItem->flags,infonView::isNormed) && !getFlagBit(b->pItem->flags,infonView::isNormed);
                ok &= norm(a).status().failed && norm(b).status().failed;
            } else {
                auto ax=a->pItem->fetchField("x"),bx=b->pItem->fetchField("x");
                ok &= ax && bx && ax->pItem!=bx->pItem && ax->pItem->value->num==1 && bx->pItem->value->num==1;
                auto shared=std::make_shared<POV>(955);
                shared->pItem=declarations->pItem->value->items.head->pItem->funcArgs;
                auto changed=caseID==1 ? shared->pItem->fetchField("x") : ax;
                if(!changed) {n.close();return false;}
                n.addRHS(changed,parse("*10+3"));ha.waitForCompletion();hb.waitForCompletion();
                ok &= ha.status().failed;
                if(caseID==1) ok &= hb.status().failed;
                else ok &= !hb.status().failed && bx->pItem->value->num==1;
            }
        } else {
            // Direct read-only compilation isolates the evidence protocol
            // from normalization: no instance writes can explain these checks.
            ProteusDefinitions definitions(n.access);Work cost{0,0};
            auto declarations=parse(caseID==4 ? "{#base=*10+1}" : "{#alias=base:*10+1}");
            auto declaration=declarations->pItem->value->items.head;
            ok &= definitions.publish(declaration);
            auto body=definitions.lookup(caseID==4 ? "base" : "alias");
            auto old=definitions.describe(body,cost);
            if(!old) {n.close();return false;}
            ok &= definitions.current(old) && definitions.current(old);
            if(caseID==4) {
                body->pItem->value->num=2;definitions.prune();
                auto fresh=definitions.describe(body,cost);
                ok &= fresh && definitions.current(fresh) && !definitions.current(old) && definitions.current(fresh);
                // A registry relation is part of source evidence too.
                n.access->registry->recordIdentity(body,parse("*10+2"),iekAssertion,0);
                definitions.prune();ok &= !definitions.current(fresh);
            } else {
                std::set<DependencyKey> reads;
                {ReadScope capture([&](const DependencyKey& key){reads.insert(key);});ok &= definitions.current(old);}
                bool woke=false;
                auto wake=std::make_shared<Dependency::Wake>([&]{woke=true;});
                for(const auto& key:reads) key->subscribe(wake);
                ok &= !definitions.lookup("base") && !definitions.declared("base");
                auto added=parse("{#base=*10+1}");
                auto change=definitions.publishChanges(added->pItem->value->items.head);
                for(const auto& key:change.changes->keys) key->publish();
                ok &= woke && definitions.lookup("base") && definitions.declared("base") && !definitions.current(old);
                auto fresh=definitions.describe(body,cost);ok &= fresh && definitions.current(fresh);
                if(caseID==6) {
                    auto competing=parse("{#base=*10+2}");
                    ok &= definitions.publish(competing->pItem->value->items.head);
                    ok &= definitions.declared("base") && !definitions.lookup("base") && !definitions.current(fresh);
                }
            }
        }
        if(!ok) std::cout<<"Definition reuse case "<<caseID<<" failed\n";
        n.close();return ok;
    }%>
    void: unitTestGraphDefinitionReuse(me string: testName, me int: caseID) <- {
        me bool: passed <- graphDefinitionReuseCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHPROGRESS(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphProgress(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHPROGRESS(unit/graphProgress/listSixteen, 1)
    GRAPHPROGRESS(unit/graphProgress/listSixtyFour, 2)
    GRAPHPROGRESS(unit/graphProgress/embeddedExtent, 3)
    GRAPHPROGRESS(unit/graphProgress/scalarIntermediates, 4)
    GRAPHPROGRESS(unit/graphProgress/scalarConflict, 5)
    GRAPHPROGRESS(unit/graphProgress/partialIntermediates, 6)
    me bool: graphProgressCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer n;n.init();bool ok=true;
        if(caseID<=3) {
            const int count=caseID==1 ? 16 : caseID==2 ? 64 : 1;
            std::string text=caseID==3 ? "{" : "*"+std::to_string(count)+"+{";
            for(int i=0;i<count;++i) text+="*1+{wheel:*10+7}.wheel ";
            auto root=graphParsed(testName,text+"}");
            if(caseID==3) {
                auto expression=graphParsed(testName,"*1+{*4+{*10+1 *10+2 *10+3 *10+4}}@[1]");
                auto member=root->pItem->value->items.head;member->pItem=expression->pItem;
                SetModeBits(root->pItem->infSize->flags,infonState::evalMode,infonState::emUnknown);
                SetFlagBit(member->flags,POV::isSubItm,true);
                // Begin with a symbolic span extent. Its result publication
                // must invalidate the count, unlike an ordinary member value.
                n.runtime.update([&] {proteus4::PathExpression::prepare(*n.access,member);});
            }
            auto h=caseID==3 ? n.runtime.normalize({root,proteus4::sizeOnly,0}) : n.normalize(root);h.waitForCompletion();
            int members=0;
            for(const auto& step:h.steps())
                if(step.query.kind==proteus4::listMember && !step.query.context.empty() &&
                   step.query.context.back()==root) ++members;
            ok &= !h.status().failed && !h.status().symbolicValues;
            if(caseID<=2) {
                ok &= getFlagBit(root->pItem->flags,infonView::isNormed) && members==count && root->pItem->infSize->num==count;
                for(auto member=root->pItem->value->items.head;member;member=member->next)
                    ok &= member->pItem->value->num==7 && getFlagBit(member->pItem->flags,infonView::isNormed);
            } else ok &= members>=2 && root->pItem->infSize->num==4 &&
                root->pItem->value->items.head->pItem->infSize->num==4;
            std::cout<<"List progress: "<<count<<" positions, "<<members<<" visits, "<<h.status().error<<"\n";
            if(!ok) std::cout<<"  symbolic="<<h.status().symbolicValues<<" result="<<toString(root->pItem.get())<<"\n";
        } else {
            auto target=graphScalar(-1,-1);
            auto middle=graphScalar(caseID==5 ? 4 : -1,caseID==6 ? 10 : -1);
            auto source=graphScalar(7,caseID==6 ? -1 : 10);
            n.addRHS(target,middle);n.addRHS(middle,source);
            auto h=n.normalize(target);h.waitForCompletion();
            if(caseID==5) ok &= h.status().failed && middle->pItem->value->num==4 && source->pItem->value->num==7;
            else {
                ok &= !h.status().failed && !h.status().symbolicValues && target->pItem->value->num==7 &&
                    target->pItem->infSize->num==10 && middle->pItem->value->num==7 && middle->pItem->infSize->num==10;
                if(caseID==6) ok &= getModeBits(source->pItem->infSize->flags,infonState::evalMode)==infonState::emUnknown;
                else ok &= middle->pItem->wrkList.empty() && middle->pItem->hasRHS(source->pItem);
                auto again=n.normalize(middle);again.waitForCompletion();
                ok &= !again.status().failed && !again.status().symbolicValues;
                for(const auto& step:again.steps()) ok &= step.action!="Set requested size/value/type";
                // A later constraint is still checked through the retained
                // identity, even though the original RHS left pending work.
                n.addRHS(middle,graphScalar(8,10));
                auto conflict=n.normalize(target);conflict.waitForCompletion();ok &= conflict.status().failed;
            }
        }
        if(!ok) std::cout<<"Progress case "<<caseID<<" failed\n";
        n.close();return ok;
    }%>
    void: unitTestGraphProgress(me string: testName, me int: caseID) <- {
        me bool: passed <- graphProgressCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHDESCRIPTIVE(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphDescriptive(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHDESCRIPTIVE(unit/graphDescriptive/subset, 0)
    GRAPHDESCRIPTIVE(unit/graphDescriptive/choose, 1)
    GRAPHDESCRIPTIVE(unit/graphDescriptive/nominal, 2)
    GRAPHDESCRIPTIVE(unit/graphDescriptive/absent, 3)
    GRAPHDESCRIPTIVE(unit/graphDescriptive/nested, 4)
    GRAPHDESCRIPTIVE(unit/graphDescriptive/unrelatedUnknown, 5)
    GRAPHDESCRIPTIVE(unit/graphDescriptive/alias, 6)
    GRAPHDESCRIPTIVE(unit/graphDescriptive/repeatedType, 7)
    GRAPHDESCRIPTIVE(unit/graphDescriptive/namedValue, 8)
    GRAPHDESCRIPTIVE(unit/graphDescriptive/orderedNamedValue, 9)
    GRAPHDESCRIPTIVE(unit/graphDescriptive/resolveChoice, 10)
    GRAPHDESCRIPTIVE(unit/graphDescriptive/resolveChain, 11)
    GRAPHDESCRIPTIVE(unit/graphDescriptive/externalChoice, 12)
    GRAPHDESCRIPTIVE(unit/graphDescriptive/displayColor, 13)
    GRAPHDESCRIPTIVE(unit/graphDescriptive/lateDescription, 14)
    GRAPHDESCRIPTIVE(unit/graphDescriptive/modelPalette, 15)
    me bool: graphDescriptiveCase(me string: testName, me int: caseID) <- <%{
        using namespace proteus4;
        GraphNormalizer n;n.init();
        auto parse=[&](const std::string& text){return graphParsed(testName,text);};
        auto norm=[&](const POVNode& p){auto h=n.normalize(p);h.waitForCompletion();return h;};
        if(caseID==15) {
            bool successful=true;
            auto checked=[&](const POVNode& p) {auto h=norm(p);successful &= !h.status().failed;return h;};
            checked(parse("{#rat=*_+_}"));
            auto foundation=parse(readAssetAsString("public/Informatics/Foundation.pr"));checked(foundation);
            auto declarations=parse(readAssetAsString("public/Things/rubixCube.pr"));checked(declarations);
            auto unchanged=toString(declarations->pItem.get());
            auto root=parse("solved-rubix-state");auto h=checked(root);
            auto parts=n.knownField(root,"parts");if(parts) checked(parts);
            std::map<int,int> paints;int cubies=0,surfaces=0,unknown=0,invalid=0;
            for(auto group=parts ? POVDescription(parts).member() : POVNode{};group;group=group->next) {
                checked(group);
                for(auto cubie=POVDescription(group).member();cubie;cubie=cubie->next) {
                    ++cubies;checked(cubie);
                    auto sides=n.knownField(cubie,"sides");if(sides) checked(sides);
                    for(auto side=sides ? POVDescription(sides).member() : POVNode{};side;side=side->next) {
                        ++surfaces;checked(side);
                        auto color=n.knownField(side,"color");if(color) checked(color);
                        auto sat=n.knownField(color,"saturation"),bright=n.knownField(color,"brightness"),hue=n.knownField(color,"hue");
                        auto known=[&](const POVNode& at){return at && (n.access->known(at)&valueOnly);};
                        if(known(sat) && sat->pItem->value->num==0 && known(bright)) {
                            auto level=bright->pItem->value->num.val;level.canonicalize();
                            if(level==mpq_class(1,2)) ++paints[-1];
                            else if(level==1) ++paints[-2];
                            else ++invalid;
                        } else if(known(hue)) ++paints[hue->pItem->fetchInt()];
                        else ++unknown;
                    }
                }
            }
            // Gray references may remain unresolved while color modeling is
            // incomplete; the renderer displays those surfaces in pink. Every
            // outward sticker must still have its actual known model color.
            auto backing=paints[-1];paints.erase(-1);
            const std::map<int,int> expected={{-2,9},{0,9},{4,9},{30,9},{55,9},{110,9}};
            bool ok=successful && !invalid && cubies==26 && surfaces==156 && backing+unknown==102 && paints==expected &&
                toString(declarations->pItem.get())==unchanged;
            if(!ok) {
                std::cout<<"Model palette: cubies="<<cubies<<" surfaces="<<surfaces<<" unknown="<<unknown<<" error="<<h.status().error<<"\n";
                for(const auto& paint:paints) std::cout<<"paint "<<paint.first<<" count="<<paint.second<<"\n";
            }
            h.cancel();n.close();return ok;
        }
        if(caseID==14) {
            auto root=parse("*2+{part:{key:_,other:7},part:{key:2,other:8}}.part:{key:1,}");
            auto h=norm(root);auto state=root->pItem->pathSelection;
            auto member=state ? state->source->pItem->value->items.head : POVNode{};
            auto key=member ? member->pItem->fetchField("key") : POVNode{};
            bool ok=!h.status().failed && h.status().withSubscribers && state && state->pending && key;
            if(key) {n.addRHS(key,parse("1"));h.waitForCompletion();}
            ok &= !h.status().failed && state && !state->pending && state->matches.size()==1 && state->matches.front()==member;
            ok &= toString(root->pItem.get())=="part:{key:1, other:7}";
            if(!ok) std::cout<<"Late description: "<<toString(root->pItem.get())<<" error="<<h.status().error<<"\n";
            h.cancel();n.close();return ok;
        }
        if(caseID==13) {
            auto defs=parse("{#color={hue:_, saturation:_, brightness:_} #red=color:{hue:0} #front-color=color #gray=color:{saturation:0, brightness:0.5} #base-color=gray #side={color} #piece={front-color,base-color,*2+{side|{%.front-color}{%.base-color}}}} ");
            norm(defs);auto before=toString(defs->pItem.get());
            auto root=parse("piece:{front-color=red,}");auto h=norm(root);
            auto sides=n.knownField(root,"sides");if(sides) norm(sides);
            auto side=sides ? sides->pItem->value->items.head : POVNode{};if(side) norm(side);
            auto color=side ? n.knownField(side,"color") : POVNode{};if(color) norm(color);
            auto hue=color ? n.knownField(color,"hue") : POVNode{};
            bool ok=!h.status().failed && hue && hue->pItem->value->num==0 && before==toString(defs->pItem.get());
            auto closed=parse("*_+[{hue:0}]");auto ambiguous=parse("*_+[{hue:0} {hue:1}]");
            auto unfinished=parse("*_+[{hue:0} ...]");
            auto snapshot=toString(closed->pItem.get())+toString(ambiguous->pItem.get())+toString(unfinished->pItem.get());
            ok &= bool(n.knownField(closed,"hue")) && !n.knownField(ambiguous,"hue") && !n.knownField(unfinished,"hue");
            ok &= snapshot==toString(closed->pItem.get())+toString(ambiguous->pItem.get())+toString(unfinished->pItem.get());
            if(!ok) {
                std::cout<<"Display: "<<toString(root->pItem.get())<<" sides="<<bool(sides)<<" side="<<bool(side)<<" color="<<bool(color)<<" error="<<h.status().error<<"\n";
            }
            n.close();return ok;
        }
        struct Case {std::string definitions, expression, expected;};
        const std::vector<Case> cases={
            {"{}","{part:{key:1, other:7}}.part:{key:1,}","part:{key:1, other:7}"},
            {"{}","{part:{key:1, other:7}, part:{key:2, other:8}}.part:{key:2,}","*_+[part:{key:2, other:8} ... ]"},
            {"{}","{wheel:{key:1, other:7}}.pedal:{key:1,}","*_+[]"},
            {"{}","*2+{part:{key:1,},part:{key:2,}}.part:{key:3,}","*_+[]"},
            {"{}","{piece:{paint:{hue:0, saturation:1}, place:7}}.piece:{paint:{hue:0,},}","piece:{paint:{hue:0, saturation:1}, place:7}"},
            {"{}","{part:{key:1, other:?}}.part:{key:1,}","part:{key:1, other}"},
            {"{#component=part}","{component:{key:1, other:7}}.part:{key:1,}","component:{key:1, other:7}"},
            {"{#collection=*2+{part:{key:1},part:{key:2}}}","collection.part:{key:2,}.key","key:2"},
            {"{#hue=_ #color={hue,} #red=color:{hue:0} #front-color=color}","{front-color=red,}.front-color.hue","*_+[hue:0 ... ]"},
            {"{#hue=_ #color={hue,} #red=color:{hue:0} #front-color=color}","{front-color=red}.front-color.hue","*_+[hue:0 ... ]"},
            {"{}","*_+[{badge:1} {badge:2}]~badge","*_+[badge:1 badge:2]"},
            {"{}","{group:*2+{part:{key:1},part:{key:2}},}.group~part:{key:2,}","*_+[part:{key:2} ... ]"},
            {"{}","*_+[{marker:1}^badge=7; {badge:2}]~badge","*_+[badge:7 badge:2]"},
        };
        auto fixture=cases.at(caseID);auto defs=parse(fixture.definitions);norm(defs);
        auto before=toString(defs->pItem.get());auto root=parse(fixture.expression);auto h=norm(root);
        bool ok=!h.status().failed && toString(root->pItem.get())==fixture.expected && before==toString(defs->pItem.get());
        if(!ok) {
            std::cout<<"Descriptive "<<caseID<<": "<<toString(root->pItem.get())<<" expected="<<fixture.expected<<" error="<<h.status().error<<"\n";
            for(const auto& step:h.steps()) if(step.action!="visit") std::cout<<step.action<<" kind="<<step.query.kind<<"\n";
        }
        h.cancel();n.close();return ok;
    }%>
    void: unitTestGraphDescriptive(me string: testName, me int: caseID) <- {
        me string: actual <- "false"; me string: expected <- "true"
        if(graphDescriptiveCase(testName,caseID)){actual <- "true"}
        REQUIRE(actual==expected)
    }
}
