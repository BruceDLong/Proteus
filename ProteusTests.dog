//////////////////////////////////////////////////////////////
// Test functions need to do one of these 3:
//    parse&Extract                           |  call parseAndExtract()
//    InitCORE -> parse&Extract               |  init_manually then call testLine(..., false)  OR  call initAndTest(..., false)
//    InitCORE -> parse&Extract -> normalize  |  init_manually then call testLine(..., true)   OR  call initAndTest(..., true)

    me bool: dynamicTestsLoaded <- false
    me string: dynamicTestsFile <- ""
    me List<me string>: dynamicTestNames
    me Map<me string, me string>: dynamicTestDisplay
    me Map<me string, me string>: dynamicTestInput
    me Map<me string, me string>: dynamicTestExpected
    me Map<me string, me string>: dynamicTestMode
    me Map<me string, me InfonPrintMode>: dynamicTestPrintMode
    me Map<me string, me string>: dynamicTestWorldFile
    me Map<me string, me string>: dynamicTestIncludedFiles

    me string: decodeTestFileEscapes(me string: txt) <- {
        me string: decoded <- ""
        me bool: isEscaped <- false
        withEach pos in range 0 .. txt.size(){
            me char: ch <- txt[pos]
            if(!isEscaped){
                if(ch=="\\"){isEscaped <- true}
                else{decoded <+- ch}
            } else {
                if(ch=="n"){decoded <+- "\n"}
                else if(ch=="t"){decoded <+- "\t"}
                else if(ch=="r"){decoded <+- "\r"}
                else if(ch=="\\"){decoded <+- "\\"}
                else{decoded <+- ch}
                isEscaped <- false
            }
        }
        if(isEscaped){decoded <+- "\\"}
        return(decoded)
    }
    me void: splitTestFileLine(me string: line, their List<me string>: columns) <- {
        columns.clear()
        me string: column <- ""
        withEach pos in range 0 .. line.size(){
            if(line[pos]=="," and (pos==0 or line[pos-1]!="\\")){
                columns.append(column)
                column <- ""
            } else {column <+- line[pos]}
        }
        columns.append(column)
    }
    me string: trimTestFileLeadingPadding(me string: txt) <- {
        me int: start <- 0
        while(start<txt.size() and (txt[start]==" " or txt[start]=="\t")){start <+- 1}
        if(start==0){return(txt)}
        return(txt.subStr(start, txt.size()-start))
    }
    me void: clearDynamicTests() <- {
        dynamicTestNames.clear()
        dynamicTestDisplay.clear()
        dynamicTestInput.clear()
        dynamicTestExpected.clear()
        dynamicTestMode.clear()
        dynamicTestPrintMode.clear()
        dynamicTestWorldFile.clear()
        dynamicTestIncludedFiles.clear()
    }
    me bool: isDynamicTestIncludeLine(me string: trimmed) <- {
        if(trimmed.size()<8){return(false)}
        if(trimmed.subStr(0,8)!="@include"){return(false)}
        if(trimmed.size()==8){return(true)}
        return(trimmed[8]==" " or trimmed[8]=="\t")
    }
    me void: loadDynamicTestLine(me string: fileName, me int: lineNum, me string: lineIn) <- {
        me string: line <- lineIn
        if(line.size()>0 and line[line.size()-1]=="\r"){line <- line.subStr(0, line.size()-1)}
        me string: trimmed <- trimWS(line)
        if(trimmed==""){return()}
        if(trimmed[0]=="#"){return()}
        if(isDynamicTestIncludeLine(trimmed)){
            me string: includedFileName <- trimmed.subStr(8, trimmed.size()-8)
            includedFileName <- trimWS(includedFileName)
            if(includedFileName==""){
                print("Dynamic test parse error in ", fileName, ":", lineNum, " missing @include filename.\n")
            }else{
                loadDynamicTestFile(includedFileName)
            }
            return()
        }

        me List<me string>: columns
        splitTestFileLine(line, columns)
        if(columns.size()<4){
            print("Dynamic test parse error in ", fileName, ":", lineNum, " expected 4 comma-separated columns.\n")
            return()
        }

        me string: testName <- trimWS(columns[0])
        if(testName==""){
            print("Dynamic test parse error in ", fileName, ":", lineNum, " missing test name.\n")
            return()
        }
        if(dynamicTestInput.containsKey(testName)){
            print("Dynamic test parse error in ", fileName, ":", lineNum, " duplicate test name: ", testName, "\n")
            return()
        }

        me string: testMode <- "norm"
        if(columns.size()>=5){testMode <- trimWS(columns[4])}
        if(testMode==""){testMode <- "norm"}
        if(testMode!="norm" and testMode!="parse" and testMode!="multi" and testMode!="world" and testMode!="graph"){
            print("Dynamic test parse warning in ", fileName, ":", lineNum, " invalid mode '", testMode, "'. Using 'norm'.\n")
            testMode <- "norm"
        }

        // Optional seventh column selects result printing independently of
        // parse/norm/multi/world/graph. Existing fixtures default to compressed.
        me InfonPrintMode: printMode <- ipmCompressed
        if(columns.size()>=7){
            me string: printModeName <- trimWS(columns[6])
            if(printModeName=="debug"){printMode <- ipmDebug}
            else if(printModeName=="expanded"){printMode <- ipmExpanded}
            else if(printModeName!="" and printModeName!="compressed"){
                print("Dynamic test parse warning in ", fileName, ":", lineNum, " invalid print mode '", printModeName, "'. Using 'compressed'.\n")
            }
        }
        dynamicTestPrintMode[testName] <- printMode

        dynamicTestNames.append(testName)
        dynamicTestDisplay[testName] <- decodeTestFileEscapes(trimTestFileLeadingPadding(columns[1]))
        dynamicTestInput[testName] <- decodeTestFileEscapes(trimTestFileLeadingPadding(columns[2]))
        dynamicTestExpected[testName] <- decodeTestFileEscapes(trimTestFileLeadingPadding(columns[3]))
        dynamicTestMode[testName] <- testMode
        if(columns.size()>=6){dynamicTestWorldFile[testName] <- decodeTestFileEscapes(trimWS(columns[5]))}
        else{dynamicTestWorldFile[testName] <- ""}
    }
    me int: loadDynamicTestFile(me string: filename) <- {
        me string: fileName <- trimWS(filename)
        if(fileName==""){
            print("Dynamic test filename is empty.\n")
            return(0)
        }
        me bool: hasTestExt <- false
        if(fileName.size()>=4 and fileName.subStr(fileName.size()-4,4)==".tst"){hasTestExt <- true}
        if(!hasTestExt){fileName <+- ".tst"}

        // Prefer maintained fixtures over stale copies in the build directory.
        // Explicit relative or absolute paths keep their caller-selected meaning.
        me string: fileText <- ""
        if(findString(fileName, "/")==-1 and findString(fileName, "\\")==-1){
            me string: testsFileName <- "../Tests/"+fileName
            fileText <- readFileAsString(testsFileName)
            if(fileText!=""){fileName <- testsFileName}
        }
        if(fileText==""){fileText <- readFileAsString(fileName)}
        if(fileText=="" and findString(fileName, "/")==-1 and findString(fileName, "\\")==-1){
            me string: parentFileName <- "../"+fileName
            me string: parentText <- readFileAsString(parentFileName)
            if(parentText!=""){
                fileName <- parentFileName
                fileText <- parentText
            }
        }
        if(dynamicTestIncludedFiles.containsKey(fileName)){return(0)}
        dynamicTestIncludedFiles[fileName] <- "1"

        if(fileText==""){
            print("Dynamic test file is empty or unreadable: ", fileName, "\n")
            return(0)
        }

        me string: line <- ""
        me int: lineNum <- 1
        withEach charPos in range 0 .. fileText.size(){
            if(fileText[charPos]=="\n"){
                loadDynamicTestLine(fileName, lineNum, line)
                line <- ""
                lineNum <+- 1
            }else{line <+- fileText[charPos]}
        }
        if(line!=""){loadDynamicTestLine(fileName, lineNum, line)}
        return(dynamicTestNames.size())
    }
    me int: loadTestSpec(me string: filename) <- {
        me string: fileName <- trimWS(filename)
        if(fileName==""){
            print("Dynamic test filename is empty.\n")
            return(0)
        }
        me bool: hasTestExt <- false
        if(fileName.size()>=4 and fileName.subStr(fileName.size()-4,4)==".tst"){hasTestExt <- true}
        if(!hasTestExt){fileName <+- ".tst"}

        if(dynamicTestsLoaded and dynamicTestsFile==fileName){return(dynamicTestNames.size())}

        clearDynamicTests()
        dynamicTestsLoaded <- true
        dynamicTestsFile <- fileName
        loadDynamicTestFile(fileName)
        return(dynamicTestNames.size())
    }
    me bool: matchesDynamicSelector(me string: testName, me string: selector) <- {
        if(selector==""){return(true)}
        me int: selSize <- selector.size()
        if(selSize<=0){return(true)}
        if(selector[selSize-1]=="/"){
            if(testName.size()<selSize){return(false)}
            return(testName.subStr(0, selSize)==selector)
        }
        if(testName==selector){return(true)}
        if(testName.size()<=selSize){return(false)}
        if(testName.subStr(0, selSize)!=selector){return(false)}
        return(testName[selSize]=="/")
    }
    me int: appendDynamicTestsMatching(me string: selector, their List<me string>: outList) <- {
        me int: numMatches <- 0
        withEach testName in dynamicTestNames{
            if(matchesDynamicSelector(testName, selector)){
                outList.append(testName)
                numMatches <+- 1
            }
        }
        return(numMatches)
    }
    me bool: hasDynamicTest(me string: testName) <- {
        return(dynamicTestInput.containsKey(testName))
    }
    me void: executeDynamicTest(me string: testName) <- {
        if(!hasDynamicTest(testName)){Tstat <- "?"; return()}
        me string: testMode <- "norm"
        if(dynamicTestMode.containsKey(testName)){testMode <- dynamicTestMode[testName]}
        me InfonPrintMode: printMode <- dynamicTestPrintMode[testName]
        me string: testInput <- dynamicTestInput[testName]
        me string: testExpected <- dynamicTestExpected[testName]
        if((testMode=="multi" or testMode=="world") and testExpected!="" and testExpected!="-" and findString(testInput, "//:")==-1){
            testInput <+- "//:"+testExpected
        }
        if(testMode=="graph"){
            testGraphLanguage(testName, testInput, testExpected, printMode)
            return()
        }
        if(testMode=="multi"){
            multiNorm(testName, testInput, "", printMode)
            return()
        }
        if(testMode=="world"){
            multiNorm(testName, testInput, dynamicTestWorldFile[testName], printMode)
            return()
        }
        me bool: doNorm <- true
        if(testMode=="parse"){doNorm <- false}
        initAndTest(testName, testInput, testExpected, doNorm, printMode)
    }

    our infonView: parseAndExtract(me string: testName, me string: data) <- {
        // InitParser -> parse -> extract
        me ProteusParser: parser{NULL, false, 0}
        parser.initParseFromString(testName, data)
        our infonView:: parsedInfon
        parser.doParse(parsedInfon)
        if(parser.doesParseHaveError()){return(NULL)}
        return(parsedInfon)
    }
    me void: testParseError(me string: testName, me string: in, me string: expectedMsg, me int64: expectedLine, me int64: expectedChar) <- {
        me ProteusParser: parser{NULL, false, 0}
        parser.initParseFromString(testName, in)
        our infonView:: parsedInfon
        parser.doParse(parsedInfon)
        me int: msgPos <- findString(parser.errorMesg, expectedMsg)
        me string: formatted <- parser.formattedError()
        me string: locSpec <- ":"+toString(expectedLine)+":"+toString(expectedChar)+":"
        me int: locPos <- findString(formatted, locSpec)
        if(!parser.doesParseHaveError()){FAIL("Expected parser to report an error")}
        if(msgPos == -1){FAIL("Expected parser error text to include the requested explanation")}
        if(parser.errLineNum != expectedLine){FAIL("Parser error line number did not match")}
        if(parser.errCharPos != expectedChar){FAIL("Parser error column number did not match")}
        if(locPos == -1){FAIL("Formatted parser error did not include the expected location")}
        return()
    }
    me void: testLine(me string: testName, our Agent: agent, me string: in, me string: expected, me bool: doNorm, me InfonPrintMode: printMode<-ipmCompressed) <- {
        our infonView: testInfon <- parseAndExtract(testName, in)
        if(testInfon==NULL){FAIL("Syntax Error in input: "+in)}
        our POV:: testPov{501}; testPov!.pItem <- testInfon
        if(doNorm){
            our WorldRequest: handle <- agent!.normalize(testPov)
            handle!.waitForCompletion()
            me WorldStatus: state <- handle!.status()
            if(state.outcome==worldUnsupported){FAIL("UNSUPPORTED: "+state.detail)}
            if(state.outcome==worldError){FAIL("ENGINE_ERROR: "+state.detail)}
            if(state.outcome==worldWaiting or state.outcome==worldReady or state.outcome==worldCancelled){
                FAIL("UNSETTLED: "+state.detail)
            }
            if(expected=="<REJECTED>"){
                if(state.outcome!=worldRejected){FAIL("Expected semantic rejection")}
                return()
            }
        }
        me string: result <- toString(testPov!.pItem, printMode)
        if(expected!=""){REQUIRE(result==expected)}
    }
    // Historical graph-mode language fixtures use the same engine entry point.
    me void: testGraphLanguage(me string: testName, me string: input, me string: expected, me InfonPrintMode: printMode<-ipmCompressed) <- {
        initAndTest(testName, input, expected, true, printMode)
    }
    me void: initAndTest(me string: testName, me string: in, me string: expected, me bool: doNorm, me InfonPrintMode: printMode<-ipmCompressed) <- {
        me ProteusCore: CORE
        CORE.init("", false)
        testLine(testName, CORE.agent, in, expected, doNorm, printMode)
        CORE.deInit()
        return()
    }
    me void: unitTestGETFIRST(me string: testName, me string: in, me string: expected, me int64: skipDots) <- {
        me string: result
        our infonView: testVector <- parseAndExtract(testName, in)
        our POV:: testPOV{502}
        testPOV!.pItem <- testVector
        our POV: resultPOV <- testPOV!.getFirst(skipDots, NULL)
        if(resultPOV == NULL){result <- "NULL"}
        else{result <- toString(resultPOV!.pItem)}
        REQUIRE(result==expected)
        return()
    }
    me void: unitTestGETFIRSTTIGHT(me string: testName, me string: in, me string: expected, me int64: skipDots) <- {
        me string: result
        our infonView: testVector <- parseAndExtract(testName, in)
        our POV:: testPOV{503}
        testPOV!.pItem <- testVector
        our infItr:: ii
        ii!.topPOV <- testPOV
        me int64: numLvlsUp
        our POV: resultPOV <- testPOV!.getFirstTight(ii, skipDots, numLvlsUp, NULL, NULL)
        if(resultPOV == NULL){result <- "NULL"}
        else{result <- toString(resultPOV!.pItem)}
        REQUIRE(result==expected)
        return()
    }
    me void: unitTestStreamLoaderSpec(me string: testName, me int64: caseID) <- {
        me bool: correct <- false
        if(caseID==1){
            our InfonStreamSpec:: SP
            SP.setSpec("agnt://[::1]:2006/Things/Things.pr")
            correct <-
                    SP.protocolTag=="agnt" and
                    SP.connectArgs=="[::1]:2006" and
                    SP.contentArgs=="Things/Things.pr" and
                    SP.ipAddr=="::1" and
                    SP.portNum=="2006"
        } else if(caseID==2){
            me InfonStreamLoader: loader
            correct <-
                    loader.resolveStreamSpec("/Informatics/Informatics.pr", "file:///public/")==
                            "file:///public/Informatics/Informatics.pr" and
                    loader.resolveStreamSpec("EnglishWords.pr", "file:///public/Languages/English/")==
                            "file:///public/Languages/English/EnglishWords.pr" and
                    loader.resolveStreamSpec("file:///public/PublicKB.pr", "file:///ignored/")==
                            "file:///public/PublicKB.pr"
        }
        me string: actual <- "false"
        if(correct){actual <- "true"}
        me string: expected <- "true"
        REQUIRE(actual==expected)
        return()
    }
    me void: unitTestGETNEXT(me string: testName, me string: in, me string: expected, me int64: skipDots) <- {
        me string: result <- "{"
        our infonView: testVector <- parseAndExtract(testName, in)
        our POV:: testPOV{504}
        testPOV!.pItem <- testVector
        our POV: CP  <- testPOV!.getFirst(skipDots, NULL)
        me int: count <- 0
        while(CP != NULL ){
            if(count > 6){result <- result + " Infinite Loop"; break()}
            if(CP == NULL){result <+- "NULL "}
            else{result <+- toString(CP!.pItem)+ " "}
            CP <- CP!.getNext(skipDots, NULL)
            count <+- 1
        }
        result <+- "}"
        REQUIRE(result==expected)
        return()
    }
    me void: unitTestGETNEXTTIGHT(me string: testName, me string: in, me string: expected, me int64: skipDots) <- {
        me string: result <- "{"
        our infonView: testVector <- parseAndExtract(testName, in)
        our POV:: testPOV{505}
        testPOV!.pItem <- testVector
        our infItr:: ii
        ii!.topPOV <- testPOV
        me int64: numLvlsUp
        our POV: CP  <- testPOV!.getNextTight(ii, skipDots, numLvlsUp, false, true, NULL, NULL)
        me int: count <- 0
        while(CP != NULL ){
            if(count > 6){result <- result + " Infinite Loop"; break()}
            if(CP == NULL){result <+- "NULL "}
            else{result <+- toString(CP!.pItem)+ " "}
            CP <- CP!.getNextTight(ii, skipDots, numLvlsUp, false, false, NULL, NULL)
            count <+- 1
        }
        result <+- "}"
        REQUIRE(result==expected)
        return()
    }
    me void: unitTestEndRelativeResolveOnClose(me string: testName) <- {
        our infonView: source <- parseAndExtract(testName, "{'Cat' 'Hat' ...}")
        our IdentityRegistry:: identityRegistry
        our POV:: sourcePOV{povSrcEndRelativeReference}
        sourcePOV!.pItem <- source
        sourcePOV!.bindIdentityRegistry(identityRegistry)
        our POV: pendingLast <- sourcePOV!.getEndRelativePOV(-1)
        our POV: samePendingLast <- sourcePOV!.getEndRelativePOV(-1)
        our infonView: pendingValue <- parseAndExtract(testName, "'Dog'")
        pendingLast!.pItem <- pendingValue

        our infonView: finalItem <- parseAndExtract(testName, "'Dog'")
        our POV: finalPOV <- source!.value!.items.append(finalItem, false, povSrcEndRelativeReference)
        source!.value!.tailUnfinished <- false
        source!.countSize(false)

        our EndRelativeReference: reference <-
                sourcePOV!.findEndRelativeReferenceRecord(-1)
        me bool: referenceWasRegistered <- reference!=NULL and
                reference!.referencePOV===pendingLast and
                samePendingLast===pendingLast and
                identityRegistry!.endRelativeReferences.size()==1 and
                source!.retainedPOVs.isEmpty()
        me bool: sourceUsesPendingSlot <- finalPOV!.pItem===pendingLast!.pItem
        me bool: finalItemIsAConstraint <- pendingLast!.pItem!.workListContainsInfonView(finalItem)
        me bool: resolvedCorrectly <- pendingLast!.endRelativeResolved and
                referenceWasRegistered and sourceUsesPendingSlot and
                finalItemIsAConstraint and reference!.resolvedPOV===finalPOV and
                reference!.identityRelation!=NULL and
                reference!.identityRelation!.evidenceKind==
                        iekEndRelativeResolution and
                identityRegistry!.areIdentical(pendingLast, finalPOV) and
                identityRegistry!.areIdentical(finalPOV, pendingLast)

        our infonView: hugeSource <- parseAndExtract(testName,
                "*1000000000+{second| ...}")
        our IdentityRegistry:: hugeRegistry
        our POV:: hugeSourcePOV{povSrcEndRelativeReference}
        hugeSourcePOV!.pItem <- hugeSource
        hugeSourcePOV!.bindIdentityRegistry(hugeRegistry)
        our POV: hugeLast <- hugeSourcePOV!.getEndRelativePOV(-1)
        our EndRelativeReference: hugeReference <-
                hugeSourcePOV!.findEndRelativeReferenceRecord(-1)
        me bool: sparseReferenceStayedSparse <- hugeLast!=NULL and
                hugeReference!=NULL and hugeLast!.endRelativeResolved and
                hugeSource!.value!.items.isEmpty() and
                hugeRegistry!.endRelativeReferences.size()==1 and
                hugeRegistry!.repetitionFamilies.size()==1 and
                hugeRegistry!.repetitionFamilies.first()!.
                        occurrences.size()==1 and
                hugeReference!.resolvedPOV!=NULL and
                hugeReference!.resolvedPOV!.repetitionOccurrence!=NULL and
                hugeReference!.resolvedPOV!.repetitionOccurrence!.
                        ordinal==999999999 and
                hugeReference!.identityRelation!=NULL and
                hugeRegistry!.areIdentical(
                        hugeLast, hugeReference!.resolvedPOV)
        me string: result <- "false"
        me string: expected <- "true"
        if(resolvedCorrectly and sparseReferenceStayedSparse){
            result <- "true"
        }
        REQUIRE(result==expected)
        return()
    }
    me void: unitTestEndRelativeQuery(me string: testName, me int: caseID) <- {
        me bool: passed <- false
        if(caseID==1){
            our infonView: source <- parseAndExtract(testName, "{1 2 3 4}")
            our POV:: sourcePOV{povSrcEndRelativeView}
            sourcePOV!.pItem <- source
            me EndRelativeExtentResult: extent <- source!.endRelativeExtent()
            me EndRelativeWindowAvailability: window <-
                    sourcePOV!.endRelativeWindowAvailability(-2, 2)
            passed <- extent.status==eresExact and extent.exactExtent==4 and
                      window.status==erwcAvailable and
                      window.extent.status==eresExact and
                      window.startIndex==2 and window.itemCount==2 and
                      window.firstSourcePOV!=NULL and
                      window.firstSourcePOV!.pItem!.value!.num.convertToInt()==3 and
                      window.lastSourcePOV!=NULL and
                      window.lastSourcePOV!.pItem!.value!.num.convertToInt()==4
        }else if(caseID==2){
            our infonView: source <- parseAndExtract(testName, "*4+{...}")
            our POV:: sourcePOV{povSrcEndRelativeView}
            sourcePOV!.pItem <- source
            me EndRelativeWindowAvailability: window <-
                    sourcePOV!.endRelativeWindowAvailability(-1, 1)
            passed <- window.extent.status==eresExact and
                      window.extent.exactExtent==4 and
                      window.status==erwcPending and window.startIndex==3 and
                      window.firstSourcePOV==NULL
        }else if(caseID==3){
            our infonView: source <- parseAndExtract(testName, "{1 2 ...}")
            our POV:: sourcePOV{povSrcEndRelativeView}
            sourcePOV!.pItem <- source
            me EndRelativeExtentResult: extent <- source!.endRelativeExtent()
            me EndRelativeWindowAvailability: window <-
                    sourcePOV!.endRelativeWindowAvailability(-1, 1)
            passed <- extent.status==eresUnknownOrUnbounded and
                      window.extent.status==eresUnknownOrUnbounded and
                      window.status==erwcPending and window.startIndex==-1
        }else if(caseID==4){
            our infonView: source <- parseAndExtract(testName, "5")
            our POV:: sourcePOV{povSrcEndRelativeView}
            sourcePOV!.pItem <- source
            me EndRelativeExtentResult: extent <- source!.endRelativeExtent()
            me EndRelativeWindowAvailability: window <-
                    sourcePOV!.endRelativeWindowAvailability(-1, 1)
            passed <- extent.status==eresIncompatible and
                      window.extent.status==eresIncompatible and
                      window.status==erwcIncompatible
        }else if(caseID==5){
            our infonView: source <- parseAndExtract(testName, "{1 2 3}")
            our POV:: sourcePOV{povSrcEndRelativeView}
            sourcePOV!.pItem <- source
            me EndRelativeWindowAvailability: window <-
                    sourcePOV!.endRelativeWindowAvailability(-4, 4)
            passed <- window.extent.status==eresExact and
                      window.extent.exactExtent==3 and
                      window.status==erwcOutOfRange and window.startIndex==-1
        }else if(caseID==6){
            our infonView: source <- parseAndExtract(testName, "{1 2 3 4}")
            our POV:: sourcePOV{povSrcEndRelativeView}
            sourcePOV!.pItem <- source
            our POV: derivedPOV <- sourcePOV!.makeEndRelativeSpanView(
                    sourcePOV, -2, povSrcEndRelativeView)
            our infonView: fifth <- parseAndExtract(testName, "5")
            fifth!.itmMode <- mItem
            source!.value!.items.append(
                    fifth, false, povSrcEndRelativeView)
            source!.value!.sizeMode <- fromCount
            source!.infSize!.evalMode <- emUnknown
            source!.countSize(false)
            me EndRelativeWindowAvailability: derivedWindow
            me EndRelativeWindowAvailability: sourceWindow
            if(derivedPOV!=NULL){
                derivedWindow <- derivedPOV!.endRelativeWindowAvailability(-1, 1)
            }
            sourceWindow <- sourcePOV!.endRelativeWindowAvailability(-1, 1)
            passed <- derivedPOV!=NULL and
                      derivedWindow.extent.status==eresExact and
                      derivedWindow.extent.exactExtent==2 and
                      derivedWindow.status==erwcAvailable and
                      derivedWindow.firstSourcePOV!.pItem!.value!.num.convertToInt()==4 and
                      sourceWindow.extent.exactExtent==5 and
                      sourceWindow.firstSourcePOV!.pItem!.value!.num.convertToInt()==5
        }

        me string: result <- "false"
        me string: expected <- "true"
        if(passed){result <- "true"}
        REQUIRE(result==expected)
        return()
    }
    me void: unitTestExternalAssociation(me string: testName) <- {
        our IdentityRegistry:: registry
        our infonView: anchor <- parseAndExtract(
                testName, "human:{marker:1}")
        our infonView: predicate <- parseAndExtract(
                testName, "name={spelling='Morgan'}")
        our infonView: value <- parseAndExtract(
                testName, "name:{spelling:'Morgan'}")
        our POV:: anchorPOV{povSrcExternalAssociation}
        our POV:: predicatePOV{povSrcExternalAssociation}
        our POV:: valuePOV{povSrcExternalAssociation}
        anchorPOV!.pItem <- anchor
        predicatePOV!.pItem <- predicate
        valuePOV!.pItem <- value
        anchorPOV!.bindIdentityRegistry(registry)
        predicatePOV!.bindIdentityRegistry(registry)
        valuePOV!.bindIdentityRegistry(registry)

        our ExternalAssociationReference: reference <-
                registry!.recordExternalAssociation(
                        anchorPOV, predicatePOV, valuePOV,
                        NULL, "name", 71)
        our ExternalAssociationReference: duplicate <-
                registry!.recordExternalAssociation(
                        anchorPOV, predicatePOV, valuePOV,
                        NULL, "name", 71)
        me List<our ExternalAssociationReference>: anchorMatches
        me List<our ExternalAssociationReference>: relationMatches
        registry!.collectExternalAssociationsForAnchor(
                anchorPOV, "name", anchorMatches)
        registry!.collectExternalAssociationsForRelation(
                "name", relationMatches)

        // An equal-looking occurrence is not the same occurrence.  An
        // explicitly recorded alias is, and must support inverse lookup.
        our infonView: separateAnchor <- parseAndExtract(
                testName, "human:{marker:1}")
        our POV:: separateAnchorPOV{povSrcExternalAssociation}
        separateAnchorPOV!.pItem <- separateAnchor
        separateAnchorPOV!.bindIdentityRegistry(registry)
        me List<our ExternalAssociationReference>: separateMatches
        registry!.collectExternalAssociationsForAnchor(
                separateAnchorPOV, "name", separateMatches)
        registry!.recordIdentity(anchorPOV, separateAnchorPOV,
                iekContextReference, 72)
        me List<our ExternalAssociationReference>: aliasMatches
        registry!.collectExternalAssociationsForAnchor(
                separateAnchorPOV, "name", aliasMatches)

        me AgentContext: context
        context.init(registry)
        our POV: contextPOV <- context.addContextPOV(
                anchorPOV, registry)
        our POV: repeatedContextPOV <- context.addContextPOV(
                separateAnchorPOV, registry)

        me bool: passed <- reference!=NULL and
                duplicate===reference and
                reference!.anchorPOV===anchorPOV and
                reference!.predicatePOV===predicatePOV and
                reference!.valuePOV===valuePOV and
                reference!.relationTypeID=="name" and
                reference!.normalizationID==71 and
                anchorMatches.size()==1 and
                anchorMatches.first()===reference and
                relationMatches.size()==1 and
                relationMatches.first()===reference and
                separateMatches.isEmpty() and
                aliasMatches.size()==1 and
                aliasMatches.first()===reference and
                !registry!.areIdentical(anchorPOV, valuePOV) and
                contextPOV!=NULL and
                repeatedContextPOV===contextPOV and
                context.containsOccurrence(anchorPOV, registry) and
                context.containsOccurrence(
                        separateAnchorPOV, registry) and
                registry!.areIdentical(contextPOV, anchorPOV)
        me string: actual <- "false"
        me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
        modelMngr.clear()
        return()
    }
    me void: unitTestWordRuleCost(me string: testName) <- {
        me WordResolutionPlan: plan
        Allocate(plan.source)
        Allocate(plan.descriptor)
        plan.source!.estimatedDefinitionCount <- 2
        plan.descriptor!.estimatedDefinitionCount <- 3
        plan.estimate(5, 10, 4, true)

        me bool: passed <-
                plan.state==wrsEstimated and
                plan.cost.interpretationPairCount==6 and
                plan.cost.definitionExpansionCost==5 and
                plan.cost.directMemberCost==30 and
                plan.cost.sourceExternalCost==6 and
                plan.cost.typedPropertyCost==60 and
                plan.cost.anyPropertyCost==84 and
                plan.cost.lowerBound==41 and
                plan.cost.upperBoundKnown and
                plan.cost.upperBound==185 and
                plan.openedBranches.isEmpty() and
                plan.candidates.isEmpty()
        me string: actual <- "false"
        me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
        return()
    }

    me void: unitTestSelectionReference(
            me string: testName, me int: caseID) <- {
        me ProteusCore: CORE
        CORE.init("", false)
        me string: expression <- "{a:1, b:2}.b"
        me SelectionReferenceKind: expectedKind <- srkPartPathSelection
        if(caseID==2){
            expression <- "{a:1 b:2}.b"
            expectedKind <- srkIntersectionCorrespondence
        }
        our infonView: result <- parseAndExtract(
                testName, expression)
        our POV:: resultPOV{povSrcPartPathSelection}
        resultPOV!.pItem <- result
        CORE.agent!.normalizeAndWait(resultPOV)

        our SelectionReference: registeredReference
        me int: partPathReferenceCount <- 0
        withEach reference in
                CORE.agent!.identityRegistry!.selectionReferences{
            if(reference!.referenceKind==expectedKind){
                partPathReferenceCount <+- 1
                if(reference!.sourceStartPOV!=NULL and
                        reference!.sourceStartPOV!.pItem!=NULL and
                        reference!.sourceStartPOV!.pItem!.type!=NULL and
                        reference!.sourceStartPOV!.pItem!.
                                type!.typeID()=="b" and
                        reference!.sourceStartPOV!.pItem!.
                                value!.overlayType==NUM and
                        reference!.sourceStartPOV!.pItem!.
                                value!.num.convertToInt()==2 and
                        reference!.resultPOV!=NULL and
                        reference!.resultPOV!.pItem===resultPOV!.pItem){
                    registeredReference <- reference
                }
            }
        }
        me List<our SelectionReference>: queryReferences
        me List<our SelectionReference>: resultReferences
        me List<our SelectionReference>: sourceReferences
        if(registeredReference!=NULL){
            CORE.agent!.identityRegistry!.
                    collectSelectionReferencesForQuery(
                            registeredReference!.queryPOV,
                            queryReferences)
            CORE.agent!.identityRegistry!.
                    collectSelectionReferencesForResult(
                            registeredReference!.resultPOV,
                            resultReferences)
            CORE.agent!.identityRegistry!.
                    collectSelectionReferencesForSource(
                            registeredReference!.sourceContextPOV,
                            registeredReference!.sourceStartPOV,
                            sourceReferences)
        }
        me bool: sourceIncludesRegistered <- false
        withEach sourceReference in sourceReferences{
            if(sourceReference===registeredReference){
                sourceIncludesRegistered <- true
                break()
            }
        }

        me bool: passed <- registeredReference!=NULL and
                partPathReferenceCount>=1 and
                queryReferences.size()==1 and
                queryReferences.first()===registeredReference and
                resultReferences.size()==1 and
                resultReferences.first()===registeredReference and
                sourceIncludesRegistered and
                CORE.agent!.identityRegistry!.identities.isEmpty() and
                registeredReference!.queryPOV!=NULL and
                registeredReference!.queryPOV!.pItem!=NULL and
                registeredReference!.queryPOV!.pItem!.type!=NULL and
                registeredReference!.queryPOV!.pItem!.type!.typeID()=="b" and
                registeredReference!.resultPOV!=NULL and
                registeredReference!.resultPOV!.pItem===resultPOV!.pItem and
                registeredReference!.sourceContextPOV!=NULL and
                registeredReference!.sourceContextPOV!.pItem!=NULL and
                registeredReference!.sourceContextPOV!.pItem!.value!.
                        overlayType==LST and
                registeredReference!.sourceStartPOV!=NULL and
                registeredReference!.sourceStartPOV!.pItem!=NULL and
                registeredReference!.sourceStartPOV!.pItem!.type!=NULL and
                registeredReference!.sourceStartPOV!.pItem!.
                        type!.typeID()=="b" and
                registeredReference!.sourceStartPOV!.pItem!.
                        value!.num.convertToInt()==2 and
                resultPOV!.pItem!.type!=NULL and
                resultPOV!.pItem!.type!.typeID()=="b" and
                resultPOV!.pItem!.value!.num.convertToInt()==2
        if(caseID==1){
            passed <- passed and
                    registeredReference!.resultPOV===resultPOV and
                    registeredReference!.sourceStartPOV!.pItem===
                            resultPOV!.pItem
        }
        me string: actual <- "false"
        me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
        modelMngr.clear()
        return()
    }
    me void: unitTestSelectionResolution(
            me string: testName, me int: caseID) <- {
        me bool: passed <- false
        if(caseID==2){
            our IdentityRegistry:: registry
            our infonView: source <- parseAndExtract(
                    testName, "{7 7}")
            our POV:: sourcePOV{povSrcPartPathSelection}
            sourcePOV!.pItem <- source
            sourcePOV!.bindIdentityRegistry(registry)
            our POV: firstSource <- source!.value!.items.head
            our POV: secondSource <- source!.value!.items.tail
            our infonView: query <- parseAndExtract(testName, "_")
            our POV:: queryPOV{povSrcPartPathSelection}
            queryPOV!.pItem <- query
            queryPOV!.bindIdentityRegistry(registry)
            our infonView: result <- parseAndExtract(testName, "7")
            our POV:: resultPOV{povSrcPartPathSelection}
            resultPOV!.pItem <- result
            resultPOV!.bindIdentityRegistry(registry)
            our SelectionRequest: request <- registry!.
                    getOrCreateSelectionRequest(
                            queryPOV, resultPOV, sourcePOV,
                            srkIntersectionCorrespondence, 1)
            our SelectionReference: firstReference <- registry!.
                    recordSelectionReferenceForRequest(
                            request, resultPOV, firstSource)
            our SelectionReference: secondReference <- registry!.
                    recordSelectionReferenceForRequest(
                            request, resultPOV, secondSource)
            our SelectionResolution: requestResolution <-
                    registry!.resolveSelectionRequest(request!.requestID)
            our SelectionResolution: queryResolution <-
                    registry!.resolveSelectionForQuery(
                            queryPOV, srkIntersectionCorrespondence)
            our SelectionResolution: resultResolution <-
                    registry!.resolveSelectionForResult(resultPOV)
            our SelectionResolution: firstSourceResolution <-
                    registry!.resolveSelectionForSource(
                            sourcePOV, firstSource)
            passed <- firstSource!=NULL and secondSource!=NULL and
                    firstSource!.pItem!==secondSource!.pItem and
                    toString(firstSource!.pItem)==
                            toString(secondSource!.pItem) and
                    firstReference!=NULL and secondReference!=NULL and
                    firstReference!.occurrenceToken!=
                            secondReference!.occurrenceToken and
                    request!.resolutionState==srsMultiple and
                    requestResolution!.resolutionState==srsMultiple and
                    requestResolution!.references.size()==2 and
                    queryResolution!.resolutionState==srsMultiple and
                    resultResolution!.resolutionState==srsMultiple and
                    firstSourceResolution!.resolutionState==srsUnique and
                    firstSourceResolution!.references.size()==1
            modelMngr.clear()
        }else if(caseID==3){
            our IdentityRegistry:: registry
            our infonView: source <- parseAndExtract(testName, "{7}")
            our POV:: sourcePOV{povSrcPartPathSelection}
            sourcePOV!.pItem <- source
            sourcePOV!.bindIdentityRegistry(registry)
            our POV: sourceStart <- source!.value!.items.head
            our infonView: firstQuery <- parseAndExtract(testName, "_")
            our infonView: secondQuery <- parseAndExtract(testName, "_")
            our infonView: firstResult <- parseAndExtract(testName, "7")
            our infonView: secondResult <- parseAndExtract(testName, "7")
            our POV:: firstQueryPOV{povSrcPartPathSelection}
            our POV:: secondQueryPOV{povSrcPartPathSelection}
            our POV:: firstResultPOV{povSrcPartPathSelection}
            our POV:: secondResultPOV{povSrcPartPathSelection}
            firstQueryPOV!.pItem <- firstQuery
            secondQueryPOV!.pItem <- secondQuery
            firstResultPOV!.pItem <- firstResult
            secondResultPOV!.pItem <- secondResult
            registry!.recordSelectionReference(
                    firstQueryPOV, firstResultPOV,
                    sourcePOV, sourceStart,
                    srkIntersectionCorrespondence, 1)
            registry!.recordSelectionReference(
                    secondQueryPOV, secondResultPOV,
                    sourcePOV, sourceStart,
                    srkIntersectionCorrespondence, 1)
            our SelectionResolution: inverse <-
                    registry!.resolveSelectionForSource(
                            sourcePOV, sourceStart)
            passed <- inverse!.resolutionState==srsMultiple and
                    inverse!.references.size()==2 and
                    inverse!.references.first()!.queryPOV!==
                            inverse!.references.last()!.queryPOV and
                    inverse!.references.first()!.resultPOV!==
                            inverse!.references.last()!.resultPOV
            modelMngr.clear()
        }else if(caseID==4){
            me ProteusCore: CORE
            CORE.init("", false)
            our infonView: result <- parseAndExtract(
                    testName, "{a:1 b:2}.b")
            our POV:: resultPOV{povSrcPartPathSelection}
            resultPOV!.pItem <- result
            CORE.agent!.normalizeAndWait(resultPOV)
            our SelectionRequest: partRequest
            withEach request in
                    CORE.agent!.identityRegistry!.selectionRequests{
                if(request!.referenceKind==srkPartPathSelection and
                        request!.consumerResultPOV===resultPOV){
                    partRequest <- request
                    break()
                }
            }
            our SelectionResolution: resolution
            if(partRequest!=NULL){
                resolution <- CORE.agent!.identityRegistry!.
                        resolveSelectionRequest(partRequest!.requestID)
            }
            passed <- partRequest!=NULL and resolution!=NULL and
                    resolution!.resolutionState==srsUnique and
                    resolution!.references.size()==1 and
                    resolution!.references.first()!.queryPOV===
                            partRequest!.queryPOV and
                    resolution!.references.first()!.resultPOV===resultPOV and
                    resolution!.references.first()!.sourceStartPOV!=NULL and
                    resolution!.references.first()!.sourceStartPOV!.pItem!.
                            type!.typeID()=="b" and
                    resultPOV!.pItem!.value!.num.convertToInt()==2
            modelMngr.clear()
        }else{
            our IdentityRegistry:: registry
            our infonView: source <- parseAndExtract(
                    testName, "{{a:1} {a:2}}")
            our POV:: sourcePOV{povSrcPartPathSelection}
            sourcePOV!.pItem <- source
            sourcePOV!.bindIdentityRegistry(registry)
            our POV: firstSource <- source!.value!.items.head
            our POV: secondSource <- source!.value!.items.tail

            our infonView: singleQuery <- parseAndExtract(testName, "1")
            our infonView: singleResult <- parseAndExtract(testName, "{a:1}")
            our POV:: singleQueryPOV{povSrcPartPathSelection}
            our POV:: singleResultPOV{povSrcPartPathSelection}
            singleQueryPOV!.pItem <- singleQuery
            singleResultPOV!.pItem <- singleResult
            our SelectionRequest: singleRequest <- registry!.
                    getOrCreateSelectionRequest(
                            singleQueryPOV, singleResultPOV, sourcePOV,
                            srkPositionalSelection, 1)
            registry!.recordSelectionReferenceForRequest(
                    singleRequest, singleResultPOV, firstSource)
            our POV: singleOccurrence <- registry!.
                    resolveSingleSelectedOccurrence(
                            singleRequest!.requestID)

            our infonView: spanQuery <- parseAndExtract(testName, "1")
            our infonView: spanResult <- parseAndExtract(
                    testName, "{{a:1} {a:2}}")
            our POV:: spanQueryPOV{povSrcPartPathSelection}
            our POV:: spanResultPOV{povSrcPartPathSelection}
            spanQueryPOV!.pItem <- spanQuery
            spanResultPOV!.pItem <- spanResult
            our SelectionRequest: spanRequest <- registry!.
                    getOrCreateSelectionRequest(
                            spanQueryPOV, spanResultPOV, sourcePOV,
                            srkPositionalSelection, 2)
            spanRequest!.selectorSpec <- spanResult
            registry!.recordSelectionReferenceForRequest(
                    spanRequest, spanResultPOV, firstSource)
            our POV: spanOccurrence <- registry!.
                    resolveSingleSelectedOccurrence(
                            spanRequest!.requestID)

            our infonView: multipleQuery <- parseAndExtract(testName, "_")
            our infonView: multipleResult <- parseAndExtract(testName, "{a:_}")
            our POV:: multipleQueryPOV{povSrcPartPathSelection}
            our POV:: multipleResultPOV{povSrcPartPathSelection}
            multipleQueryPOV!.pItem <- multipleQuery
            multipleResultPOV!.pItem <- multipleResult
            our SelectionRequest: multipleRequest <- registry!.
                    getOrCreateSelectionRequest(
                            multipleQueryPOV, multipleResultPOV, sourcePOV,
                            srkPositionalSelection, 3)
            registry!.recordSelectionReferenceForRequest(
                    multipleRequest, multipleResultPOV, firstSource)
            registry!.recordSelectionReferenceForRequest(
                    multipleRequest, multipleResultPOV, secondSource)
            our POV: multipleOccurrence <- registry!.
                    resolveSingleSelectedOccurrence(
                            multipleRequest!.requestID)

            passed <- singleOccurrence===firstSource and
                    spanOccurrence==NULL and
                    multipleOccurrence==NULL
            modelMngr.clear()
        }

        me string: actual <- "false"
        me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
        return()
    }
    me void: unitTestPositionalSelectionReference(
            me string: testName, me int: caseID) <- {
        me ProteusCore: CORE
        CORE.init("", false)
        me string: expression <- "{10 20 30}@[2]"
        me int64: expectedValue <- 20
        if(caseID==2){
            expression <- "{10 20 30}.first"
            expectedValue <- 10
        }else if(caseID==3){
            expression <- "{10 20 30}.last"
            expectedValue <- 30
        }else if(caseID==4){
            expression <- "{10 20 30 40}@[1:*2+{ ... }]"
            expectedValue <- 20
        }
        our infonView: result <- parseAndExtract(testName, expression)
        our POV:: resultPOV{povSrcPartPathSelection}
        resultPOV!.pItem <- result
        CORE.agent!.normalizeAndWait(resultPOV)

        our SelectionReference: registeredReference
        me int: positionalReferenceCount <- 0
        withEach reference in
                CORE.agent!.identityRegistry!.selectionReferences{
            if(reference!.referenceKind==srkPositionalSelection){
                positionalReferenceCount <+- 1
                registeredReference <- reference
            }
        }
        me List<our SelectionReference>: sourceReferences
        if(registeredReference!=NULL){
            CORE.agent!.identityRegistry!.
                    collectSelectionReferencesForSource(
                            registeredReference!.sourceContextPOV,
                            registeredReference!.sourceStartPOV,
                            sourceReferences)
        }
        me bool: sourceIncludesRegistered <- false
        withEach sourceReference in sourceReferences{
            if(sourceReference===registeredReference){
                sourceIncludesRegistered <- true
                break()
            }
        }

        me bool: passed <- registeredReference!=NULL and
                positionalReferenceCount==1 and
                sourceIncludesRegistered and
                registeredReference!.queryPOV!=NULL and
                registeredReference!.resultPOV!=NULL and
                registeredReference!.resultPOV!.pItem===resultPOV!.pItem and
                registeredReference!.sourceContextPOV!=NULL and
                registeredReference!.sourceContextPOV!.pItem!=NULL and
                registeredReference!.sourceContextPOV!.pItem!.value!.
                        overlayType==LST and
                registeredReference!.sourceStartPOV!=NULL and
                registeredReference!.sourceStartPOV!.pItem!=NULL and
                registeredReference!.sourceStartPOV!.pItem!.
                        value!.num.convertToInt()==expectedValue
        if(caseID==4){
            our POV: firstResultPOV <-
                    resultPOV!.pItem!.value!.items.head
            our POV: secondResultPOV <-
                    resultPOV!.pItem!.value!.items.tail
            // The positive range's compressed prefix is a repetition. When
            // its demanded occurrence is exposed, that occurrence and the
            // concrete head are genuinely identical; this is independent of
            // the non-identity selection provenance checked above.
            our IdentityRelation: exposureIdentity
            if(CORE.agent!.identityRegistry!.identities.size()==1){
                exposureIdentity <-
                        CORE.agent!.identityRegistry!.identities.first()
            }
            passed <- passed and firstResultPOV!=NULL and
                    secondResultPOV!=NULL and
                    exposureIdentity!=NULL and
                    exposureIdentity!.evidenceKind==
                            iekRepetitionMaterialization and
                    firstResultPOV!.pItem!.value!.
                            num.convertToInt()==20 and
                    secondResultPOV!.pItem!.value!.
                            num.convertToInt()==30
        }else{
            passed <- passed and
                    CORE.agent!.identityRegistry!.identities.isEmpty() and
                    resultPOV!.pItem!.value!.
                            num.convertToInt()==expectedValue
        }
        me string: actual <- "false"
        me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
        modelMngr.clear()
        return()
    }
    me void: unitTestIndexLowering(me string: testName, me int: caseID) <- {
        me bool: passed <- false

        me TestProteusCore: CORE
        if(!CORE.initForWorldTest("TestFiles/timeTestCases.pr")){
            me string: failure <- CORE.errorMesg
            CORE.deInit()
            FAIL("WORLD_LOAD: "+failure)
        }
        our infonView: sugar <- parseAndExtract(testName,
                "hour:{second| 1 2 3 4 5 6}@[-1]")
        our infonView: lowLevel <- parseAndExtract(testName,
                "*(-1)+[<minute>] <~ hour:{second| 1 2 3 4 5 6}")
        our POV:: sugarPOV{povSrcEndRelativeView}
        sugarPOV!.pItem <- sugar
        our POV:: lowLevelPOV{povSrcEndRelativeView}
        lowLevelPOV!.pItem <- lowLevel
        CORE.agent!.normalizeAndWait(sugarPOV)
        CORE.agent!.normalizeAndWait(lowLevelPOV)
        our POV: sugarFirst <- sugarPOV!.pItem!.value!.items.head
        our POV: lowLevelFirst <- lowLevelPOV!.pItem!.value!.items.head
        passed <- sugarPOV!.pItem!.type!=NULL and
                lowLevelPOV!.pItem!.type!=NULL and
                sugarPOV!.pItem!.type!.typeID()=="minute" and
                lowLevelPOV!.pItem!.type!.typeID()=="minute" and
                sugarPOV!.viewMap.sourcePov!=NULL and
                sugarPOV!.viewMap.startPov!=NULL and
                lowLevelPOV!.viewMap.sourcePov!=NULL and
                lowLevelPOV!.viewMap.startPov!=NULL and
                sugarPOV!.viewMap.startPov!.pItem!.value!.num.
                        convertToInt()==4 and
                lowLevelPOV!.viewMap.startPov!.pItem!.value!.num.
                        convertToInt()==4 and
                sugarFirst!=NULL and lowLevelFirst!=NULL and
                sugarFirst!.viewMap.startPov!=NULL and
                lowLevelFirst!.viewMap.startPov!=NULL and
                sugarFirst!.viewMap.startPov!.pItem!.value!.num.
                        convertToInt()==4 and
                lowLevelFirst!.viewMap.startPov!.pItem!.value!.num.
                        convertToInt()==4
        CORE.deInit()
        modelMngr.clear()

        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
    me void: unitTestImplicitItem(me string: testName, me int: caseID) <- {
        our infonView: source <- parseAndExtract(testName, "*4+{item| ...}")
        our POV:: sourcePOV{povSrcImplicitItem}
        sourcePOV!.pItem <- source
        sourcePOV!.isSubItm <- true
        our IdentityRegistry:: identityRegistry
        sourcePOV!.bindIdentityRegistry(identityRegistry)

        me bool: passed <- false
        if(caseID==1){
            our POV: firstLookup <- sourcePOV!.getOrCreateImplicitItemPOV(2)
            our POV: secondLookup <- sourcePOV!.getOrCreateImplicitItemPOV(2)
            passed <- firstLookup!=NULL and firstLookup===secondLookup and
                      firstLookup!.pItem!=NULL and firstLookup!.pItem!.type===source!.value!.listSpec!.type and
                      firstLookup!.isImplicitItemPOV() and firstLookup!.implicitItem.sourcePov===sourcePOV and
                      firstLookup!.implicitItem.sourceIndex==2 and firstLookup!.viewMap.sourcePov==NULL and
                      source!.retainedPOVs.isEmpty() and
                      sourcePOV!.repetitionSpan.family!=NULL and
                      sourcePOV!.repetitionSpan.family!.occurrences.size()==1 and
                      firstLookup!.repetitionOccurrence!=NULL and
                      firstLookup!.repetitionOccurrence!.ordinalKnown and
                      firstLookup!.repetitionOccurrence!.ordinal==2 and
                      firstLookup!.repetitionOccurrence!.occurrenceToken>0 and
                      sourcePOV!.getOrCreateImplicitItemPOV(-1)==NULL and
                      sourcePOV!.getOrCreateImplicitItemPOV(4)==NULL
        }else if(caseID==2){
            our POV: firstPosition <- sourcePOV!.getOrCreateImplicitItemPOV(1)
            our POV: secondPosition <- sourcePOV!.getOrCreateImplicitItemPOV(2)
            passed <- firstPosition!=NULL and secondPosition!=NULL and
                      !(firstPosition===secondPosition) and
                      !(firstPosition!.pItem===secondPosition!.pItem) and
                      firstPosition!.implicitItem.sourceIndex==1 and
                      secondPosition!.implicitItem.sourceIndex==2 and
                      firstPosition!.repetitionOccurrence!.occurrenceToken!=
                            secondPosition!.repetitionOccurrence!.occurrenceToken and
                      source!.retainedPOVs.isEmpty() and
                      sourcePOV!.repetitionSpan.family!.occurrences.size()==2
        }else if(caseID==3){
            our POV: implicitPOV <- sourcePOV!.getOrCreateImplicitItemPOV(2)
            passed <- implicitPOV!=NULL and source!.value!.items.size()==0 and
                      sourcePOV!.sparseSpanCount()==4 and source!.value!.tailUnfinished and
                      implicitPOV!.pParent==NULL and implicitPOV!.prev==NULL and implicitPOV!.next==NULL
        }else if(caseID==4){
            our POV: temporaryLookup <- sourcePOV!.getOrCreateImplicitItemPOV(2)
            temporaryLookup <- NULL
            our POV: retainedOrigin <- sourcePOV!.findImplicitItemPOV(2)
            our POV:: viewPOV{povSrcImplicitItem}
            if(retainedOrigin!=NULL){
                viewPOV!.pItem <- retainedOrigin!.pItem
                viewPOV!.viewMap.sourcePov <- sourcePOV
                viewPOV!.viewMap.startPov <- retainedOrigin
            }
            passed <- retainedOrigin!=NULL and viewPOV!.viewMap.sourcePov===sourcePOV and
                      viewPOV!.viewMap.startPov===retainedOrigin and
                      viewPOV!.viewMap.startPov!.implicitItem.sourcePov===sourcePOV
        }else if(caseID==5){
            our infonView: parent <- parseAndExtract(testName, "{*4+{item| ...} 99}")
            our POV:: parentPOV{povSrcImplicitItem}
            parentPOV!.pItem <- parent
            our POV: sparsePOV <- parent!.value!.items.head
            our POV: thirdItem
            our POV: fourthItem
            our POV: followingConcrete
            me int64: levelsUp <- 0
            our infItr:: ii
            ii!.topPOV <- parentPOV
            our POV: tightFollowing
            if(sparsePOV!=NULL){
                sparsePOV!.pParent <- parentPOV
                sparsePOV!.isSubItm <- true
                sparsePOV!.bindIdentityRegistry(identityRegistry)
                thirdItem <- sparsePOV!.getOrCreateImplicitItemPOV(2)
            }
            if(thirdItem!=NULL){fourthItem <- thirdItem!.logicalNextItemPOV()}
            if(fourthItem!=NULL){
                followingConcrete <- fourthItem!.logicalNextItemPOV()
                tightFollowing <- fourthItem!.getNextTight(
                        ii, 0, levelsUp, false, false, NULL, NULL)
            }
            passed <- sparsePOV!=NULL and sparsePOV!.isSparseOrderedSpan() and
                      thirdItem!=NULL and fourthItem!=NULL and
                      thirdItem!.implicitItem.sourceIndex==2 and
                      fourthItem!.implicitItem.sourceIndex==3 and
                      followingConcrete!=NULL and followingConcrete===sparsePOV!.next and
                      followingConcrete!.pItem!.value!.num.convertToInt()==99 and
                      tightFollowing===followingConcrete and
                      sparsePOV!.pItem!.value!.items.isEmpty()
        }else if(caseID==7){
            our infonView: outer <- parseAndExtract(
                    testName, "{&{*4+{item| ...}} 99}")
            our POV:: outerPOV{povSrcImplicitItem}
            outerPOV!.pItem <- outer
            our POV: innerPOV <- outer!.value!.items.head
            our POV: sparsePOV
            if(innerPOV!=NULL){
                innerPOV!.pParent <- outerPOV
                innerPOV!.isSubItm <- true
                sparsePOV <- innerPOV!.pItem!.value!.items.head
            }
            our POV: lastImplicit
            if(sparsePOV!=NULL){
                sparsePOV!.pParent <- innerPOV
                sparsePOV!.isSubItm <- true
                sparsePOV!.bindIdentityRegistry(identityRegistry)
                lastImplicit <- sparsePOV!.getOrCreateImplicitItemPOV(3)
            }
            me int64: outerLevelsUp <- 0
            our infItr:: outerItr
            outerItr!.topPOV <- outerPOV
            our POV: crossedToOuterSibling
            if(lastImplicit!=NULL){
                crossedToOuterSibling <- lastImplicit!.getNextTight(
                        outerItr, 0, outerLevelsUp, false, false, NULL, NULL)
            }
            me int64: innerLevelsUp <- 0
            our infItr:: innerItr
            innerItr!.topPOV <- innerPOV
            our POV: stoppedAtInnerBoundary
            if(lastImplicit!=NULL){
                stoppedAtInnerBoundary <- lastImplicit!.getNextTight(
                        innerItr, 0, innerLevelsUp, false, false, NULL, NULL)
            }
            passed <- innerPOV!=NULL and sparsePOV!=NULL and lastImplicit!=NULL and
                      lastImplicit!.logicalNextItemPOV()==NULL and
                      crossedToOuterSibling!=NULL and
                      crossedToOuterSibling===innerPOV!.next and
                      crossedToOuterSibling!.pItem!.value!.num.convertToInt()==99 and
                      stoppedAtInnerBoundary==NULL and
                      sparsePOV!.pItem!.value!.items.isEmpty()
        }else if(caseID==8){
            our infonView: parent <- parseAndExtract(
                    testName, "{&*4+{item| ...} 99}")
            our POV:: parentPOV{povSrcImplicitItem}
            parentPOV!.pItem <- parent
            our POV: sparsePOV <- parent!.value!.items.head
            our POV: remainderPOV
            if(sparsePOV!=NULL){
                sparsePOV!.pParent <- parentPOV
                sparsePOV!.isSubItm <- true
                sparsePOV!.bindIdentityRegistry(identityRegistry)
                remainderPOV <- sparsePOV!.splitSparseSpanPrefix(2)
            }
            passed <- sparsePOV!=NULL and remainderPOV!=NULL and
                      sparsePOV!.pItem!.value!.sizeMode==fromGiven and
                      remainderPOV!.pItem!.value!.sizeMode==fromGiven and
                      sparsePOV!.sparseSpanCount()==2 and
                      remainderPOV!.sparseSpanCount()==2 and
                      remainderPOV!.isSubItm and
                      remainderPOV!.pParent===parentPOV
        }else if(caseID==9){
            our infonView: parent <- parseAndExtract(
                    testName, "{&*6+{item| ...} 99}")
            our POV:: parentPOV{povSrcImplicitItem}
            parentPOV!.pItem <- parent
            parentPOV!.bindIdentityRegistry(identityRegistry)
            our POV: sparsePOV <- parent!.value!.items.head
            our POV: beforeSplit
            our POV: remainderPOV
            our POV: afterSplit
            me uint64: occurrenceToken <- 0
            if(sparsePOV!=NULL){
                sparsePOV!.pParent <- parentPOV
                sparsePOV!.isSubItm <- true
                beforeSplit <- sparsePOV!.getOrCreateImplicitItemPOV(4)
            }
            if(beforeSplit!=NULL){
                occurrenceToken <- beforeSplit!.repetitionOccurrence!.
                        occurrenceToken
                remainderPOV <- sparsePOV!.splitSparseSpanPrefix(3)
            }
            if(remainderPOV!=NULL){
                afterSplit <- remainderPOV!.getOrCreateImplicitItemPOV(1)
            }
            passed <- beforeSplit!=NULL and remainderPOV!=NULL and
                      afterSplit!=NULL and beforeSplit===afterSplit and
                      afterSplit!.repetitionOccurrence!.occurrenceToken==
                            occurrenceToken and
                      afterSplit!.repetitionOccurrence!.ordinal==4 and
                      afterSplit!.implicitItem.sourcePov===remainderPOV and
                      afterSplit!.implicitItem.sourceIndex==1 and
                      sparsePOV!.repetitionSpan.family===
                            remainderPOV!.repetitionSpan.family and
                      sparsePOV!.sparseSpanCount()==3 and
                      remainderPOV!.sparseSpanCount()==3 and
                      parent!.value!.items.size()==3
        }else if(caseID==10){
            our infonView: parent <- parseAndExtract(
                    testName, "{&*3+{item| ...} 99}")
            our POV:: parentPOV{povSrcImplicitItem}
            parentPOV!.pItem <- parent
            parentPOV!.bindIdentityRegistry(identityRegistry)
            our POV: sparsePOV <- parent!.value!.items.head
            our POV: occurrenceReference
            our POV: concretePOV
            our POV: nextOccurrence
            if(sparsePOV!=NULL){
                sparsePOV!.pParent <- parentPOV
                sparsePOV!.isSubItm <- true
                occurrenceReference <-
                        sparsePOV!.getOrCreateImplicitItemPOV(0)
            }
            if(occurrenceReference!=NULL){
                concretePOV <- sparsePOV!.exposeSparseHeadWithItem(
                        occurrenceReference!.pItem)
                nextOccurrence <- sparsePOV!.getOrCreateImplicitItemPOV(0)
            }
            passed <- occurrenceReference!=NULL and concretePOV!=NULL and
                      nextOccurrence!=NULL and
                      !(occurrenceReference===concretePOV) and
                      !(occurrenceReference===nextOccurrence) and
                      identityRegistry!.areIdentical(
                            occurrenceReference, concretePOV) and
                      identityRegistry!.areIdentical(
                            concretePOV, occurrenceReference) and
                      identityRegistry!.identities.size()==1 and
                      occurrenceReference!.repetitionOccurrence!.
                            materializedPOV===concretePOV and
                      concretePOV!.repetitionOccurrence===
                            occurrenceReference!.repetitionOccurrence and
                      !occurrenceReference!.isImplicitItemPOV() and
                      sparsePOV!.repetitionSpan.startOrdinal==1 and
                      nextOccurrence!.repetitionOccurrence!.ordinal==1 and
                      sparsePOV!.sparseSpanCount()==2 and
                      parent!.value!.items.size()==3
        }else if(caseID==11){
            our infonView: hugeSource <- parseAndExtract(
                    testName, "*1000000000+{item| ...}")
            our POV:: hugeSourcePOV{povSrcImplicitItem}
            hugeSourcePOV!.pItem <- hugeSource
            hugeSourcePOV!.isSubItm <- true
            hugeSourcePOV!.bindIdentityRegistry(identityRegistry)
            our POV: lastOccurrence <- hugeSourcePOV!.
                    getOrCreateImplicitItemPOV(999999999)
            passed <- lastOccurrence!=NULL and
                      lastOccurrence!.repetitionOccurrence!=NULL and
                      lastOccurrence!.repetitionOccurrence!.ordinal==999999999 and
                      hugeSource!.value!.items.isEmpty() and
                      hugeSourcePOV!.sparseSpanCount()==1000000000 and
                      hugeSourcePOV!.repetitionSpan.family!=NULL and
                      hugeSourcePOV!.repetitionSpan.family!.occurrences.size()==1 and
                      identityRegistry!.repetitionFamilies.size()==1
        }else if(caseID==12){
            our POV:: firstPOV{povSrcImplicitItem}
            our POV:: secondPOV{povSrcImplicitItem}
            our POV:: thirdPOV{povSrcImplicitItem}
            our infonView:: first
            our infonView:: second
            our infonView:: third
            firstPOV!.pItem <- first
            secondPOV!.pItem <- second
            thirdPOV!.pItem <- third
            our IdentityRelation: firstIdentity <- identityRegistry!.
                    recordIdentity(firstPOV, secondPOV,
                            iekAssertion, 1)
            our IdentityRelation: secondIdentity <- identityRegistry!.
                    recordIdentity(secondPOV, thirdPOV,
                            iekAssertion, 1)
            our IdentityRelation: duplicateIdentity <- identityRegistry!.
                    recordIdentity(secondPOV, firstPOV,
                            iekAssertion, 1)
            passed <- firstIdentity!=NULL and secondIdentity!=NULL and
                      duplicateIdentity===firstIdentity and
                      identityRegistry!.identities.size()==2 and
                      identityRegistry!.areIdentical(firstPOV, thirdPOV) and
                      identityRegistry!.areIdentical(thirdPOV, firstPOV)
        }else if(caseID==13){
            our infonView: parent <- parseAndExtract(
                    testName, "{&*2+{item| ...} 99}")
            our POV:: parentPOV{povSrcImplicitItem}
            parentPOV!.pItem <- parent
            parentPOV!.bindIdentityRegistry(identityRegistry)
            our POV: sparsePOV <- parent!.value!.items.head
            our POV: concretePOV
            their RepetitionOccurrence: occurrence
            if(sparsePOV!=NULL){
                sparsePOV!.pParent <- parentPOV
                sparsePOV!.isSubItm <- true
                concretePOV <- sparsePOV!.exposeSparseHead(false)
            }
            if(concretePOV!=NULL){
                occurrence <- concretePOV!.repetitionOccurrence
            }
            passed <- concretePOV!=NULL and occurrence!=NULL and
                      occurrence!.referencePOV!=NULL and
                      occurrence!.materializedPOV===concretePOV and
                      identityRegistry!.areIdentical(
                            occurrence!.referencePOV, concretePOV) and
                      identityRegistry!.areIdentical(
                            concretePOV, occurrence!.referencePOV) and
                      identityRegistry!.identities.size()==1 and
                      sparsePOV!.repetitionSpan.startOrdinal==1 and
                      sparsePOV!.sparseSpanCount()==1 and
                      parent!.value!.items.size()==3
        }else{
            source!.infSize!.evalMode <- emUnknown
            our RepetitionOccurrence: firstOccurrence <- identityRegistry!.
                    createUnknownOrdinalRepetitionOccurrence(sourcePOV)
            our RepetitionOccurrence: secondOccurrence <- identityRegistry!.
                    createUnknownOrdinalRepetitionOccurrence(sourcePOV)
            me uint64: firstToken <- 0
            our POV: firstReferencePOV
            if(firstOccurrence!=NULL){
                firstToken <- firstOccurrence!.occurrenceToken
                firstReferencePOV <- firstOccurrence!.referencePOV
            }
            our infonView: occurrenceQuery <- parseAndExtract(
                    testName, "_")
            our POV:: occurrenceQueryPOV{povSrcPartPathSelection}
            occurrenceQueryPOV!.pItem <- occurrenceQuery
            our infonView: occurrenceResult <- parseAndExtract(
                    testName, "item")
            our POV:: occurrenceResultPOV{povSrcPartPathSelection}
            occurrenceResultPOV!.pItem <- occurrenceResult
            our SelectionRequest: occurrenceRequest <- identityRegistry!.
                    getOrCreateSelectionRequest(
                            occurrenceQueryPOV, occurrenceResultPOV,
                            sourcePOV, srkIntersectionCorrespondence, 1)
            our SelectionReference: firstSelection
            our SelectionReference: secondSelection
            our SelectionResolution: occurrenceResolution
            if(firstOccurrence!=NULL and secondOccurrence!=NULL and
                    occurrenceRequest!=NULL){
                firstSelection <- identityRegistry!.
                        recordSelectionReferenceForRequest(
                                occurrenceRequest, occurrenceResultPOV,
                                firstOccurrence!.referencePOV)
                secondSelection <- identityRegistry!.
                        recordSelectionReferenceForRequest(
                                occurrenceRequest, occurrenceResultPOV,
                                secondOccurrence!.referencePOV)
                occurrenceResolution <- identityRegistry!.
                        resolveSelectionRequest(
                                occurrenceRequest!.requestID)
            }
            me bool: firstBound <- identityRegistry!.
                    bindRepetitionOccurrenceOrdinal(firstOccurrence, 2)
            me bool: sameBinding <- identityRegistry!.
                    bindRepetitionOccurrenceOrdinal(firstOccurrence, 2)
            me bool: conflictingRebind <- identityRegistry!.
                    bindRepetitionOccurrenceOrdinal(firstOccurrence, 1)
            me bool: ordinalCollision <- identityRegistry!.
                    bindRepetitionOccurrenceOrdinal(secondOccurrence, 2)
            me bool: secondBound <- identityRegistry!.
                    bindRepetitionOccurrenceOrdinal(secondOccurrence, 3)
            our RepetitionOccurrence: foundFirst <- identityRegistry!.
                    findOrdinalOccurrence(
                            sourcePOV!.repetitionSpan.family, 2)
            our RepetitionOccurrence: foundSecond <- identityRegistry!.
                    findOrdinalOccurrence(
                            sourcePOV!.repetitionSpan.family, 3)
            passed <- firstOccurrence!=NULL and secondOccurrence!=NULL and
                      firstOccurrence!==secondOccurrence and
                      firstToken!=secondOccurrence!.occurrenceToken and
                      firstReferencePOV===firstOccurrence!.referencePOV and
                      firstReferencePOV!.repetitionOccurrence===
                            firstOccurrence and
                      firstSelection!=NULL and secondSelection!=NULL and
                      firstSelection!.repetitionOccurrence===firstOccurrence and
                      secondSelection!.repetitionOccurrence===secondOccurrence and
                      occurrenceResolution!=NULL and
                      occurrenceResolution!.resolutionState==srsMultiple and
                      occurrenceResolution!.references.size()==2 and
                      firstBound and sameBinding and !conflictingRebind and
                      !ordinalCollision and secondBound and
                      firstOccurrence!.ordinalKnown and
                      firstOccurrence!.ordinal==2 and
                      secondOccurrence!.ordinalKnown and
                      secondOccurrence!.ordinal==3 and
                      foundFirst===firstOccurrence and
                      foundSecond===secondOccurrence and
                      source!.infSize!.evalMode==emUnknown and
                      source!.value!.items.isEmpty() and
                      sourcePOV!.repetitionSpan.family!.occurrences.size()==2
        }

        me string: result <- "false"
        me string: expected <- "true"
        if(passed){result <- "true"}
        REQUIRE(result==expected)
        return()
    }
    me void: unitTestListSpecApplication(me string: testName) <- {
        our infonView:: firstListSpec
        firstListSpec!.viewMode <- vmAny
        firstListSpec!.value!.overlayType <- NUM
        firstListSpec!.value!.evalMode <- emUnknown

        our infonView:: secondListSpec
        secondListSpec!.viewMode <- vmAny
        secondListSpec!.value!.overlayType <- STR
        secondListSpec!.value!.evalMode <- emUnknown

        our infonView:: list
        list!.viewMode <- vmOverlay
        list!.value!.overlayType <- LST
        list!.value!.evalMode <- emLiteral
        list!.value!.listSpec <- firstListSpec
        our POV:: listPOV{627}
        listPOV!.pItem <- list

        our infonView:: member
        member!.viewMode <- vmOverlay
        member!.value!.overlayType <- NUM
        member!.value!.evalMode <- emLiteral

        me bool: firstApplied <- listPOV!.seedTypeSpecs(member, false)
        me bool: duplicateSkipped <-
                !listPOV!.seedNewlyVisibleTypeSpecs(member, false)
        me bool: firstStateCorrect <-
                member!.appliedListSpecs.size()==1 and
                member!.appliedListSpecs[0]===firstListSpec and
                member!.wrkList.size()==1

        list!.value!.listSpec <- secondListSpec
        me bool: ordinaryRepeatPreserved <-
                listPOV!.seedTypeSpecs(member, false) and
                member!.appliedListSpecs.size()==1 and
                member!.wrkList.size()==1
        me bool: secondApplied <-
                listPOV!.seedNewlyVisibleTypeSpecs(member, false)
        me bool: secondStateCorrect <-
                member!.appliedListSpecs.size()==2 and
                member!.appliedListSpecs[1]===secondListSpec and
                member!.wrkList.size()==2

        me string: actual <- "false"
        me string: expected <- "true"
        if(firstApplied and duplicateSkipped and firstStateCorrect and
                ordinaryRepeatPreserved and secondApplied and
                secondStateCorrect){actual <- "true"}
        REQUIRE(actual==expected)
        return()
    }
    me void: processTestLine(me string: testName, our Agent: agent, me string: line, me InfonPrintMode: printMode<-ipmCompressed) <- {
        me int: pos           <- findString(line, "//:")
        me string: testInput
        me string: expected
        if(pos==-1){
            testInput  <- line
            expected <- ""
        }else{
            testInput  <- line.subStr(0,pos)
            expected <- line.subStr(pos+3,line.size())
        }
        log("IN:<"+testInput+">  EXPECTED:<"+expected+">")
        testLine(testName, agent, testInput, expected, true, printMode)
    }
    me void: multiNorm(me string: testName, me string: in, me string: worldFileName, me InfonPrintMode: printMode<-ipmCompressed) <- {
        infonViewPrinter.debugSublistPrint <- true
        me TestProteusCore: CORE
        me bool: loaded <- CORE.initForWorldTest(worldFileName)
        me string: loadedState <- "false"
        if(loaded){loadedState <- "true"}
        me string: expectedLoadState <- "true"
        if(!loaded){
            me string: message <- CORE.errorMesg
            CORE.deInit(); modelMngr.clear()
            FAIL("WORLD_LOAD: "+message)
        }
        REQUIRE(loadedState==expectedLoadState)
        me string: line <- ""
        withEach charPos in range 0 .. in.size(){
            if(in[charPos]=="\n"){
                processTestLine(testName, CORE.agent, line, printMode)
                line <- ""
            }else{line <+- in[charPos]}
        }
        if(line!=""){processTestLine(testName, CORE.agent, line, printMode)}
        CORE.deInit()
        modelMngr.clear()
    }
}

struct GLOBAL {
    void: unit_graphText_identityInSource(me string: tname) <- {initAndTest(tname, "{*3+$ *4+$} == ($ = 'CatDogs')", "{'Cat' 'Dogs'}", true)}
    void: unit_graphText_unknownString(me string: tname) <- {initAndTest(tname, "$ == 'Hello'", "'Hello'", true)}
    void: unit_graphText_sizedString(me string: tname) <- {initAndTest(tname, "*5+$ == 'Hello'", "'Hello'", true)}
    void: unit_graphText_literalString(me string: tname) <- {initAndTest(tname, "'Hello' == 'Hello'", "'Hello'", true)}
    void: unit_graphText_anyString(me string: tname) <- {initAndTest(tname, "? == 'Hello'", "'Hello'", true)}

    void: unit_worldManager_incompleteRHS(me string: testName) <- {
        testParseError(testName, "_ = ", "Expected a number", 1, 1)
    }
}

// Ordinary CodeDog regressions for the parser's input-lock boundary.
struct ParserInputQuery: inherits=Threads {
    their ProteusCore: core
    our infonView: watched
    me bool: observedParsing
    me string: answer
    me Mutex: stateMutex
    me bool: done
    me bool: isDone() <- {protect(stateMutex){return(done)}}
    void: run() <- {
        if(watched!=NULL){
            protect(core!.agent!.worldManager.control!.mutex){
                observedParsing <- watched!.streamState!=parseDone
            }
        }
        our infonView: result <- core!.query("_ = 7", false)
        if(result!=NULL){answer <- toString(result)}
        protect(stateMutex){done <- true}
    }
}

struct ParserInputWorker: inherits=Threads {
    their ProteusCore: core
    our ProteusParser: parser
    our infonView: root
    me Semaphore: entered
    void: run() <- {
        // Signal only after owning the model lock. A second registered scope
        // also checks recursive release through the real generated buffer path.
        me InputLock: lock{core!.agent!.worldManager.control!.mutex}
        entered.post()
        parser!.doParse(root)
    }
}

struct ParserCallbackCore: inherits=ProteusCore {
    me bool: callbackRan
    me string: callbackAnswer
    void: handleSyntaxError(me uint64: originID, me string: message) <- {
        me ParserInputQuery: query
        query.core <- self
        query.start()
        query.waitForExit()
        callbackAnswer <- query.answer
        callbackRan <- true
    }
}

struct ParserInputConnector: inherits=InfonConnector {
    me bool: pumpOutputBuf(me string: message) <- {return(true)}
}

struct ParserStreamShutdown: inherits=Threads {
    their InfonStream: stream
    me Mutex: stateMutex
    me bool: done
    me bool: isDone() <- {protect(stateMutex){return(done)}}
    void: run() <- {
        stream!.requestFinish()
        protect(stateMutex){done <- true}
    }
}

struct GLOBAL {
    void: testParserInputProgress(me string: testName, me bool: buffered) <- {
        me ProteusCore: core; core.init("")
        me strBuf: input; input.init("parser-input-test")
        me string: source <- "123"
        if(buffered){
            source <- "{"
            withEach item in range 0 .. 10000{source <+- "1 "}
            source <+- "}"
        }
        input.putStr(source)
        if(buffered){input.close()}
        our ProteusParser:: parser{core, true, 0}
        parser!.initParseFromStream(input)
        our infonView:: root
        me ParserInputWorker: reader
        reader.core <- core; reader.parser <- parser; reader.root <- root
        // Semaphore starts with one permit; consume it before the worker signals.
        reader.entered.wait(); reader.start(); reader.entered.wait()
        me ParserInputQuery: query
        query.core <- core; query.watched <- root; query.start()
        me int: elapsed
        while(!query.isDone() and elapsed<2000){sleep(5); elapsed <+- 5}
        me bool: progressed <- query.isDone()
        input.close()
        reader.waitForExit(); query.waitForExit()
        me bool: parsed <- !parser!.doesParseHaveError()
        core.deInit(); modelMngr.clear()
        me string: expected <- toString(true)
        INFO("Progress="+toString(progressed)+", while parsing="+toString(query.observedParsing)+", parsed="+toString(parsed)+", answer="+query.answer)
        me string: actual <- toString(progressed); REQUIRE(actual==expected)
        actual <- toString(query.observedParsing); REQUIRE(actual==expected)
        actual <- toString(parsed); REQUIRE(actual==expected)
        actual <- query.answer; expected <- "7"; REQUIRE(actual==expected)
    }
    void: unit_parserInput_openWait(me string: testName) <- {testParserInputProgress(testName, false)}
    void: unit_parserInput_bufferedProgress(me string: testName) <- {testParserInputProgress(testName, true)}

    void: unit_parserInput_syntaxCallback(me string: testName) <- {
        me ParserCallbackCore: core; core.init("")
        our infonView: result <- core.parseAndExtractString("_ = ", "callback-test")
        core.deInit(); modelMngr.clear()
        me string: expected <- toString(true)
        me string: actual <- toString(result==NULL); REQUIRE(actual==expected)
        actual <- toString(core.callbackRan); REQUIRE(actual==expected)
        actual <- core.callbackAnswer; expected <- "7"; REQUIRE(actual==expected)
    }

    void: unit_parserInput_shutdown(me string: testName) <- {
        me ProteusCore: core; core.init("")
        our ParserInputConnector:: connector
        Allocate(connector!.streamSpec)
        connector!.streamSpec!.spec <- "parser-shutdown-test"
        connector!.allowStreamingNormalize <- true
        our ProteusParser:: parser{core, true, 0}
        our infonView:: root
        me InfonStream: stream
        stream.init(connector, core.agent, parser, root, 0)
        stream.start("INPUT_TEST")
        stream.pushParserInputBuf("123")
        sleep(50)
        me ParserStreamShutdown: shutdown
        shutdown.stream <- stream; shutdown.start()
        me int: elapsed
        while(!shutdown.isDone() and elapsed<2000){sleep(5); elapsed <+- 5}
        me bool: stopped <- shutdown.isDone()
        // Close independently on failure so the test can report and join.
        connector!.inputBuf.close()
        shutdown.waitForExit(); stream.waitForCompletion()
        me bool: cancelled <- stream.normerThread.handle!=NULL and stream.normerThread.handle!.status().outcome==worldCancelled
        core.deInit(); modelMngr.clear()
        me string: expected <- toString(true)
        me string: actual <- toString(stopped); REQUIRE(actual==expected)
        actual <- toString(cancelled); REQUIRE(actual==expected)
    }
}

// Null identity syntax retains the positive-int64 domain of identity scopes.
struct GLOBAL {
    void: checkParsedNullIdentity(me string: testName, me string: digits, me string: expected) <- {
        me ProteusParser: parser{NULL, false, 0}
        parser.initParseFromString(testName, "NULL:"+digits)
        our infonView:: root
        parser.doParse(root)
        if(parser.doesParseHaveError()){FAIL(parser.formattedError())}
        if(!root!.isNull()){FAIL("Expected a null infon")}
        me string: actual <- "unlabelled"
        if(root!.identityName!=NULL){actual <- toString(root!.identityName!.id)}
        REQUIRE(actual==expected)
    }
    void: unit_parserIdentity_validRange(me string: testName) <- {
        checkParsedNullIdentity(testName, "", "unlabelled")
        checkParsedNullIdentity(testName, "1", "1")
        checkParsedNullIdentity(testName, "00042", "42")
        checkParsedNullIdentity(testName, "9223372036854775807", "9223372036854775807")
        checkParsedNullIdentity(testName, "0000000000000000000000009223372036854775807", "9223372036854775807")
    }
    void: unit_parserIdentity_rejectedRange(me string: testName) <- {
        me List<string>: inputs <- ["0", "000", "-1", "9223372036854775808", "18446744073709551615", "18446744073709551616", "99999999999999999999999999999999999999"]
        withEach idx in range 0 .. inputs.size(){
            me ProteusParser: parser{NULL, false, 0}
            parser.initParseFromString(testName, "NULL:"+inputs[idx])
            our infonView:: root
            parser.doParse(root)
            if(!parser.doesParseHaveError()){FAIL("Accepted invalid identity: "+inputs[idx])}
            if(root!.identityName!=NULL){FAIL("An invalid identity was registered")}
            me string: actual <- parser.errorMesg
            me string: expected <- "Null identity ID exceeds positive int64"
            if(idx<3){expected <- "Null identity ID must be positive"}
            REQUIRE(actual==expected)
            actual <- toString(parser.errLineNum)+":"+toString(parser.errCharPos)
            expected <- "1:6"; REQUIRE(actual==expected)
        }
    }
    void: unit_parserLifecycle_errorBeforeCompletion(me string: testName) <- {
        me ProteusCore: core; core.init("")
        our infonView:: root
        core.agent!.worldManager.prepareInput(root)
        our POV:: target{977}; target!.pItem <- root
        our WorldRequest: request <- core.agent!.normalize(target)
        me bool: waited <- request!.status().outcome==worldWaiting
        me ProteusParser: parser{core, false, 0}
        parser.initParseFromString(testName, "1 =")
        parser.doParse(root)
        me bool: errorPublished <- parser.doesParseHaveError() and request!.status().outcome==worldError
        me bool: sameError <- request!.error()==parser.formattedError()
        me bool: completed <- root!.streamState==parseDone
        core.deInit(); modelMngr.clear()
        me string: expected <- toString(true)
        me string: actual <- toString(waited); REQUIRE(actual==expected)
        actual <- toString(errorPublished); REQUIRE(actual==expected)
        actual <- toString(sameError); REQUIRE(actual==expected)
        actual <- toString(completed); REQUIRE(actual==expected)
    }
}

// Parsing one infon leaves later input available, in either parser mode.
struct GLOBAL {
    void: parse_prefixInput(me string: testName) <- {
        me List<string>: inputs <- ["1", "1 2", "1)", "1 /* comment */ 2", "1/", "1/\n"]
        withEach streamCase in range 0 .. 2{
            withEach input in inputs{
                me ProteusParser: parser{NULL, false, 0}
                parser.setStreamingMode(streamCase==1)
                parser.initParseFromString(testName, input)
                our infonView:: root
                parser.doParse(root)
                if(parser.doesParseHaveError()){FAIL(parser.formattedError())}
                if(root!.streamState!=parseDone){FAIL("The parsed infon was not marked complete")}
                me string: actual <- toString(root)
                me string: expected <- "1"
                REQUIRE(actual==expected)
            }
        }
    }
}

struct GLOBAL {
    void: parse_decimalInput(me string: testName) <- {
        me List<string>: inputs <- ["08", "010", "08/09", "0.25", "184467440737095516160"]
        me List<string>: outputs <- ["8", "10", "8/9", "0.25", "184467440737095516160"]
        withEach idx in range 0 .. inputs.size(){
            our infonView: root <- parseAndExtract(testName, inputs[idx])
            if(root==NULL){FAIL("Decimal input failed: "+inputs[idx])}
            me string: actual <- toString(root)
            me string: expected <- outputs[idx]
            REQUIRE(actual==expected)
        }
        testParseError(testName, "1/0", "Invalid decimal number", 1, 1)
        testParseError(testName, "0/0", "Invalid decimal number", 1, 1)
    }
}

// Parser metadata matters independently of a successful textual round trip.
struct GLOBAL {
    void: unit_parserWords_parameters(me string: testName) <- {
        our infonView: parsed <- parseAndExtract(testName, "{#give(actor, item, object) <en verb> = {%actor %item %object}}")
        if(parsed==NULL){FAIL("Parameterized definition did not parse")}
        our infonView: declaration <- parsed!.value!.items.head!.pItem
        our WordDefn: definition <- declaration!.definedWord
        if(definition==NULL or !definition!.hasParameterList or definition!.parameterNames.size()!=3){FAIL("Parameter signature was lost")}
        if(definition!.parameterNames[0]!="actor" or definition!.parameterNames[1]!="item" or definition!.parameterNames[2]!="object"){FAIL("Parameter declaration order changed")}
        if(!definition!.tagExists("en") or !definition!.tagExists("verb")){FAIL("Usage tags were lost")}
        our POV: reference <- declaration!.funcArgs!.value!.items.head
        withEach name in definition!.parameterNames{
            if(reference==NULL or reference!.pItem!.viewMode!=vmCursor or reference!.pItem!.cursorMode!=cmParameter or reference!.pItem!.parameterName!=name){FAIL("Body parameter was parsed as a context cursor")}
            our infonView:: copied
            reference!.pItem!.copyAsTypeTo(copied, true, true)
            if(copied!.cursorMode!=cmParameter or copied!.parameterName!=name){FAIL("Copy lost the parameter reference")}
            reference <- reference!.next
        }
        me string: printed <- toString(parsed)
        our infonView: again <- parseAndExtract(testName, printed)
        if(again==NULL or again!.value!.items.head!.pItem!.definedWord!.parameterNames.size()!=3){FAIL("Signature did not round trip")}
        // Registering a declaration must preserve its signature too.
        me Agent: agent
        our POV:: input{501}; input!.pItem <- parsed
        our WorldRequest: request <- agent.normalize(input)
        if(request!.failed()){FAIL("Could not register the declaration")}
        our infonView: use <- parseAndExtract(testName, "give")
        our POV:: target{501}; target!.pItem <- use
        request <- agent.normalize(target)
        if(request!.failed()){FAIL("Omitted parameters should permit partial normalization: "+request!.error())}
        agent.endWorldSessions(); modelMngr.clear()
    }
    void: unit_parserWords_invalidParameters(me string: testName) <- {
        me List<string>: inputs <- [
            "{#give(item, item)=_}", "{#give(item,)=_}", "{#give(,item)=_}",
            "{#give(item actor)=_}", "{#give(item=_)=_}", "{#give(7)=_}",
            "{#give(item = _}", "{#give(item)=%other}",
            "{#outer(item)={#inner=%item}}", "{#outer(item)={#inner(other)=%item}}",
            "{#give(item)=%item %item}", "{#give: item = _}"
        ]
        withEach input in inputs{
            me ProteusParser: parser{NULL, false, 0}
            parser.initParseFromString(testName, input)
            our infonView:: result; parser.doParse(result)
            if(!parser.doesParseHaveError()){FAIL("Invalid declaration was accepted: "+input)}
        }
        me List<string>: reserved <- ["self", "W", "U", "ctx", "args", "vars", "prev", "next", "tprev", "tnext", "INSERT", "PROTEUS", "NULL", "T", "S"]
        withEach name in reserved{
            me ProteusParser: parser{NULL, false, 0}
            parser.initParseFromString(testName, "{#give("+name+")=_}")
            our infonView:: result; parser.doParse(result)
            if(!parser.doesParseHaveError() or findString(parser.errorMesg, "Reserved parameter name")<0){FAIL("Reserved parameter name was not diagnosed: "+name)}
        }
    }
    void: unit_parserWords_nestedScope(me string: testName) <- {
        // Ordinary nested lists retain the body scope; definitions replace it.
        our infonView: parsed <- parseAndExtract(testName, "{#outer(item)={#inner(other)=%other {%item}} #plain=7}")
        if(parsed==NULL){FAIL("Nested local scopes did not parse")}
        our infonView: outer <- parsed!.value!.items.head!.pItem
        our infonView: inner <- outer!.funcArgs!.value!.items.head!.pItem
        if(inner!.definedWord!.parameterNames[0]!="other" or inner!.funcArgs!.parameterName!="other"){FAIL("Nested signature lost its own scope")}
        our infonView: after <- outer!.funcArgs!.value!.items.head!.next!.pItem
        if(after!.value!.items.head!.pItem!.parameterName!="item"){FAIL("Outer scope was not restored")}
        if(parsed!.value!.items.head!.next!.pItem!.definedWord!.hasParameterList){FAIL("Signature leaked to the next declaration")}
    }
    void: unit_parserWords_streamedSyntax(me string: testName) <- {
        me string: source <- "{#give(actor, item) = %item^T@[1]^S give(actor::3, item::4)}"
        me List<int>: cuts <- [7, 10, 13, 24, 26, 29, 32, 40, 47, 56, 58]
        withEach cut in cuts{
            me ProteusCore: core; core.init("")
            me strBuf: input; input.init(testName); input.putStr(source.subStr(0, cut))
            our ProteusParser:: parser{core, true, 0}; parser!.initParseFromStream(input)
            our infonView:: root
            me ParserInputWorker: reader; reader.core <- core; reader.parser <- parser; reader.root <- root
            reader.entered.wait(); reader.start(); reader.entered.wait()
            me ParserInputQuery: query; query.core <- core; query.watched <- root; query.start()
            me int: elapsed
            while(!query.isDone() and elapsed<2000){sleep(5); elapsed <+- 5}
            me bool: progressed <- query.isDone()
            input.putStr(source.subStr(cut)); input.close()
            reader.waitForExit(); query.waitForExit()
            me bool: parsed <- !parser!.doesParseHaveError()
            me string: actual <- toString(root)
            core.deInit(); modelMngr.clear()
            if(!progressed or !parsed){FAIL("Split syntax did not resume at offset "+toString(cut))}
            me string: expected <- source; REQUIRE(actual==expected)
        }
    }
    void: unit_parserViews_structure(me string: testName) <- {
        our infonView: parsed <- parseAndExtract(testName, "cube^T@[1]^S.location")
        if(parsed==NULL or parsed!.partRef==NULL or parsed!.partRef!.pathMode!=asTSpanField){FAIL("^T became an external property")}
        our PartPath: temporal <- parsed!.partRef
        if(temporal!.path!.partRef!=NULL or temporal!.continuation==NULL){FAIL("Selection was swallowed into the view descriptor")}
        our PartPath: index <- temporal!.continuation!.partRef
        if(index==NULL or index!.pathMode!=idxField or index!.continuation==NULL){FAIL("Temporal member selection was lost")}
        our PartPath: state <- index!.continuation!.partRef
        if(state==NULL or state!.pathMode!=asSListField or state!.continuation==NULL){FAIL("^S was lost after the index")}
        if(state!.continuation!.partRef==NULL or state!.continuation!.partRef!.pathMode!=dotField){FAIL("Selected S-state field was lost")}
        our infonView: identity <- parseAndExtract(testName, "cube^T = {T 1 2}")
        if(identity==NULL or identity!.partRef!.continuation==NULL or identity!.partRef!.continuation!.wrkList.size()!=1 or !identity!.partRef!.path!.wrkList.isEmpty()){FAIL("Identity was attached to the view descriptor instead of its result")}
        me List<string>: properties <- ["cube^size", "cube^Timeline", "cube^State", "cube^t", "cube^s"]
        withEach text in properties{
            our infonView: property <- parseAndExtract(testName, text)
            if(property==NULL or property!.partRef!.pathMode!=upField){FAIL("Ordinary external property was captured as a view")}
        }
    }
    void: unit_parserViews_unsupported(me string: testName) <- {
        me List<string>: inputs <- ["{x:1}^T", "{T {x:1} {x:2}}@[1]^S"]
        withEach input in inputs{
            me Agent: agent
            me WorldParseResult: parsed <- agent.worldManager.parse(input)
            if(parsed.target==NULL){FAIL(parsed.error)}
            our WorldRequest: request <- agent.normalize(parsed.target)
            me bool: unsupported <- request!.status().outcome==worldUnsupported
            me string: detail <- request!.error()
            agent.endWorldSessions(); modelMngr.clear()
            if(!unsupported or detail!="Temporal view conversion is not implemented"){FAIL("Unimplemented view was treated as an external association")}
        }
    }
}

// Calls use the production parser, request lifecycle and shared declarations.
struct GLOBAL {
    void: unit_wordArguments_isolation(me string: testName) <- {
        me Agent: agent; Allocate(agent.identityRegistry); agent.worldManager.control!.identities <- agent.identityRegistry
        me WorldParseResult: declarations <- agent.worldManager.parse("{#ident(item)=%item #outer(item)=ident(item::%item) #constant(item)=5}")
        if(declarations.target==NULL){FAIL(declarations.error)}
        me string: before <- toString(declarations.target!.pItem)
        our WorldRequest: request <- agent.normalize(declarations.target)
        if(request!.failed()){FAIL(request!.error())}
        me List<string>: calls <- ["ident(item::3)", "ident(item::8)", "outer(item::9)", "constant(item::unavailable)"]
        me List<int>: expectedValues <- [3, 8, 9, 5]
        withEach idx in range 0 .. calls.size(){
            me WorldParseResult: call <- agent.worldManager.parse(calls[idx])
            if(call.target==NULL){FAIL(call.error)}
            request <- agent.normalize(call.target)
            if(request!.failed() or call.target!.pItem!.fetchInt()!=expectedValues[idx]){FAIL("Application failed: "+calls[idx]+": "+request!.error())}
            our WordUse: binding <- call.target!.pItem!.type
            request <- agent.normalize(call.target)
            if(request!.failed() or call.target!.pItem!.type!.baseDefinition!==binding!.baseDefinition){FAIL("Application rebound on repeated normalization")}
            if(request!.framesCreated!=0 or request!.queueSteps!=0){FAIL("Completed application repeated normalization work")}
        }
        me List<int>: widths <- [16, 32, 64]
        withEach width in widths{
            me string: input <- "{"
            withEach idx in range 0 .. width{input <+- "ident("+toString(idx)+") "}
            input <+- "}"
            me WorldParseResult: batch <- agent.worldManager.parse(input)
            request <- agent.normalize(batch.target)
            if(!request!.complete()){FAIL("Independent call batch did not complete: "+request!.error())}
            our POV: member <- batch.target!.pItem!.value!.items.head
            withEach idx in range 0 .. width{
                if(member==NULL or member!.pItem!.fetchInt()!=idx){FAIL("Batch application mixed argument values")}
                member <- member!.next
            }
            print("Word arguments ", width, ": frames=", request!.framesCreated,
                " relationships=", request!.relationshipsRead, " queue=", request!.queueSteps,
                " sequenceVisits=", request!.sequenceVisits, "\n")
        }
        me string: after <- toString(declarations.target!.pItem)
        agent.endWorldSessions(); modelMngr.clear()
        REQUIRE(after==before)
    }
    void: unit_wordArguments_invalidCalls(me string: testName) <- {
        me List<string>: malformed <- ["ident(item::1,item::2)", "ident(item::)", "ident(1,)", "ident(1 item::2)", "ident(1,item::2)", "ident(item::1,2)", "ident(item::1"]
        withEach input in malformed{
            me ProteusParser: parser{NULL, false, 0}; parser.initParseFromString(testName, input)
            our infonView:: value; parser.doParse(value)
            if(!parser.doesParseHaveError()){FAIL("Invalid call parsed: "+input)}
        }
        me Agent: agent; Allocate(agent.identityRegistry); agent.worldManager.control!.identities <- agent.identityRegistry
        me WorldParseResult: declarations <- agent.worldManager.parse("{#ident(item)=%item #plain=7}")
        our WorldRequest: request <- agent.normalize(declarations.target)
        me List<string>: invalid <- ["ident(other::1)", "ident(1,2)", "plain(item::1)", "plain(1)"]
        withEach input in invalid{
            me WorldParseResult: call <- agent.worldManager.parse(input)
            if(call.target==NULL){FAIL(call.error)}
            me string: before <- toString(call.target!.pItem)
            request <- agent.normalize(call.target)
            if(request!.status().outcome!=worldRejected or toString(call.target!.pItem)!=before){FAIL("Invalid binding did not reject atomically: "+input)}
        }
        me WorldParseResult: recursive <- agent.worldManager.parse("{#repeat(item)=repeat(item::%item)}")
        request <- agent.normalize(recursive.target)
        recursive <- agent.worldManager.parse("repeat(1)")
        request <- agent.normalize(recursive.target)
        if(request!.status().outcome!=worldUnsupported){FAIL("Unbounded recursive application was not diagnosed")}
        me WorldParseResult: shared <- agent.worldManager.parse("{#change(item)=%item.x=7; #holder=change(item::{x:_})}")
        request <- agent.normalize(shared.target)
        me string: before <- toString(shared.target!.pItem)
        me WorldParseResult: call <- agent.worldManager.parse("holder")
        request <- agent.normalize(call.target)
        if(request!.status().outcome!=worldUnsupported or toString(shared.target!.pItem)!=before){FAIL("Borrowed argument literal was modified or lost its scope")}
        agent.endWorldSessions(); modelMngr.clear()
    }
    void: unit_wordArguments_partial(me string: testName) <- {
        me Agent: agent; Allocate(agent.identityRegistry); agent.worldManager.control!.identities <- agent.identityRegistry
        me WorldParseResult: declarations <- agent.worldManager.parse("{#ident(item)=%item #fixed(item)=%item=7 #same(item)={%item %item} #grouped(item)={(%item) (%item)}}")
        our WorldRequest: request <- agent.normalize(declarations.target)
        me WorldParseResult: missing <- agent.worldManager.parse("ident()")
        request <- agent.normalize(missing.target)
        if(request!.status().outcome!=worldPartial){FAIL("Missing argument was not left partial: "+request!.error())}
        me WorldParseResult: constrained <- agent.worldManager.parse("fixed()")
        request <- agent.normalize(constrained.target)
        if(request!.failed() or constrained.target!.pItem!.fetchInt()!=7){FAIL("Model did not constrain the omitted argument: "+request!.error())}
        me WorldParseResult: conflict <- agent.worldManager.parse("fixed(8)")
        request <- agent.normalize(conflict.target)
        if(request!.status().outcome!=worldRejected){FAIL("Argument conflict was not rejected")}
        me WorldParseResult: caller <- agent.worldManager.parse("{_ fixed(item::%prev)}")
        request <- agent.normalize(caller.target)
        if(!request!.complete() or caller.target!.pItem!.value!.items.head!.pItem!.fetchInt()!=7){FAIL("Argument deduction did not reach the caller's returned occurrence: "+request!.error())}
        me List<string>: inverse <- ["same():{7 8}", "grouped():{7 8}", "same(_):{7 8}", "ident()=7"]
        withEach input in inverse{
            me WorldParseResult: call <- agent.worldManager.parse(input)
            request <- agent.normalize(call.target)
            if(request!.status().outcome!=worldUnsupported){FAIL("Unproved inverse binding was accepted: "+input+": "+request!.error())}
        }
        conflict <- agent.worldManager.parse("same(7):{7 8}")
        request <- agent.normalize(conflict.target)
        if(request!.status().outcome!=worldRejected){FAIL("Repeated known argument conflict was not rejected")}
        missing <- agent.worldManager.parse("ident()")
        request <- agent.normalize(missing.target)
        if(!missing.target!.pItem!.parameterBindingRequired){FAIL("Partial argument lost its binding obligation")}
        me WorldParseResult: extraValue <- agent.worldManager.parse("7")
        our POV: extra <- extraValue.target
        missing.target!.pItem!.wrkList.append(extra); missing.target!.pItem!.noteNormalizationWork()
        request <- agent.normalize(missing.target)
        if(request!.status().outcome!=worldUnsupported){FAIL("Published unknown argument became an independent wildcard")}
        agent.endWorldSessions(); modelMngr.clear()
    }
}

// Required display facts use ordinary CodeDog and the production cursor API.
struct GLOBAL {
    our POV: cursorPreparedField(our TCursor: cursor, our POV: parent, me string: field) <- {
        our POV: value <- cursor!.preparedView(parent)
        if(value==NULL){return(NULL)}
        return(cursor!.preparedView(value!.pItem!.fetchField(field)))
    }
    void: unit_cursorReadiness_requiredValues(me string: testName) <- {
        me Agent: agent; Allocate(agent.identityRegistry); agent.worldManager.control!.identities <- agent.identityRegistry
        me WorldParseResult: parsed <- agent.worldManager.parse(
            "{T {thing:{location:{xLoc:0 yLoc:2 zLoc:(3 +4)}} color:_}}")
        if(parsed.target==NULL){FAIL(parsed.error)}
        our POV: first <- parsed.target!.pItem!.value!.items.head; first!.pParent <- parsed.target
        our infonView: sourceDescription <- first!.pItem
        me string: original <- toString(sourceDescription)
        our TCursor: cursor; Allocate(cursor, first); cursor!.attach(agent.worldManager, agent.startSession())
        me bool: registered <- cursor!.requireField("thing.location.xloc") and
            cursor!.requireField("thing.location.yloc") and cursor!.requireField("thing.location.zloc")
        if(!registered or !cursor!.refresh()){FAIL("Required fields did not become ready: "+cursor!.status().detail)}
        our POV: thing <- cursorPreparedField(cursor, cursor!.current, "thing")
        our POV: location <- cursorPreparedField(cursor, thing, "location")
        our POV: x <- cursorPreparedField(cursor, location, "xloc")
        our POV: z <- cursorPreparedField(cursor, location, "zloc")
        if(x==NULL or z==NULL){FAIL("Prepared coordinates are unavailable")}
        me string: actual <- toString(x!.pItem!.fetchInt())+":"+toString(z!.pItem!.fetchInt())
        me string: expected <- "0:7"; REQUIRE(actual==expected)
        actual <- toString(cursor!.requiredRequests); expected <- "5"; REQUIRE(actual==expected)
        actual <- toString(sourceDescription); expected <- original; REQUIRE(actual==expected)
        our POV: storedZ <- cursor!.current!.pItem!.fetchField("thing")!.pItem!.fetchField("location")!.pItem!.fetchField("zloc")
        if(storedZ==NULL or storedZ!.pItem!.fetchInt()!=7){FAIL("Required facts were not stored in the cursor occurrence")}
        if(cursor!.preparedView(first!.pItem!.fetchField("color"))!=NULL){FAIL("Optional color was demanded")}
        me uint64: frames <- cursor!.requiredFrames
        if(!cursor!.refresh() or cursor!.requiredFrames!=frames or cursor!.requiredRequests!=5){FAIL("Refresh repeated completed field work")}
        agent.endWorldSessions(); modelMngr.clear()
    }
    // Pending input is the original parser-owned header. Repeated refresh and
    // unrelated arrivals must retain the exact request and old displayed value.
    void: testCursorRequiredFailure(me string: testName, me int: scenario) <- {
        me Agent: agent; Allocate(agent.identityRegistry); agent.worldManager.control!.identities <- agent.identityRegistry
        me string: leaf <- "4"
        if(scenario==1){leaf <- "_"}
        if(scenario==3){leaf <- "4=5"}
        me WorldParseResult: parsed <- agent.worldManager.parse(
            "{T {pose:{x:1}} {pose:{x:"+leaf+"}}}")
        if(parsed.target==NULL){FAIL(parsed.error)}
        our POV: first <- parsed.target!.pItem!.value!.items.head; first!.pParent <- parsed.target
        our POV: second <- first!.next; second!.pParent <- parsed.target
        our TCursor: seed; Allocate(seed, first); seed!.attach(agent.worldManager, agent.startSession())
        if(!seed!.refresh()){FAIL("Initial cursor seed failed")}
        // Mark the literal destination as an available shallow state. Its
        // nested field must still be acquired by a cursor with requirements.
        agent.worldManager.graph.rememberCursorValue(second, NULL, worldPartial, true)
        our POV: pose <- second!.pItem!.fetchField("pose")
        our POV: field <- pose!.pItem!.fetchField("x")
        if(scenario==0 or scenario==4){agent.worldManager.prepareInput(field!.pItem)}
        if(scenario==2){pose!.pItem!.value!.items.clear()}
        our TCursor: cursor; Allocate(cursor, first); cursor!.attach(agent.worldManager, agent.startSession())
        cursor!.requireField("pose.x")
        if(!cursor!.refresh()){FAIL("Initial required field failed: "+cursor!.status().detail)}
        our POV: previous <- cursor!.current
        if(cursor!.goNext()){FAIL("Unready destination was presented")}
        if(cursor!.current!==previous or cursor!.position!.node!==first){FAIL("Unready movement changed the displayed occurrence")}
        if(scenario==0 or scenario==4){
            if(cursor!.status().outcome!=worldWaiting){FAIL("Parser dependency did not wait: "+cursor!.status().detail)}
            if(agent.worldManager.control!.inputWaiters.size()!=1){FAIL("Required input did not retain one subscription")}
            our WorldRequest: waiting <- cursor!.request
            me uint64: count <- cursor!.requiredRequests
            if(cursor!.refresh() or cursor!.request!==waiting or cursor!.requiredRequests!=count){FAIL("Waiting demand restarted")}
            our infonView:: unrelated; agent.worldManager.inputReady(unrelated)
            if(cursor!.request!==waiting or waiting!.status().outcome!=worldWaiting){FAIL("Unrelated arrival changed the demand")}
            if(scenario==4){
                waiting!.cancel()
                if(cursor!.refresh() or cursor!.status().outcome!=worldCancelled or cursor!.current!==previous){FAIL("Cancellation changed the displayed value")}
            }else{
                field!.pItem!.streamState <- parseDone; agent.worldManager.inputReady(field!.pItem)
                if(!cursor!.refresh() or cursor!.current!==second){FAIL("Required parser arrival did not finish the move: "+cursor!.status().detail)}
                our POV: result <- cursorPreparedField(cursor, cursorPreparedField(cursor, cursor!.current, "pose"), "x")
                if(result==NULL or result!.pItem!.fetchInt()!=4){FAIL("Resumed field has the wrong value")}
            }
            if(!agent.worldManager.control!.inputWaiters.isEmpty()){FAIL("Finished readiness retained a subscription")}
        }else{
            me WorldOutcome: expectedOutcome <- worldPartial
            if(scenario==3){expectedOutcome <- worldRejected}
            if(cursor!.pendingPosition!=NULL or cursor!.status().outcome!=expectedOutcome){FAIL("Exhausted readiness has wrong status: "+cursor!.status().detail)}
        }
        agent.endWorldSessions(); modelMngr.clear()
    }
    void: unit_cursorReadiness_waitAndResume(me string: testName) <- {testCursorRequiredFailure(testName, 0)}
    void: unit_cursorReadiness_unknown(me string: testName) <- {testCursorRequiredFailure(testName, 1)}
    void: unit_cursorReadiness_missing(me string: testName) <- {testCursorRequiredFailure(testName, 2)}
    void: unit_cursorReadiness_rejected(me string: testName) <- {testCursorRequiredFailure(testName, 3)}
    void: unit_cursorReadiness_cancelled(me string: testName) <- {testCursorRequiredFailure(testName, 4)}
    void: unit_cursorReadiness_navigation(me string: testName) <- {
        me Agent: agent; Allocate(agent.identityRegistry); agent.worldManager.control!.identities <- agent.identityRegistry
        me WorldParseResult: parsed <- agent.worldManager.parse("{T {pose:{x:1} color:_} {pose:{x:(2 +3)} color:_} {pose:{x:(6 +1)} color:_}}")
        if(parsed.target==NULL){FAIL(parsed.error)}
        our POV: first <- parsed.target!.pItem!.value!.items.head; first!.pParent <- parsed.target
        our TCursor: cursor; Allocate(cursor, first); cursor!.attach(agent.worldManager, agent.startSession())
        cursor!.requireField("pose.x")
        if(!cursor!.refresh() or !cursor!.goNext() or !cursor!.goNext()){FAIL("Forward readiness failed: "+cursor!.status().detail)}
        if(!cursor!.goPrev()){FAIL("Cached backward readiness failed: "+cursor!.status().detail)}
        our POV: x <- cursorPreparedField(cursor, cursorPreparedField(cursor, cursor!.current, "pose"), "x")
        if(x==NULL or x!.pItem!.fetchInt()!=5 or cursor!.current!==first!.next){FAIL("Prepared values belong to the wrong occurrence")}
        if(!cursor!.goPrev() or cursor!.current!==first){FAIL("Repeated backward movement failed")}
        if(cursor!.session!.requests.size()>1){FAIL("Completed readiness requests accumulated")}
        agent.endWorldSessions(); modelMngr.clear()
    }
    void: unit_cursorReadiness_legacy(me string: testName) <- {
        me Agent: agent; Allocate(agent.identityRegistry); agent.worldManager.control!.identities <- agent.identityRegistry
        me WorldParseResult: parsed <- agent.worldManager.parse("{T {pose:{x:_}} {pose:{x:2}}}")
        if(parsed.target==NULL){FAIL(parsed.error)}
        our POV: first <- parsed.target!.pItem!.value!.items.head; first!.pParent <- parsed.target
        our TCursor: cursor; Allocate(cursor, first); cursor!.attach(agent.worldManager, agent.startSession())
        if(!cursor!.refresh() or cursor!.requiredRequests!=0 or !cursor!.goNext()){FAIL("Default shallow cursor behavior changed")}
        agent.endWorldSessions(); modelMngr.clear()
    }
}

struct GLOBAL {
    void: unit_cursorReadiness_atomicFields(me string: testName) <- {
        me Agent: agent; Allocate(agent.identityRegistry); agent.worldManager.control!.identities <- agent.identityRegistry
        me WorldParseResult: parsed <- agent.worldManager.parse("{T {pose:{x:1 y:2}} {pose:{x:(3 +4) y:_}}}")
        if(parsed.target==NULL){FAIL(parsed.error)}
        our POV: first <- parsed.target!.pItem!.value!.items.head; first!.pParent <- parsed.target
        our POV: second <- first!.next; second!.pParent <- parsed.target
        agent.worldManager.graph.rememberCursorValue(second, NULL, worldPartial, true)
        me string: before <- toString(second!.pItem)
        our TCursor: cursor; Allocate(cursor, first); cursor!.attach(agent.worldManager, agent.startSession())
        cursor!.requireField("pose.x"); cursor!.requireField("pose.y")
        if(!cursor!.refresh()){FAIL("Initial pose was not ready")}
        our POV: oldX <- cursorPreparedField(cursor, cursorPreparedField(cursor, cursor!.current, "pose"), "x")
        if(cursor!.goNext() or cursor!.status().outcome!=worldPartial){FAIL("Unknown required axis was presented")}
        if(cursor!.current!==first or oldX!.pItem!.fetchInt()!=1){FAIL("Partial preparation changed the old view")}
        me string: actual <- toString(second!.pItem); me string: expected <- before; REQUIRE(actual==expected)
        agent.endWorldSessions(); modelMngr.clear()
    }
    void: unit_cursorReadiness_readOnly(me string: testName) <- {
        me Agent: agent; Allocate(agent.identityRegistry); agent.worldManager.control!.identities <- agent.identityRegistry
        me WorldParseResult: parsed <- agent.worldManager.parse("{T {pose:{x:1}} {pose:{x:4}}}")
        if(parsed.target==NULL){FAIL(parsed.error)}
        our POV: first <- parsed.target!.pItem!.value!.items.head; first!.pParent <- parsed.target
        our POV: second <- first!.next; second!.pParent <- parsed.target
        our POV: input <- second!.pItem!.fetchField("pose")!.pItem!.fetchField("x")
        me string: before <- toString(parsed.target!.pItem)
        our TCursor: cursor; Allocate(cursor, first); cursor!.attach(agent.worldManager, agent.startSession())
        cursor!.position!.writable <- false; cursor!.requireField("pose.x")
        if(!cursor!.refresh()){FAIL("Read-only initial pose failed")}
        our POV: displayed <- cursor!.current
        me string: oldValue <- toString(displayed!.pItem)
        agent.worldManager.prepareInput(input!.pItem)
        if(cursor!.goNext() or cursor!.status().outcome!=worldWaiting){FAIL("Read-only destination did not wait")}
        me string: actual <- toString(displayed!.pItem); me string: expected <- oldValue; REQUIRE(actual==expected)
        input!.pItem!.streamState <- parseDone; agent.worldManager.inputReady(input!.pItem)
        if(!cursor!.refresh() or cursor!.current!==displayed){FAIL("Read-only cursor did not reuse its working value")}
        our POV: result <- cursorPreparedField(cursor, cursorPreparedField(cursor, cursor!.current, "pose"), "x")
        if(result==NULL or result!.pItem!.fetchInt()!=4){FAIL("Read-only prepared field is wrong")}
        actual <- toString(parsed.target!.pItem); expected <- before; REQUIRE(actual==expected)
        agent.endWorldSessions(); modelMngr.clear()
    }
    void: unit_cursorReadiness_scaling(me string: testName) <- {
        me int: width <- 8
        while(width<=128){
            me Agent: agent; Allocate(agent.identityRegistry); agent.worldManager.control!.identities <- agent.identityRegistry
            me string: text <- "{T {"
            withEach idx in range 0 .. width{text <+- "field"+toString(idx)+":"+toString(idx)+" "}
            text <+- "}}"
            me WorldParseResult: parsed <- agent.worldManager.parse(text)
            if(parsed.target==NULL){FAIL(parsed.error)}
            our POV: first <- parsed.target!.pItem!.value!.items.head; first!.pParent <- parsed.target
            our TCursor: cursor; Allocate(cursor, first); cursor!.attach(agent.worldManager, agent.startSession())
            withEach idx in range 0 .. width{cursor!.requireField("field"+toString(idx))}
            if(!cursor!.refresh()){FAIL("Wide readiness failed: "+cursor!.status().detail)}
            if(cursor!.requiredRequests!=width or cursor!.requiredMembersScanned!=width or cursor!.requiredFrames>width*3){FAIL("Required siblings repeated their parent scan")}
            print("READINESS width=",width," requests=",cursor!.requiredRequests," frames=",cursor!.requiredFrames,
                " queue=",cursor!.requiredQueueSteps," relationships=",cursor!.requiredRelationships," members=",cursor!.requiredMembersScanned,"\n")
            agent.endWorldSessions(); modelMngr.clear(); width <*- 4
        }
    }
}


struct GLOBAL {
    void: unit_embeddedNeighbours_boundaries(me string: testName) <- {
        me Agent: agent; Allocate(agent.identityRegistry); agent.worldManager.control!.identities <- agent.identityRegistry
        me List<string>: inputs <- ["{1 &{2 ...} %prev}", "{%next &{...} 3}", "{1 &*1000000000+{_|...} %prev}", "{1 &*5+{2 3} %prev}"]
        withEach input in inputs{
            me WorldParseResult: parsed <- agent.worldManager.parse(input)
            our POV: target <- parsed.target!.pItem!.value!.items.tail
            if(parsed.target!.pItem!.value!.items.head!.pItem!.cursorMode==cmNext){target <- parsed.target!.pItem!.value!.items.head}
            target!.pParent <- parsed.target
            our WorldRequest: request <- agent.normalize(target)
            if(request!.status().outcome!=worldPartial){FAIL("Unknown boundary was treated as an endpoint: "+input+": "+request!.error())}
            if(request!.correspondencePositions>100 or request!.framesCreated>100){FAIL("Unknown span was enumerated")}
        }
        me WorldParseResult: parsed <- agent.worldManager.parse("{&{7} &{7} %prev}")
        our POV: target <- parsed.target!.pItem!.value!.items.tail; target!.pParent <- parsed.target
        our POV: expectedSource <- target!.prev!.pItem!.value!.items.head
        our WorldRequest: request <- agent.normalize(target)
        if(!request!.complete() or target!.pItem!.fetchInt()!=7 or request!.selectedSource()!==expectedSource){FAIL("Neighbour lost its occurrence identity")}
        parsed <- agent.worldManager.parse("{#loop={&loop}}")
        request <- agent.normalize(parsed.target)
        parsed <- agent.worldManager.parse("{%next &loop}@[1]")
        request <- agent.normalize(parsed.target)
        if(request!.status().outcome!=worldUnsupported or request!.namedLayouts>10){FAIL("Recursive layout did not stop at a finite boundary")}
        parsed <- agent.worldManager.parse("{#local={_ %prev=7}}")
        request <- agent.normalize(parsed.target)
        me string: before <- toString(parsed.target!.pItem)
        me WorldParseResult: call <- agent.worldManager.parse("local")
        request <- agent.normalize(call.target)
        if(request!.status().outcome!=worldUnsupported or toString(parsed.target!.pItem)!=before){FAIL("Neighbour constraint modified a shared declaration")}
        agent.endWorldSessions(); modelMngr.clear()
    }
    void: unit_embeddedNeighbours_waiting(me string: testName) <- {
        withEach scenario in range 0 .. 3{
            me Agent: agent; Allocate(agent.identityRegistry); agent.worldManager.control!.identities <- agent.identityRegistry
            me string: source <- "{&{7} %prev}"
            if(scenario==1){source <- "{%next &{7}}"}
            me WorldParseResult: parsed <- agent.worldManager.parse(source)
            our POV: target <- parsed.target!.pItem!.value!.items.tail
            our POV: pending <- parsed.target!.pItem!.value!.items.head
            if(scenario==1){target <- pending; pending <- parsed.target!.pItem!.value!.items.tail}
            target!.pParent <- parsed.target
            agent.worldManager.prepareInput(pending!.pItem)
            our WorldRequest: request <- agent.normalize(target)
            if(request!.status().outcome!=worldWaiting or agent.worldManager.control!.inputWaiters.size()!=1){FAIL("Neighbour did not retain one parser wait")}
            me uint64: frames <- request!.framesCreated
            me uint64: queue <- request!.queueSteps
            me uint64: ancestors <- request!.neighbourAncestors
            me WorldParseResult: unrelated <- agent.worldManager.parse("9")
            agent.worldManager.inputReady(unrelated.target!.pItem)
            if(request!.framesCreated!=frames or request!.queueSteps!=queue){FAIL("Unrelated arrival repeated neighbour work")}
            if(scenario==2){request!.cancel()}
            pending!.pItem!.streamState <- parseDone; agent.worldManager.inputReady(pending!.pItem)
            if(scenario==2){
                if(request!.status().outcome!=worldCancelled or target!.pItem!.viewMode!=vmCursor){FAIL("Cancelled neighbour published")}
            }else if(!request!.complete() or target!.pItem!.fetchInt()!=7 or request!.neighbourAncestors!=ancestors){FAIL("Neighbour did not continue at its retained boundary: "+request!.error())}
            if(!agent.worldManager.control!.inputWaiters.isEmpty()){FAIL("Finished neighbour retained a subscription")}
            agent.endWorldSessions(); modelMngr.clear()
        }
    }
    void: unit_embeddedNeighbours_scaling(me string: testName) <- {
        me List<int>: widths <- [16, 32, 64]
        withEach forward in range 0 .. 2{
            withEach width in widths{
                me Agent: agent; Allocate(agent.identityRegistry); agent.worldManager.control!.identities <- agent.identityRegistry
                me string: input <- "{0 "
                if(forward==1){input <- "{"}
                withEach idx in range 0 .. width{
                    if(forward==1){input <+- "&{(%next +1)} "}else{input <+- "&{(%prev +1)} "}
                }
                if(forward==1){input <+- "0"}
                input <+- "}"
                me WorldParseResult: parsed <- agent.worldManager.parse(input)
                our WorldRequest: request <- agent.normalize(parsed.target)
                if(!request!.complete()){FAIL("Embedded recurrence did not complete: "+request!.error())}
                our POV: edge <- parsed.target!.pItem!.value!.items.tail
                if(forward==1){edge <- parsed.target!.pItem!.value!.items.head}
                if(edge!.pItem!.value!.items.head!.pItem!.fetchInt()!=width){FAIL("Embedded recurrence produced the wrong endpoint")}
                print("Neighbours width ", width, " direction ", forward, ": frames=", request!.framesCreated,
                    " relationships=", request!.relationshipsRead, " queue=", request!.queueSteps,
                    " positions=", request!.correspondencePositions, " ancestors=", request!.neighbourAncestors,
                    " levels=", request!.neighbourLevelsCreated, " peak=", request!.neighbourPeakLevels, "\n")
                if(request!.framesCreated>20*width+20 or request!.queueSteps>100*width+100 or
                   request!.correspondencePositions>20*width+20 or request!.neighbourAncestors>5*width+5){FAIL("Fixed-width neighbour work exceeded a linear bound")}
                agent.endWorldSessions(); modelMngr.clear()
            }
        }
        withEach depth in widths{
            me Agent: agent; Allocate(agent.identityRegistry); agent.worldManager.control!.identities <- agent.identityRegistry
            me WorldParseResult: nested <- agent.worldManager.parse("{%prev}")
            withEach level in range 0 .. depth{
                me WorldParseResult: wrapper <- agent.worldManager.parse("{&{}}")
                wrapper.target!.pItem!.value!.items.head!.pItem <- nested.target!.pItem
                wrapper.target!.pItem!.infSize!.evalMode <- emUnknown
                nested <- wrapper
            }
            me WorldParseResult: root <- agent.worldManager.parse("{7 &{}}")
            root.target!.pItem!.value!.items.tail!.pItem <- nested.target!.pItem
            root.target!.pItem!.infSize!.evalMode <- emUnknown
            our WorldRequest: request <- agent.normalize(root.target)
            if(!request!.complete()){FAIL("Deep embedded neighbour failed: "+request!.error())}
            our POV: value <- root.target!.pItem!.value!.items.tail
            withEach level in range 0 .. depth+1{value <- value!.pItem!.value!.items.head}
            if(value!.pItem!.fetchInt()!=7){FAIL("Deep neighbour reached the wrong scope")}
            print("Neighbours depth ", depth, ": frames=", request!.framesCreated, " relationships=", request!.relationshipsRead,
                " queue=", request!.queueSteps, " positions=", request!.correspondencePositions, " ancestors=", request!.neighbourAncestors,
                    " levels=", request!.neighbourLevelsCreated, " peak=", request!.neighbourPeakLevels, "\n")
            if(request!.framesCreated>20*depth+40 or request!.correspondencePositions>20*depth+40 or request!.neighbourAncestors>depth+3){FAIL("Deep neighbour expanded unrelated structure")}
            agent.endWorldSessions(); modelMngr.clear()
        }
        // Local neighbours under many embedded ancestors must not seed or
        // retain an entire ancestor stack for every member.
        me Agent: localAgent; Allocate(localAgent.identityRegistry); localAgent.worldManager.control!.identities <- localAgent.identityRegistry
        me string: localInput <- "{0 "
        withEach idx in range 0 .. 64{localInput <+- "(%prev +1) "}
        localInput <+- "}"
        me WorldParseResult: local <- localAgent.worldManager.parse(localInput)
        withEach level in range 0 .. 64{
            me WorldParseResult: wrapper <- localAgent.worldManager.parse("{&{}}")
            wrapper.target!.pItem!.value!.items.head!.pItem <- local.target!.pItem
            wrapper.target!.pItem!.infSize!.evalMode <- emUnknown; local <- wrapper
        }
        our WorldRequest: localRequest <- localAgent.normalize(local.target)
        if(!localRequest!.complete() or localRequest!.neighbourAncestors!=64 or localRequest!.neighbourLevelsCreated!=64 or
           localRequest!.neighbourPeakLevels!=1){FAIL("Local adjacency walked or retained unrelated ancestor levels")}
        our POV: localValue <- local.target
        withEach level in range 0 .. 64{localValue <- localValue!.pItem!.value!.items.head}
        if(localValue!.pItem!.value!.items.tail!.pItem!.fetchInt()!=64){FAIL("Deep local recurrence changed its values")}
        localAgent.endWorldSessions(); modelMngr.clear()
    }
    void: unit_embeddedNeighbours_sharedEmpty(me string: testName) <- {
        me List<int>: depths <- [16, 32, 64]
        withEach form in range 0 .. 2{
        withEach depth in depths{
            me Agent: agent; Allocate(agent.identityRegistry); agent.worldManager.control!.identities <- agent.identityRegistry
            me string: leaf <- "{}"
            if(form==1){leaf <- "*0+{_|...}"}
            me WorldParseResult: nested <- agent.worldManager.parse(leaf)
            if(form==0){nested.target!.pItem!.infSize!.evalMode <- emUnknown}
            withEach level in range 0 .. depth{
                me WorldParseResult: pair <- agent.worldManager.parse("{&{} &{}}")
                pair.target!.pItem!.value!.items.head!.pItem <- nested.target!.pItem
                pair.target!.pItem!.value!.items.tail!.pItem <- nested.target!.pItem
                pair.target!.pItem!.infSize!.evalMode <- emUnknown
                nested <- pair
            }
            me WorldParseResult: root <- agent.worldManager.parse("{7 &{} %prev}")
            root.target!.pItem!.value!.items.head!.next!.pItem <- nested.target!.pItem
            our POV: target <- root.target!.pItem!.value!.items.tail; target!.pParent <- root.target
            our WorldRequest: request <- agent.normalize(target)
            if(!request!.complete() or target!.pItem!.fetchInt()!=7){FAIL("Shared empty layout changed the neighbour: "+request!.error())}
            print("Neighbours shared-empty form ", form, " depth ", depth, ": frames=", request!.framesCreated,
                " queue=", request!.queueSteps, " positions=", request!.correspondencePositions,
                " emptyHits=", request!.emptyLayoutHits, " levels=", request!.neighbourLevelsCreated, " peak=", request!.neighbourPeakLevels, "\n")
            if(request!.correspondencePositions>20*depth+20 or request!.neighbourLevelsCreated>4*depth+10 or
               request!.neighbourPeakLevels>depth+3){FAIL("Shared empty layout unfolded exponentially")}
            agent.endWorldSessions(); modelMngr.clear()
        }
        }
    }
}
