    GRAPHSLICE(unit/graphSlice/lateLayout, 42)
    me bool: graphSliceCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer normalizer;normalizer.init();
        std::string expression="{*10+1 *10+2 *10+3 *10+4}@[1:*2+{...}]",expected="{*10+2 *10+3}";
        switch(caseID) {
        case 1: expression="{*10+1 *10+2 *10+3}@[0:*2+{...}]";expected="{*10+1 *10+2}";break;
        case 2: expression="{*10+1 *10+2 *10+3}@[-2:*2+{...}]";break;
        case 3: expression="{*10+1 &{*10+2 &{*10+3}} *10+4}@[1:*2+{...}]";break;
        case 4: expression="{*10+1 {*10+2 *10+3} *10+4}@[1:*1+{...}]";expected="{{*10+2 *10+3}}";break;
        case 5: expression="{*10+1 *10+2 *10+3}@[1:*2+{...}]@[2]";expected="*10+3";break;
        case 6: expression="{a:*10+1 b:*10+2 c:*10+3}@[1:*2+{...}].b";expected="b:*10+2";break;
        case 7: expression="{*10+1 *10+2}@[0:*0+{...}]";expected="{}";break;
        case 8: expression="{*10+1 *10+2}@[3:*2+{...}]";expected="*_+[]";break;
        case 9: expression="{*10+1 *10+2}@[1:*2+{...}]";expected="*_+[]";break;
        case 10: expression="{*10+1 *10+2 *10+3 ...}@[1:*2+{...}]";break;
        case 11:case 12:case 13: expression="{*10+1 *10+2 *10+3 ...}@[-2:*2+{...}]";break;
        case 14: expression="*1000000000+{*10+7|...}@[100:*900000000+{...}]";expected="";break;
        case 26: expression="*_+[*1000000000+{*10+7|...}]@[100:*900000000+{...}]";expected="";break;
        case 15: expression="*1000000000+{*10+7|...}@[100:*900000000+{...}]@[900000000]";expected="*10+7";break;
        case 16: expression="{&*1000000000+{*10+7|...} *10+2}@[999999999:*2+{...}]@[2]";expected="*10+2";break;
        case 17: expression="{*10+1 *10+2}@[1:*10+2]";expected="*10+2";break;
        case 18: expression="{*10+1 *10+2}@[0:*10+2]";expected="*_+[]";break;
        case 19: expression="{*10+1 ?}@[1:*10+2]";expected="*10+2";break;
        case 20: expression="{*10+1 *10+2 *10+3}@[1:*_+{...}]";break;
        case 21: expression="{*10+1 *10+2 *10+3 *10+4}@[0:*3+{...}]@[1:*2+{...}]";break;
        case 22: expression="*_+[{*10+1 *10+2} {*10+3 *10+4}]@[0:*1+{...}]";expected="*_+[{*10+1} {*10+3}]";break;
        case 23: expression="{*10+1 *10+2 *10+3}@[1:{*10+2 *10+3}]";break;
        case 24: expression="{*10+1 *10+2 *10+3}@[1:{*10+2 *10+4}]";expected="*_+[]";break;
        case 25: expression="*_+[*3+{&{...} ...}]@[1:*2+{...}]";break;
        case 27: expression="{*10+1 ? *10+3}@[1:*2+{...}]";break;
        case 28: expression="{*10+1 *10+2}@[0:*2+{*10+2|...}]";break;
        case 29: expression="{*10+1 *10+2}@[0:*9223372036854775808+{...}]";break;
        case 30: expression="{&{...} *10+2 *10+3}@[1:*2+{...}]";break;
        case 31: expression="{*10+1 *10+2}@[2:*0+{...}]";expected="{}";break;
        case 32: expression="{*10+1 *10+2 *10+3}@[?:*2+{...}]";break;
        case 33: expression="{*10+1 *10+2}@[2:*10+2]";expected="*_+[]";break;
        case 34: expression="*_+[{*10+1} {*10+2}]@[0:{*10+2}]";expected="{*10+2}";break;
        case 35: expression="*_+[{*10+1 ...} {*10+2 *10+3}]@[1:*1+{...}]";expected="*_+[{*10+3} ... ]";break;
        case 36: expression="{*10+1 %prev *10+3}@[1:*1+{...}]";expected="{*10+1}";break;
        case 37: expression="{*10+1 %next *10+3}@[1:*1+{...}]";expected="{*10+3}";break;
        case 38: expression="*1000000000+{...}@[100:*900000000+{...}]";expected="";break;
        case 39: expression="{*10+1 *10+2}@[-1:*10+2]";expected="*10+2";break;
        case 40: expression="{*10+1 *10+2}@[0:*10+1]";expected="*10+1";break;
        case 42: expression="{&*1+{...} *10+2}@[0:*2+{...}]";expected="{*10+1 *10+2}";break;
        case 41: expression="{}@[0:*0+{...}]";expected="{}";break;
        }
        auto root=graphParsed(testName,expression);auto original=root->pItem;
        auto first=original->value->items.head;auto before=toString(original.get());
        proteus4::POVNode occurrence;
        if(caseID==25) normalizer.recordIdentity(original->innr->value->items.head,graphParsed(testName,"{*10+1 *10+2 *10+3}"));
        if(caseID==26) {
            normalizer.access->bind(original->innr->value->items.head);
            occurrence=normalizer.access->sparseItem(original->innr->value->items.head,105);
        }
        auto handle=normalizer.normalize(root);handle.waitForCompletion();
        bool passed=!handle.status().failed;
        if(caseID==11 || caseID==12 || caseID==13 || caseID==19 || caseID==20 || caseID==27 || caseID==30 || caseID==32 || caseID==42) {
            passed &= handle.status().symbolicValues && handle.status().withSubscribers;
            auto retained=caseID==42 ? root->pItem->selectedResult->pItem->value->items.tail : nullptr;
            if(caseID==13) handle.cancel();
            if(caseID==12 || caseID==13) normalizer.runtime.update([&] {
                auto source=root->pItem->pathSelection->source;
                SetFlagBit(source->pItem->value->flags,infonState::tailUnfinished,false);++source->workRevision;
            });
            if(caseID==19 || caseID==27) normalizer.addRHS(first->next,graphParsed(testName,"*10+2"));
            if(caseID==20) normalizer.addRHS(root->pItem->pathSelection->spec,graphParsed(testName,"*2+{...}"));
            if(caseID==30 || caseID==42) normalizer.addRHS(first,graphParsed(testName,"{*10+1}"));
            if(caseID==32) normalizer.addRHS(root->pItem->pathSelection->predicate,graphParsed(testName,"*10+1"));
            handle.waitForCompletion();
            if(caseID==42) passed &= root->pItem->selectedResult->pItem->value->items.tail==retained;
        }
        bool deferred=caseID==11 || caseID==13 || caseID==28 || caseID==29;
        if(deferred) {
            passed &= handle.status().symbolicValues && !root->pItem->selectedResult;
            if(caseID==13) passed &= handle.status().cancelled;
        } else {
            passed &= bool(root->pItem->selectedResult);
            if(!expected.empty()) passed &= toString(root->pItem.get())==expected;
            if(caseID==14 || caseID==26) {
                auto state=root->pItem->pathSelection;auto span=state->result->pItem->value->items.head;
                auto sparseSource=caseID==26 ? original->innr->value->items.head : state->source;
                passed &= sparseSource->pItem->value->items.size()==0 && span && getFlagBit(span->flags,POV::isSubItm) &&
                    span->pItem->value->items.size()==0 && span->pItem->infSize->num==900000000 &&
                    span->repetitionSpan.family==sparseSource->repetitionSpan.family && span->repetitionSpan.startOrdinal==100;
                passed &= span->repetitionSpan.family->occurrences.size()==(caseID==26 ? 1 : 0);
                if(caseID==26) {
                    auto query=normalizer.findItem(state->result,5);query.waitForCompletion();
                    passed &= query.result()==occurrence;query.cancel();
                }
            }
            bool symbolic=caseID==8 || caseID==9 || caseID==14 || caseID==18 || caseID==22 || caseID==24 ||
                caseID==26 || caseID==33 || caseID==35 || caseID==38;
            if(!symbolic) passed &= !handle.status().symbolicValues && getFlagBit(root->pItem->flags,infonView::isNormed);
            if(caseID==22 || caseID==34 || caseID==35) passed &= root->pItem->pathSelection->pending==(caseID==35);
            if(caseID==38) passed &= root->pItem->infSize->num==900000000 && handle.status().symbolicValues &&
                root->pItem->selectedResult->pItem->value->items.size()==1;
            auto selected=root->pItem->selectedResult;auto identities=normalizer.access->registry->identities.size();
            auto replay=normalizer.normalize(root);replay.waitForCompletion();
            passed &= !replay.status().failed && selected==root->pItem->selectedResult && identities==normalizer.access->registry->identities.size();
            replay.cancel();
        }
        if(caseID!=12 && caseID!=13 && caseID!=19 && caseID!=20 && caseID!=27 && caseID!=30 && caseID!=32 && caseID!=36 && caseID!=37 && caseID!=42)
            passed &= toString(original.get())==before;
        if(!passed) {
            std::cout << "Slice " << caseID << ": " << handle.status().error << " symbolic=" << handle.status().symbolicValues << "\n" << toString(root->pItem.get()) << "\n";
            for(const auto& step:handle.steps()) std::cout << step.action << "\n";
        }
        handle.cancel();normalizer.close();return passed;
    }%>
    void: unitTestGraphSlice(me string: testName, me int: caseID) <- {
        me bool: passed <- graphSliceCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHENDORIGIN(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphEndOrigin(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHENDORIGIN(unit/graphEndOrigin/last, 0)
    GRAPHENDORIGIN(unit/graphEndOrigin/marked, 1)
