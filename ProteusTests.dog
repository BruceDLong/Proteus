            passed &= handle.status().symbolicValues && gapA->pItem->value->items.isEmpty() && gapB->pItem->value->items.isEmpty();
        } else {
            auto middle=gapA->pItem->value->items.head;
            passed &= middle && getFlagBit(middle->flags,POV::isSubItm) && !getFlagBit(gapA->pItem->value->flags,infonState::tailUnfinished);
            if(middle) {
                passed &= gapA->pItem->value->items.size()==(caseID==2 ? 2u : 3u) && gapB->pItem->value->items.size()==2;
                auto other=gapB->pItem->value->items.tail;
                passed &= other && getFlagBit(other->flags,POV::isSubItm);
                if(caseID==6) passed &= normalizer.access->listExtent(root)==4 && !handle.status().symbolicValues;
                else passed &= handle.status().symbolicValues && !getFlagBit(root->pItem->flags,infonView::isNormed);
                if(caseID==7) {
                    passed &= middle->pItem->infSize->num==999999996 && middle->pItem->value->items.isEmpty();
                    auto printed=toString(root->pItem.get());
