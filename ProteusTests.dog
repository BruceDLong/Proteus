    me bool: graphProjectionCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer normalizer;normalizer.init();
        std::string declarations="{#spoke={color:$ length:*1000+123}}";
        std::string expression="spoke:{length:_}.length",expected="length:*1000+123";
