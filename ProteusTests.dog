FileName = "TestProteus"

do ManageCmdLine(cmd)

#define MULTITEST(NAME, MSG, SPEC) <%void: DESLASH(NAME)(me string: tname)<-{multiNorm(tname, SPEC,"")}%>
#define WORLDTEST(NAME, MSG, WFILE, SPEC) <%void: DESLASH(NAME)(me string: tname)<-{multiNorm(tname, SPEC, WFILE)}%>
#define GETFIRST (NAME, MSG, IN, OUT, SKIP) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGETFIRST(tname, IN, OUT, SKIP)}%>
#define GETNEXT (NAME, MSG, IN, OUT, SKIP) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGETNEXT(tname, IN, OUT, SKIP)}%>
#define GETFIRSTTIGHT (NAME, MSG, IN, OUT, SKIP) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGETFIRSTTIGHT(tname, IN, OUT, SKIP)}%>
#define GETNEXTTIGHT (NAME, MSG, IN, OUT, SKIP) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGETNEXTTIGHT(tname, IN, OUT, SKIP)}%>
#define ENDRELRESOLVE (NAME, MSG) <%void: DESLASH(NAME)(me string: tname)<-{unitTestEndRelativeResolveOnClose(tname)}%>
#define ENDRELQUERY (NAME, MSG, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestEndRelativeQuery(tname, CASE_ID)}%>
#define ENDRELPLAN (NAME, MSG, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestEndRelativeTraversalPlan(tname, CASE_ID)}%>
#define ENDRELCORRESPONDENCE (NAME, MSG, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestEndRelativeCorrespondence(tname, CASE_ID)}%>
#define ORDEREDSPANVIEW (NAME, MSG, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestOrderedSpanView(tname, CASE_ID)}%>
#define MAPPEDWRITE (NAME, MSG, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestMappedWrite(tname, CASE_ID)}%>
#define RESULTSELECTION (NAME, MSG, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestResultSelection(tname, CASE_ID)}%>
#define INDEXLOWERING (NAME, MSG, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestIndexLowering(tname, CASE_ID)}%>
#define IMPLICITITEM (NAME, MSG, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestImplicitItem(tname, CASE_ID)}%>
#define STRICTLISTUNKNOWN (NAME, MSG, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestStrictListUnknownCase(tname, CASE_ID)}%>
#define LOOSELISTUNKNOWN (NAME, MSG, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestLooseListUnknownCase(tname, CASE_ID)}%>
#define LISTSIZEPROMOTION (NAME, MSG, COMMIT_PLAN) <%void: DESLASH(NAME)(me string: tname)<-{unitTestListSizePromotion(tname, COMMIT_PLAN)}%>
#define DEFINITIONSHAPECOMMIT (NAME, MSG, COMMIT_PLAN) <%void: DESLASH(NAME)(me string: tname)<-{unitTestDefinitionShapeCommit(tname, COMMIT_PLAN)}%>
#define LISTSPECAPPLICATION (NAME, MSG) <%void: DESLASH(NAME)(me string: tname)<-{unitTestListSpecApplication(tname)}%>
#define LIFECYCLEINDEPENDENCE (NAME, MSG, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestLifecycleIndependence(tname, CASE_ID)}%>
#define WORKPARENTROLES (NAME, MSG) <%void: DESLASH(NAME)(me string: tname)<-{unitTestWorkParentRoles(tname)}%>
#define LISTCOMPLETIONBARRIER (NAME, MSG) <%void: DESLASH(NAME)(me string: tname)<-{unitTestListCompletionBarrier(tname)}%>
#define PARSEERR (NAME, MSG, INPUT, ERRTXT, ERRLINE, ERRCOL) <%void: DESLASH(NAME)(me string: tname)<-{testParseError(tname, INPUT, ERRTXT, ERRLINE, ERRCOL)}%>


