#define MULTITEST(NAME, MSG, SPEC) <%void: DESLASH(NAME)(me string: tname)<-{multiNorm(tname, SPEC,"")}%>
#define WORLDTEST(NAME, MSG, WFILE, SPEC) <%void: DESLASH(NAME)(me string: tname)<-{multiNorm(tname, SPEC, WFILE)}%>
#define GETFIRST (NAME, MSG, IN, OUT, SKIP) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGETFIRST(tname, IN, OUT, SKIP)}%>
#define GETNEXT (NAME, MSG, IN, OUT, SKIP) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGETNEXT(tname, IN, OUT, SKIP)}%>
#define GETFIRSTTIGHT (NAME, MSG, IN, OUT, SKIP) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGETFIRSTTIGHT(tname, IN, OUT, SKIP)}%>
#define GETNEXTTIGHT (NAME, MSG, IN, OUT, SKIP) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGETNEXTTIGHT(tname, IN, OUT, SKIP)}%>
#define STREAMLOADERSPEC (NAME, MSG, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestStreamLoaderSpec(tname, CASE_ID)}%>
#define ENDRELRESOLVE (NAME, MSG) <%void: DESLASH(NAME)(me string: tname)<-{unitTestEndRelativeResolveOnClose(tname)}%>
#define ENDRELQUERY (NAME, MSG, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestEndRelativeQuery(tname, CASE_ID)}%>
#define SELECTIONREFERENCE (NAME, MSG, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestSelectionReference(tname, CASE_ID)}%>
#define EXTERNALASSOCIATION (NAME, MSG) <%void: DESLASH(NAME)(me string: tname)<-{unitTestExternalAssociation(tname)}%>
#define SELECTIONRESOLUTION (NAME, MSG, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestSelectionResolution(tname, CASE_ID)}%>
#define POSITIONALSELECTION (NAME, MSG, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestPositionalSelectionReference(tname, CASE_ID)}%>
#define INDEXLOWERING (NAME, MSG, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestIndexLowering(tname, CASE_ID)}%>
#define IMPLICITITEM (NAME, MSG, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestImplicitItem(tname, CASE_ID)}%>
#define LISTSPECAPPLICATION (NAME, MSG) <%void: DESLASH(NAME)(me string: tname)<-{unitTestListSpecApplication(tname)}%>
#define WORDRULECOST (NAME, MSG) <%void: DESLASH(NAME)(me string: tname)<-{unitTestWordRuleCost(tname)}%>
#define PARSEERR (NAME, MSG, INPUT, ERRTXT, ERRLINE, ERRCOL) <%void: DESLASH(NAME)(me string: tname)<-{testParseError(tname, INPUT, ERRTXT, ERRLINE, ERRCOL)}%>

// File-aware core for the ordinary CodeDog world and stream fixtures.
struct TestConnectionManager: inherits=InfonStreamLoader{}

struct TestProteusCore: inherits=ProteusCore {
    me TestConnectionManager: connectionMgr
    our infonView: loadedWorldSource

    our InfonConnector: makeInfonConnector(me string: specString,
            me int: loadNumber) <- {
        our InfonStreamSpec:: SP
        SP.setSpec(specString)
        if(SP.protocolTag!="file"){
            errorMesg <- "Unsupported test stream protocol: "+SP.protocolTag
            return(NULL)
        }
        our AssetFileConnector:: connector
        connector.init(SP)
        if(connector.statusCode!=0){
            errorMesg <- connector.statusMesg
            return(NULL)
        }
        return(connector)
    }

    me bool: normalizeFromStreamSpec(our POV: infToFill,
            me string: streamSpec) <- {
        return(normalizeFromStreamSpecAtOrigin(infToFill, streamSpec, 0))
    }

    me bool: normalizeFromStreamSpecAtOrigin(our POV: infToFill,
            me string: streamSpec, me uint64: sourceOriginID) <- {
        me uint64: parentOriginID <-
                streamSourceOriginID(infToFill, sourceOriginID)
        our InfonStream: stream <- connectionMgr.startNewConnection(
                infToFill.pItem, streamSpec, parentOriginID)
        return(stream!=NULL)
    }

    me string: getOriginIDString(me uint64: originID) <- {
        return(connectionMgr.getOriginIDString(originID))
    }

    me bool: loadInto(our infonView: target, me string: specString) <- {
        me string: canonicalSpec <- connectionMgr.canonicalFileSpec(specString)
        our InfonStream: stream <-
                connectionMgr.startNewConnection(target, canonicalSpec)
        if(stream==NULL){return(false)}
        connectionMgr.waitForAllStreams()
        if(stream.normerThread.handle!=NULL and stream.normerThread.handle!.failed()){
            errorMesg <- stream.normerThread.handle!.error()
            if(stream.normerThread.handle!.status().outcome==worldUnsupported){errorMesg <- "UNSUPPORTED: "+errorMesg}
            return(false)
        }
        return(true)
    }

    me bool: initializeWorldFromKernel() <- {
        our infonView: parsedWorld <-
                parseAndExtractString("world", "internal:world")
        if(parsedWorld==NULL){return(false)}
        agent!.world <- parsedWorld
        our POV:: worldPov{30}
        worldPov!.pItem <- agent!.world
        agent!.normalizeAndWait(worldPov)
        agent!.world <- worldPov!.pItem
        if(agent!.world==NULL or
                agent!.world!.value!.overlayType!=LST or
                agent!.world!.value!.evalMode!=emLiteral or
                !agent!.world!.wordDerefed){
            errorMesg <-
                    "The kernel definition 'world' did not normalize into a resolved list."
            return(false)
        }
        return(true)
    }

    me bool: loadKernel(me string: kernelFileName) <- {
        our infonView:: kernelSource
        agent!.kernel <- kernelSource
        if(!loadInto(agent!.kernel, kernelFileName)){return(false)}
        return(initializeWorldFromKernel())
    }

    me bool: initForWorldTest(me string: worldFileName) <- {
        if(!init("", false)){return(false)}
        connectionMgr.init(agent, this)
        if(worldFileName==""){return(true)}

        if(findString(worldFileName, "KernelKB.pr")!=-1){
            return(loadKernel(worldFileName))
        }
        if(findString(worldFileName, "PublicKB.pr")!=-1){
            // The kernel belongs to this fixture, not the application world.
            me string: canonicalSpec <- connectionMgr.canonicalFileSpec(worldFileName)
            me int: lastSlashPos <- findLastSubString(canonicalSpec, "/")
            me string: parentPath <- canonicalSpec.subStr(0, lastSlashPos+1)
            me string: kernelFile <- connectionMgr.resolveStreamSpec("KernelKB.pr", parentPath)
            if(!loadKernel(kernelFile)){return(false)}
            our infonView:: publicSource
            loadedWorldSource <- publicSource
            return(loadInto(loadedWorldSource, worldFileName))
        }

        our infonView:: fixtureWorld
        agent!.world <- fixtureWorld
        return(loadInto(agent!.world, worldFileName))
    }
}


