    me bool: graphStructureCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer normalizer;normalizer.init();
        std::string declarations="{#wheel={position:_ torque:_} #pedals={position:_ torque:_}}";
        std::string expression="{wheel:{position:321 torque:4} wheel:{position:210 torque:5}}",pattern="wheel";
        if(caseID==2 || caseID==19) expression="{wheel:{position:321 torque:4}, wheel:{position:210 torque:5}}";
        if(caseID==3) {pattern="{_ _}";expression="{{position:'bad' torque:4} other:{position:210 torque:5}}";}
        if(caseID==4) {declarations="{#wheel={position:_ torque:{_ $}}}";expression="{wheel:{position:210 torque:{5 'ok'}}}";}
        if(caseID==5) expression="{wheel:{&{position:210} torque:5}}";
        if(caseID==6) {declarations="{}";pattern="{_ $}";expression="{{a:3 b:'yes'} {x:3 y:4}}";}
        if(caseID==7 || caseID==20) {pattern="{position:1 torque:_}";expression="{{position:? torque:4} {position:1 torque:5}}";}
        if(caseID==8) {pattern="{_ _}";expression="{{position:'bad' torque:?} other:{position:210 torque:5}}";}
        if(caseID==9 || caseID==10) {declarations="{}";expression="{pedals:{position:*10+1 torque:*10+2} wheel:{position:*10+3 torque:*10+4}}";}
        if(caseID==11) declarations="{}";
        if(caseID==13) expression="{{position:321, torque:4} wheel:{position:210 torque:5}}";
        if(caseID==14) {pattern="{_ _}";expression="{{a:1 b:2 c:3} wheel:{position:210 torque:5}}";}
        if(caseID==15) expression="{{position:321 ...} wheel:{position:210 torque:5}}";
        if(caseID==16) {pattern="!wheel";expression="{wheel:{position:1 torque:2} pedals:{position:3 torque:4}}";}
        if(caseID==17) {declarations="{#wheel={position:_ torque:_} #bad={_ $}}";pattern="!wheel";expression="{bad:{a:1 b:2}}";}
        if(caseID==18) declarations="{#wheel=*1000000000+{_|...}}";
        if(caseID==22) expression+=".wheel";
        if(caseID==23) {declarations="{}";pattern="{_ _}";expression="{{&{3 %prev}} {2 1}}";}
        if(caseID==24) {declarations="{}";expression="{missing:*10+1 b:'text'}";pattern="missing:_";}
        if(caseID==25) {declarations="{#position=$ #wheel={position:_ torque:_}}";}
        if(caseID==26) {declarations="{}";pattern="!{_ $}";expression="{{1 2}}";}
        if(caseID==27) {declarations="{}";expression="{pedals:{position:*10+1 torque:*10+2} wheel:{position:*10+3 torque:*10+4}}.wheel";}
        if(caseID==28 || caseID==29) expression="{pedals:{position:321 torque:4} wheel:{position:210 torque:5}}";
        if(caseID==29) declarations="{#component={position:_ torque:_} #pedals=component #wheel=component}";
        if(caseID==30) {declarations="{#raceWheel=wheel #wheel={position:_ torque:_}}";expression="{raceWheel:{position:1 torque:2} wheel:{position:3 torque:4}}";}
        if(caseID==31) expression="{{position:1 torque:2} wheel:{position:3 torque:4}}";
        if(caseID==32) expression="{pedals:{position:1} wheel:{position:2}}";
        if(caseID==33) {declarations="{#wheel={position:%prev torque:_}}";expression="{wheel:{position:? torque:?}}";}
        if(caseID==34) {declarations="{#raceWheel=wheel #wheel={position:%prev torque:_}}";expression="{raceWheel:{position:?}}";}
        if(caseID==35) {declarations="{#wheel=*10+_}";expression="{wheel:*10+1 wheel:*10+2}";pattern="wheel:*10+2";}
        if(caseID==36) expression="{wheel:{position:1}, wheel:{position:2}}";
        if(caseID==37) {declarations="{#wheel=*10+2}";expression="{wheel}";pattern="wheel:*10+2";}
        // Explicit descriptions exercise structural comparison independently of
        // the bare nominal selections above, which need no full type validation.
        if(caseID==1 || caseID==2 || caseID==5 || caseID==12 || caseID==19) pattern="wheel:{position:_ torque:_}";
        if(caseID==4) pattern="wheel:{position:_ torque:{_ $}}";
        auto defs=graphParsed(testName,declarations);
        auto declared=normalizer.normalize(defs);declared.waitForCompletion();
        auto source=graphParsed(testName,expression),predicate=graphParsed(testName,pattern);
        auto before=toString(source->pItem.get()),defsBefore=toString(defs->pItem.get()),patternBefore=toString(predicate->pItem.get());
        auto first=source->pItem->value->items.head;
        proteus4::CostPolicy cost;if(caseID==21) cost.maximumRoute=1;
        auto handle=(caseID==22 || caseID==27) ? normalizer.normalize(source) : normalizer.runtime.normalize({source,proteus4::selectField,0,predicate},cost);
        handle.waitForCompletion();
        bool passed=!declared.status().failed;
        if(caseID==7 || caseID==20) {
            passed &= !handle.status().failed && !handle.result() && handle.status().symbolicValues && handle.status().withSubscribers;
            if(caseID==20) handle.cancel();
            normalizer.addRHS(first->pItem->value->items.head,graphParsed(testName,"'wrong'"));handle.waitForCompletion();
        }
        if(caseID==9 || caseID==10) {
            passed &= !handle.status().failed && handle.result()==first->next && !handle.status().symbolicValues;
            auto later=graphParsed(testName,caseID==9 ? "{#wheel=pedals}" : "{#wheel=pedals #wheel=other}");
            auto added=normalizer.normalize(later);added.waitForCompletion();
            handle=normalizer.findField(source,predicate);handle.waitForCompletion();
        }
        if(caseID==27) {
            passed &= !handle.status().failed && !handle.status().symbolicValues && source->pItem->selectedResult==first->next;
            auto published=normalizer.normalize(graphParsed(testName,"{#wheel=pedals}"));published.waitForCompletion();
            // Completed handles do not restart when a definition arrives.
            passed &= source->pItem->selectedResult==first->next && !handle.status().withSubscribers;
            handle=normalizer.normalize(source);handle.waitForCompletion();
            passed &= !handle.status().failed && source->pItem->selectedResult==first &&
                toString(source->pItem.get())=="pedals:{position:*10+1 torque:*10+2}";
        }
        bool deferred=caseID==31 || caseID==26 || caseID==10 || caseID==13 || caseID==15 || caseID==20 || caseID==21;
        if(caseID==27) passed &= !handle.status().failed && !handle.status().symbolicValues;
        else if(deferred) {
            passed &= !handle.status().failed && !handle.result() && handle.status().symbolicValues;
            if(caseID==20) passed &= handle.status().cancelled;
            else passed &= handle.status().withSubscribers;
        } else if(caseID==2 || caseID==19 || caseID==36) {
            auto result=handle.result();
            passed &= !handle.status().failed && result && result->pItem->isOrLike() && handle.status().symbolicValues;
            if(result) {
                auto a=result->pItem->innr->value->items.head;
                passed &= a && a->next && !a->next->next && a->pItem==first->pItem && a->next->pItem==first->next->pItem;
                auto count=normalizer.access->registry->identities.size();
                normalizer.runtime.update([]{});handle.waitForCompletion();
                passed &= handle.result()==result && count==normalizer.access->registry->identities.size();
            }
        } else if(caseID==22) {
            passed &= !handle.status().failed && toString(source->pItem.get())=="wheel:{position:321 torque:4}";
            // Bare numeric members still have unknown size; matching is not full normalization.
            passed &= handle.status().symbolicValues && !getFlagBit(source->pItem->flags,infonView::isNormed);
            auto selected=source->pItem->selectedResult;
            auto identities=normalizer.access->registry->identities.size();
            auto again=normalizer.normalize(source);again.waitForCompletion();
            passed &= selected==source->pItem->selectedResult && identities==normalizer.access->registry->identities.size();
        } else {
            auto wanted=caseID==3 || caseID==7 || caseID==8 || caseID==14 || caseID==16 || caseID==28 || caseID==29 || caseID==32 || caseID==35 ? first->next : first;
            passed &= !handle.status().failed && handle.result()==wanted && !handle.status().symbolicValues;
        }
        if(caseID!=7 && caseID!=20 && caseID!=22 && caseID!=23 && caseID!=27) passed &= before==toString(source->pItem.get());
        passed &= defsBefore==toString(defs->pItem.get()) && patternBefore==toString(predicate->pItem.get());
        if(!passed) {
            std::cout << "Structure " << caseID << ": " << handle.status().error << " symbolic=" << handle.status().symbolicValues << "\n";
            if(handle.result()) std::cout << toString(handle.result()->pItem.get()) << "\n";
            for(const auto& step:handle.steps()) std::cout << step.action << "\n";
        }
        handle.cancel();normalizer.close();return passed;
    }%>
    void: unitTestGraphStructure(me string: testName, me int: caseID) <- {
        me bool: passed <- graphStructureCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

#define GRAPHCHAIN(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphChain(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHCHAIN(unit/graphChain/twoSegments, 1)
    GRAPHCHAIN(unit/graphChain/threeSegments, 2)
    GRAPHCHAIN(unit/graphChain/partialIntermediate, 3)
    GRAPHCHAIN(unit/graphChain/typedSource, 4)
    GRAPHCHAIN(unit/graphChain/embedded, 5)
    GRAPHCHAIN(unit/graphChain/lateValue, 6)
    GRAPHCHAIN(unit/graphChain/cancel, 7)
    GRAPHCHAIN(unit/graphChain/unorderedIntermediate, 8)
    GRAPHCHAIN(unit/graphChain/explicitConstraint, 9)
    GRAPHCHAIN(unit/graphChain/renormalize, 10)
    GRAPHCHAIN(unit/graphChain/singleFieldLateValue, 11)

    me bool: graphChainCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer normalizer;normalizer.init();
        std::string declarations="{#pedals={position:_ torque:_} #wheel={position:_ torque:_}}";
        std::string expression="{pedals:{position:321 torque:4} wheel:{position:210 torque:5}}.wheel.position";
        std::string expected="position:210";
        if(caseID==2 || caseID==3) {
            declarations="{#color=$ #length=_ #spoke={color:$ length:_} #wheel={position:_ torque:_ spoke}}";
            expression=caseID==2 ? "{wheel:{position:210 torque:5 spoke:{length:234}}}.wheel.spoke.length" :
                "{wheel:{spoke:{length:*1000+234}}}.wheel.spoke.length";
            expected=caseID==2 ? "length:234" : "length:*1000+234";
        }
        if(caseID==4) {declarations="{#bike={pedals wheel} #wheel={position:_ torque:_}}";expression="bike:{wheel:{position:*10+7}}.wheel.position";expected="position:*10+7";}
        if(caseID==5) {expression="{&{wheel:{&{position:*10+7}}}}.wheel.position";expected="position:*10+7";}
        if(caseID==6 || caseID==7) {expression="{wheel:{position:?} wheel:{position:*10+2}}.wheel.position";expected="position:*10+7";}
        if(caseID==8) expression="{wheel:{position:*10+1}, wheel:{position:*10+2}}.wheel.position";
        if(caseID==9) {expression="{wheel:{position:*10+1 position:*10+2}}.wheel.position:*10+2";expected="position:*10+2";}
        if(caseID==10) {declarations="{}";expression="{pedals:{position:*10+1} wheel:{position:*10+2}}.wheel.position";expected="position:*10+1";}
        if(caseID==11) {declarations="{}";expression="{position:?}.position";expected="position:*10+7";}
        auto defs=graphParsed(testName,declarations);
        auto declared=normalizer.normalize(defs);declared.waitForCompletion();
        auto root=graphParsed(testName,expression);
        auto original=root->pItem;auto first=original->value->items.head;
        auto sourceBefore=toString(original.get()),defsBefore=toString(defs->pItem.get());
        auto handle=normalizer.normalize(root);handle.waitForCompletion();
        bool passed=!declared.status().failed && !handle.status().failed;
        if(caseID==6 || caseID==7 || caseID==11) {
            auto position=caseID==11 ? first : first->pItem->value->items.head;
            passed &= root->pItem->selectedResult==position && handle.status().symbolicValues && handle.status().withSubscribers;
            if(caseID==7) handle.cancel();
            auto steps=handle.steps().size();
            normalizer.addRHS(position,graphParsed(testName,"*10+7"));handle.waitForCompletion();
            if(caseID==7) passed &= handle.status().cancelled && handle.steps().size()==steps;
        }
        if(caseID==10) {
            passed &= !handle.status().symbolicValues && toString(root->pItem.get())=="position:*10+2";
            auto added=normalizer.normalize(graphParsed(testName,"{#wheel=pedals}"));added.waitForCompletion();
            passed &= toString(root->pItem.get())=="position:*10+2";
            handle=normalizer.normalize(root);handle.waitForCompletion();
        }
        if(caseID==8) {
            passed &= handle.status().symbolicValues && handle.status().withSubscribers && root->pItem->pathSelection &&
                root->pItem->pathSelection->pending && toString(root->pItem.get())=="*_+[position:*10+1 position:*10+2 ... ]";
        } else if(caseID!=7) {
            passed &= !handle.status().failed && toString(root->pItem.get())==expected;
            if(caseID>=3) passed &= !handle.status().symbolicValues && getFlagBit(root->pItem->flags,infonView::isNormed);
            else passed &= handle.status().symbolicValues && !getFlagBit(root->pItem->flags,infonView::isNormed);
            auto selected=root->pItem->selectedResult;
            auto identities=normalizer.access->registry->identities.size();
            auto again=normalizer.normalize(root);again.waitForCompletion();
            passed &= !again.status().failed && selected==root->pItem->selectedResult && identities==normalizer.access->registry->identities.size();
        }
        if(caseID!=6 && caseID!=7 && caseID!=11) passed &= sourceBefore==toString(original.get());
        passed &= defsBefore==toString(defs->pItem.get());
        if(!passed) {
            std::cout << "Chain " << caseID << ": " << handle.status().error << " symbolic=" << handle.status().symbolicValues << "\n"
                      << toString(root->pItem.get()) << "\n";
            for(const auto& step:handle.steps()) std::cout << step.action << "\n";
        }
        handle.cancel();normalizer.close();return passed;
    }%>
    void: unitTestGraphChain(me string: testName, me int: caseID) <- {
        me bool: passed <- graphChainCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

