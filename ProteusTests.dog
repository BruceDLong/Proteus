        if(caseID==5) expression="spoke";
        if(caseID==6) {definitions="{#length=*10+7 #spoke={color:$ length:_}}";expression="spoke:{length:*10+8}";}
        if(caseID==7) expression="spoke:{length:*10+7, extra:*10+8}";
        if(caseID==8) definitions="{#length=*10+_ #spoke={color:%prev length:_}}";
        auto defs=graphParsed(testName,definitions);auto declared=normalizer.normalize(defs);declared.waitForCompletion();
        auto original=toString(defs->pItem.get());
