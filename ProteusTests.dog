        if(caseID==3) declarations="{#spoke={color:$ &{length:*1000+123}}}";
        if(caseID==4) expression="wheel:{spoke:{length:_}}.spoke.length";
        if(caseID==5) declarations="{#spoke={color:%prev length:*1000+123}}";
        if(caseID==6) declarations="{#spoke={color:*10+1=*10+2 length:*1000+123}}";
        if(caseID==7 || caseID==8) declarations="{#unused=_}";
        if(caseID==10) {expression="spoke:{length:*1000+99}.length";expected="length:*1000+99";}
        if(caseID==11) declarations="{#spoke={color:*10+1 length:%prev}}";
