    GRAPHCROSSING(unit/graphCrossing/lateOverlap, 12)
    me bool: graphCrossingCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer normalizer;normalizer.init();
        std::string expression="{1 ... 6} = {... &{4 5 6}}";
        if(caseID==3) expression="{*10+1 ... *10+6} = {... &{*10+4 *10+5 *10+6}}";
        if(caseID==1) expression="{... &{4 5 6}} = {1 ... 6}";
