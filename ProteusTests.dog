    TEMPORALCONTAINMENT(unit/temporal/rootedContainmentBidirectional, "identify whole-interval host and component boundaries in both directions")
    ENDRELRESOLVE(unit/endRelative/resolveOnClose, "register end-relative references and identify them while large sparse sources stay compressed")
