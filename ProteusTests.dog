#define GRAPHCROSSING(NAME, CASE_ID) <%void: DESLASH(NAME)(me string: tname)<-{unitTestGraphCrossing(tname, CASE_ID)}%>
struct GLOBAL {
    GRAPHCROSSING(unit/graphCrossing/crossing, 0)
    GRAPHCROSSING(unit/graphCrossing/reverse, 1)
    GRAPHCROSSING(unit/graphCrossing/anchored, 2)
    GRAPHCROSSING(unit/graphCrossing/lateFill, 3)
    GRAPHCROSSING(unit/graphCrossing/lateConflict, 4)
    GRAPHCROSSING(unit/graphCrossing/cancel, 5)
    GRAPHCROSSING(unit/graphCrossing/emptyMiddle, 6)
    GRAPHCROSSING(unit/graphCrossing/billion, 7)
    GRAPHCROSSING(unit/graphCrossing/cost, 8)
    GRAPHCROSSING(unit/graphCrossing/unknownOverlap, 9)
    GRAPHCROSSING(unit/graphCrossing/compatibleOverlap, 10)
    GRAPHCROSSING(unit/graphCrossing/typedEnds, 11)
    GRAPHCROSSING(unit/graphCrossing/lateOverlap, 12)
    me bool: graphCrossingCase(me string: testName, me int: caseID) <- <%{
        GraphNormalizer normalizer;normalizer.init();
        std::string expression="{1 ... 6} = {... &{4 5 6}}";
        if(caseID==3) expression="{*10+1 ... *10+6} = {... &{*10+4 *10+5 *10+6}}";
        if(caseID==1) expression="{... &{4 5 6}} = {1 ... 6}";
        if(caseID==2) expression="{1 ... 5 _} = {... 4 5 6}";
        if(caseID==6) expression="*4+{*10+1 ... *10+6} = {... &{*10+4 *10+5 *10+6}}";
        if(caseID==7) expression="*1000000000+{1 ... 6} = {... &{4 5 6}}";
        if(caseID==9 || caseID==12) expression="{_ ... 6} = {... &{4 5 6}}";
        if(caseID==10) expression="{4 ... 6} = {... &{4 5 6}}";
        if(caseID==11) expression="{start:*10+1 ... 6} = {... &{end:*10+4 5 6}}";
        auto root=graphParsed(testName,expression),rhs=root->pItem->wrkList.front();
        auto left=caseID==1 ? rhs : root, right=caseID==1 ? root : rhs;
        auto gapA=left->pItem->value->items.head->next,gapB=right->pItem->value->items.head;
        auto handle=caseID==8 ? normalizer.normalizeWithCost(root,1) : normalizer.normalize(root);handle.waitForCompletion();
        bool passed=!handle.status().failed;
        if(caseID==12) {
            passed &= gapA->pItem->value->items.isEmpty();
            normalizer.addRHS(left->pItem->value->items.head,graphParsed(testName,"1"));handle.waitForCompletion();
        }
        if(caseID==8 || caseID==9 || caseID==10) {
            passed &= handle.status().symbolicValues && gapA->pItem->value->items.isEmpty() && gapB->pItem->value->items.isEmpty();
        } else {
            auto middle=gapA->pItem->value->items.head;
            passed &= middle && getFlagBit(middle->flags,POV::isSubItm) && !getFlagBit(gapA->pItem->value->flags,infonState::tailUnfinished);
            if(middle) {
                passed &= gapA->pItem->value->items.size()==(caseID==2 ? 2u : 3u) && gapB->pItem->value->items.size()==2;
                auto other=gapB->pItem->value->items.tail;
                passed &= other && getFlagBit(other->flags,POV::isSubItm);
                if(caseID==6) passed &= normalizer.access->listExtent(root)==4 && !handle.status().symbolicValues;
                else passed &= handle.status().symbolicValues && !getFlagBit(root->pItem->flags,infonView::isNormed);
                if(caseID==7) {
                    passed &= middle->pItem->infSize->num==999999996 && middle->pItem->value->items.isEmpty();
                    auto printed=toString(root->pItem.get());
                    passed &= printed.find("*999999996+")!=std::string::npos;
                    auto reparsed=graphParsed(testName,printed);auto roundtrip=normalizer.normalize(reparsed);roundtrip.waitForCompletion();
                    passed &= !roundtrip.status().failed && normalizer.access->listExtent(reparsed)==1000000000;
                    roundtrip.cancel();
                }
                if(caseID==11) passed &= middle->next->pItem->type && middle->next->pItem->type->typeID()=="end";
                if(caseID==3 || caseID==4 || caseID==5) {
                    if(caseID==5) handle.cancel();
                    normalizer.addRHS(gapA,graphParsed(testName,"{*10+2 *10+3 *10+4 *10+5}"));handle.waitForCompletion();
                    if(caseID==5) passed &= handle.status().cancelled && !handle.status().withSubscribers && middle->pItem->value->items.isEmpty();
                    else {
                        passed &= !handle.status().failed && normalizer.access->listExtent(root)==6 && normalizer.access->listExtent(gapB)==3;
                        passed &= middle->pItem->value->items.size()==2 && other->pItem->value->items.size()==2;
                        passed &= caseID==3 ? !handle.status().symbolicValues : handle.status().withSubscribers;
                        if(caseID==4) {normalizer.addRHS(gapB,graphParsed(testName,"{1 9 3}"));handle.waitForCompletion();passed &= handle.status().failed;}
                    }
                }
            }
        }
        if(caseID!=4 && caseID!=5 && caseID!=8) {
            auto before=toString(root->pItem.get());auto count=normalizer.access->registry->identities.size();
            auto again=normalizer.normalize(root);again.waitForCompletion();
            passed &= !again.status().failed && toString(root->pItem.get())==before && normalizer.access->registry->identities.size()==count;again.cancel();
        }
        if(!passed) std::cout << "Crossing " << caseID << ": " << handle.status().error << " symbolic=" << handle.status().symbolicValues << "\n" << toString(root->pItem.get()) << "\n";
        handle.cancel();normalizer.close();return passed;
    }%>
    void: unitTestGraphCrossing(me string: testName, me int: caseID) <- {
        me bool: passed <- graphCrossingCase(testName, caseID)
        me string: actual <- "false"; me string: expected <- "true"
        if(passed){actual <- "true"}
        REQUIRE(actual==expected)
    }
}

