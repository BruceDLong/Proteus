// Structural entry point for rsMerge agenda items.
// The First Cut preserves behavior by delegating to the existing implementation.
struct MergeProcessor{
    void: process(their WorldManager: worldManager, their Agenda: agenda, our AItem: aItem, me int: alternativesNestLvl) <- {
        worldManager!.processAgendaItemLegacy(agenda, aItem, alternativesNestLvl)
    }
}
