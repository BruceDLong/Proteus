// A phase is measured from zero up to one turn. Grid positions are whole,
// zero-based ticks. A known turn can be observed before choosing a grid.
{
    #phase-reading(turn) = {
        turns:   (*1+_ == %turn),
        degrees: **((*1+_ == %turn) *360+0)
    }

    // Adding the discrete sum identity *1+0 requires a whole tick.
    // Match it against [0,n), then apply the reciprocal radix 1/n.
    #scaled-phase(n,k) = phase-reading(
        **((*(%n)+_ == ++(%k *1+0)) /(++(%n *1+0))+0)
    )

    #tick-width(n) = **(1 /(++(%n *1+0))+0)

    // Divide a bounded turn by the width of one tick. The resulting
    // extent is n. The discrete sum rejects a fractional tick.
    #phase-tick(n,turn) = ++(
        **((*1+_ == %turn) /(tick-width(%n))+0) *1+0
    )
}
