// The initial window is {a b}. The step copies b, then selects a new
// value from the row for p and the column for a. Indices start at one.
// fixed(*3+1,*3+_,*_+[*3+0 *3+1 *3+2])@[7]@[1] gives *3+1.
// fresh(*3+1,*3+_)@[7]@[1] gives *_+[*3+0 *3+1 *3+2].
{
    #advance(w,p) = {
        %w@[2]
        {
            {*3+0 *3+1 *3+2}
            {*3+1 *3+2 *3+0}
            {*3+2 *3+0 *3+1}
        }@[(%p +1)]@[(%w@[1] +1)]
    }

    #fixed(a,b,p) = {T {%a %b} &*6000000+{T advance(%tprev,%p) | ...}}
    #fresh(a,b) = {T {%a %b} &*6000000+{T advance(%tprev,*_+[*3+0 *3+1 *3+2]) | ...}}
}
