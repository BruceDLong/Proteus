// First world-model transition exercise. Reuse the actual cube declarations.
// State 2 describes only the requested change; preservation is an engine obligation.
// Target: first edge cubie xRot 0 -> 0.3, matching the Slipstream example.
{
    // Named imports cannot be mistaken for an earlier cubeTransition match.
    libraries:{
        %INSERT /../public/Informatics/Foundation.pr
        %INSERT /../public/Things/rubixCube.pr
    }
    // T marks temporal composition; this definition also establishes order.
    #cubeTransition = {T ? ?}
    cubeTransition:{T
        solvedState
        rubixState.edgeCubes@[1].thing.orientation.xRot=0.3;;;;;
    }
}
