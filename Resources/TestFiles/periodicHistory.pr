// A history of overlapping ternary pairs. Seeds a and b and phase p belong to *3.
// Each public window is {x_t x_(t+1)}. Time starts at 0 and @[1] selects window 0.
// The step on a pair {u v} is {v (u+p) mod 3}. The tables below encode the shifts.
// With one seed, history(*3+1,*3+_,*3+1)@[19683]@[1] evaluates to *3+2.
{
    // Rows use phase p. Columns use the public ternary value of the selected seed.
    #once = {
        {*3+0 *3+1 *3+2}
        {*3+1 *3+2 *3+0}
        {*3+2 *3+0 *3+1}
    }

    #twice = {
        {*3+0 *3+1 *3+2}
        {*3+2 *3+0 *3+1}
        {*3+1 *3+2 *3+0}
    }

    // Applying the pair rule twice shifts both seeds. Three such shifts restore them.
    #block6(a,b,p) = *6+{
        {%a %b}
        {%b once@[(%p +1)]@[(%a +1)]}
        {once@[(%p +1)]@[(%a +1)] once@[(%p +1)]@[(%b +1)]}
        {once@[(%p +1)]@[(%b +1)] twice@[(%p +1)]@[(%a +1)]}
        {twice@[(%p +1)]@[(%a +1)] twice@[(%p +1)]@[(%b +1)]}
        {twice@[(%p +1)]@[(%b +1)] %a}
    }

    // Each level concatenates two closed blocks. An index can skip a block
    // once traversal has established its width.
    #block12(a,b,p) = *12+{&block6(%a,%b,%p) &block6(%a,%b,%p)}
    #block24(a,b,p) = *24+{&block12(%a,%b,%p) &block12(%a,%b,%p)}
    #block48(a,b,p) = *48+{&block24(%a,%b,%p) &block24(%a,%b,%p)}
    #block96(a,b,p) = *96+{&block48(%a,%b,%p) &block48(%a,%b,%p)}
    #block192(a,b,p) = *192+{&block96(%a,%b,%p) &block96(%a,%b,%p)}
    #block384(a,b,p) = *384+{&block192(%a,%b,%p) &block192(%a,%b,%p)}
    #block768(a,b,p) = *768+{&block384(%a,%b,%p) &block384(%a,%b,%p)}
    #block1536(a,b,p) = *1536+{&block768(%a,%b,%p) &block768(%a,%b,%p)}
    #block3072(a,b,p) = *3072+{&block1536(%a,%b,%p) &block1536(%a,%b,%p)}
    #block6144(a,b,p) = *6144+{&block3072(%a,%b,%p) &block3072(%a,%b,%p)}
    #block12288(a,b,p) = *12288+{&block6144(%a,%b,%p) &block6144(%a,%b,%p)}
    #block24576(a,b,p) = *24576+{&block12288(%a,%b,%p) &block12288(%a,%b,%p)}
    #block49152(a,b,p) = *49152+{&block24576(%a,%b,%p) &block24576(%a,%b,%p)}
    #block98304(a,b,p) = *98304+{&block49152(%a,%b,%p) &block49152(%a,%b,%p)}
    #block196608(a,b,p) = *196608+{&block98304(%a,%b,%p) &block98304(%a,%b,%p)}
    #history(a,b,p) = *393216+{&block196608(%a,%b,%p) &block196608(%a,%b,%p)}
}
