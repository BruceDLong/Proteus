// State 2 flips the edge in the top-front slot. No intrinsic cubie index.
// Its body +Y and +Z stickers exchange outward directions; position is preserved.
rubix-cube:{T rubix-state|
    solved-rubix-state:{
        thing:{orientation:{xRot:3, yRot:3, zRot:0}, location:{xLoc:0, yLoc:0, zLoc:3.5}},
    }
    rubix-state.parts.edge-cubes.edge-cube:{thing:{location:{xLoc:0,yLoc:1.1,zLoc:1.1},},}.thing.orientation={xRot:-1.570796326794897,yRot:3.141592653589793};;;;;
}
