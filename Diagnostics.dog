// Per-agenda diagnostics for stable execution traces, coverage, and debug graphs.
struct Diagnostics{
    me AItemValidator: validator
    me bool: validateAitems <- true
    me bool: makeDebugGraph <- false
    me AItemGrapherData: grapherData

    void: beginAgenda(their Agenda: agenda) <- {
        if(agenda!.normalizationID==0){
            {
                me MutexMngr: phase1IDLock{phase1NormalizationIDMutex}
                agenda!.normalizationID <- phase1NextNormalizationID
                phase1NextNormalizationID <+- 1
            }
        }
        if(makeDebugGraph){grapher.clear(); grapher.addItem("rankdir=RL; ordering=out;")}
    }

    our AItemTrace: beginAItem(their Agenda: agenda, our AItem: aItem) <- {
        if(makeDebugGraph){GraphNode_prePAI(aItem, grapherData)}
        return(validator.beginAItem(agenda, aItem, validateAitems))
    }

    void: endAItem(their Agenda: agenda, our AItem: aItem, our AItemTrace: trace) <- {
        validator.endAItem(agenda, aItem, trace, validateAitems)
        if(makeDebugGraph){GraphNode_postPAI(aItem, grapherData)}
    }

    void: completeAgenda(their WorldManager: worldManager, their Agenda: agenda) <- {
        worldManager!.phase1LastTraceCount <- validator.traces.size()
        worldManager!.phase1LastCoverageReport <- validator.coverageReport(agenda!.normalizationID)
        log(worldManager!.phase1LastCoverageReport)
        if(makeDebugGraph){grapher.saveGraph("AgendaRun", "AgendaRun.dot")}
    }
}
